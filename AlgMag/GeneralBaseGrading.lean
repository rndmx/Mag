import AlgMag.Sec3Affine
import AlgMag.AffineComparison
import AlgMag.Sec6FPR

/-!
# Quotient gradings and fixed points

Mayeux, *Algebraic Magnetism*, Semigroup Forum 113 (2026), Lemma 3.26, Propositions 3.32 and 3.35.
`AlgMag.Sec3Affine` proves the ideal identities with the *image family* on `A / I`. Here that family
is shown to be an actual grading when `I` is homogeneous, so that `Z^N` and `(X^N)^L` are attractors
in the sense of `Magnetism.Attractor`.

## Main results

* `AlgMag.quotGrading`, `AlgMag.quotGradedAlgebra`: the grading on `A / I`, `I` homogeneous.
* `AlgMag.isHomogeneous_magnetIdeal`: `J_N` is homogeneous.
* `AlgMag.attractorQuotientEquiv`: Lemma 3.26, `Z^N(C) = Z(C) ×_{Y(C)} Y^N(C)`.
* `AlgMag.attractorAttractorEquiv`: Proposition 3.32 (i), `(X^N)^L = X^{N ∩ L}`.
* `AlgMag.isFixedPoint_iff_mem_fixedPoints`, `AlgMag.attractorPtFixedEquiv`: Proposition 3.35 in
  terms of `AlgMag.fixedPoints` of §6.
-/

suppress_compilation

open Magnetism DirectSum CategoryTheory Opposite

open scoped Classical

universe u

namespace AlgMag

section Quot

variable {M : Type*} [AddCommMonoid M] [DecidableEq M]
variable {R₀ A : Type*} [CommRing R₀] [CommRing A] [Algebra R₀ A]
variable (𝒜 : M → Submodule R₀ A) [GradedAlgebra 𝒜]

/-- `I` is homogeneous: it contains the homogeneous components of its elements. This is the
condition that `Spec (A / I) ⊆ Spec A` is an equivariant closed subscheme. -/
def IsHomogeneousIdeal (I : Ideal A) : Prop :=
  ∀ (a : A), a ∈ I → ∀ m, (DirectSum.decompose 𝒜 a m : A) ∈ I

/-- An ideal generated by homogeneous elements is homogeneous. -/
theorem isHomogeneous_span {s : Set A} (hs : ∀ a ∈ s, ∃ m, a ∈ 𝒜 m) :
    IsHomogeneousIdeal 𝒜 (Ideal.span s) := by
  intro a ha m
  induction ha using Submodule.span_induction generalizing m with
  | mem a h =>
    obtain ⟨k, hk⟩ := hs a h
    rw [DirectSum.decompose_of_mem 𝒜 hk]
    by_cases e : k = m
    · subst e
      simpa using Ideal.subset_span h
    · rw [DirectSum.of_eq_of_ne _ _ _ (Ne.symm e)]
      simp
  | zero => simp
  | add a b _ _ ha hb =>
    rw [DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add]
    exact Ideal.add_mem _ (ha m) (hb m)
  | smul c x _ hx =>
    -- `c • x` with `c` decomposed into homogeneous pieces
    induction c using DirectSum.Decomposition.inductionOn 𝒜 generalizing m with
    | zero => simp
    | add c c' h h' =>
      rw [add_smul, DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add]
      exact Ideal.add_mem _ (h m) (h' m)
    | @homogeneous i c =>
      -- `decompose (c x) m = ∑ c x_k` over `i + k = m`
      have key : ∀ y : A, (∀ k, (DirectSum.decompose 𝒜 y k : A) ∈ Ideal.span s) →
          (DirectSum.decompose 𝒜 ((c : A) * y) m : A) ∈ Ideal.span s := by
        intro y hy
        have hy' : y = ∑ k ∈ (DirectSum.decompose 𝒜 y).support,
            (DirectSum.decompose 𝒜 y k : A) := (DirectSum.sum_support_decompose 𝒜 y).symm
        rw [hy', Finset.mul_sum, DirectSum.decompose_sum, DFinsupp.finsetSum_apply,
          AddSubmonoidClass.coe_finsetSum]
        refine Ideal.sum_mem _ fun k _ => ?_
        have hmem : (c : A) * (DirectSum.decompose 𝒜 y k : A) ∈ 𝒜 (i + k) :=
          SetLike.GradedMul.mul_mem c.2 (SetLike.coe_mem _)
        rw [DirectSum.decompose_of_mem 𝒜 hmem]
        by_cases e : i + k = m
        · subst e
          simpa using Ideal.mul_mem_left _ _ (hy k)
        · rw [DirectSum.of_eq_of_ne _ _ _ (Ne.symm e)]
          simp
      exact key x hx

/-- `J_N` is homogeneous. -/
theorem isHomogeneous_magnetIdeal (N : Magnet M) : IsHomogeneousIdeal 𝒜 (magnetIdeal 𝒜 N) := by
  refine isHomogeneous_span 𝒜 fun a ha => ?_
  simp only [Set.mem_iUnion, SetLike.mem_coe] at ha
  obtain ⟨m, -, h⟩ := ha
  exact ⟨m, h⟩

/-- The image family on `A / I`. -/
abbrev quotGrading (I : Ideal A) (m : M) : Submodule R₀ (A ⧸ I) :=
  (𝒜 m).map (Ideal.Quotient.mkₐ R₀ I).toLinearMap

variable {𝒜}

/-- The decomposition map of `A / I`. -/
def quotDecompose {I : Ideal A} (hI : IsHomogeneousIdeal 𝒜 I) :
    A ⧸ I →+ ⨁ m, quotGrading 𝒜 I m :=
  QuotientAddGroup.lift I.toAddSubgroup
    ((DirectSum.toAddMonoid fun m =>
      (DirectSum.of (fun m => quotGrading 𝒜 I m) m).comp
        (LinearMap.toAddMonoidHom
          (((Ideal.Quotient.mkₐ R₀ I).toLinearMap.restrict (q := quotGrading 𝒜 I m)
            fun a ha => Submodule.mem_map_of_mem ha)))).comp
      (DirectSum.decomposeAddEquiv 𝒜).toAddMonoidHom)
    (by
      intro a ha
      have hsum : DirectSum.decompose 𝒜 a =
          ∑ k ∈ (DirectSum.decompose 𝒜 a).support,
            DirectSum.of (fun i => 𝒜 i) k (DirectSum.decompose 𝒜 a k) :=
        (DFinsupp.sum_single (f := DirectSum.decompose 𝒜 a)).symm.trans rfl
      change DirectSum.toAddMonoid _ (DirectSum.decompose 𝒜 a) = 0
      rw [hsum, map_sum]
      refine Finset.sum_eq_zero fun k _ => ?_
      rw [DirectSum.toAddMonoid_of]
      have h0 : ((Ideal.Quotient.mkₐ R₀ I).toLinearMap.restrict (q := quotGrading 𝒜 I k)
          (fun a ha => Submodule.mem_map_of_mem ha)) (DirectSum.decompose 𝒜 a k) = 0 := by
        refine Subtype.ext ?_
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (hI a ha k)
      exact (congrArg (DirectSum.of (fun m => quotGrading 𝒜 I m) k) h0).trans (map_zero _))

lemma quotDecompose_mk_of_mem {I : Ideal A} (hI : IsHomogeneousIdeal 𝒜 I) {m : M} {a : A}
    (ha : a ∈ 𝒜 m) :
    quotDecompose hI (Ideal.Quotient.mk I a) =
      DirectSum.of (fun m => quotGrading 𝒜 I m) m
        ⟨Ideal.Quotient.mk I a, Submodule.mem_map_of_mem ha⟩ := by
  change DirectSum.toAddMonoid _ (DirectSum.decompose 𝒜 a) = _
  rw [DirectSum.decompose_of_mem 𝒜 ha, DirectSum.toAddMonoid_of]
  rfl

/-- **Lemma 3.26, Proposition 3.32**: for a homogeneous ideal `I`, the image family is a grading of
`A / I`: this is the action of `𝔸(M)_S` on the equivariant closed subscheme `Spec (A / I)`. -/
def quotGradedAlgebra {I : Ideal A} (hI : IsHomogeneousIdeal 𝒜 I) :
    GradedAlgebra (quotGrading 𝒜 I) where
  one_mem := ⟨1, SetLike.GradedOne.one_mem, map_one (Ideal.Quotient.mkₐ R₀ I)⟩
  mul_mem := by
    rintro i j _ _ ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
    exact ⟨a * b, SetLike.GradedMul.mul_mem ha hb, map_mul (Ideal.Quotient.mkₐ R₀ I) _ _⟩
  toDecomposition := DirectSum.Decomposition.ofAddHom _ (quotDecompose hI)
    (by
      refine AddMonoidHom.ext fun x => ?_
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
      induction a using DirectSum.Decomposition.inductionOn 𝒜 with
      | zero => simp
      | @homogeneous m a =>
        change DirectSum.coeAddMonoidHom _ (quotDecompose hI _) = _
        rw [quotDecompose_mk_of_mem hI a.2, DirectSum.coeAddMonoidHom_of]
        rfl
      | add a b ha hb =>
        simp only [map_add, AddMonoidHom.add_apply] at ha hb ⊢
        rw [ha, hb])
    (by
      refine DirectSum.addHom_ext fun m ⟨x, a, ha, hax⟩ => ?_
      subst hax
      change quotDecompose hI (DirectSum.coeAddMonoidHom _ (DirectSum.of _ m _)) = _
      rw [DirectSum.coeAddMonoidHom_of]
      exact quotDecompose_mk_of_mem hI ha)

variable {C : Type*} [CommRing C] [Algebra R₀ C]

/-- **Lemma 3.26** (`S` affine, on points). Let `I` be a homogeneous ideal of the graded algebra `A`
and `Z = Spec (A / I)` with the quotient grading. Then the `C`-points of `Z^N` are the
points of `Y = Spec A` lying in `Z` and in `Y^N`: `Z^N = Z ×_Y Y^N`. -/
def attractorQuotientEquiv {I : Ideal A} (hI : IsHomogeneousIdeal 𝒜 I) (N : Magnet M) :
    letI := quotGradedAlgebra hI
    Attractor (quotGrading 𝒜 I) N C ≃
      {g : A →ₐ[R₀] C // (∀ a ∈ I, g a = 0) ∧ ∀ a ∈ magnetIdeal 𝒜 N, g a = 0} :=
  letI := quotGradedAlgebra hI
  (attractorPointsEquiv (quotGrading 𝒜 I) C N).trans
    { toFun := fun g => ⟨g.1.comp (Ideal.Quotient.mkₐ R₀ I),
        fun a ha => by
          change g.1 (Ideal.Quotient.mk I a) = 0
          rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero],
        fun a ha => g.2 _ (by
          rw [magnetIdeal_map_quotient]
          exact Ideal.mem_map_of_mem _ ha)⟩
      invFun := fun g => ⟨Ideal.Quotient.liftₐ I g.1 g.2.1, fun x hx => by
        rw [magnetIdeal_map_quotient] at hx
        have hle : (magnetIdeal 𝒜 N).map (Ideal.Quotient.mk I) ≤
            RingHom.ker (Ideal.Quotient.liftₐ I g.1 g.2.1 : A ⧸ I →+* C) := by
          rw [Ideal.map_le_iff_le_comap]
          intro a ha
          exact g.2.2 a ha
        exact hle hx⟩
      left_inv := fun g => by
        refine Subtype.ext (AlgHom.ext fun x => ?_)
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
        rfl
      right_inv := fun g => by
        refine Subtype.ext (AlgHom.ext fun a => ?_)
        rfl }

/-- **Proposition 3.32 (i)** (`S` affine). With the quotient grading on `A / J_N` (the action of
Remark 3.11 on `X^N`), the attractor `(X^N)^L` is literally an attractor, and it is `X^{N ∩ L}`:
compatibly with the maps to `X`, points of the two sides are the points of `X` that kill the same
ideal. -/
def attractorAttractorEquiv (N L : Magnet M) :
    letI := quotGradedAlgebra (isHomogeneous_magnetIdeal 𝒜 N)
    Attractor (quotGrading 𝒜 (magnetIdeal 𝒜 N)) L C ≃ Attractor 𝒜 (N ⊓ L) C :=
  letI := quotGradedAlgebra (isHomogeneous_magnetIdeal 𝒜 N)
  (attractorQuotientEquiv (isHomogeneous_magnetIdeal 𝒜 N) L).trans
    (Equiv.trans
      { toFun := fun g => ⟨g.1, fun a ha => by
          rw [magnetIdeal_inf] at ha
          have hle : magnetIdeal 𝒜 N ⊔ magnetIdeal 𝒜 L ≤ RingHom.ker (g.1 : A →+* C) :=
            sup_le (fun a ha => g.2.1 a ha) (fun a ha => g.2.2 a ha)
          exact hle ha⟩
        invFun := fun g => ⟨g.1, fun a ha => g.2 a (magnetIdeal_anti 𝒜 inf_le_left ha),
          fun a ha => g.2 a (magnetIdeal_anti 𝒜 inf_le_right ha)⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
      (attractorPointsEquiv 𝒜 C (N ⊓ L)).symm)

/-- The identification of Proposition 3.32 (i) is the identity on the underlying points of `X`. -/
theorem attractorPoint_attractorAttractorEquiv (N L : Magnet M)
    (x : letI := quotGradedAlgebra (isHomogeneous_magnetIdeal 𝒜 N)
      Attractor (quotGrading 𝒜 (magnetIdeal 𝒜 N)) L C) :
    letI := quotGradedAlgebra (isHomogeneous_magnetIdeal 𝒜 N)
    attractorPoint 𝒜 (attractorAttractorEquiv N L x) =
      (attractorPoint (quotGrading 𝒜 (magnetIdeal 𝒜 N)) x).comp
        (Ideal.Quotient.mkₐ R₀ (magnetIdeal 𝒜 N)) :=
  letI := quotGradedAlgebra (isHomogeneous_magnetIdeal 𝒜 N)
  congrArg Subtype.val ((attractorPointsEquiv 𝒜 C (N ⊓ L)).apply_symm_apply _)

end Quot

section Fixed

variable {R : Type u} [CommRing R] {G A : Type u} [AddCommGroup G] [DecidableEq G] [CommRing A]
  [Algebra R A] (𝒢 : G → Submodule R A) [GradedAlgebra 𝒢] (Z : AddSubgroup G)

/-- **Proposition 3.35**, linking the two notions: the point `g` of `Spec A` is fixed in the sense of
`AlgMag.IsFixedPoint` iff it is a point of the fixed-point functor `AlgMag.fixedPoints` of §6, for
the action of `D(G/Z)` induced by the grading. -/
theorem isFixedPoint_iff_mem_fixedPoints (C : CommAlgCat.{u} R) (g : A →ₐ[R] C) :
    IsFixedPoint 𝒢 Z g ↔
      g ∈ (fixedPoints (quotientAction (gradedAction 𝒢) Z)).obj (op (op C)) := by
  constructor
  · intro hg T' s h
    let D : CommAlgCat.{u} R := unop (unop T')
    let φ : C →ₐ[R] D := s.unop.unop.hom
    let h' : Multiplicative (G ⧸ Z) →* D := h
    change gradedSmul (D := D) 𝒢 (h'.comp (AddMonoidHom.toMultiplicative (QuotientAddGroup.mk' Z)))
      (φ.comp g) = φ.comp g
    refine algHom_ext_of_homogeneous (D := D) 𝒢 fun m a ha => ?_
    refine (gradedSmul_apply_of_mem (D := D) 𝒢 _ _ ha).trans ?_
    change h' (Multiplicative.ofAdd (QuotientAddGroup.mk m)) * φ (g a) = φ (g a)
    by_cases hm : m ∈ Z
    · have : (QuotientAddGroup.mk m : G ⧸ Z) = 0 := (QuotientAddGroup.eq_zero_iff m).2 hm
      rw [this, ofAdd_zero, map_one, one_mul]
    · rw [(isFixedPoint_iff Z g).1 hg m hm a ha, map_zero, mul_zero]
  · intro hg
    let D : CommAlgCat.{u} R := CommAlgCat.of R (AddMonoidAlgebra C (G ⧸ Z))
    let φ : C →ₐ[R] AddMonoidAlgebra C (G ⧸ Z) := constAlg (G ⧸ Z) C
    let s : op (op C) ⟶ op (op D) := (CommAlgCat.ofHom φ).op.op
    let h : Multiplicative (G ⧸ Z) →* AddMonoidAlgebra C (G ⧸ Z) := AddMonoidAlgebra.of C (G ⧸ Z)
    have key : gradedSmul (D := AddMonoidAlgebra C (G ⧸ Z)) 𝒢
        (h.comp (AddMonoidHom.toMultiplicative (QuotientAddGroup.mk' Z))) (φ.comp g) = φ.comp g :=
      hg s h
    intro m a ha
    have h1 := DFunLike.congr_fun key a
    rw [gradedSmul_apply_of_mem 𝒢 _ _ ha] at h1
    change AddMonoidAlgebra.single (QuotientAddGroup.mk m : G ⧸ Z) 1 *
      AddMonoidAlgebra.single 0 (g a) = AddMonoidAlgebra.single 0 (g a) at h1
    rw [AddMonoidAlgebra.single_mul_single, add_zero, one_mul] at h1
    exact h1

/-- **Proposition 3.35**, on the attractor of Definition 3.1 and the fixed-point functor of §6
(`S = Spec R`, `X = Spec A`; the finite generation of `G` is not needed): the underlying point is a
bijection from `X^Z(C)` onto `X^{D(G/Z)}(C)`. -/
def attractorPtFixedEquiv (C : CommAlgCat.{u} R) :
    AttractorPt (gradedAction 𝒢) Z.toAddSubmonoid (op C) ≃
      (fixedPoints (quotientAction (gradedAction 𝒢) Z)).obj (op (op C)) :=
  (attractorPtEquiv 𝒢 Z.toAddSubmonoid C).trans <|
    (attractorFixedEquiv Z).trans <| Equiv.subtypeEquivRight fun g =>
      isFixedPoint_iff_mem_fixedPoints 𝒢 Z C g

end Fixed

end AlgMag
