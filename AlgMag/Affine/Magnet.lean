import Mathlib.RingTheory.GradedAlgebra.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Magnets and the ideal they cut out

Following Mayeux, *Algebraic Magnetism* (Semigroup Forum, DOI 10.1007/s00233-026-10645-3),
§3: a **magnet** of a commutative monoid `M` is by definition a submonoid `N ⊆ M`.

If `A` is an `M`-graded algebra, the magnet `N` cuts out the ideal `J_N` generated by
the homogeneous components `A_m` for `m ∉ N`; by Theorem 3.20 the attractor `X^N` is
the closed subscheme `Spec (A / J_N)`.
-/

namespace Magnetism

/-- A **magnet** of a commutative monoid `M` is, by definition, a submonoid of `M`. -/
abbrev Magnet (M : Type*) [AddCommMonoid M] := AddSubmonoid M

variable {M : Type*} [AddCommMonoid M]
variable {R₀ A : Type*} [CommRing R₀] [CommRing A] [Algebra R₀ A]

/-- The ideal `J_N ⊆ A` generated by the homogeneous components of degree outside
the magnet `N`. -/
def magnetIdeal (𝒜 : M → Submodule R₀ A) (N : Magnet M) : Ideal A :=
  Ideal.span (⋃ (m : M) (_ : m ∉ N), (𝒜 m : Set A))

variable {𝒜 : M → Submodule R₀ A} {N : Magnet M}

lemma mem_magnetIdeal_of_notMem {m : M} (hm : m ∉ N) {a : A} (ha : a ∈ 𝒜 m) :
    a ∈ magnetIdeal 𝒜 N :=
  Ideal.subset_span <| by
    simp only [Set.mem_iUnion, SetLike.mem_coe]
    exact ⟨m, hm, ha⟩

lemma magnetIdeal_le_of_notMem {m : M} (hm : m ∉ N) :
    (𝒜 m : Submodule R₀ A) ≤ (magnetIdeal 𝒜 N).restrictScalars R₀ :=
  fun _ ha => mem_magnetIdeal_of_notMem hm ha

end Magnetism
