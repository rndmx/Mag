import AlgMag.Affine.Attractor

/-!
# Theorem 3.20 (affine case): representability of the attractor

Mayeux, *Algebraic Magnetism*, Theorem 3.20, in the case `S = Spec R₀`, `X = Spec A`.

The attractor `X^N` is represented by the closed subscheme `Spec (A / J_N)`, where
`J_N` is the ideal generated by the homogeneous components of degree outside `N`.
Concretely we produce a bijection, natural in `C`,

  `Hom_{R₀}(A / J_N, C)  ≃  Hom_{R₀}^{M-graded}(A, C[N])`

which is the paper's pair `(Θ, Ψ)`.
-/

suppress_compilation

namespace Magnetism

open DirectSum

open scoped Classical

variable {M : Type*} [AddCommMonoid M] [DecidableEq M]
variable {R₀ A : Type*} [CommRing R₀] [CommRing A] [Algebra R₀ A]
variable (𝒜 : M → Submodule R₀ A) [GradedAlgebra 𝒜] (N : Magnet M)
variable (C : Type*) [CommRing C] [Algebra R₀ C]

local notation "J" => magnetIdeal 𝒜 N

section Theta

variable {𝒜 N C}
variable (F : (A ⧸ magnetIdeal 𝒜 N) →ₐ[R₀] C)

/-- The degree `m` component of the map `Θ F`: `a ↦ F [a] · X^m`, which is `0`
unless `m ∈ N`. -/
def thetaComponent (m : M) : 𝒜 m →ₗ[R₀] AddMonoidAlgebra C N where
  toFun a := if h : m ∈ N then
      AddMonoidAlgebra.single (⟨m, h⟩ : N) (F (Ideal.Quotient.mkₐ R₀ (magnetIdeal 𝒜 N) (a : A))) else 0
  map_add' a b := by by_cases h : m ∈ N <;> simp [h, AddMonoidAlgebra.single_add]
  map_smul' r a := by by_cases h : m ∈ N <;> simp [h, AddMonoidAlgebra.smul_single]

@[simp] lemma thetaComponent_apply_of_mem {m : M} (h : m ∈ N) (a : 𝒜 m) :
    thetaComponent F m a =
      AddMonoidAlgebra.single (⟨m, h⟩ : N) (F (Ideal.Quotient.mkₐ R₀ (magnetIdeal 𝒜 N) (a : A))) := by
  simp [thetaComponent, h]

@[simp] lemma thetaComponent_apply_of_notMem {m : M} (h : m ∉ N) (a : 𝒜 m) :
    thetaComponent F m a = 0 := by
  simp [thetaComponent, h]

variable (𝒜 N C)

/-- `Θ F` as a `R₀`-algebra map `A → C[N]`. -/
def thetaAlgHom : A →ₐ[R₀] AddMonoidAlgebra C N :=
  (DirectSum.toAlgebra R₀ (fun m => (𝒜 m : Submodule R₀ A)) (thetaComponent F)
    (by
      have h0 : (0 : M) ∈ N := N.zero_mem
      rw [thetaComponent_apply_of_mem F h0]
      simp only [SetLike.coe_gOne 𝒜, map_one]
      rw [AddMonoidAlgebra.one_def]
      rfl)
    (by
      rintro i j ai aj
      have hcoe := SetLike.coe_gMul 𝒜 ai aj
      by_cases hi : i ∈ N
      · by_cases hj : j ∈ N
        · have hij : i + j ∈ N := N.add_mem hi hj
          rw [thetaComponent_apply_of_mem F hi, thetaComponent_apply_of_mem F hj,
            thetaComponent_apply_of_mem F hij, AddMonoidAlgebra.single_mul_single]
          simp only [hcoe, map_mul]
          congr 1
        · rw [thetaComponent_apply_of_notMem F hj, mul_zero]
          by_cases hij : i + j ∈ N
          · rw [thetaComponent_apply_of_mem F hij, hcoe]
            have hz : Ideal.Quotient.mkₐ R₀ (magnetIdeal 𝒜 N)
                ((ai : A) * aj) = 0 := by
              rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
              exact Ideal.mul_mem_left _ _ (mem_magnetIdeal_of_notMem hj aj.2)
            rw [hz, map_zero, AddMonoidAlgebra.single_zero]
          · rw [thetaComponent_apply_of_notMem F hij]
      · rw [thetaComponent_apply_of_notMem F hi, zero_mul]
        by_cases hij : i + j ∈ N
        · rw [thetaComponent_apply_of_mem F hij, hcoe]
          have hz : Ideal.Quotient.mkₐ R₀ (magnetIdeal 𝒜 N)
              ((ai : A) * aj) = 0 := by
            rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
            exact Ideal.mul_mem_right _ _ (mem_magnetIdeal_of_notMem hi ai.2)
          rw [hz, map_zero, AddMonoidAlgebra.single_zero]
        · rw [thetaComponent_apply_of_notMem F hij])).comp
    (DirectSum.decomposeAlgEquiv 𝒜).toAlgHom

/-- The defining property of `Θ F` on homogeneous elements. -/
lemma thetaAlgHom_apply_of_mem {m : M} {a : A} (ha : a ∈ 𝒜 m) :
    thetaAlgHom 𝒜 N C F a = thetaComponent F m ⟨a, ha⟩ := by
  rw [thetaAlgHom, AlgHom.comp_apply,
    show (DirectSum.decomposeAlgEquiv 𝒜).toAlgHom a = DirectSum.of (fun i => 𝒜 i) m ⟨a, ha⟩ from
      DirectSum.decompose_of_mem 𝒜 ha]
  simp only [AlgHom.toRingHom_eq_coe, DirectSum.toAlgebra_apply]
  exact DirectSum.toSemiring_of _ _ _ _ _

/-- `Θ F : A → C[N]` is a morphism of `M`-graded algebras, i.e. a point of the
attractor. This is the map `Θ` of Theorem 3.20. -/
def theta : Attractor 𝒜 N C where
  __ := thetaAlgHom 𝒜 N C F
  map_mem' {m a} ha := by
    show thetaAlgHom 𝒜 N C F a ∈ magnetGrading N C m
    rw [thetaAlgHom_apply_of_mem 𝒜 N C F ha]
    by_cases h : m ∈ N
    · rw [thetaComponent_apply_of_mem F h]
      exact single_mem_magnetGrading _ _
    · rw [thetaComponent_apply_of_notMem F h]
      exact zero_mem _

@[simp] lemma theta_apply (a : A) : theta 𝒜 N C F a = thetaAlgHom 𝒜 N C F a := rfl

end Theta

section Psi

variable {𝒜 N C}
variable (f : Attractor 𝒜 N C)

/-- A graded map into `C[N]` kills every homogeneous component of degree outside `N`. -/
lemma attractor_apply_eq_zero_of_notMem {m : M} (hm : m ∉ N) {a : A} (ha : a ∈ 𝒜 m) :
    f a = 0 := by
  have h := f.map_mem ha
  rw [magnetGrading_eq_bot hm, Submodule.mem_bot] at h
  exact h

/-- The composite `A → C[N] → C` of `f` with the augmentation. -/
def psiAux : A →ₐ[R₀] C := ((magnetAug N C).restrictScalars R₀).comp f.toAlgHom

@[simp] lemma psiAux_apply (a : A) : psiAux f a = magnetAug N C (f a) := rfl

lemma psiAux_eq_zero_of_mem_magnetIdeal {a : A} (ha : a ∈ magnetIdeal 𝒜 N) :
    psiAux f a = 0 := by
  have hle : magnetIdeal 𝒜 N ≤ RingHom.ker ((psiAux f : A →ₐ[R₀] C) : A →+* C) := by
    rw [magnetIdeal, Ideal.span_le]
    rintro x hx
    simp only [Set.mem_iUnion, SetLike.mem_coe] at hx
    obtain ⟨m, hm, hxm⟩ := hx
    simp only [SetLike.mem_coe, RingHom.mem_ker, AlgHom.coe_toRingHom]
    rw [psiAux_apply, attractor_apply_eq_zero_of_notMem f hm hxm, map_zero]
  simpa only [RingHom.mem_ker, AlgHom.coe_toRingHom] using hle ha

/-- `Ψ f : A / J_N → C`, the map `Ψ` of Theorem 3.20. -/
def psi : (A ⧸ magnetIdeal 𝒜 N) →ₐ[R₀] C :=
  Ideal.Quotient.liftₐ _ (psiAux f) fun _ ha => psiAux_eq_zero_of_mem_magnetIdeal f ha

@[simp] lemma psi_mk (a : A) :
    psi f (Ideal.Quotient.mkₐ R₀ (magnetIdeal 𝒜 N) a) = magnetAug N C (f a) := rfl

end Psi

section Equiv

variable {𝒜 N C}

lemma psi_theta (F : (A ⧸ magnetIdeal 𝒜 N) →ₐ[R₀] C) : psi (theta 𝒜 N C F) = F := by
  refine AlgHom.ext fun x => ?_
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
  show psi (theta 𝒜 N C F) (Ideal.Quotient.mkₐ R₀ (magnetIdeal 𝒜 N) a) = _
  rw [psi_mk]
  induction a using DirectSum.Decomposition.inductionOn 𝒜 with
  | zero => simp
  | @homogeneous m x =>
      rw [theta_apply, thetaAlgHom_apply_of_mem 𝒜 N C F x.2]
      by_cases h : m ∈ N
      · rw [thetaComponent_apply_of_mem F h, magnetAug_single, Ideal.Quotient.mkₐ_eq_mk]
      · rw [thetaComponent_apply_of_notMem F h, map_zero]
        have hx0 : Ideal.Quotient.mk (magnetIdeal 𝒜 N) (x : A) = 0 := by
          rw [Ideal.Quotient.eq_zero_iff_mem]
          exact mem_magnetIdeal_of_notMem h x.2
        rw [hx0, map_zero]
  | add a a' ha ha' => simp only [map_add] at ha ha' ⊢; rw [ha, ha']

lemma theta_psi (f : Attractor 𝒜 N C) : theta 𝒜 N C (psi f) = f := by
  refine GradedAlgHom.ext fun a => ?_
  rw [theta_apply]
  induction a using DirectSum.Decomposition.inductionOn 𝒜 with
  | zero => simp
  | @homogeneous m x =>
      rw [thetaAlgHom_apply_of_mem 𝒜 N C (psi f) x.2]
      by_cases h : m ∈ N
      · rw [thetaComponent_apply_of_mem (psi f) h, psi_mk]
        obtain ⟨c, hc⟩ := exists_single_of_mem_magnetGrading h (f.map_mem x.2)
        rw [hc, magnetAug_single]
      · rw [thetaComponent_apply_of_notMem (psi f) h]
        exact (attractor_apply_eq_zero_of_notMem f h x.2).symm
  | add a a' ha ha' => simp only [map_add] at ha ha' ⊢; rw [ha, ha']

variable (𝒜 N C)

/-- **Theorem 3.20** (Mayeux, *Algebraic Magnetism*), affine case.

The attractor `X^N` of a magnet `N` is represented by the closed subscheme
`Spec (A / J_N)` of `X = Spec A`: there is a bijection, natural in the `R₀`-algebra `C`,

  `Hom_{R₀}(A / J_N, C) ≃ Hom_{R₀}^{M-graded}(A, C[N]) = X^N(C)`. -/
def attractorEquiv : ((A ⧸ magnetIdeal 𝒜 N) →ₐ[R₀] C) ≃ Attractor 𝒜 N C where
  toFun := theta 𝒜 N C
  invFun := psi
  left_inv := psi_theta
  right_inv := theta_psi

end Equiv

end Magnetism
