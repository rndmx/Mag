import Mathlib.AlgebraicGeometry.RelativeGluing
import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
import AlgMag.GeneralBaseAttractor
import AlgMag.GeneralBaseSheaf
import AlgMag.Representation

/-!
# Theorem 3.20 over an arbitrary base

Let `X → S` be affine, with an action of `𝔸(M)_S`, and `N` a magnet of `M`. The closed subschemes
`Spec (A_U / J_U)` of the charts `p⁻¹ U`, `U ⊆ S` affine, glue to a closed subscheme of `X` which
represents `X^N`.

## Main results

* `AlgMag.GB.Zatt`, `AlgMag.GB.iAtt`, `AlgMag.GB.instClosedIAtt`: the closed subscheme.
* `AlgMag.GB.attEquiv`, `AlgMag.GB.toPoint_attEquiv`, `AlgMag.GB.attEquiv_comp`,
  `AlgMag.GB.representsAttractor`: Theorem 3.20, representability.
* `AlgMag.GB.ker_iAtt_ideal`: Theorem 3.20, the ideal sheaf is generated by the `A_m`, `m ∉ N`.
-/

suppress_compilation

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry Magnetism

open scoped Classical

universe u

namespace AlgMag.GB

attribute [local instance] gradedAlgebraOf

variable {S : Scheme.{u}} {M : Type u} [AddCommMonoid M]
variable {X : Over S} [IsAffineHom X.hom] (act : AAction (overO S) M (yoneda.obj X))
variable (N : AddSubmonoid M)

section Local

variable {U : S.Opens} (hU : IsAffineOpen U)

/-- `A / J_N` as an algebra over `Γ(S, U)`. -/
abbrev Qalg : CommAlgCat.{u} Γ(S, U) :=
  CommAlgCat.of Γ(S, U) (Aalg X U ⧸ magnetIdeal (gradingOf hU act) N)

/-- The projection `A → A / J_N`. -/
def qAlg : Aalg X U →ₐ[Γ(S, U)] Qalg act N hU :=
  Ideal.Quotient.mkₐ _ (magnetIdeal (gradingOf hU act) N)

/-- `Z_U = Spec (A / J_N)`, over `S`. -/
abbrev Zloc : Over S := Phi hU (Qalg act N hU)

lemma liesOver_Zloc : LiesOver (Zloc act N hU) U := liesOver_Phi hU _

/-- The immersion `Z_U → X`, closed in `p⁻¹ U`. -/
def iLoc : Zloc act N hU ⟶ X := PhiMap hU (qAlg act N hU) ≫ iotaX X hU

instance : IsClosedImmersion (PhiMap hU (qAlg act N hU)).left :=
  IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective

lemma closedq : IsClosedImmersion (PhiMap hU (qAlg act N hU)).left := inferInstance

lemma qLeft_mono : Mono (PhiMap hU (qAlg act N hU)).left := by
  have : IsClosedImmersion (PhiMap hU (qAlg act N hU)).left := inferInstance
  infer_instance

instance : Mono (iLoc act N hU).left := by
  change Mono ((PhiMap hU (qAlg act N hU)).left ≫ (iotaX X hU).left)
  infer_instance

lemma iLoc_cancel {T : Over S} {f g : T ⟶ Zloc act N hU}
    (h : f ≫ iLoc act N hU = g ≫ iLoc act N hU) : f = g := by
  refine Over.OverMorphism.ext ?_
  rw [← cancel_mono (iLoc act N hU).left]
  exact congrArg (fun k : T ⟶ X => k.left) h

lemma ptX_comp_iota {T : Over S} (hT : LiesOver T U) (f : T ⟶ Phi hU (Aalg X U)) :
    ptX X hU T hT (f ≫ iotaX X hU) = homPhi hU T hT _ f := by
  change homPhi hU T hT _ (toChart X hU T hT ((toChart X hU T hT).symm f)) = _
  rw [Equiv.apply_symm_apply]

/-- **Theorem 3.20 over `U`**: `Z_U` represents `X^N` on schemes over `U`. -/
def repLoc {T : Over S} (hT : LiesOver T U) : (T ⟶ Zloc act N hU) ≃ AttractorPt act N T :=
  (homPhi hU T hT _).trans (localEquiv hU act N hT).symm

lemma toPoint_repLoc {T : Over S} (hT : LiesOver T U) (z : T ⟶ Zloc act N hU) :
    (repLoc act N hU hT z).toPoint = z ≫ iLoc act N hU := by
  apply (ptX X hU T hT).injective
  refine (ptX_toPoint_localEquiv_symm hU act N hT _).trans ?_
  have h1 : ptX X hU T hT (z ≫ iLoc act N hU) =
      homPhi hU T hT _ (z ≫ PhiMap hU (qAlg act N hU)) := by
    rw [iLoc, ← Category.assoc]
    exact ptX_comp_iota hU hT _
  rw [h1]
  refine AlgHom.ext fun a => ?_
  have h2 := homPhi_comp hU (liesOver_Phi hU (Qalg act N hU)) hT z (PhiMap hU (qAlg act N hU))
  rw [homPhi_PhiMap] at h2
  have h3 : homPhi hU T hT (Qalg act N hU) z =
      (gpull hU (liesOver_Phi hU (Qalg act N hU)) hT z).comp (eta hU (Qalg act N hU)) := by
    have := homPhi_comp hU (liesOver_Phi hU (Qalg act N hU)) hT z (𝟙 _)
    rwa [Category.comp_id] at this
  have h4 := DFunLike.congr_fun h2 a
  have h5 := DFunLike.congr_fun h3 (qAlg act N hU a)
  exact h5.trans h4.symm

/-- A point of `X` over `T`, lying over `U`, comes from `Z_U` iff it underlies a point of `X^N`. -/
lemma exists_lift_of_toPoint {T : Over S} (hT : LiesOver T U) (φ : AttractorPt act N T) :
    (repLoc act N hU hT).symm φ ≫ iLoc act N hU = φ.toPoint := by
  rw [← toPoint_repLoc act N hU hT, Equiv.apply_symm_apply]

end Local

section Glue

/-- The transition morphism `Z_U → Z_{U'}`, for `U ≤ U'`. -/
def trLoc {U U' : S.Opens} (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (h : U ≤ U') :
    Zloc act N hU ⟶ Zloc act N hU' :=
  (repLoc act N hU' ((liesOver_Zloc act N hU).mono h)).symm
    (repLoc act N hU (liesOver_Zloc act N hU) (𝟙 _))

lemma trLoc_iLoc {U U' : S.Opens} (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (h : U ≤ U') :
    trLoc act N hU hU' h ≫ iLoc act N hU' = iLoc act N hU := by
  rw [trLoc, exists_lift_of_toPoint, toPoint_repLoc, Category.id_comp]

lemma trLoc_trans {U U' U'' : S.Opens} (hU : IsAffineOpen U) (hU' : IsAffineOpen U')
    (hU'' : IsAffineOpen U'') (h1 : U ≤ U') (h2 : U' ≤ U'') (h3 : U ≤ U'') :
    trLoc act N hU hU'' h3 = trLoc act N hU hU' h1 ≫ trLoc act N hU' hU'' h2 := by
  refine iLoc_cancel act N _ ?_
  rw [Category.assoc, trLoc_iLoc, trLoc_iLoc, trLoc_iLoc]

/-- The structure morphism `Z_U → U`. -/
def zToU {U : S.Opens} (hU : IsAffineOpen U) : (Zloc act N hU).left ⟶ U.toScheme :=
  IsOpenImmersion.lift U.ι (Zloc act N hU).hom (by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨x, rfl⟩
    exact (liesOver_Zloc act N hU).mem x)

@[reassoc (attr := simp)]
lemma zToU_ι {U : S.Opens} (hU : IsAffineOpen U) : zToU act N hU ≫ U.ι = (Zloc act N hU).hom :=
  IsOpenImmersion.lift_fac _ _ _

lemma zSquare_w {U U' : S.Opens} (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (h : U ≤ U') :
    (trLoc act N hU hU' h).left ≫ zToU act N hU' = zToU act N hU ≫ S.homOfLE h := by
  rw [← cancel_mono U'.ι, Category.assoc, zToU_ι, Category.assoc, Scheme.homOfLE_ι, zToU_ι]
  exact Over.w (trLoc act N hU hU' h)

lemma zSquare_exists {U U' : S.Opens} (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (h : U ≤ U')
    {W : Scheme.{u}} (a : W ⟶ (Zloc act N hU').left) (b : W ⟶ U.toScheme)
    (hab : a ≫ zToU act N hU' = b ≫ S.homOfLE h) :
    ∃ m : W ⟶ (Zloc act N hU).left, m ≫ (trLoc act N hU hU' h).left = a ∧
      m ≫ zToU act N hU = b ∧ ∀ m' : W ⟶ (Zloc act N hU).left,
        m' ≫ (trLoc act N hU hU' h).left = a → m' ≫ zToU act N hU = b → m' = m := by
  let Tw : Over S := Over.mk (b ≫ U.ι)
  have hTw : LiesOver Tw U := liesOver_of_forall fun x => by
    have e : (b ≫ U.ι) x = U.ι (b x) := Scheme.Hom.comp_apply _ _ _
    change (b ≫ U.ι) x ∈ U
    rw [e]
    exact (b x).2
  have hw : a ≫ (Zloc act N hU').hom = b ≫ U.ι := by
    rw [← zToU_ι act N hU', ← Category.assoc, hab, Category.assoc, Scheme.homOfLE_ι]
  let a' : Tw ⟶ Zloc act N hU' := Over.homMk a hw
  let z : Tw ⟶ Zloc act N hU := (repLoc act N hU hTw).symm (repLoc act N hU' (hTw.mono h) a')
  have hz : z ≫ iLoc act N hU = a' ≫ iLoc act N hU' := by
    rw [exists_lift_of_toPoint, toPoint_repLoc]
  have hz2 : z ≫ trLoc act N hU hU' h = a' := by
    refine iLoc_cancel act N hU' ?_
    rw [Category.assoc, trLoc_iLoc, hz]
  refine ⟨z.left, congrArg (fun k => k.left) hz2, ?_, ?_⟩
  · rw [← cancel_mono U.ι, Category.assoc, zToU_ι]
    exact Over.w z
  · intro m' h1 h2
    have hm' : m' ≫ (Zloc act N hU).hom = Tw.hom := by
      rw [← zToU_ι act N hU, ← Category.assoc, h2]
      rfl
    let n : Tw ⟶ Zloc act N hU := Over.homMk m' hm'
    have : n = z := by
      refine iLoc_cancel act N hU ?_
      rw [hz, ← trLoc_iLoc act N hU hU' h, ← Category.assoc]
      congr 1
      exact Over.OverMorphism.ext h1
    exact congrArg (fun k => k.left) this

/-- The squares of the gluing datum are cartesian: `Z_U = Z_{U'} ×_{U'} U`. -/
lemma zSquare {U U' : S.Opens} (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (h : U ≤ U') :
    IsPullback (trLoc act N hU hU' h).left (zToU act N hU) (zToU act N hU') (S.homOfLE h) := by
  refine ⟨⟨zSquare_w act N hU hU' h⟩, ⟨PullbackCone.IsLimit.mk _
    (fun s => (zSquare_exists act N hU hU' h s.fst s.snd s.condition).choose) ?_ ?_ ?_⟩⟩
  · exact fun s => (zSquare_exists act N hU hU' h s.fst s.snd s.condition).choose_spec.1
  · exact fun s => (zSquare_exists act N hU hU' h s.fst s.snd s.condition).choose_spec.2.1
  · exact fun s m h1 h2 =>
      (zSquare_exists act N hU hU' h s.fst s.snd s.condition).choose_spec.2.2 m h1 h2

/-- The functor `U ↦ Z_U` on the affine opens of `S`. -/
def zFunctor : S.directedAffineCover.I₀ ⥤ Scheme.{u} where
  obj U := (Zloc act N (show S.affineOpens from U).2).left
  map {U U'} f := (trLoc act N (show S.affineOpens from U).2 (show S.affineOpens from U').2
    (leOfHom f)).left
  map_id U := by
    have : trLoc act N (show S.affineOpens from U).2 (show S.affineOpens from U).2 le_rfl = 𝟙 _ :=
      iLoc_cancel act N _ ((trLoc_iLoc act N _ _ _).trans (Category.id_comp _).symm)
    exact congrArg (fun k => k.left) this
  map_comp {U U' U''} f g := by
    have : trLoc act N (show S.affineOpens from U).2 (show S.affineOpens from U'').2
        (leOfHom (f ≫ g)) =
        trLoc act N (show S.affineOpens from U).2 (show S.affineOpens from U').2 (leOfHom f) ≫
          trLoc act N (show S.affineOpens from U').2 (show S.affineOpens from U'').2 (leOfHom g) :=
      trLoc_trans act N _ _ _ _ _ _
    exact congrArg (fun k => k.left) this

/-- The natural transformation of the gluing datum. -/
def zNat : zFunctor act N ⟶ S.directedAffineCover.functorOfLocallyDirected where
  app U := zToU act N (show S.affineOpens from U).2
  naturality {_ _} f := zSquare_w act N _ _ (leOfHom f)

/-- The gluing datum. -/
def zData : S.directedAffineCover.RelativeGluingData where
  functor := zFunctor act N
  natTrans := zNat act N
  equifibered {_ _} f := zSquare act N _ _ (leOfHom f)

/-- **Theorem 3.20**: the scheme `Z`, over `S`, obtained by gluing the `Spec (A_U / J_U)`. -/
def Zatt : Over S := Over.mk (zData act N).toBase

/-- The open immersion `Z_U → Z`. -/
def iotaZ (U : S.affineOpens) : Zloc act N U.2 ⟶ Zatt act N :=
  Over.homMk (colimit.ι (zData act N).functor U) (by
    refine ((zData act N).ι_toBase U).trans ?_
    exact zToU_ι act N U.2)

/-- The cocone of the `Z_U → X`. -/
def zCocone : Cocone (zData act N).functor where
  pt := X.left
  ι :=
    { app := fun U => (iLoc act N (show S.affineOpens from U).2).left
      naturality := fun {U U'} f => by
        have := trLoc_iLoc act N (show S.affineOpens from U).2
          (show S.affineOpens from U').2 (leOfHom f)
        refine (congrArg (fun k => k.left) this).trans (Category.comp_id _).symm }

/-- **Theorem 3.20**: the morphism `Z → X`. -/
def iAtt : Zatt act N ⟶ X :=
  Over.homMk (colimit.desc (zData act N).functor (zCocone act N))
    (by
      refine colimit.hom_ext fun U => ?_
      refine (Category.assoc _ _ _).symm.trans ?_
      refine (congrArg (· ≫ X.hom) (colimit.ι_desc (zCocone act N) U)).trans ?_
      refine Eq.trans ?_ ((zData act N).ι_toBase U).symm
      refine Eq.trans ?_ (zToU_ι act N (show S.affineOpens from U).2).symm
      exact Over.w (iLoc act N (show S.affineOpens from U).2))

@[reassoc]
lemma iotaZ_iAtt (U : S.affineOpens) : iotaZ act N U ≫ iAtt act N = iLoc act N U.2 := by
  refine Over.OverMorphism.ext ?_
  exact colimit.ι_desc _ _

/-- A morphism to `Z`, from a scheme over `U`, factors through `Z_U`. -/
lemma exists_lift_iotaZ (U : S.affineOpens) {T : Over S} (hT : LiesOver T U.1)
    (z : T ⟶ Zatt act N) : ∃ m : T ⟶ Zloc act N U.2, m ≫ iotaZ act N U = z := by
  have hpb := (zData act N).isPullback_natTrans_ι_toBase U
  let τ : T.left ⟶ U.1.toScheme := IsOpenImmersion.lift U.1.ι T.hom (by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨x, rfl⟩
    exact hT.mem x)
  have hτ : τ ≫ U.1.ι = T.hom := IsOpenImmersion.lift_fac _ _ _
  have hcond : τ ≫ U.1.ι = z.left ≫ (zData act N).toBase := by
    rw [hτ]
    exact (Over.w z).symm
  let m := hpb.lift τ z.left hcond
  have h1 : m ≫ zToU act N U.2 = τ := hpb.lift_fst _ _ _
  have h2 : m ≫ colimit.ι (zData act N).functor U = z.left := hpb.lift_snd _ _ _
  refine ⟨Over.homMk m ((congrArg (m ≫ ·) (zToU_ι act N U.2).symm).trans
    ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫ U.1.ι) h1).trans hτ))),
    Over.OverMorphism.ext h2⟩

/-- The chart square: `Z_U = Z ×_X Spec A_U`. -/
lemma isPullback_chart (U : S.affineOpens) :
    IsPullback (iotaZ act N U).left (PhiMap U.2 (qAlg act N U.2)).left (iAtt act N).left
      (iotaX X U.2).left := by
  have w : (iotaZ act N U).left ≫ (iAtt act N).left =
      (PhiMap U.2 (qAlg act N U.2)).left ≫ (iotaX X U.2).left :=
    congrArg (fun k => k.left) (iotaZ_iAtt act N U)
  have key : ∀ {W : Scheme.{u}} (a : W ⟶ (Zatt act N).left) (b : W ⟶ (Phi U.2 (Aalg X U.1)).left)
      (hab : a ≫ (iAtt act N).left = b ≫ (iotaX X U.2).left),
      ∃ m : W ⟶ (Zloc act N U.2).left, m ≫ (iotaZ act N U).left = a ∧
        m ≫ (PhiMap U.2 (qAlg act N U.2)).left = b := by
    intro W a b hab
    let Tw : Over S := Over.mk (b ≫ (Phi U.2 (Aalg X U.1)).hom)
    have hTw : LiesOver Tw U.1 := LiesOver.of_hom (Over.homMk b rfl) (liesOver_Phi U.2 _)
    have hw : a ≫ (Zatt act N).hom = Tw.hom := by
      have h1 := Over.w (iAtt act N)
      have h2 := Over.w (iotaX X U.2)
      change a ≫ (Zatt act N).hom = b ≫ (Phi U.2 (Aalg X U.1)).hom
      rw [← h1, ← h2, ← Category.assoc, hab, Category.assoc]
    let a' : Tw ⟶ Zatt act N := Over.homMk a hw
    let b' : Tw ⟶ Phi U.2 (Aalg X U.1) := Over.homMk b rfl
    obtain ⟨m, hm⟩ := exists_lift_iotaZ act N U hTw a'
    refine ⟨m.left, congrArg (fun k => k.left) hm, ?_⟩
    have h3 : m ≫ iLoc act N U.2 = b' ≫ iotaX X U.2 := by
      rw [← iotaZ_iAtt act N U, ← Category.assoc, hm]
      exact Over.OverMorphism.ext hab
    have h4 : (m ≫ PhiMap U.2 (qAlg act N U.2)) = b' := by
      have h5 := congrArg (toChart X U.2 Tw hTw) h3
      have h6 : ∀ g : Tw ⟶ Phi U.2 (Aalg X U.1), toChart X U.2 Tw hTw (g ≫ iotaX X U.2) = g :=
        fun g => (toChart X U.2 Tw hTw).apply_symm_apply g
      have e : m ≫ iLoc act N U.2 = (m ≫ PhiMap U.2 (qAlg act N U.2)) ≫ iotaX X U.2 :=
        (Category.assoc _ _ _).symm
      rw [e, h6, h6] at h5
      exact h5
    exact congrArg (fun k => k.left) h4
  refine ⟨⟨w⟩, ⟨PullbackCone.IsLimit.mk _
    (fun s => (key s.fst s.snd s.condition).choose) ?_ ?_ ?_⟩⟩
  · exact fun s => (key s.fst s.snd s.condition).choose_spec.1
  · exact fun s => (key s.fst s.snd s.condition).choose_spec.2
  · intro s m h1 h2
    have hm := qLeft_mono act N U.2
    rw [← cancel_mono (PhiMap U.2 (qAlg act N U.2)).left, h2]
    exact (key s.fst s.snd s.condition).choose_spec.2.symm

omit [IsAffineHom X.hom] in
lemma isOpen_iota [IsAffineHom X.hom] (U : S.affineOpens) : IsOpenImmersion (iotaX X U.2).left :=
  inferInstanceAs (IsOpenImmersion (isAffineOpen_preimage X U.2).fromSpec)

/-- The open cover of `X` by the charts `Spec A_U`. -/
def chartCover : X.left.OpenCover where
  I₀ := S.affineOpens
  X U := (Phi U.2 (Aalg X U.1)).left
  f U := (iotaX X U.2).left
  mem₀ := by
    rw [Scheme.presieve₀_mem_precoverage_iff]
    refine ⟨fun x => ?_, fun U => isOpen_iota U⟩
    obtain ⟨U, y, hy⟩ := S.directedAffineCover.exists_eq (X.hom x)
    let U' : S.affineOpens := U
    have hx : x ∈ X.hom ⁻¹ᵁ U'.1 := by
      change X.hom x ∈ U'.1
      rw [← hy]
      exact y.2
    have hr := range_iotaX X U'.2
    rw [← SetLike.mem_coe, ← hr] at hx
    obtain ⟨z, hz⟩ := hx
    exact ⟨U', z, hz⟩

/-- **Theorem 3.20**: `Z → X` is a closed immersion. -/
instance instClosedIAtt : IsClosedImmersion (iAtt act N).left := by
  refine IsZariskiLocalAtTarget.of_openCover (chartCover (X := X)) fun U => ?_
  let U' : S.affineOpens := U
  have hp := isPullback_chart act N U'
  have h1 : pullback.snd (iAtt act N).left (iotaX X U'.2).left =
      hp.isoPullback.inv ≫ (PhiMap U'.2 (qAlg act N U'.2)).left :=
    (Iso.inv_hom_id_assoc _ _).symm.trans (congrArg (hp.isoPullback.inv ≫ ·) hp.isoPullback_hom_snd)
  change IsClosedImmersion (pullback.snd (iAtt act N).left (iotaX X U'.2).left)
  rw [h1]
  have := closedq act N U'.2
  infer_instance

instance : Mono (iAtt act N).left := inferInstance

lemma iAtt_cancel {T : Over S} {f g : T ⟶ Zatt act N}
    (h : f ≫ iAtt act N = g ≫ iAtt act N) : f = g := by
  refine Over.OverMorphism.ext ?_
  rw [← cancel_mono (iAtt act N).left]
  exact congrArg (fun k : T ⟶ X => k.left) h

/-- For `T` over an affine open, the composites `T → Z → X` are the underlying points of `X^N(T)`. -/
lemma exists_toPoint_eq (U : S.affineOpens) {T : Over S} (hT : LiesOver T U.1)
    (z : T ⟶ Zatt act N) : ∃ φ : AttractorPt act N T, φ.toPoint = z ≫ iAtt act N := by
  obtain ⟨m, rfl⟩ := exists_lift_iotaZ act N U hT z
  refine ⟨repLoc act N U.2 hT m, ?_⟩
  exact (toPoint_repLoc act N U.2 hT m).trans
    ((congrArg (m ≫ ·) (iotaZ_iAtt act N U)).symm.trans (Category.assoc _ _ _).symm)

lemma exists_comp_eq (U : S.affineOpens) {T : Over S} (hT : LiesOver T U.1)
    (φ : AttractorPt act N T) : ∃ z : T ⟶ Zatt act N, z ≫ iAtt act N = φ.toPoint := by
  refine ⟨(repLoc act N U.2 hT).symm φ ≫ iotaZ act N U, ?_⟩
  rw [Category.assoc, iotaZ_iAtt]
  exact exists_lift_of_toPoint act N U.2 hT φ

/-- `X^N` is a sheaf for the Zariski topology (Proposition 3.2). -/
lemma isSheaf_att : Presieve.IsSheaf (Scheme.zariskiTopology.over S) (attractor act N) :=
  isSheaf_attractor act N _ (isSheaf_yoneda_over X)

variable {act N} in
/-- Two points of `X^N(T)` with the same underlying point are equal, for any `T` over `S`. -/
theorem toPoint_injective_global {T : Over S} :
    Function.Injective (AttractorPt.toPoint (act := act) (N := N) (T := T)) := by
  intro φ φ' h
  refine ((isSheaf_att act N) _ (sieveU_mem T)).isSeparatedFor.ext fun W f hf => ?_
  obtain ⟨U, hU⟩ := hf
  refine toPoint_injective U.2 act hU ?_
  change (φ.baseChange f).toPoint = (φ'.baseChange f).toPoint
  rw [toPoint_baseChange, toPoint_baseChange, h]

/-- The point of `X^N(T)` of a morphism `T → Z`. -/
theorem exists_att_of_hom {T : Over S} (z : T ⟶ Zatt act N) :
    ∃ φ : AttractorPt act N T, φ.toPoint = z ≫ iAtt act N := by
  have sh := (isSheaf_att act N) _ (sieveU_mem T)
  let x : Presieve.FamilyOfElements (attractor act N) (sieveU T).arrows := fun W f hf =>
    (exists_toPoint_eq act N hf.choose hf.choose_spec (f ≫ z)).choose
  have hx : ∀ {W} (f : W ⟶ T) (hf : (sieveU T).arrows f),
      AttractorPt.toPoint (x f hf) = f ≫ z ≫ iAtt act N := fun f hf => by
    rw [← Category.assoc]
    exact (exists_toPoint_eq act N hf.choose hf.choose_spec (f ≫ z)).choose_spec
  have hc : x.Compatible := by
    intro W₁ W₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
    refine toPoint_injective_global ?_
    change ((x f₁ h₁).baseChange g₁).toPoint = ((x f₂ h₂).baseChange g₂).toPoint
    rw [toPoint_baseChange, toPoint_baseChange, hx f₁ h₁, hx f₂ h₂, ← Category.assoc, ← Category.assoc g₂, comm]
  let φ : AttractorPt act N T := sh.amalgamate x hc
  refine ⟨φ, ?_⟩
  refine ((isSheaf_yoneda_over X) _ (sieveU_mem T)).isSeparatedFor.ext fun W f hf => ?_
  change f ≫ φ.toPoint = f ≫ z ≫ iAtt act N
  rw [← toPoint_baseChange, ← hx f hf]
  exact congrArg AttractorPt.toPoint (sh.valid_glue hc f hf)

/-- The morphism `T → Z` of a point of `X^N(T)`. -/
theorem exists_hom_of_att {T : Over S} (φ : AttractorPt act N T) :
    ∃ z : T ⟶ Zatt act N, z ≫ iAtt act N = φ.toPoint := by
  have sh := (isSheaf_yoneda_over (Zatt act N)) _ (sieveU_mem T)
  let x : Presieve.FamilyOfElements (yoneda.obj (Zatt act N)) (sieveU T).arrows := fun W f hf =>
    (exists_comp_eq act N hf.choose hf.choose_spec (φ.baseChange f)).choose
  have hx : ∀ {W} (f : W ⟶ T) (hf : (sieveU T).arrows f),
      (show W ⟶ Zatt act N from x f hf) ≫ iAtt act N = f ≫ φ.toPoint := fun f hf => by
    rw [← toPoint_baseChange]
    exact (exists_comp_eq act N hf.choose hf.choose_spec (φ.baseChange f)).choose_spec
  have hc : x.Compatible := by
    intro W₁ W₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
    refine iAtt_cancel act N (T := Z) ?_
    change (g₁ ≫ (show W₁ ⟶ Zatt act N from x f₁ h₁)) ≫ iAtt act N =
      (g₂ ≫ (show W₂ ⟶ Zatt act N from x f₂ h₂)) ≫ iAtt act N
    rw [Category.assoc, Category.assoc, hx f₁ h₁, hx f₂ h₂, ← Category.assoc, ← Category.assoc g₂, comm]
  let z : T ⟶ Zatt act N := sh.amalgamate x hc
  refine ⟨z, ?_⟩
  refine ((isSheaf_yoneda_over X) _ (sieveU_mem T)).isSeparatedFor.ext fun W f hf => ?_
  change f ≫ z ≫ iAtt act N = f ≫ φ.toPoint
  rw [← Category.assoc, ← hx f hf]
  exact congrArg (· ≫ iAtt act N) (sh.valid_glue hc f hf)

/-- **Theorem 3.20**, representability. For `X → S` affine with an action of `𝔸(M)_S`, and any `N`,
the closed subscheme `Z` of `X` represents the functor `X^N` of Definition 3.1, on all schemes over
`S`. -/
def attEquiv (T : Over S) : (T ⟶ Zatt act N) ≃ AttractorPt act N T :=
  Equiv.ofBijective (fun z => (exists_att_of_hom act N z).choose)
    ⟨fun z z' h => iAtt_cancel act N (by
        rw [← (exists_att_of_hom act N z).choose_spec, ← (exists_att_of_hom act N z').choose_spec]
        exact congrArg AttractorPt.toPoint h),
      fun φ => by
        obtain ⟨z, hz⟩ := exists_hom_of_att act N φ
        refine ⟨z, toPoint_injective_global ?_⟩
        rw [(exists_att_of_hom act N z).choose_spec, hz]⟩

/-- **Theorem 3.20**: the map `X^N → X` is the closed immersion `Z → X`. -/
theorem toPoint_attEquiv {T : Over S} (z : T ⟶ Zatt act N) :
    (attEquiv act N T z).toPoint = z ≫ iAtt act N :=
  (exists_att_of_hom act N z).choose_spec

/-- **Theorem 3.20**: the representation is natural. -/
theorem attEquiv_comp {T T' : Over S} (s : T' ⟶ T) (z : T ⟶ Zatt act N) :
    attEquiv act N T' (s ≫ z) = (attEquiv act N T z).baseChange s := by
  refine toPoint_injective_global ?_
  rw [toPoint_baseChange, toPoint_attEquiv, toPoint_attEquiv, Category.assoc]

/-- **Theorem 3.20** in the language of `AlgMag.Representation`. -/
def representsAttractor : RepresentsAttractor act N (yoneda.obj (Zatt act N)) where
  equiv T := attEquiv act N T
  naturality s z := attEquiv_comp act N s z

/-- A morphism `T → X` factors through `Z` exactly when it underlies a point of `X^N(T)`. -/
theorem exists_lift_iff {T : Over S} (t : T ⟶ X) :
    (∃ z : T ⟶ Zatt act N, z ≫ iAtt act N = t) ↔
      ∃ φ : AttractorPt act N T, φ.toPoint = t :=
  ⟨fun ⟨z, hz⟩ => ⟨attEquiv act N T z, by rw [toPoint_attEquiv, hz]⟩,
    fun ⟨φ, hφ⟩ => ⟨(attEquiv act N T).symm φ, by
      rw [← toPoint_attEquiv, Equiv.apply_symm_apply, hφ]⟩⟩

end Glue

