import AlgMag.Sec9General
import AlgMag.GeneralBaseCor

/-!
# Proposition 2.22 over an arbitrary base, and the ideal sheaf of Theorem 3.20

Mayeux, *Algebraic Magnetism*, Semigroup Forum 113 (2026) 126–201, Proposition 2.22, Theorem 3.20.

Let `p : X → S` be affine. An `M`-grading of the quasi-coherent algebra `p_* 𝒪_X` is a family of
`M`-gradings of the algebras `Γ(X, p⁻¹ U)`, `U ⊆ S` affine open, compatible with restriction.

## Main results

* `AlgMag.GB.GlobalGrading`: `M`-gradings of `p_* 𝒪_X`.
* `AlgMag.GB.actionEquivGrading`: Proposition 2.22, both directions.
* `AlgMag.GB.isLeast_ker_iAtt`: Theorem 3.20, the ideal sheaf of `X^N` is generated by the `A_m`,
  `m ∉ N`, as a global statement.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry Magnetism

open scoped Classical

universe u

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.deprecated false
set_option linter.style.haveILetI false

namespace AlgMag.GB

attribute [local instance] gradedAlgebraOf

variable {S : Scheme.{u}} {M : Type u} [AddCommMonoid M] {X : Over S} [IsAffineHom X.hom]

/-- The restriction `Γ(X, p⁻¹ U) → Γ(X, p⁻¹ U')`, for `U' ≤ U`. -/
def resA (X : Over S) {U U' : S.Opens} (h : U' ≤ U) : Aalg X U →+* Aalg X U' :=
  (X.left.presheaf.map (homOfLE (X.hom.preimage_mono h)).op).hom

/-- `ptX` is compatible with the restriction of sections. -/
lemma ptX_resA {U U' : S.Opens} (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (h : U' ≤ U)
    {T : Over S} (hT' : LiesOver T U') (f : T ⟶ X) (a : Aalg X U) :
    ptX X hU' T hT' f (resA X h a) = ptX X hU T (hT'.mono h) f a := by
  have e' : (⊤ : T.left.Opens) ≤ f.left ⁻¹ᵁ X.hom ⁻¹ᵁ U' := by
    intro x _
    change X.hom (f.left x) ∈ U'
    rw [← Scheme.Hom.comp_apply, Over.w f]
    exact hT'.mem x
  have e : (⊤ : T.left.Opens) ≤ f.left ⁻¹ᵁ X.hom ⁻¹ᵁ U := fun x hx => h (e' hx)
  refine (appLE_eq_ptX hU' hT' f e' _).symm.trans (Eq.trans ?_ (appLE_eq_ptX hU (hT'.mono h) f e a))
  have := Scheme.Hom.map_appLE f.left (U := X.hom ⁻¹ᵁ U') (V := ⊤) e' (homOfLE (X.hom.preimage_mono h)).op
  exact congrArg (fun k => k.hom a) this

/-- **Proposition 2.22**: an `M`-grading `A = ⨁ A_m` of the quasi-coherent `𝒪_S`-algebra `p_* 𝒪_X`. -/
@[ext]
structure GlobalGrading (X : Over S) [IsAffineHom X.hom] (M : Type u) [AddCommMonoid M] where
  /-- `A_m(U)` -/
  comp : ∀ U : S.affineOpens, M → Submodule Γ(S, U.1) (Aalg X U.1)
  internal : ∀ U, DirectSum.IsInternal (comp U)
  one_mem : ∀ U, (1 : Aalg X U.1) ∈ comp U 0
  mul_mem : ∀ U {i j : M} {a b : Aalg X U.1}, a ∈ comp U i → b ∈ comp U j → a * b ∈ comp U (i + j)
  res_mem : ∀ {U U' : S.affineOpens} (h : U'.1 ≤ U.1) {m : M} {a : Aalg X U.1},
    a ∈ comp U m → resA X h a ∈ comp U' m

/-- The criterion of membership in the grading of an action: `a ∈ A_m` iff `h` acts on `a` through
`h(m)`. -/
lemma mem_gradingOf_of_forall {U : S.Opens} (hU : IsAffineOpen U)
    (act : AAction (overO S) M (yoneda.obj X)) {m : M} {a : Aalg X U}
    (H : ∀ {T : Over S} (hT : LiesOver T U) (h : APt (overO S) M (op T)) (x : T ⟶ X),
      ptX X hU T hT (act.smul h x) a = toGa hU hT h (Multiplicative.ofAdd m) * ptX X hU T hT x a) :
    a ∈ gradingOf hU act m := by
  rw [gradingOf, mem_coactGrading]
  refine (eta_bijective hU (Aover X U M)).1 ?_
  have h1 := H (liesOver_Phi hU (Aover X U M)) (hUniv hU X) (xConst hU X M)
  have h2 := DFunLike.congr_fun (eta_rho hU X act) a
  refine h2.trans (h1.trans ?_)
  have e : ptX X hU _ (liesOver_Phi hU (Aover X U M)) (xConst hU X M) =
      (eta hU (Aover X U M)).comp (constAlg M (Aalg X U)) := Equiv.apply_symm_apply _ _
  rw [e]
  refine (map_mul (eta hU (Aover X U M)) (AddMonoidAlgebra.single m 1)
    (AddMonoidAlgebra.single 0 a)).symm.trans ?_
  rw [AddMonoidAlgebra.single_mul_single, add_zero, one_mul]

variable (act : AAction (overO S) M (yoneda.obj X))

/-- **Proposition 2.22**, from an action to a grading. -/
def globalGradingOf : GlobalGrading X M where
  comp U := gradingOf U.2 act
  internal U :=
    letI := gradedAlgebraOf U.2 act
    DirectSum.Decomposition.isInternal _
  one_mem U :=
    letI := gradedAlgebraOf U.2 act
    SetLike.GradedOne.one_mem
  mul_mem U _ _ _ _ ha hb :=
    letI := gradedAlgebraOf U.2 act
    SetLike.GradedMul.mul_mem ha hb
  res_mem {U U'} h m a ha := by
    refine mem_gradingOf_of_forall U'.2 act fun {T} hT g x => ?_
    rw [ptX_resA U.2 U'.2 h, ptX_resA U.2 U'.2 h]
    exact ptX_smul_of_mem U.2 act (hT.mono h) g x ha

section Inverse

variable (G : GlobalGrading X M)

/-- The grading of `Γ(X, p⁻¹ U)`. -/
@[reducible] def GlobalGrading.graded (U : S.affineOpens) : GradedAlgebra (G.comp U) where
  one_mem := G.one_mem U
  mul_mem := fun _ _ _ _ ha hb => G.mul_mem U ha hb
  toDecomposition := (G.internal U).chooseDecomposition

/-- The action, locally: for `T` over `U`, `h • x` is `a ↦ h(m) x(a)` on `A_m(U)`. -/
def smLoc (U : S.affineOpens) {T : Over S} (hT : LiesOver T U.1) (h : APt (overO S) M (op T))
    (x : T ⟶ X) : T ⟶ X :=
  letI := G.graded U
  (ptX X U.2 T hT).symm (gradedSmul (D := Ga U.2 T hT) (G.comp U) (toGa U.2 hT h) (ptX X U.2 T hT x))

lemma ptX_smLoc (U : S.affineOpens) {T : Over S} (hT : LiesOver T U.1)
    (h : APt (overO S) M (op T)) (x : T ⟶ X) {m : M} {a : Aalg X U.1} (ha : a ∈ G.comp U m) :
    ptX X U.2 T hT (smLoc G U hT h x) a =
      toGa U.2 hT h (Multiplicative.ofAdd m) * ptX X U.2 T hT x a := by
  letI := G.graded U
  rw [smLoc, Equiv.apply_symm_apply]
  exact gradedSmul_apply_of_mem (D := Ga U.2 T hT) (G.comp U) _ _ ha

/-- Uniqueness of the local action: it is determined by its values on the components. -/
lemma eq_smLoc (U : S.affineOpens) {T : Over S} (hT : LiesOver T U.1)
    (h : APt (overO S) M (op T)) (x y : T ⟶ X)
    (H : ∀ (m : M) (a : Aalg X U.1), a ∈ G.comp U m →
      ptX X U.2 T hT y a = toGa U.2 hT h (Multiplicative.ofAdd m) * ptX X U.2 T hT x a) :
    y = smLoc G U hT h x := by
  letI := G.graded U
  apply (ptX X U.2 T hT).injective
  refine algHom_ext_of_homogeneous (D := Ga U.2 T hT) (G.comp U) fun m a ha => ?_
  rw [H m a ha, ptX_smLoc G U hT h x ha]

lemma smLoc_comp (U : S.affineOpens) {T T' : Over S} (hT : LiesOver T U.1) (hT' : LiesOver T' U.1)
    (s : T' ⟶ T) (h : APt (overO S) M (op T)) (x : T ⟶ X) :
    s ≫ smLoc G U hT h x = smLoc G U hT' (APt.res s.op h) (s ≫ x) := by
  refine eq_smLoc G U hT' _ _ _ fun m a ha => ?_
  rw [ptX_comp X U.2 hT hT', ptX_comp X U.2 hT hT']
  change (s.left.appTop).hom (ptX X U.2 T hT (smLoc G U hT h x) a) = _
  rw [ptX_smLoc G U hT h x ha]
  exact map_mul (s.left.appTop).hom _ _

/-- For `U' ≤ U`, the local actions over `U'` and `U` agree on schemes over `U'`. -/
lemma smLoc_mono {U U' : S.affineOpens} (hle : U'.1 ≤ U.1) {T : Over S} (hT' : LiesOver T U'.1)
    (h : APt (overO S) M (op T)) (x : T ⟶ X) :
    smLoc G U' hT' h x = smLoc G U (hT'.mono hle) h x := by
  refine eq_smLoc G U (hT'.mono hle) h x _ fun m a ha => ?_
  rw [← ptX_resA U.2 U'.2 hle hT', ← ptX_resA U.2 U'.2 hle hT']
  exact ptX_smLoc G U' hT' h x (G.res_mem hle ha)

/-- Two morphisms over `T` lying over two opens agree if they do over each affine open contained in
both. -/
lemma hom_ext_of_two {U₁ U₂ : S.Opens} {T Y : Over S} (h₁ : LiesOver T U₁) (h₂ : LiesOver T U₂)
    {y y' : T ⟶ Y}
    (H : ∀ (U : S.affineOpens) (_ : U.1 ≤ U₁) (_ : U.1 ≤ U₂) (W : Over S) (_ : LiesOver W U.1)
      (s : W ⟶ T), s ≫ y = s ≫ y') : y = y' := by
  let ι := {U : S.affineOpens // U.1 ≤ U₁ ∧ U.1 ≤ U₂}
  let V : ι → T.left.Opens := fun U => T.hom ⁻¹ᵁ U.1.1
  have hV : TopologicalSpace.IsOpenCover V := by
    refine top_le_iff.mp fun x _ => ?_
    have hx : T.hom x ∈ U₁ ⊓ U₂ := ⟨h₁.mem x, h₂.mem x⟩
    obtain ⟨_, ⟨W, hW, rfl⟩, hxW, hle⟩ :=
      S.isBasis_affineOpens.exists_subset_of_mem_open hx (U₁ ⊓ U₂).2
    refine TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨⟨W, hW⟩, fun z hz => (hle hz).1,
      fun z hz => (hle hz).2⟩, hxW⟩
  let 𝒰 : Scheme.OpenCover.{u} T.left := T.left.openCoverOfIsOpenCover V hV
  refine ((isSheaf_yoneda_over Y) _ (S9.coverSieve_mem T 𝒰)).isSeparatedFor.ext fun W f hf => ?_
  obtain ⟨i, u, hu⟩ := hf
  refine H i.1 i.2.1 i.2.2 W (liesOver_of_forall fun x => ?_) f
  have e : W.hom = f.left ≫ T.hom := (Over.w f).symm
  have hu' : f.left x = (V i).ι (u x) := by
    rw [hu]
    exact Scheme.Hom.comp_apply _ _ _
  rw [e, Scheme.Hom.comp_apply, hu']
  exact (u x).2

/-- The local actions agree. -/
lemma smLoc_indep (U U' : S.affineOpens) {T : Over S} (hT : LiesOver T U.1) (hT' : LiesOver T U'.1)
    (h : APt (overO S) M (op T)) (x : T ⟶ X) :
    smLoc G U hT h x = smLoc G U' hT' h x := by
  refine hom_ext_of_two hT hT' fun U'' h1 h2 W hW s => ?_
  rw [smLoc_comp G U hT (hW.mono h1), smLoc_comp G U' hT' (hW.mono h2),
    ← smLoc_mono G h1 hW, ← smLoc_mono G h2 hW]

/-- The action of the grading on arbitrary points, glued from the affine opens of `S`. -/
theorem exists_smul {T : Over S} (h : APt (overO S) M (op T)) (x : T ⟶ X) :
    ∃ y : T ⟶ X, ∀ (U : S.affineOpens) {W : Over S} (hW : LiesOver W U.1) (s : W ⟶ T),
      s ≫ y = smLoc G U hW (APt.res s.op h) (s ≫ x) := by
  have sh := (isSheaf_yoneda_over X) _ (sieveU_mem T)
  let v : Presieve.FamilyOfElements (yoneda.obj X) (sieveU T).arrows := fun W f hf =>
    smLoc G hf.choose hf.choose_spec (APt.res f.op h) (f ≫ x)
  have hc : v.Compatible := by
    intro W₁ W₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
    change g₁ ≫ smLoc G _ _ _ _ = g₂ ≫ smLoc G _ _ _ _
    have hZ₁ : LiesOver Z h₁.choose.1 := h₁.choose_spec.of_hom g₁
    have hZ₂ : LiesOver Z h₂.choose.1 := h₂.choose_spec.of_hom g₂
    rw [smLoc_comp G _ h₁.choose_spec hZ₁, smLoc_comp G _ h₂.choose_spec hZ₂]
    have e1 : APt.res g₁.op (APt.res f₁.op h) = APt.res g₂.op (APt.res f₂.op h) := by
      rw [← APt.res_comp, ← APt.res_comp, ← op_comp, ← op_comp, comm]
    have e2 : g₁ ≫ f₁ ≫ x = g₂ ≫ f₂ ≫ x := by
      rw [← Category.assoc, ← Category.assoc, comm]
    rw [e1, e2]
    exact smLoc_indep G _ _ hZ₁ hZ₂ _ _
  refine ⟨sh.amalgamate v hc, fun U W hW s => ?_⟩
  have hs : (sieveU T).arrows s := ⟨U, hW⟩
  exact (sh.valid_glue hc s hs).trans (smLoc_indep G _ _ hs.choose_spec hW _ _)

/-- The action of the grading. -/
def gsmul {T : Over S} (h : APt (overO S) M (op T)) (x : T ⟶ X) : T ⟶ X :=
  (exists_smul G h x).choose

lemma comp_gsmul {T : Over S} (h : APt (overO S) M (op T)) (x : T ⟶ X) (U : S.affineOpens)
    {W : Over S} (hW : LiesOver W U.1) (s : W ⟶ T) :
    s ≫ gsmul G h x = smLoc G U hW (APt.res s.op h) (s ≫ x) :=
  (exists_smul G h x).choose_spec U hW s

lemma over_hom_ext {T Y : Over S} {y y' : T ⟶ Y}
    (H : ∀ (U : S.affineOpens) (W : Over S) (_ : LiesOver W U.1) (s : W ⟶ T),
      s ≫ y = s ≫ y') : y = y' :=
  ((isSheaf_yoneda_over Y) _ (sieveU_mem T)).isSeparatedFor.ext fun W f hf => by
    obtain ⟨U, hU⟩ := hf
    exact H U W hU f

lemma gsmul_local {T : Over S} (h : APt (overO S) M (op T)) (x : T ⟶ X) (U : S.affineOpens)
    (hT : LiesOver T U.1) : gsmul G h x = smLoc G U hT h x := by
  have := comp_gsmul G h x U hT (𝟙 T)
  simpa using this

lemma res_id' {T : Over S} (h : APt (overO S) M (op T)) : APt.res (𝟙 T).op h = h := by
  rw [op_id]
  exact APt.res_id h

/-- **Proposition 2.22**, from a grading to an action. -/
def actionOfGrading : AAction (overO S) M (yoneda.obj X) where
  smul {U} h x := gsmul G (T := unop U) h x
  one_smul {U} x := by
    refine over_hom_ext fun V W hW s => ?_
    change s ≫ gsmul G (T := unop U) 1 x = _
    rw [comp_gsmul G _ _ V hW]
    refine (eq_smLoc G V hW _ _ _ fun m a ha => ?_).symm
    have : toGa V.2 hW (APt.res s.op (1 : APt (overO S) M (op (unop U))))
        (Multiplicative.ofAdd m) = 1 := map_one ((overO S).map s.op).hom
    rw [this, one_mul]
  mul_smul {U} g h x := by
    refine over_hom_ext fun V W hW s => ?_
    change s ≫ gsmul G (T := unop U) (g * h) x = s ≫ gsmul G (T := unop U) g (gsmul G (T := unop U) h x)
    rw [comp_gsmul G _ _ V hW, comp_gsmul G _ _ V hW, comp_gsmul G _ _ V hW]
    refine (eq_smLoc G V hW _ _ _ fun m a ha => ?_).symm
    rw [ptX_smLoc G V hW _ _ ha, ptX_smLoc G V hW _ _ ha, ← mul_assoc]
    congr 1
    exact (map_mul ((overO S).map s.op).hom _ _).symm
  map_smul {U V} f h x := by
    refine over_hom_ext fun V' W hW s => ?_
    change s ≫ f.unop ≫ gsmul G (T := unop U) h x =
      s ≫ gsmul G (T := unop V) (APt.res f h) (f.unop ≫ x)
    rw [← Category.assoc, comp_gsmul G _ _ V' hW, comp_gsmul G _ _ V' hW, Category.assoc]
    exact congrArg (fun k => smLoc G V' hW k _) (APt.res_comp f s.op h)

end Inverse

lemma AAction.ext' {A B : AAction (overO S) M (yoneda.obj X)}
    (h : ∀ {T : Over S} (g : APt (overO S) M (op T)) (x : T ⟶ X),
      A.smul (U := op T) g x = B.smul (U := op T) g x) : A = B := by
  cases A with
  | mk a _ _ _ =>
    cases B with
    | mk b _ _ _ =>
      have : @a = @b := by
        funext U g x
        exact h (T := unop U) g x
      subst this
      rfl

/-- Gradings of the same module are equal if one is contained in the other. -/
lemma eq_of_le_internal {R A : Type*} [CommRing R] [AddCommGroup A] [Module R A]
    {𝒜 ℬ : M → Submodule R A} (h𝒜 : DirectSum.IsInternal 𝒜) (hℬ : DirectSum.IsInternal ℬ)
    (hle : ∀ m, 𝒜 m ≤ ℬ m) : 𝒜 = ℬ := by
  funext m
  refine le_antisymm (hle m) fun b hb => ?_
  obtain ⟨y, hy⟩ := h𝒜.2 b
  let φ : DirectSum M (fun k => 𝒜 k) →+ DirectSum M (fun k => ℬ k) :=
    DirectSum.toAddMonoid fun k => (DirectSum.of (fun k => ℬ k) k).comp
      (Submodule.inclusion (hle k)).toAddMonoidHom
  have h1 : ∀ z, DirectSum.coeAddMonoidHom ℬ (φ z) = DirectSum.coeAddMonoidHom 𝒜 z := by
    intro z
    induction z using DirectSum.induction_on with
    | zero => simp
    | of k x => simp [φ]
    | add p q hp hq => simp only [map_add, hp, hq]
  have h2 : ∀ (z) (k : M), ((φ z) k : A) = (z k : A) := by
    intro z k
    induction z using DirectSum.induction_on with
    | zero => simp
    | of j x =>
      by_cases e : j = k
      · subst e
        simp [φ]
      · simp [φ, DirectSum.of_eq_of_ne _ _ _ (Ne.symm e)]
    | add p q hp hq => simp [hp, hq]
  have h3 : φ y = DirectSum.of (fun k => ℬ k) m ⟨b, hb⟩ := by
    apply hℬ.1
    rw [h1, hy]
    simp
  have h4 := h2 y m
  rw [h3] at h4
  simp at h4
  rw [h4]
  exact (y m).2

variable (X M) in
/-- **Proposition 2.22**: for `p : X → S` affine, actions of `𝔸(M)_S` on `X` correspond to `M`-gradings
of the quasi-coherent `𝒪_S`-algebra `p_* 𝒪_X`, with `S` any scheme and `M` any commutative monoid. -/
def actionEquivGrading : AAction (overO S) M (yoneda.obj X) ≃ GlobalGrading X M where
  toFun := globalGradingOf
  invFun := actionOfGrading
  left_inv act := by
    refine AAction.ext' fun {T} g x => ?_
    refine over_hom_ext fun U W hW s => ?_
    change s ≫ gsmul (globalGradingOf act) g x = s ≫ act.smul (U := op T) g x
    rw [comp_gsmul _ _ _ U hW]
    have hm : s ≫ act.smul (U := op T) g x = act.smul (U := op W) (APt.res s.op g) (s ≫ x) :=
      act.map_smul s.op g x
    rw [hm]
    refine (eq_smLoc _ U hW _ _ _ fun m a ha => ?_).symm
    exact ptX_smul_of_mem U.2 act hW _ _ ha
  right_inv G := by
    refine GlobalGrading.ext ?_
    funext U
    refine (eq_of_le_internal (G.internal U) ((globalGradingOf (actionOfGrading G)).internal U)
      fun m a ha => ?_).symm
    refine mem_gradingOf_of_forall U.2 _ fun {T} hT g x => ?_
    change ptX X U.2 T hT (gsmul G g x) a = _
    rw [gsmul_local G g x U hT]
    exact ptX_smLoc G U hT g x ha

/-- **Proposition 2.22**: the grading of an action on points: `h • x` is `h(m) x` on `A_m`. -/
theorem actionEquivGrading_comp (act : AAction (overO S) M (yoneda.obj X)) (U : S.affineOpens) :
    (actionEquivGrading M X act).comp U = gradingOf U.2 act := rfl

/-- **Theorem 3.20**, the ideal sheaf, globally: the ideal sheaf of the closed subscheme `X^N` of `X`
is the ideal sheaf generated by `{A_m | m ∉ N}`, that is, the smallest ideal sheaf of `X` containing
the sections `A_m(U) ⊆ Γ(X, p⁻¹ U)`, `U ⊆ S` affine open, `m ∉ N`. -/
theorem isLeast_ker_iAtt (act : AAction (overO S) M (yoneda.obj X)) (N : AddSubmonoid M) :
    IsLeast {I : X.left.IdealSheafData | ∀ (U : S.affineOpens) (m : M), m ∉ N →
      ∀ a ∈ (actionEquivGrading M X act).comp U m,
        a ∈ I.ideal ⟨X.hom ⁻¹ᵁ U.1, isAffineOpen_preimage X U.2⟩}
      (iAtt act N).left.ker := by
  constructor
  · intro U m hm a ha
    rw [ker_iAtt_ideal]
    exact Ideal.subset_span (Set.mem_iUnion₂.mpr ⟨m, hm, ha⟩)
  · intro I hI
    rw [← sup_eq_right]
    refine Scheme.IdealSheafData.ext_of_iSup_eq_top _ (iSup_chart (X := X)) fun U => ?_
    rw [Scheme.IdealSheafData.ideal_sup, Pi.sup_apply, ker_iAtt_ideal]
    refine sup_eq_right.mpr ?_
    refine Ideal.span_le.mpr (Set.iUnion₂_subset fun m hm a ha => ?_)
    exact hI U m hm a ha

end AlgMag.GB
