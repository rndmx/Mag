import Mathlib

/-!
# Existence of strongly-FPR atlases: commutative algebra of Lemma 2.2

Mayeux, *Existence of strongly-FPR atlases*, "Stabilizers" and Lemma 2.2. `I ⊆ R[M]` is the ideal of a closed subgroup
scheme of `D(M)_R` (`IsSubgroupIdeal`: unit section, multiplication into `V(I) × V(I)`, in `R[M × M]`).

* `SubgroupIdeal.le_span`: over a field, `G = D(M/Y)` [SGA3, VIII]: `I` is generated by the `χ^m - 1`, `m ∈ Y`.
* `SubgroupIdeal.exists_generic`: Lemma 2.2, the step on an integral base.
* `SubgroupIdeal.finite_range`: **Lemma 2.2**, noetherian induction.
-/

open AddMonoidAlgebra

universe u

namespace AlgMag.StronglyFPRNote.SubgroupIdeal

noncomputable section

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M]

local notation "chi" m => (AddMonoidAlgebra.single m 1 : AddMonoidAlgebra _ _)

/-- The augmentation, ring map of the unit section. -/
def aug (R : Type*) [CommRing R] (M : Type*) [AddCommGroup M] : AddMonoidAlgebra R M →+* R :=
  AddMonoidAlgebra.liftNCRingHom (RingHom.id R) (1 : Multiplicative M →* R) (fun _ _ => mul_comm _ _)

/-- The comultiplication `R[M] → R[M × M]`. -/
def comul (R : Type*) [CommRing R] (M : Type*) [AddCommGroup M] :
    AddMonoidAlgebra R M →+* AddMonoidAlgebra R (M × M) :=
  AddMonoidAlgebra.mapDomainRingHom R (AddMonoidHom.prod (AddMonoidHom.id M) (AddMonoidHom.id M))

/-- First factor. -/
def inl' (R : Type*) [CommRing R] (M : Type*) [AddCommGroup M] :
    AddMonoidAlgebra R M →+* AddMonoidAlgebra R (M × M) :=
  AddMonoidAlgebra.mapDomainRingHom R (AddMonoidHom.inl M M)

/-- Second factor. -/
def inr' (R : Type*) [CommRing R] (M : Type*) [AddCommGroup M] :
    AddMonoidAlgebra R M →+* AddMonoidAlgebra R (M × M) :=
  AddMonoidAlgebra.mapDomainRingHom R (AddMonoidHom.inr M M)

/-- `V(I) ⊆ D(M)_R` contains the unit section and is stable under the product. -/
structure IsSubgroupIdeal (I : Ideal (AddMonoidAlgebra R M)) : Prop where
  counit : ∀ x ∈ I, aug R M x = 0
  mul_mem : ∀ x ∈ I, comul R M x ∈ I.map (inl' R M) ⊔ I.map (inr' R M)

/-- Change of base ring on `R[M]`. -/
def baseMap {R' : Type*} [CommRing R'] (φ : R →+* R') (M : Type*) [AddCommGroup M] :
    AddMonoidAlgebra R M →+* AddMonoidAlgebra R' M :=
  AddMonoidAlgebra.mapRingHom M φ

@[simp] lemma baseMap_single {R' : Type*} [CommRing R'] (φ : R →+* R') (m : M) (r : R) :
    baseMap φ M (single m r) = single m (φ r) := by
  simp [baseMap]

section Hom

variable {A : Type*} [CommRing A] {R' : Type*} [CommRing R']

lemma hom_ext' {P : Type*} [AddCommMonoid P] {f g : AddMonoidAlgebra R P →+* A}
    (h1 : ∀ r, f (single 0 r) = g (single 0 r)) (h2 : ∀ m, f (single m 1) = g (single m 1)) : f = g :=
  AddMonoidAlgebra.ringHom_ext h1 h2

variable (φ : R →+* R')

lemma aug_baseMap : (aug R' M).comp (baseMap φ M) = φ.comp (aug R M) := by
  refine hom_ext' (fun r => ?_) (fun m => ?_) <;> simp [aug, baseMap, AddMonoidAlgebra.liftNC_single, AddMonoidAlgebra.liftNCRingHom]

lemma comul_baseMap : (comul R' M).comp (baseMap φ M) = (baseMap φ (M × M)).comp (comul R M) := by
  refine hom_ext' (fun r => ?_) (fun m => ?_) <;> simp [comul, baseMap]

lemma inl_baseMap : (inl' R' M).comp (baseMap φ M) = (baseMap φ (M × M)).comp (inl' R M) := by
  refine hom_ext' (fun r => ?_) (fun m => ?_) <;> simp [inl', baseMap]

lemma inr_baseMap : (inr' R' M).comp (baseMap φ M) = (baseMap φ (M × M)).comp (inr' R M) := by
  refine hom_ext' (fun r => ?_) (fun m => ?_) <;> simp [inr', baseMap]

/-- Base change of a subgroup. -/
theorem IsSubgroupIdeal.map {I : Ideal (AddMonoidAlgebra R M)} (h : IsSubgroupIdeal I) :
    IsSubgroupIdeal (I.map (baseMap φ M)) := by
  constructor
  · intro x hx
    have : I.map (baseMap φ M) ≤ RingHom.ker (aug R' M) := by
      rw [Ideal.map_le_iff_le_comap]
      intro y hy
      have e := congrArg (fun k => k y) (aug_baseMap (M := M) φ)
      simp only [RingHom.comp_apply] at e
      rw [Ideal.mem_comap, RingHom.mem_ker, e, h.counit y hy, map_zero]
    exact this hx
  · intro x hx
    have : I.map (baseMap φ M) ≤ (((I.map (baseMap φ M)).map (inl' R' M) ⊔
        (I.map (baseMap φ M)).map (inr' R' M))).comap (comul R' M) := by
      rw [Ideal.map_le_iff_le_comap]
      intro y hy
      have e := congrArg (fun k => k y) (comul_baseMap (M := M) φ)
      simp only [RingHom.comp_apply] at e
      rw [Ideal.mem_comap, Ideal.mem_comap, e]
      have hle : I.map (inl' R M) ⊔ I.map (inr' R M) ≤
          (((I.map (baseMap φ M)).map (inl' R' M) ⊔ (I.map (baseMap φ M)).map (inr' R' M))).comap
            (baseMap φ (M × M)) := by
        refine sup_le ?_ ?_
        · rw [Ideal.map_le_iff_le_comap]
          intro z hz
          have e1 := congrArg (fun k => k z) (inl_baseMap (M := M) φ)
          simp only [RingHom.comp_apply] at e1
          rw [Ideal.mem_comap, Ideal.mem_comap, ← e1]
          exact Ideal.mem_sup_left (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hz))
        · rw [Ideal.map_le_iff_le_comap]
          intro z hz
          have e1 := congrArg (fun k => k z) (inr_baseMap (M := M) φ)
          simp only [RingHom.comp_apply] at e1
          rw [Ideal.mem_comap, Ideal.mem_comap, ← e1]
          exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hz))
      exact hle (h.mul_mem y hy)
    exact this hx

end Hom

/-- `Y`: the characters trivial on `V(I)`, as a set. -/
def charSet (I : Ideal (AddMonoidAlgebra R M)) : Set M :=
  {m | (single m 1 - 1 : AddMonoidAlgebra R M) ∈ I}

/-- The ideal of `D(M/Y)`. -/
def spanY (R : Type*) [CommRing R] {M : Type*} [AddCommGroup M] (Y : Set M) :
    Ideal (AddMonoidAlgebra R M) :=
  Ideal.span ((fun m => (single m 1 - 1 : AddMonoidAlgebra R M)) '' Y)

section Field

variable {K : Type*} [Field K]

lemma sub_mem_iff (I : Ideal (AddMonoidAlgebra K M)) (a b : M) (h : (single b 1 - single a 1 : AddMonoidAlgebra K M) ∈ I) :
    (b - a) ∈ charSet I := by
  have e : (single (b - a) 1 - 1 : AddMonoidAlgebra K M) =
      single (-a) 1 * (single b 1 - single a 1) := by
    rw [mul_sub, single_mul_single, single_mul_single, neg_add_cancel, mul_one, ← one_def, neg_add_eq_sub]
  change _ ∈ I
  rw [e]
  exact I.mul_mem_left _ h

lemma mem_of_charSet (I : Ideal (AddMonoidAlgebra K M)) {a b : M} (h : b - a ∈ charSet I) :
    (single b 1 - single a 1 : AddMonoidAlgebra K M) ∈ I := by
  have e : (single b 1 - single a 1 : AddMonoidAlgebra K M) =
      single a 1 * (single (b - a) 1 - 1) := by
    rw [mul_sub, single_mul_single, mul_one]
    simp
  rw [e]
  exact I.mul_mem_left _ h

/-- The contraction `id ⊗ λ : K[M × M] → K[M]`. -/
def contr (l : AddMonoidAlgebra K M →ₗ[K] K) : AddMonoidAlgebra K (M × M) →ₗ[K] AddMonoidAlgebra K M :=
  (Finsupp.lsum K (fun p : M × M =>
    LinearMap.toSpanSingleton K _ (single p.1 (l (single p.2 1))))) ∘ₗ
    (coeffLinearEquiv K).toLinearMap

lemma contr_single (l : AddMonoidAlgebra K M →ₗ[K] K) (p : M × M) (c : K) :
    contr l (single p c) = single p.1 (c * l (single p.2 1)) := by
  simp [contr, smul_single]

lemma contr_mul_inl (l : AddMonoidAlgebra K M →ₗ[K] K) (a b : M) (x : AddMonoidAlgebra K M) :
    contr l (single (a, b) 1 * inl' K M x) = single a (l (single b 1)) * x := by
  induction x using AddMonoidAlgebra.induction_linear with
  | zero => simp
  | add u v hu hv => simp only [map_add, mul_add, hu, hv]
  | single m c =>
    simp [inl', contr_single, single_mul_single, mul_comm, add_comm]

lemma contr_mul_inr (l : AddMonoidAlgebra K M →ₗ[K] K) (a b : M) (x : AddMonoidAlgebra K M) :
    contr l (single (a, b) 1 * inr' K M x) = single a (l (single b 1 * x)) := by
  induction x using AddMonoidAlgebra.induction_linear with
  | zero => simp
  | add u v hu hv => simp only [map_add, mul_add, hu, hv, single_add]
  | single m c =>
    have e : (single b 1 * single m c : AddMonoidAlgebra K M) = c • single (b + m) 1 := by
      simp [single_mul_single, smul_single]
    rw [e, map_smul]
    simp [inr', contr_single, single_mul_single]

lemma contr_aux (I : Ideal (AddMonoidAlgebra K M)) (l : AddMonoidAlgebra K M →ₗ[K] K)
    (g : AddMonoidAlgebra K M →+* AddMonoidAlgebra K (M × M))
    (h : ∀ x ∈ I, ∀ a b, contr l (single (a, b) 1 * g x) ∈ I) {y : AddMonoidAlgebra K (M × M)}
    (hy : y ∈ I.map g) : ∀ a b, contr l (single (a, b) 1 * y) ∈ I := by
  refine Submodule.span_induction (p := fun y _ => ∀ a b, contr l (single (a, b) 1 * y) ∈ I)
    ?_ (by simp) ?_ ?_ hy
  · rintro _ ⟨x, hx, rfl⟩ a b
    exact h x hx a b
  · intro u v _ _ hu hv a b
    rw [mul_add, map_add]
    exact I.add_mem (hu a b) (hv a b)
  · intro r y _ hy a b
    rw [smul_eq_mul]
    induction r using AddMonoidAlgebra.induction_linear with
    | zero => simp
    | add u v hu hv =>
      rw [add_mul, mul_add, map_add]
      exact I.add_mem hu hv
    | single p c =>
      have e : (single (a, b) 1 * (single p c * y) : AddMonoidAlgebra K (M × M)) =
          c • (single (a + p.1, b + p.2) 1 * y) := by
        rw [← mul_assoc, single_mul_single, one_mul, ← smul_mul_assoc, smul_single, smul_eq_mul, mul_one]
        rfl
      rw [e, map_smul]
      exact Submodule.smul_of_tower_mem I c (hy _ _)

/-- `contr` of `V(I) × V(I)` lands in `I`, for `λ` vanishing on `I`. -/
lemma contr_mem (I : Ideal (AddMonoidAlgebra K M)) (l : AddMonoidAlgebra K M →ₗ[K] K)
    (hl : ∀ x ∈ I, l x = 0) {w : AddMonoidAlgebra K (M × M)}
    (hw : w ∈ I.map (inl' K M) ⊔ I.map (inr' K M)) : contr l w ∈ I := by
  obtain ⟨w1, h1, w2, h2, rfl⟩ := Submodule.mem_sup.1 hw
  have e : (single ((0 : M), (0 : M)) 1 : AddMonoidAlgebra K (M × M)) = 1 := rfl
  have a1 := contr_aux I l (inl' K M) (fun x hx a b => by
    rw [contr_mul_inl]; exact I.mul_mem_left _ hx) h1 0 0
  have a2 := contr_aux I l (inr' K M) (fun x hx a b => by
    rw [contr_mul_inr, hl _ (I.mul_mem_left _ hx)]; simp) h2 0 0
  rw [e, one_mul] at a1 a2
  rw [map_add]
  exact I.add_mem a1 a2

lemma z_coeff (l : AddMonoidAlgebra K M →ₗ[K] K) (x : AddMonoidAlgebra K M) (m m' : M) :
    (contr l (comul K M x) - single 0 (l (single m 1)) * x).coeff m' =
      x.coeff m' * (l (single m' 1) - l (single m 1)) := by
  classical
  induction x using AddMonoidAlgebra.induction_linear with
  | zero => simp
  | add u v hu hv =>
    have : (contr l (comul K M (u + v)) - single 0 (l (single m 1)) * (u + v)) =
        (contr l (comul K M u) - single 0 (l (single m 1)) * u) +
        (contr l (comul K M v) - single 0 (l (single m 1)) * v) := by
      rw [map_add, map_add, mul_add]; abel
    rw [this, coeff_add, Finsupp.add_apply, hu, hv, coeff_add, Finsupp.add_apply, add_mul]
  | single n c =>
    have e : comul K M (single n c) = single (n, n) c := by simp [comul]
    rw [e, contr_single, single_mul_single, zero_add]
    by_cases hn : n = m'
    · subst hn; simp [mul_sub, mul_comm]
    · simp [Finsupp.single_apply, hn]

lemma aug_single (m : M) (c : K) : aug K M (single m c) = c := by
  simp [aug, AddMonoidAlgebra.liftNCRingHom, AddMonoidAlgebra.liftNC_single]

/-- Over a field, a function in `I` whose support meets each class mod `Y` at most once vanishes: the Dedekind argument
behind `G = D(M/Y)`, [SGA3, VIII]. -/
theorem eq_zero_of_distinct {I : Ideal (AddMonoidAlgebra K M)} (h : IsSubgroupIdeal I) :
    ∀ (n : ℕ) (x : AddMonoidAlgebra K M), x ∈ I → x.coeff.support.card = n →
      (∀ a ∈ x.coeff.support, ∀ b ∈ x.coeff.support, b - a ∈ charSet I → a = b) → x = 0 := by
  classical
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro x hx hn hd
  by_contra hne
  have hsn : x.coeff.support.Nonempty := by
    rw [Finsupp.support_nonempty_iff]
    exact fun h0 => hne (coeff_eq_zero.1 h0)
  obtain ⟨m1, hm1⟩ := hsn
  by_cases hex : ∃ m2 ∈ x.coeff.support, m2 ≠ m1
  · obtain ⟨m2, hm2, hne2⟩ := hex
    have hδ : (single m2 1 - single m1 1 : AddMonoidAlgebra K M) ∉ I := fun hδ =>
      hne2 (hd m1 hm1 m2 hm2 (sub_mem_iff I m1 m2 hδ)).symm
    let q := Ideal.Quotient.mkₐ K I
    have hq : q (single m2 1 - single m1 1) ≠ 0 := fun h0 =>
      hδ (Ideal.Quotient.eq_zero_iff_mem.1 h0)
    obtain ⟨φ, hφ⟩ : ∃ φ : Module.Dual K (AddMonoidAlgebra K M ⧸ I), φ (q (single m2 1 - single m1 1)) ≠ 0 := by
      by_contra hc
      push_neg at hc
      exact hq ((Module.forall_dual_apply_eq_zero_iff K _).1 hc)
    let l : AddMonoidAlgebra K M →ₗ[K] K := φ ∘ₗ q.toLinearMap
    have hl : ∀ y ∈ I, l y = 0 := fun y hy => by
      change φ (q y) = 0
      rw [show q y = 0 from Ideal.Quotient.eq_zero_iff_mem.2 hy, map_zero]
    let z := contr l (comul K M x) - single 0 (l (single m1 1)) * x
    have hz : z ∈ I := I.sub_mem (contr_mem I l hl (h.mul_mem x hx)) (I.mul_mem_left _ hx)
    have hzc := z_coeff l x m1
    have hsub : z.coeff.support ⊆ x.coeff.support.erase m1 := by
      intro c hc
      rw [Finsupp.mem_support_iff, hzc] at hc
      refine Finset.mem_erase.2 ⟨fun e => hc (by rw [e]; simp), ?_⟩
      rw [Finsupp.mem_support_iff]
      exact fun e => hc (by rw [e, zero_mul])
    have hzs : z.coeff.support ⊆ x.coeff.support := hsub.trans (Finset.erase_subset _ _)
    have hcard : z.coeff.support.card < n := by
      rw [← hn]
      exact (Finset.card_le_card hsub).trans_lt (Finset.card_erase_lt_of_mem hm1)
    have hz0 := ih _ hcard z hz rfl (fun a ha b hb hab => hd a (hzs ha) b (hzs hb) hab)
    have h2 := hzc m2
    change z.coeff m2 = _ at h2
    rw [hz0, coeff_zero, Finsupp.zero_apply] at h2
    have hx2 : x.coeff m2 ≠ 0 := Finsupp.mem_support_iff.1 hm2
    have h3 : l (single m2 1) - l (single m1 1) = 0 := (mul_eq_zero.1 h2.symm).resolve_left hx2
    apply hφ
    change l _ = 0
    rw [map_sub, h3]
  · push_neg at hex
    have hxs : x = single m1 (x.coeff m1) := by
      apply coeff_injective
      ext c
      by_cases hc : c = m1
      · subst hc; simp
      · have : c ∉ x.coeff.support := fun hh => hc (hex c hh)
        simp [Finsupp.notMem_support_iff.1 this, Finsupp.single_apply, Ne.symm hc]
    have h0 := h.counit x hx
    rw [hxs, aug_single] at h0
    exact Finsupp.mem_support_iff.1 hm1 h0

lemma chi_sub_mem_span {Y : Set M} {a b : M} (hab : b - a ∈ Y) :
    (single b 1 - single a 1 : AddMonoidAlgebra K M) ∈ spanY K Y := by
  have e : (single b 1 - single a 1 : AddMonoidAlgebra K M) =
      single a 1 * (single (b - a) 1 - 1) := by
    rw [mul_sub, single_mul_single, mul_one]
    simp
  rw [e]
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨_, hab, rfl⟩)

/-- **`G = D(M/Y)`** [SGA3, VIII], over a field: `I` is generated by the `χ^m - 1`, `m ∈ Y`. -/
theorem le_span {I : Ideal (AddMonoidAlgebra K M)} (h : IsSubgroupIdeal I) : I ≤ spanY K (charSet I) := by
  classical
  suffices H : ∀ (n : ℕ) (x : AddMonoidAlgebra K M), x ∈ I → x.coeff.support.card = n →
      x ∈ spanY K (charSet I) from fun x hx => H _ x hx rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro x hx hn
  by_cases hd : ∀ a ∈ x.coeff.support, ∀ b ∈ x.coeff.support, b - a ∈ charSet I → a = b
  · rw [eq_zero_of_distinct h _ x hx rfl hd]
    exact Ideal.zero_mem _
  · push_neg at hd
    obtain ⟨a, ha, b, hb, hab, hne⟩ := hd
    let c := x.coeff b
    let x' : AddMonoidAlgebra K M := x - c • (single b 1 - single a 1)
    have hδ : (single b 1 - single a 1 : AddMonoidAlgebra K M) ∈ I := mem_of_charSet I hab
    have hx' : x' ∈ I := I.sub_mem hx (Submodule.smul_of_tower_mem I c hδ)
    have hc' : ∀ d, x'.coeff d = x.coeff d - (if d = b then c else 0) + (if d = a then c else 0) := by
      intro d
      simp only [x', coeff_sub, coeff_smul, Finsupp.sub_apply, Finsupp.smul_apply, coeff_single,
        Finsupp.single_apply, smul_eq_mul]
      by_cases h1 : b = d <;> by_cases h2 : a = d <;> simp [h1, h2, eq_comm] <;> ring_nf <;> simp_all
    have hsub : x'.coeff.support ⊆ x.coeff.support.erase b := by
      intro d hd
      rw [Finsupp.mem_support_iff, hc'] at hd
      by_cases hdb : d = b
      · subst hdb
        exact absurd (by simp [Ne.symm hne, c, hne]) hd
      · refine Finset.mem_erase.2 ⟨hdb, ?_⟩
        by_cases hda : d = a
        · subst hda; exact ha
        · rw [Finsupp.mem_support_iff]
          intro e
          exact hd (by simp [hdb, hda, e])
    have hcard : x'.coeff.support.card < n := by
      rw [← hn]
      exact (Finset.card_le_card hsub).trans_lt (Finset.card_erase_lt_of_mem hb)
    have := ih _ hcard x' hx' rfl
    have e : x = x' + c • (single b 1 - single a 1) := by simp [x']
    rw [e]
    exact Ideal.add_mem _ this (Submodule.smul_of_tower_mem _ c (chi_sub_mem_span hab))

/-- `Y` as a subgroup. -/
def charSub (I : Ideal (AddMonoidAlgebra K M)) : AddSubgroup M where
  carrier := charSet I
  zero_mem' := by
    change (single (0 : M) 1 - 1 : AddMonoidAlgebra K M) ∈ I
    rw [← one_def, sub_self]; exact I.zero_mem
  add_mem' {a b} ha hb := by
    have e : (single (a + b) 1 - 1 : AddMonoidAlgebra K M) =
        single a 1 * (single b 1 - 1) + (single a 1 - 1) := by
      rw [mul_sub, single_mul_single, mul_one, mul_one]; abel
    change _ ∈ I
    rw [e]
    exact I.add_mem (I.mul_mem_left _ hb) ha
  neg_mem' {a} ha := by
    have e : (single (-a) 1 - 1 : AddMonoidAlgebra K M) = - (single (-a) 1 * (single a 1 - 1)) := by
      rw [mul_sub, single_mul_single, mul_one, neg_add_cancel, mul_one, ← one_def]; abel
    change _ ∈ I
    rw [e]
    exact I.neg_mem (I.mul_mem_left _ ha)

lemma mem_of_chi_mem (Y : AddSubgroup M) {m : M}
    (h : (single m 1 - 1 : AddMonoidAlgebra K M) ∈ spanY K (Y : Set M)) : m ∈ Y := by
  classical
  let qq : AddMonoidAlgebra K M →+* AddMonoidAlgebra K (M ⧸ Y) :=
    AddMonoidAlgebra.mapDomainRingHom K (QuotientAddGroup.mk' Y)
  have hle : spanY K (Y : Set M) ≤ RingHom.ker qq := by
    rw [spanY, Ideal.span_le]
    rintro _ ⟨y, hy, rfl⟩
    have hy0 : (QuotientAddGroup.mk' Y) y = 0 := (QuotientAddGroup.eq_zero_iff y).2 hy
    change qq _ = 0
    simp only [qq, map_sub, map_one, AddMonoidAlgebra.mapDomainRingHom_apply, mapDomain_single, hy0]
    simp [one_def]
  have h0 : qq (single m 1 - 1) = 0 := hle h
  simp only [qq, map_sub, map_one, AddMonoidAlgebra.mapDomainRingHom_apply, mapDomain_single] at h0
  by_contra hm
  have hne : (QuotientAddGroup.mk' Y) m ≠ 0 := fun e => hm ((QuotientAddGroup.eq_zero_iff m).1 e)
  have := congrArg (fun w => w.coeff ((QuotientAddGroup.mk' Y) m)) (sub_eq_zero.1 h0)
  simp [one_def, Finsupp.single_apply, Ne.symm hne] at this
  exact hne this.symm

end Field

section Generic

variable {R' : Type*} [CommRing R']

lemma baseMap_coeff (φ : R →+* R') (x : AddMonoidAlgebra R M) (m : M) :
    (baseMap φ M x).coeff m = φ (x.coeff m) := by
  classical
  induction x using AddMonoidAlgebra.induction_linear with
  | zero => simp
  | add u v hu hv => simp [hu, hv]
  | single n c =>
    simp only [baseMap_single, coeff_single, Finsupp.single_apply]
    split_ifs <;> simp

lemma baseMap_injective {φ : R →+* R'} (hφ : Function.Injective φ) :
    Function.Injective (baseMap φ M) := fun x y h => by
  apply coeff_injective
  ext m
  exact hφ (by rw [← baseMap_coeff, ← baseMap_coeff, h])

lemma map_spanY (φ : R →+* R') (Y : Set M) : (spanY R Y).map (baseMap φ M) = spanY R' Y := by
  rw [spanY, Ideal.map_span, spanY, ← Set.image_comp]
  congr 1
  refine Set.image_congr fun m _ => ?_
  simp [one_def]

variable [IsDomain R]

local notation "KK" => FractionRing R
local notation "φK" => algebraMap R (FractionRing R)

lemma clear_elem (r : AddMonoidAlgebra KK M) : ∃ (d : R) (r' : AddMonoidAlgebra R M), d ≠ 0 ∧
    single 0 (φK d) * r = baseMap φK M r' := by
  induction r using AddMonoidAlgebra.induction_linear with
  | zero => exact ⟨1, 0, one_ne_zero, by simp⟩
  | add u v hu hv =>
    obtain ⟨d1, r1, h1, e1⟩ := hu
    obtain ⟨d2, r2, h2, e2⟩ := hv
    refine ⟨d1 * d2, single 0 d2 * r1 + single 0 d1 * r2, mul_ne_zero h1 h2, ?_⟩
    have s : (single 0 (φK (d1 * d2)) : AddMonoidAlgebra KK M) = single 0 (φK d1) * single 0 (φK d2) := by
      rw [single_mul_single, add_zero, map_mul]
    rw [map_add, map_mul (baseMap φK M) (single 0 d2) r1, map_mul (baseMap φK M) (single 0 d1) r2, ← e1, ← e2,
      baseMap_single, baseMap_single, s]
    ring
  | single m c =>
    obtain ⟨n, d, hd, rfl⟩ := IsFractionRing.div_surjective (A := R) c
    have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hd
    have hd1 : (φK d) ≠ 0 := by simpa using hd0
    refine ⟨d, single m n, hd0, ?_⟩
    rw [single_mul_single, zero_add, baseMap_single, mul_div_cancel₀ _ hd1]

lemma clear_ideal (J : Ideal (AddMonoidAlgebra R M)) {w : AddMonoidAlgebra KK M}
    (hw : w ∈ J.map (baseMap φK M)) : ∃ (d : R) (g : AddMonoidAlgebra R M), d ≠ 0 ∧ g ∈ J ∧
      single 0 (φK d) * w = baseMap φK M g := by
  have s : ∀ (a b : R), (single 0 (φK (a * b)) : AddMonoidAlgebra KK M) = single 0 (φK a) * single 0 (φK b) := fun a b => by
    rw [single_mul_single, add_zero, map_mul]
  refine Submodule.span_induction (p := fun w _ => ∃ (d : R) (g : AddMonoidAlgebra R M), d ≠ 0 ∧ g ∈ J ∧
      single 0 (φK d) * w = baseMap φK M g) ?_ ?_ ?_ ?_ hw
  · rintro _ ⟨x, hx, rfl⟩
    exact ⟨1, x, one_ne_zero, hx, by simp [← one_def]⟩
  · exact ⟨1, 0, one_ne_zero, J.zero_mem, by simp⟩
  · rintro u v _ _ ⟨d1, g1, h1, m1, e1⟩ ⟨d2, g2, h2, m2, e2⟩
    refine ⟨d1 * d2, single 0 d2 * g1 + single 0 d1 * g2, mul_ne_zero h1 h2,
      J.add_mem (J.mul_mem_left _ m1) (J.mul_mem_left _ m2), ?_⟩
    rw [map_add, map_mul (baseMap φK M) (single 0 d2) g1, map_mul (baseMap φK M) (single 0 d1) g2, ← e1, ← e2,
      baseMap_single, baseMap_single, s]
    ring
  · rintro r u _ ⟨d1, g1, h1, m1, e1⟩
    obtain ⟨d2, r2, h2, e2⟩ := clear_elem r
    refine ⟨d1 * d2, r2 * g1, mul_ne_zero h1 h2, J.mul_mem_left _ m1, ?_⟩
    rw [smul_eq_mul, map_mul (baseMap φK M) r2 g1, ← e1, ← e2, s]
    ring

/-- **Lemma 2.2**, integral base: `Y_v = Y_η` on a dense open. -/
theorem exists_generic [IsNoetherianRing R] [AddGroup.FG M] (I : Ideal (AddMonoidAlgebra R M))
    (h : IsSubgroupIdeal I) : ∃ a : R, a ≠ 0 ∧ ∀ {L : Type*} [Field L] (ψ : R →+* L), ψ a ≠ 0 →
      charSet (I.map (baseMap ψ M)) = charSet (I.map (baseMap φK M)) := by
  classical
  have hφ : Function.Injective φK := IsFractionRing.injective R KK
  let IK := I.map (baseMap φK M)
  let Y := charSub IK
  have hIK : IsSubgroupIdeal IK := IsSubgroupIdeal.map φK h
  have hnoeth : IsNoetherianRing (AddMonoidAlgebra R M) := by
    haveI : AddMonoid.FG M := AddGroup.fg_iff_addMonoid_fg.1 inferInstance
    exact Algebra.FiniteType.isNoetherianRing R _
  obtain ⟨F, hF⟩ := (isNoetherianRing_iff_ideal_fg _).1 hnoeth I
  have hgen : ∀ f ∈ F, ∃ (d : R) (g : AddMonoidAlgebra R M), d ≠ 0 ∧ g ∈ spanY R (Y : Set M) ∧
      single 0 d * f = g := by
    intro f hf
    have hfI : f ∈ I := hF ▸ Ideal.subset_span hf
    have h1 : baseMap φK M f ∈ (spanY R (Y : Set M)).map (baseMap φK M) := by
      rw [map_spanY]
      exact le_span hIK (Ideal.mem_map_of_mem _ hfI)
    obtain ⟨d, g, hd, hg, e⟩ := clear_ideal _ h1
    refine ⟨d, g, hd, hg, baseMap_injective hφ ?_⟩
    rw [map_mul, baseMap_single, e]
  have hYfg : Y.FG := by
    have : Module.Finite ℤ M := Module.Finite.iff_addGroup_fg.2 inferInstance
    exact (Submodule.fg_iff_addSubgroup_fg _).1 (IsNoetherian.noetherian (AddSubgroup.toIntSubmodule Y))
  obtain ⟨T, hT⟩ := hYfg
  have hgenT : ∀ t ∈ T, ∃ d : R, d ≠ 0 ∧ single 0 d * (single t 1 - 1 : AddMonoidAlgebra R M) ∈ I := by
    intro t ht
    have htY : t ∈ Y := hT ▸ AddSubgroup.subset_closure ht
    have ht' : (single t 1 - 1 : AddMonoidAlgebra KK M) ∈ IK := htY
    obtain ⟨d, g, hd, hg, e⟩ := clear_ideal I ht'
    refine ⟨d, hd, ?_⟩
    have e2 : single 0 d * (single t 1 - 1 : AddMonoidAlgebra R M) = g := baseMap_injective hφ (by
      rw [← e, map_mul, baseMap_single, map_sub, map_one, baseMap_single, map_one])
    rwa [e2]
  choose! d1 g1 hd1 hg1 he1 using hgen
  choose! d2 hd2 he2 using hgenT
  let a : R := (∏ f ∈ F, d1 f) * ∏ t ∈ T, d2 t
  have ha : a ≠ 0 := mul_ne_zero (Finset.prod_ne_zero_iff.2 hd1) (Finset.prod_ne_zero_iff.2 hd2)
  refine ⟨a, ha, fun {L} _ ψ hψ => ?_⟩
  have hψ1 : ∀ f ∈ F, ψ (d1 f) ≠ 0 := fun f hf e => hψ (by
    simp only [a, map_mul, map_prod]
    rw [Finset.prod_eq_zero hf e, zero_mul])
  have hψ2 : ∀ t ∈ T, ψ (d2 t) ≠ 0 := fun t ht e => hψ (by
    simp only [a, map_mul, map_prod]
    rw [Finset.prod_eq_zero ht e, mul_zero])
  have unit : ∀ {J : Ideal (AddMonoidAlgebra L M)} {c : L} {w : AddMonoidAlgebra L M}, c ≠ 0 →
      single 0 c * w ∈ J → w ∈ J := by
    intro J c w hc hw
    have := J.mul_mem_left (single 0 c⁻¹) hw
    rwa [← mul_assoc, single_mul_single, add_zero, inv_mul_cancel₀ hc, ← one_def, one_mul] at this
  let IL := I.map (baseMap ψ M)
  apply Set.Subset.antisymm
  · intro m hm
    have hle : IL ≤ spanY L (Y : Set M) := by
      rw [Ideal.map_le_iff_le_comap, ← hF, Ideal.span_le]
      intro f hf
      change baseMap ψ M f ∈ spanY L (Y : Set M)
      apply unit (hψ1 f hf)
      have e : single 0 (ψ (d1 f)) * baseMap ψ M f = baseMap ψ M (g1 f) := by
        rw [← he1 f hf, map_mul, baseMap_single]
      rw [e, ← map_spanY ψ]
      exact Ideal.mem_map_of_mem _ (hg1 f hf)
    exact mem_of_chi_mem Y (hle hm)
  · intro m hm
    have hYle : Y ≤ charSub IL := by
      rw [← hT, AddSubgroup.closure_le]
      intro t ht
      change (single t 1 - 1 : AddMonoidAlgebra L M) ∈ IL
      apply unit (hψ2 t ht)
      have e : single 0 (ψ (d2 t)) * (single t 1 - 1 : AddMonoidAlgebra L M) =
          baseMap ψ M (single 0 (d2 t) * (single t 1 - 1)) := by
        rw [map_mul, baseMap_single, map_sub, map_one, baseMap_single, map_one]
      rw [e]
      exact Ideal.mem_map_of_mem _ (he2 t ht)
    exact hYle hm

end Generic

/-- `Y_p` for a prime `p` of `R`: the characters trivial on the fibre of `V(I)` at `p`. -/
def charAt (I : Ideal (AddMonoidAlgebra R M)) (p : PrimeSpectrum R) : Set M :=
  charSet (I.map (baseMap (algebraMap R p.asIdeal.ResidueField) M))

/-- **Lemma 2.2**: `Y_v` takes finitely many values. -/
theorem finite_range [IsNoetherianRing R] [AddGroup.FG M] (I : Ideal (AddMonoidAlgebra R M))
    (h : IsSubgroupIdeal I) : (Set.range (charAt I)).Finite := by
  classical
  suffices H : ∀ q : Ideal R, ((fun p : {p : PrimeSpectrum R // q ≤ p.asIdeal} => charAt I p.1) '' Set.univ).Finite by
    refine (H ⊥).subset ?_
    rintro _ ⟨p, rfl⟩
    exact ⟨⟨p, bot_le⟩, trivial, rfl⟩
  intro q
  induction q using (wellFounded_gt (α := Ideal R)).induction with
  | _ q ih =>
  by_cases hq : q.IsPrime
  · let R1 := R ⧸ q
    let I1 := I.map (baseMap (Ideal.Quotient.mk q) M)
    haveI : IsDomain R1 := Ideal.Quotient.isDomain q
    obtain ⟨a1, ha1, hgen⟩ := exists_generic I1 (IsSubgroupIdeal.map _ h)
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a1
    have hlt : q < q ⊔ Ideal.span {a} := by
      refine lt_of_le_of_ne le_sup_left fun e => ha1 ?_
      have : a ∈ q := by rw [e]; exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self a)
      exact Ideal.Quotient.eq_zero_iff_mem.2 this
    refine ((ih _ hlt).union (Set.finite_singleton (charSet (I1.map (baseMap (algebraMap R1 (FractionRing R1)) M))))).subset ?_
    rintro _ ⟨⟨p, hp⟩, -, rfl⟩
    by_cases hap : a ∈ p.asIdeal
    · refine Or.inl ⟨⟨p, sup_le hp ((Ideal.span_singleton_le_iff_mem _).2 hap)⟩, trivial, rfl⟩
    · refine Or.inr ?_
      let ψ : R1 →+* p.asIdeal.ResidueField := Ideal.Quotient.lift q (algebraMap R _) (fun x hx =>
        (Ideal.algebraMap_residueField_eq_zero).2 (hp hx))
      have hne : ψ (Ideal.Quotient.mk q a) ≠ 0 := by
        change algebraMap R p.asIdeal.ResidueField a ≠ 0
        exact fun e => hap ((Ideal.algebraMap_residueField_eq_zero).1 e)
      have ecomp : (baseMap ψ M).comp (baseMap (Ideal.Quotient.mk q) M) =
          baseMap (algebraMap R p.asIdeal.ResidueField) M := by
        refine hom_ext' (fun r => ?_) (fun m => ?_) <;> simp <;> rfl
      have e : I.map (baseMap (algebraMap R p.asIdeal.ResidueField) M) = I1.map (baseMap ψ M) := by
        rw [Ideal.map_map, ecomp]
      rw [Set.mem_singleton_iff]
      change charSet (I.map (baseMap (algebraMap R p.asIdeal.ResidueField) M)) = _
      rw [e]
      exact hgen ψ hne
  · by_cases htop : q = ⊤
    · subst htop
      refine Set.Finite.subset Set.finite_empty ?_
      rintro _ ⟨⟨p, hp⟩, -, rfl⟩
      exact absurd (top_le_iff.1 hp) p.2.ne_top
    · have hfin := Ideal.finite_minimalPrimes_of_isNoetherianRing R q
      refine (hfin.biUnion (t := fun P => ((fun p : {p : PrimeSpectrum R // P ≤ p.asIdeal} => charAt I p.1) '' Set.univ))
        (fun P hP => ih P (lt_of_le_of_ne hP.1.2 (fun e => hq (e ▸ hP.1.1))))).subset ?_
      rintro _ ⟨⟨p, hp⟩, -, rfl⟩
      obtain ⟨P, hP, hPp⟩ := Ideal.exists_minimalPrimes_le hp
      exact Set.mem_biUnion hP ⟨⟨p, hPp⟩, trivial, rfl⟩

end

