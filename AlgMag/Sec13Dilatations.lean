/-!
# Attractors and dilatations, affine case

Mayeux, *Algebraic Magnetism*, Semigroup Forum 113 (2026) 126–201, §13.

**Everything in this file is the affine case** of §13: `S = Spec R₀`, `X = Spec A` with `A` an
`M`-graded `R₀`-algebra, the locally principal closed subscheme `S'` is principal, cut out by
an element `a`, and `Y = V(I)` for an ideal `I` containing `a`. Stability of `Y` under the action
is homogeneity of `I`. We do not treat algebraic spaces, nor Corollary 13.3 (which needs the
smoothness results of §11).

The dilatation `A[I/a]` (`Spec` of it is `Bl_Y^D X`) is the `A`-subalgebra of `A[1/a]` generated by
the fractions `x/a`, `x ∈ I` (`AlgMag.dilatation`). Its universal property among `A`-algebras in
which `a` is regular is `AlgMag.dilatationLift` and `AlgMag.dilatation_ringHom_ext`.

## Main results

* `AlgMag.dilatationGradedAlgebra`: the grading on `A[I/a]`, i.e. the action in Proposition 13.1.
* `AlgMag.dilQuotHom_surjective`, `AlgMag.dilQuotHom_bijective_iff`: **Proposition 13.1**, sharp form.
  The canonical map `A[I/a] / J'_N → (A/J_N)[Ī/ā]` is surjective, and bijective iff `a` is regular on
  the source.
* `AlgMag.dilQuotEquivOfFlat`: **Proposition 13.1** under flatness of `(Bl_Y^D X)^N` over `S`.
* `AlgMag.attractorDilatationEquivOfFlat`: the same on functors of points.
-/

suppress_compilation

set_option linter.unusedSectionVars false

open Magnetism

namespace AlgMag

section General

variable {A : Type*} [CommRing A]

/-- The fraction `x / a ^ n` in `A[1/a]`. -/
def dilFrac (a x : A) (n : ℕ) : Localization.Away a :=
  algebraMap A _ x * IsLocalization.Away.invSelf a ^ n

lemma dilFrac_mul_pow (a x : A) (n : ℕ) :
    dilFrac a x n * algebraMap A _ (a ^ n) = algebraMap A _ x := by
  have h := IsLocalization.Away.mul_invSelf (S := Localization.Away a) a
  rw [dilFrac, map_pow, mul_assoc, ← mul_pow, mul_comm (IsLocalization.Away.invSelf a), h]
  simp

lemma dilFrac_zero_right (a x : A) : dilFrac a x 0 = algebraMap A _ x := by simp [dilFrac]

lemma dilFrac_mul (a x y : A) (n p : ℕ) :
    dilFrac a (x * y) (n + p) = dilFrac a x n * dilFrac a y p := by
  simp only [dilFrac, map_mul, pow_add]; ring

lemma dilFrac_add (a x y : A) (n : ℕ) :
    dilFrac a (x + y) n = dilFrac a x n + dilFrac a y n := by
  simp only [dilFrac, map_add]; ring

/-- Enlarging the denominator. -/
lemma dilFrac_shift (a x : A) (n p : ℕ) : dilFrac a (a ^ p * x) (n + p) = dilFrac a x n := by
  have h := IsLocalization.Away.mul_invSelf (S := Localization.Away a) a
  simp only [dilFrac, map_mul, map_pow, pow_add]
  calc _ = (algebraMap A (Localization.Away a) a * IsLocalization.Away.invSelf a) ^ p *
        (algebraMap A _ x * IsLocalization.Away.invSelf a ^ n) := by ring
    _ = _ := by rw [h]; simp

lemma dilFrac_eq_zero_iff (a x : A) (n : ℕ) : dilFrac a x n = 0 ↔ ∃ k : ℕ, a ^ k * x = 0 := by
  constructor
  · intro h
    have h' := dilFrac_mul_pow a x n
    rw [h, zero_mul] at h'
    obtain ⟨⟨_, k, rfl⟩, hk⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers a) (Localization.Away a) x).1 h'.symm
    exact ⟨k, hk⟩
  · rintro ⟨k, hk⟩
    rw [← dilFrac_shift a x n k, hk]
    simp [dilFrac]

variable (I : Ideal A) (a : A)

/-- The affine dilatation `A[I/a]` (`Spec` of it is `Bl_Y^D X`, with `Y = V(I)`, `D = V(a)`): the
`A`-subalgebra of `A[1/a]` generated by the fractions `x/a` for `x ∈ I`. -/
def dilatation : Subalgebra A (Localization.Away a) :=
  Algebra.adjoin A {u | ∃ x ∈ I, u = dilFrac a x 1}

variable {I a}

lemma dilFrac_mem_dilatation {n : ℕ} {x : A} (hx : x ∈ I ^ n) : dilFrac a x n ∈ dilatation I a := by
  induction n generalizing x with
  | zero => rw [dilFrac_zero_right]; exact Subalgebra.algebraMap_mem _ x
  | succ n ih =>
    rw [pow_succ] at hx
    induction hx using Submodule.mul_induction_on' with
    | mem_mul_mem y hy z hz =>
      rw [dilFrac_mul]
      exact mul_mem (ih hy) (Algebra.subset_adjoin ⟨z, hz, rfl⟩)
    | add y _ z _ hy hz => rw [dilFrac_add]; exact add_mem hy hz

/-- Elements of `A[I/a]` are the fractions `x / a ^ n` with `x ∈ I ^ n` (for `a ∈ I`). -/
lemma mem_dilatation_iff (ha : a ∈ I) {u : Localization.Away a} :
    u ∈ dilatation I a ↔ ∃ n, ∃ x ∈ I ^ n, u = dilFrac a x n := by
  refine ⟨fun hu => ?_, by rintro ⟨n, x, hx, rfl⟩; exact dilFrac_mem_dilatation hx⟩
  induction hu using Algebra.adjoin_induction with
  | mem u hu =>
    obtain ⟨x, hx, rfl⟩ := hu
    exact ⟨1, x, by simpa using hx, rfl⟩
  | algebraMap r => exact ⟨0, r, by simp, (dilFrac_zero_right a r).symm⟩
  | add u v _ _ hu hv =>
    obtain ⟨n, x, hx, rfl⟩ := hu
    obtain ⟨p, y, hy, rfl⟩ := hv
    refine ⟨n + p, a ^ p * x + a ^ n * y, add_mem ?_ ?_, ?_⟩
    · rw [add_comm, pow_add]; exact Ideal.mul_mem_mul (Ideal.pow_mem_pow ha p) hx
    · rw [pow_add]; exact Ideal.mul_mem_mul (Ideal.pow_mem_pow ha n) hy
    · rw [dilFrac_add, dilFrac_shift, add_comm n p, dilFrac_shift]
  | mul u v _ _ hu hv =>
    obtain ⟨n, x, hx, rfl⟩ := hu
    obtain ⟨p, y, hy, rfl⟩ := hv
    exact ⟨n + p, x * y, by rw [pow_add]; exact Ideal.mul_mem_mul hx hy, (dilFrac_mul ..).symm⟩

/-- `a` is regular on `A[I/a]`. -/
lemma dilatation_regular (b : dilatation I a)
    (h : algebraMap A (dilatation I a) a * b = 0) : b = 0 := by
  have h' : algebraMap A (Localization.Away a) a * (b : Localization.Away a) = 0 :=
    congrArg Subtype.val h
  have hu : IsUnit (algebraMap A (Localization.Away a) a) :=
    IsLocalization.Away.algebraMap_isUnit a
  exact Subtype.ext (hu.mul_right_eq_zero.1 h')

/-- The fraction `x/a` in `A[I/a]`, for `x ∈ I`. -/
def dilOverA {x : A} (hx : x ∈ I) : dilatation I a :=
  ⟨dilFrac a x 1, Algebra.subset_adjoin ⟨x, hx, rfl⟩⟩

/-- `x = a · (x/a)` in `A[I/a]`, for `x ∈ I`: the center pulls back into `a A[I/a]`. -/
lemma algebraMap_mul_dilOverA {x : A} (hx : x ∈ I) :
    algebraMap A (dilatation I a) a * dilOverA hx = algebraMap A _ x := by
  apply Subtype.ext
  have := dilFrac_mul_pow a x 1
  rw [pow_one] at this
  rw [mul_comm] at this
  exact this

section Lift

variable {B : Type*} [CommRing B] (ρ : A →+* B)

omit [CommRing A] in
private lemma regular_pow {B : Type*} [CommRing B] {c : B} (hreg : ∀ b : B, c * b = 0 → b = 0)
    (n : ℕ) (b : B) (h : c ^ n * b = 0) : b = 0 := by
  induction n with
  | zero => simpa using h
  | succ n ih => exact ih (hreg _ (by rw [← h]; ring))

/-- Two maps out of `A[I/a]` to a ring where `a` is regular agree if they agree on `A`
(uniqueness in the universal property of dilatations). -/
lemma dilatation_ringHom_ext (ha : a ∈ I) (hreg : ∀ b : B, ρ a * b = 0 → b = 0)
    {f g : dilatation I a →+* B}
    (hf : ∀ r, f (algebraMap A _ r) = ρ r) (hg : ∀ r, g (algebraMap A _ r) = ρ r) : f = g := by
  ext ⟨u, hu⟩
  obtain ⟨n, x, hx, rfl⟩ := (mem_dilatation_iff ha).1 hu
  have key : ∀ h : dilatation I a →+* B, (∀ r, h (algebraMap A _ r) = ρ r) →
      ρ a ^ n * h ⟨dilFrac a x n, hu⟩ = ρ x := by
    intro h hh
    rw [← map_pow, ← hh, ← hh, ← map_mul]
    congr 1
    apply Subtype.ext
    have := dilFrac_mul_pow a x n
    rw [mul_comm] at this
    exact this
  rw [← sub_eq_zero]
  apply regular_pow hreg n
  rw [mul_sub, key f hf, key g hg, sub_self]

variable (hreg : ∀ b : B, ρ a * b = 0 → b = 0) (hI : ∀ x ∈ I, ∃ b, ρ x = ρ a * b)

include hreg in
private lemma awayInj : Function.Injective (algebraMap B (Localization.Away (ρ a))) := by
  rw [injective_iff_map_eq_zero]
  intro b hb
  obtain ⟨⟨_, k, rfl⟩, hk⟩ :=
    (IsLocalization.map_eq_zero_iff (Submonoid.powers (ρ a)) (Localization.Away (ρ a)) b).1 hb
  exact regular_pow hreg k b hk

private def awayMap : Localization.Away a →+* Localization.Away (ρ a) :=
  IsLocalization.Away.lift a (g := (algebraMap B _).comp ρ) (by
    simpa using IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (ρ a)) (ρ a))

private lemma awayMap_algebraMap (r : A) :
    awayMap (a := a) ρ (algebraMap A _ r) = algebraMap B _ (ρ r) :=
  IsLocalization.Away.lift_eq a _ r

include hI in
private lemma awayMap_mem (u : dilatation I a) :
    awayMap ρ (u : Localization.Away a) ∈ (algebraMap B (Localization.Away (ρ a))).range := by
  obtain ⟨u, hu⟩ := u
  induction hu using Algebra.adjoin_induction with
  | mem u hu =>
    obtain ⟨x, hx, rfl⟩ := hu
    obtain ⟨b, hb⟩ := hI x hx
    refine ⟨b, ?_⟩
    have e := dilFrac_mul_pow a x 1
    have e' := congrArg (awayMap (a := a) ρ) e
    rw [map_mul, awayMap_algebraMap, awayMap_algebraMap, hb, pow_one, map_mul, mul_comm] at e'
    exact ((IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (ρ a)) (ρ a)).mul_left_cancel
      e').symm
  | algebraMap r => exact ⟨ρ r, (awayMap_algebraMap ρ r).symm⟩
  | add u v _ _ hu hv => simpa only [map_add] using add_mem hu hv
  | mul u v _ _ hu hv => simpa only [map_mul] using mul_mem hu hv

/-- **Universal property of dilatations**: if `a` is regular in `B` and `I B ⊆ a B`, then
`ρ : A → B` extends to `A[I/a] → B`. -/
def dilatationLift : dilatation I a →+* B :=
  (RingEquiv.ofBijective (algebraMap B (Localization.Away (ρ a))).rangeRestrict
    ⟨fun _ _ h => awayInj ρ hreg (congrArg Subtype.val h),
      fun ⟨_, b, hb⟩ => ⟨b, Subtype.ext hb⟩⟩).symm.toRingHom.comp
    (((awayMap (a := a) ρ).comp (dilatation I a).val.toRingHom).codRestrict _
      (fun u => awayMap_mem ρ hI u))

lemma dilatationLift_spec (u : dilatation I a) :
    algebraMap B _ (dilatationLift ρ hreg hI u) = awayMap ρ (u : Localization.Away a) := by
  set E := RingEquiv.ofBijective (algebraMap B (Localization.Away (ρ a))).rangeRestrict
    ⟨fun _ _ h => awayInj ρ hreg (congrArg Subtype.val h),
      fun ⟨_, b, hb⟩ => ⟨b, Subtype.ext hb⟩⟩ with hE
  have : E (dilatationLift ρ hreg hI u) = ⟨awayMap ρ (u : Localization.Away a), awayMap_mem ρ hI u⟩ :=
    E.apply_symm_apply _
  exact congrArg Subtype.val this

@[simp] lemma dilatationLift_algebraMap (r : A) :
    dilatationLift ρ hreg hI (algebraMap A _ r) = ρ r := by
  apply awayInj ρ hreg
  rw [dilatationLift_spec]
  exact awayMap_algebraMap ρ r

end Lift

end General

section Graded

variable {M R₀ A : Type*} [AddCommMonoid M] [DecidableEq M] [CommRing R₀] [CommRing A]
  [Algebra R₀ A]
variable (𝒜 : M → Submodule R₀ A) (I : Ideal A) (a : A)

/-- The degree `m` part of `A[I/a]`: spanned by the fractions `x / a ^ n` with `x ∈ I ^ n` homogeneous
of degree `m`. This grading is the action of `𝔸(M)_S` on `Bl_Y^D X` of Proposition 13.1. -/
def dilGrading (m : M) : Submodule R₀ (dilatation I a) :=
  Submodule.span R₀ {u | ∃ n, ∃ x ∈ 𝒜 m, x ∈ I ^ n ∧ (u : Localization.Away a) = dilFrac a x n}

variable {𝒜 I a}

lemma dilFrac_smul (r : R₀) (x : A) (n : ℕ) : dilFrac a (r • x) n = r • dilFrac a x n := by
  have : algebraMap A (Localization.Away a) (r • x) = r • algebraMap A _ x :=
    map_smul (IsScalarTower.toAlgHom R₀ A (Localization.Away a)) r x
  rw [dilFrac, this, smul_mul_assoc, dilFrac]

lemma dil_pow_mul {n : ℕ} {x : A} (u : dilatation I a) (hu : (u : Localization.Away a) = dilFrac a x n) :
    algebraMap A (dilatation I a) a ^ n * u = algebraMap A _ x := by
  apply Subtype.ext
  have := dilFrac_mul_pow a x n
  rw [mul_comm, ← hu] at this
  simpa using this

variable [GradedAlgebra 𝒜]

/-- Membership in the degree `m` part of `A[I/a]`, for `a ∈ I` of degree zero. -/
lemma mem_dilGrading_iff (ha : a ∈ I) (ha0 : a ∈ 𝒜 0) {m : M} {u : dilatation I a} :
    u ∈ dilGrading 𝒜 I a m ↔
      ∃ n, ∃ x ∈ 𝒜 m, x ∈ I ^ n ∧ (u : Localization.Away a) = dilFrac a x n := by
  refine ⟨fun hu => ?_, fun hu => Submodule.subset_span hu⟩
  have hapow : ∀ p : ℕ, a ^ p ∈ 𝒜 0 := fun p => by
    simpa using SetLike.pow_mem_graded (A := 𝒜) p ha0
  have hmul : ∀ {p : ℕ} {x : A}, x ∈ 𝒜 m → a ^ p * x ∈ 𝒜 m := fun {p x} hx => by
    simpa using SetLike.mul_mem_graded (hapow p) hx
  induction hu using Submodule.span_induction with
  | mem u hu => exact hu
  | zero => exact ⟨0, 0, zero_mem _, zero_mem _, by simp [dilFrac]⟩
  | add u v _ _ hu hv =>
    obtain ⟨n, x, hx, hxI, hu⟩ := hu
    obtain ⟨p, y, hy, hyI, hv⟩ := hv
    refine ⟨n + p, a ^ p * x + a ^ n * y, add_mem (hmul hx) (hmul hy), add_mem ?_ ?_, ?_⟩
    · rw [add_comm, pow_add]; exact Ideal.mul_mem_mul (Ideal.pow_mem_pow ha p) hxI
    · rw [pow_add]; exact Ideal.mul_mem_mul (Ideal.pow_mem_pow ha n) hyI
    · rw [dilFrac_add, dilFrac_shift, add_comm n p, dilFrac_shift]
      simp [hu, hv]
  | smul r u _ hu =>
    obtain ⟨n, x, hx, hxI, hu⟩ := hu
    refine ⟨n, r • x, Submodule.smul_mem _ r hx, ?_, ?_⟩
    · rw [Algebra.smul_def]
      exact Ideal.mul_mem_left _ _ hxI
    · rw [dilFrac_smul, ← hu]; rfl

/-- The map `A → A[I/a]` preserves degrees. -/
lemma algebraMap_mem_dilGrading {m : M} {x : A} (hx : x ∈ 𝒜 m) :
    algebraMap A (dilatation I a) x ∈ dilGrading 𝒜 I a m :=
  Submodule.subset_span ⟨0, x, hx, by simp, (dilFrac_zero_right a x).symm⟩

private lemma isHomogeneous_pow (hI : I.IsHomogeneous 𝒜) (n : ℕ) : (I ^ n).IsHomogeneous 𝒜 := by
  induction n with
  | zero => rw [pow_zero, Ideal.one_eq_top]; exact fun _ _ _ => Submodule.mem_top
  | succ n ih => rw [pow_succ]; exact ih.mul hI

private lemma eq_zero_of_sum_homogeneous {s : Finset M} {y : M → A} (hy : ∀ m ∈ s, y m ∈ 𝒜 m)
    (h : ∑ m ∈ s, y m = 0) {m : M} (hm : m ∈ s) : y m = 0 := by
  have h' := congrArg (GradedRing.proj 𝒜 m) h
  rw [map_sum, map_zero, Finset.sum_eq_single m] at h'
  · rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_same 𝒜 (hy m hm)] at h'
    exact h'
  · intro b hb hbm
    rw [GradedRing.proj_apply]
    exact DirectSum.decompose_of_mem_ne 𝒜 (hy b hb) hbm
  · intro hms; exact absurd hm hms

private lemma common_denominator (ha : a ∈ I) (ha0 : a ∈ 𝒜 0) (s : Finset M)
    (u : M → dilatation I a) (hu : ∀ m ∈ s, u m ∈ dilGrading 𝒜 I a m) :
    ∃ N, ∀ m ∈ s, ∃ x ∈ 𝒜 m, (u m : Localization.Away a) = dilFrac a x N := by
  have hapow : ∀ p : ℕ, a ^ p ∈ 𝒜 0 := fun p => by
    simpa using SetLike.pow_mem_graded (A := 𝒜) p ha0
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨0, by simp⟩
  | insert m s _ ih =>
    obtain ⟨N, hN⟩ := ih fun k hk => hu k (Finset.mem_insert_of_mem hk)
    obtain ⟨n, x, hx, -, hxu⟩ :=
      (mem_dilGrading_iff ha ha0).1 (hu m (Finset.mem_insert_self m s))
    refine ⟨N + n, fun k hk => ?_⟩
    rcases Finset.mem_insert.1 hk with rfl | hk
    · refine ⟨a ^ N * x, by simpa using SetLike.mul_mem_graded (hapow N) hx, ?_⟩
      rw [add_comm N n, dilFrac_shift, hxu]
    · obtain ⟨y, hy, hyu⟩ := hN k hk
      refine ⟨a ^ n * y, by simpa using SetLike.mul_mem_graded (hapow n) hy, ?_⟩
      rw [dilFrac_shift, hyu]

private lemma dilFrac_sum {ι : Type*} (s : Finset ι) (x : ι → A) (n : ℕ) :
    dilFrac a (∑ i ∈ s, x i) n = ∑ i ∈ s, dilFrac a (x i) n := by
  simp only [dilFrac, map_sum, Finset.sum_mul]

private lemma eq_zero_of_sum_dilGrading (ha : a ∈ I) (ha0 : a ∈ 𝒜 0) (s : Finset M)
    (u : M → dilatation I a) (hu : ∀ m ∈ s, u m ∈ dilGrading 𝒜 I a m)
    (h : ∑ m ∈ s, u m = 0) {m : M} (hm : m ∈ s) : u m = 0 := by
  have hapow : ∀ p : ℕ, a ^ p ∈ 𝒜 0 := fun p => by
    simpa using SetLike.pow_mem_graded (A := 𝒜) p ha0
  obtain ⟨N, hN⟩ := common_denominator ha ha0 s u hu
  choose! x hx hxu using hN
  have h1 : dilFrac a (∑ k ∈ s, x k) N = 0 := by
    rw [dilFrac_sum, Finset.sum_congr rfl fun k hk => (hxu k hk).symm]
    have := congrArg (Subtype.val) h
    simpa using this
  obtain ⟨k, hk⟩ := (dilFrac_eq_zero_iff a _ N).1 h1
  rw [Finset.mul_sum] at hk
  have h2 := eq_zero_of_sum_homogeneous (𝒜 := 𝒜) (s := s) (y := fun j => a ^ k * x j)
    (fun j hj => by simpa using SetLike.mul_mem_graded (hapow k) (hx j hj)) hk hm
  apply Subtype.ext
  rw [hxu m hm]
  exact (dilFrac_eq_zero_iff a _ N).2 ⟨k, h2⟩

private lemma isInternal_dilGrading (ha : a ∈ I) (ha0 : a ∈ 𝒜 0) (hI : I.IsHomogeneous 𝒜) :
    DirectSum.IsInternal (dilGrading 𝒜 I a) := by
  refine DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top ?_ ?_
  · rw [iSupIndep_iff_forall_dfinsupp]
    intro i x v hv
    classical
    have hs : ∑ k ∈ (DFinsupp.erase i v).support,
        ((DFinsupp.erase i v k : dilGrading 𝒜 I a k) : dilatation I a) = x := by
      rw [DFinsupp.lsum_apply_apply, DFinsupp.sumAddHom_apply] at hv
      exact hv
    have hi : i ∉ (DFinsupp.erase i v).support := by simp
    let u : M → dilatation I a := fun k =>
      if k = i then -(x : dilatation I a)
      else ((DFinsupp.erase i v k : dilGrading 𝒜 I a k) : dilatation I a)
    have hu : ∀ k ∈ insert i (DFinsupp.erase i v).support, u k ∈ dilGrading 𝒜 I a k := by
      intro k _
      by_cases hk : k = i
      · subst hk; simp [u]
      · simp [u, hk]
    have hsum : ∑ k ∈ insert i (DFinsupp.erase i v).support, u k = 0 := by
      rw [Finset.sum_insert hi]
      have : ∑ k ∈ (DFinsupp.erase i v).support, u k = x := by
        rw [← hs]
        refine Finset.sum_congr rfl fun k hk => ?_
        have hki : k ≠ i := fun e => hi (e ▸ hk)
        simp [u, hki]
      rw [this]
      simp [u]
    have h0 := eq_zero_of_sum_dilGrading ha ha0 _ u hu hsum (Finset.mem_insert_self i _)
    apply Subtype.ext
    simpa [u] using h0
  · rw [eq_top_iff]
    rintro ⟨u, hu⟩ -
    classical
    obtain ⟨n, x, hx, rfl⟩ := (mem_dilatation_iff ha).1 hu
    have hsum := DirectSum.sum_support_decompose 𝒜 x
    have : (⟨dilFrac a x n, hu⟩ : dilatation I a) =
        ∑ i ∈ (DirectSum.decompose 𝒜 x).support,
          ⟨dilFrac a (DirectSum.decompose 𝒜 x i : A) n, dilFrac_mem_dilatation
            (isHomogeneous_pow hI n i hx)⟩ := by
      apply Subtype.ext
      rw [AddSubmonoidClass.coe_finsetSum]
      simp only
      rw [← dilFrac_sum, hsum]
    rw [this]
    refine Submodule.sum_mem _ fun i _ => Submodule.mem_iSup_of_mem i (Submodule.subset_span
      ⟨n, _, SetLike.coe_mem _, isHomogeneous_pow hI n i hx, rfl⟩)

/-- **Proposition 13.1, first assertion, affine case**: `𝔸(M)_S` acts on `Bl_Y^D X`, i.e. `A[I/a]`
is `M`-graded, when `I` is homogeneous (`Y` stable) and `a` has degree zero (`S'` comes from the
base). `M` may be any commutative monoid here; the paper has an abelian group. -/
@[instance_reducible] def dilatationGradedAlgebra (ha : a ∈ I) (ha0 : a ∈ 𝒜 0) (hI : I.IsHomogeneous 𝒜) :
    GradedAlgebra (dilGrading 𝒜 I a) where
  one_mem := Submodule.subset_span ⟨0, 1, SetLike.GradedOne.one_mem, by simp, by
    rw [dilFrac_zero_right, map_one]; rfl⟩
  mul_mem := by
    intro i j u v hu hv
    obtain ⟨n, x, hx, hxI, hu⟩ := (mem_dilGrading_iff ha ha0).1 hu
    obtain ⟨p, y, hy, hyI, hv⟩ := (mem_dilGrading_iff ha ha0).1 hv
    refine Submodule.subset_span ⟨n + p, x * y, SetLike.mul_mem_graded hx hy, ?_, ?_⟩
    · rw [pow_add]; exact Ideal.mul_mem_mul hxI hyI
    · rw [dilFrac_mul, ← hu, ← hv]; rfl
  toDecomposition := (isInternal_dilGrading ha ha0 hI).chooseDecomposition

variable (𝒜 I a) (N : Magnet M)

/-- `J'_N`: the ideal of the attractor `(Bl_Y^D X)^N = Spec (A[I/a] / J'_N)`. -/
abbrev dilJ : Ideal (dilatation I a) := magnetIdeal (dilGrading 𝒜 I a) N

/-- The center of the dilatation of `X^N = Spec (A/J_N)`: the image of `I`. Its closed subscheme is
`Y^N`, see `magnetIdeal_map_quotient_dil`. -/
abbrev centerN : Ideal (A ⧸ magnetIdeal 𝒜 N) := I.map (Ideal.Quotient.mk _)

/-- The image of `a` in `A/J_N`. -/
abbrev elemN : A ⧸ magnetIdeal 𝒜 N := Ideal.Quotient.mk _ a

/-- The coordinate ring `(A/J_N)[Ī/ā]` of `Bl_{Y^N}^{D^N} X^N`. -/
abbrev dilN : Subalgebra (A ⧸ magnetIdeal 𝒜 N) (Localization.Away (elemN 𝒜 a N)) :=
  dilatation (centerN 𝒜 I N) (elemN 𝒜 a N)

/-- `Y^N` is the closed subscheme `V(Ī)` of `X^N`: in the quotient `A/I` with the image grading,
the magnet ideal is the image of `J_N`, so `(A/I)/J_N(A/I) = A/(I + J_N) = (A/J_N)/Ī`. -/
lemma magnetIdeal_map_quotient_dil :
    magnetIdeal (fun m => (𝒜 m).map (Ideal.Quotient.mkₐ R₀ I).toLinearMap) N =
      (magnetIdeal 𝒜 N).map (Ideal.Quotient.mk I) := by
  apply le_antisymm
  · rw [magnetIdeal, Ideal.span_le]
    intro y hy
    simp only [Set.mem_iUnion, SetLike.mem_coe, Submodule.mem_map] at hy
    obtain ⟨m, hm, x, hx, rfl⟩ := hy
    exact Ideal.mem_map_of_mem _ (mem_magnetIdeal_of_notMem hm hx)
  · rw [Ideal.map_le_iff_le_comap, magnetIdeal, Ideal.span_le]
    intro x hx
    simp only [Set.mem_iUnion, SetLike.mem_coe] at hx
    obtain ⟨m, hm, hx⟩ := hx
    exact mem_magnetIdeal_of_notMem hm (Submodule.mem_map_of_mem hx)

variable {𝒜 I a N}

/-- The map `A → (A/J_N)[Ī/ā]`. -/
abbrev rhoN : A →+* dilN 𝒜 I a N :=
  (algebraMap _ (dilN 𝒜 I a N)).comp (Ideal.Quotient.mk (magnetIdeal 𝒜 N))

private lemma rhoN_center {x : A} (hx : x ∈ I) :
    rhoN (𝒜 := 𝒜) (I := I) (a := a) (N := N) x =
      rhoN a * dilOverA (I := centerN 𝒜 I N) (a := elemN 𝒜 a N) (Ideal.mem_map_of_mem _ hx) :=
  (algebraMap_mul_dilOverA _).symm

/-- The map `A[I/a] → (A/J_N)[Ī/ā]` from the universal property of dilatations. -/
def dilToN : dilatation I a →+* dilN 𝒜 I a N :=
  dilatationLift rhoN (fun b h => dilatation_regular b h) (fun _ hx => ⟨_, rhoN_center hx⟩)

@[simp] lemma dilToN_algebraMap (r : A) :
    dilToN (𝒜 := 𝒜) (N := N) (algebraMap A (dilatation I a) r) = rhoN r :=
  dilatationLift_algebraMap _ _ _ r

private lemma rhoN_pow_regular (n : ℕ) (b : dilN 𝒜 I a N)
    (h : rhoN (𝒜 := 𝒜) (I := I) (a := a) (N := N) a ^ n * b = 0) : b = 0 :=
  regular_pow (c := rhoN (𝒜 := 𝒜) (I := I) (a := a) (N := N) a)
    (fun b h => dilatation_regular b h) n b h

/-- `dilToN` kills `J'_N`. -/
lemma dilJ_le_ker (ha : a ∈ I) (ha0 : a ∈ 𝒜 0) :
    dilJ 𝒜 I a N ≤ RingHom.ker (dilToN (𝒜 := 𝒜) (I := I) (a := a) (N := N)) := by
  refine Ideal.span_le.2 ?_
  intro u hu
  simp only [Set.mem_iUnion, SetLike.mem_coe] at hu
  obtain ⟨m, hm, hu⟩ := hu
  obtain ⟨n, x, hx, -, hxu⟩ := (mem_dilGrading_iff ha ha0).1 hu
  have e := congrArg (dilToN (𝒜 := 𝒜) (N := N)) (dil_pow_mul u hxu)
  rw [map_mul, map_pow, dilToN_algebraMap, dilToN_algebraMap] at e
  have hx0 : rhoN (𝒜 := 𝒜) (I := I) (a := a) (N := N) x = 0 := by
    simp [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem.2 (mem_magnetIdeal_of_notMem hm hx)]
  rw [hx0] at e
  exact rhoN_pow_regular n _ e

/-- The canonical ring map `A[I/a] / J'_N → (A/J_N)[Ī/ā]`, always defined (`a ∈ I`, `a` of degree
`0`). It is the comorphism of a morphism `Bl_{Y^N}^{D^N} X^N → (Bl_Y^D X)^N`, going in the direction
opposite to the paper's map; when bijective, its inverse is the comorphism of the paper's map. -/
def dilQuotHom (ha : a ∈ I) (ha0 : a ∈ 𝒜 0) :
    (dilatation I a ⧸ dilJ 𝒜 I a N) →+* dilN 𝒜 I a N :=
  Ideal.Quotient.lift _ dilToN fun _ hu => dilJ_le_ker ha ha0 hu

/-- The map `A/J_N → A[I/a] / J'_N`. -/
def quotToDilQuot : (A ⧸ magnetIdeal 𝒜 N) →+* (dilatation I a ⧸ dilJ 𝒜 I a N) :=
  Ideal.Quotient.lift _ ((Ideal.Quotient.mk _).comp (algebraMap A (dilatation I a))) (by
    intro x hx
    have hle : magnetIdeal 𝒜 N ≤ (dilJ 𝒜 I a N).comap (algebraMap A (dilatation I a)) := by
      rw [magnetIdeal, Ideal.span_le]
      intro y hy
      simp only [Set.mem_iUnion, SetLike.mem_coe] at hy
      obtain ⟨m, hm, hy⟩ := hy
      exact mem_magnetIdeal_of_notMem hm (algebraMap_mem_dilGrading hy)
    exact Ideal.Quotient.eq_zero_iff_mem.2 (hle hx))

lemma dilQuotHom_surjective (ha : a ∈ I) (ha0 : a ∈ 𝒜 0) :
    Function.Surjective (dilQuotHom (𝒜 := 𝒜) (I := I) (a := a) (N := N) ha ha0) := by
  rintro ⟨v, hv⟩
  suffices h : ∀ hv' : v ∈ dilN 𝒜 I a N,
      ∃ w : dilatation I a, dilToN (𝒜 := 𝒜) (N := N) w = ⟨v, hv'⟩ by
    obtain ⟨w, hw⟩ := h hv
    exact ⟨Ideal.Quotient.mk _ w, hw⟩
  induction hv using Algebra.adjoin_induction with
  | mem u hu =>
    intro _
    obtain ⟨x', hx', rfl⟩ := hu
    obtain ⟨x, hx, rfl⟩ := (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).1 hx'
    refine ⟨dilOverA hx, ?_⟩
    rw [← sub_eq_zero]
    apply dilatation_regular (I := centerN 𝒜 I N) (a := elemN 𝒜 a N)
    rw [mul_sub, sub_eq_zero]
    have e := congrArg (dilToN (𝒜 := 𝒜) (N := N)) (algebraMap_mul_dilOverA (a := a) hx)
    rw [map_mul, dilToN_algebraMap, dilToN_algebraMap] at e
    exact e.trans (algebraMap_mul_dilOverA (I := centerN 𝒜 I N) (a := elemN 𝒜 a N) hx').symm
  | algebraMap r =>
    intro _
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
    exact ⟨algebraMap A _ r, dilToN_algebraMap r⟩
  | add u v hu hv ihu ihv =>
    intro _
    obtain ⟨w, hw⟩ := ihu hu
    obtain ⟨w', hw'⟩ := ihv hv
    exact ⟨w + w', by rw [map_add, hw, hw']; rfl⟩
  | mul u v hu hv ihu ihv =>
    intro _
    obtain ⟨w, hw⟩ := ihu hu
    obtain ⟨w', hw'⟩ := ihv hv
    exact ⟨w * w', by rw [map_mul, hw, hw']; rfl⟩

/-- Regularity of `a` on `A[I/a] / J'_N`, i.e. `(Bl_Y^D X)^N` is `S'`-regular. -/
def DilQuotRegular (𝒜 : M → Submodule R₀ A) (I : Ideal A) (a : A) (N : Magnet M) : Prop :=
  ∀ b : dilatation I a ⧸ dilJ 𝒜 I a N,
    Ideal.Quotient.mk _ (algebraMap A (dilatation I a) a) * b = 0 → b = 0

private lemma dilQuotHom_injective_of_regular (ha : a ∈ I) (ha0 : a ∈ 𝒜 0)
    (hreg : DilQuotRegular 𝒜 I a N) :
    Function.Injective (dilQuotHom (𝒜 := 𝒜) (I := I) (a := a) (N := N) ha ha0) := by
  let q : (A ⧸ magnetIdeal 𝒜 N) →+* (dilatation I a ⧸ dilJ 𝒜 I a N) :=
    quotToDilQuot (𝒜 := 𝒜) (I := I) (a := a) (N := N)
  have hreg' : ∀ b, q (elemN 𝒜 a N) * b = 0 → b = 0 := hreg
  have hcenter : ∀ x ∈ centerN 𝒜 I N, ∃ b, q x = q (elemN 𝒜 a N) * b := by
    intro x' hx'
    obtain ⟨x, hx, rfl⟩ := (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).1 hx'
    refine ⟨Ideal.Quotient.mk _ (dilOverA hx), ?_⟩
    change Ideal.Quotient.mk _ (algebraMap A (dilatation I a) x) =
      Ideal.Quotient.mk _ (algebraMap A (dilatation I a) a) * _
    rw [← map_mul, algebraMap_mul_dilOverA]
  let g : dilN 𝒜 I a N →+* (dilatation I a ⧸ dilJ 𝒜 I a N) :=
    dilatationLift (I := centerN 𝒜 I N) (a := elemN 𝒜 a N) q hreg' hcenter
  have hg : ∀ r : A ⧸ magnetIdeal 𝒜 N, g (algebraMap _ (dilN 𝒜 I a N) r) = q r :=
    dilatationLift_algebraMap (I := centerN 𝒜 I N) (a := elemN 𝒜 a N) q hreg' hcenter
  have hcomp : g.comp (dilToN (𝒜 := 𝒜) (I := I) (a := a) (N := N)) =
      Ideal.Quotient.mk (dilJ 𝒜 I a N) := by
    refine dilatation_ringHom_ext
      ((Ideal.Quotient.mk (dilJ 𝒜 I a N)).comp (algebraMap A (dilatation I a))) ha hreg ?_ fun _ => rfl
    intro r
    change g (dilToN (𝒜 := 𝒜) (N := N) (algebraMap A _ r)) = _
    rw [dilToN_algebraMap]
    exact hg _
  intro x y hxy
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
  have e : dilToN (𝒜 := 𝒜) (I := I) (a := a) (N := N) x = dilToN (𝒜 := 𝒜) (N := N) y := hxy
  have hx := congrArg (· x) hcomp
  have hy := congrArg (· y) hcomp
  simp only [RingHom.comp_apply] at hx hy
  rw [← hx, ← hy, e]

/-- **Proposition 13.1, affine case, sharp form.** The canonical map
`A[I/a] / J'_N → (A/J_N)[Ī/ā]` is surjective, and it is bijective iff `a` is regular on
`A[I/a] / J'_N`. In the paper's notation, `(Bl_Y^D X)^N = Bl_{Y^N}^{D^N} X^N` iff `(Bl_Y^D X)^N` is
`S'`-regular; neither flatness of `X` nor of `Bl_{Y^N}^{D^N} X^N` is needed. -/
theorem dilQuotHom_bijective_iff (ha : a ∈ I) (ha0 : a ∈ 𝒜 0) :
    Function.Bijective (dilQuotHom (𝒜 := 𝒜) (I := I) (a := a) (N := N) ha ha0) ↔
      DilQuotRegular 𝒜 I a N := by
  constructor
  · intro hbij b hb
    apply hbij.1
    rw [map_zero]
    obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective b
    apply dilatation_regular (I := centerN 𝒜 I N) (a := elemN 𝒜 a N)
    have e := congrArg (dilQuotHom (𝒜 := 𝒜) (I := I) (a := a) (N := N) ha ha0) hb
    rw [← map_mul, map_zero] at e
    change dilToN (𝒜 := 𝒜) (N := N) (_ * w) = 0 at e
    rw [map_mul, dilToN_algebraMap] at e
    exact e
  · intro hreg
    refine ⟨?_, dilQuotHom_surjective ha ha0⟩
    exact dilQuotHom_injective_of_regular ha ha0 hreg

/-- **Proposition 13.1, flatness hypothesis.** If `A[I/a] / J'_N` is flat over `R₀`
(the paper's hypothesis that `(Bl_Y^D X)^N → S` is flat) and `a` comes from `r ∈ R₀`, then `a` is
regular on it. No regularity of `r` in `R₀` is needed: `Ann(r)` kills `A[I/a]`. -/
theorem dilQuotRegular_of_flat (r : R₀) (hflat : Module.Flat R₀
      (dilatation I (algebraMap R₀ A r) ⧸ dilJ 𝒜 I (algebraMap R₀ A r) N)) :
    DilQuotRegular 𝒜 I (algebraMap R₀ A r) N := by
  intro b hb
  have h0 : ∑ _i : Unit, (fun _ : Unit => r) () • b = 0 := by
    simp only [Finset.univ_unique, Finset.sum_singleton, Algebra.smul_def]
    exact hb
  obtain ⟨k, c, y, hxy, hrel⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
    (f := fun _ : Unit => r) (x := fun _ : Unit => b) (by simpa using h0)
  have hb' : b = ∑ j, c () j • y j := hxy ()
  rw [hb']
  refine Finset.sum_eq_zero fun j _ => ?_
  have hc : r * c () j = 0 := by simpa using hrel j
  have hc0 : algebraMap R₀ (dilatation I (algebraMap R₀ A r)) (c () j) = 0 := by
    apply dilatation_regular
    change algebraMap A _ (algebraMap R₀ A r) * algebraMap A _ (algebraMap R₀ A (c () j)) = 0
    rw [← map_mul, ← map_mul, hc, map_zero, map_zero]
  rw [Algebra.smul_def]
  change Ideal.Quotient.mk _ (algebraMap R₀ (dilatation I (algebraMap R₀ A r)) (c () j)) * _ = 0
  rw [hc0, map_zero, zero_mul]

end Graded

section Main

variable {M R₀ A : Type*} [AddCommMonoid M] [DecidableEq M] [CommRing R₀] [CommRing A]
  [Algebra R₀ A] {𝒜 : M → Submodule R₀ A} [GradedAlgebra 𝒜] {I : Ideal A} {N : Magnet M} (r : R₀)

local notation "a₀" => algebraMap R₀ A r

/-- **Proposition 13.1** (Mayeux, *Algebraic Magnetism*), affine case: `S = Spec R₀`, `S' = V(r)`,
`X = Spec A`, `Y = V(I)`, `a₀ ∈ I`, `I` homogeneous. If `(Bl_Y^D X)^N → S` is flat, then the
canonical map is an isomorphism `(Bl_Y^D X)^N = Bl_{Y^N}^{D^N} X^N` of `S`-schemes, i.e. an
`R₀`-algebra isomorphism `A[I/a] / J'_N ≃ (A/J_N)[Ī/ā]`. Only flatness of `(Bl_Y^D X)^N` is used.
The homogeneity of `I` gives the action (`dilatationGradedAlgebra`) and is not otherwise needed. -/
def dilQuotEquivOfFlat (ha : a₀ ∈ I)
    (hflat : Module.Flat R₀ (dilatation I a₀ ⧸ dilJ 𝒜 I a₀ N)) :
    (dilatation I a₀ ⧸ dilJ 𝒜 I a₀ N) ≃ₐ[R₀] dilN 𝒜 I a₀ N :=
  AlgEquiv.ofRingEquiv
    (f := RingEquiv.ofBijective (dilQuotHom ha (SetLike.algebraMap_mem_graded 𝒜 r))
      ((dilQuotHom_bijective_iff ha _).2 (dilQuotRegular_of_flat r hflat))) (by
      intro s
      exact dilToN_algebraMap (algebraMap R₀ A s))

/-- **Proposition 13.1, functor of points**, affine case: for every `R₀`-algebra `C`,
`(Bl_Y^D X)^N(C) = Hom^{M-graded}_{R₀}(A[I/a], C[N])` is in bijection with
`(Bl_{Y^N}^{D^N} X^N)(C) = Hom_{R₀}((A/J_N)[Ī/ā], C)`, under flatness of `(Bl_Y^D X)^N`. -/
def attractorDilatationEquivOfFlat (ha : a₀ ∈ I) (hI : I.IsHomogeneous 𝒜)
    (hflat : Module.Flat R₀ (dilatation I a₀ ⧸ dilJ 𝒜 I a₀ N))
    (C : Type*) [CommRing C] [Algebra R₀ C] :
    Attractor (dilGrading 𝒜 I a₀) N C ≃ (dilN 𝒜 I a₀ N →ₐ[R₀] C) :=
  letI := dilatationGradedAlgebra ha (SetLike.algebraMap_mem_graded 𝒜 r) hI
  (attractorEquiv (dilGrading 𝒜 I a₀) N C).symm.trans
    ((dilQuotEquivOfFlat r ha hflat).arrowCongr AlgEquiv.refl)

end Main

end AlgMag
