import AlgMag.Sec3Intersections
import AlgMag.Sec8Theorem83
import AlgMag.Sec6Atlas

/-!
# Proposition 3.32 (ii), Fact 3.34, Proposition 15.1 with one `Z`-FPR atlas per subgroup

Mayeux, *Algebraic Magnetism*, §3, §6, §15.

The proofs of `AlgMag.Sec3Intersections` use a point `x` of `X` fixed by `D(M/N^×)` and by `D(M/L^×)`.
Such a point is fixed by `D(M/(N^× ∩ L^×))`, on `X` itself, with no atlas (`AlgMag.mem_fixedPoints_inf`):
`D(M/N^×) × D(M/L^×) → D(M/(N^× ∩ L^×))` is surjective for the fppf topology. So one
`(N ∩ L)^×`-FPR atlas suffices for two magnets, as supplied by Theorem 6.8, and different atlases can
serve at different steps. The atlas may be a disjoint union as in Definition 6.1 (iv).
-/

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry
universe u
set_option linter.unusedSectionVars false

namespace AlgMag

section Site

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
local notation "Sch" => BigFppfOver.toScheme B S hS
attribute [local instance] hasPullbacks_bigFppfOver preservesPullbacks_bigFppfOverToScheme

variable {M : Type u} [AddCommGroup M] [AddMonoid.FG M]

/-- The units of `N ⊓ L` are the common units. -/
lemma unitsSubgroup_inf (N L : AddSubmonoid M) :
    unitsSubgroup (N ⊓ L) = unitsSubgroup N ⊓ unitsSubgroup L := by
  ext x
  constructor
  · rintro ⟨⟨h1, h2⟩, y, ⟨h3, h4⟩, e⟩
    exact ⟨⟨h1, y, h3, e⟩, ⟨h2, y, h4, e⟩⟩
  · rintro ⟨⟨h1, y, h3, e⟩, ⟨h2, y', h4, e'⟩⟩
    have : y = y' := add_left_cancel (e.trans e'.symm)
    subst this
    exact ⟨⟨h1, h2⟩, y, ⟨h3, h4⟩, e⟩

/-- The subgroup of `M × M` generated by the diagonal and `Z₁ × Z₂`. -/
def diagSub (Z₁ Z₂ : AddSubgroup M) : AddSubgroup (M × M) where
  carrier := {p | ∃ m, p.1 - m ∈ Z₁ ∧ p.2 - m ∈ Z₂}
  zero_mem' := ⟨0, by simp [Z₁.zero_mem], by simp [Z₂.zero_mem]⟩
  add_mem' := by
    rintro a b ⟨m, h1, h2⟩ ⟨n, h3, h4⟩
    refine ⟨m + n, ?_, ?_⟩
    · have := Z₁.add_mem h1 h3
      rwa [show a.1 - m + (b.1 - n) = (a + b).1 - (m + n) by simp only [Prod.fst_add]; abel] at this
    · have := Z₂.add_mem h2 h4
      rwa [show a.2 - m + (b.2 - n) = (a + b).2 - (m + n) by simp only [Prod.snd_add]; abel] at this
  neg_mem' := by
    rintro a ⟨m, h1, h2⟩
    refine ⟨-m, ?_, ?_⟩
    · have := Z₁.neg_mem h1
      rwa [show -(a.1 - m) = (-a).1 - -m by simp only [Prod.fst_neg]; abel] at this
    · have := Z₂.neg_mem h2
      rwa [show -(a.2 - m) = (-a).2 - -m by simp only [Prod.snd_neg]; abel] at this

/-- **A point fixed by `D(M/Z₁)` and by `D(M/Z₂)` is fixed by `D(M/(Z₁ ∩ Z₂))`**, on any sheaf: no atlas.
A point `h` of `D(M/(Z₁ ∩ Z₂))` is, fppf locally, a product of points of `D(M/Z₁)` and `D(M/Z₂)`. -/
theorem mem_fixedPoints_inf {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (hF : Presieve.IsSheaf (BigFppfOver.topology B S hS) F) {act : AAction (fppfO B S hS) M F}
    {Z₁ Z₂ : AddSubgroup M} {T : (BigFppfOver B S hS)ᵒᵖ} {x : F.obj T}
    (h₁ : x ∈ (fixedPoints (quotientAction act Z₁)).obj T)
    (h₂ : x ∈ (fixedPoints (quotientAction act Z₂)).obj T) :
    x ∈ (fixedPoints (quotientAction act (Z₁ ⊓ Z₂))).obj T := by
  classical
  have : AddGroup.FG (M × M) := by
    rw [AddGroup.fg_iff_addMonoid_fg]; infer_instance
  rw [mem_fixedPoints_quotient_iff] at h₁ h₂ ⊢
  intro T' s h hh
  have hwd : ∀ m m' : M, m - m' ∈ Z₁ ⊓ Z₂ →
      h (Multiplicative.ofAdd m) = h (Multiplicative.ofAdd m') := by
    intro m m' e
    have h0 : h (Multiplicative.ofAdd (m - m')) = 1 :=
      DFunLike.congr_fun hh (Multiplicative.ofAdd (⟨m - m', e⟩ : (Z₁ ⊓ Z₂).toAddSubmonoid))
    have : Multiplicative.ofAdd m = Multiplicative.ofAdd (m - m') * Multiplicative.ofAdd m' := by
      rw [← ofAdd_add]; simp
    rw [this, map_mul, h0, one_mul]
  let D := diagSub Z₁ Z₂
  have hkey : ∀ (p : M × M) (hp : p ∈ D) (m : M), p.1 - m ∈ Z₁ → p.2 - m ∈ Z₂ →
      h (Multiplicative.ofAdd (Exists.choose hp)) = h (Multiplicative.ofAdd m) := by
    intro p hp m a b
    refine hwd _ _ ⟨?_, ?_⟩
    · have := Z₁.sub_mem a (Exists.choose_spec hp).1
      rwa [show p.1 - m - (p.1 - Exists.choose hp) = Exists.choose hp - m by abel] at this
    · have := Z₂.sub_mem b (Exists.choose_spec hp).2
      rwa [show p.2 - m - (p.2 - Exists.choose hp) = Exists.choose hp - m by abel] at this
  let a : APt (fppfO B S hS) D.toAddSubmonoid T' :=
    { toFun := fun p => h (Multiplicative.ofAdd
        (Exists.choose (show (Multiplicative.toAdd p).1 ∈ D from (Multiplicative.toAdd p).2)))
      map_one' := by
        refine (hkey 0 D.zero_mem 0 (by simp [Z₁.zero_mem]) (by simp [Z₂.zero_mem])).trans ?_
        exact map_one h
      map_mul' := by
        intro p q
        have hp : (Multiplicative.toAdd p).1 ∈ D := (Multiplicative.toAdd p).2
        have hq : (Multiplicative.toAdd q).1 ∈ D := (Multiplicative.toAdd q).2
        have hpq : (Multiplicative.toAdd (p * q)).1 ∈ D := (Multiplicative.toAdd (p * q)).2
        refine (hkey _ hpq (Exists.choose hp + Exists.choose hq) ?_ ?_).trans ?_
        · have := Z₁.add_mem (Exists.choose_spec hp).1 (Exists.choose_spec hq).1
          rwa [show (Multiplicative.toAdd p).1.1 - Exists.choose hp +
            ((Multiplicative.toAdd q).1.1 - Exists.choose hq) =
            (Multiplicative.toAdd (p * q)).1.1 - (Exists.choose hp + Exists.choose hq) by
              simp only [toAdd_mul, AddSubmonoid.coe_add, Prod.fst_add]; abel] at this
        · have := Z₂.add_mem (Exists.choose_spec hp).2 (Exists.choose_spec hq).2
          rwa [show (Multiplicative.toAdd p).1.2 - Exists.choose hp +
            ((Multiplicative.toAdd q).1.2 - Exists.choose hq) =
            (Multiplicative.toAdd (p * q)).1.2 - (Exists.choose hp + Exists.choose hq) by
              simp only [toAdd_mul, AddSubmonoid.coe_add, Prod.snd_add]; abel] at this
        · rw [ofAdd_add, map_mul] }
  have ha : ∀ (p : M × M) (hp : p ∈ D) (m : M), p.1 - m ∈ Z₁ → p.2 - m ∈ Z₂ →
      a (Multiplicative.ofAdd (⟨p, hp⟩ : D.toAddSubmonoid)) = h (Multiplicative.ofAdd m) :=
    fun p hp m e e' => hkey p hp m e e'
  have hmem := extSieve_mem D (T := unop T') a
  refine (hF _ hmem).isSeparatedFor.ext fun {Y} i hi => ?_
  obtain ⟨c, hc⟩ := hi
  have hcv : ∀ (p : M × M) (hp : p ∈ D) (m : M), p.1 - m ∈ Z₁ → p.2 - m ∈ Z₂ →
      c (Multiplicative.ofAdd p) = APt.res i.op h (Multiplicative.ofAdd m) := by
    intro p hp m e e'
    have := DFunLike.congr_fun hc (Multiplicative.ofAdd (⟨p, hp⟩ : D.toAddSubmonoid))
    refine this.trans ?_
    simp only [APt.res_apply]
    exact congrArg _ (ha p hp m e e')
  let c₁ : APt (fppfO B S hS) M (op Y) :=
    c.comp (AddMonoidHom.toMultiplicative (AddMonoidHom.inl M M))
  let c₂ : APt (fppfO B S hS) M (op Y) :=
    c.comp (AddMonoidHom.toMultiplicative (AddMonoidHom.inr M M))
  have hres0 : APt.res i.op h (Multiplicative.ofAdd (0 : M)) = 1 := map_one _
  have t₁ : TrivialOn Z₁ c₁ := by
    refine MonoidHom.ext fun n => ?_
    obtain ⟨z, hz⟩ : ∃ z : M, z ∈ Z₁ ∧ z = ((Multiplicative.toAdd n).1 : M) := ⟨_, (Multiplicative.toAdd n).2, rfl⟩
    obtain ⟨hz, ez⟩ := hz
    change c (Multiplicative.ofAdd (((Multiplicative.toAdd n).1 : M), (0 : M))) = 1
    rw [← ez]
    rw [hcv (z, 0) ⟨0, by simpa using hz, by simp [Z₂.zero_mem]⟩ 0 (by simpa using hz)
      (by simp [Z₂.zero_mem]), hres0]
  have t₂ : TrivialOn Z₂ c₂ := by
    refine MonoidHom.ext fun n => ?_
    obtain ⟨z, hz⟩ : ∃ z : M, z ∈ Z₂ ∧ z = ((Multiplicative.toAdd n).1 : M) := ⟨_, (Multiplicative.toAdd n).2, rfl⟩
    obtain ⟨hz, ez⟩ := hz
    change c (Multiplicative.ofAdd ((0 : M), ((Multiplicative.toAdd n).1 : M))) = 1
    rw [← ez]
    rw [hcv (0, z) ⟨0, by simp [Z₁.zero_mem], by simpa using hz⟩ 0 (by simp [Z₁.zero_mem])
      (by simpa using hz), hres0]
  have hprod : APt.res i.op h = c₁ * c₂ := by
    refine MonoidHom.ext fun m => ?_
    have e := hcv (Multiplicative.toAdd m, Multiplicative.toAdd m)
      ⟨Multiplicative.toAdd m, by simp [Z₁.zero_mem], by simp [Z₂.zero_mem]⟩ (Multiplicative.toAdd m)
      (by simp [Z₁.zero_mem]) (by simp [Z₂.zero_mem])
    refine e.symm.trans ?_
    rw [MonoidHom.mul_apply]
    change c _ = c _ * c _
    rw [← map_mul]
    congr 1
    exact congrArg Multiplicative.ofAdd
      (Prod.ext (add_zero _).symm (zero_add _).symm)
  have hms := act.map_smul i.op h (F.map s x)
  change F.map i.op (act.smul h (F.map s x)) = F.map i.op (F.map s x)
  rw [hms, hprod, act.mul_smul]
  have e₂ := h₂ (s ≫ i.op) c₂ t₂
  have e₁ := h₁ (s ≫ i.op) c₁ t₁
  rw [Functor.map_comp_apply] at e₁ e₂
  rw [e₂, e₁]

variable {U : BigFppfOver B S hS} {aU : AAction (fppfO B S hS) M (yoneda.obj U)}
variable {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {aX : AAction (fppfO B S hS) M X}

/-- The core of the two-magnet case: `φ ∈ X^{N × L}(T)`, `u : T → U` a point of an `S`-affine scheme
étale and equivariant over `X`, lifting the limit point of `φ`, and fixed by `D(M/(N^× ∩ L^×))`. -/
theorem exists_inf_core [IsAffineHom U.hom.hom] (hX : IsAlgebraicSpace B S hS X)
    (hsep : IsSeparatedOver X) (F : EquivariantHom aU aX) (he : Space.IsEtale B S hS F.hom)
    {N L : AddSubmonoid M} (hb : (N.FG ∧ L.FG) ∨ IsLimitPreserving X) {T : BigFppfOver B S hS}
    (φ : AttractorPt (biAct aX) (N.prod L) T) (u : T ⟶ U)
    (hu : F.hom.app (op T) u =
      (AttractorPt.ofFace (isFace_units (N.prod L)) φ).toPoint)
    (hfix : u ∈ (fixedPoints (quotientAction aU (unitsSubgroup N ⊓ unitsSubgroup L))).obj (op T)) :
    ∃ χ : AttractorPt aX (N ⊓ L) T, χ.toPoint = φ.toPoint := by
  have : AddGroup.FG M := AddGroup.fg_iff_addMonoid_fg.mpr inferInstance
  let F₂ : EquivariantHom (biAct aU) (biAct aX) := ⟨F.hom, fun h x => F.map_smul _ x⟩
  let Q := unitsSubgroup (N.prod L)
  have hQ : IsFace Q.toAddSubmonoid (N.prod L) := isFace_units _
  let Z := unitsSubgroup N ⊓ unitsSubgroup L
  have hcov : ∀ {W : BigFppfOver B S hS} (a : APt (fppfO B S hS) Z.toAddSubmonoid (op W)),
      extSieve (fppfO B S hS) Z a ∈ BigFppfOver.topology B S hS W :=
    fun a => extSieve_mem Z a
  let wK : AttractorPt aU Z.toAddSubmonoid T :=
    attractorFixedEquivOfCover (BigFppfOver.isSheaf_of_type_yoneda_obj U) hcov T ⟨u, hfix⟩
  have hwK : wK.toPoint = u := congrArg Subtype.val
    ((attractorFixedEquivOfCover (act := aU) (BigFppfOver.isSheaf_of_type_yoneda_obj U)
      hcov T).symm_apply_apply ⟨u, hfix⟩)
  have hK : ∀ k ∈ Z.toAddSubmonoid, (k, k) ∈ Q.toAddSubmonoid := by
    rintro k ⟨⟨h1, y1, hy1, e1⟩, ⟨h2, y2, hy2, e2⟩⟩
    exact ⟨⟨h1, h2⟩, (y1, y2), ⟨hy1, hy2⟩, Prod.ext e1 e2⟩
  let wZ : AttractorPt (biAct aU) Q.toAddSubmonoid T := wK.toBi hK
  have hpush : AttractorPt.ofFace hQ φ = AttractorPt.push F₂ wZ := by
    apply attractor_toPoint_injective_sep hX hsep
    change _ = F.hom.app (op T) wZ.toPoint
    have e : wZ.toPoint = u := (AttractorPt.toPoint_toBi hK wK).trans hwK
    rw [e, hu]
  have hcart : IsFaceCartesian F₂ hQ := by
    rcases hb with ⟨hN, hL⟩ | hl
    · exact isFaceCartesian_of_fg hX hsep F₂ he hQ (hN.prod hL)
    · exact isFaceCartesian_of_separated hX hsep hl F₂ he hQ
  obtain ⟨w, hw⟩ := (hcart T).2 ⟨(φ, wZ), hpush⟩
  have hw' : AttractorPt.push F₂ w = φ := congrArg (fun p => p.1.1) hw
  let wN : AttractorPt aU N T := w.ofBi (AddMonoidHom.fst M M) (fun _ => rfl) pFst (fun _ => rfl)
  let wL : AttractorPt aU L T := w.ofBi (AddMonoidHom.snd M M) (fun _ => rfl) pSnd (fun _ => rfl)
  obtain ⟨v, hv⟩ := exists_sInf_of_isAffineHom (aU := aU) (s := {N, L}) ⟨_, Or.inl rfl⟩ w.toPoint (by
    rintro K (rfl | rfl)
    · exact ⟨wN, AttractorPt.toPoint_ofBi _ _ _ _ _⟩
    · exact ⟨wL, AttractorPt.toPoint_ofBi _ _ _ _ _⟩)
  have hinf : sInf ({N, L} : Set (AddSubmonoid M)) = N ⊓ L := sInf_pair
  refine ⟨AttractorPt.ofLE hinf.le (AttractorPt.push F v), ?_⟩
  rw [AttractorPt.toPoint_ofLE, ← hw']
  exact congrArg (F.hom.app (op T)) hv

/-- A point of a stable piece of `U`, fixed in `U`, is fixed in the piece. -/
lemma mem_fixed_piece {A : Type u} {V : A → ((Sch).obj U).Opens}
    (hV : IsAffineDecomposition aU V) (b : A) {Z : AddSubgroup M} {T : BigFppfOver B S hS}
    (t : T ⟶ openObj (V b)) (h : t ≫ openJ (V b) ∈ (fixedPoints (quotientAction aU Z)).obj (op T)) :
    t ∈ (fixedPoints (quotientAction (pieceAct (hV.stable b)) Z)).obj (op T) := by
  have : AddGroup.FG M := AddGroup.fg_iff_addMonoid_fg.mpr inferInstance
  intro T' s k
  have hm := mono_openJ (V := V b)
  apply (cancel_mono (openJ (V b))).1
  refine (pieceAct_spec (hV.stable b) (T := unop T') _ _).trans ?_
  exact h s k

/-- **The two-magnet step, with one `(N ∩ L)^×`-FPR atlas**, which may be any disjoint union of `S`-affine
stable pieces. -/
theorem exists_inf_of_bi_weak (hX : IsAlgebraicSpace B S hS X) (hsep : IsSeparatedOver X)
    {N L : AddSubmonoid M} (hat : ExistsZFPRAtlas aX (unitsSubgroup (N ⊓ L)))
    (hb : (N.FG ∧ L.FG) ∨ IsLimitPreserving X) {T : BigFppfOver B S hS}
    (φ : AttractorPt (biAct aX) (N.prod L) T) :
    ∃ χ : AttractorPt aX (N ⊓ L) T, χ.toPoint = φ.toPoint := by
  have : AddGroup.FG M := AddGroup.fg_iff_addMonoid_fg.mpr inferInstance
  obtain ⟨U, aU, f, hat⟩ := hat
  obtain ⟨A, V, hV⟩ := hat.atlas.decomposition
  have hsX := (isSheaf_iff_isSheaf_of_type _ _).mp hX.isSheaf
  have hinj := fun T => attractor_toPoint_injective_sep (aX := aX) hX hsep (N ⊓ L) T
  let F : EquivariantHom aU aX := ⟨f, hat.atlas.equivariant⟩
  let Q := unitsSubgroup (N.prod L)
  have hQ : IsFace Q.toAddSubmonoid (N.prod L) := isFace_units _
  let x₀ : AttractorPt (biAct aX) Q.toAddSubmonoid T := AttractorPt.ofFace hQ φ
  let g₀ : yoneda.obj T ⟶ X := yonedaEquiv.symm x₀.toPoint
  let rep := hat.atlas.etale.rep
  let T' := rep.pullback g₀
  let q : T' ⟶ T := rep.snd g₀
  let u : T' ⟶ U := rep.fst' g₀
  have hu : f.app (op T') u = X.map q.op x₀.toPoint := by
    have h2 : yoneda.map u ≫ f = yoneda.map q ≫ g₀ := by
      rw [Functor.relativelyRepresentable.map_fst']
      exact rep.w g₀
    have h3 := congrArg (fun k => k.app (op T') (𝟙 T')) h2
    have h4 : (yoneda.map u ≫ f).app (op T') (𝟙 T') = f.app (op T') u := by
      change f.app (op T') (𝟙 T' ≫ u) = _
      rw [Category.id_comp]
    have h5 : (yoneda.map q ≫ g₀).app (op T') (𝟙 T') = X.map q.op x₀.toPoint := by
      change g₀.app (op T') (𝟙 T' ≫ q) = _
      rw [Category.id_comp]
      simp [g₀, yonedaEquiv_symm_app_apply]
    exact h4.symm.trans (h3.trans h5)
  have hfixQ : X.map q.op x₀.toPoint ∈
      (fixedPoints (quotientAction (biAct aX) Q)).obj (op T') := by
    rw [← AttractorPt.toPoint_baseChange]
    exact (AttractorPt.baseChange q x₀).toPoint_mem_fixedPoints
  have hf₁ : X.map q.op x₀.toPoint ∈ (fixedPoints (quotientAction aX (unitsSubgroup N))).obj (op T') := mem_fixed_of_bi (AddMonoidHom.fst M M) (fun _ => rfl) (Z := unitsSubgroup N)
    (fun p hp => by
      obtain ⟨⟨h1, h2⟩, y, ⟨h3, h4⟩, e⟩ := hp
      exact ⟨h1, y.1, h3, congrArg Prod.fst e⟩) hfixQ
  have hf₂ : X.map q.op x₀.toPoint ∈ (fixedPoints (quotientAction aX (unitsSubgroup L))).obj (op T') := mem_fixed_of_bi (AddMonoidHom.snd M M) (fun _ => rfl) (Z := unitsSubgroup L)
    (fun p hp => by
      obtain ⟨⟨h1, h2⟩, y, ⟨h3, h4⟩, e⟩ := hp
      exact ⟨h2, y.2, h4, congrArg Prod.snd e⟩) hfixQ
  have hfX : X.map q.op x₀.toPoint ∈ (fixedPoints (quotientAction aX (unitsSubgroup N ⊓ unitsSubgroup L))).obj (op T') :=
    mem_fixedPoints_inf hsX hf₁ hf₂
  have hfU : u ∈ (fixedPoints (quotientAction aU (unitsSubgroup N ⊓ unitsSubgroup L))).obj (op T') := by
    have key : ∀ (T₀ : (BigFppfOver B S hS)ᵒᵖ) (x : (yoneda.obj U).obj T₀),
        f.app T₀ x ∈ (fixedPoints (quotientAction aX (unitsSubgroup (N ⊓ L)))).obj T₀ →
        x ∈ (fixedPoints (quotientAction aU (unitsSubgroup (N ⊓ L)))).obj T₀ :=
      (isFPR_iff (IsEquivariant.comap (actU := aU) (actX := aX) (f := f) hat.atlas.equivariant
        (QuotientAddGroup.mk' _))).mp hat.isZFPR
    have e := unitsSubgroup_inf N L
    have h0 : f.app (op T') u ∈ (fixedPoints (quotientAction aX (unitsSubgroup (N ⊓ L)))).obj (op T') := by
      rw [hu, e]; exact hfX
    have h1 : u ∈ (fixedPoints (quotientAction aU (unitsSubgroup (N ⊓ L)))).obj (op T') :=
      @key (op T') u h0
    rwa [e] at h1
  have hlocal : ∃ χ : AttractorPt aX (N ⊓ L) T',
      χ.toPoint = (AttractorPt.baseChange q φ).toPoint := by
    refine exists_toPoint_of_sieve hsX hinj _ _ (cover_mem hV u) ?_
    rintro Y g ⟨W, r, s', ⟨b⟩, rfl⟩
    let J₀ := openJ ((Sch).map u ⁻¹ᵁ V b)
    obtain ⟨u', hu'⟩ := exists_lift_open (V := V b) (J₀ ≫ u) (fun p => by
      change (Sch).map (J₀ ≫ u) p ∈ V b
      rw [Functor.map_comp]
      exact p.2)
    have hA : IsAffineHom (openObj (V b)).hom.hom := hV.isAffineHom b
    have hfix' : u' ∈ (fixedPoints (quotientAction (pieceAct (hV.stable b))
        (unitsSubgroup N ⊓ unitsSubgroup L))).obj (op _) := by
      refine mem_fixed_piece hV b u' ?_
      rw [hu']
      exact (fixedPoints _).map J₀.op hfU
    have he : Space.IsEtale B S hS ((pieceJ (hV.stable b)).comp F).hom :=
      isEtale_piece_comp hat.atlas.etale
    obtain ⟨χ, hχ⟩ := exists_inf_core hX hsep ((pieceJ (hV.stable b)).comp F) he hb
      (AttractorPt.baseChange (J₀ ≫ q) φ) u' (by
        refine (congrArg (f.app (op _)) hu').trans ?_
        refine (NatTrans.naturality_apply f J₀.op u).trans ?_
        rw [hu, ← Functor.map_comp_apply]
        exact (AttractorPt.toPoint_baseChange (J₀ ≫ q) x₀).symm) hfix'
    refine ⟨AttractorPt.baseChange r χ, ?_⟩
    rw [AttractorPt.toPoint_baseChange, hχ, AttractorPt.toPoint_baseChange,
      AttractorPt.toPoint_baseChange, ← Functor.map_comp_apply, ← Functor.map_comp_apply]
    rfl
  obtain ⟨χ', hχ'⟩ := hlocal
  refine exists_toPoint_of_sieve hsX hinj _ _
    (Space.sieve_generate_singleton_mem_topology_over B S hS q
      (hat.atlas.surjective.property_snd g₀) (hat.atlas.etale.property_snd g₀)) ?_
  rintro Y g ⟨W, a, b, ⟨⟩, rfl⟩
  refine ⟨AttractorPt.baseChange a χ', ?_⟩
  rw [AttractorPt.toPoint_baseChange, hχ', AttractorPt.toPoint_baseChange,
    ← Functor.map_comp_apply, ← op_comp]

/-- **Proposition 3.32 (ii)** with one `(N ∩ L)^×`-FPR atlas. -/
theorem prop332_weak (hX : IsAlgebraicSpace B S hS X) (hsep : IsSeparatedOver X)
    {N L : AddSubmonoid M} (hat : ExistsZFPRAtlas aX (unitsSubgroup (N ⊓ L)))
    (hb : (N.FG ∧ L.FG) ∨ IsLimitPreserving X) (T : BigFppfOver B S hS) :
    Function.Bijective (iterOfInf : AttractorPt aX (N ⊓ L) T → IterPt aX N L T) := by
  constructor
  · intro χ χ' h
    apply attractor_toPoint_injective_sep hX hsep
    have h' := (iterEquivBi T).symm.injective h
    have := congrArg AttractorPt.toPoint h'
    exact (AttractorPt.toPoint_toBi _ χ).symm.trans (this.trans (AttractorPt.toPoint_toBi _ χ'))
  · intro Ψ
    obtain ⟨χ, hχ⟩ := exists_inf_of_bi_weak hX hsep hat hb Ψ.toBi
    refine ⟨χ, ?_⟩
    apply (iterEquivBi T).injective
    rw [iterOfInf, Equiv.apply_symm_apply]
    apply attractor_toPoint_injective_sep hX hsep
    exact (AttractorPt.toPoint_toBi _ χ).trans hχ

/-- Two magnets of **Fact 3.34 (ii)**, with one `(N ∩ L)^×`-FPR atlas. -/
theorem attractorImage_inf_of_eq_weak (hX : IsAlgebraicSpace B S hS X) (hsep : IsSeparatedOver X)
    {N L : AddSubmonoid M} (hat : ExistsZFPRAtlas aX (unitsSubgroup (N ⊓ L)))
    (hb : (N.FG ∧ L.FG) ∨ IsLimitPreserving X)
    (h : attractorImage aX N = attractorImage aX L) :
    attractorImage aX (N ⊓ L) = attractorImage aX N := by
  refine le_antisymm (attractorImage_monotone aX inf_le_left) ?_
  intro T x hx
  rw [h] at hx
  obtain ⟨ψ, rfl⟩ := hx
  obtain ⟨Ψ, hΨ⟩ := exists_iter_of_image_eq hX hsep h ψ
  obtain ⟨χ, hχ⟩ := exists_inf_of_bi_weak hX hsep hat hb Ψ.toBi
  exact ⟨χ, by rw [hχ, IterPt.toPoint_toBi, hΨ]⟩

/-- **Fact 3.34 (ii)** for a finite family, one FPR atlas per finite intersection; the atlases may
differ. -/
theorem fact334_finite_weak (hX : IsAlgebraicSpace B S hS X) (hsep : IsSeparatedOver X)
    (hlim : IsLimitPreserving X) {s : Set (AddSubmonoid M)} (hfin : s.Finite)
    (hat : ∀ J ⊆ s, J.Nonempty → ExistsZFPRAtlas aX (unitsSubgroup (sInf J)))
    (y) (hne : s.Nonempty) (hy : ∀ N ∈ s, attractorImage aX N = y) :
    attractorImage aX (sInf s) = y := by
  induction s, hfin using Set.Finite.induction_on with
  | empty => exact absurd hne Set.not_nonempty_empty
  | @insert N s' _ _ ih =>
    rw [sInf_insert]
    rcases s'.eq_empty_or_nonempty with rfl | hs'
    · simpa using hy N (Set.mem_insert _ _)
    · have e := ih (fun J hJ => hat J (hJ.trans (Set.subset_insert _ _))) hs'
        fun K hK => hy K (Set.mem_insert_of_mem _ hK)
      have hat' := hat (insert N s') subset_rfl (Set.insert_nonempty _ _)
      rw [sInf_insert] at hat'
      rw [attractorImage_inf_of_eq_weak hX hsep hat' (Or.inr hlim)
        ((hy N (Set.mem_insert _ _)).trans e.symm)]
      exact hy N (Set.mem_insert _ _)

/-- **Proposition 15.1**, for `N`, with one `(N ∩ L)^×`-FPR atlas for each `L`. -/
theorem prop151_weak (hX : IsAlgebraicSpace B S hS X) (hsep : IsSeparatedOver X)
    (hlim : IsLimitPreserving X) (N : AddSubmonoid M)
    (hat : ∀ L, ExistsZFPRAtlas aX (unitsSubgroup (N ⊓ L))) :
    IsPure (attractorImage aX) N ↔ ∀ L, L < N → attractorImage aX L < attractorImage aX N := by
  constructor
  · intro h L hL
    exact IsPure.attractorImage_lt aX h hL
  · intro h L e
    by_contra hNL
    have hlt : N ⊓ L < N := lt_of_le_of_ne inf_le_left fun e' => hNL (inf_eq_left.mp e')
    have := h _ hlt
    rw [attractorImage_inf_of_eq_weak hX hsep (hat L) (Or.inr hlim) e] at this
    exact lt_irrefl _ this

/-- `M/Z` torsion-free (`Z` saturated): any equivariant atlas serves (Theorem A.1). -/
theorem existsZFPRAtlas_of_atlas {Z : AddSubgroup M} (hM : B.Contains (Spec (ZMon (M ⧸ Z))))
    (hirr : IrreducibleFibres (M ⧸ Z) S) {f : yoneda.obj U ⟶ X}
    (h : IsEquivariantAtlas aU aX f) : ExistsZFPRAtlas aX Z :=
  ⟨U, aU, f, isZFPRAtlas_of_atlas hM hirr h⟩

/-- Zariski locally linearizable actions have all the `Z`-FPR atlases, by Fact 7.3. -/
theorem existsZFPRAtlas_of_linearizable {A : Type u} {W : A → BigFppfOver B S hS}
    {V : BigFppfOver B S hS} {j : ∀ a, W a ⟶ V} (hX : IsAlgebraicSpace B S hS X)
    (Ln : ZariskiLocallyLinearizable aX A W) (hV : IsColimit (Cofan.mk V j)) (Z : AddSubgroup M) :
    ExistsZFPRAtlas aX Z := by
  obtain ⟨actV, v, h⟩ := fact73 hX Ln hV
  exact ⟨V, actV, v, h.isZFPRAtlas Z⟩

/-- **Proposition 3.32 (ii)** for a Zariski locally linearizable action. -/
theorem prop332_linearizable {A : Type u} {W : A → BigFppfOver B S hS}
    {V : BigFppfOver B S hS} {j : ∀ a, W a ⟶ V} (hX : IsAlgebraicSpace B S hS X)
    (hsep : IsSeparatedOver X) (Ln : ZariskiLocallyLinearizable aX A W)
    (hV : IsColimit (Cofan.mk V j)) {N L : AddSubmonoid M}
    (hb : (N.FG ∧ L.FG) ∨ IsLimitPreserving X) (T : BigFppfOver B S hS) :
    Function.Bijective (iterOfInf : AttractorPt aX (N ⊓ L) T → IterPt aX N L T) :=
  prop332_weak hX hsep (existsZFPRAtlas_of_linearizable hX Ln hV _) hb T

/-- **Fact 3.34 (ii)**, finite families, Zariski locally linearizable action. -/
theorem fact334_finite_linearizable {A : Type u} {W : A → BigFppfOver B S hS}
    {V : BigFppfOver B S hS} {j : ∀ a, W a ⟶ V} (hX : IsAlgebraicSpace B S hS X)
    (hsep : IsSeparatedOver X) (hlim : IsLimitPreserving X) (Ln : ZariskiLocallyLinearizable aX A W)
    (hV : IsColimit (Cofan.mk V j)) {s : Set (AddSubmonoid M)} (hfin : s.Finite)
    (y) (hne : s.Nonempty) (hy : ∀ N ∈ s, attractorImage aX N = y) :
    attractorImage aX (sInf s) = y :=
  fact334_finite_weak hX hsep hlim hfin
    (fun _ _ _ => existsZFPRAtlas_of_linearizable hX Ln hV _) y hne hy

