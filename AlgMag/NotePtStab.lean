import AlgMag.StronglyFPRNoteLem22

/-!
# Existence of strongly-FPR atlases: the paragraph "Stabilizers", for points of `|X|`

Mayeux, *Existence of strongly-FPR atlases* (no journal version), §1, "Stabilizers".

A point of `|X|` is a class of field-valued points (`AlgebraicGeometry.Space.points`, Stacks 03BU), and
the statements below hold for every representative, in particular for the residue field.

* `AlgMag.NotePt.stabY`: `Y_x`, the characters trivial on `G_x`.
* `AlgMag.NotePt.exists_stabIdeal_eq_span`: `G_x` is closed, with ideal generated by the `χ^m - 1`, `m ∈ Y_x`.
* `AlgMag.NotePt.smul_eq_iff`: `G_x = D(M/Y_x)`.
* `AlgMag.NotePt.mem_fixed_iff`: `x ∈ X^Z` iff `Y_x ⊆ Z`.
* `AlgMag.NotePt.stabPt`: `Y_x` for `x ∈ |X|`.
* `AlgMag.NotePt.mem_range_fixed_iff`: `x` lies in the image of `X^Z` iff `Y_x ⊆ Z`.
* `AlgMag.NotePt.smul_eq_of_equivariant`, `AlgMag.NotePt.stabPt_map_le`: `G_u ⊆ G_{f(u)}`.
-/

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry

universe u

namespace AlgMag.NotePt

open AlgMag.StronglyFPR AlgMag.StronglyFPRNote AlgMag.StronglyFPRNote.SubgroupIdeal

noncomputable section

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {M : Type u} [AddCommGroup M] {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}

local notation "SCH" => BigFppfOver.toScheme B S hS

/-- `Y_x ⊆ M`: the characters `χ^m` trivial on the stabilizer `G_x` of `x ∈ X(V)`. -/
def stabY (act : AAction (fppfO B S hS) M X) {V : BigFppfOver B S hS} (x : X.obj (op V)) :
    AddSubgroup M where
  carrier := {m | ∀ {T : BigFppfOver B S hS} (t : T ⟶ V) (k : APt (fppfO B S hS) M (op T)),
    act.smul k (X.map t.op x) = X.map t.op x → k (Multiplicative.ofAdd m) = 1}
  zero_mem' := fun _ k _ => map_one k
  add_mem' := fun {a b} ha hb T t k h => by
    rw [ofAdd_add, map_mul, ha t k h, hb t k h, one_mul]
  neg_mem' := fun {a} ha T t k h => by
    have e : k (Multiplicative.ofAdd (-a)) * k (Multiplicative.ofAdd a) = 1 := by
      rw [← map_mul, ← ofAdd_add, neg_add_cancel, ofAdd_zero, map_one]
    rw [ha t k h, mul_one] at e
    exact e

lemma mem_stabY {act : AAction (fppfO B S hS) M X} {V : BigFppfOver B S hS} {x : X.obj (op V)} {m : M} :
    m ∈ stabY act x ↔ ∀ {T : BigFppfOver B S hS} (t : T ⟶ V) (k : APt (fppfO B S hS) M (op T)),
      act.smul k (X.map t.op x) = X.map t.op x → k (Multiplicative.ofAdd m) = 1 := Iff.rfl

/-- `Y` grows along restriction. -/
lemma stabY_le_map (act : AAction (fppfO B S hS) M X) {V W : BigFppfOver B S hS} (r : W ⟶ V)
    (x : X.obj (op V)) : stabY act x ≤ stabY act (X.map r.op x) := by
  intro m hm T t k h
  refine hm (t ≫ r) k ?_
  rw [op_comp, Functor.map_comp_apply]
  exact h

instance quotCountable [Countable M] (Z : AddSubgroup M) : Countable (M ⧸ Z) := Quotient.countable

section Family

variable [Countable M] {V : BigFppfOver B S hS} [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
  {act : AAction (fppfO B S hS) M X} {x : X.obj (op V)}

lemma specRing_chi {T : BigFppfOver B S hS} (t : T ⟶ V) (k : APt (fppfO B S hS) M (op T)) (m : M) :
    specRing t k (AddMonoidAlgebra.single m 1) = k (Multiplicative.ofAdd m) := by
  rw [specRing_single, map_one, one_mul]

lemma specRing_chi_sub {T : BigFppfOver B S hS} (t : T ⟶ V) (k : APt (fppfO B S hS) M (op T)) (m : M) :
    specRing t k (AddMonoidAlgebra.single m 1 - 1) = 0 ↔ k (Multiplicative.ofAdd m) = 1 := by
  rw [map_sub, map_one, specRing_chi]
  exact sub_eq_zero

/-- `Y_x = {m | χ^m - 1 ∈ I}`, for `I` the ideal of `G_x`. -/
theorem stabIdeal_charSet_eq (D : StabIdeal act x) : charSet D.I = (stabY act x : Set M) := by
  ext m
  constructor
  · intro hm T t k h
    exact (specRing_chi_sub t k m).1 (D.kills t k h hm)
  · intro hm
    let t₀ : D.E ⟶ V := D.i ≫ specPr M V
    let k₀ : APt (fppfO B S hS) M (op D.E) := APt.res D.i.op (specPt M V)
    have hi : D.i = specLift t₀ k₀ := specLift_uniq _ _ _ rfl rfl
    have h₀ := hm t₀ k₀ ((D.univ t₀ k₀).2 ⟨𝟙 _, by rw [Category.id_comp]; exact hi⟩)
    change evalAt D.i _ = 0
    rw [hi, evalAt_specLift]
    exact (specRing_chi_sub t₀ k₀ m).2 h₀

/-- Over a field, `G_x = D(M/Y_x)` as ideals [SGA3, VIII]. -/
theorem stabIdeal_eq_spanY (D : StabIdeal act x) (hV : IsField Γ((SCH).obj V, ⊤)) :
    D.I = spanY _ (stabY act x : Set M) := by
  rw [← stabIdeal_charSet_eq D]
  apply le_antisymm
  · let _ : Field Γ((SCH).obj V, ⊤) := hV.toField
    exact le_span D.isSubgroupIdeal
  · rw [spanY, Ideal.span_le]
    rintro _ ⟨m, hm, rfl⟩
    exact hm

/-- **"Stabilizers", first sentence.** `G_x ⊆ D(M)_κ` is a closed subgroup scheme: closed because `X` is separated, and
diagonalizable, with ideal generated by the `χ^m - 1`, `m ∈ Y_x`. -/
theorem exists_stabIdeal_eq_span (act : AAction (fppfO B S hS) M X) (hsep : Space.IsSeparatedOver B S hS X)
    (x : X.obj (op V)) (hV : IsField Γ((SCH).obj V, ⊤)) :
    ∃ D : StabIdeal act x, IsSubgroupIdeal D.I ∧ D.I = spanY _ (stabY act x : Set M) := by
  obtain ⟨D⟩ := nonempty_stabIdeal act hsep x
  exact ⟨D, D.isSubgroupIdeal, stabIdeal_eq_spanY D hV⟩

/-- **"Stabilizers".** `G_x = D(M/Y_x)`: a point of `D(M)` stabilizes `x` iff it is trivial on `Y_x`. -/
theorem smul_eq_iff (hsep : Space.IsSeparatedOver B S hS X) (x : X.obj (op V))
    (hV : IsField Γ((SCH).obj V, ⊤)) {T : BigFppfOver B S hS} (t : T ⟶ V)
    (k : APt (fppfO B S hS) M (op T)) :
    act.smul k (X.map t.op x) = X.map t.op x ↔ ∀ m ∈ stabY act x, k (Multiplicative.ofAdd m) = 1 := by
  refine ⟨fun h m hm => hm t k h, fun h => ?_⟩
  obtain ⟨D, -, hD⟩ := exists_stabIdeal_eq_span act hsep x hV
  refine D.fix_of_kills t k fun y hy => ?_
  rw [hD] at hy
  have hle : spanY Γ((SCH).obj V, ⊤) (stabY act x : Set M) ≤ RingHom.ker (specRing t k) := by
    rw [spanY, Ideal.span_le]
    rintro _ ⟨m, hm, rfl⟩
    exact (specRing_chi_sub t k m).2 (h m hm)
  exact hle hy

/-- The character `χ^m` of `D(M/Z)` is trivial iff `m ∈ Z`, on the universal point. -/
lemma specPt_quot_eq_one [Nontrivial Γ((SCH).obj V, ⊤)] (Z : AddSubgroup M) (m : M)
    (h : (specPt (M ⧸ Z) V) (Multiplicative.ofAdd (QuotientAddGroup.mk' Z m)) = 1) : m ∈ Z := by
  classical
  have h1 : (Scheme.ΓSpecIso (.of (gRing (M ⧸ Z) V))).inv.hom
      (AddMonoidAlgebra.single (QuotientAddGroup.mk' Z m) 1) =
      (Scheme.ΓSpecIso (.of (gRing (M ⧸ Z) V))).inv.hom 1 := h.trans (map_one _).symm
  have h2 := inv_injective_Γ (M := M ⧸ Z) (U := V) h1
  rw [AddMonoidAlgebra.one_def] at h2
  have h3 := congrArg (fun w : gRing (M ⧸ Z) V => w.coeff (QuotientAddGroup.mk' Z m)) h2
  by_contra hm
  have hne : QuotientAddGroup.mk' Z m ≠ 0 := fun e => hm ((QuotientAddGroup.eq_zero_iff m).1 e)
  simp only [AddMonoidAlgebra.coeff_single, Finsupp.single_apply, reduceIte, Ne.symm hne] at h3
  exact one_ne_zero h3

/-- **"Stabilizers", last sentence**, on a field-valued representative: `x ∈ X^Z` iff `K_{Z,κ} ⊆ G_x` iff `Y_x ⊆ Z`. -/
theorem mem_fixed_iff (hsep : Space.IsSeparatedOver B S hS X) (x : X.obj (op V))
    (hV : IsField Γ((SCH).obj V, ⊤)) (Z : AddSubgroup M) :
    x ∈ (fixedPoints (quotientAction act Z)).obj (op V) ↔ stabY act x ≤ Z := by
  constructor
  · intro hx m hm
    have : Nontrivial Γ((SCH).obj V, ⊤) := ⟨hV.exists_pair_ne⟩
    refine specPt_quot_eq_one (V := V) Z m ?_
    have := hx (specPr (M ⧸ Z) V).op (specPt (M ⧸ Z) V)
    exact hm (specPr (M ⧸ Z) V) ((specPt (M ⧸ Z) V).comp
      (AddMonoidHom.toMultiplicative (QuotientAddGroup.mk' Z))) this
  · intro hZ T' s h
    change act.smul (h.comp (AddMonoidHom.toMultiplicative (QuotientAddGroup.mk' Z))) (X.map s.unop.op x) = X.map s.unop.op x
    refine (smul_eq_iff (act := act) hsep x hV s.unop _).2 fun m hm => ?_
    have h0 : QuotientAddGroup.mk' Z m = 0 := (QuotientAddGroup.eq_zero_iff m).2 (hZ hm)
    change h (Multiplicative.ofAdd (QuotientAddGroup.mk' Z m)) = 1
    rw [h0]
    exact map_one h

/-- Over field extensions `Y` does not change. -/
theorem stabY_map_eq (hsep : Space.IsSeparatedOver B S hS X) {W : BigFppfOver B S hS}
    [IsAffine ((SCH).obj W)] (r : W ⟶ V) (x : X.obj (op V))
    (hV : IsField Γ((SCH).obj V, ⊤)) (hW : IsField Γ((SCH).obj W, ⊤)) :
    stabY act (X.map r.op x) = stabY act x := by
  refine le_antisymm ?_ (stabY_le_map act r x)
  refine (mem_fixed_iff hsep _ hW _).1 ?_
  exact (fixedPoints (quotientAction act (stabY act x))).map r.op
    ((mem_fixed_iff hsep x hV _).2 le_rfl)

end Family

/-! ### Points of `|X|` -/

section Points

variable [Countable M]

instance fvp_affine (p : Space.FieldValuedPoint B S hS X) :
    IsAffine ((SCH).obj p.siteObject) :=
  inferInstanceAs (IsAffine (Spec (.of p.carrier)))

lemma fvp_isField (p : Space.FieldValuedPoint B S hS X) : IsField Γ((SCH).obj p.siteObject, ⊤) :=
  MulEquiv.isField (Field.toIsField p.carrier)
    (Scheme.ΓSpecIso (.of p.carrier)).commRingCatIsoToRingEquiv.toMulEquiv

/-- `Y_x` for `x ∈ |X|`: well defined since `Y` does not change under field extensions. -/
def stabPt (act : AAction (fppfO B S hS) M X) (hsep : Space.IsSeparatedOver B S hS X) :
    Space.points B S hS X → AddSubgroup M :=
  Quot.lift (fun p => stabY act (V := p.siteObject) p.value) (by
    rintro p q ⟨r, ⟨a, ha⟩, ⟨b, hb⟩⟩
    have h1 := stabY_map_eq (act := act) hsep a p.value (fvp_isField p) (fvp_isField r)
    have h2 := stabY_map_eq (act := act) hsep b q.value (fvp_isField q) (fvp_isField r)
    rw [ha] at h1
    rw [hb] at h2
    exact h1.symm.trans h2)

@[simp] lemma stabPt_class (act : AAction (fppfO B S hS) M X) (hsep : Space.IsSeparatedOver B S hS X)
    (p : Space.FieldValuedPoint B S hS X) :
    stabPt act hsep (p.class B S hS X) = stabY act (V := p.siteObject) p.value := rfl

/-- **"Stabilizers", last sentence.** `x ∈ |X|` lies in the image of `X^Z` iff `Y_x ⊆ Z`. -/
theorem mem_range_fixed_iff (act : AAction (fppfO B S hS) M X) (hsep : Space.IsSeparatedOver B S hS X)
    (Z : AddSubgroup M) (w : Space.points B S hS X) :
    w ∈ Set.range (Space.pointsMap B S hS (fixedPoints (quotientAction act Z)).toFunctor
      (fixedPoints (quotientAction act Z)).ι) ↔ stabPt act hsep w ≤ Z := by
  induction w using Quot.ind with
  | mk p =>
  constructor
  · rintro ⟨w', h⟩
    induction w' using Quot.ind with
    | mk r =>
    have h' : ((Space.FieldValuedPoint.map B S hS _ (fixedPoints (quotientAction act Z)).ι r).class B S hS X) =
      p.class B S hS X := h
    change stabPt act hsep (p.class B S hS X) ≤ Z
    rw [← h', stabPt_class]
    have hr : r.value.1 ∈ (fixedPoints (quotientAction act Z)).obj (op r.siteObject) := r.value.2
    exact (mem_fixed_iff hsep (V := r.siteObject) _ (fvp_isField r) Z).1 hr
  · intro h
    have hp : p.value ∈ (fixedPoints (quotientAction act Z)).obj (op p.siteObject) :=
      (mem_fixed_iff hsep (V := p.siteObject) p.value (fvp_isField p) Z).2 h
    exact ⟨Space.FieldValuedPoint.class B S hS _
      { carrier := p.carrier, contained := p.contained, toBase := p.toBase, value := ⟨p.value, hp⟩ }, rfl⟩

/-- **"Stabilizers".** `G_u ⊆ G_{f(u)}`, on points of `D(M)`. -/
theorem smul_eq_of_equivariant {U : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {actU : AAction (fppfO B S hS) M U}
    {actX : AAction (fppfO B S hS) M X} {f : U ⟶ X} (hf : IsEquivariant actU actX f) {T : BigFppfOver B S hS}
    (k : APt (fppfO B S hS) M (op T)) (x : U.obj (op T)) (h : actU.smul k x = x) :
    actX.smul k (f.app (op T) x) = f.app (op T) x := by
  rw [← hf, h]

/-- `G_u ⊆ G_{f(u)}` means `Y_{f(u)} ⊆ Y_u`. -/
lemma stabY_map_le {U : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {actU : AAction (fppfO B S hS) M U}
    {actX : AAction (fppfO B S hS) M X} {f : U ⟶ X} (hf : IsEquivariant actU actX f) {V : BigFppfOver B S hS}
    (x : U.obj (op V)) : stabY actX (f.app (op V) x) ≤ stabY actU x := by
  intro m hm T t k h
  refine hm t k ?_
  rw [← NatTrans.naturality_apply]
  exact smul_eq_of_equivariant hf k _ h

/-- **"Stabilizers".** For `u ↦ x`, `G_u ⊆ G_{x, κ(u)}`, that is, `Y_x ⊆ Y_u`. -/
theorem stabPt_map_le {U : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {actU : AAction (fppfO B S hS) M U}
    {actX : AAction (fppfO B S hS) M X} {f : U ⟶ X} (hf : IsEquivariant actU actX f)
    (hsepU : Space.IsSeparatedOver B S hS U) (hsep : Space.IsSeparatedOver B S hS X)
    (w : Space.points B S hS U) :
    stabPt actX hsep (Space.pointsMap B S hS U f w) ≤ stabPt actU hsepU w := by
  induction w using Quot.ind with
  | mk p => exact stabY_map_le hf (V := p.siteObject) p.value

end Points

end

end AlgMag.NotePt

