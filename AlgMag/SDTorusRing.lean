import AlgMag.FinalMisc331Ring

/-!
# The ring theory of Step 1 of Lemma D (Props. 3.31 (ii), 3.32 (ii))

`δ : P → Γ`, `q : Λ → Γ` surjective. `Ã = R[P ×_Γ Λ]` and `A'' = R[P × Λ]`. Then `Ã → A''` is free and of finite
presentation, by the base change `A'' = Ã ⊗_{R[ker q]} R[Λ]`. So `Spec A'' → Spec Ã` is an fppf cover.
-/

open TensorProduct

universe u

namespace AlgMag.SDTorus

/-- A ring map `A → Q` is of finite presentation when `Q` is a retract, compatible on pure tensors, of the base
change `A ⊗_C L` of a finitely presented `C → L`, and `Q` is additively generated by products `φ a * ψ l`. -/
theorem finitePresentation_of_pure {C A L Q : Type u} [CommRing C] [CommRing A] [CommRing L] [CommRing Q]
    [Algebra C A] [Algebra C L] [Algebra.FinitePresentation C L] (φ : A →+* Q) (ψ : L →+* Q)
    (comm : φ.comp (algebraMap C A) = ψ.comp (algebraMap C L))
    (Ψ : Q →+ A ⊗[C] L) (h1 : ∀ a l, Ψ (φ a * ψ l) = a ⊗ₜ[C] l)
    (hs : ∀ x : Q, x ∈ AddSubmonoid.closure {y | ∃ a l, y = φ a * ψ l}) :
    φ.FinitePresentation := by
  let : Algebra A Q := φ.toAlgebra
  let : Algebra C Q := (φ.comp (algebraMap C A)).toAlgebra
  have : IsScalarTower C A Q := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  let f : A →ₐ[A] Q := Algebra.ofId A Q
  let g : L →ₐ[C] Q :=
    { ψ with commutes' := fun r => (congrArg (fun k => k r) comm).symm }
  let Φ : A ⊗[C] L →ₐ[A] Q := Algebra.TensorProduct.productLeftAlgHom f g
  have hΦ : ∀ a l, Φ (a ⊗ₜ[C] l) = φ a * ψ l := fun a l => rfl
  have hleft : ∀ y, Ψ (Φ y) = y := by
    intro y
    induction y using TensorProduct.induction_on with
    | zero => simp
    | tmul a l => rw [hΦ, h1]
    | add a b ha hb => rw [map_add, map_add, ha, hb]
  have hright : Function.Surjective Φ := by
    intro x
    induction hs x using AddSubmonoid.closure_induction with
    | mem y hy =>
      obtain ⟨a, l, rfl⟩ := hy
      exact ⟨_, hΦ a l⟩
    | zero => exact ⟨0, map_zero _⟩
    | add u v _ _ hu hv =>
      obtain ⟨a, rfl⟩ := hu
      obtain ⟨b, rfl⟩ := hv
      exact ⟨a + b, map_add _ _ _⟩
  let e : A ⊗[C] L ≃ₐ[A] Q :=
    AlgEquiv.ofBijective Φ ⟨Function.LeftInverse.injective hleft, hright⟩
  have : Algebra.FinitePresentation A (A ⊗[C] L) := inferInstance
  exact Algebra.FinitePresentation.equiv e

variable {P Γ Λ : Type u} [AddCommMonoid P] [AddCommGroup Γ] [AddCommGroup Λ]

/-- `δ - q` on `P × Λ`; the grading of `A''`. -/
def dd (δ : P →+ Γ) (q : Λ →+ Γ) : P × Λ →+ Γ :=
  δ.comp (AddMonoidHom.fst P Λ) - q.comp (AddMonoidHom.snd P Λ)

/-- The monoid `P ×_Γ Λ`, the degree-zero part of `P × Λ`; `Ã = R[P ×_Γ Λ]`. -/
def Pt (δ : P →+ Γ) (q : Λ →+ Γ) : AddSubmonoid (P × Λ) := AddMonoidHom.mker (dd δ q)

lemma mem_Pt {δ : P →+ Γ} {q : Λ →+ Γ} {x : P × Λ} : x ∈ Pt δ q ↔ δ x.1 = q x.2 := by
  change δ x.1 - q x.2 = 0 ↔ _
  exact sub_eq_zero

variable (δ : P →+ Γ) {q : Λ →+ Γ} (hq : Function.Surjective q)

include hq in
/-- `P × Λ` is free over `P ×_Γ Λ`, on `{0} × σ(Γ)`, `σ` a section of `q`. -/
theorem isFreeAlong_Pt : IsFreeAlong (Pt δ q).subtype := by
  let σ := Function.surjInv hq
  have hσ : ∀ γ, q (σ γ) = γ := Function.surjInv_eq hq
  refine ⟨Set.range fun γ : Γ => ((0 : P), σ (-γ)), ?_, ?_⟩
  · rintro ⟨⟨a, ha⟩, ⟨_, γ, rfl⟩⟩ ⟨⟨b, hb⟩, ⟨_, γ', rfl⟩⟩ h
    have h1 : a.1 = b.1 := by simpa using congrArg Prod.fst h
    have h2 : a.2 + σ (-γ) = b.2 + σ (-γ') := by simpa using congrArg Prod.snd h
    have ha' := mem_Pt.1 ha
    have hb' := mem_Pt.1 hb
    have h3 := congrArg q h2
    simp only [map_add, hσ, ← ha', ← hb', h1] at h3
    have h4 : γ = γ' := by simpa using h3
    subst h4
    have h5 : a.2 = b.2 := add_right_cancel h2
    have : a = b := Prod.ext h1 h5
    subst this
    rfl
  · rintro ⟨p, z⟩
    let γ := δ p - q z
    refine ⟨⟨⟨(p, z - σ (-γ)), mem_Pt.2 ?_⟩, ⟨_, γ, rfl⟩⟩, ?_⟩
    · simp [hσ, γ]
    · refine Prod.ext (by simp) (by simp)

/-- `k ↦ (0, k)`. -/
def aK (δ : P →+ Γ) (q : Λ →+ Γ) : q.ker →+ Pt δ q where
  toFun k := ⟨(0, k), mem_Pt.2 (by simpa using (AddMonoidHom.mem_ker.1 k.2).symm)⟩
  map_zero' := rfl
  map_add' a b := Subtype.ext (Prod.ext (by simp) rfl)

variable (R : Type u) [CommRing R]

include hq in
/-- `R[P ×_Γ Λ] → R[P × Λ]` is of finite presentation. -/
theorem fp_Pt [AddGroup.FG Λ] : (AddMonoidAlgebra.mapDomainRingHom R (Pt δ q).subtype).FinitePresentation := by
  classical
  have : Module.Finite ℤ Λ := Module.Finite.iff_addGroup_fg.2 inferInstance
  have : Module.Finite ℤ q.ker :=
    Module.Finite.of_fg (IsNoetherian.noetherian (AddSubgroup.toIntSubmodule q.ker))
  have : AddMonoid.FG q.ker := AddGroup.fg_iff_addMonoid_fg.1 (Module.Finite.iff_addGroup_fg.1 this)
  have : AddMonoid.FG Λ := AddGroup.fg_iff_addMonoid_fg.1 inferInstance
  let C := AddMonoidAlgebra R q.ker
  let A := AddMonoidAlgebra R (Pt δ q)
  let L := AddMonoidAlgebra R Λ
  let : Algebra C A := (AddMonoidAlgebra.mapDomainRingHom R (aK δ q)).toAlgebra
  let th : q.ker →+ Λ := q.ker.subtype
  let : Algebra C L := (AddMonoidAlgebra.mapDomainRingHom R th).toAlgebra
  have hsm1 : ∀ (k : q.ker) (r : R) (p : Pt δ q) (s : R),
      (AddMonoidAlgebra.single k r : C) • (AddMonoidAlgebra.single p s : A) =
        AddMonoidAlgebra.single (aK δ q k + p) (r * s) := by
    intro k r p s
    change AddMonoidAlgebra.mapDomain (aK δ q) (AddMonoidAlgebra.single k r) * _ = _
    rw [AddMonoidAlgebra.mapDomain_single, AddMonoidAlgebra.single_mul_single]
  have hsm2 : ∀ (k : q.ker) (r : R) (z : Λ) (s : R),
      (AddMonoidAlgebra.single k r : C) • (AddMonoidAlgebra.single z s : L) =
        AddMonoidAlgebra.single ((k : Λ) + z) (r * s) := by
    intro k r z s
    change AddMonoidAlgebra.mapDomain th (AddMonoidAlgebra.single k r) * _ = _
    rw [AddMonoidAlgebra.mapDomain_single, AddMonoidAlgebra.single_mul_single]
    rfl
  have hfpL : Algebra.FinitePresentation R L := by
    have h : Algebra.FinitePresentation ℤ (AddMonoidAlgebra ℤ Λ) :=
      Algebra.FinitePresentation.of_finiteType.mp inferInstance
    have h2 := Algebra.FinitePresentation.baseChange (R := ℤ) (A := AddMonoidAlgebra ℤ Λ) (B := R)
    exact Algebra.FinitePresentation.equiv (AddMonoidAlgebra.scalarTensorEquiv ℤ R)
  have hfp : Algebra.FinitePresentation C L := by
    have h0 : (AddMonoidAlgebra.mapDomainRingHom R th).comp (algebraMap R C) = algebraMap R L := by
      refine RingHom.ext fun r => ?_
      change AddMonoidAlgebra.mapDomain th (AddMonoidAlgebra.single 0 r) = AddMonoidAlgebra.single 0 r
      rw [AddMonoidAlgebra.mapDomain_single, map_zero]
    have : (AddMonoidAlgebra.mapDomainRingHom R th).FinitePresentation := by
      refine RingHom.FinitePresentation.of_comp_finiteType (algebraMap R C) ?_ ?_
      · rw [h0, RingHom.finitePresentation_algebraMap]
        exact hfpL
      · rw [RingHom.finiteType_algebraMap]
        infer_instance
    exact this
  let σ := Function.surjInv hq
  have hσ : ∀ γ, q (σ γ) = γ := Function.surjInv_eq hq
  let bs : P → Pt δ q := fun p => ⟨(p, σ (δ p)), mem_Pt.2 (hσ _).symm⟩
  let Ψ₀ : P × Λ → R →+ A ⊗[C] L := fun x =>
    { toFun := fun r => (AddMonoidAlgebra.single (bs x.1) r : A) ⊗ₜ[C]
        (AddMonoidAlgebra.single (x.2 - σ (δ x.1)) (1 : R) : L)
      map_zero' := by simp
      map_add' := fun a b => by
        rw [AddMonoidAlgebra.single_add, TensorProduct.add_tmul] }
  let Ψ : AddMonoidAlgebra R (P × Λ) →+ A ⊗[C] L :=
    (Finsupp.liftAddHom Ψ₀).comp (AddMonoidAlgebra.coeffAddEquiv (R := R) (M := P × Λ)).toAddMonoidHom
  have hΨ : ∀ x r, Ψ (AddMonoidAlgebra.single x r) = (AddMonoidAlgebra.single (bs x.1) r : A) ⊗ₜ[C]
      (AddMonoidAlgebra.single (x.2 - σ (δ x.1)) (1 : R) : L) := by
    intro x r
    simp only [Ψ, AddMonoidHom.comp_apply]
    change Finsupp.liftAddHom Ψ₀ (Finsupp.single x r) = _
    rw [Finsupp.liftAddHom_apply_single]
    rfl
  -- the key move across the tensor sign
  have key : ∀ (y : Pt δ q) (r : R) (z : Λ) (s : R),
      (AddMonoidAlgebra.single y r : A) ⊗ₜ[C] (AddMonoidAlgebra.single z s : L) =
        (AddMonoidAlgebra.single (bs y.1.1) (r * s) : A) ⊗ₜ[C]
          (AddMonoidAlgebra.single (y.1.2 + z - σ (δ y.1.1)) (1 : R) : L) := by
    intro y r z s
    have hk : y.1.2 - σ (δ y.1.1) ∈ q.ker := by
      rw [AddMonoidHom.mem_ker, map_sub, hσ, ← mem_Pt.1 y.2, sub_self]
    let k : q.ker := ⟨_, hk⟩
    have e1 : (AddMonoidAlgebra.single y r : A) =
        (AddMonoidAlgebra.single k 1 : C) • (AddMonoidAlgebra.single (bs y.1.1) r : A) := by
      rw [hsm1, one_mul]
      congr 1
      refine Subtype.ext (Prod.ext (by simp [aK, bs]) ?_)
      simp [aK, bs, k]
    have e2 : (AddMonoidAlgebra.single (y.1.2 + z - σ (δ y.1.1)) (1 : R) : L) =
        (AddMonoidAlgebra.single k 1 : C) • (AddMonoidAlgebra.single z 1 : L) := by
      rw [hsm2, mul_one]
      congr 1
      simp only [k]
      abel
    have e3 : (AddMonoidAlgebra.single z s : L) =
        (AddMonoidAlgebra.single (0 : q.ker) s : C) • (AddMonoidAlgebra.single z 1 : L) := by
      rw [hsm2, mul_one]
      simp
    have e4 : (AddMonoidAlgebra.single (bs y.1.1) (r * s) : A) =
        (AddMonoidAlgebra.single (0 : q.ker) s : C) • (AddMonoidAlgebra.single (bs y.1.1) r : A) := by
      rw [hsm1, mul_comm]
      simp
    rw [e1, e3, e4, e2, TensorProduct.smul_tmul, TensorProduct.smul_tmul, smul_comm]
  refine finitePresentation_of_pure (C := C) (A := A) (L := L)
    (AddMonoidAlgebra.mapDomainRingHom R (Pt δ q).subtype)
    (AddMonoidAlgebra.mapDomainRingHom R (AddMonoidHom.inr P Λ)) ?_ Ψ ?_ ?_
  · refine AddMonoidAlgebra.ringHom_ext (fun r => ?_) (fun k => ?_)
    · change AddMonoidAlgebra.mapDomain _ (AddMonoidAlgebra.mapDomain _ (AddMonoidAlgebra.single 0 r)) =
        AddMonoidAlgebra.mapDomain _ (AddMonoidAlgebra.mapDomain _ (AddMonoidAlgebra.single 0 r))
      simp [AddMonoidAlgebra.mapDomain_single]
      rfl
    · change AddMonoidAlgebra.mapDomain _ (AddMonoidAlgebra.mapDomain _ (AddMonoidAlgebra.single _ 1)) =
        AddMonoidAlgebra.mapDomain _ (AddMonoidAlgebra.mapDomain _ (AddMonoidAlgebra.single _ 1))
      simp only [AddMonoidAlgebra.mapDomain_single]
      rfl
  · intro a l
    induction a using AddMonoidAlgebra.induction_linear with
    | zero => simp
    | add a b ha hb => rw [map_add, add_mul, map_add, ha, hb, TensorProduct.add_tmul]
    | single y r =>
      induction l using AddMonoidAlgebra.induction_linear with
      | zero => simp
      | add a b ha hb => rw [map_add, mul_add, map_add, ha, hb, TensorProduct.tmul_add]
      | single z s =>
        change Ψ (AddMonoidAlgebra.mapDomain _ (AddMonoidAlgebra.single y r) *
          AddMonoidAlgebra.mapDomain _ (AddMonoidAlgebra.single z s)) = _
        rw [AddMonoidAlgebra.mapDomain_single, AddMonoidAlgebra.mapDomain_single,
          AddMonoidAlgebra.single_mul_single, hΨ]
        have e0 : ((Pt δ q).subtype y + AddMonoidHom.inr P Λ z).1 = y.1.1 := by simp
        have e1 : ((Pt δ q).subtype y + AddMonoidHom.inr P Λ z).2 = y.1.2 + z := by simp
        rw [e0, e1, key y r z s]
  · intro x
    induction x using AddMonoidAlgebra.induction_linear with
    | zero => exact zero_mem _
    | add a b ha hb => exact add_mem ha hb
    | single x r =>
      refine AddSubmonoid.subset_closure ⟨AddMonoidAlgebra.single (bs x.1) r,
        AddMonoidAlgebra.single (x.2 - σ (δ x.1)) 1, ?_⟩
      change _ = AddMonoidAlgebra.mapDomain _ (AddMonoidAlgebra.single _ r) *
        AddMonoidAlgebra.mapDomain _ (AddMonoidAlgebra.single _ 1)
      rw [AddMonoidAlgebra.mapDomain_single, AddMonoidAlgebra.mapDomain_single,
        AddMonoidAlgebra.single_mul_single, mul_one]
      congr 1
      refine Prod.ext (by simp [bs]) (by simp [bs])

include hq in
/-- `Spec R[P × Λ] → Spec R[P ×_Γ Λ]` is surjective. -/
theorem comap_Pt_surjective :
    Function.Surjective (PrimeSpectrum.comap (AddMonoidAlgebra.mapDomainRingHom R (Pt δ q).subtype)) := by
  intro p
  let := (AddMonoidAlgebra.mapDomainRingHom R (Pt δ q).subtype).toAlgebra
  have hfr := FinalMisc.free_of_isFreeAlong R (isFreeAlong_Pt δ hq)
  have hne : Nontrivial (AddMonoidAlgebra R (Pt δ q)) := PrimeSpectrum.nontrivial p
  have hR : Nontrivial R := by
    rcases subsingleton_or_nontrivial R with h | h
    · exfalso
      obtain ⟨x, y, hxy⟩ := hne
      exact hxy (AddMonoidAlgebra.coeff_injective (Finsupp.ext fun _ => Subsingleton.elim _ _))
    · exact h
  exact PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := AddMonoidAlgebra R (Pt δ q))
    (B := AddMonoidAlgebra R (P × Λ)) p

end AlgMag.SDTorus
