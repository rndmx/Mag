import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
import Mathlib.AlgebraicGeometry.Morphisms.Affine

/-!
# The inverse image of an ideal sheaf commutes with powers

Not part of the built closure of the Stacks library: the statements and proofs are those of
`StacksFrontier/AlgebraicGeometry/Groupoids/IdealSheafComap.lean`,
`DivisorFlatPullback/Basic.lean` and `Scheme/IdealSheafComapMul.lean`, restated in a private
namespace. Delete this file once those three modules are in the build.
-/

open CategoryTheory AlgebraicGeometry

universe u

namespace AlgMag.ChartMain.IdealPow

variable {X Y : Scheme.{u}}

/-! ### Ideals and isomorphisms of commutative rings -/

/-- The image of an ideal under an isomorphism of commutative rings is its inverse image under
the inverse isomorphism. -/
theorem ideal_map_hom_eq_comap_inv {R S : CommRingCat.{u}} (e : R ≅ S) (K : Ideal R) :
    Ideal.map e.hom.hom K = Ideal.comap e.inv.hom K := by
  refine le_antisymm (Ideal.map_le_iff_le_comap.mpr fun x hx ↦ ?_) fun x hx ↦ ?_
  · simpa [Ideal.mem_comap, ← CommRingCat.comp_apply] using hx
  · have hmem : e.hom.hom (e.inv.hom x) ∈ Ideal.map e.hom.hom K :=
      Ideal.mem_map_of_mem _ (Ideal.mem_comap.mp hx)
    simpa [← CommRingCat.comp_apply] using hmem

/-- Taking the image of an ideal under an isomorphism of commutative rings is injective. -/
theorem ideal_map_hom_injective {R S : CommRingCat.{u}} (e : R ≅ S) :
    Function.Injective (Ideal.map e.hom.hom : Ideal R → Ideal S) := fun K L h ↦ by
  simpa [Ideal.map_map, ← CommRingCat.hom_comp] using congrArg (Ideal.map e.inv.hom) h

/-! ### The inverse image along the inclusion of an affine open -/

/-- The ideal of global sections of the inverse image of an ideal sheaf along the inclusion of
an affine open `V` is the image of the ideal of `V` under `Scheme.Opens.topIso`. -/
theorem ideal_comap_ι_top (J : X.IdealSheafData) {V : X.Opens} (hV : IsAffineOpen V)
    (hT : IsAffineOpen (⊤ : V.toScheme.Opens)) :
    (J.comap V.ι).ideal ⟨⊤, hT⟩ = Ideal.map V.topIso.inv.hom (J.ideal ⟨V, hV⟩) := by
  have hres : X.presheaf.map (homOfLE V.ι_image_top.le).op ≫ (V.ι.appIso ⊤).hom =
      V.topIso.inv := by
    simp only [Scheme.Opens.ι_appIso, Scheme.Opens.topIso_inv]
    exact Category.comp_id _
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion,
    ← ideal_map_hom_eq_comap_inv (V.ι.appIso ⊤),
    ← J.map_ideal (U := ⟨V.ι ''ᵁ ⊤, hT.image_of_isOpenImmersion V.ι⟩) (V := ⟨V, hV⟩)
      V.ι_image_top.le, Ideal.map_map, ← CommRingCat.hom_comp]
  exact congrArg (fun φ ↦ Ideal.map (CommRingCat.Hom.hom φ) (J.ideal ⟨V, hV⟩)) hres

/-! ### The formula for an affine morphism -/

/-- The image of the ideal of an affine open under an affine morphism is contained in the ideal
of the inverse image of the ideal sheaf, on the preimage of that open. -/
theorem map_ideal_le_ideal_comap (I : Y.IdealSheafData) (f : X ⟶ Y) [IsAffineHom f]
    (U : Y.affineOpens) :
    Ideal.map (f.app U.1).hom (I.ideal U) ≤
      (I.comap f).ideal ⟨f ⁻¹ᵁ U.1, U.2.preimage f⟩ := by
  rw [Ideal.map_le_iff_le_comap, ← Scheme.IdealSheafData.ideal_map_of_isAffineHom]
  exact I.le_map_comap f U

/-- For a morphism of affine schemes, the ideal of global sections of the inverse image of an
ideal sheaf is generated by the image of the ideal of global sections. -/
theorem ideal_comap_top_of_isAffine [IsAffine X] [IsAffine Y] (I : Y.IdealSheafData)
    (f : X ⟶ Y) :
    (I.comap f).ideal ⟨⊤, isAffineOpen_top X⟩ =
      Ideal.map f.appTop.hom (I.ideal ⟨⊤, isAffineOpen_top Y⟩) := by
  refine le_antisymm ?_ (map_ideal_le_ideal_comap I f ⟨⊤, isAffineOpen_top Y⟩)
  have hKtop : (Scheme.IdealSheafData.ofIdealTop
      (Ideal.map f.appTop.hom (I.ideal ⟨⊤, isAffineOpen_top Y⟩))).ideal
        ⟨⊤, isAffineOpen_top X⟩ = Ideal.map f.appTop.hom (I.ideal ⟨⊤, isAffineOpen_top Y⟩) := by
    rw [Scheme.IdealSheafData.ofIdealTop_ideal,
      show (homOfLE (le_top (a := (⊤ : X.Opens)))) = 𝟙 _ from rfl]
    simp
  have hIK : I ≤ (Scheme.IdealSheafData.ofIdealTop
      (Ideal.map f.appTop.hom (I.ideal ⟨⊤, isAffineOpen_top Y⟩))).map f := by
    refine Scheme.IdealSheafData.le_of_isAffine ?_
    rw [Scheme.IdealSheafData.ideal_map_of_isAffineHom _ f ⟨⊤, isAffineOpen_top Y⟩]
    exact le_trans Ideal.le_comap_map (Ideal.comap_mono hKtop.ge)
  exact (Scheme.IdealSheafData.le_map_iff_comap_le.mp hIK _).trans hKtop.le

/-- Replacing the two opens of a map on sections by equal ones amounts to composing with the
restriction maps along those equalities. -/
private lemma appLE_eqToHom_comp {X Y : Scheme.{u}} (f : Y ⟶ X)
    {U U' : X.Opens} {V V' : Y.Opens} (hU : U = U') (hV : V = V')
    (hVU : V ≤ f ⁻¹ᵁ U) (e : V' ≤ f ⁻¹ᵁ U') :
    f.appLE U' V' e =
      X.presheaf.map (eqToHom hU).op ≫ f.appLE U V hVU ≫
        Y.presheaf.map (eqToHom hV.symm).op := by
  subst hU
  subst hV
  simp

/-- **The inverse image of an ideal sheaf on a pair of affine charts.** If the affine open `V`
of the source lies in the preimage of the affine open `U` of the target, then the ideal of
`I.comap f` on `V` is generated by the image of the ideal of `I` on `U`. -/
theorem ideal_comap_appLE {X Y : Scheme.{u}} (I : X.IdealSheafData) (f : Y ⟶ X)
    (U : X.affineOpens) (V : Y.affineOpens) (hVU : (V : Y.Opens) ≤ f ⁻¹ᵁ (U : X.Opens)) :
    (I.comap f).ideal V = (I.ideal U).map (f.appLE U V hVU).hom := by
  suffices key : ∀ (U' : X.affineOpens) (V' : Y.affineOpens),
      U' = ⟨(U : X.Opens).ι ''ᵁ ⊤, by simpa only [Scheme.Opens.ι_image_top] using U.2⟩ →
      V' = ⟨(V : Y.Opens).ι ''ᵁ ⊤, by simpa only [Scheme.Opens.ι_image_top] using V.2⟩ →
      ∀ (e : (V' : Y.Opens) ≤ f ⁻¹ᵁ (U' : X.Opens)),
        (I.comap f).ideal V' = (I.ideal U').map (f.appLE U' V' e).hom from
    key U V (Subtype.ext (U : X.Opens).ι_image_top.symm)
      (Subtype.ext (V : Y.Opens).ι_image_top.symm) hVU
  rintro _ _ rfl rfl e
  have h := ideal_comap_top_of_isAffine (I.comap (U : X.Opens).ι) (f.resLE U V hVU)
  rw [← Scheme.IdealSheafData.comap_comp, Scheme.Hom.resLE_comp_ι,
    Scheme.IdealSheafData.comap_comp,
    Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion (I.comap f) (V : Y.Opens).ι,
    Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion I (U : X.Opens).ι] at h
  simp only [Scheme.Opens.ι_appIso, Iso.refl_inv, Scheme.Hom.appTop,
    Scheme.Hom.resLE_app_top] at h
  convert h using 2 <;> try rfl
  congr 1
  simp only [Scheme.Opens.topIso_hom, Scheme.Opens.topIso_inv]
  exact appLE_eqToHom_comp f (U : X.Opens).ι_image_top.symm
    (V : Y.Opens).ι_image_top.symm hVU e

private lemma ext_of_forall_le_preimage (f : Y ⟶ X) {A B : Y.IdealSheafData}
    (h : ∀ (U : X.affineOpens) (V : Y.affineOpens), (V : Y.Opens) ≤ f ⁻¹ᵁ (U : X.Opens) →
      A.ideal V = B.ideal V) : A = B := by
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top (ι := {p : X.affineOpens × Y.affineOpens //
    (p.2 : Y.Opens) ≤ f ⁻¹ᵁ (p.1 : X.Opens)}) (fun p => p.1.2)
    (eq_top_iff.2 fun y _ => ?_) fun p => h _ _ p.2
  obtain ⟨U, hU, hyU, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
    (show f y ∈ (⊤ : X.Opens) from trivial)
  obtain ⟨V, hV, hyV, hVU⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp Y.isBasis_affineOpens
    (show y ∈ f ⁻¹ᵁ U from hyU)
  exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨(⟨U, hU⟩, ⟨V, hV⟩), hVU⟩, hyV⟩

/-- The inverse image of ideal sheaves commutes with powers. -/
theorem comap_pow (I : X.IdealSheafData) (f : Y ⟶ X) (n : ℕ) :
    (I ^ n).comap f = I.comap f ^ n := by
  refine ext_of_forall_le_preimage f fun U V h => ?_
  simp only [ideal_comap_appLE _ _ U V h, Scheme.IdealSheafData.ideal_pow, Pi.pow_apply,
    Ideal.map_pow]

end AlgMag.ChartMain.IdealPow
