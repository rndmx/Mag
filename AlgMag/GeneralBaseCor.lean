import AlgMag.GeneralBaseThm320

/-!
# Consequences of Theorem 3.20 over an arbitrary base

## Main results

* `AlgMag.GB.ker_iAtt_ideal`: Theorem 3.20, the ideal sheaf of `X^N`.
* `AlgMag.GB.Zincl`, `AlgMag.GB.instClosedZincl`: Corollary 3.22.
* `AlgMag.GB.ker_iAtt_iInf`, `AlgMag.GB.exists_toPoint_iInf_iff`: Proposition 3.24.
* `AlgMag.GB.Zmap`, `AlgMag.GB.isPullback_Zmap`, `AlgMag.GB.instClosedZmap`: Lemma 3.26.
-/

suppress_compilation

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry Magnetism

open scoped Classical

universe u

namespace AlgMag.GB

attribute [local instance] gradedAlgebraOf

variable {S : Scheme.{u}} {M : Type u} [AddCommMonoid M]

section Sections

variable {X : Over S} [IsAffineHom X.hom] {U : S.Opens} (hU : IsAffineOpen U)

/-- `AlgMag.GB.ptX` is the restriction of sections. -/
lemma appLE_eq_ptX {T : Over S} (hT : LiesOver T U) (f : T ⟶ X)
    (e : (⊤ : T.left.Opens) ≤ f.left ⁻¹ᵁ X.hom ⁻¹ᵁ U) (a : Γ(X.left, X.hom ⁻¹ᵁ U)) :
    (f.left.appLE (X.hom ⁻¹ᵁ U) ⊤ e).hom a = ptX X hU T hT f a := by
  let g : T.left ⟶ Spec Γ(X.left, X.hom ⁻¹ᵁ U) := (toChart X hU T hT f).left
  have hg : ∀ (F : T.left ⟶ X.left) (_ : F = g ≫ (isAffineOpen_preimage X hU).fromSpec)
      (e' : (⊤ : T.left.Opens) ≤ F ⁻¹ᵁ X.hom ⁻¹ᵁ U),
      F.appLE (X.hom ⁻¹ᵁ U) ⊤ e' = (Scheme.ΓSpecIso _).inv ≫ g.appTop := by
    rintro F rfl e'
    have e1 : (⊤ : (Spec Γ(X.left, X.hom ⁻¹ᵁ U)).Opens) ≤
        (isAffineOpen_preimage X hU).fromSpec ⁻¹ᵁ X.hom ⁻¹ᵁ U := by
      rw [(isAffineOpen_preimage X hU).fromSpec_preimage_self]
    rw [← Scheme.Hom.appLE_comp_appLE g (isAffineOpen_preimage X hU).fromSpec _ ⊤ ⊤ e1 le_top]
    congr 1
    · rw [Scheme.Hom.appLE, (isAffineOpen_preimage X hU).fromSpec_app_self, Category.assoc,
        ← Functor.map_comp]
      convert Category.comp_id _
      exact (Spec _).presheaf.map_id _
    · simp [Scheme.Hom.appLE]
      rfl
  have h0 : f.left = g ≫ (isAffineOpen_preimage X hU).fromSpec :=
    congrArg (fun k => k.left) ((toChart X hU T hT).symm_apply_apply f).symm
  rw [hg f.left h0 e]
  rfl

/-- A section over `W` vanishes if it vanishes on a scheme mapping by an open immersion onto a
neighbourhood of `W`. -/
lemma section_eq_zero_of_range {Z Z' : Scheme.{u}} (ι : Z' ⟶ Z) [IsOpenImmersion ι] (W : Z.Opens)
    (hW : (W : Set Z) ⊆ Set.range ι) (s : Γ(Z, W)) (e : (⊤ : Z'.Opens) ≤ ι ⁻¹ᵁ W)
    (h : (ι.appLE W ⊤ e).hom s = 0) (he : ι ⁻¹ᵁ W = ⊤) : s = 0 := by
  have h1 : (ι.app W).hom s = 0 := by
    have : ι.appLE W ⊤ e = ι.app W ≫ Z'.presheaf.map (eqToHom he.symm).op := rfl
    rw [this] at h
    have hi : IsIso (Z'.presheaf.map (eqToHom he.symm).op) := inferInstance
    have hinj := ((ConcreteCategory.isIso_iff_bijective _).mp hi).1
    exact hinj (h.trans (map_zero _).symm)
  refine TopCat.Presheaf.section_ext Z.sheaf W s 0 fun x hx => ?_
  obtain ⟨y, rfl⟩ := hW hx
  have hinj : Function.Injective (ι.stalkMap y) :=
    ((ConcreteCategory.isIso_iff_bijective _).mp inferInstance).1
  refine hinj ?_
  have k1 := Scheme.Hom.germ_stalkMap_apply ι W y hx s
  have k2 := Scheme.Hom.germ_stalkMap_apply ι W y hx 0
  refine k1.trans (Eq.trans ?_ k2.symm)
  exact congrArg _ (h1.trans (map_zero _).symm)

end Sections

section Kernel

variable {X : Over S} [IsAffineHom X.hom] (act : AAction (overO S) M (yoneda.obj X))
variable (N : AddSubmonoid M)

lemma appLE_eq_of_eq {X' Y' : Scheme.{u}} {F G : X' ⟶ Y'} (h : F = G) (U : Y'.Opens) (V : X'.Opens)
    (e : V ≤ F ⁻¹ᵁ U) (e' : V ≤ G ⁻¹ᵁ U) : F.appLE U V e = G.appLE U V e' := by
  subst h
  rfl

/-- **Theorem 3.20**, the ideal sheaf. On the affine open `p⁻¹ U` of `X`, `U ⊆ S` affine, the ideal
sheaf of the closed subscheme `X^N` of `X` is the ideal generated by the components `A_m`,
`m ∉ N`, of `A = Γ(X, p⁻¹ U)`. -/
theorem ker_iAtt_ideal (U : S.affineOpens) :
    (iAtt act N).left.ker.ideal ⟨X.hom ⁻¹ᵁ U.1, isAffineOpen_preimage X U.2⟩ =
      magnetIdeal (gradingOf U.2 act) N := by
  ext a
  rw [Scheme.Hom.ker_apply, RingHom.mem_ker]
  have hT := liesOver_Zloc act N U.2
  let ι := (iotaZ act N U).left
  let f := (iAtt act N).left
  have hcomp : ι ≫ f = (iLoc act N U.2).left := congrArg (fun k => k.left) (iotaZ_iAtt act N U)
  have hs : ∀ x : (Zloc act N U.2).left, X.hom (f (ι x)) = (Zloc act N U.2).hom x := by
    intro x
    have e1 : (ι ≫ f ≫ X.hom) x = X.hom (f (ι x)) := by simp
    have e2 : ι ≫ f ≫ X.hom = (Zloc act N U.2).hom := by
      rw [← Category.assoc, hcomp]
      exact Over.w _
    rw [← e1, e2]
  have he : ι ⁻¹ᵁ f ⁻¹ᵁ X.hom ⁻¹ᵁ U.1 = ⊤ := by
    refine top_le_iff.mp fun x _ => ?_
    change X.hom (f (ι x)) ∈ U.1
    rw [hs]
    exact hT.mem x
  have e0 : (⊤ : (Zloc act N U.2).left.Opens) ≤ (iLoc act N U.2).left ⁻¹ᵁ X.hom ⁻¹ᵁ U.1 := by
    rw [← hcomp]
    exact he.ge
  have h1 : (ι.appLE (f ⁻¹ᵁ X.hom ⁻¹ᵁ U.1) ⊤ he.ge).hom ((f.app (X.hom ⁻¹ᵁ U.1)).hom a) =
      eta U.2 (Qalg act N U.2) (qAlg act N U.2 a) := by
    have k := Scheme.Hom.appLE_comp_appLE ι f (X.hom ⁻¹ᵁ U.1)
      (f ⁻¹ᵁ X.hom ⁻¹ᵁ U.1) ⊤ le_rfl he.ge
    rw [Scheme.Hom.appLE_eq_app, appLE_eq_of_eq hcomp _ _ _ e0] at k
    have k2 := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom k) a
    refine k2.trans ?_
    have h3 : ptX X U.2 _ hT (iLoc act N U.2) =
        (eta U.2 (Qalg act N U.2)).comp (qAlg act N U.2) :=
      (ptX_comp_iota U.2 hT _).trans (homPhi_PhiMap U.2 _)
    exact (appLE_eq_ptX U.2 hT (iLoc act N U.2) e0 a).trans (DFunLike.congr_fun h3 a)
  constructor
  · intro h
    have h2 : eta U.2 (Qalg act N U.2) (qAlg act N U.2 a) = 0 := by
      rw [← h1]
      change (ι.appLE _ ⊤ he.ge).hom ((f.app (X.hom ⁻¹ᵁ U.1)).hom a) = 0
      rw [show (f.app (X.hom ⁻¹ᵁ U.1)).hom a = 0 from h, map_zero]
    have h3 : qAlg act N U.2 a = 0 :=
      (eta_bijective U.2 (Qalg act N U.2)).1 (h2.trans (map_zero _).symm)
    exact (Ideal.Quotient.eq_zero_iff_mem (I := magnetIdeal (gradingOf U.2 act) N)
      (a := (a : Aalg X U.1))).mp h3
  · intro h
    have h2 : qAlg act N U.2 a = 0 := (Ideal.Quotient.eq_zero_iff_mem
      (I := magnetIdeal (gradingOf U.2 act) N) (a := (a : Aalg X U.1))).mpr h
    have hopen : IsOpenImmersion ι := by
      have hU0 : IsOpenImmersion (S.directedAffineCover.f U) :=
        inferInstanceAs (IsOpenImmersion U.1.ι)
      exact MorphismProperty.of_isPullback ((zData act N).isPullback_natTrans_ι_toBase U) hU0
    refine section_eq_zero_of_range ι _ ?_ _ he.ge ?_ he
    · intro x hx
      have hb : (zData act N).toBase x ∈ Set.range (S.directedAffineCover.f U) := by
        have w0 : f ≫ X.hom = (zData act N).toBase := Over.w (iAtt act N)
        have e3 : X.hom (f x) = (zData act N).toBase x := by
          have := Scheme.Hom.comp_apply f X.hom x
          rw [w0] at this
          exact this.symm
        rw [← e3, show Set.range (S.directedAffineCover.f U) = (U.1 : Set S) from
          Scheme.Opens.range_ι _]
        exact hx
      have hb' : x ∈ (zData act N).toBase ⁻¹' Set.range (S.directedAffineCover.f U) := hb
      rw [(zData act N).preimage_toBase_eq_range_ι U] at hb'
      exact hb'
    · exact h1.trans ((congrArg _ h2).trans (map_zero _))

end Kernel

section Monotone

variable {X : Over S} {act : AAction (overO S) M (yoneda.obj X)}

/-- **§3**: the morphism `X^N → X^L` for magnets `N ⊆ L`, by restriction along `𝔸(L) → 𝔸(N)`. -/
def attIncl {N L : AddSubmonoid M} (h : N ≤ L) {T : Over S} (φ : AttractorPt act N T) :
    AttractorPt act L T where
  app s a := φ.app s (a.comp (AddMonoidHom.toMultiplicative (AddSubmonoid.inclusion h)))
  naturality s t a := φ.naturality s t (a.comp (AddMonoidHom.toMultiplicative (AddSubmonoid.inclusion h)))
  equivariant t g a := by
    have e : (APt.toMagnet L g * a).comp (AddMonoidHom.toMultiplicative (AddSubmonoid.inclusion h)) =
        APt.toMagnet N g * a.comp (AddMonoidHom.toMultiplicative (AddSubmonoid.inclusion h)) :=
      MonoidHom.ext fun _ => rfl
    rw [e]
    exact φ.equivariant t g _

lemma toPoint_attIncl {N L : AddSubmonoid M} (h : N ≤ L) {T : Over S} (φ : AttractorPt act N T) :
    (attIncl h φ).toPoint = φ.toPoint := by
  have e : (1 : APt (overO S) L (op T)).comp
      (AddMonoidHom.toMultiplicative (AddSubmonoid.inclusion h)) = 1 := MonoidHom.ext fun _ => rfl
  change φ.app (𝟙 T) ((1 : APt (overO S) L (op T)).comp _) = φ.app (𝟙 T) 1
  rw [e]

end Monotone

section Cor

variable {X : Over S} [IsAffineHom X.hom] (act : AAction (overO S) M (yoneda.obj X))

/-- The morphism `X^N → X^L` on the representing closed subschemes. -/
def Zincl {N L : AddSubmonoid M} (h : N ≤ L) : Zatt act N ⟶ Zatt act L :=
  (attEquiv act L _).symm (attIncl h (attEquiv act N _ (𝟙 _)))

@[reassoc]
lemma Zincl_iAtt {N L : AddSubmonoid M} (h : N ≤ L) :
    Zincl act h ≫ iAtt act L = iAtt act N := by
  rw [← toPoint_attEquiv, Zincl, Equiv.apply_symm_apply, toPoint_attIncl, toPoint_attEquiv,
    Category.id_comp]

/-- **Corollary 3.22.** If `X` is affine over `S` and `N ⊆ L` are magnets, then `X^N → X^L` is a
closed immersion. -/
instance instClosedZincl {N L : AddSubmonoid M} (h : N ≤ L) :
    IsClosedImmersion (Zincl act h).left := by
  have hc : (Zincl act h).left ≫ (iAtt act L).left = (iAtt act N).left :=
    congrArg (fun k => k.left) (Zincl_iAtt act h)
  have : IsClosedImmersion ((Zincl act h).left ≫ (iAtt act L).left) := by
    rw [hc]
    infer_instance
  exact IsClosedImmersion.of_comp _ (iAtt act L).left

/-- A morphism to `X` underlies a point of `X^N` as soon as it does on the pieces lying over affine
opens of `S`. -/
theorem exists_att_of_local {N : AddSubmonoid M} {T : Over S} (t : T ⟶ X)
    (H : ∀ {W : Over S} (f : W ⟶ T) (U : S.affineOpens), LiesOver W U.1 →
      ∃ φ : AttractorPt act N W, φ.toPoint = f ≫ t) :
    ∃ φ : AttractorPt act N T, φ.toPoint = t := by
  have sh := (isSheaf_att act N) _ (sieveU_mem T)
  let x : Presieve.FamilyOfElements (attractor act N) (sieveU T).arrows := fun W f hf =>
    (H f hf.choose hf.choose_spec).choose
  have hx : ∀ {W} (f : W ⟶ T) (hf : (sieveU T).arrows f),
      AttractorPt.toPoint (x f hf) = f ≫ t := fun f hf =>
    (H f hf.choose hf.choose_spec).choose_spec
  have hc : x.Compatible := by
    intro W₁ W₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
    refine toPoint_injective_global ?_
    change ((x f₁ h₁).baseChange g₁).toPoint = ((x f₂ h₂).baseChange g₂).toPoint
    rw [toPoint_baseChange, toPoint_baseChange, hx f₁ h₁, hx f₂ h₂, ← Category.assoc,
      ← Category.assoc g₂, comm]
  refine ⟨sh.amalgamate x hc, ?_⟩
  refine ((isSheaf_yoneda_over X) _ (sieveU_mem T)).isSeparatedFor.ext fun W f hf => ?_
  change f ≫ AttractorPt.toPoint (sh.amalgamate x hc) = f ≫ t
  refine (toPoint_baseChange act N f _).symm.trans ?_
  exact (congrArg AttractorPt.toPoint (sh.valid_glue hc f hf)).trans (hx f hf)

/-- A morphism to `X` over `U` underlies a point of `X^N` iff it kills the ideal `J_N` of `U`. -/
theorem exists_att_iff_kills {U : S.Opens} (hU : IsAffineOpen U) {N : AddSubmonoid M} {T : Over S}
    (hT : LiesOver T U) (t : T ⟶ X) :
    (∃ φ : AttractorPt act N T, φ.toPoint = t) ↔
      ∀ a ∈ magnetIdeal (gradingOf hU act) N, ptX X hU T hT t a = 0 := by
  constructor
  · rintro ⟨φ, rfl⟩ a ha
    exact toPoint_kills hU act N hT φ ha
  · intro h
    refine ⟨(localEquiv hU act N hT).symm (Ideal.Quotient.liftₐ _ (ptX X hU T hT t) h), ?_⟩
    apply (ptX X hU T hT).injective
    rw [ptX_toPoint_localEquiv_symm]
    exact AlgHom.ext fun a => rfl

/-- **Proposition 3.24**, on points. For `X` affine over `S`, a morphism `T → X` factors through
`X^{⋂ N_i}` iff it factors through every `X^{N_i}`: this is `X^{⋂ N_i} = ∏_X X^{N_i}`, for an
arbitrary family. -/
theorem exists_toPoint_iInf_iff {ι : Sort*} (N : ι → AddSubmonoid M) {T : Over S} (t : T ⟶ X) :
    (∃ φ : AttractorPt act (⨅ i, N i) T, φ.toPoint = t) ↔
      ∀ i, ∃ φ : AttractorPt act (N i) T, φ.toPoint = t := by
  constructor
  · rintro ⟨φ, rfl⟩ i
    exact ⟨attIncl (iInf_le N i) φ, toPoint_attIncl _ _⟩
  · intro H
    refine exists_att_of_local act t fun {W} f U hW => ?_
    refine (exists_att_iff_kills act U.2 hW _).2 fun a ha => ?_
    rw [magnetIdeal_iInf] at ha
    have hle : (⨆ i, magnetIdeal (gradingOf U.2 act) (N i)) ≤
        RingHom.ker (ptX X U.2 W hW (f ≫ t) : Aalg X U.1 →+* Ga U.2 W hW) := by
      refine iSup_le fun i => fun b hb => ?_
      obtain ⟨φ, hφ⟩ := H i
      refine (exists_att_iff_kills act U.2 hW _).1 ⟨φ.baseChange f, ?_⟩ b hb
      rw [toPoint_baseChange, hφ]
    exact hle ha

/-- The opens `p⁻¹ U` cover `X`. -/
lemma iSup_chart : ⨆ U : S.affineOpens, (⟨X.hom ⁻¹ᵁ U.1, isAffineOpen_preimage X U.2⟩ :
    X.left.affineOpens).1 = ⊤ := by
  refine top_le_iff.mp fun x _ => ?_
  obtain ⟨U, y, hy⟩ := S.directedAffineCover.exists_eq (X.hom x)
  let U' : S.affineOpens := U
  refine TopologicalSpace.Opens.mem_iSup.mpr ⟨U', ?_⟩
  change X.hom x ∈ U'.1
  rw [← hy]
  exact y.2

/-- **Proposition 3.24**, ideal sheaves: the ideal sheaf of `X^{⋂ N_i}` is the sum of the ideal
sheaves of the `X^{N_i}`, i.e. `X^{⋂ N_i}` is the scheme theoretic intersection of the `X^{N_i}`. -/
theorem ker_iAtt_iInf {ι : Type*} (N : ι → AddSubmonoid M) :
    (iAtt act (⨅ i, N i)).left.ker = ⨆ i, (iAtt act (N i)).left.ker := by
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top _ (iSup_chart (X := X)) fun U => ?_
  rw [ker_iAtt_ideal, magnetIdeal_iInf, Scheme.IdealSheafData.ideal_iSup, iSup_apply]
  exact iSup_congr fun i => (ker_iAtt_ideal act (N i) U).symm

end Cor

section Closed

variable {Y Z' : Over S} [IsAffineHom Y.hom] [IsAffineHom Z'.hom]
variable (actY : AAction (overO S) M (yoneda.obj Y)) (actZ : AAction (overO S) M (yoneda.obj Z'))
variable (f : Z' ⟶ Y)

/-- The morphism `f` of `S`-schemes is equivariant. -/
def IsEquivariantMor : Prop :=
  ∀ {T : Over S} (h : APt (overO S) M (op T)) (z : T ⟶ Z'),
    actY.smul h (z ≫ f) = actZ.smul h z ≫ f

/-- **Fact 3.17**: an equivariant morphism induces a morphism of attractors. -/
def attPush {actY actZ} {f : Z' ⟶ Y} (hf : IsEquivariantMor actY actZ f) {N : AddSubmonoid M}
    {T : Over S} (φ : AttractorPt actZ N T) : AttractorPt actY N T where
  app s a := φ.app s a ≫ f
  naturality s t a := by
    have := φ.naturality s t a
    rw [this]
    exact Category.assoc _ _ _
  equivariant t h a := by
    rw [φ.equivariant t h a]
    exact (hf h _).symm

lemma toPoint_attPush {actY actZ} {f : Z' ⟶ Y} (hf : IsEquivariantMor actY actZ f)
    {N : AddSubmonoid M} {T : Over S} (φ : AttractorPt actZ N T) :
    (attPush hf φ).toPoint = φ.toPoint ≫ f := rfl

variable {U : S.Opens} (hU : IsAffineOpen U)

/-- The algebra map `A_Y → A_Z` of `f`. -/
def fSharp : Aalg Y U →ₐ[Γ(S, U)] Aalg Z' U :=
  backX hU Y (Aalg Z' U) (iotaX Z' hU ≫ f)

lemma ptX_comp_f {T : Over S} (hT : LiesOver T U) (w : T ⟶ Z') (a : Aalg Y U) :
    ptX Y hU T hT (w ≫ f) a = ptX Z' hU T hT w (fSharp f hU a) := by
  let g := toChart Z' hU T hT w
  have hg : w = g ≫ iotaX Z' hU := ((toChart Z' hU T hT).symm_apply_apply w).symm
  have h1 : ptX Y hU T hT (w ≫ f) = (gpull hU (liesOver_Phi hU _) hT g).comp
      (ptX Y hU _ (liesOver_Phi hU _) (iotaX Z' hU ≫ f)) := by
    rw [← ptX_comp Y hU (liesOver_Phi hU _) hT, ← Category.assoc, ← hg]
  have h2 : ptX Z' hU T hT w = homPhi hU T hT _ g := rfl
  have h3 : homPhi hU T hT _ g = (gpull hU (liesOver_Phi hU _) hT g).comp (eta hU (Aalg Z' U)) := by
    have := homPhi_comp hU (liesOver_Phi hU _) hT g (𝟙 _)
    rwa [Category.comp_id] at this
  rw [h1, h2, h3, AlgHom.comp_apply, AlgHom.comp_apply]
  congr 1
  exact (eta_backX_aux hU _ _ a).symm

variable {actY actZ f} in
/-- The map `A_Y → A_Z` preserves the gradings. -/
lemma fSharp_mem (hf : IsEquivariantMor actY actZ f) {m : M} {a : Aalg Y U}
    (ha : a ∈ gradingOf hU actY m) : fSharp f hU a ∈ gradingOf hU actZ m := by
  change rho hU actZ (fSharp f hU a) = AddMonoidAlgebra.single m (fSharp f hU a)
  refine (eta_bijective hU (Aover Z' U M)).1 ?_
  have hT := liesOver_Phi hU (Aover Z' U M)
  have h1 := DFunLike.congr_fun (eta_rho hU Z' actZ) (fSharp f hU a)
  refine h1.trans ?_
  refine (ptX_comp_f f hU hT _ _).symm.trans ?_
  refine (congrArg (fun k => ptX Y hU _ hT k a) (hf (hUniv hU Z') (xConst hU Z' M)).symm).trans ?_
  refine (ptX_smul_of_mem hU actY hT _ _ ha).trans ?_
  have h2 : ptX Y hU _ hT (xConst hU Z' M ≫ f) a =
      eta hU (Aover Z' U M) (AddMonoidAlgebra.single 0 (fSharp f hU a)) :=
    (ptX_comp_f f hU hT _ a).trans
      (DFunLike.congr_fun ((ptX Z' hU _ hT).apply_symm_apply _) (fSharp f hU a))
  refine (congrArg (_ * ·) h2).trans ?_
  refine (map_mul (eta hU (Aover Z' U M)) (AddMonoidAlgebra.single m 1)
    (AddMonoidAlgebra.single 0 (fSharp f hU a))).symm.trans ?_
  congr 1
  change AddMonoidAlgebra.single m 1 * AddMonoidAlgebra.single 0 _ = _
  rw [AddMonoidAlgebra.single_mul_single]
  simp

/-- The square of charts. -/
lemma PhiMap_iota : PhiMap hU (fSharp f hU) ≫ iotaX Y hU = iotaX Z' hU ≫ f := by
  apply (ptX Y hU _ (liesOver_Phi hU _)).injective
  refine (ptX_comp_iota hU (liesOver_Phi hU _) _).trans ?_
  rw [homPhi_PhiMap]
  refine AlgHom.ext fun a => ?_
  exact eta_backX_aux hU _ _ a

/-- `p⁻¹ U` in `Z` is the preimage of `p⁻¹ U` in `Y`. -/
lemma isPullback_chart_f : IsPullback (iotaX Z' hU).left (PhiMap hU (fSharp f hU)).left f.left
    (iotaX Y hU).left := by
  have w : (iotaX Z' hU).left ≫ f.left = (PhiMap hU (fSharp f hU)).left ≫ (iotaX Y hU).left :=
    congrArg (fun k => k.left) (PhiMap_iota f hU).symm
  have key : ∀ {W : Scheme.{u}} (a : W ⟶ Z'.left) (b : W ⟶ (Phi hU (Aalg Y U)).left)
      (_ : a ≫ f.left = b ≫ (iotaX Y hU).left),
      ∃ m : W ⟶ (Phi hU (Aalg Z' U)).left, m ≫ (iotaX Z' hU).left = a ∧
        m ≫ (PhiMap hU (fSharp f hU)).left = b := by
    intro W a b hab
    let Tw : Over S := Over.mk (b ≫ (Phi hU (Aalg Y U)).hom)
    have hTw : LiesOver Tw U := LiesOver.of_hom (Over.homMk b rfl) (liesOver_Phi hU _)
    let b' : Tw ⟶ Phi hU (Aalg Y U) := Over.homMk b rfl
    have hw : a ≫ Z'.hom = Tw.hom := by
      have h1 := Over.w f
      have h2 := Over.w (iotaX Y hU)
      change a ≫ Z'.hom = b ≫ (Phi hU (Aalg Y U)).hom
      rw [← h1, ← h2, ← Category.assoc, hab, Category.assoc]
    let a' : Tw ⟶ Z' := Over.homMk a hw
    let c := toChart Z' hU Tw hTw a'
    have hc : c ≫ iotaX Z' hU = a' := (toChart Z' hU Tw hTw).symm_apply_apply a'
    refine ⟨c.left, congrArg (fun k => k.left) hc, ?_⟩
    have h6 : ∀ g : Tw ⟶ Phi hU (Aalg Y U), toChart Y hU Tw hTw (g ≫ iotaX Y hU) = g :=
      fun g => (toChart Y hU Tw hTw).apply_symm_apply g
    have h3 : (c ≫ PhiMap hU (fSharp f hU)) ≫ iotaX Y hU = b' ≫ iotaX Y hU := by
      rw [Category.assoc, PhiMap_iota, ← Category.assoc, hc]
      exact Over.OverMorphism.ext hab
    have h4 := congrArg (toChart Y hU Tw hTw) h3
    rw [h6, h6] at h4
    exact congrArg (fun k => k.left) h4
  refine ⟨⟨w⟩, ⟨PullbackCone.IsLimit.mk _
    (fun s => (key s.fst s.snd s.condition).choose) ?_ ?_ ?_⟩⟩
  · exact fun s => (key s.fst s.snd s.condition).choose_spec.1
  · exact fun s => (key s.fst s.snd s.condition).choose_spec.2
  · intro s m h1 h2
    have hi : Mono (iotaX Z' hU).left := inferInstance
    rw [← cancel_mono (iotaX Z' hU).left, h1]
    exact (key s.fst s.snd s.condition).choose_spec.1.symm

/-- A closed immersion is surjective on the algebras of the charts. -/
lemma fSharp_surjective [IsClosedImmersion f.left] : Function.Surjective (fSharp f hU) := by
  have hcl : IsClosedImmersion (PhiMap hU (fSharp f hU)).left :=
    MorphismProperty.of_isPullback (isPullback_chart_f f hU) inferInstance
  intro b
  have : IsAffine (Phi hU (Aalg Y U)).left := inferInstanceAs (IsAffine (Spec _))
  have hs := (IsClosedImmersion.isAffine_surjective_of_isAffine
    (PhiMap hU (fSharp f hU)).left).2
  obtain ⟨s, hs⟩ := hs (eta hU (Aalg Z' U) b)
  obtain ⟨a, rfl⟩ := (eta_bijective hU (Aalg Y U)).2 s
  refine ⟨a, (eta_bijective hU (Aalg Z' U)).1 ?_⟩
  refine Eq.trans ?_ hs
  exact (DFunLike.congr_fun (gpull_PhiMap_eta hU (fSharp f hU)) a).symm

variable {actY actZ f} in
/-- A homogeneous element of `A_Z` lifts to a homogeneous element of the same degree in `A_Y`. -/
lemma exists_homogeneous_lift [IsClosedImmersion f.left] (hf : IsEquivariantMor actY actZ f)
    {m : M} {c : Aalg Z' U} (hc : c ∈ gradingOf hU actZ m) :
    ∃ d ∈ gradingOf hU actY m, fSharp f hU d = c := by
  obtain ⟨y, rfl⟩ := fSharp_surjective f hU c
  have key : ∀ y : Aalg Y U, (rho hU actZ (fSharp f hU y)).coeff m =
      fSharp f hU (DirectSum.decompose (gradingOf hU actY) y m) := by
    intro y
    induction y using DirectSum.Decomposition.inductionOn (gradingOf hU actY) with
    | zero => simp
    | @homogeneous k x =>
      have h2 : rho hU actZ (fSharp f hU x) = AddMonoidAlgebra.single k (fSharp f hU x) :=
        fSharp_mem hU hf x.2
      rw [h2, DirectSum.decompose_of_mem _ x.2, AddMonoidAlgebra.coeff_single]
      by_cases e : k = m
      · subst e
        simp
      · rw [Finsupp.single_eq_of_ne (Ne.symm e), DirectSum.of_eq_of_ne _ _ _ (Ne.symm e)]
        simp
    | add a b ha hb =>
      rw [map_add, map_add, AddMonoidAlgebra.coeff_add, Finsupp.add_apply, ha, hb,
        DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add, map_add]
  refine ⟨_, SetLike.coe_mem (DirectSum.decompose (gradingOf hU actY) y m), ?_⟩
  rw [← key, show rho hU actZ (fSharp f hU y) = AddMonoidAlgebra.single m (fSharp f hU y) from hc]
  simp

variable {actY actZ f} in
/-- `J_N` of `A_Z` is generated by the image of `J_N` of `A_Y`: a point of `Z` whose image in `Y`
kills `J_N` itself kills `J_N`. -/
lemma kills_of_comp_kills [IsClosedImmersion f.left] (hf : IsEquivariantMor actY actZ f)
    {N : AddSubmonoid M} {T : Over S} (hT : LiesOver T U) (w : T ⟶ Z')
    (h : ∀ a ∈ magnetIdeal (gradingOf hU actY) N, ptX Y hU T hT (w ≫ f) a = 0) :
    ∀ a ∈ magnetIdeal (gradingOf hU actZ) N, ptX Z' hU T hT w a = 0 := by
  intro a ha
  refine map_eq_zero_of_mem_magnetIdeal (𝒜 := gradingOf hU actZ) _ (fun m hm c hc => ?_) ha
  obtain ⟨d, hd, rfl⟩ := exists_homogeneous_lift hU hf hc
  rw [← ptX_comp_f f hU hT]
  exact h d (mem_magnetIdeal_of_notMem hm hd)

variable {actY actZ f} (N : AddSubmonoid M)

/-- The morphism `Z^N → Y^N`. -/
def Zmap (hf : IsEquivariantMor actY actZ f) : Zatt actZ N ⟶ Zatt actY N :=
  (attEquiv actY N _).symm (attPush hf (attEquiv actZ N _ (𝟙 _)))

@[reassoc]
lemma Zmap_iAtt (hf : IsEquivariantMor actY actZ f) :
    Zmap N hf ≫ iAtt actY N = iAtt actZ N ≫ f := by
  rw [← toPoint_attEquiv]
  change AttractorPt.toPoint (attEquiv actY N _ ((attEquiv actY N _).symm _)) = _
  rw [Equiv.apply_symm_apply, toPoint_attPush, toPoint_attEquiv, Category.id_comp]

/-- **Lemma 3.26.** Let `f : Z → Y` be an equivariant closed immersion of `S`-affine schemes and
`N` a magnet. Then `Z^N = Z ×_Y Y^N`. -/
theorem isPullback_Zmap [IsClosedImmersion f.left] (hf : IsEquivariantMor actY actZ f) :
    IsPullback (Zmap N hf).left (iAtt actZ N).left (iAtt actY N).left f.left := by
  have w : (Zmap N hf).left ≫ (iAtt actY N).left = (iAtt actZ N).left ≫ f.left :=
    congrArg (fun k => k.left) (Zmap_iAtt N hf)
  have key : ∀ {W : Scheme.{u}} (a : W ⟶ (Zatt actY N).left) (b : W ⟶ Z'.left)
      (_ : a ≫ (iAtt actY N).left = b ≫ f.left),
      ∃ m : W ⟶ (Zatt actZ N).left, m ≫ (Zmap N hf).left = a ∧ m ≫ (iAtt actZ N).left = b := by
    intro W a b hab
    let Tw : Over S := Over.mk (b ≫ Z'.hom)
    let b' : Tw ⟶ Z' := Over.homMk b rfl
    have hw : a ≫ (Zatt actY N).hom = Tw.hom := by
      have h1 := Over.w (iAtt actY N)
      have h2 := Over.w f
      change a ≫ (Zatt actY N).hom = b ≫ Z'.hom
      rw [← h1, ← h2, ← Category.assoc, hab, Category.assoc]
    let a' : Tw ⟶ Zatt actY N := Over.homMk a hw
    have hab' : a' ≫ iAtt actY N = b' ≫ f := Over.OverMorphism.ext hab
    have hex : ∃ φ : AttractorPt actZ N Tw, φ.toPoint = b' := by
      refine exists_att_of_local actZ b' fun {W'} g U hW' => ?_
      refine (exists_att_iff_kills actZ U.2 hW' _).2 ?_
      refine kills_of_comp_kills U.2 hf hW' _ ?_
      refine (exists_att_iff_kills actY U.2 hW' _).1 ⟨(attEquiv actY N _ a').baseChange g, ?_⟩
      rw [toPoint_baseChange, toPoint_attEquiv, hab', Category.assoc]
    obtain ⟨z, hz⟩ := exists_hom_of_att actZ N hex.choose
    rw [hex.choose_spec] at hz
    have hz2 : z ≫ Zmap N hf = a' := by
      refine iAtt_cancel actY N ?_
      rw [Category.assoc, Zmap_iAtt, ← Category.assoc, hz, hab']
    exact ⟨z.left, congrArg (fun k => k.left) hz2, congrArg (fun k => k.left) hz⟩
  refine ⟨⟨w⟩, ⟨PullbackCone.IsLimit.mk _
    (fun s => (key s.fst s.snd s.condition).choose) ?_ ?_ ?_⟩⟩
  · exact fun s => (key s.fst s.snd s.condition).choose_spec.1
  · exact fun s => (key s.fst s.snd s.condition).choose_spec.2
  · intro s m h1 h2
    rw [← cancel_mono (iAtt actZ N).left, h2]
    exact (key s.fst s.snd s.condition).choose_spec.2.symm

/-- **Lemma 3.26.** `Z^N → Y^N` is a closed immersion. -/
instance instClosedZmap [IsClosedImmersion f.left] (hf : IsEquivariantMor actY actZ f) :
    IsClosedImmersion (Zmap N hf).left :=
  MorphismProperty.of_isPullback (isPullback_Zmap N hf).flip inferInstance

end Closed

