import AlgMag.Sec8Representability

/-!
# `ℤ[Z] → ℤ[M]` is of finite presentation when `M/Z` is finitely generated

Step towards Proposition 3.35 / 8.1 for arbitrary `M`. With `M₀ ⊆ M` finitely generated and `Z + M₀ = M`,
`ℤ[M] = ℤ[Z][M₀] / (x^k y^{-k} - 1 : k ∈ Z ∩ M₀)`.
-/

open AddMonoidAlgebra

namespace AlgMag.Final2Quot

variable {M : Type*} [AddCommGroup M] (Z M₀ : AddSubgroup M)

/-- `ℤ[Z]`. -/
abbrev RZ := AddMonoidAlgebra ℤ Z.toAddSubmonoid
/-- `ℤ[Z][M₀]`. -/
abbrev P := AddMonoidAlgebra (RZ Z) M₀

/-- The ring map `ℤ[Z] → ℤ[M]`. -/
noncomputable abbrev fZ : RZ Z →+* AddMonoidAlgebra ℤ M :=
  AddMonoidAlgebra.mapDomainRingHom ℤ Z.toAddSubmonoid.subtype

/-- `ℤ[Z][M₀] → ℤ[M]`. -/
noncomputable def Φ : P Z M₀ →+* AddMonoidAlgebra ℤ M :=
  let := (fZ Z).toAlgebra
  (AddMonoidAlgebra.lift (RZ Z) (AddMonoidAlgebra ℤ M) M₀
    { toFun := fun m => single ((Multiplicative.toAdd m : M₀) : M) 1
      map_one' := rfl
      map_mul' := fun a b => by simp [single_mul_single] }).toRingHom

lemma Φ_single (n : M₀) (a : RZ Z) : Φ Z M₀ (single n a) = fZ Z a * single (n : M) 1 := by
  let := (fZ Z).toAlgebra
  simp only [Φ, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AddMonoidAlgebra.lift_single]
  rw [Algebra.smul_def]; rfl

lemma fZ_single (z : Z.toAddSubmonoid) (r : ℤ) : fZ Z (single z r) = single (z : M) r := by
  simp [fZ, AddMonoidAlgebra.mapDomain_single]

lemma Φ_comp : (Φ Z M₀).comp (algebraMap (RZ Z) (P Z M₀)) = fZ Z := by
  ext x <;> simp [Φ_single]

variable {Z M₀}

/-- `x^k y^{-k}` for `k ∈ Z ∩ M₀`. -/
noncomputable def u (n : M₀) (hn : (n : M) ∈ Z) : P Z M₀ := single (-n) (single ⟨n, hn⟩ 1)

lemma u_zero : u (Z := Z) (0 : M₀) (Z.zero_mem) = 1 := by
  rw [u, AddMonoidAlgebra.one_def, AddMonoidAlgebra.one_def]
  congr 1
  · simp

lemma u_add (a b : M₀) (ha : (a : M) ∈ Z) (hb : (b : M) ∈ Z) :
    u (a + b) (by simpa using Z.add_mem ha hb) = u a ha * u b hb := by
  simp only [u, single_mul_single, mul_one, neg_add]
  congr 2

lemma Φ_u (n : M₀) (hn : (n : M) ∈ Z) : Φ Z M₀ (u n hn) = 1 := by
  rw [u, Φ_single, fZ_single, single_mul_single]
  simp [AddMonoidAlgebra.one_def]

variable (s : Finset M₀)

/-- The ideal generated by `u k - 1`, `k ∈ s`. -/
noncomputable def I (hs : ∀ n ∈ s, (n : M) ∈ Z) : Ideal (P Z M₀) :=
  Ideal.span (Set.range fun n : s => u (n : M₀) (hs n n.2) - 1)

lemma I_fg (hs : ∀ n ∈ s, (n : M) ∈ Z) : (I s hs).FG := by
  classical
  exact ⟨(Finset.univ : Finset s).image fun n : s => u (n : M₀) (hs n.1 n.2) - 1, by
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]; rfl⟩

lemma mk_u (hs : ∀ n ∈ s, (n : M) ∈ Z)
    (hcl : ∀ n : M₀, (n : M) ∈ Z ↔ n ∈ AddSubgroup.closure (s : Set M₀))
    (n : M₀) (hn : (n : M) ∈ Z) : Ideal.Quotient.mk (I s hs) (u n hn) = 1 := by
  have key : ∀ n (h : n ∈ AddSubgroup.closure (s : Set M₀)),
      Ideal.Quotient.mk (I s hs) (u n ((hcl n).2 h)) = 1 := by
    intro n h
    induction h using AddSubgroup.closure_induction with
    | mem x hx =>
      rw [← map_one (Ideal.Quotient.mk (I s hs)), Ideal.Quotient.eq]
      exact Ideal.subset_span ⟨⟨x, hx⟩, rfl⟩
    | zero => exact (congrArg _ u_zero).trans (map_one _)
    | add x y hx hy ihx ihy =>
      rw [u_add x y ((hcl x).2 hx) ((hcl y).2 hy), map_mul, ihx, ihy]; first | exact mul_one _ | exact one_mul _ | exact (mul_one (1 : P Z M₀ ⧸ I s hs))
    | neg x hx ihx =>
      have e : u (-x) ((hcl (-x)).2 (neg_mem hx)) * u x ((hcl x).2 hx) = 1 := by
        rw [← u_add]; simp [u]; rfl
      have := congrArg (Ideal.Quotient.mk (I s hs)) e
      rw [map_mul, ihx, map_one] at this; exact (mul_one _).symm.trans this
  exact key n ((hcl n).1 hn)

/-- `x^z y^n`. -/
noncomputable def w (z : M) (hz : z ∈ Z) (n : M₀) : P Z M₀ :=
  single n (single (⟨z, hz⟩ : Z.toAddSubmonoid) 1)

variable (hs : ∀ n ∈ s, (n : M) ∈ Z)
  (hcl : ∀ n : M₀, (n : M) ∈ Z ↔ n ∈ AddSubgroup.closure (s : Set M₀))

include hcl in
lemma mk_w (z z' : M) (hz : z ∈ Z) (hz' : z' ∈ Z) (n n' : M₀) (h : z + n = z' + n') :
    Ideal.Quotient.mk (I s hs) (w z hz n) = Ideal.Quotient.mk (I s hs) (w z' hz' n') := by
  have e : z = z' + n' - n := by rw [← h]; abel
  subst e
  have hk : ((n' - n : M₀) : M) ∈ Z := by
    have : ((n' - n : M₀) : M) = (z' + n' - n) - z' := by push_cast; abel
    rw [this]; exact Z.sub_mem hz hz'
  have e2 : w (z' + n' - n) hz n = w z' hz' n' * u (n' - n) hk := by
    simp only [w, u, single_mul_single, mul_one]
    congr 1
    · ext; push_cast; abel
    · congr 1; ext; push_cast; abel
  rw [e2, map_mul, mk_u s hs hcl]
  exact mul_one (Ideal.Quotient.mk (I s hs) (w z' hz' n'))

variable (hsplit : ∀ m : M, ∃ z : Z, ∃ n : M₀, (z : M) + n = m)

/-- The inverse map on monomials. -/
noncomputable def χ : Multiplicative M →* P Z M₀ ⧸ I s hs where
  toFun m := Ideal.Quotient.mk (I s hs)
    (w ((hsplit m.toAdd).choose : M) (hsplit m.toAdd).choose.2 (hsplit m.toAdd).choose_spec.choose)
  map_one' := by
    have h := (hsplit (Multiplicative.toAdd 1)).choose_spec.choose_spec
    rw [mk_w s hs hcl _ 0 _ Z.zero_mem _ 0 (by simpa using h)]
    rw [← map_one (Ideal.Quotient.mk (I s hs))]
    congr 1
  map_mul' a b := by
    have ha := (hsplit a.toAdd).choose_spec.choose_spec
    have hb := (hsplit b.toAdd).choose_spec.choose_spec
    have hab := (hsplit (a * b).toAdd).choose_spec.choose_spec
    rw [← map_mul]
    have e : w ((hsplit a.toAdd).choose : M) (hsplit a.toAdd).choose.2 (hsplit a.toAdd).choose_spec.choose *
        w ((hsplit b.toAdd).choose : M) (hsplit b.toAdd).choose.2 (hsplit b.toAdd).choose_spec.choose =
        w (((hsplit a.toAdd).choose : M) + (hsplit b.toAdd).choose)
          (Z.add_mem (hsplit a.toAdd).choose.2 (hsplit b.toAdd).choose.2)
          ((hsplit a.toAdd).choose_spec.choose + (hsplit b.toAdd).choose_spec.choose) := by
      simp only [w, single_mul_single, mul_one]; rfl
    rw [e]
    refine mk_w s hs hcl _ _ _ _ _ _ ?_
    have hsum := congrArg₂ (· + ·) ha hb
    rw [hab, toAdd_mul, ← hsum]; push_cast; abel

/-- `Ψ : ℤ[M] → ℤ[Z][M₀]/I`. -/
noncomputable def Ψ : AddMonoidAlgebra ℤ M →+* P Z M₀ ⧸ I s hs :=
  (AddMonoidAlgebra.lift ℤ (P Z M₀ ⧸ I s hs) M (χ s hs hcl hsplit)).toRingHom

lemma Ψ_single (m : M) : Ψ s hs hcl hsplit (single m 1) = χ s hs hcl hsplit (Multiplicative.ofAdd m) := by
  simp [Ψ, AddMonoidAlgebra.lift_single]

lemma χ_eq (m z : M) (hz : z ∈ Z) (n : M₀) (h : z + n = m) :
    χ s hs hcl hsplit (Multiplicative.ofAdd m) = Ideal.Quotient.mk (I s hs) (w z hz n) := by
  refine mk_w s hs hcl _ _ _ _ _ _ ?_
  rw [(hsplit _).choose_spec.choose_spec, h]; rfl

lemma Ψ_Φ : (Ψ s hs hcl hsplit).comp (Φ Z M₀) = Ideal.Quotient.mk (I s hs) := by
  refine AddMonoidAlgebra.ringHom_ext (fun r => ?_) (fun n => ?_)
  · induction r using AddMonoidAlgebra.induction_on with
    | of z =>
      show Ψ s hs hcl hsplit (Φ Z M₀ (single 0 (single z 1))) = Ideal.Quotient.mk (I s hs) (single 0 (single z 1))
      rw [Φ_single, fZ_single, single_mul_single, mul_one,
        show ((z : M) + ((0 : M₀) : M)) = z by simp, Ψ_single]
      exact χ_eq s hs hcl hsplit _ _ z.2 0 (by simp)
    | add x y hx hy =>
      simp only [RingHom.comp_apply, single_add, map_add] at *
      rw [hx, hy]
    | smul r x hx =>
      simp only [RingHom.comp_apply, ← AddMonoidAlgebra.smul_single, map_zsmul] at *
      rw [hx]
  · show Ψ s hs hcl hsplit (Φ Z M₀ (single n 1)) = Ideal.Quotient.mk (I s hs) (single n 1)
    rw [Φ_single, map_one, one_mul, Ψ_single, χ_eq s hs hcl hsplit _ 0 Z.zero_mem n (by simp)]
    simp only [w]
    rfl

include hsplit in
lemma Φ_surjective : Function.Surjective (Φ Z M₀) := by
  intro x
  induction x using AddMonoidAlgebra.induction_on with
  | of m =>
    obtain ⟨z, n, h⟩ := hsplit m
    refine ⟨single n (single (⟨z, z.2⟩ : Z.toAddSubmonoid) 1), ?_⟩
    rw [Φ_single, fZ_single, single_mul_single, mul_one, h]; rfl
  | add x y hx hy =>
    obtain ⟨a, rfl⟩ := hx; obtain ⟨b, rfl⟩ := hy; exact ⟨a + b, map_add _ _ _⟩
  | smul r x hx =>
    obtain ⟨a, rfl⟩ := hx; exact ⟨r • a, map_zsmul _ _ _⟩

include hcl hsplit in
lemma ker_Φ : RingHom.ker (Φ Z M₀) = I s hs := by
  refine le_antisymm (fun x hx => ?_) ?_
  · have := congrArg (fun f => f x) (Ψ_Φ s hs hcl hsplit)
    simp only [RingHom.comp_apply, (RingHom.mem_ker).1 hx, map_zero] at this
    exact Ideal.Quotient.eq_zero_iff_mem.1 this.symm
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨n, rfl⟩
    simp [RingHom.mem_ker, Φ_u]

include hs hcl hsplit in
/-- `ℤ[Z] → ℤ[M]` is of finite presentation, given `M₀` finitely generated with `Z + M₀ = M`. -/
theorem finitePresentation_fZ [AddGroup.FG M₀] : (fZ Z).FinitePresentation := by
  rw [← Φ_comp Z M₀]
  refine RingHom.FinitePresentation.comp (RingHom.FinitePresentation.of_surjective _
    (Φ_surjective hsplit) (by rw [ker_Φ s hs hcl hsplit]; exact I_fg s hs)) ?_
  have : AddMonoid.FG M₀ := AddGroup.fg_iff_addMonoid_fg.mp inferInstance
  rw [RingHom.finitePresentation_algebraMap]
  exact finitePresentation (RZ Z) M₀

variable (Z) in
/-- **`ℤ[Z] → ℤ[M]` is of finite presentation when `M/Z` is finitely generated.** -/
theorem finitePresentation_of_quot [AddGroup.FG (M ⧸ Z)] : (fZ Z).FinitePresentation := by
  classical
  obtain ⟨t, ht, htf⟩ := AddGroup.fg_iff.1 (inferInstance : AddGroup.FG (M ⧸ Z))
  let M₀ : AddSubgroup M := AddSubgroup.closure ((fun q : M ⧸ Z => q.out) '' t)
  have hM₀ : AddGroup.FG M₀ := (AddGroup.fg_iff_addSubgroup_fg M₀).2
    ⟨(htf.image (fun q : M ⧸ Z => q.out)).toFinset, by simp [M₀]⟩
  have hmap : M₀.map (QuotientAddGroup.mk' Z) = ⊤ := by
    rw [AddMonoidHom.map_closure, ← Set.image_comp, ← ht]
    congr 1
    have : (⇑(QuotientAddGroup.mk' Z) ∘ fun q : M ⧸ Z => q.out) = id := by
      funext q; exact QuotientAddGroup.out_eq' q
    rw [this, Set.image_id]
  have hsplit : ∀ m : M, ∃ z : Z, ∃ n : M₀, (z : M) + n = m := by
    intro m
    have : (QuotientAddGroup.mk' Z m) ∈ M₀.map (QuotientAddGroup.mk' Z) := by rw [hmap]; trivial
    obtain ⟨n, hn, e⟩ := this
    have hz : m - n ∈ Z := by
      have := (QuotientAddGroup.eq (s := Z)).1 e
      rwa [sub_eq_neg_add]
    exact ⟨⟨m - n, hz⟩, ⟨n, hn⟩, by simp⟩
  have : Module.Finite ℤ M₀ := Module.Finite.iff_addGroup_fg.mpr hM₀
  have hK : (AddSubgroup.toIntSubmodule (Z.addSubgroupOf M₀)).FG := IsNoetherian.noetherian _
  obtain ⟨s, hs⟩ := (Submodule.fg_iff_addSubgroup_fg _).1 hK
  have hcl : ∀ n : M₀, (n : M) ∈ Z ↔ n ∈ AddSubgroup.closure (s : Set M₀) := by
    intro n; rw [hs]; exact (AddSubgroup.mem_addSubgroupOf).symm
  have hs' : ∀ n ∈ s, (n : M) ∈ Z := fun n hn => (hcl n).2 (AddSubgroup.subset_closure hn)
  exact finitePresentation_fZ s hs' hcl hsplit

end AlgMag.Final2Quot

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry

universe u

namespace AlgMag

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
variable {M : Type u} [AddCommGroup M]

local notation "SCH" => BigFppfOver.toScheme B S hS

/-- **Proposition 3.35, cover step**: `D(M) → D(Z)` is an fppf cover when `M/Z` is finitely generated. -/
theorem final2_extSieve_mem_quot (Z : AddSubgroup M) [AddGroup.FG (M ⧸ Z)]
    (hAZ : B.Contains (GB.AZ M)) {T : BigFppfOver B S hS}
    (a : APt (fppfO B S hS) Z.toAddSubmonoid (op T)) :
    extSieve (fppfO B S hS) Z a ∈ BigFppfOver.topology B S hS T := by
  let φ := Z.toAddSubmonoid.subtype
  let f : (SCH).obj T ⟶ GB.AZ Z.toAddSubmonoid := (GB.ptsZ _).symm a
  let W : Scheme.{u} := pullback f (GB.AZmap φ)
  have hW : B.Contains W := lt_of_le_of_lt (Scheme.size_pullback_le _ _)
    (max_lt T.left.2 hAZ)
  let T'' : BigFppfOver B S hS := siteObject B S hS hW (pullback.fst f (GB.AZmap φ) ≫ structMap T)
  let q : T'' ⟶ T := Over.homMk (ObjectProperty.homMk (pullback.fst f (GB.AZmap φ))) rfl
  have hfl : Flat (GB.AZmap φ) := GB.flat_AZmap φ (flat_of_isFreeAlong ℤ (isFreeAlong_subtype Z))
  have hlf : LocallyOfFinitePresentation (GB.AZmap φ) :=
    (HasRingHomProperty.Spec_iff (P := @LocallyOfFinitePresentation)).mpr
      (Final2Quot.finitePresentation_of_quot Z)
  have hsu : Surjective (GB.AZmap φ) := ⟨comap_mapDomain_surjective Z ℤ⟩
  have hqf : Flat ((SCH).map q) := inferInstanceAs (Flat (pullback.fst f (GB.AZmap φ)))
  have hqp : LocallyOfFinitePresentation ((SCH).map q) :=
    inferInstanceAs (LocallyOfFinitePresentation (pullback.fst f (GB.AZmap φ)))
  have hqs : Surjective ((SCH).map q) := inferInstanceAs (Surjective (pullback.fst f (GB.AZmap φ)))
  refine (BigFppfOver.topology B S hS).superset_covering ?_
    (Space.sieve_generate_singleton_mem_topology_over_of_flat B S hS q hqs hqf hqp)
  rw [Sieve.generate_le_iff]
  rintro _ _ ⟨⟩
  refine ⟨GB.ptsZ _ (pullback.snd f (GB.AZmap φ)), ?_⟩
  have e := GB.ptsZ_AZmap φ (pullback.snd f (GB.AZmap φ))
  rw [← pullback.condition, GB.ptsZ_comp] at e
  have hf : GB.ptsZ _ f = a := (GB.ptsZ _).apply_symm_apply a
  rw [hf] at e
  exact e.symm

end AlgMag

#print axioms AlgMag.Final2Quot.finitePresentation_of_quot
#print axioms AlgMag.final2_extSieve_mem_quot

namespace AlgMag

/-- **Proposition 8.1** for an abelian group `M` with `M/Z` finitely generated: a `Z`-FPR atlas makes `X^Z`
a closed subspace of `X`. -/
theorem final2_prop81_quotFG (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) (M : Type u)
    [AddCommGroup M] (X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (hX : IsAlgebraicSpace B S hS X)
    (actX : AAction (fppfO B S hS) M X) (Z : AddSubgroup M) [AddGroup.FG (M ⧸ Z)]
    (hAZ : B.Contains (GB.AZ M)) (hM : B.Contains (Spec (ZMon M)))
    (hQ : B.Contains (Spec (ZMon (M ⧸ Z)))) :
    ExistsZFPRAtlas actX Z → AttractorIsClosedSubspace actX Z := by
  rintro ⟨U, actU, g, hg⟩
  have hsh : Presieve.IsSheaf (BigFppfOver.topology B S hS) X :=
    (isSheaf_iff_isSheaf_of_type _ _).mp hX.isSheaf
  have hcov : ∀ {T : BigFppfOver B S hS} (a : APt (fppfO B S hS) Z.toAddSubmonoid (op T)),
      extSieve (fppfO B S hS) Z a ∈ BigFppfOver.topology B S hS T :=
    fun a => final2_extSieve_mem_quot Z hAZ a
  let Y := (fixedPoints (quotientAction actX Z)).toFunctor
  let i : Y ⟶ X := (fixedPoints (quotientAction actX Z)).ι
  have hYs : Presheaf.IsSheaf (BigFppfOver.topology B S hS) Y := isSheaf_fixedPoints hX.isSheaf actX Z
  obtain ⟨W, j, hj, hiff⟩ := exists_closed_fixed hM hg.atlas.decomposition hQ
  have hι := presheaf_fixed_ι j hj hiff
  have hpb : IsPullback (fixedMap (IsEquivariant.comap (actU := actU) (actX := actX) (f := g)
        hg.atlas.equivariant (QuotientAddGroup.mk' Z)))
      (fixedPoints (quotientAction actU Z)).ι i g := hg.isZFPR
  have hsq : IsPullback hpb.isoPullback.inv (pullback.snd i g)
      (fixedPoints (quotientAction actU Z)).ι (𝟙 _) :=
    IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id, IsPullback.isoPullback_inv_snd]⟩
  have hV := (MorphismProperty.relative_isStableUnderBaseChange _).of_isPullback hsq hι
  have hres := Space.isAlgebraicSpace_and_presheaf_of_surjectiveEtaleChart_of_descent
    (Space.isEffectiveDescentAlongSurjectiveEtale_isClosedImmersion B S hS) hYs hX
    hg.atlas.surjective hg.atlas.etale hV
  refine ⟨Y, i, ⟨fun T => attractorFixedEquivOfCover hsh hcov T, fun s z =>
    attractorFixedEquivOfCover_naturality hsh hcov s z⟩, hres.1, hres.2, fun T y => ?_⟩
  exact (congrArg Subtype.val
    ((attractorFixedEquivOfCover (act := actX) hsh hcov T).symm_apply_apply y)).symm

end AlgMag

#print axioms AlgMag.final2_prop81_quotFG
