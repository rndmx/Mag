import AlgMag.SelfActionsBase
import Mathlib.GroupTheory.MonoidLocalization.GrothendieckGroup

/-!
# Self-actions: the statements of the paper, over a ring and over a scheme

Mayeux, *Algebraic magnetism invariants of self-actions of diagonalizable monoid schemes*,
Semigroup Forum 112 (2026) 532–540, doi:10.1007/s00233-025-10572-9 (the published version, read from
the publisher's PDF; numbering and quotations below are those of the journal).

`PiS L S` is the set `Π(a)` of pure magnets of the action of `𝔸(M)_S` on `𝔸(L)_S`, for an arbitrary
scheme `S`, and `PiR R L` the same for `S = Spec R`.

The proofs are in `AlgMag.SelfActionsMonoid`. Proposition 2.1 is in `AlgMag.SelfActionsProp21`. The
Theorem of §1.1 is Theorem 4.6.

## Added hypothesis

`S ≠ ∅` (resp. `R ≠ 0`) is added to Proposition 3.1, the first assertion of Lemma 4.1, Proposition 4.5,
Theorem 4.6 and the computations of `Π(a)` in Examples (i)-(v), which fail over `S = ∅`, where `Π(a) = {0}`
(`pureMagnets_empty_base`, `pureMagnets_ring_subsingleton`). The other statements hold for every `S`
and carry no such hypothesis: the decomposition and `Π(a) = Π(a')` of §2, Proposition 2.1, the two
vanishing assertions and the case `M = 0` of Lemma 4.1, Proposition 4.2, Proposition 4.3 and the
finiteness in Example (vi).

## Departures from the printed text

* Proposition 2.1: the printed proof shows the identification on `R`-points for rings `R`; here it is
  on `T`-points for all schemes `T` over `S`, by the same two maps (`toPoint_vanish`, `vanishPt`).
* §2: "A magnet `N` is called pure if for any other magnet `P ⊂ N` such that `X^P = X^N`, we have
  `P = N`" is `IsPurePrinted`. The proofs use `AlgMag.IsPure` (every magnet with the same attractor
  contains `N`), equivalent by `isPurePrinted_iff`, `isPurePrinted_scheme`.
* Proposition 3.1: stated both as `N ↦ N ∩ E` (`prop31Equiv`, printed bijection) and as the equality
  `Π(a) = {[B⟩}`. The printed "We can assume that `S = Spec(ℤ)`" is `pureMagnets_scheme`.
* Proposition 4.2: the printed hypothesis `M^* ≠ 0` follows from the other one and is not stated.
* Theorem 4.6: Ogus, Proposition 1.3.3 (cited) is proved, as `sharp_add_left_cancel`.
* Theorem 4.6 (i): `M/M^×` is `M` when `M^× = 0`; `thm46_i` takes `E ⊆ M`, `thm46_i_quot` takes
  `E ⊆ M/M^×`.
* The examples of §5 apply Proposition 3.1 where the printed text applies Theorem 4.6 (i), whose printed
  proof is "this is Proposition 3.1", and `thm46_lifted` where it applies Theorem 4.6 (ii).
* Example (v): the sentence "(which is sharp)" has no printed proof; it is proved with the height
  `(a, b) ↦ 2a - b`.

## Printed points

* Proof of Proposition 3.1, p. 536, "This implies that `e' ∈ N^*`. So `N^* ≠ 0` which is absurd":
  read `[E⟩^*`, see `isPure_closure`.
* Lemma 4.4, p. 537, "submonoids of `N` containing `M^*`": read `M`.
* Example (iii), "`(1, -1), (1, 0)` and `(1, 1)` are independent": they are not `ℤ`-independent; what is
  used is that no element is in the submonoid generated by the others (`ex_iii_independent`).
* Example (v), "with `s > 2`": read `s ≥ 2` (`ex_v_inequality`). The parenthesis "in `ℕ_{≥1}`" can be
  dropped: the inequality also covers `(0, -1)`, which belongs to the set since `k ∈ ℕ`.
-/

suppress_compilation

open CategoryTheory AlgebraicGeometry Magnetism Set

open scoped Classical

set_option linter.unusedSectionVars false

universe u v

namespace AlgMag.SelfActions

open AlgMag.GB

section Scheme

variable {S : Scheme.{u}} {M : Type u} [AddCommMonoid M]

/-- `Π(a)` for the action of `𝔸(M)_S` on `𝔸(L)_S`. -/
abbrev PiS (L : AddSubmonoid M) (S : Scheme.{u}) : Set (AddSubmonoid M) :=
  pureMagnets (attractorImage (aAction L S))

/-- The definition of pure magnets of §2 agrees with `AlgMag.IsPure`, for every `S`. -/
theorem isPurePrinted_scheme (L N : AddSubmonoid M) :
    IsPurePrinted (attractorImage (aAction L S)) N ↔ N ∈ PiS L S := by
  rcases isEmpty_or_nonempty S with hS | hS
  · rw [PiS, pureMagnets_empty_base, Set.mem_singleton_iff]
    constructor
    · intro h
      exact (h ⊥ bot_le (attractorImage_eq_of_isEmpty L _ _)).symm
    · rintro rfl P hP -
      exact le_bot_iff.mp hP
  have h1 : IsPurePrinted (attractorImage (aAction L S)) N ↔ IsPurePrinted (monIdeal L) N :=
    forall_congr' fun P => forall_congr' fun _ => by rw [attractorImage_eq_iff]
  rw [h1, isPurePrinted_iff, PiS, pureMagnets_scheme]
  rfl

/-- **§2**: the decomposition `m(a) = ⊔_{N ∈ Π(a)} m^N(a)`, for every `S`. -/
theorem existsUnique_pure_scheme (L N : AddSubmonoid M) :
    ∃! P : AddSubmonoid M, P ∈ PiS L S ∧
      attractorImage (aAction L S) N = attractorImage (aAction L S) P := by
  rcases isEmpty_or_nonempty S with hS | hS
  · simp only [PiS, pureMagnets_empty_base, Set.mem_singleton_iff]
    exact ⟨⊥, ⟨rfl, attractorImage_eq_of_isEmpty L _ _⟩, fun P hP => hP.1⟩
  simp only [PiS, pureMagnets_scheme, attractorImage_eq_iff]
  exact existsUnique_pure L N

/-- **§2**: `Π(a) = Π(a')`. For `ι : M → G` injective, in particular `M → M^gp`
(`piS_grothendieck`), the pure magnets of `𝔸(L)_S` are the same submonoids, for every `S`. -/
theorem piS_map {G : Type u} [AddCommMonoid G] (L : AddSubmonoid M) (ι : M →+ G)
    (hι : Function.Injective ι) :
    PiS (L.map ι) S = AddSubmonoid.map ι '' PiS L S := by
  rcases isEmpty_or_nonempty S with hS | hS
  · simp only [PiS, pureMagnets_empty_base, Set.image_singleton, AddSubmonoid.map_bot]
  simp only [PiS, pureMagnets_scheme]
  exact pureMagnets_map L ι hι

/-- **Proposition 4.3**, for every `S`. The printed proof "We reduce to the case where `S = Spec(ℤ)`"
is `attractorImage_eq_iff`, for `S ≠ ∅`; for `S = ∅` both sides hold. -/
theorem prop43_scheme {N N' : AddSubmonoid M} (hN : unitsOf M ≤ N) (hN' : unitsOf M ≤ N') :
    attractorImage (aAction (⊤ : AddSubmonoid M) S) N =
        attractorImage (aAction (⊤ : AddSubmonoid M) S) N' ↔
      attractorImage (aAction (⊤ : AddSubmonoid (Sharp M)) S) (N.map (proj M)) =
        attractorImage (aAction (⊤ : AddSubmonoid (Sharp M)) S) (N'.map (proj M)) := by
  rcases isEmpty_or_nonempty S with hS | hS
  · exact iff_of_true (attractorImage_eq_of_isEmpty _ _ _) (attractorImage_eq_of_isEmpty _ _ _)
  rw [attractorImage_eq_iff, attractorImage_eq_iff]
  exact prop43 hN hN'

/-- **Lemma 4.1**, for any `S`: `(𝔸(G)_S)^G = 𝔸(G)_S`, as schemes: the closed immersion is an
isomorphism. More generally `(𝔸(L)_S)^L = 𝔸(L)_S`. -/
theorem lemma41_top_iso (L : AddSubmonoid M) : IsIso (iAtt (aAction L S) L).left := by
  let φ : AttractorPt (aAction L S) L (A L S) :=
    vanishPt L (𝟙 _) fun l hl => absurd l.2 hl
  let z : A L S ⟶ Zatt (aAction L S) L := (attEquiv (aAction L S) L _).symm φ
  have hz : z ≫ iAtt (aAction L S) L = 𝟙 _ := by
    rw [← toPoint_attEquiv, Equiv.apply_symm_apply, toPoint_vanishPt]
  have hz' : z.left ≫ (iAtt (aAction L S) L).left = 𝟙 _ := congrArg (fun k => k.left) hz
  have : IsSplitEpi (iAtt (aAction L S) L).left := IsSplitEpi.mk' ⟨z.left, hz'⟩
  exact isIso_of_mono_of_isSplitEpi _

variable [Nonempty S]

/-- **Lemma 3.2** is `lemma32`. **Proposition 3.1**, over an arbitrary `S ≠ ∅`:
`Π(a) = {[B⟩ | B ⊆ E}`. Hypothesis (i) is `hE`, (ii) is `hu`. -/
theorem prop31_scheme [IsCancelAdd M] {E : Set M} (hE : IsMinimalGen E)
    (hu : unitsFace (AddSubmonoid.closure E) = ⊥) :
    PiS (AddSubmonoid.closure E) S = AddSubmonoid.closure '' 𝒫 E := by
  rw [PiS, pureMagnets_scheme, prop31 hE hu]

/-- **Proposition 3.1**, over an arbitrary `S ≠ ∅`: `Π(a) ≅ {subsets of E}`, by `N ↦ N ∩ E`. -/
def prop31EquivScheme [IsCancelAdd M] {E : Set M} (hE : IsMinimalGen E)
    (hu : unitsFace (AddSubmonoid.closure E) = ⊥) :
    PiS (AddSubmonoid.closure E) S ≃ 𝒫 E :=
  (Equiv.cast (congrArg (fun s : Set (AddSubmonoid M) => (↥s : Type u))
    (pureMagnets_scheme (S := S) (AddSubmonoid.closure E)))).trans (prop31Equiv hE hu)

/-- **Lemma 4.1**, over `S ≠ ∅`: `Π(a) = {0, G}` if `G ≠ 0`. -/
theorem lemma41_scheme {G : Type u} [AddCommGroup G] [Nontrivial G] :
    PiS (⊤ : AddSubmonoid G) S = {⊥, ⊤} := by
  rw [PiS, pureMagnets_scheme, lemma41_pure]

omit [Nonempty S] in
/-- **Lemma 4.1**, for any `S`: `Π(a) = {0}` if `G = 0`. -/
theorem lemma41_scheme_trivial {G : Type u} [AddCommGroup G] [Subsingleton G] :
    PiS (⊤ : AddSubmonoid G) S = {⊥} := by
  rcases isEmpty_or_nonempty S with hS | hS
  · exact pureMagnets_empty_base _
  rw [PiS, pureMagnets_scheme, lemma41_trivial]

omit [Nonempty S] in
/-- **Lemma 4.1**, for any `S`: `(𝔸(G)_S)^N = ∅` if `N ⊊ G`. -/
theorem lemma41_empty_scheme {G : Type u} [AddCommGroup G] {N : AddSubmonoid G} (h : N ≠ ⊤) :
    IsEmpty (Zatt (aAction (⊤ : AddSubmonoid G) S) N).left :=
  isEmpty_Zatt_of_zero_mem _ ((lemma41_empty h).symm ▸ mem_univ _)

omit [Nonempty S] in
/-- **Lemma 4.1**, for any `S`: `(𝔸(G)_S)^G = 𝔸(G)_S`, on points; see `lemma41_top_iso` for schemes. -/
theorem lemma41_top_scheme {G : Type u} [AddCommMonoid G] (T : Over S) :
    attractorImage (aAction (⊤ : AddSubmonoid G) S) ⊤ T = univ := by
  rw [attractorImage_self]
  exact eq_univ_of_forall fun t l hl => absurd trivial hl

omit [Nonempty S] in
/-- **Proposition 4.2**, for any `S`: if `N` does not contain `M^×`, then `(𝔸(M)_S)^N = ∅`. -/
theorem prop42_scheme {N : AddSubmonoid M} (h : ¬ unitsOf M ≤ N) :
    IsEmpty (Zatt (aAction (⊤ : AddSubmonoid M) S) N).left :=
  isEmpty_Zatt_of_zero_mem _ ((prop42 h).symm ▸ mem_univ _)

/-- **Proposition 4.5**, over `S ≠ ∅`: if `M^× ≠ 0`, `Π(a) = {0} ⊔ {f⁻¹(P) | P ∈ Π(ā)}`. -/
theorem prop45_scheme (hU : unitsOf M ≠ ⊥) :
    PiS (⊤ : AddSubmonoid M) S =
      {⊥} ∪ AddSubmonoid.comap (proj M) '' PiS (⊤ : AddSubmonoid (Sharp M)) S := by
  simp only [PiS, pureMagnets_scheme]
  exact prop45 hU

variable [IsCancelAdd M]

/-- **Theorem 4.6 (i)**, over `S ≠ ∅`, for `E ⊆ M` a minimal generating set of `M = M/0`. -/
theorem thm46_i_scheme {E : Set M} (hE : IsMinimalGen E) (hgen : AddSubmonoid.closure E = ⊤)
    (hU : unitsOf M = ⊥) : BijOn AddSubmonoid.closure (𝒫 E) (PiS (⊤ : AddSubmonoid M) S) := by
  rw [PiS, pureMagnets_scheme]
  exact thm46_i hE hgen hU

/-- **Theorem 4.6 (i)**, over `S ≠ ∅`, for `E` a minimal generating set of `M/M^×`. -/
theorem thm46_i_quot_scheme {E : Set (Sharp M)} (hE : IsMinimalGen E)
    (hgen : AddSubmonoid.closure E = ⊤) (hU : unitsOf M = ⊥) :
    BijOn (fun B : Set (Sharp M) => (AddSubmonoid.closure B).comap (proj M)) (𝒫 E)
      (PiS (⊤ : AddSubmonoid M) S) := by
  rw [PiS, pureMagnets_scheme]
  exact thm46_i_quot hE hgen hU

/-- **Theorem 4.6 (ii)**, over `S ≠ ∅`: if `M^× ≠ 0`, `Π(a) = {0} ⊔ {f⁻¹([B⟩) | B ∈ 𝒫(E)}`. -/
theorem thm46_ii_scheme {E : Set (Sharp M)} (hE : IsMinimalGen E)
    (hgen : AddSubmonoid.closure E = ⊤) (hU : unitsOf M ≠ ⊥) :
    PiS (⊤ : AddSubmonoid M) S =
      {⊥} ∪ (fun B : Set (Sharp M) => (AddSubmonoid.closure B).comap (proj M)) '' 𝒫 E := by
  rw [PiS, pureMagnets_scheme]
  exact thm46_ii hE hgen hU

/-- **Theorem 4.6**, over `S ≠ ∅`: `#Π(a) = 2^{#E}` if `M^× = 0`. -/
theorem thm46_card_i_scheme {E : Set (Sharp M)} (hE : IsMinimalGen E)
    (hgen : AddSubmonoid.closure E = ⊤) (hU : unitsOf M = ⊥) :
    Cardinal.mk (PiS (⊤ : AddSubmonoid M) S) = 2 ^ Cardinal.mk E := by
  rw [PiS, pureMagnets_scheme]
  exact thm46_card_i hE hgen hU

/-- **Theorem 4.6**, over `S ≠ ∅`: `#Π(a) = 2^{#E} + 1` if `M^× ≠ 0`. -/
theorem thm46_card_ii_scheme {E : Set (Sharp M)} (hE : IsMinimalGen E)
    (hgen : AddSubmonoid.closure E = ⊤) (hU : unitsOf M ≠ ⊥) :
    Cardinal.mk (PiS (⊤ : AddSubmonoid M) S) = 2 ^ Cardinal.mk E + 1 := by
  rw [PiS, pureMagnets_scheme]
  exact thm46_card_ii hE hgen hU

end Scheme

section Ring

variable (R : Type v) [CommRing R] [Nontrivial R] {M : Type u} [AddCommMonoid M]

/-- `Π(a)` for the action of `𝔸(M)_R` on `𝔸(L)_R`. -/
abbrev PiR (L : AddSubmonoid M) : Set (AddSubmonoid M) :=
  pureMagnets (affineY (magnetGrading L R))

/-- **Proposition 3.1** over a ring `R ≠ 0`, by the printed proof. Compare
`AlgMag.pureMagnets_self_eq`, the same statement with a direct proof. -/
theorem prop31_ring [IsCancelAdd M] {E : Set M} (hE : IsMinimalGen E)
    (hu : unitsFace (AddSubmonoid.closure E) = ⊥) :
    PiR R (AddSubmonoid.closure E) = AddSubmonoid.closure '' 𝒫 E := by
  rw [PiR, pureMagnets_ring, prop31 hE hu]

/-- **Lemma 4.1** over a ring `R ≠ 0`. -/
theorem lemma41_ring {G : Type u} [AddCommGroup G] [Nontrivial G] :
    PiR R (⊤ : AddSubmonoid G) = {⊥, ⊤} := by
  rw [PiR, pureMagnets_ring, lemma41_pure]

omit [Nontrivial R] in
/-- **Proposition 4.2** over a ring: if `N` does not contain `M^×`, `J_N = 1`. -/
theorem prop42_ring {N : AddSubmonoid M} (h : ¬ unitsOf M ≤ N) :
    magnetIdeal (magnetGrading (⊤ : AddSubmonoid M) R) N = ⊤ := by
  rcases subsingleton_or_nontrivial R with hR | hR
  · have h1 : Subsingleton (AddMonoidAlgebra R (⊤ : AddSubmonoid M)) :=
      ⟨fun a b => AddMonoidAlgebra.coeff_inj.mp (Finsupp.ext fun x => Subsingleton.elim _ _)⟩
    exact Subsingleton.elim _ _
  refine Ideal.eq_top_of_isUnit_mem _ ((mono_mem_magnetIdeal_iff R _ (0 : (⊤ : AddSubmonoid M))).2
    ((prop42 h).symm ▸ mem_univ _)) ?_
  exact isUnit_one

omit [Nontrivial R] in
/-- **Proposition 4.3** over any ring `R`. For `R = 0` both sides hold. -/
theorem prop43_ring {N N' : AddSubmonoid M} (hN : unitsOf M ≤ N) (hN' : unitsOf M ≤ N') :
    magnetIdeal (magnetGrading (⊤ : AddSubmonoid M) R) N =
        magnetIdeal (magnetGrading (⊤ : AddSubmonoid M) R) N' ↔
      magnetIdeal (magnetGrading (⊤ : AddSubmonoid (Sharp M)) R) (N.map (proj M)) =
        magnetIdeal (magnetGrading (⊤ : AddSubmonoid (Sharp M)) R) (N'.map (proj M)) := by
  rcases subsingleton_or_nontrivial R with hR | hR
  · have h1 : Subsingleton (AddMonoidAlgebra R (⊤ : AddSubmonoid M)) :=
      ⟨fun a b => AddMonoidAlgebra.coeff_inj.mp (Finsupp.ext fun x => Subsingleton.elim _ _)⟩
    have h2 : Subsingleton (AddMonoidAlgebra R (⊤ : AddSubmonoid (Sharp M))) :=
      ⟨fun a b => AddMonoidAlgebra.coeff_inj.mp (Finsupp.ext fun x => Subsingleton.elim _ _)⟩
    exact iff_of_true (Subsingleton.elim _ _) (Subsingleton.elim _ _)
  rw [magnetIdeal_eq_iff, magnetIdeal_eq_iff]
  exact prop43 hN hN'

/-- **Proposition 4.5** over a ring `R ≠ 0`. -/
theorem prop45_ring (hU : unitsOf M ≠ ⊥) :
    PiR R (⊤ : AddSubmonoid M) =
      {⊥} ∪ AddSubmonoid.comap (proj M) '' PiR R (⊤ : AddSubmonoid (Sharp M)) := by
  simp only [PiR, pureMagnets_ring]
  exact prop45 hU

variable [IsCancelAdd M]

/-- **Theorem 4.6 (i)** over a ring `R ≠ 0`. -/
theorem thm46_i_ring {E : Set M} (hE : IsMinimalGen E) (hgen : AddSubmonoid.closure E = ⊤)
    (hU : unitsOf M = ⊥) : BijOn AddSubmonoid.closure (𝒫 E) (PiR R (⊤ : AddSubmonoid M)) := by
  rw [PiR, pureMagnets_ring]
  exact thm46_i hE hgen hU

/-- **Theorem 4.6 (ii)** over a ring `R ≠ 0`. -/
theorem thm46_ii_ring {E : Set (Sharp M)} (hE : IsMinimalGen E)
    (hgen : AddSubmonoid.closure E = ⊤) (hU : unitsOf M ≠ ⊥) :
    PiR R (⊤ : AddSubmonoid M) =
      {⊥} ∪ (fun B : Set (Sharp M) => (AddSubmonoid.closure B).comap (proj M)) '' 𝒫 E := by
  rw [PiR, pureMagnets_ring]
  exact thm46_ii hE hgen hU

end Ring

section Grothendieck

variable {S : Scheme.{u}} {M : Type u} [AddCommMonoid M] [IsCancelAdd M]

/-- **§2**: `Π(a) = Π(a')` for the action of `D(M^gp)_S = 𝔸(M^gp)_S`, where `M` is cancellative. -/
theorem piS_grothendieck (L : AddSubmonoid M) :
    PiS (L.map (Algebra.GrothendieckAddGroup.of (M := M))) S =
      AddSubmonoid.map (Algebra.GrothendieckAddGroup.of (M := M)) '' PiS L S :=
  piS_map L _ Algebra.GrothendieckAddGroup.of_injective

end Grothendieck

