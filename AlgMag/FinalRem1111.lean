import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
import Mathlib.RingTheory.Flat.TorsionFree
import Mathlib.RingTheory.PrincipalIdealDomain
import Mathlib.Algebra.Polynomial.AlgebraMap
import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.RingTheory.MvPolynomial.Basic
import Mathlib.RingTheory.Polynomial.UniqueFactorization

/-!
# Remark 11.11 of *Algebraic Magnetism*: flatness is not preserved

The paper refers to a Mathoverflow answer and prints no example. Example here: `M = ℤ`, `N = 0`, a field `k`,
`X = Spec k[x, y]` with `x, y` of weights `1, -1`, `Y = Spec k[t]` with the trivial action, `X → Y` given by
`t ↦ xy`. It is flat. By Theorem 3.20 (`isLeast_ker_iAtt`, `representsAttractor`) the coordinate ring of `X^0` is
`k[x, y] / J`, `J` generated by the weight spaces of nonzero weight, and that of `Y^0` is `k[t]`. Then `J = (x, y)`,
and `X^0 → Y^0` is `Spec k → Spec k[t]`, `t ↦ 0`, which is not flat.
-/

open MvPolynomial

set_option linter.style.haveILetI false

noncomputable section

namespace AlgMag.Final

variable (k : Type*) [Field k]

/-- The weights `1, -1`. -/
def w₂ : Fin 2 → ℤ := ![1, -1]

/-- `k[x, y]`. -/
abbrev A₂ := MvPolynomial (Fin 2) k

/-- `J`: the ideal generated by the weight spaces of nonzero weight (Theorem 3.20 with `N = 0`). -/
def J₂ : Ideal (A₂ k) :=
  Ideal.span (⋃ m : {m : ℤ // m ≠ 0}, (weightedHomogeneousSubmodule k w₂ m.1 : Set (A₂ k)))

/-- `t ↦ xy`. -/
def toA₂ : Polynomial k →ₐ[k] A₂ k := Polynomial.aeval (X 0 * X 1)

lemma x_mem : (X 0 : A₂ k) ∈ J₂ k := by
  refine Ideal.subset_span (Set.mem_iUnion.mpr ⟨⟨1, one_ne_zero⟩, ?_⟩)
  simpa [w₂] using isWeightedHomogeneous_X k w₂ (0 : Fin 2)

lemma y_mem : (X 1 : A₂ k) ∈ J₂ k := by
  refine Ideal.subset_span (Set.mem_iUnion.mpr ⟨⟨-1, by norm_num⟩, ?_⟩)
  simpa [w₂] using isWeightedHomogeneous_X k w₂ (1 : Fin 2)

lemma J₂_le : J₂ k ≤ RingHom.ker (constantCoeff : A₂ k →+* k) := by
  refine Ideal.span_le.mpr (Set.iUnion_subset fun m p hp => ?_)
  have hp' : IsWeightedHomogeneous w₂ p m.1 := hp
  change constantCoeff p = 0
  by_contra h
  have hne : coeff 0 p ≠ 0 := by simpa [constantCoeff_eq] using h
  have := hp' hne
  simp only [Finsupp.weight_apply, Finsupp.sum_zero_index] at this
  exact m.2 this.symm

lemma one_notMem : (1 : A₂ k) ∉ J₂ k := fun h => by
  have := J₂_le k h
  simp [RingHom.mem_ker] at this

/-- The structure map of `X^0 → Y^0`. -/
def toQuot : Polynomial k →+* (A₂ k ⧸ J₂ k) :=
  (Ideal.Quotient.mk (J₂ k)).comp (toA₂ k).toRingHom

/-- **Remark 11.11**, first half: `X → Y` is flat. -/
theorem rem1111_flat :
    letI := (toA₂ k).toRingHom.toAlgebra
    Module.Flat (Polynomial k) (A₂ k) := by
  letI := (toA₂ k).toRingHom.toAlgebra
  rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, Submodule.eq_bot_iff]
  intro a ha
  obtain ⟨⟨c, hc⟩, hca⟩ := (Submodule.mem_torsion_iff a).1 ha
  have hc0 : c ≠ 0 := nonZeroDivisors.ne_zero hc
  have hinj : toA₂ k c ≠ 0 := by
    intro h0
    -- evaluate at `x = T, y = 1`: then `aeval (T)` recovers `c`.
    let φ : A₂ k →ₐ[k] Polynomial k := aeval ![Polynomial.X, 1]
    have : φ.comp (toA₂ k) = AlgHom.id k _ := by
      apply Polynomial.algHom_ext
      simp [toA₂, φ]
    have h1 := congrArg (fun f => f c) this
    simp only [AlgHom.comp_apply, AlgHom.id_apply, h0, map_zero] at h1
    exact hc0 h1.symm
  have : toA₂ k c * a = 0 := hca
  exact (mul_eq_zero.mp this).resolve_left hinj

/-- **Remark 11.11**: `X^0 → Y^0` is not flat. -/
theorem rem1111_not_flat :
    letI := (toQuot k).toAlgebra
    ¬ Module.Flat (Polynomial k) (A₂ k ⧸ J₂ k) := by
  letI := (toQuot k).toAlgebra
  intro hf
  haveI : Nontrivial (A₂ k ⧸ J₂ k) := Ideal.Quotient.nontrivial_iff.mpr
    ((Ideal.ne_top_iff_one _).mpr (one_notMem k))
  have hX : IsRegular (Polynomial.X : Polynomial k) :=
    (isRegular_iff_ne_zero').2 Polynomial.X_ne_zero
  have hreg := Module.Flat.isSMulRegular_of_isRegular (M := A₂ k ⧸ J₂ k) hX
  have h1 : (Polynomial.X : Polynomial k) • (1 : A₂ k ⧸ J₂ k) = 0 := by
    rw [Algebra.smul_def, mul_one]
    change Ideal.Quotient.mk (J₂ k) (toA₂ k Polynomial.X) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    simpa [toA₂] using (J₂ k).mul_mem_left _ (y_mem k)
  have h2 : (Polynomial.X : Polynomial k) • (0 : A₂ k ⧸ J₂ k) = 0 := smul_zero _
  exact one_ne_zero (hreg (h1.trans h2.symm))

end AlgMag.Final

#print axioms AlgMag.Final.rem1111_flat
#print axioms AlgMag.Final.rem1111_not_flat
