import Mathlib.LinearAlgebra.RootSystem.Basic
import Mathlib.Basic.Real.Basic

/-!
# Independent proof of Thm 15.22: the classical inputs (R1), (R2) and the definition (TP)

Setting: a root datum, i.e. a Mathlib `RootPairing ι ℤ M N` (`M` = character lattice,
`N = M^∨`, coroots in `N`, pairing `P.coroot' i : M →ₗ[ℤ] ℤ`).

Points of `M^∨ ⊗ ℝ` are modelled as additive maps `M →+ ℝ` (equal to `M^∨ ⊗ ℝ` for `M` free of
finite rank). An element `w : M ≃ₗ[ℤ] M` acts on them contragrediently: `x ↦ x ∘ w⁻¹`.
-/

namespace AlgMag.Torsion

open Set

variable {ι M N : Type*} [AddCommGroup M] [AddCommGroup N] (P : RootPairing ι ℤ M N)

namespace RD

/-- The coroot `α_i^∨` as a point of `M^∨ ⊗ ℝ`. -/
def corootR (i : ι) : M →+ ℝ :=
  (Int.castAddHom ℝ).comp (P.coroot' i).toAddMonoidHom

/-- Contragredient action `x ↦ x ∘ w⁻¹`. -/
def actPt (w : M ≃ₗ[ℤ] M) (x : M →+ ℝ) : M →+ ℝ :=
  x.comp w.symm.toLinearMap.toAddMonoidHom

/-- The affine reflection `s_{α_i,k}(y) = y - (⟨α_i, y⟩ - k) α_i^∨`. -/
def affRefl (i : ι) (k : ℤ) (y : M →+ ℝ) : M →+ ℝ :=
  y - (y (P.root i) - k) • corootR P i

/-- Reflections `s_α`, `α ∈ Ψ`. -/
def refls (Ψ : Set M) : Set (M ≃ₗ[ℤ] M) := {w | ∃ i, P.root i ∈ Ψ ∧ P.reflection i = w}

/-- `W(Ψ) = ⟨s_α | α ∈ Ψ⟩`. -/
def W (Ψ : Set M) : Subgroup (M ≃ₗ[ℤ] M) := Subgroup.closure (refls P Ψ)

/-- `ℤΨ^∨` as a subgroup of `M^∨ ⊗ ℝ`. -/
def corootLattR (Ψ : Set M) : AddSubgroup (M →+ ℝ) :=
  AddSubgroup.closure {y | ∃ i, P.root i ∈ Ψ ∧ corootR P i = y}

/-- `Ψ` is a subsystem: `Ψ ⊆ Φ` and `s_α(Ψ) ⊆ Ψ` for `α ∈ Ψ`. -/
def IsSubsystem (Ψ : Set M) : Prop :=
  Ψ ⊆ range P.root ∧ ∀ i j, P.root i ∈ Ψ → P.root j ∈ Ψ → P.reflection i (P.root j) ∈ Ψ

end RD

open RD

/-- **(R1)** [Steinberg 1964, *Differential equations invariant under finite reflection groups*,
Thm 1.5]: "the subgroup of a finite reflection group fixing pointwise a subset of the space is
generated by the reflections it contains". Stated literally for `W(Ψ)`, `Ψ` a subsystem, acting
on `M^∨ ⊗ ℝ`: an element of `W(Ψ)` fixing `S` pointwise is a product of reflections `s_α`,
`α ∈ Ψ`, with `⟨α, x⟩ = 0` for all `x ∈ S` (these are exactly the reflections of `W(Ψ)` fixing `S`). -/
def HypR1 : Prop :=
  ∀ Ψ : Set M, IsSubsystem P Ψ → ∀ S : Set (M →+ ℝ), ∀ w ∈ W P Ψ,
    (∀ x ∈ S, actPt w x = x) →
      w ∈ Subgroup.closure {v | ∃ i, P.root i ∈ Ψ ∧ (∀ x ∈ S, x (P.root i) = 0) ∧
        P.reflection i = v}

/-- **(R2)** [Bourbaki, *Lie* V §3 no. 3 Prop. 1 and VI §2 no. 1 (affine Weyl group
`W_a = ℤΨ^∨ ⋊ W(Ψ)`)]: "the stabiliser of a point `x` in the affine Weyl group is generated by
the affine reflections it contains, namely the `s_{α,k}` with `⟨α, x⟩ = k`". Stated literally:
if the affine map `y ↦ w·y + t` (`w ∈ W(Ψ)`, `t ∈ ℤΨ^∨`) fixes `x`, it is a composite of
affine reflections `s_{α,k}`, `α ∈ Ψ`, `k ∈ ℤ`, with `⟨α, x⟩ = k`. -/
def HypR2 : Prop :=
  ∀ Ψ : Set M, IsSubsystem P Ψ → ∀ x : M →+ ℝ, ∀ w ∈ W P Ψ, ∀ t ∈ corootLattR P Ψ,
    actPt w x + t = x →
      ∃ l : List (ι × ℤ), (∀ q ∈ l, P.root q.1 ∈ Ψ ∧ x (P.root q.1) = q.2) ∧
        (fun y => actPt w y + t) = (l.map fun q => affRefl P q.1 q.2).foldr (· ∘ ·) id

/-- `ℤΨ^∨ ⊆ N`. -/
def corootLatt (Ψ : Set M) : Submodule ℤ N :=
  Submodule.span ℤ {y | ∃ i, P.root i ∈ Ψ ∧ P.coroot i = y}

/-- `Ψ` integrally closed: `Ψ = Φ ∩ ℤΨ`. -/
def IsIntClosed (Ψ : Set M) : Prop :=
  Ψ = range P.root ∩ (Submodule.span ℤ Ψ : Set M)

/-- **Definition (TP)** (notes Def. 1.3): `p` is a torsion prime if for some integrally closed
`Ψ ⊆ Φ`, `M^∨/ℤΨ^∨` has an element of order `p` (equivalently, by Cauchy, `p` divides the order
of its finite torsion subgroup). -/
def IsTP (p : ℕ) : Prop :=
  p.Prime ∧ ∃ Ψ : Set M, IsIntClosed P Ψ ∧
    ∃ c : N, c ∉ corootLatt P Ψ ∧ (p : ℤ) • c ∈ corootLatt P Ψ

end AlgMag.Torsion
