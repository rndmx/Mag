import AlgMag.Torsion.Cor34
import AlgMag.Reductive.TorsionPrimes

/-!
# Theorem 15.22 (independent proof), final assembly

Setting: `P : RootPairing ι ℤ M N`, `ι` finite, `M` free of finite rank, hypotheses `HypR1 P`, `HypR2 P`.
`W` is the subgroup `W(Φ)` of `Aut M` generated by the reflections, acting on `M`.

`torsion_final`: `IsTP P p` iff some join-irreducible (non-redundant) Weyl magnet `Z_w` has `w` of
`p`-power order; moreover for `IsTP P p` there is such a `w` with `Φ ∩ Z_w = ∅` and `W_{Z_w}` a
`p`-group. Non-redundant means `Z_w ≠ ℤ(Φ ∩ Z_w) + Σ{Z_v : Z_v ⊊ Z_w}` (`Rooted.weylMagnetLower`).

The minimality argument (positive system of `R_w`, `ρ` argument) is `stepA`/`stepB`/
`posSystemExists` from `AlgMag.Reductive.TorsionPrimes`, which are proved for an abstract finite
group acting on `M` with no extra hypothesis; the hypotheses `hSt`/`hLevi` of
`Reductive.Torsion.torsion_primes` are NOT used: they are replaced by `prop41'` and `prop33`.
-/

namespace AlgMag.Torsion

open Set RD Classical AlgMag.Reductive AlgMag.Reductive.Torsion

variable {ι M N : Type*} [AddCommGroup M] [AddCommGroup N] [Fintype ι]
  (P : RootPairing ι ℤ M N)

namespace FinalAux

/-- `W(Φ)` as a type. -/
abbrev WΦ := ↥(RD.W P (range P.root))

lemma refl_mem (i : ι) : P.reflection i ∈ RD.W P (range P.root) :=
  Subgroup.subset_closure ⟨i, mem_range_self i, rfl⟩

/-- `α ↦ s_α` (and `1` off the roots). -/
noncomputable def reflW (α : M) : WΦ P :=
  if h : ∃ i, P.root i = α then ⟨P.reflection h.choose, refl_mem P _⟩ else 1

lemma reflW_root (i : ι) : reflW P (P.root i) = ⟨P.reflection i, refl_mem P i⟩ := by
  have h : ∃ j, P.root j = P.root i := ⟨i, rfl⟩
  rw [reflW, dif_pos h]
  apply Subtype.ext
  show P.reflection h.choose = P.reflection i
  rw [P.root.injective h.choose_spec]

lemma smul_def (v : WΦ P) (m : M) : v • m = v.1 m := rfl

lemma good {v : M ≃ₗ[ℤ] M} (hv : v ∈ RD.W P (range P.root)) :
    ∀ i, ∃ j, P.root j = v (P.root i) ∧ v * P.reflection i * v⁻¹ = P.reflection j := by
  induction hv using Subgroup.closure_induction_left with
  | one => intro i; exact ⟨i, rfl, by simp⟩
  | mul_left x hx y hy ih =>
    obtain ⟨k, -, rfl⟩ := hx
    intro i
    obtain ⟨j, hj1, hj2⟩ := ih i
    refine ⟨P.reflectionPerm k j, ?_, ?_⟩
    · rw [P.root_reflectionPerm, hj1]; rfl
    · rw [P.reflection_reflectionPerm, ← hj2]
      simp only [mul_inv_rev, P.reflection_inv, mul_assoc]
  | inv_mul_cancel x hx y hy ih =>
    obtain ⟨k, -, rfl⟩ := hx
    intro i
    obtain ⟨j, hj1, hj2⟩ := ih i
    refine ⟨P.reflectionPerm k j, ?_, ?_⟩
    · rw [P.root_reflectionPerm, hj1, P.reflection_inv]; rfl
    · rw [P.reflection_reflectionPerm, ← hj2]
      simp only [mul_inv_rev, P.reflection_inv, inv_inv, mul_assoc]

lemma hconj (v : WΦ P) (α : M) (hα : α ∈ range P.root) :
    v * reflW P α * v⁻¹ = reflW P (v • α) := by
  obtain ⟨i, rfl⟩ := hα
  obtain ⟨j, hj1, hj2⟩ := good P v.2 i
  rw [smul_def, ← hj1, reflW_root, reflW_root]
  exact Subtype.ext (by simp only [Subgroup.coe_mul, Subgroup.coe_inv]; exact hj2)

lemma hΦW (v : WΦ P) (α : M) (hα : α ∈ range P.root) : v • α ∈ range P.root := by
  obtain ⟨i, rfl⟩ := hα
  obtain ⟨j, hj1, -⟩ := good P v.2 i
  exact ⟨j, by rw [smul_def, hj1]⟩

lemma hneg (α : M) (hα : α ∈ range P.root) : -α ∈ range P.root := by
  obtain ⟨i, rfl⟩ := hα
  exact ⟨P.reflectionPerm i i, by simp⟩

lemma hBrefl (α : M) (hα : α ∈ range P.root) (x : M) : ∃ c : ℤ,
    x - reflW P α • x = c • α ∧ P.RootForm α α * c = 2 * P.RootForm α x := by
  obtain ⟨i, rfl⟩ := hα
  refine ⟨P.coroot' i x, ?_, rootForm_self_mul_coroot P i x⟩
  rw [reflW_root, smul_def]
  show x - P.reflection i x = _
  rw [P.reflection_apply]; abel

lemma hBpos (α : M) (hα : α ∈ range P.root) : 0 < P.RootForm α α := by
  obtain ⟨i, rfl⟩ := hα
  exact rootForm_root_self_pos P i

lemma hfaith (w : WΦ P) (h : ∀ m : M, w • m = m) : w = 1 :=
  Subtype.ext (LinearEquiv.ext h)

lemma map_reflGroup {S : Set M} (hS : S ⊆ range P.root) :
    (reflGroup (reflW P) S).map (RD.W P (range P.root)).subtype = RD.W P S := by
  rw [reflGroup, MonoidHom.map_closure]
  show Subgroup.closure _ = Subgroup.closure (refls P S)
  congr 1
  ext g
  constructor
  · rintro ⟨_, ⟨α, hα, rfl⟩, rfl⟩
    obtain ⟨i, rfl⟩ := hS hα
    exact ⟨i, hα, by rw [reflW_root]; rfl⟩
  · rintro ⟨i, hi, rfl⟩
    exact ⟨_, ⟨_, hi, rfl⟩, by rw [reflW_root]; rfl⟩

lemma mem_reflGroup_iff {S : Set M} (hS : S ⊆ range P.root) (v : WΦ P) :
    v ∈ reflGroup (reflW P) S ↔ v.1 ∈ RD.W P S := by
  rw [← map_reflGroup P hS]
  exact (Subgroup.mem_map_iff_mem (RD.W P (range P.root)).subtype_injective).symm

lemma rw_eq (v : WΦ P) : Rw (range P.root) v = range P.root ∩ Zset v.1 := by
  ext z
  simp only [Rw, mem_inter_iff, SetLike.mem_coe, mem_Z]
  constructor <;> rintro ⟨h1, h2⟩ <;> exact ⟨h2, h1⟩

lemma mem_reflGroup_Rw (v : WΦ P) :
    v ∈ reflGroup (reflW P) (Rw (range P.root) v) ↔ v.1 ∈ RD.W P (range P.root ∩ Zset v.1) := by
  rw [mem_reflGroup_iff P (fun _ h => h.2) v, rw_eq]

end FinalAux

open FinalAux

instance FinalAux.finiteWΦ : Finite (WΦ P) := RD.W_finite P

theorem torsion_final [Module.Free ℤ M] [Module.Finite ℤ M] (hR1 : HypR1 P) (hR2 : HypR2 P)
    {p : ℕ} (hp : p.Prime) :
    (IsTP P p ↔ ∃ w : WΦ P, (∃ n, w ^ (p ^ n) = 1) ∧
        Z M w ≠ Rooted.weylMagnetLower (range P.root) (actOf M (WΦ P)) w) ∧
    (IsTP P p → ∃ w : WΦ P, (∃ n, w ^ (p ^ n) = 1) ∧
        Z M w ≠ Rooted.weylMagnetLower (range P.root) (actOf M (WΦ P)) w ∧
        Rw (range P.root) w = ∅ ∧ IsPGroup p (weylPart (W := WΦ P) (Z M w))) := by
  haveI : IsAddTorsionFree M := ⟨fun n hn a b hab => by
    have h : ((n : ℤ)) • (a - b) = 0 := by
      simp only [smul_sub, natCast_zsmul]; exact sub_eq_zero.2 hab
    exact sub_eq_zero.1 (tf_of_free _ _ (by exact_mod_cast hn) h)⟩
  have hΦfin : (range P.root).Finite := Set.finite_range _
  have hrefl : ∀ α ∈ range P.root, ∀ m : M, m - reflW P α • m ∈ AddSubgroup.zmultiples α :=
    fun α hα m => by
      obtain ⟨c, hc, -⟩ := hBrefl P α hα m
      rw [hc]; exact ⟨c, rfl⟩
  have hpg : ∀ v, IsCand (range P.root) (reflW P) p v → ∀ u ∈ weylPart (W := WΦ P) (Z M v),
      ∃ k, u ^ (p ^ k) ∈ reflGroup (reflW P) (Rw (range P.root) v) := by
    rintro v ⟨⟨n, hn⟩, -⟩ u hu
    obtain ⟨b, -, hb⟩ := (Nat.dvd_prime_pow hp).1 (orderOf_dvd_of_pow_eq_one hn)
    have hb' : orderOf v.1 = p ^ b := by rw [Subgroup.orderOf_coe]; exact hb
    obtain ⟨k, hk⟩ := (RD.prop33 hR1 hR2 hp (ZW v.1) (prim_ZW tf_of_free hb') u.1 u.2
      (fun m => mem_Z.1 (hu m))).1
    refine ⟨k, (mem_reflGroup_iff P (fun _ h => h.2) _).2 ?_⟩
    rw [rw_eq, Subgroup.coe_pow]
    exact hk
  have hmore : IsTP P p → ∃ w : WΦ P, (∃ n, w ^ (p ^ n) = 1) ∧
      Z M w ≠ Rooted.weylMagnetLower (range P.root) (actOf M (WΦ P)) w ∧
      Rw (range P.root) w = ∅ ∧ IsPGroup p (weylPart (W := WΦ P) (Z M w)) := by
    intro ht
    obtain ⟨w0, b, hw0W, -, hord, hn⟩ := prop41' P ht
    have hord' : orderOf (⟨w0, hw0W⟩ : WΦ P) = p ^ b := by
      rw [← Subgroup.orderOf_coe]; exact hord
    have hcand : IsCand (range P.root) (reflW P) p (⟨w0, hw0W⟩ : WΦ P) :=
      ⟨⟨b, by rw [← hord']; exact pow_orderOf_eq_one _⟩, fun h => hn ((mem_reflGroup_Rw P (⟨w0, hw0W⟩ : WΦ P)).1 h)⟩
    obtain ⟨w, hw, hmin⟩ := exists_min_cand ⟨_, hcand⟩
    have hR := stepA hrefl (hneg P) hp hΦfin hpg hw
      (posSystemExists P.RootForm (hΦW P) hΦfin (hBpos P) (hBrefl P) w) hmin
    obtain ⟨hne, hC⟩ := stepB (hfaith P) hpg hw hR hmin
    exact ⟨w, hw.1, hne, hR, fun g => (hC g.1 g.2).imp fun k hk => Subtype.ext (by simpa using hk)⟩
  refine ⟨⟨fun ht => ?_, ?_⟩, hmore⟩
  · obtain ⟨w, hw, hne, -⟩ := hmore ht
    exact ⟨w, hw, hne⟩
  · rintro ⟨w, ⟨n, hn⟩, hne⟩
    have hwH := not_mem_reflGroup_of_nonredundant hrefl (hneg P) hne
    obtain ⟨b, -, hb⟩ := (Nat.dvd_prime_pow hp).1 (orderOf_dvd_of_pow_eq_one hn)
    have hb' : orderOf w.1 = p ^ b := by rw [Subgroup.orderOf_coe]; exact hb
    refine (isTP_iff_candidate hR1 hR2 hp).2 ⟨w.1, b, w.2, ?_, hb', ?_⟩
    · rcases Nat.eq_zero_or_pos b with rfl | h
      · exfalso; apply hwH
        rw [pow_zero, orderOf_eq_one_iff] at hb
        rw [hb]; exact one_mem _
      · exact h
    · exact fun h => hwH ((mem_reflGroup_Rw P w).2 h)

end AlgMag.Torsion
