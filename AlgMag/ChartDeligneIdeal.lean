import AlgMag.ChartGraded

/-!
# The ideal `a` of the setup of §4 of the chart-lemma proof

`a := ⊕ lim (a_n)_d`, in the form: `A n ⊂ C` is the preimage of `a_n = J·C/mⁿ`. Then `a + mⁿ = A n`.
-/

namespace AlgMag.ChartGraded

open DirectSum

variable {M C : Type*} [AddCommGroup M] [DecidableEq M] [CommRing C]
  {𝒞 : M → AddSubgroup C} [GradedRing 𝒞] {m : Ideal C}

/-- The ideal generated by the homogeneous elements lying in every `A n`. -/
def limIdeal (𝒞 : M → AddSubgroup C) (A : ℕ → Ideal C) : Ideal C :=
  Ideal.span {c | (∃ d, c ∈ 𝒞 d) ∧ ∀ n, c ∈ A n}

lemma limIdeal_le (A : ℕ → Ideal C) (n : ℕ) : limIdeal 𝒞 A ≤ A n :=
  Ideal.span_le.2 fun _ hc => hc.2 n

/-- **§4, setup: `a + mⁿ/mⁿ = a_n`.** -/
theorem limIdeal_sup (hP : IsCompletePair 𝒞 m) (A : ℕ → Ideal C)
    (hm : ∀ n, m ^ n ≤ A n) (hh : ∀ n, (A n).IsHomogeneous 𝒞)
    (hs : ∀ n, A (n + 1) ⊔ m ^ n = A n) (n : ℕ) : limIdeal 𝒞 A ⊔ m ^ n = A n := by
  classical
  refine le_antisymm (sup_le (limIdeal_le A n) (hm n)) ?_
  have hanti : ∀ k r, A (k + r) ≤ A k := by
    intro k r
    induction r with
    | zero => exact le_rfl
    | succ r ih =>
      refine le_trans ?_ ih
      rw [← add_assoc, ← hs (k + r)]
      exact le_sup_left
  have hhomp : ∀ n, (m ^ n).IsHomogeneous 𝒞 := fun n => pow_homogeneous hP.hom n
  -- homogeneous step
  have hstep : ∀ (k : ℕ) (d : M) (z : C), z ∈ 𝒞 d → z ∈ A k →
      ∃ z' ∈ 𝒞 d, z' ∈ A (k + 1) ∧ z' - z ∈ m ^ k := by
    intro k d z hzd hz
    rw [← hs k, Submodule.mem_sup] at hz
    obtain ⟨u, hu, v, hv, rfl⟩ := hz
    refine ⟨(decompose 𝒞 u d : C), SetLike.coe_mem _, hh (k + 1) d hu, ?_⟩
    have e : (decompose 𝒞 (u + v) d : C) = u + v := decompose_of_mem_same 𝒞 hzd
    have e2 : (decompose 𝒞 (u + v) d : C) = (decompose 𝒞 u d : C) + (decompose 𝒞 v d : C) := by
      rw [decompose_add]; rfl
    have : (decompose 𝒞 u d : C) - (u + v) = -(decompose 𝒞 v d : C) := by
      rw [← e]; rw [e2]; ring
    rw [this]
    exact neg_mem (hhomp k d hv)
  -- reduce to homogeneous elements
  intro w hw
  rw [← DirectSum.sum_support_decompose 𝒞 w]
  refine sum_mem fun d _ => ?_
  have hzd : (decompose 𝒞 w d : C) ∈ A n := hh n d hw
  set z : C := (decompose 𝒞 w d : C) with hz
  have hzm : z ∈ 𝒞 d := SetLike.coe_mem _
  -- the sequence from `n` on
  let seq : (r : ℕ) → {y : C // y ∈ 𝒞 d ∧ y ∈ A (n + r)} := fun r =>
    Nat.rec ⟨z, hzm, hzd⟩ (fun r y =>
      ⟨(hstep (n + r) d y.1 y.2.1 y.2.2).choose,
        (hstep (n + r) d y.1 y.2.1 y.2.2).choose_spec.1,
        (hstep (n + r) d y.1 y.2.1 y.2.2).choose_spec.2.1⟩) r
  have hseq : ∀ r, ((seq (r + 1)).1 - (seq r).1) ∈ m ^ (n + r) := fun r =>
    (hstep (n + r) d (seq r).1 (seq r).2.1 (seq r).2.2).choose_spec.2.2
  let y : ℕ → C := fun k => if k ≤ n then z else (seq (k - n)).1
  have hy : ∀ k, y k ∈ 𝒞 d := fun k => by
    simp only [y]; split_ifs
    · exact hzm
    · exact (seq _).2.1
  have hyr : ∀ r, y (n + r) = (seq r).1 := fun r => by
    simp only [y]
    by_cases h : n + r ≤ n
    · have : r = 0 := by omega
      subst this; simp; rfl
    · rw [if_neg h, Nat.add_sub_cancel_left]
  have hc : ∀ k, y (k + 1) - y k ∈ m ^ k := by
    intro k
    by_cases hk : k < n
    · have h1 : y (k + 1) = z := by simp only [y]; rw [if_pos (by omega)]
      have h2 : y k = z := by simp only [y]; rw [if_pos (by omega)]
      rw [h1, h2, sub_self]; exact zero_mem _
    · obtain ⟨r, rfl⟩ := Nat.exists_eq_add_of_le (not_lt.1 hk)
      rw [show n + r + 1 = n + (r + 1) from rfl, hyr, hyr]
      exact hseq r
  obtain ⟨c, hcd, hcn⟩ := hP.exists_lim d y hy hc
  have hcA : ∀ k, c ∈ A k := by
    intro k
    have h1 : c - y (n + k) ∈ m ^ (n + k) := hcn _
    have h2 : y (n + k) ∈ A (n + k) := by rw [hyr]; exact (seq k).2.2
    have h3 : c ∈ A (n + k) := by
      have := add_mem (hm _ h1) h2
      simpa using this
    rw [add_comm] at h3
    exact hanti k n h3
  have hcl : c ∈ limIdeal 𝒞 A := Ideal.subset_span ⟨⟨d, hcd⟩, hcA⟩
  have hyn : y n = z := by simp only [y]; rw [if_pos le_rfl]
  have h4 : c - z ∈ m ^ n := by rw [← hyn]; exact hcn n
  have : z = c - (c - z) := by ring
  rw [this]
  exact Submodule.mem_sup.2 ⟨c, hcl, -(c - z), neg_mem h4, by ring⟩

/-- `a` and its powers are homogeneous. -/
theorem limIdeal_pow_homogeneous (A : ℕ → Ideal C) (k : ℕ) :
    (limIdeal 𝒞 A ^ k).IsHomogeneous 𝒞 :=
  pow_homogeneous (Ideal.homogeneous_span 𝒞 _ fun _ hc => hc.1) k

end AlgMag.ChartGraded

#print axioms AlgMag.ChartGraded.limIdeal_sup
