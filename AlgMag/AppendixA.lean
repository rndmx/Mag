/-!
# Appendix A (by M. Romagny): fixed points and étale equivariant morphisms

Mayeux, *Algebraic Magnetism*, Semigroup Forum 113 (2026) 126–201, Appendix A, for the group
schemes `D(M)_S`.

The paper's uses of Theorem A.1 are Proposition 6.3 (`M = ℤ^r`) and Theorem 6.8, where the group is
`D(M/Z)`; this file works with diagonalizable groups only.

## Main results

* `AlgMag.lemmaA4`: **Lemma A.4**.
* `AlgMag.isFPR_of_hasOpenEqualizers`, `AlgMag.isFPR_of_etale`: the assertion of **Theorem A.1** that
  étale equivariant morphisms are FPR, for `D(M)` with irreducible fibres.
* `AlgMag.irreducibleFibres_of_torsionFree`, `AlgMag.irreducibleFibres_of_torsionResidue`: the
  hypothesis on fibres holds for `M` torsion-free, and if `D(M)` has infinitesimal finite part.
* `AlgMag.prop63`: **Proposition 6.3**.

The closedness of `X^G → X` in Theorem A.1, Lemmas A.3 and A.5, and Theorem A.2 are not treated here.

The proof of the FPR assertion is not the one of the paper: the stabilizer of a point is an open
subgroup functor of `D(M)_T`, and an open subgroup of a group with irreducible fibres is everything.
It uses neither Lemma A.5, nor the closedness of fixed points, nor limit arguments, and needs no
noetherian or quasi-separatedness assumption.
-/

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry

universe u

namespace AlgMag

/-! ### Lemma A.4 -/

/-- **Lemma A.4.** Let `R → A` be a ring map and `x : Fin d → A`. Let `I n` be the ideal generated by
the `n`-th powers of the `x i`. If `A / I 1` is finite over `R`, so is `A / I n` for all `n ≥ 1`. -/
theorem lemmaA4 {R A : Type*} [CommRing R] [CommRing A] [Algebra R A] {d : ℕ} (x : Fin d → A)
    (I : ℕ → Ideal A) (hI : ∀ n, I n = Ideal.span (Set.range fun i => x i ^ n))
    (h1 : Module.Finite R (A ⧸ I 1)) (n : ℕ) (hn : 1 ≤ n) : Module.Finite R (A ⧸ I n) := by
  have hxn : ∀ i, x i ^ n ∈ I n := fun i => by
    rw [hI n]; exact Ideal.subset_span ⟨i, rfl⟩
  have hx1 : ∀ i, x i ∈ I 1 := fun i => by
    rw [hI 1]; exact Ideal.subset_span ⟨i, by simp⟩
  have hle : I n ≤ I 1 := by
    conv_lhs => rw [hI n]
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact Ideal.pow_mem_of_mem _ (hx1 i) n hn
  let f : (A ⧸ I n) →ₐ[R] A ⧸ I 1 := Ideal.Quotient.factorₐ R hle
  have hf : Function.Surjective f := Ideal.Quotient.factor_surjective hle
  have hker : RingHom.ker f = (I 1).map (Ideal.Quotient.mk (I n)) := by
    ext y
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective]
    constructor
    · intro h
      exact ⟨y, Ideal.Quotient.eq_zero_iff_mem.mp h, rfl⟩
    · rintro ⟨z, hz, e⟩
      have : y - z ∈ I n := Ideal.Quotient.eq.mp e.symm
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (by
        have := (I 1).add_mem (hle this) hz
        simpa using this)
  have hgen : (I 1).map (Ideal.Quotient.mk (I n)) ≤ nilradical (A ⧸ I n) := by
    rw [Ideal.map_le_iff_le_comap]
    conv_lhs => rw [hI 1]
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    refine ⟨n, ?_⟩
    have e : (Ideal.Quotient.mk (I n)) (x i ^ 1) ^ n = 0 := by
      rw [pow_one, ← map_pow]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (hxn i)
    exact e
  refine Module.finite_of_surjective_of_ker_le_nilradical f hf (hker ▸ hgen) ?_
  rw [hker, hI 1]
  have h : (Ideal.span (Set.range fun i => x i ^ 1)).FG :=
    Submodule.fg_span (Set.finite_range fun i => x i ^ 1)
  exact h.map _

/-! ### Irreducibility of the fibres of `D(M)` -/

/-- The fibres of `D(M)` over `S` are irreducible, after any field extension. -/
def IrreducibleFibres (M : Type u) [AddCommGroup M] (S : Scheme.{u}) : Prop :=
  ∀ (R : Type u) [CommRing R], IsField R → (Spec (.of R) ⟶ S) →
    IrreducibleSpace (PrimeSpectrum (AddMonoidAlgebra R M))

theorem irreducibleFibres_of_torsionFree (M : Type u) [AddCommGroup M] [AddGroup.FG M]
    [IsAddTorsionFree M] (S : Scheme.{u}) : IrreducibleFibres M S := by
  intro R _ hR _
  let := hR.toField
  infer_instance

/-- `R[M]` has irreducible spectrum if `R` is a field of exponential characteristic `q` and the
torsion of `M` is killed by powers of `q`: `R[M] → R[M/torsion]` has nil kernel and target a domain. -/
theorem irreducibleSpace_of_torsion_expChar (M : Type u) [AddCommGroup M] [AddGroup.FG M]
    (R : Type u) [Field R] (q : ℕ) [ExpChar R q]
    (h : ∀ m : M, IsOfFinAddOrder m → ∃ N : ℕ, q ^ N • m = 0) :
    IrreducibleSpace (PrimeSpectrum (AddMonoidAlgebra R M)) := by
  classical
  let T := AddCommGroup.torsion M
  let mk : M →+ M ⧸ T := QuotientAddGroup.mk' T
  have hmk : Function.Surjective mk := QuotientAddGroup.mk'_surjective T
  let π : AddMonoidAlgebra R M →+* AddMonoidAlgebra R (M ⧸ T) :=
    AddMonoidAlgebra.mapDomainRingHom R mk
  have : ExpChar (AddMonoidAlgebra R M) q :=
    expChar_of_injective_algebraMap (R := R) (algebraMap R (AddMonoidAlgebra R M)).injective q
  have hnil : ∀ x, π x = 0 → x ∈ nilradical (AddMonoidAlgebra R M) := by
    intro x hx
    let σ := Function.surjInv hmk
    have hσ : ∀ y, mk (σ y) = y := Function.surjInv_eq hmk
    have hsub : ∀ z : AddMonoidAlgebra R M,
        z - AddMonoidAlgebra.mapDomain σ (π z) ∈ nilradical (AddMonoidAlgebra R M) := by
      intro z
      induction z using AddMonoidAlgebra.induction_linear with
      | zero => simp
      | add a b ha hb =>
        have := add_mem ha hb
        rw [map_add, AddMonoidAlgebra.mapDomain_add]
        convert this using 1
        abel
      | single m c =>
        have hπ : π (AddMonoidAlgebra.single m c) = AddMonoidAlgebra.single (mk m) c := by
          simp [π]
        rw [hπ, AddMonoidAlgebra.mapDomain_single]
        have hd : IsOfFinAddOrder (m - σ (mk m)) := by
          have : m - σ (mk m) ∈ T := by
            have e : mk (m - σ (mk m)) = 0 := by rw [map_sub, hσ, sub_self]
            exact (QuotientAddGroup.eq_zero_iff _).mp e
          exact this
        obtain ⟨N, hN⟩ := h _ hd
        refine ⟨q ^ N, ?_⟩
        have e : (AddMonoidAlgebra.single m c - AddMonoidAlgebra.single (σ (mk m)) c :
            AddMonoidAlgebra R M) ^ q ^ N = 0 := by
          rw [sub_pow_expChar_pow, AddMonoidAlgebra.single_pow, AddMonoidAlgebra.single_pow]
          have e2 : q ^ N • m = q ^ N • σ (mk m) := by
            rw [smul_sub, sub_eq_zero] at hN
            exact hN
          rw [e2, sub_self]
        exact e
    have := hsub x
    rwa [hx, AddMonoidAlgebra.mapDomain_zero, sub_zero] at this
  rw [PrimeSpectrum.irreducibleSpace_iff_isPrime_nilradical]
  refine ⟨?_, ?_⟩
  · rw [Ideal.ne_top_iff_one]
    rintro ⟨n, hn⟩
    rw [one_pow] at hn
    exact one_ne_zero hn
  · intro a b hab
    have hz : π a * π b = 0 := by
      obtain ⟨n, hn⟩ := hab
      have : (π (a * b)) ^ n = 0 := by rw [← map_pow, hn, map_zero]
      rw [← map_mul]
      exact IsNilpotent.eq_zero ⟨n, this⟩
    rcases mul_eq_zero.mp hz with h0 | h0
    · exact Or.inl (hnil a h0)
    · exact Or.inr (hnil b h0)

/-- The hypothesis of **Theorem A.2 (ii)** in the form its proof uses: writing `D(M) = T × F` with `T`
a split torus and `F` finite, `F` is infinitesimal at every point of `S`, i.e. at every point the
torsion of `M` is killed by a power of the residue exponential characteristic. -/
def TorsionResidue (M : Type u) [AddCommGroup M] (S : Scheme.{u}) : Prop :=
  ∀ (s : S) (q : ℕ), ExpChar (S.residueField s) q → ∀ m : M, IsOfFinAddOrder m → ∃ N : ℕ, q ^ N • m = 0

theorem irreducibleFibres_of_torsionResidue (M : Type u) [AddCommGroup M] [AddGroup.FG M]
    (S : Scheme.{u}) (h : TorsionResidue M S) : IrreducibleFibres M S := by
  intro R _ hR t
  let := hR.toField
  let x := Scheme.SpecToEquivOfField R S t
  obtain ⟨q, hq⟩ := ExpChar.exists (S.residueField x.1)
  have hR' : ExpChar R q :=
    expChar_of_injective_ringHom (f := x.2.hom) x.2.hom.injective q
  exact irreducibleSpace_of_torsion_expChar M R q (h x.1 q hq)

/-- A finitely generated abelian group is countable. -/
theorem countable_of_fg (M : Type u) [AddCommGroup M] [AddGroup.FG M] : Countable M := by
  have : Module.Finite ℤ M := Module.Finite.iff_addGroup_fg.mpr inferInstance
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' ℤ M
  exact hf.countable

/-- `Spec ℤ[M]` is below any cutoff if `M` is countable. -/
theorem contains_zmon_of_countable {B : BigFppfSite.{u}} {S : Scheme.{u}} (hS : B.Contains S)
    (M : Type u) [AddCommMonoid M] [Countable M] : B.Contains (Spec (ZMon M)) := by
  refine Scheme.size_Spec_lt_of_mk_le B.aleph0_lt_cutoff B.cutoff_isStrongPrelimit _ hS ?_
  have hc : Countable (AddMonoidAlgebra (ULift.{u} ℤ) M) :=
    AddMonoidAlgebra.coeff_injective.countable
  refine (Cardinal.mk_le_aleph0 (α := AddMonoidAlgebra (ULift.{u} ℤ) M)).trans ?_
  exact (Scheme.aleph0_le_size S).trans (Cardinal.self_le_power _ Cardinal.one_le_aleph0)

/-! ### Open equalizers -/

section Site

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

local notation "SCH" => BigFppfOver.toScheme B S hS

/-- The conclusion of the openness of the diagonal of an étale morphism, in functorial form: two
points of `U` over `Y` with the same image in `X` agree exactly on an open of `Y`. -/
def HasOpenEqualizers {U X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : U ⟶ X) : Prop :=
  ∀ (Y : BigFppfOver B S hS) (a b : U.obj (op Y)), f.app _ a = f.app _ b →
    ∃ W : ((SCH).obj Y).Opens, ∀ (Y' : BigFppfOver B S hS) (r : Y' ⟶ Y),
      U.map r.op a = U.map r.op b ↔ Set.range ((SCH).map r) ⊆ W

/-- An étale representable morphism has open equalizers. -/
theorem hasOpenEqualizers_of_etale {U X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {f : U ⟶ X}
    (hf : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Etale.{u} : MorphismProperty Scheme.{u}) (SCH))) f) : HasOpenEqualizers f := by
  intro Y a b hab
  let g : yoneda.obj Y ⟶ X := yonedaEquiv.symm (f.app _ a)
  have hr := hf.rep
  let ia : yoneda.obj Y ⟶ U := yonedaEquiv.symm a
  let ib : yoneda.obj Y ⟶ U := yonedaEquiv.symm b
  have wa : ia ≫ f = yoneda.map (𝟙 Y) ≫ g := by
    apply yonedaEquiv.injective
    simp [ia, g, yonedaEquiv_comp]
  have wb : ib ≫ f = yoneda.map (𝟙 Y) ≫ g := by
    apply yonedaEquiv.injective
    simp [ib, g, yonedaEquiv_comp, hab]
  let sa := hr.lift ia (𝟙 Y) wa
  let sb := hr.lift ib (𝟙 Y) wb
  have hp : Etale ((SCH).map (hr.snd g)) := hf.property_snd g
  let p := (SCH).map (hr.snd g)
  have hsa : (SCH).map sa ≫ p = 𝟙 _ := by
    rw [← (SCH).map_comp, hr.lift_snd, (SCH).map_id]
  have hsb : (SCH).map sb ≫ p = 𝟙 _ := by
    rw [← (SCH).map_comp, hr.lift_snd, (SCH).map_id]
  let pr : (SCH).obj Y ⟶ pullback p p :=
    pullback.lift ((SCH).map sa) ((SCH).map sb) (by rw [hsa, hsb])
  refine ⟨pr ⁻¹ᵁ (pullback.diagonal p).opensRange, fun Y' r => ?_⟩
  have ha : yoneda.map (r ≫ sa) ≫ hr.fst g = yonedaEquiv.symm (U.map r.op a) := by
    rw [yoneda.map_comp, Category.assoc, hr.lift_fst, yonedaEquiv_symm_map]
    rfl
  have hb : yoneda.map (r ≫ sb) ≫ hr.fst g = yonedaEquiv.symm (U.map r.op b) := by
    rw [yoneda.map_comp, Category.assoc, hr.lift_fst, yonedaEquiv_symm_map]
    rfl
  have key : U.map r.op a = U.map r.op b ↔ r ≫ sa = r ≫ sb := by
    constructor
    · intro h
      refine hr.hom_ext (by rw [ha, hb, h]) ?_
      simp [sa, sb]
    · intro h
      apply yonedaEquiv.symm.injective
      rw [← ha, ← hb, h]
  rw [key]
  have hpf : pr ≫ pullback.fst p p = (SCH).map sa := pullback.lift_fst _ _ _
  have hps : pr ≫ pullback.snd p p = (SCH).map sb := pullback.lift_snd _ _ _
  constructor
  · intro h
    rintro _ ⟨y, rfl⟩
    refine ⟨(SCH).map (r ≫ sa) y, ?_⟩
    have e : (SCH).map (r ≫ sa) ≫ pullback.diagonal p = (SCH).map r ≫ pr := by
      apply pullback.hom_ext
      · rw [Category.assoc, pullback.diagonal_fst, Category.comp_id, Category.assoc, hpf,
          (SCH).map_comp]
      · rw [Category.assoc, pullback.diagonal_snd, Category.comp_id, Category.assoc, hps, h,
          (SCH).map_comp]
    change pullback.diagonal p ((SCH).map (r ≫ sa) y) = pr ((SCH).map r y)
    rw [← Scheme.Hom.comp_apply, e, Scheme.Hom.comp_apply]
  · intro h
    have hr' : Set.range ((SCH).map r ≫ pr) ⊆ Set.range (pullback.diagonal p) := by
      rintro _ ⟨y, rfl⟩
      exact h ⟨y, rfl⟩
    let l := IsOpenImmersion.lift (pullback.diagonal p) ((SCH).map r ≫ pr) hr'
    have hl : l ≫ pullback.diagonal p = (SCH).map r ≫ pr := IsOpenImmersion.lift_fac _ _ _
    have e1 : l = (SCH).map r ≫ (SCH).map sa := by
      have := hl =≫ pullback.fst p p
      rwa [Category.assoc, pullback.diagonal_fst, Category.comp_id, Category.assoc, hpf] at this
    have e2 : l = (SCH).map r ≫ (SCH).map sb := by
      have := hl =≫ pullback.snd p p
      rwa [Category.assoc, pullback.diagonal_snd, Category.comp_id, Category.assoc, hps] at this
    apply (SCH).map_injective
    rw [(SCH).map_comp, (SCH).map_comp, ← e1, ← e2]

/-! ### The universal point of `D(M)` -/

variable {M : Type u} [AddCommGroup M]

/-- The inverse of a point of `D(M)`. -/
noncomputable def APt.inv {U : (BigFppfOver B S hS)ᵒᵖ} (a : APt (fppfO B S hS) M U) : APt (fppfO B S hS) M U :=
  a.comp (invMonoidHom (α := Multiplicative M))

lemma APt.inv_mul {U : (BigFppfOver B S hS)ᵒᵖ} (a : APt (fppfO B S hS) M U) : APt.inv a * a = 1 := by
  refine MonoidHom.ext fun p => ?_
  change a p⁻¹ * a p = 1
  rw [← map_mul, inv_mul_cancel, map_one]

lemma APt.inv_res {U V : (BigFppfOver B S hS)ᵒᵖ} (f : U ⟶ V) (a : APt (fppfO B S hS) M U) :
    APt.res f (APt.inv a) = APt.inv (APt.res f a) := rfl

/-- The structure morphism `D(M)_T → T`. -/
noncomputable def gπ (hM : B.Contains (Spec (ZMon M))) (T : BigFppfOver B S hS) :
    monAffObj M hM T ⟶ T :=
  Over.homMk (ObjectProperty.homMk (MonAff.π M _)) rfl

/-- The universal point of `D(M)` over `D(M)_T`. -/
noncomputable def gc (hM : B.Contains (Spec (ZMon M))) (T : BigFppfOver B S hS) :
    APt (fppfO B S hS) M (op (monAffObj M hM T)) :=
  MonAff.coord M _

/-- The classifying morphism of a point of `D(M)`. -/
noncomputable def gLift (hM : B.Contains (Spec (ZMon M))) {T T' : BigFppfOver B S hS} (t : T' ⟶ T)
    (a : APt (fppfO B S hS) M (op T')) : T' ⟶ monAffObj M hM T :=
  Over.homMk (ObjectProperty.homMk (MonAff.homOf ((SCH).map t) a)) (by
    apply B.inclusion.map_injective
    have hw : (SCH).map t ≫ structMap T = structMap T' := congrArg (B.inclusion.map) (Over.w t)
    refine Eq.trans ?_ hw
    refine Eq.trans ?_ (MonAff.homOf_π_assoc _ a (structMap T))
    rfl)

lemma gLift_π (hM : B.Contains (Spec (ZMon M))) {T T' : BigFppfOver B S hS} (t : T' ⟶ T)
    (a : APt (fppfO B S hS) M (op T')) : gLift hM t a ≫ gπ hM T = t := by
  apply (SCH).map_injective
  rw [Functor.map_comp]
  exact MonAff.homOf_π _ _

lemma res_gLift (hM : B.Contains (Spec (ZMon M))) {T T' : BigFppfOver B S hS} (t : T' ⟶ T)
    (a : APt (fppfO B S hS) M (op T')) : APt.res (gLift hM t a).op (gc hM T) = a := by
  refine MonoidHom.ext fun p => ?_
  exact MonAff.homOf_coord _ _ _

/-- The spectrum of the residue field of a point, as an object of the site. -/
noncomputable def fieldObj (Y : BigFppfOver B S hS) (g : (SCH).obj Y) : BigFppfOver B S hS :=
  siteObject B S hS (BigFppfSite.residueField_spec_contains B Y.left.2 g)
    (((SCH).obj Y).fromSpecResidueField g ≫ Y.hom.hom)

/-- The morphism from the spectrum of the residue field. -/
noncomputable def fieldHom (Y : BigFppfOver B S hS) (g : (SCH).obj Y) : fieldObj Y g ⟶ Y :=
  Over.homMk (ObjectProperty.homMk (((SCH).obj Y).fromSpecResidueField g)) (by ext; rfl)

lemma fieldHom_apply (Y : BigFppfOver B S hS) (g : (SCH).obj Y) (z : (SCH).obj (fieldObj Y g)) :
    (SCH).map (fieldHom Y g) z = g := by
  have : ((SCH).obj Y).fromSpecResidueField g z ∈ Set.range (((SCH).obj Y).fromSpecResidueField g) :=
    ⟨z, rfl⟩
  rw [Scheme.range_fromSpecResidueField] at this
  exact this

instance (Y : BigFppfOver B S hS) (g : (SCH).obj Y) : Nonempty ((SCH).obj (fieldObj Y g)) :=
  inferInstanceAs (Nonempty (Spec (.of (((SCH).obj Y).residueField g))))

/-- `D(M)` over a field is irreducible. -/
lemma irreducible_monAff (hM : B.Contains (Spec (ZMon M))) (hirr : IrreducibleFibres M S)
    (Y : BigFppfOver B S hS) (g : (SCH).obj Y) :
    IrreducibleSpace ((SCH).obj (monAffObj M hM (fieldObj Y g))) := by
  let K : Scheme.{u} := Spec (.of (((SCH).obj Y).residueField g))
  have : IsAffine K := inferInstance
  let e := MonAff.isoOfIsAffine M K
  let R := Γ(K, ⊤)
  have hf : IsField R :=
    (MulEquiv.isField (Field.toIsField (((SCH).obj Y).residueField g))
      (Scheme.ΓSpecIso (.of (((SCH).obj Y).residueField g))).commRingCatIsoToRingEquiv.toMulEquiv)
  have hS' : Spec (.of R) ⟶ S :=
    K.isoSpec.inv ≫ ((SCH).obj Y).fromSpecResidueField g ≫ Y.hom.hom
  have hI := hirr R hf hS'
  let E := Scheme.homeoOfIso e.symm
  have : IrreducibleSpace (Spec (.of (AddMonoidAlgebra R M))) := hI
  have : PreirreducibleSpace (MonAff M K) :=
    E.surjective.preirreducibleSpace E.continuous
  have hne : Nonempty (MonAff M K) := ⟨E (Nonempty.some (inferInstance))⟩
  exact { toPreirreducibleSpace := this, toNonempty := hne }

/-- The heart of **Theorem A.1**, assertion on FPR morphisms: let `u ∈ U(T)` have image fixed in `X`.
The set of points of `D(M)_T` fixing `u` is open and is a subgroup, hence is `D(M)_T`. -/
theorem smul_eq_of_hasOpenEqualizers (hM : B.Contains (Spec (ZMon M)))
    (hirr : IrreducibleFibres M S) {U X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {actU : AAction (fppfO B S hS) M U} {actX : AAction (fppfO B S hS) M X} {f : U ⟶ X}
    (hf : IsEquivariant actU actX f) (hopen : HasOpenEqualizers f) {T : BigFppfOver B S hS}
    (u : U.obj (op T))
    (hu : ∀ {T' : BigFppfOver B S hS} (r : T' ⟶ T) (k : APt (fppfO B S hS) M (op T')),
      actX.smul k (X.map r.op (f.app _ u)) = X.map r.op (f.app _ u))
    (h : APt (fppfO B S hS) M (op T)) : actU.smul h u = u := by
  let G := monAffObj M hM T
  let π := gπ hM T
  let b : U.obj (op G) := U.map π.op u
  let a : U.obj (op G) := actU.smul (gc hM T) b
  have hfb : f.app _ b = X.map π.op (f.app _ u) := NatTrans.naturality_apply f π.op u
  have hab : f.app _ a = f.app _ b := by
    change f.app _ (actU.smul (gc hM T) b) = _
    rw [hf, hfb]
    exact hu π _
  obtain ⟨W, hW⟩ := hopen G a b hab
  -- pulling back `a` and `b`
  have hpull : ∀ {Y : BigFppfOver B S hS} (r : Y ⟶ G),
      U.map r.op a = actU.smul (APt.res r.op (gc hM T)) (U.map (r ≫ π).op u) ∧
      U.map r.op b = U.map (r ≫ π).op u := by
    intro Y r
    have e : U.map r.op b = U.map (r ≫ π).op u := by
      change U.map r.op (U.map π.op u) = _
      rw [op_comp, Functor.map_comp_apply]
    refine ⟨?_, e⟩
    rw [← e]
    exact actU.map_smul r.op _ _
  -- a point `r` of `D(M)` fixing `u` lands in `W`
  have hmem : ∀ {Y : BigFppfOver B S hS} (r : Y ⟶ G),
      actU.smul (APt.res r.op (gc hM T)) (U.map (r ≫ π).op u) = U.map (r ≫ π).op u →
      Set.range ((SCH).map r) ⊆ W := by
    intro Y r hr
    refine (hW Y r).mp ?_
    rw [(hpull r).1, (hpull r).2, hr]
  have hconv : ∀ {Y : BigFppfOver B S hS} (r : Y ⟶ G), Set.range ((SCH).map r) ⊆ W →
      actU.smul (APt.res r.op (gc hM T)) (U.map (r ≫ π).op u) = U.map (r ≫ π).op u := by
    intro Y r hr
    have := (hW Y r).mpr hr
    rwa [(hpull r).1, (hpull r).2] at this
  have htop : ∀ g : (SCH).obj G, g ∈ W := by
    intro g
    let K := fieldObj G g
    let ρ : K ⟶ G := fieldHom G g
    let t : K ⟶ T := ρ ≫ π
    let hg : APt (fppfO B S hS) M (op K) := APt.res ρ.op (gc hM T)
    let GK := monAffObj M hM K
    let πK := gπ hM K
    let cK := gc hM K
    let hgG : APt (fppfO B S hS) M (op GK) := APt.res πK.op hg
    let α := cK
    let β : APt (fppfO B S hS) M (op GK) := hgG * APt.inv cK
    let q₁ : GK ⟶ G := gLift hM (πK ≫ t) α
    let q₂ : GK ⟶ G := gLift hM (πK ≫ t) β
    have hq₁ : q₁ ≫ π = πK ≫ t := gLift_π hM _ _
    have hq₂ : q₂ ≫ π = πK ≫ t := gLift_π hM _ _
    have hc₁ : APt.res q₁.op (gc hM T) = α := res_gLift hM _ _
    have hc₂ : APt.res q₂.op (gc hM T) = β := res_gLift hM _ _
    -- the unit section lands in `q₁⁻¹ W`, the section `hg` in `q₂⁻¹ W`
    let e₁ : K ⟶ GK := gLift hM (𝟙 K) 1
    let e₂ : K ⟶ GK := gLift hM (𝟙 K) hg
    have he₂ : e₂ ≫ πK = 𝟙 K := gLift_π hM _ _
    have hce₁ : APt.res e₁.op cK = 1 := res_gLift hM _ _
    have hce₂ : APt.res e₂.op cK = hg := res_gLift hM _ _
    have hW₁ : Set.range ((SCH).map (e₁ ≫ q₁)) ⊆ W := by
      refine hmem _ ?_
      have : APt.res (e₁ ≫ q₁).op (gc hM T) = 1 := by
        rw [op_comp, APt.res_comp, hc₁]
        exact hce₁
      rw [this, actU.one_smul]
    have hW₂ : Set.range ((SCH).map (e₂ ≫ q₂)) ⊆ W := by
      refine hmem _ ?_
      have : APt.res (e₂ ≫ q₂).op (gc hM T) = 1 := by
        rw [op_comp, APt.res_comp, hc₂]
        change APt.res e₂.op (hgG * APt.inv cK) = 1
        rw [APt.res_mul, APt.inv_res, hce₂]
        have : APt.res e₂.op hgG = hg := by
          change APt.res e₂.op (APt.res πK.op hg) = hg
          rw [← APt.res_comp, ← op_comp, he₂]
          simp
        rw [this, mul_comm, APt.inv_mul]
      rw [this, actU.one_smul]
    have hI := irreducible_monAff hM hirr G g
    obtain ⟨z₀⟩ : Nonempty ((SCH).obj K) := inferInstance
    have hne₁ : (((SCH).map q₁ ⁻¹ᵁ W : ((SCH).obj GK).Opens) : Set _).Nonempty :=
      ⟨(SCH).map e₁ z₀, by
        have := hW₁ ⟨z₀, rfl⟩
        rwa [Functor.map_comp, Scheme.Hom.comp_apply] at this⟩
    have hne₂ : (((SCH).map q₂ ⁻¹ᵁ W : ((SCH).obj GK).Opens) : Set _).Nonempty :=
      ⟨(SCH).map e₂ z₀, by
        have := hW₂ ⟨z₀, rfl⟩
        rwa [Functor.map_comp, Scheme.Hom.comp_apply] at this⟩
    obtain ⟨y, hy₁, hy₂⟩ := nonempty_preirreducible_inter (X := (SCH).obj GK)
      ((SCH).map q₁ ⁻¹ᵁ W).2 ((SCH).map q₂ ⁻¹ᵁ W).2 hne₁ hne₂
    let L := fieldObj GK y
    let ι : L ⟶ GK := fieldHom GK y
    have hι : ∀ {q : GK ⟶ G}, (SCH).map q y ∈ W → Set.range ((SCH).map (ι ≫ q)) ⊆ W := by
      rintro q hq _ ⟨z, rfl⟩
      rw [Functor.map_comp, Scheme.Hom.comp_apply, fieldHom_apply]
      exact hq
    let τ : L ⟶ T := ι ≫ πK ≫ t
    let uL := U.map τ.op u
    have h₁ : actU.smul (APt.res ι.op α) uL = uL := by
      have := hconv (ι ≫ q₁) (hι hy₁)
      rw [op_comp, APt.res_comp, hc₁, Category.assoc, hq₁] at this
      exact this
    have h₂ : actU.smul (APt.res ι.op β) uL = uL := by
      have := hconv (ι ≫ q₂) (hι hy₂)
      rw [op_comp, APt.res_comp, hc₂, Category.assoc, hq₂] at this
      exact this
    have hprod : APt.res ι.op β * APt.res ι.op α = APt.res (ι ≫ πK).op hg := by
      change APt.res ι.op (hgG * APt.inv cK) * APt.res ι.op cK = _
      rw [APt.res_mul, APt.inv_res, mul_assoc, APt.inv_mul, mul_one, op_comp, APt.res_comp]
    have hL : Set.range ((SCH).map ((ι ≫ πK) ≫ ρ)) ⊆ W := by
      refine hmem _ ?_
      have e1 : ((ι ≫ πK) ≫ ρ) ≫ π = τ := by simp [τ, t]
      have e2 : APt.res ((ι ≫ πK) ≫ ρ).op (gc hM T) = APt.res (ι ≫ πK).op hg := by
        rw [op_comp, APt.res_comp]
      rw [e1, e2, ← hprod, actU.mul_smul, h₁, h₂]
    obtain ⟨w⟩ : Nonempty ((SCH).obj L) := inferInstance
    have : (SCH).map ((ι ≫ πK) ≫ ρ) w = g := by
      rw [Functor.map_comp, Scheme.Hom.comp_apply, fieldHom_apply]
    rw [← this]
    exact hL ⟨w, rfl⟩
  have heq : a = b := by
    have := (hW G (𝟙 G)).mpr (fun x _ => htop x)
    simpa using this
  have := congrArg (U.map (gLift hM (𝟙 T) h).op) heq
  have h1 := (hpull (gLift hM (𝟙 T) h)).1
  have h2 := (hpull (gLift hM (𝟙 T) h)).2
  rw [h1, h2, res_gLift, gLift_π] at this
  simpa using this

/-- **Theorem A.1**, assertion that equivariant morphisms are FPR, for `D(M)` with irreducible
fibres, for morphisms with open equalizers. -/
theorem isFPR_of_hasOpenEqualizers (hM : B.Contains (Spec (ZMon M)))
    (hirr : IrreducibleFibres M S) {U X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {actU : AAction (fppfO B S hS) M U} {actX : AAction (fppfO B S hS) M X} {f : U ⟶ X}
    (hf : IsEquivariant actU actX f) (hopen : HasOpenEqualizers f) : IsFPR hf := by
  refine (isFPR_iff hf).mpr fun T x hx T' s h => ?_
  refine smul_eq_of_hasOpenEqualizers hM hirr hf hopen (T := unop T') (U.map s x) ?_ h
  intro T'' r k
  have e : X.map r.op (f.app _ (U.map s x)) = X.map (s ≫ r.op) (f.app _ x) := by
    rw [NatTrans.naturality_apply f s x, Functor.map_comp_apply]
  rw [e]
  exact hx (s ≫ r.op) k

/-- **Theorem A.1**, assertion that étale equivariant morphisms are FPR, for `D(M)` with irreducible
fibres: no noetherian or quasi-separatedness hypothesis is needed. -/
theorem isFPR_of_etale (hM : B.Contains (Spec (ZMon M)))
    (hirr : IrreducibleFibres M S) {U X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {actU : AAction (fppfO B S hS) M U} {actX : AAction (fppfO B S hS) M X} {f : U ⟶ X}
    (hf : IsEquivariant actU actX f)
    (het : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Etale.{u} : MorphismProperty Scheme.{u}) (SCH))) f) : IsFPR hf :=
  isFPR_of_hasOpenEqualizers hM hirr hf (hasOpenEqualizers_of_etale het)

/-- **Theorem A.1**, assertion that étale equivariant morphisms are FPR, for the induced action of
`H = D(M/Z)`: if `H` has irreducible fibres, every étale equivariant morphism is `Z`-FPR. -/
theorem isZFPR_of_etale {Z : AddSubgroup M} (hM : B.Contains (Spec (ZMon (M ⧸ Z))))
    (hirr : IrreducibleFibres (M ⧸ Z) S) {U X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {actU : AAction (fppfO B S hS) M U} {actX : AAction (fppfO B S hS) M X} {f : U ⟶ X}
    (hf : IsEquivariant actU actX f)
    (het : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Etale.{u} : MorphismProperty Scheme.{u}) (SCH))) f) : IsZFPR hf Z :=
  isFPR_of_etale hM hirr (hf.comap (QuotientAddGroup.mk' Z)) het

/-- **Proposition 6.3.** If `M` is finitely generated and torsion-free (so `M ≅ ℤ^r`), every étale
equivariant morphism is FPR: `U^{D(M)} → X^{D(M)} ×_X U` is an isomorphism. -/
theorem prop63 [AddGroup.FG M] [IsAddTorsionFree M] {U X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {actU : AAction (fppfO B S hS) M U} {actX : AAction (fppfO B S hS) M X} {f : U ⟶ X}
    (hf : IsEquivariant actU actX f)
    (het : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Etale.{u} : MorphismProperty Scheme.{u}) (SCH))) f) : IsFPR hf :=
  have : Countable M := countable_of_fg M
  isFPR_of_etale (contains_zmon_of_countable hS M) (irreducibleFibres_of_torsionFree M S) hf het

end Site

