import AlgMag.Rooted.MinimalRootReductive

/-!
# Monogenic pure magnets of a reductive group

In the reductive setting (`hdet`, `hrefl` as in `ReductivePure.lean`), with `M` torsion-free and
`0 ∉ Φ`: the nonzero monogenic pure magnets are exactly the rays `ℕα`, `α ∈ Φ`
(`pure_mono_iff`).
-/

namespace AlgMag.Rooted

variable {M : Type*} [AddCommGroup M] [IsAddTorsionFree M]

lemma eq_zero_of_nsmul_eq_zero {x : M} {n : ℕ} (hn : n ≠ 0) (h : n • x = 0) : x = 0 :=
  nsmul_right_injective hn (h.trans (nsmul_zero n).symm)

/-- `ℕx ∩ -ℕx = 0` in a torsion-free group. -/
lemma eq_zero_of_mem_mono_of_neg_mem {x z : M} (hz : z ∈ mono x) (hz' : -z ∈ mono x) :
    z = 0 := by
  obtain ⟨m, rfl⟩ := AddSubmonoid.mem_closure_singleton.1 hz
  obtain ⟨n, hn⟩ := AddSubmonoid.mem_closure_singleton.1 hz'
  have h : (m + n) • x = 0 := by rw [add_nsmul, hn, add_neg_cancel]
  by_cases hmn : m + n = 0
  · have hm : m = 0 := by omega
    rw [hm, zero_nsmul]
  · rw [eq_zero_of_nsmul_eq_zero hmn h, nsmul_zero]

/-- If `x ≠ 0` lies in the monoid generated by `S ⊆ ℕx`, then `x ∈ S`. -/
lemma mem_of_mem_closure_of_subset_mono {x : M} (hx : x ≠ 0) {S : Set M}
    (hS : S ⊆ mono x) (h : x ∈ AddSubmonoid.closure S) : x ∈ S := by
  by_contra hxS
  let T : AddSubmonoid M :=
    { carrier := {y | ∃ m : ℕ, m ≠ 1 ∧ m • x = y}
      zero_mem' := ⟨0, by omega, zero_nsmul x⟩
      add_mem' := by
        rintro _ _ ⟨m, hm, rfl⟩ ⟨m', hm', rfl⟩
        refine ⟨m + m', ?_, add_nsmul x m m'⟩
        rcases Nat.eq_zero_or_pos m with h0 | h0
        · subst h0; omega
        · rcases Nat.eq_zero_or_pos m' with h1 | h1
          · subst h1; omega
          · omega }
  have hST : S ⊆ T := by
    intro y hy
    obtain ⟨m, rfl⟩ := AddSubmonoid.mem_closure_singleton.1 (hS hy)
    refine ⟨m, fun h1 => hxS ?_, rfl⟩
    rw [h1, one_nsmul] at hy
    exact hy
  obtain ⟨m, hm, hmx⟩ := (AddSubmonoid.closure_le.2 hST) h
  rcases Nat.eq_zero_or_pos m with h0 | h0
  · subst h0; exact hx (by rw [← hmx, zero_nsmul])
  · have : (m - 1) • x = 0 := by
      have h2 : (m - 1) • x + x = x := by
        rw [← succ_nsmul, Nat.sub_add_cancel h0, hmx]
      simpa using h2
    exact hx (eq_zero_of_nsmul_eq_zero (by omega) this)

variable {Φ : Set M} {W : Type*} {act : W → M →+ M}
variable {α : Type*} {Y : AddSubmonoid M → α}

variable
  (hdet : ∀ N L : AddSubmonoid M, L ≤ N → (∀ a ∈ Φ, a ∈ N → a ∈ L) →
    (∀ w, weylMagnet (act w) ≤ N → weylMagnet (act w) ≤ L) → Y L = Y N)
  (hrefl : ∀ N L : AddSubmonoid M, Y N = Y L →
    (∀ a ∈ Φ, a ∈ N → a ∈ L) ∧ ∀ w, weylMagnet (act w) ≤ N → weylMagnet (act w) ≤ L)
include hdet hrefl

/-- A nonzero monogenic pure magnet `ℕx` has `x ∈ Φ`. -/
theorem mem_roots_of_pure_mono {x : M} (hx : x ≠ 0) (hN : IsPure Y (mono x)) : x ∈ Φ := by
  have H := reductiveInput_of_attractors (act := act) hdet hrefl
  have hE := (H.pure_iff _).1 hN
  have hW : (⨆ w ∈ {w | weylMagnet (act w) ≤ mono x}, weylMagnet (act w)) = ⊥ := by
    refine le_antisymm (iSup₂_le fun w hw => ?_) bot_le
    intro z hz
    exact (AddSubmonoid.mem_bot).2
      (eq_zero_of_mem_mono_of_neg_mem (hw hz) (hw (neg_mem_weylMagnet hz)))
  have hxE : x ∈ reductiveHull Φ act (mono x) := hE ▸ AddSubmonoid.subset_closure rfl
  rw [reductiveHull, hW, sup_bot_eq] at hxE
  exact (mem_of_mem_closure_of_subset_mono hx Set.inter_subset_left hxE).2

/-- **Monogenic pure magnets**: for `0 ∉ Φ`, `N` is a nonzero monogenic pure magnet iff
`N = ℕα` for a root `α`. -/
theorem pure_mono_iff (h0 : (0 : M) ∉ Φ) (N : AddSubmonoid M) :
    (IsPure Y N ∧ ∃ x, x ≠ 0 ∧ N = mono x) ↔ ∃ a ∈ Φ, N = mono a := by
  constructor
  · rintro ⟨hN, x, hx, rfl⟩
    exact ⟨x, mem_roots_of_pure_mono hdet hrefl hx hN, rfl⟩
  · rintro ⟨a, ha, rfl⟩
    have R := reductive_joinDense (reductiveInput_of_attractors (act := act) hdet hrefl)
    exact ⟨R.pure_of_mem (Or.inl ⟨a, ha, rfl⟩), a, fun h => h0 (h ▸ ha), rfl⟩

end AlgMag.Rooted
