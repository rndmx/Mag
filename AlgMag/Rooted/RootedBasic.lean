import Mathlib.Algebra.Group.Submonoid.Membership

/-!
# Rooted actions (abstract layer)

Brochard–Mayeux, *Rooted spaces*, Definition `def:rooted` and Lemma `lem:elements`.

We work with an abstract predicate `P : AddSubmonoid M → Prop` singling out the pure magnets of an
action (for a concrete action take `P := AlgMag.IsPure Y`, so `{N | P N} = AlgMag.pureMagnets Y`).
For `Φ ⊆ Sub(M)`:
* `trace Φ N = {I ∈ Φ | I ≤ N}` (the trace of a magnet),
* `gen E = [E⟩ = ⨆_{I ∈ E} I`,
* `E` is stable if `trace Φ [E⟩ = E`,
* the action is rooted by `Φ` if `trace Φ` is a bijection from pure magnets onto stable subsets,
  with inverse `E ↦ [E⟩`.
-/

namespace AlgMag.Rooted

variable {M : Type*} [AddCommMonoid M]

/-- The trace `tr_Φ(N) = {I ∈ Φ : I ⊆ N}` of a magnet `N`. -/
def trace (Φ : Set (AddSubmonoid M)) (N : AddSubmonoid M) : Set (AddSubmonoid M) :=
  {I | I ∈ Φ ∧ I ≤ N}

/-- `[E⟩ = Σ_{I ∈ E} I`, the magnet generated by a set of submonoids. -/
abbrev gen (E : Set (AddSubmonoid M)) : AddSubmonoid M := sSup E

/-- `E ⊆ Φ` is stable if `tr_Φ([E⟩) = E`. -/
def IsStable (Φ E : Set (AddSubmonoid M)) : Prop := trace Φ (gen E) = E

/-- **Definition `def:rooted`.** The action whose pure magnets are `{N | P N}` is rooted by `Φ`. -/
structure IsJoinDense (P : AddSubmonoid M → Prop) (Φ : Set (AddSubmonoid M)) : Prop where
  maps : ∀ N, P N → IsStable Φ (trace Φ N)
  left : ∀ N, P N → gen (trace Φ N) = N
  right_mem : ∀ E, IsStable Φ E → P (gen E)

variable {P : AddSubmonoid M → Prop} {Φ : Set (AddSubmonoid M)}

lemma trace_subset (N : AddSubmonoid M) : trace Φ N ⊆ Φ := fun _ h => h.1

lemma trace_mono {N L : AddSubmonoid M} (h : N ≤ L) : trace Φ N ⊆ trace Φ L :=
  fun _ hI => ⟨hI.1, hI.2.trans h⟩

lemma gen_trace_le (N : AddSubmonoid M) : gen (trace Φ N) ≤ N := sSup_le fun _ hI => hI.2

lemma le_gen {E : Set (AddSubmonoid M)} {I : AddSubmonoid M} (h : I ∈ E) : I ≤ gen E := le_sSup h

lemma subset_trace_gen {E : Set (AddSubmonoid M)} (hE : E ⊆ Φ) : E ⊆ trace Φ (gen E) :=
  fun _ hI => ⟨hE hI, le_sSup hI⟩

lemma IsStable.subset {E : Set (AddSubmonoid M)} (hE : IsStable Φ E) : E ⊆ Φ := by
  intro I hI
  unfold IsStable at hE
  rw [← hE] at hI
  exact hI.1

lemma isStable_trace_of_gen_eq {N : AddSubmonoid M} (h : gen (trace Φ N) = N) :
    IsStable Φ (trace Φ N) := by
  unfold IsStable
  rw [h]

/-- For `I ∈ Φ`, `[tr_Φ I⟩ = I`. -/
lemma gen_trace_of_mem {I : AddSubmonoid M} (hI : I ∈ Φ) : gen (trace Φ I) = I :=
  le_antisymm (gen_trace_le I) (le_sSup ⟨hI, le_rfl⟩)

/-- Every `[E⟩` with `E ⊆ Φ` equals `[tr_Φ [E⟩⟩`. -/
lemma gen_trace_gen {E : Set (AddSubmonoid M)} (hE : E ⊆ Φ) : gen (trace Φ (gen E)) = gen E :=
  le_antisymm (gen_trace_le _) (sSup_le_sSup (subset_trace_gen hE))

/-! ### Bijection form -/

theorem IsJoinDense.bijOn (R : IsJoinDense P Φ) :
    Set.BijOn (trace Φ) {N | P N} {E | IsStable Φ E} :=
  ⟨fun N hN => R.maps N hN,
   fun N hN L hL h => by rw [← R.left N hN, ← R.left L hL, h],
   fun E hE => ⟨gen E, R.right_mem E hE, hE⟩⟩

theorem IsJoinDense.invOn (R : IsJoinDense P Φ) :
    Set.InvOn gen (trace Φ) {N | P N} {E | IsStable Φ E} :=
  ⟨fun N hN => R.left N hN, fun _ hE => hE⟩

/-- `def:rooted` verbatim: `tr_Φ` is a bijection from pure magnets onto stable subsets, with
inverse `E ↦ [E⟩`. -/
theorem isJoinDense_iff :
    IsJoinDense P Φ ↔ Set.BijOn (trace Φ) {N | P N} {E | IsStable Φ E} ∧
      Set.InvOn gen (trace Φ) {N | P N} {E | IsStable Φ E} := by
  refine ⟨fun R => ⟨R.bijOn, R.invOn⟩, ?_⟩
  rintro ⟨hb, hi⟩
  refine ⟨fun N hN => hb.mapsTo hN, fun N hN => hi.1 hN, fun E hE => ?_⟩
  obtain ⟨N, hN, rfl⟩ := hb.surjOn hE
  rw [hi.1 hN]
  exact hN

/-! ### Consequences -/

/-- Every member of a root is a pure magnet (Proposition M (a)). -/
theorem IsJoinDense.pure_of_mem (R : IsJoinDense P Φ) {I : AddSubmonoid M} (hI : I ∈ Φ) : P I := by
  have h := R.right_mem _ (isStable_trace_of_gen_eq (gen_trace_of_mem hI))
  rwa [gen_trace_of_mem hI] at h

/-- `[E⟩` is pure for every `E ⊆ Φ`, not only for stable `E`. -/
theorem IsJoinDense.pure_gen (R : IsJoinDense P Φ) {E : Set (AddSubmonoid M)} (hE : E ⊆ Φ) :
    P (gen E) := by
  have h := R.right_mem _ (isStable_trace_of_gen_eq (gen_trace_gen hE))
  rwa [gen_trace_gen hE] at h

/-- The sums of subsets of `Φ`. -/
def span (Φ : Set (AddSubmonoid M)) : Set (AddSubmonoid M) := {N | ∃ E ⊆ Φ, sSup E = N}

/-- Rooted by `Φ` iff the pure magnets are exactly the sums of members of `Φ`. -/
theorem isJoinDense_iff_eq_span : IsJoinDense P Φ ↔ {N | P N} = span Φ := by
  constructor
  · intro R
    ext N
    constructor
    · intro hN
      exact ⟨trace Φ N, trace_subset N, R.left N hN⟩
    · rintro ⟨E, hE, rfl⟩
      exact R.pure_gen hE
  · intro h
    rw [Set.ext_iff] at h
    have hl : ∀ N, P N → gen (trace Φ N) = N := by
      intro N hN
      obtain ⟨E, hE, hEN⟩ := (h N).1 hN
      refine le_antisymm (gen_trace_le N) ?_
      calc N = sSup E := hEN.symm
        _ ≤ gen (trace Φ N) :=
          sSup_le_sSup fun I hI => ⟨hE hI, by rw [← hEN]; exact le_sSup hI⟩
    exact ⟨fun N hN => isStable_trace_of_gen_eq (hl N hN), hl,
      fun E hE => (h _).2 ⟨E, hE.subset, rfl⟩⟩

/-- Hull criterion: if `N` pure implies `N = [tr_Φ N⟩`, and every `[tr_Φ N⟩` is pure, the action is
rooted by `Φ` (the shape of the proof of Theorem R). -/
theorem isJoinDense_of_hull (h1 : ∀ N, P N → gen (trace Φ N) = N)
    (h2 : ∀ N, P (gen (trace Φ N))) : IsJoinDense P Φ := by
  refine ⟨fun N hN => isStable_trace_of_gen_eq (h1 N hN), h1, fun E hE => ?_⟩
  have h := h2 (gen E)
  unfold IsStable at hE
  rwa [hE] at h

/-- The pure magnets of a rooted action are closed under arbitrary sums. -/
theorem IsJoinDense.pure_sSup (R : IsJoinDense P Φ) {S : Set (AddSubmonoid M)} (hS : ∀ N ∈ S, P N) :
    P (sSup S) := by
  have e : gen (trace Φ (sSup S)) = sSup S := by
    refine le_antisymm (gen_trace_le _) (sSup_le fun N hN => ?_)
    calc N = gen (trace Φ N) := (R.left N (hS N hN)).symm
      _ ≤ gen (trace Φ (sSup S)) := sSup_le_sSup (trace_mono (le_sSup hN))
  have h := R.right_mem _ (isStable_trace_of_gen_eq e)
  rwa [e] at h

/-! ### Element version (Lemma `lem:elements`) -/

/-- The monogenic submonoid `[α⟩ = ℕα`. -/
abbrev mono (a : M) : AddSubmonoid M := AddSubmonoid.closure {a}

lemma mono_le_iff {a : M} {N : AddSubmonoid M} : mono a ≤ N ↔ a ∈ N :=
  AddSubmonoid.closure_le.trans Set.singleton_subset_iff

/-- For `Φ ⊆ M`, `E ⊆ Φ` is stable if `[E⟩ ∩ Φ = E`. -/
def IsStableElt (Φe E : Set M) : Prop :=
  E ⊆ Φe ∧ ((AddSubmonoid.closure E : AddSubmonoid M) : Set M) ∩ Φe = E

lemma trace_mono_image (S : Set M) (N : AddSubmonoid M) :
    trace (mono '' S) N = mono '' ((N : Set M) ∩ S) := by
  ext I
  constructor
  · rintro ⟨⟨a, ha, rfl⟩, hle⟩
    exact ⟨a, ⟨mono_le_iff.1 hle, ha⟩, rfl⟩
  · rintro ⟨a, ⟨haN, ha⟩, rfl⟩
    exact ⟨⟨a, ha, rfl⟩, mono_le_iff.2 haN⟩

lemma gen_mono_image (S : Set M) : gen (mono '' S) = AddSubmonoid.closure S :=
  le_antisymm
    (sSup_le (by rintro _ ⟨a, ha, rfl⟩; exact mono_le_iff.2 (AddSubmonoid.subset_closure ha)))
    (AddSubmonoid.closure_le.2 fun a ha => mono_le_iff.1 (le_sSup ⟨a, ha, rfl⟩))

/-- **Lemma `lem:elements`.** Rooted by `{[α⟩ : α ∈ Φ}` iff `N ↦ N ∩ Φ` maps pure magnets to stable
subsets of `Φ`, `[N ∩ Φ⟩ = N` for pure `N`, and `[E⟩` is pure for stable `E` (i.e. a bijection with
inverse `E ↦ [E⟩`). -/
theorem isJoinDense_mono_iff (Φe : Set M) :
    IsJoinDense P (mono '' Φe) ↔
      (∀ N, P N → IsStableElt Φe ((N : Set M) ∩ Φe)) ∧
      (∀ N, P N → AddSubmonoid.closure ((N : Set M) ∩ Φe) = N) ∧
      (∀ E, IsStableElt Φe E → P (AddSubmonoid.closure E)) := by
  constructor
  · intro R
    have hl : ∀ N, P N → AddSubmonoid.closure ((N : Set M) ∩ Φe) = N := fun N hN => by
      rw [← gen_mono_image, ← trace_mono_image]
      exact R.left N hN
    refine ⟨fun N hN => ⟨Set.inter_subset_right, ?_⟩, hl, fun E hE => ?_⟩
    · rw [hl N hN]
    · have hs : IsStable (mono '' Φe) (mono '' E) := by
        unfold IsStable
        rw [gen_mono_image, trace_mono_image, hE.2]
      have h := R.right_mem _ hs
      rwa [gen_mono_image] at h
  · rintro ⟨-, h2, h3⟩
    have hl : ∀ N, P N → gen (trace (mono '' Φe) N) = N := fun N hN => by
      rw [trace_mono_image, gen_mono_image]
      exact h2 N hN
    refine ⟨fun N hN => isStable_trace_of_gen_eq (hl N hN), hl, fun E hE => ?_⟩
    set F : Set M := {a | a ∈ Φe ∧ mono a ∈ E} with hF
    have hEF : E = mono '' F := by
      ext I
      constructor
      · intro hI
        obtain ⟨a, ha, rfl⟩ := hE.subset hI
        exact ⟨a, ⟨ha, hI⟩, rfl⟩
      · rintro ⟨a, ⟨-, ha⟩, rfl⟩
        exact ha
    have hs : trace (mono '' Φe) (gen E) = E := hE
    rw [hEF, gen_mono_image, trace_mono_image] at hs
    rw [hEF, gen_mono_image]
    refine h3 F ⟨fun a ha => ha.1, ?_⟩
    ext a
    constructor
    · rintro ⟨hac, haΦ⟩
      have hm : mono a ∈ mono '' F := by
        rw [← hs]
        exact ⟨a, ⟨hac, haΦ⟩, rfl⟩
      rw [← hEF] at hm
      exact ⟨haΦ, hm⟩
    · intro ha
      exact ⟨AddSubmonoid.subset_closure ha, ha.1⟩

end AlgMag.Rooted
