import Mathlib.Geometry.RingedSpace.SheafedSpace
import Mathlib.Geometry.RingedSpace.OpenImmersion
import Mathlib.Algebra.Category.MonCat.Limits
import Mathlib.Topology.Sheaves.LocalPredicate
import Mathlib.GroupTheory.MonoidLocalization.Basic
import Mathlib.Topology.Sheaves.SheafCondition.Sites

/-!
# Schemes over `F₁` (monoschemes): Definitions 2.1, 2.2, 2.3

Mayeux, *Algebraic magnetism: X-products of attractors via F₁-geometry*, §2.

## Main definitions

* `AlgMag.XP.F1.MPrime`, `AlgMag.XP.F1.specTop`, `AlgMag.XP.F1.spec`: **Definition 2.1**, the monoidal
  space `spec Q`, with the Zariski topology and the sheaf of locally fractions, whose stalk at `𝔭` is
  the localization `Q_𝔭`.
* `AlgMag.XP.F1.MonoidalSpace`: **Definition 2.2**. A monoidal space is a sheafed space with values in
  `CommMonCat`. A morphism is a morphism of sheafed spaces which is local on stalks, `IsLocalMor`.
  Since the stalks are filtered colimits, a homomorphism of stalks is local exactly when a section whose
  pull-back is invertible near `x` is invertible near `f x`; this is the form used. (Mathlib's
  `TopCat.Presheaf.stalk` needs `HasColimits`, which Mathlib does not provide for `CommMonCat`.)
* `AlgMag.XP.F1.IsAffineSpace`, `AlgMag.XP.F1.IsMonoscheme`: **Definition 2.3**.
-/

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry TopologicalSpace

universe u

set_option linter.unusedSectionVars false

namespace AlgMag.XP.F1

section Spec

variable (Q : Type u) [CommMonoid Q]

/-- A prime ideal of a commutative monoid: an ideal whose complement is a submonoid ([6], Ogus). The
empty set is a prime ideal, and the complement of the non-units is the maximal one. -/
@[ext]
structure MPrime where
  /-- The underlying subset. -/
  carrier : Set Q
  ideal : ∀ (q : Q) {a : Q}, a ∈ carrier → q * a ∈ carrier
  one_notMem : (1 : Q) ∉ carrier
  prime : ∀ {a b : Q}, a * b ∈ carrier → a ∈ carrier ∨ b ∈ carrier

variable {Q}

/-- The complement of a prime ideal, a submonoid. -/
def MPrime.compl (p : MPrime Q) : Submonoid Q where
  carrier := p.carrierᶜ
  one_mem' := p.one_notMem
  mul_mem' {a b} ha hb h := (p.prime h).elim ha hb

lemma MPrime.mem_compl {p : MPrime Q} {a : Q} : a ∈ p.compl ↔ a ∉ p.carrier := Iff.rfl

variable (Q)

/-- The basic open `D(f)`, the primes not containing `f`. -/
def basicSet (f : Q) : Set (MPrime Q) := {p | f ∉ p.carrier}

/-- The Zariski topology on the set of prime ideals of `Q`: it is generated by the `D(f)`. -/
instance : TopologicalSpace (MPrime Q) := TopologicalSpace.generateFrom (Set.range (basicSet Q))

/-- The topological space underlying `spec Q`. -/
def specTop : TopCat.{u} := TopCat.of (MPrime Q)

variable {Q}

lemma isOpen_basicSet (f : Q) : IsOpen (basicSet Q f) :=
  TopologicalSpace.isOpen_generateFrom_of_mem ⟨f, rfl⟩

/-- `D(f) ∩ D(g) = D(fg)`. -/
lemma basicSet_mul (f g : Q) : basicSet Q (f * g) = basicSet Q f ∩ basicSet Q g := by
  ext p
  constructor
  · intro h
    exact ⟨fun hf => h (by rw [mul_comm]; exact p.ideal g hf), fun hg => h (p.ideal f hg)⟩
  · rintro ⟨h1, h2⟩ h
    exact (p.prime h).elim h1 h2

lemma isTopologicalBasis_basicSet : IsTopologicalBasis (Set.range (basicSet Q)) := by
  refine ⟨?_, ?_, rfl⟩
  · rintro _ ⟨f, rfl⟩ _ ⟨g, rfl⟩ x hx
    exact ⟨_, ⟨f * g, rfl⟩, by rw [basicSet_mul]; exact hx, by rw [basicSet_mul]⟩
  · refine Set.eq_univ_of_forall fun p => ⟨_, ⟨1, rfl⟩, p.one_notMem⟩

variable (Q)

/-- The localizations `Q_𝔭`, the stalks of the structure sheaf. -/
abbrev Loc (p : specTop Q) : Type u := Localization (MPrime.compl (Q := Q) p)

/-- `a / f` in `Q_𝔭`. -/
def fracAt (a f : Q) (p : specTop Q) (h : f ∉ (show MPrime Q from p).carrier) : Loc Q p :=
  Localization.mk a ⟨f, h⟩

/-- Functions which are one fraction on all of `U`. -/
def isFractionPrelocal : TopCat.PrelocalPredicate (Loc Q) where
  pred {U} s := ∃ (a f : Q) (hf : ∀ x : U, f ∉ (show MPrime Q from x.1).carrier),
    ∀ x : U, s x = fracAt Q a f x.1 (hf x)
  res := by
    rintro V U i s ⟨a, f, hf, h⟩
    exact ⟨a, f, fun x => hf (i x), fun x => h (i x)⟩

variable {Q} in
lemma isFractionPrelocal_mk {U : Opens (specTop Q)} (s : ∀ x : U, Loc Q x.1) (a f : Q)
    (hf : ∀ x : U, f ∉ (show MPrime Q from x.1).carrier)
    (h : ∀ x : U, s x = fracAt Q a f x.1 (hf x)) : (isFractionPrelocal Q).pred s :=
  ⟨a, f, hf, h⟩

/-- Functions which are locally a fraction. -/
def isLocallyFraction : TopCat.LocalPredicate (Loc Q) := (isFractionPrelocal Q).sheafify

/-- The sections over `U`, a submonoid of the product of the stalks. -/
def sections (U : Opens (specTop Q)) : Submonoid (∀ x : U, Loc Q x.1) where
  carrier := {s | (isLocallyFraction Q).pred s}
  one_mem' := fun x => ⟨U, x.2, 𝟙 U, 1, 1, fun x h => x.1.one_notMem h, fun y => by
    change (1 : Loc Q y.1) = Localization.mk 1 _
    exact Localization.mk_one.symm⟩
  mul_mem' := by
    intro s t hs ht x
    obtain ⟨V, hV, i, a, f, hf, h⟩ := hs x
    obtain ⟨W, hW, j, b, g, hg, k⟩ := ht x
    refine ⟨V ⊓ W, ⟨hV, hW⟩, Opens.infLELeft V W ≫ i, a * b, f * g, fun y hy => ?_, fun y => ?_⟩
    · exact ((show MPrime Q from y.1).prime hy).elim (hf ⟨y.1, y.2.1⟩) (hg ⟨y.1, y.2.2⟩)
    · have e1 := h ⟨y.1, y.2.1⟩
      have e2 := k ⟨y.1, y.2.2⟩
      exact (congrArg₂ (· * ·) e1 e2).trans (Localization.mk_mul _ _ _ _)

/-- The structure presheaf of `spec Q`, with values in commutative monoids. -/
def structurePresheaf : TopCat.Presheaf CommMonCat.{u} (specTop Q) where
  obj U := CommMonCat.of (sections Q (unop U))
  map {U V} i := CommMonCat.ofHom
    { toFun := fun s => ⟨fun x => s.1 (i.unop x), (isLocallyFraction Q).res i.unop _ s.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl }

/-- The presheaf in types underlying `structurePresheaf` is the subsheaf of locally fractions. -/
def structurePresheafCompForget :
    structurePresheaf Q ⋙ forget CommMonCat ≅ (TopCat.subsheafToTypes (isLocallyFraction Q)).1 :=
  NatIso.ofComponents fun _ => Iso.refl _

/-- **Definition 2.1**: the sheaf of monoids of `spec Q`. -/
theorem isSheaf_structurePresheaf : (structurePresheaf Q).IsSheaf :=
  (TopCat.Presheaf.isSheaf_iff_isSheaf_comp (forget CommMonCat) _).mpr
    (TopCat.Presheaf.isSheaf_of_iso (structurePresheafCompForget Q).symm
      (TopCat.subsheafToTypes (isLocallyFraction Q)).2)

/-- **Definition 2.1**: the monoidal space `aQ = spec Q`. -/
def spec : SheafedSpace CommMonCat.{u} where
  carrier := specTop Q
  presheaf := structurePresheaf Q
  IsSheaf := isSheaf_structurePresheaf Q

end Spec

section Morphisms

/-- **Definition 2.2**: a monoidal space is a topological space with a sheaf of commutative monoids. -/
abbrev MonoidalSpace : Type (u + 1) := SheafedSpace CommMonCat.{u}

variable {X Y Z : MonoidalSpace.{u}}

/-- **Definition 2.2**: the stalk maps of `f` are local homomorphisms of monoids, in the form: a section
of `Y` near `f x` whose pull-back is invertible near `x` is invertible near `f x`. -/
def IsLocalMor (f : X ⟶ Y) : Prop :=
  ∀ (x : X) (U : Opens Y) (_ : f.hom.base x ∈ U) (s : Y.presheaf.obj (op U)),
    (∃ (V : Opens X) (_ : x ∈ V) (i : V ⟶ (Opens.map f.hom.base).obj U)
      (t : X.presheaf.obj (op V)), X.presheaf.map i.op (f.hom.c.app (op U) s) * t = 1) →
    ∃ (W : Opens Y) (_ : f.hom.base x ∈ W) (j : W ⟶ U) (t : Y.presheaf.obj (op W)),
      Y.presheaf.map j.op s * t = 1

lemma isLocalMor_id (X : MonoidalSpace.{u}) : IsLocalMor (𝟙 X) := by
  intro x U hx s ⟨V, hV, i, t, ht⟩
  exact ⟨V, hV, i, t, ht⟩

lemma IsLocalMor.comp {f : X ⟶ Y} {g : Y ⟶ Z} (hf : IsLocalMor f) (hg : IsLocalMor g) :
    IsLocalMor (f ≫ g) := by
  intro x U hx s ⟨V, hV, i, t, ht⟩
  exact hg (f.hom.base x) U hx s (hf x ((Opens.map g.hom.base).obj U) hx (g.hom.c.app (op U) s)
    ⟨V, hV, i, t, ht⟩)

/-- A morphism of monoidal spaces, **Definition 2.2**. -/
structure MonoidalHom (X Y : MonoidalSpace.{u}) where
  /-- The morphism of sheafed spaces. -/
  hom : X ⟶ Y
  isLocal : IsLocalMor hom

/-- **Definition 2.2**: monoidal spaces with local morphisms, as a category. -/
structure MonoidalCat where
  /-- The monoidal space. -/
  X : MonoidalSpace.{u}

instance : Category MonoidalCat.{u} where
  Hom A B := MonoidalHom A.X B.X
  id A := ⟨𝟙 A.X, isLocalMor_id A.X⟩
  comp f g := ⟨f.hom ≫ g.hom, f.isLocal.comp g.isLocal⟩
  id_comp f := by
    cases f
    simp
  comp_id f := by
    cases f
    simp
  assoc f g h := by
    simp

/-- **Definition 2.3**: a monoidal space is affine if it is isomorphic to `spec Q` for a monoid `Q`. The
isomorphism is one of sheafed spaces. -/
def IsAffineSpace (X : MonoidalSpace.{u}) : Prop :=
  ∃ (Q : Type u) (_ : CommMonoid Q), Nonempty (X ≅ spec Q)

/-- **Definition 2.3**: a monoscheme (a scheme over `F₁`) is a monoidal space admitting an open cover by
affines. -/
def IsMonoscheme (X : MonoidalSpace.{u}) : Prop :=
  ∀ x : X, ∃ (Q : Type u) (_ : CommMonoid Q) (f : spec Q ⟶ X), SheafedSpace.IsOpenImmersion f ∧
    x ∈ Set.range f.hom.base

end Morphisms

end AlgMag.XP.F1
