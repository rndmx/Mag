import AlgMag.SelfActionsBase

/-!
# Self-actions: Proposition 2.1 as an equality of schemes

Mayeux, *Algebraic magnetism invariants of self-actions of diagonalizable monoid schemes*,
Semigroup Forum 112 (2026) 532–540, doi:10.1007/s00233-025-10572-9, journal p. 534:

"**Proposition 2.1** If `X = A(L)`, then for any submonoid `N` of `M` the scheme `X^N` is a closed
subscheme of `X` and equals `Spec(ℤ[L]/J_N)` where `J_N` is the ideal of `ℤ[L]` given by
`⟨ℤX^m | m ∈ L ∖ (N ∩ L)⟩`."

The paper states this for `S = Spec ℤ`, having reduced to it "because attractors commute with base
change". Here `J_N` is `printedJ`, with `specJ = Spec(ℤ[L]/J_N)` and `specJι : specJ ⟶ AZ L` the
closed immersion into `Spec ℤ[L]`.

* `isPullback_prop21`: over an arbitrary `S`, `X^N` is the base change along `𝔸(L)_S → Spec ℤ[L]` of
  `Spec(ℤ[L]/J_N) → Spec ℤ[L]`.
* `isPullback_prop21_base`: over an arbitrary `S`, `X^N = S ×_ℤ Spec(ℤ[L]/J_N)` over `S`.
* `prop21`: **Proposition 2.1** over a terminal scheme: the printed statement.
* `prop21_specZ`: the same for `S = Spec ℤ` itself.
-/

suppress_compilation

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry Magnetism

open scoped Classical

set_option linter.unusedSectionVars false

universe u

namespace AlgMag.SelfActions

open AlgMag.GB

variable {M : Type u} [AddCommMonoid M] (L N : AddSubmonoid M)

/-- The ideal `J_N = ⟨ℤX^m | m ∈ L ∖ (N ∩ L)⟩` of `ℤ[L]`, as printed. -/
def printedJ : Ideal (AddMonoidAlgebra ℤ L) :=
  Ideal.span {a | ∃ m : L, (m : M) ∉ N ∧ a = mono ℤ L m}

/-- `printedJ` is the ideal generated by the graded pieces of degree outside `N`. -/
theorem printedJ_eq : printedJ L N = magnetIdeal (magnetGrading L ℤ) N :=
  (magnetIdeal_eq_span ℤ L N).symm

/-- The scheme `Spec(ℤ[L]/J_N)`. -/
abbrev specJ : Scheme.{u} := Spec (CommRingCat.of (AddMonoidAlgebra ℤ L ⧸ printedJ L N))

/-- The closed immersion `Spec(ℤ[L]/J_N) → Spec ℤ[L]`. -/
def specJι : specJ L N ⟶ AZ L :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (printedJ L N)))

instance : IsClosedImmersion (specJι L N) :=
  IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective

section Factor

variable {L N} {T : Scheme.{u}}

lemma ptsZ_apply (t : T ⟶ AZ L) (l : L) :
    ptsZ T t (Multiplicative.ofAdd l) = (homSpecEquiv T _ t).hom (AddMonoidAlgebra.single l 1) := rfl

/-- A morphism to `Spec ℤ[L]` killing `L ∖ N` factors through `Spec(ℤ[L]/J_N)`. -/
def liftJ (t : T ⟶ AZ L) (h : ∀ l : L, (l : M) ∉ N → ptsZ T t (Multiplicative.ofAdd l) = 0) :
    T ⟶ specJ L N :=
  (homSpecEquiv T _).symm (CommRingCat.ofHom (Ideal.Quotient.lift (printedJ L N)
    (homSpecEquiv T _ t).hom (fun a ha => by
      have hle : printedJ L N ≤ RingHom.ker (homSpecEquiv T _ t).hom := by
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨m, hm, rfl⟩
        exact h m hm
      exact hle ha)))

lemma liftJ_ι (t : T ⟶ AZ L) (h : ∀ l : L, (l : M) ∉ N → ptsZ T t (Multiplicative.ofAdd l) = 0) :
    liftJ t h ≫ specJι L N = t := by
  apply (homSpecEquiv T _).injective
  rw [specJι, homSpecEquiv_map, liftJ, Equiv.apply_symm_apply]
  refine CommRingCat.hom_ext (RingHom.ext fun a => ?_)
  rfl

/-- A morphism factoring through `Spec(ℤ[L]/J_N)` kills `L ∖ N`. -/
lemma kills_of_factor (b : T ⟶ specJ L N) {l : L} (hl : (l : M) ∉ N) :
    ptsZ T (b ≫ specJι L N) (Multiplicative.ofAdd l) = 0 := by
  rw [ptsZ_apply, specJι, homSpecEquiv_map]
  change (homSpecEquiv T _ b).hom (Ideal.Quotient.mk (printedJ L N) (AddMonoidAlgebra.single l 1)) = 0
  have hmem : (AddMonoidAlgebra.single l 1 : AddMonoidAlgebra ℤ L) ∈ printedJ L N :=
    Ideal.subset_span ⟨l, hl, rfl⟩
  rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero]

end Factor

variable {S : Scheme.{u}}

/-- The morphism `X^N → Spec(ℤ[L]/J_N)`: the point of `Spec ℤ[L]` underlying `X^N` kills `L ∖ N`. This
is the printed post-composition with `R[N] → R`, `X^n ↦ 1`, followed by passing to the quotient. -/
def toSpecJ : (Zatt (aAction L S) N).left ⟶ specJ L N :=
  liftJ ((iAtt (aAction L S) N).left ≫ toAZ L S) fun _ hl =>
    (congrArg (fun z : APt (overO S) L (op (Zatt (aAction L S) N)) => z (Multiplicative.ofAdd _))
      ((congrArg (pts _) (toPoint_attEquiv (aAction L S) N (𝟙 _))).trans
        (congrArg (pts _) (Category.id_comp _)))).symm.trans
      (toPoint_vanish L (attEquiv (aAction L S) N _ (𝟙 _)) hl)

lemma toSpecJ_ι :
    toSpecJ L N (S := S) ≫ specJι L N = (iAtt (aAction L S) N).left ≫ toAZ L S :=
  liftJ_ι _ _

/-- **Proposition 2.1**, for an arbitrary `S`: the square
```
X^N ------> 𝔸(L)_S
 |            |
 v            v
Spec(ℤ[L]/J_N) --> Spec ℤ[L]
```
is cartesian. A `T`-point of `𝔸(L)_S` lying over `Spec(ℤ[L]/J_N)` underlies an equivariant map
`𝔸(N)_T → 𝔸(L)_T`, the printed one "sending `X^m` to `F([X^m]) X^m`" (`vanishPt`). -/
theorem isPullback_prop21 :
    IsPullback (iAtt (aAction L S) N).left (toSpecJ L N) (toAZ L S) (specJι L N) := by
  have w : (iAtt (aAction L S) N).left ≫ toAZ L S = toSpecJ L N ≫ specJι L N :=
    (toSpecJ_ι L N).symm
  have key : ∀ {W : Scheme.{u}} (a : W ⟶ (A L S).left) (b : W ⟶ specJ L N)
      (_ : a ≫ toAZ L S = b ≫ specJι L N),
      ∃ m : W ⟶ (Zatt (aAction L S) N).left, m ≫ (iAtt (aAction L S) N).left = a := by
    intro W a b hab
    let Tw : Over S := Over.mk (a ≫ (A L S).hom)
    let a' : Tw ⟶ A L S := Over.homMk a rfl
    have ht : ∀ l : L, (l : M) ∉ N → pts Tw a' (Multiplicative.ofAdd l) = 0 := by
      intro l hl
      have h1 : pts Tw a' (Multiplicative.ofAdd l) = ptsZ W (a ≫ toAZ L S) (Multiplicative.ofAdd l) :=
        rfl
      rw [h1, hab]
      exact kills_of_factor b hl
    let z : Tw ⟶ Zatt (aAction L S) N := (attEquiv (aAction L S) N Tw).symm (vanishPt L a' ht)
    have hz : z ≫ iAtt (aAction L S) N = a' := by
      rw [← toPoint_attEquiv, Equiv.apply_symm_apply, toPoint_vanishPt]
    exact ⟨z.left, congrArg (fun k => k.left) hz⟩
  refine ⟨⟨w⟩, ⟨PullbackCone.IsLimit.mk _
    (fun s => (key s.fst s.snd s.condition).choose) ?_ ?_ ?_⟩⟩
  · exact fun s => (key s.fst s.snd s.condition).choose_spec
  · intro s
    rw [← cancel_mono (specJι L N), Category.assoc, ← w, ← Category.assoc,
      (key s.fst s.snd s.condition).choose_spec, s.condition]
  · intro s m h1 _
    rw [← cancel_mono (iAtt (aAction L S) N).left, h1]
    exact (key s.fst s.snd s.condition).choose_spec.symm

/-- **Proposition 2.1**, for an arbitrary `S`: `X^N = S ×_ℤ Spec(ℤ[L]/J_N)`, as a scheme over `S`
(`attractorPtEquivSpec` is this on functors of points). -/
theorem isPullback_prop21_base :
    IsPullback (Zatt (aAction L S) N).hom (toSpecJ L N) (terminal.from S)
      (terminal.from (specJ L N)) := by
  have h1 : IsPullback (A L S).hom (toAZ L S) (terminal.from S) (terminal.from (AZ L)) :=
    IsPullback.of_hasPullback _ _
  have h2 := (isPullback_prop21 (S := S) L N).paste_horiz h1
  have e1 : (iAtt (aAction L S) N).left ≫ (A L S).hom = (Zatt (aAction L S) N).hom :=
    Over.w (iAtt (aAction L S) N)
  rw [e1] at h2
  have e2 : specJι L N ≫ terminal.from (AZ L) = terminal.from (specJ L N) :=
    terminal.hom_ext _ _
  rwa [e2] at h2

/-- **Proposition 2.1**, the closed immersion, for an arbitrary `S`. Its ideal over an affine open of
`S` is `ker_iAtt_self`. -/
theorem prop21_closed : IsClosedImmersion (iAtt (aAction L S) N).left := inferInstance

/-- **Proposition 2.1**, over `S` terminal: `X = 𝔸(L)_S` is `Spec ℤ[L]`, `X^N` is `Spec(ℤ[L]/J_N)`, and
under these identifications the closed immersion `X^N → X` is `Spec(ℤ[L]/J_N) → Spec ℤ[L]`, with
`J_N = ⟨ℤX^m | m ∈ L ∖ (N ∩ L)⟩`. -/
theorem prop21 (hS : IsTerminal S) :
    IsClosedImmersion (iAtt (aAction L S) N).left ∧
      IsIso (toAZ L S) ∧ IsIso (toSpecJ L N (S := S)) ∧
      (iAtt (aAction L S) N).left ≫ toAZ L S = toSpecJ L N ≫ specJι L N := by
  have hi : IsIso (terminal.from S) := isIso_of_isTerminal hS terminalIsTerminal _
  have h1 : IsPullback (A L S).hom (toAZ L S) (terminal.from S) (terminal.from (AZ L)) :=
    IsPullback.of_hasPullback _ _
  exact ⟨inferInstance, h1.isIso_snd_of_isIso, (isPullback_prop21_base L N).isIso_snd_of_isIso,
    (toSpecJ_ι L N).symm⟩

/-- **Proposition 2.1** as printed, for `S = Spec ℤ`: "the scheme `X^N` is a closed subscheme of `X` and
equals `Spec(ℤ[L]/J_N)`". -/
theorem prop21_specZ :
    IsClosedImmersion (iAtt (aAction L (Spec (CommRingCat.of (ULift.{u} ℤ)))) N).left ∧
      IsIso (toAZ L (Spec (CommRingCat.of (ULift.{u} ℤ)))) ∧
      IsIso (toSpecJ L N (S := Spec (CommRingCat.of (ULift.{u} ℤ)))) ∧
      (iAtt (aAction L (Spec (CommRingCat.of (ULift.{u} ℤ)))) N).left ≫
          toAZ L (Spec (CommRingCat.of (ULift.{u} ℤ))) =
        toSpecJ L N ≫ specJι L N :=
  prop21 L N specULiftZIsTerminal

end AlgMag.SelfActions

#print axioms AlgMag.SelfActions.printedJ_eq
#print axioms AlgMag.SelfActions.isPullback_prop21
#print axioms AlgMag.SelfActions.isPullback_prop21_base
#print axioms AlgMag.SelfActions.prop21
#print axioms AlgMag.SelfActions.prop21_specZ
