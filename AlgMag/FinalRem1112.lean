/-!
# Remark 11.12 of *Algebraic Magnetism*

"If `X` is Cohen-Macaulay, then `X^N` is not Cohen-Macaulay in general." The paper cites Mathoverflow only. Example: `M = ℤ`, `N = 0`,
`X = Spec k[u,v,x₁,y₁,x₂,y₂]/(u²-x₁y₁, uv-x₂y₂)` with weights `0,0,1,-1,1,-1`, and `X^0 = Spec k[u,v]/(u²,uv)`.
`X` is a complete intersection, Cohen-Macaulay at every prime (`rem1112_CM`); `X^0` is not, at `(u,v)` (`rem1112_not_CM`).
As in `FinalRem1111`, this is the ring form: the link with `X^0` is Thm 3.20 (`isLeast_ker_iAtt`), and `rem1112_ideal` identifies
the ideal with the one generated by the monomials of nonzero weight.
Coordinates: `0 = x₂, 1 = y₂, 2 = u, 3 = v, 4 = x₁, 5 = y₁`.
-/

open MvPolynomial Module RingTheory.Sequence

noncomputable section

namespace AlgMag.Final.Rem1112

/-- A quotient of a Cohen-Macaulay ring by a weakly regular sequence is Cohen-Macaulay at each prime. -/
theorem cm_quotient {S : Type*} [CommRing S] [IsNoetherianRing S]
    (hS : ∀ (p : Ideal S) [p.IsPrime],
      IsMaximalCohenMacaulay (Localization.AtPrime p) (Localization.AtPrime p))
    (rs : List S) (hrs : IsWeaklyRegular S rs)
    (P : Ideal (S ⧸ Ideal.ofList rs)) [P.IsPrime] :
    IsMaximalCohenMacaulay (Localization.AtPrime P) (Localization.AtPrime P) := by
  let I := Ideal.ofList rs
  let q : Ideal S := P.comap (Ideal.Quotient.mk I)
  haveI : q.IsPrime := Ideal.comap_isPrime _ _
  let Sq := Localization.AtPrime q
  haveI : IsNoetherianRing Sq := IsLocalization.isNoetherianRing q.primeCompl Sq ‹_›
  have hIq : I ≤ q := fun x hx => by
    change Ideal.Quotient.mk I x ∈ P
    rw [Ideal.Quotient.eq_zero_iff_mem.2 hx]
    exact P.zero_mem
  have hmem : ∀ x ∈ rs.map (algebraMap S Sq), x ∈ IsLocalRing.maximalIdeal Sq := by
    intro x hx
    obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff Sq q y).2 (hIq (Ideal.subset_span hy))
  have hw : IsWeaklyRegular Sq (rs.map (algebraMap S Sq)) := hrs.of_isLocalization Sq q.primeCompl
  have hr : IsRegular Sq (rs.map (algebraMap S Sq)) :=
    (IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal hmem).2 hw
  have hk := ((hS q).isRegular_iff_ringKrullDim_add_length_eq_ringKrullDim _ hmem).2 hr |>.2
    (rs.map (algebraMap S Sq)).length le_rfl
  rw [List.take_length, ← Ideal.map_ofList] at hk
  obtain ⟨hloc, hCM, -⟩ := hk
  haveI : P.LiesOver q := ⟨rfl⟩
  letI : Algebra S (S ⧸ I) := inferInstance
  have hsub : Algebra.algebraMapSubmonoid (S ⧸ I) q.primeCompl = P.primeCompl :=
    Ideal.algebraMapSubmonoid_primeCompl_of_liesOver_surjective P q Ideal.Quotient.mk_surjective
  haveI hL : IsLocalization P.primeCompl (Sq ⧸ I.map (algebraMap S Sq)) := by
    rw [← hsub]; infer_instance
  let e := IsLocalization.algEquiv P.primeCompl (Sq ⧸ I.map (algebraMap S Sq)) (Localization.AtPrime P)
  exact Stacks.RegularSequence.FibrewiseLocus.isMaximalCohenMacaulay_of_ringEquiv e.toRingEquiv hCM

section Elementary

open Polynomial in
/-- `p (a - bX)` divisible by the constant `F` forces `F ∣ p`, if `b` is regular modulo `F`. -/
lemma dvd_of_dvd_mul {D : Type*} [CommRing D] {F a b : D} (hb : ∀ c, F ∣ b * c → F ∣ c) (p : D[X])
    (h : Polynomial.C F ∣ p * (Polynomial.C a - Polynomial.C b * Polynomial.X)) : Polynomial.C F ∣ p := by
  rw [Polynomial.C_dvd_iff_dvd_coeff] at h ⊢
  have key : ∀ k n, p.natDegree < n + k → F ∣ p.coeff n := by
    intro k
    induction k with
    | zero =>
      intro n hn
      rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by simpa using hn)]
      exact dvd_zero _
    | succ k ih =>
      intro n hn
      have h1 : F ∣ p.coeff (n + 1) := ih (n + 1) (by omega)
      have h2 := h (n + 1)
      have h3 : (p * (Polynomial.C a - Polynomial.C b * Polynomial.X)).coeff (n + 1) =
          p.coeff (n + 1) * a - b * p.coeff n := by
        rw [mul_sub, Polynomial.coeff_sub, Polynomial.coeff_mul_C, ← mul_assoc,
          Polynomial.coeff_mul_X, Polynomial.coeff_mul_C, mul_comm b]
      rw [h3] at h2
      exact hb _ ((dvd_sub_right (h1.mul_right a)).1 h2)
  intro n
  exact key (p.natDegree + 1) n (by omega)

/-- The last variable is regular modulo a constant. -/
lemma dvd_of_dvd_X_mul {D : Type*} [CommRing D] {F : D} (p : Polynomial D)
    (h : Polynomial.C F ∣ Polynomial.X * p) : Polynomial.C F ∣ p := by
  rw [Polynomial.C_dvd_iff_dvd_coeff] at h ⊢
  intro n
  simpa using h (n + 1)

variable (k : Type*) [Field k]

/-- The polynomial ring, coordinates `0 = x₂, 1 = y₂, 2 = u, 3 = v, 4 = x₁, 5 = y₁`. -/
abbrev R6 := MvPolynomial (Fin 6) k

/-- `u² - x₁y₁`. -/
def f : R6 k := X 2 ^ 2 - X 4 * X 5
/-- `uv - x₂y₂`. -/
def g : R6 k := X 2 * X 3 - X 0 * X 1

lemma f_ne_zero : f k ≠ 0 := by
  intro h
  have := congrArg (aeval (R := k) (fun i : Fin 6 => if i = 2 then (1 : k) else 0)) h
  simp [f] at this

/-- `g` is regular modulo `f`. -/
lemma dvd_of_dvd_mul_g (a : R6 k) (h : f k ∣ a * g k) : f k ∣ a := by
  let Φ := finSuccEquiv k 5
  let Ψ := finSuccEquiv k 4
  let f₂ : MvPolynomial (Fin 4) k := X 0 ^ 2 - X 2 * X 3
  let f₁ : MvPolynomial (Fin 5) k := X 1 ^ 2 - X 3 * X 4
  have hΨ : Ψ f₁ = Polynomial.C f₂ := by
    have h1 : (1 : Fin 5) = Fin.succ 0 := rfl
    have h3 : (3 : Fin 5) = Fin.succ 2 := rfl
    have h4 : (4 : Fin 5) = Fin.succ 3 := rfl
    simp only [f₁, f₂, Ψ, map_sub, map_pow, map_mul]
    rw [h1, h3, h4, finSuccEquiv_X_succ, finSuccEquiv_X_succ, finSuccEquiv_X_succ]
  have hΦf : Φ (f k) = Polynomial.C f₁ := by
    have h2 : (2 : Fin 6) = Fin.succ 1 := rfl
    have h4 : (4 : Fin 6) = Fin.succ 3 := rfl
    have h5 : (5 : Fin 6) = Fin.succ 4 := rfl
    simp only [f, f₁, Φ, map_sub, map_pow, map_mul]
    rw [h2, h4, h5, finSuccEquiv_X_succ, finSuccEquiv_X_succ, finSuccEquiv_X_succ]
  have hΦg : Φ (g k) = Polynomial.C (X 1 * X 2) - Polynomial.C (X 0) * Polynomial.X := by
    have h1 : (1 : Fin 6) = Fin.succ 0 := rfl
    have h2 : (2 : Fin 6) = Fin.succ 1 := rfl
    have h3 : (3 : Fin 6) = Fin.succ 2 := rfl
    simp only [g, Φ, map_sub, map_mul]
    rw [h1, h2, h3, finSuccEquiv_X_succ, finSuccEquiv_X_succ, finSuccEquiv_X_succ, finSuccEquiv_X_zero]
    rw [mul_comm Polynomial.X]
  have hb : ∀ c : MvPolynomial (Fin 5) k, f₁ ∣ X 0 * c → f₁ ∣ c := by
    intro c hc
    have h0 : Polynomial.C f₂ ∣ Polynomial.X * Ψ c := by
      have := map_dvd Ψ hc
      rwa [hΨ, map_mul, finSuccEquiv_X_zero] at this
    have h1 := dvd_of_dvd_X_mul (Ψ c) h0
    rw [← hΨ] at h1
    exact (map_dvd_iff Ψ).1 h1
  have h' : Polynomial.C f₁ ∣ Φ a * (Polynomial.C (X 1 * X 2) - Polynomial.C (X 0) * Polynomial.X) := by
    have := map_dvd Φ h
    rwa [hΦf, map_mul, hΦg] at this
  have h1 := dvd_of_dvd_mul hb (Φ a) h'
  rw [← hΦf] at h1
  exact (map_dvd_iff Φ).1 h1

/-- `u² - x₁y₁, uv - x₂y₂` is a regular sequence. -/
theorem weaklyRegular : IsWeaklyRegular (R6 k) [f k, g k] := by
  rw [isWeaklyRegular_cons_iff]
  refine ⟨fun a b h => mul_left_cancel₀ (f_ne_zero k) h, ?_⟩
  rw [isWeaklyRegular_cons_iff]
  refine ⟨?_, IsWeaklyRegular.nil _ _⟩
  refine (isSMulRegular_quotient_iff_mem_of_smul_mem _ _).2 fun a ha => ?_
  obtain ⟨b, -, hb⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 ha
  have h1 : f k ∣ a * g k := ⟨b, by simpa [mul_comm] using hb.symm⟩
  obtain ⟨c, rfl⟩ := dvd_of_dvd_mul_g k a h1
  exact (Submodule.mem_smul_pointwise_iff_exists _ _ _).2 ⟨c, trivial, rfl⟩

/-- The localizations of `R6 k` at primes are Cohen-Macaulay. -/
theorem cm_R6 (p : Ideal (R6 k)) [p.IsPrime] :
    IsMaximalCohenMacaulay (Localization.AtPrime p) (Localization.AtPrime p) := by
  have hL : ∀ (r : Ideal k) [r.IsPrime],
      Module.IsMaximalCohenMacaulay (Localization.AtPrime r) (Localization.AtPrime r) :=
    fun _ _ => isMaximalCohenMacaulay_self_of_isField _ (IsArtinianRing.isField_of_isDomain _)
  exact Module.IsMaximalCohenMacaulay.of_isLocalization_atPrime_mvPolynomial hL p _

/-- The ring of `X`. -/
abbrev AX := R6 k ⧸ Ideal.ofList [f k, g k]

/-- **Remark 11.12**, first half: `X` is Cohen-Macaulay at every prime. -/
theorem rem1112_CM (P : Ideal (AX k)) [P.IsPrime] :
    IsMaximalCohenMacaulay (Localization.AtPrime P) (Localization.AtPrime P) :=
  cm_quotient (fun p _ => cm_R6 k p) _ (weaklyRegular k) P

/-- The ideal of `X^0` in `k[u,v,x₁,y₁,x₂,y₂]`. -/
def IX : Ideal (R6 k) := Ideal.span {f k, g k, X 4, X 5, X 0, X 1}

/-- The weight: `x₁, x₂` have weight `1`, `y₁, y₂` have weight `-1`, `u, v` weight `0`. -/
def wt (m : Fin 6 →₀ ℕ) : ℤ := (m 4 : ℤ) + m 0 - m 5 - m 1

/-- **Remark 11.12**, the fixed locus: `IX` is `(f, g)` plus the monomials of nonzero weight. -/
theorem rem1112_ideal :
    IX k = Ideal.ofList [f k, g k] ⊔ Ideal.span {z | ∃ m, wt m ≠ 0 ∧ z = monomial m (1 : k)} := by
  have hX : ∀ i : Fin 6, wt (Finsupp.single i 1) ≠ 0 → (X i : R6 k) ∈
      Ideal.span {z | ∃ m, wt m ≠ 0 ∧ z = monomial m (1 : k)} := fun i hi =>
    Ideal.subset_span ⟨_, hi, rfl⟩
  apply le_antisymm
  · refine Ideal.span_le.2 ?_
    rintro z (rfl | rfl | rfl | rfl | rfl | rfl)
    · exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
    · exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
    · exact Ideal.mem_sup_right (hX 4 (by simp [wt]))
    · exact Ideal.mem_sup_right (hX 5 (by simp [wt]))
    · exact Ideal.mem_sup_right (hX 0 (by simp [wt]))
    · exact Ideal.mem_sup_right (hX 1 (by simp [wt]))
  · refine sup_le (Ideal.span_le.2 ?_) (Ideal.span_le.2 ?_)
    · intro z hz
      simp only [List.mem_cons, List.not_mem_nil, or_false, SetLike.mem_coe] at hz ⊢
      rcases hz with rfl | rfl <;> exact Ideal.subset_span (by simp)
    · rintro _ ⟨m, hm, rfl⟩
      have hgen : ∀ i : Fin 6, i = 4 ∨ i = 5 ∨ i = 0 ∨ i = 1 → (X i : R6 k) ∈ IX k := by
        rintro i (rfl | rfl | rfl | rfl) <;> exact Ideal.subset_span (by simp)
      have hex : ∃ i : Fin 6, (i = 4 ∨ i = 5 ∨ i = 0 ∨ i = 1) ∧ m i ≠ 0 := by
        by_contra hc
        push_neg at hc
        apply hm
        simp [wt, hc 4 (by simp), hc 5 (by simp), hc 0 (by simp), hc 1 (by simp)]
      obtain ⟨i, hi, hmi⟩ := hex
      have : (X i : R6 k) ∣ monomial m (1 : k) := by
        refine ⟨monomial (m - Finsupp.single i 1) 1, ?_⟩
        rw [X, monomial_mul, one_mul, add_tsub_cancel_of_le]
        exact Finsupp.single_le_iff.2 (Nat.one_le_iff_ne_zero.2 hmi)
      exact Ideal.mem_of_dvd _ this (hgen i hi)

/-- The ring of `X^0`, that is `k[u,v]/(u²,uv)`. -/
abbrev BX := R6 k ⧸ IX k

/-- The dual-number test for `u`. -/
def rho : R6 k →ₐ[k] DualNumber k :=
  aeval fun i => if i = 2 then DualNumber.eps else 0

/-- The test for `v`. -/
def phi : R6 k →ₐ[k] Polynomial k :=
  aeval fun i => if i = 3 then Polynomial.X else 0

lemma IX_le_rho : IX k ≤ RingHom.ker (rho k) := by
  refine Ideal.span_le.2 ?_
  rintro z (rfl | rfl | rfl | rfl | rfl | rfl) <;>
    simp [rho, f, g, RingHom.mem_ker, pow_two]

lemma IX_le_phi : IX k ≤ RingHom.ker (phi k) := by
  refine Ideal.span_le.2 ?_
  rintro z (rfl | rfl | rfl | rfl | rfl | rfl) <;>
    simp [phi, f, g, RingHom.mem_ker]

lemma rho_fst (h : R6 k) : (rho k h).fst = constantCoeff h := by
  have : (TrivSqZeroExt.fstHom k k k).comp (rho k) = aeval (fun _ => (0 : k)) := by
    refine MvPolynomial.algHom_ext fun i => ?_
    by_cases hi : i = 2 <;> simp [rho, hi]
  have h1 := AlgHom.congr_fun this h
  rw [AlgHom.comp_apply] at h1
  change (rho k h).fst = _ at h1
  rw [h1, aeval_zero']
  rfl

lemma phi_eval (h : R6 k) : (phi k h).eval 0 = constantCoeff h := by
  have : (Polynomial.aeval (0 : k)).comp (phi k) = aeval (fun _ => (0 : k)) := by
    refine MvPolynomial.algHom_ext fun i => ?_
    by_cases hi : i = 3 <;> simp [phi, hi]
  have h1 := AlgHom.congr_fun this h
  rw [AlgHom.comp_apply, Polynomial.coe_aeval_eq_eval] at h1
  rw [h1, aeval_zero']
  rfl

lemma ne_of_const (h : R6 k) (hh : constantCoeff h ≠ 0) : h * X 2 ∉ IX k := by
  intro hm
  have h0 : rho k (h * X 2) = 0 := IX_le_rho k hm
  have h1 := congrArg TrivSqZeroExt.snd h0
  rw [map_mul] at h1
  have h2 : rho k (X 2) = DualNumber.eps := by simp [rho]
  rw [h2] at h1
  simp only [TrivSqZeroExt.snd_mul, DualNumber.snd_eps, DualNumber.fst_eps] at h1
  apply hh
  rw [← rho_fst]
  simpa using h1

lemma mul_u_mem (z : R6 k) : (z - C (constantCoeff z)) * X 2 ∈ IX k := by
  have hv : ∀ i : Fin 6, (X i * X 2 : R6 k) ∈ IX k := by
    have hf : (f k) ∈ IX k := Ideal.subset_span (by simp)
    have hg : (g k) ∈ IX k := Ideal.subset_span (by simp)
    have h4 : (X 4 : R6 k) ∈ IX k := Ideal.subset_span (by simp)
    have h5 : (X 5 : R6 k) ∈ IX k := Ideal.subset_span (by simp)
    have h0 : (X 0 : R6 k) ∈ IX k := Ideal.subset_span (by simp)
    have h1 : (X 1 : R6 k) ∈ IX k := Ideal.subset_span (by simp)
    intro i
    fin_cases i
    · exact Ideal.mul_mem_right _ _ h0
    · exact Ideal.mul_mem_right _ _ h1
    · have : (X 2 * X 2 : R6 k) = f k + X 5 * X 4 := by simp only [f]; ring
      change (X 2 * X 2 : R6 k) ∈ _
      rw [this]
      exact Ideal.add_mem _ hf (Ideal.mul_mem_left _ _ h4)
    · have : (X 3 * X 2 : R6 k) = g k + X 1 * X 0 := by simp only [g]; ring
      change (X 3 * X 2 : R6 k) ∈ _
      rw [this]
      exact Ideal.add_mem _ hg (Ideal.mul_mem_left _ _ h0)
    · exact Ideal.mul_mem_right _ _ h4
    · exact Ideal.mul_mem_right _ _ h5
  induction z using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq =>
    have : (p + q - C (constantCoeff (p + q))) * X 2 =
        (p - C (constantCoeff p)) * X 2 + (q - C (constantCoeff q)) * X 2 := by
      simp only [map_add]; ring
    rw [this]
    exact Ideal.add_mem _ hp hq
  | mul_X p i _ =>
    have : (p * X i - C (constantCoeff (p * X i))) * X 2 = p * (X i * X 2) := by
      simp only [map_mul, constantCoeff_X, mul_zero, map_zero, sub_zero]; ring
    rw [this]
    exact Ideal.mul_mem_left _ _ (hv i)

/-- The point `(u,v)` of `X^0`. -/
def mX : Ideal (BX k) := RingHom.ker (Ideal.Quotient.lift (IX k) (constantCoeff (R := k) (σ := Fin 6)) (by
  intro a ha
  have := IX_le_rho k ha
  have h : rho k a = 0 := this
  rw [← rho_fst, h]
  rfl))

instance : (mX k).IsPrime := RingHom.ker_isPrime _

lemma mem_mX (h : R6 k) : Ideal.Quotient.mk (IX k) h ∈ mX k ↔ constantCoeff h = 0 := Iff.rfl

/-- **Remark 11.12**, second half: `X^0` is not Cohen-Macaulay at `(u,v)`. -/
theorem rem1112_not_CM :
    ¬ IsMaximalCohenMacaulay (Localization.AtPrime (mX k)) (Localization.AtPrime (mX k)) := by
  intro hCM
  let L := Localization.AtPrime (mX k)
  haveI : IsNoetherianRing (BX k) := inferInstance
  haveI : IsNoetherianRing L := IsLocalization.isNoetherianRing (mX k).primeCompl L ‹_›
  let w : L := algebraMap (BX k) L (Ideal.Quotient.mk _ (X 2))
  have hw0 : w ≠ 0 := by
    intro h0
    obtain ⟨⟨s, hs⟩, hsw⟩ := (IsLocalization.map_eq_zero_iff (mX k).primeCompl L _).1 h0
    obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective s
    have hc : constantCoeff h ≠ 0 := fun hh => hs ((mem_mX k h).2 hh)
    apply ne_of_const k h hc
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul]
    exact hsw
  have hann : ∀ x : L, x ∈ IsLocalRing.maximalIdeal L ↔ x * w = 0 := by
    intro x
    constructor
    · intro hx
      obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq (mX k).primeCompl x
      obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective a
      have ha : Ideal.Quotient.mk (IX k) h ∈ mX k :=
        (IsLocalization.AtPrime.mk'_mem_maximal_iff L (mX k) _ _).1 hx
      have hc : constantCoeff h = 0 := (mem_mX k h).1 ha
      have h1 := mul_u_mem k h
      rw [hc, map_zero, sub_zero] at h1
      have h2 : Ideal.Quotient.mk (IX k) h * Ideal.Quotient.mk (IX k) (X 2) = 0 := by
        rw [← map_mul]; exact Ideal.Quotient.eq_zero_iff_mem.2 h1
      have h3 : IsLocalization.mk' L (Ideal.Quotient.mk (IX k) h) s * w =
          IsLocalization.mk' L (Ideal.Quotient.mk (IX k) h * Ideal.Quotient.mk (IX k) (X 2)) s := by
        rw [mul_comm, IsLocalization.mul_mk'_eq_mk'_of_mul, mul_comm]
      rw [h3, h2, IsLocalization.mk'_zero]
    · intro hx
      by_contra hn
      have hu : IsUnit x := by simpa using hn
      exact hw0 (hu.mul_right_eq_zero.1 hx)
  have hAss : (IsLocalRing.maximalIdeal L) ∈ associatedPrimes L L := by
    refine Submodule.isAssociatedPrime_iff.2 ⟨inferInstance, w, ?_⟩
    ext x
    rw [hann x, Submodule.mem_colon_singleton, Submodule.mem_bot, smul_eq_mul]
  have hCM' : (depth L (IsLocalRing.maximalIdeal L) L : WithBot ℕ∞) = supportDim L L := by
    rw [supportDim_self_eq_ringKrullDim]; exact hCM
  have hd := (ringKrullDim_quotient_eq_supportDim_and_minimal_support_of_mem_associatedPrimes hCM'
    (p := ⟨IsLocalRing.maximalIdeal L, inferInstance⟩) hAss).1
  rw [supportDim_self_eq_ringKrullDim] at hd
  have hd0 : ringKrullDim L = 0 := by
    rw [← hd]
    exact ringKrullDim_eq_zero_of_isField
      ((Ideal.Quotient.maximal_ideal_iff_isField_quotient _).1 inferInstance)
  haveI : Ring.KrullDimLE 0 L := ringKrullDimZero_iff_ringKrullDim_eq_zero.2 hd0
  let t : L := algebraMap (BX k) L (Ideal.Quotient.mk _ (X 3))
  have htm : t ∈ IsLocalRing.maximalIdeal L := by
    refine (IsLocalization.AtPrime.to_map_mem_maximal_iff L (mX k) _).2 ?_
    exact (mem_mX k _).2 (by simp)
  have hnil : IsNilpotent t := by
    have : t ∈ nilradical L := by
      rw [nilradical_eq_sInf]
      refine Ideal.mem_sInf.2 fun J hJ => ?_
      have hJm : J = IsLocalRing.maximalIdeal L :=
        IsLocalRing.eq_maximalIdeal (Ring.krullDimLE_zero_iff.1 inferInstance J hJ)
      exact hJm ▸ htm
    exact this
  obtain ⟨n, hn⟩ := hnil
  have h0 : algebraMap (BX k) L (Ideal.Quotient.mk _ (X 3) ^ n) = 0 := by
    rw [map_pow]; exact hn
  obtain ⟨⟨s, hs⟩, hsw⟩ := (IsLocalization.map_eq_zero_iff (mX k).primeCompl L _).1 h0
  obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective s
  have hc : constantCoeff h ≠ 0 := fun hh => hs ((mem_mX k h).2 hh)
  have hm : h * X 3 ^ n ∈ IX k := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, map_pow]
    exact hsw
  have hp : phi k (h * X 3 ^ n) = 0 := IX_le_phi k hm
  have hX3 : phi k (X 3) = Polynomial.X := by simp [phi]
  rw [map_mul, map_pow, hX3] at hp
  have hph : phi k h = 0 := by
    exact (mul_eq_zero.1 hp).resolve_right (pow_ne_zero _ Polynomial.X_ne_zero)
  apply hc
  rw [← phi_eval, hph, Polynomial.eval_zero]

end Elementary

end AlgMag.Final.Rem1112

