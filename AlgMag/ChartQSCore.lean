import AlgMag.ChartEffective

/-!
# Lemma 4.5 for quasi-separated targets: the ring and scheme core

Step 1 of the chart-lemma proof without separatedness. On the kernel pair of a completion along a principal ideal `(g)`,
two lifts `s, t` to an étale chart `V → X` agree in `X` on `D(g)` and agree in `V` on all `V(g^k)`.
They need not agree in `V` on `D(g)`: the locus of agreement is only clopen there.

* `AlgMag.ChartQS.exists_mul_eq_zero`: there is `w` with `(1 - g w) I = 0`, where `I` is the ideal of
  the equalizer of `s, t`. So `s = t` on the neighbourhood `D(1 - g w)` of `V(g)`.
* `AlgMag.ChartQS.exists_idempotent_of_section`: the input of the previous lemma, from the fact that
  the diagonal of `V ×_X V` is an open immersion.
-/

open CategoryTheory AlgebraicGeometry

universe u

namespace AlgMag.ChartQS

section Ring

variable {C R : Type*} [CommRing C] [CommRing R] [Algebra C R]

/-- Let `C` be noetherian, `R` flat over `C`, `g ∈ C`, `I ⊂ ⋂ g^k R` an ideal. If `e ∈ R_g` kills `I`
and `1 - e ∈ I R_g`, then `(1 - g w) I = 0` for some `w`. -/
theorem exists_mul_eq_zero [IsNoetherianRing C] [Module.Flat C R] (g : C) (I : Ideal R)
    (hI : ∀ i ∈ I, ∀ k : ℕ, i ∈ ((Ideal.span {g}) ^ k).map (algebraMap C R))
    {Rg : Type*} [CommRing Rg] [Algebra R Rg]
    [IsLocalization.Away (algebraMap C R g) Rg] (e : Rg)
    (he : ∀ i ∈ I, e * algebraMap R Rg i = 0) (h1 : 1 - e ∈ I.map (algebraMap R Rg)) :
    ∃ w : R, ∀ i ∈ I, (1 - algebraMap C R g * w) * i = 0 := by
  set γ := algebraMap C R g with hγ
  have hmem : ∀ k : ℕ, ∀ r : R, r ∈ ((Ideal.span {g}) ^ k).map (algebraMap C R) → ∃ w, r = γ ^ k * w := by
    intro k r hr
    rw [Ideal.span_singleton_pow, Ideal.map_span, Set.image_singleton, map_pow] at hr
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.1 hr
    exact ⟨w, by rw [← hw, mul_comm]⟩
  obtain ⟨⟨i₀, ⟨_, N, rfl⟩⟩, hi₀⟩ := (IsLocalization.mem_map_algebraMap_iff
    (Submonoid.powers γ) Rg).1 h1
  dsimp only at hi₀
  obtain ⟨w, hw⟩ := hmem (N + 1) i₀.1 (hI _ i₀.2 _)
  have hunit : IsUnit (algebraMap R Rg γ) := IsLocalization.Away.algebraMap_isUnit γ
  have hN : (1 - e) * algebraMap R Rg (γ ^ N) = algebraMap R Rg (γ ^ N) * algebraMap R Rg (γ * w) := by
    rw [hi₀, hw, ← map_mul]
    congr 1
    ring
  have he' : 1 - e = algebraMap R Rg (γ * w) := by
    have hu : IsUnit (algebraMap R Rg (γ ^ N)) := by rw [map_pow]; exact hunit.pow N
    apply hu.mul_left_cancel
    rw [mul_comm _ (1 - e)]
    exact hN
  refine ⟨w, fun i hi => ?_⟩
  have h0 : algebraMap R Rg ((1 - γ * w) * i) = 0 := by
    rw [map_mul, map_sub, map_one, ← he', sub_sub_cancel]
    exact he i hi
  obtain ⟨⟨_, s, rfl⟩, hs⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers γ) Rg _).1 h0
  dsimp only at hs
  refine Chart.separating (Ideal.span {g}) s _ (fun x hx => ?_) (fun k => ?_)
  · obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 (by rwa [Ideal.span_singleton_pow] at hx)
    rw [map_mul, map_pow, ← hγ, mul_assoc, hs, mul_zero]
  · exact Ideal.mul_mem_left _ _ (hI i hi k)

end Ring

section Scheme

variable {D V F : Scheme.{u}} [IsAffine D]

lemma isCompl_aux {R : Type*} [CommRing R] (I : Ideal R) (e : R) (he : IsIdempotentElem e)
    (h : ∀ p : PrimeSpectrum R, I ≤ p.asIdeal → e ∉ p.asIdeal) : 1 - e ∈ I := by
  have htop : I ⊔ Ideal.span {e} = ⊤ := by
    by_contra hne
    obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hne
    exact h ⟨m, hm.isPrime⟩ (le_trans le_sup_left hle)
      (hle (Ideal.mem_sup_right (Ideal.mem_span_singleton_self e)))
  obtain ⟨x, hx, y, hy, hxy⟩ := Submodule.mem_sup.1 (htop ▸ Submodule.mem_top (x := (1 : R)))
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 hy
  have : 1 - e = (1 - e) * x := by
    have h2 : e * e = e := he
    calc 1 - e = (1 - e) * (x + c * e) := by rw [hxy, mul_one]
      _ = (1 - e) * x + c * (e - e * e) := by ring
      _ = (1 - e) * x := by rw [h2]; ring
  rw [this]
  exact I.mul_mem_left _ hx

/-- Let `δ : V → F` be an open immersion and `m : D → F`, `D` affine. Let `I ⊂ Γ(D)` be an ideal which
vanishes on the preimage of `δ` (as sections, `hvan`), with `V(I)` inside that preimage. Then `I` is
generated by an idempotent: `e I = 0`, `1 - e ∈ I`. For `F = V ×_X V` and `m = (s, t)`, `δ` is the
diagonal, which is open as `V → X` is étale, and `I` is the ideal of the equalizer of `s, t`. -/
theorem exists_idempotent_of_open (δ : V ⟶ F) [IsOpenImmersion δ] (m : D ⟶ F)
    (I : Ideal Γ(D, ⊤))
    (hU : ∀ i ∈ I, ∀ x : D, m x ∈ Set.range δ → x ∉ D.basicOpen i)
    (hvan : ∀ i ∈ I, ∀ r : Γ(D, ⊤), (∀ x ∈ D.basicOpen r, m x ∈ Set.range δ) →
      (D.basicOpen r).ι.appTop i = 0)
    (hV : ∀ x : D, (∀ i ∈ I, x ∉ D.basicOpen i) → m x ∈ Set.range δ) :
    ∃ e : Γ(D, ⊤), (∀ i ∈ I, e * i = 0) ∧ 1 - e ∈ I := by
  have hU' : ∀ x : D, m x ∈ Set.range δ ↔ ∀ i ∈ I, x ∉ D.basicOpen i :=
    fun x => ⟨fun h i hi => hU i hi x h, hV x⟩
  let u : Set D := {x | m x ∈ Set.range δ}
  have huo : IsOpen u := δ.isOpenEmbedding.isOpen_range.preimage m.continuous
  have huc : IsClosed u := by
    have : u = ⋂ i ∈ I, ((D.basicOpen i : D.Opens) : Set D)ᶜ := by
      ext x
      simp only [u, Set.mem_setOf_eq, hU', Set.mem_iInter, Set.mem_compl_iff, SetLike.mem_coe]
    rw [this]
    exact isClosed_biInter fun i _ => (D.basicOpen i).isOpen.isClosed_compl
  let h := D.isoSpec
  have hbo : ∀ (x : D) (r : Γ(D, ⊤)), x ∈ D.basicOpen r ↔
      h.hom x ∈ PrimeSpectrum.basicOpen r := by
    intro x r
    have := congrArg (fun U : D.Opens => x ∈ U) (Scheme.toSpecΓ_preimage_basicOpen D r)
    exact (iff_of_eq this).symm
  let u' : Set (PrimeSpectrum Γ(D, ⊤)) := h.inv ⁻¹' u
  have hc' : IsClopen u' := ⟨huc.preimage h.inv.continuous, huo.preimage h.inv.continuous⟩
  obtain ⟨e, hidem, hbo'⟩ := PrimeSpectrum.isClopen_iff.1 hc'
  have hhi : ∀ x : D, h.inv (h.hom x) = x := fun x => by
    rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]; rfl
  have hih : ∀ p : Spec Γ(D, ⊤), h.hom (h.inv p) = p := fun p => by
    rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]; rfl
  have hmem : ∀ x : D, x ∈ u ↔ x ∈ D.basicOpen e := by
    intro x
    have h1 : x ∈ u ↔ h.hom x ∈ u' := by
      change x ∈ u ↔ h.inv (h.hom x) ∈ u
      rw [hhi]
    rw [h1, hbo', hbo]
    rfl
  refine ⟨e, fun i hi => ?_, ?_⟩
  · obtain ⟨n, hn⟩ := Chart.basicOpen_ι_appTop_eq_zero e i (hvan i hi e fun x hx => (hmem x).2 hx)
    rcases n with _ | n
    · simp only [pow_zero, one_mul] at hn; rw [hn, mul_zero]
    · rwa [hidem.pow_succ_eq] at hn
  · refine isCompl_aux I e hidem fun p hp => ?_
    have hx : h.inv p ∈ u := hV _ fun i hi hb => by
      have := (hbo _ i).1 hb
      erw [hih] at this
      exact this (hp hi)
    have := (hmem _).1 hx
    rw [hbo] at this
    erw [hih] at this
    exact this

end Scheme

end AlgMag.ChartQS

#print axioms AlgMag.ChartQS.exists_mul_eq_zero
#print axioms AlgMag.ChartQS.exists_idempotent_of_open
