import Mathlib.GroupTheory.Congruence.Basic
import Mathlib.SetTheory.Cardinal.Order
import Mathlib.SetTheory.Cardinal.Arithmetic

/-!
# Self-actions of diagonalizable monoid schemes: the monoid computation

Mayeux, *Algebraic magnetism invariants of self-actions of diagonalizable monoid schemes*,
Semigroup Forum 112 (2026) 532–540, doi:10.1007/s00233-025-10572-9 (the published version, read from
the publisher's PDF; numbering and quotations below are those of the journal).

For the action of `𝔸(M)_S` on `𝔸(L)_S`, the equality `X^N = X^{N'}` is the equality of the monoid
ideals `MonIdeal(L ∖ N)` of `L` (Proposition 2.1, proved in `AlgMag.SelfActionsRing` over a ring and
in `AlgMag.SelfActionsBase` over a scheme). Hence `Π(a) = pureMagnets (monIdeal L)`, and the whole of
§§3-4 of the paper is the present computation.

## Main results

* `IsPurePrinted`, `isPurePrinted_iff`: the definition of pure magnets of §2.
* `existsUnique_pure`, `pureOfMagnet`: the decomposition `m(a) = ⊔ m^N(a)` and `E(N')` of §2.
* `pureMagnets_map`: `Π(a) = Π(a')` of §2.
* `lemma32`, `prop31`, `prop31Equiv`: Lemma 3.2, Proposition 3.1.
* `lemma41_*`, `prop42`, `prop43`, `lemma44`, `prop45`: §4.
* `isCancelAdd_sharp`, `unitsFace_sharp`: `M/M^×` is sharp and cancellative (Ogus, Prop. 1.3.3).
* `thm46_i`, `thm46_ii`, `thm46_card_i`, `thm46_card_ii`: Theorem 4.6.
-/

open Set

set_option linter.unusedSectionVars false

noncomputable section

namespace AlgMag.SelfActions

variable {M : Type*} [AddCommMonoid M]

section Ideal

/-- `MonIdeal(L ∖ N)`: the monoid ideal of `L` generated by `L ∖ N`. By Proposition 2.1 this set
determines `X^N` for `X = 𝔸(L)`. -/
def monIdeal (L N : AddSubmonoid M) : Set M := {x | ∃ m ∈ L, m ∉ N ∧ ∃ t ∈ L, x = m + t}

variable {L L' N N' : AddSubmonoid M}

lemma monIdeal_subset : monIdeal L N ⊆ L := by
  rintro x ⟨m, hm, -, t, ht, rfl⟩
  exact L.add_mem hm ht

lemma mem_monIdeal_of_notMem {m : M} (hm : m ∈ L) (hN : m ∉ N) : m ∈ monIdeal L N :=
  ⟨m, hm, hN, 0, L.zero_mem, (add_zero m).symm⟩

lemma add_mem_monIdeal {x t : M} (hx : x ∈ monIdeal L N) (ht : t ∈ L) : x + t ∈ monIdeal L N := by
  obtain ⟨m, hm, hmN, s, hs, rfl⟩ := hx
  exact ⟨m, hm, hmN, s + t, L.add_mem hs ht, add_assoc m s t⟩

lemma monIdeal_anti (h : N ≤ N') : monIdeal L N' ⊆ monIdeal L N := by
  rintro x ⟨m, hm, hmN, t, ht, rfl⟩
  exact ⟨m, hm, fun e => hmN (h e), t, ht, rfl⟩

/-- The monoid-ideal form of [Algebraic Magnetism, Fact 3.15]: the equivariant morphism
`𝔸(L') → 𝔸(L)`, for `L ≤ L'`, carries `J_N` into `J_N`. -/
lemma monIdeal_mono_left (h : L ≤ L') : monIdeal L N ⊆ monIdeal L' N := by
  rintro x ⟨m, hm, hmN, t, ht, rfl⟩
  exact ⟨m, h hm, hmN, t, h ht, rfl⟩

lemma mem_monIdeal_sInf {s : Set (AddSubmonoid M)} {x : M} :
    x ∈ monIdeal L (sInf s) ↔ ∃ K ∈ s, x ∈ monIdeal L K := by
  constructor
  · rintro ⟨m, hm, hmN, t, ht, rfl⟩
    obtain ⟨K, hK, hmK⟩ : ∃ K ∈ s, m ∉ K := by
      by_contra! hc
      exact hmN (AddSubmonoid.mem_sInf.mpr hc)
    exact ⟨K, hK, m, hm, hmK, t, ht, rfl⟩
  · rintro ⟨K, hK, hx⟩
    exact monIdeal_anti (sInf_le hK) hx

lemma monIdeal_inf : monIdeal L (N ⊓ N') = monIdeal L N ∪ monIdeal L N' := by
  ext x
  rw [← sInf_pair, mem_monIdeal_sInf]
  simp

lemma monIdeal_inf_left : monIdeal L (N ⊓ L) = monIdeal L N := by
  refine Subset.antisymm ?_ (monIdeal_anti inf_le_left)
  rintro x ⟨m, hm, hmN, t, ht, rfl⟩
  exact ⟨m, hm, fun e => hmN ⟨e, hm⟩, t, ht, rfl⟩

/-- `divisorCore L N` is the complement of `MonIdeal(L ∖ N)` in `L`. -/
lemma mem_divisorCore_iff {x : M} (hx : x ∈ L) : x ∈ divisorCore L N ↔ x ∉ monIdeal L N := by
  constructor
  · rintro ⟨h, hd⟩ ⟨m, hm, hmN, t, ht, rfl⟩
    exact hmN (hd ⟨m, hm⟩ ⟨t, ht⟩ rfl)
  · intro h
    refine ⟨hx, fun l l' e => ?_⟩
    by_contra hl
    exact h ⟨l, l.2, hl, l', l'.2, congrArg Subtype.val e⟩

lemma monIdeal_eq_iff_divisorCore :
    monIdeal L N = monIdeal L N' ↔ divisorCore L N = divisorCore L N' := by
  constructor
  · intro h
    ext x
    constructor
    · intro hx
      have hL : x ∈ L := hx.1
      exact (mem_divisorCore_iff hL).2 (h ▸ (mem_divisorCore_iff hL).1 hx)
    · intro hx
      have hL : x ∈ L := hx.1
      exact (mem_divisorCore_iff hL).2 (h.symm ▸ (mem_divisorCore_iff hL).1 hx)
  · intro h
    ext x
    by_cases hL : x ∈ L
    · have h1 := mem_divisorCore_iff (N := N) hL
      have h2 := mem_divisorCore_iff (N := N') hL
      rw [h] at h1
      exact not_iff_not.mp (h1.symm.trans h2)
    · exact ⟨fun hx => absurd (monIdeal_subset hx) hL, fun hx => absurd (monIdeal_subset hx) hL⟩

end Ideal

section Pure

variable {α : Type*}

/-- The definition of pure magnets printed in §2: "for any other magnet `P ⊂ N` such that
`X^P = X^N`, we have `P = N`". -/
def IsPurePrinted (Y : AddSubmonoid M → α) (N : AddSubmonoid M) : Prop :=
  ∀ P : AddSubmonoid M, P ≤ N → Y P = Y N → P = N

variable (L : AddSubmonoid M)

/-- The definition of §2 agrees with `AlgMag.IsPure` (every magnet with the same attractor
contains `N`), because `J_{N ∩ N'} = J_N + J_{N'}`. -/
theorem isPurePrinted_iff (N : AddSubmonoid M) :
    IsPurePrinted (monIdeal L) N ↔ IsPure (monIdeal L) N := by
  constructor
  · intro h K e
    have h1 : monIdeal L (N ⊓ K) = monIdeal L N := by rw [monIdeal_inf, ← e, union_self]
    exact inf_eq_left.mp (h _ inf_le_left h1)
  · intro h P hP e
    exact le_antisymm hP (h P e.symm)

/-- `E(N')` (§2): the pure magnet with the same attractor as `N'`. -/
def pureOfMagnet (N : AddSubmonoid M) : AddSubmonoid M := sInf {K | monIdeal L K = monIdeal L N}

lemma monIdeal_pureOfMagnet (N : AddSubmonoid M) :
    monIdeal L (pureOfMagnet L N) = monIdeal L N := by
  refine Subset.antisymm ?_ (monIdeal_anti (sInf_le rfl))
  intro x hx
  obtain ⟨K, hK, hxK⟩ := mem_monIdeal_sInf.mp hx
  exact (show monIdeal L K = monIdeal L N from hK) ▸ hxK

lemma isPure_pureOfMagnet (N : AddSubmonoid M) : IsPure (monIdeal L) (pureOfMagnet L N) := by
  intro K e
  refine sInf_le ?_
  show monIdeal L K = monIdeal L N
  rw [← e, monIdeal_pureOfMagnet]

variable {L} in
lemma IsPure.eq_of_monIdeal_eq {N N' : AddSubmonoid M} (h : IsPure (monIdeal L) N)
    (h' : IsPure (monIdeal L) N') (e : monIdeal L N = monIdeal L N') : N = N' :=
  le_antisymm (h _ e) (h' _ e.symm)

/-- **§2**: the decomposition `m(a) = ⊔_{N ∈ Π(a)} m^N(a)`. Every magnet has the attractor of a
unique pure magnet. -/
theorem existsUnique_pure (N : AddSubmonoid M) :
    ∃! P : AddSubmonoid M, IsPure (monIdeal L) P ∧ monIdeal L N = monIdeal L P :=
  ⟨pureOfMagnet L N, ⟨isPure_pureOfMagnet L N, (monIdeal_pureOfMagnet L N).symm⟩,
    fun _ hP => IsPure.eq_of_monIdeal_eq hP.1 (isPure_pureOfMagnet L N) (hP.2.symm.trans
      (monIdeal_pureOfMagnet L N).symm)⟩

variable {L} in
/-- The pure magnets of `𝔸(L)` are submonoids of `L`. -/
lemma IsPure.le_self {N : AddSubmonoid M} (h : IsPure (monIdeal L) N) : N ≤ L :=
  (h _ monIdeal_inf_left.symm).trans inf_le_right

variable {G : Type*} [AddCommMonoid G]

lemma monIdeal_map (ι : M →+ G) (hι : Function.Injective ι) (N : AddSubmonoid M) :
    monIdeal (L.map ι) (N.map ι) = ι '' monIdeal L N := by
  ext x
  constructor
  · rintro ⟨m, ⟨m', hm', rfl⟩, hmN, t, ⟨t', ht', rfl⟩, rfl⟩
    exact ⟨m' + t', ⟨m', hm', fun e => hmN ⟨m', e, rfl⟩, t', ht', rfl⟩, map_add ι m' t'⟩
  · rintro ⟨_, ⟨m, hm, hmN, t, ht, rfl⟩, rfl⟩
    refine ⟨ι m, ⟨m, hm, rfl⟩, ?_, ι t, ⟨t, ht, rfl⟩, map_add ι m t⟩
    rintro ⟨m', hm', e⟩
    exact hmN (hι e ▸ hm')

lemma monIdeal_map_inf (ι : M →+ G) (K : AddSubmonoid G) :
    monIdeal (L.map ι) K = monIdeal (L.map ι) (K ⊓ L.map ι) := monIdeal_inf_left.symm

/-- **§2**: `Π(a) = Π(a')`. The pure magnets of the action on `𝔸(L)` do not depend on the ambient
monoid: for `ι : M → G` injective, in particular for `M → M^gp`, they are the same submonoids. -/
theorem pureMagnets_map (ι : M →+ G) (hι : Function.Injective ι) :
    pureMagnets (monIdeal (L.map ι)) = AddSubmonoid.map ι '' pureMagnets (monIdeal L) := by
  have hinj : Function.Injective (AddSubmonoid.map ι) := AddSubmonoid.map_injective_of_injective hι
  have key : ∀ N N' : AddSubmonoid M, monIdeal (L.map ι) (N.map ι) = monIdeal (L.map ι) (N'.map ι) ↔
      monIdeal L N = monIdeal L N' := by
    intro N N'
    rw [monIdeal_map L ι hι, monIdeal_map L ι hι]
    exact (image_injective.mpr hι).eq_iff
  have hle : ∀ K : AddSubmonoid G, K ≤ L.map ι → ∃ N : AddSubmonoid M, N ≤ L ∧ N.map ι = K := by
    intro K hK
    refine ⟨(K.comap ι) ⊓ L, inf_le_right, le_antisymm ?_ ?_⟩
    · rintro _ ⟨m, hm, rfl⟩
      exact hm.1
    · intro x hx
      obtain ⟨m, hm, rfl⟩ := hK hx
      exact ⟨m, ⟨hx, hm⟩, rfl⟩
  ext K
  constructor
  · intro hK
    obtain ⟨N, -, rfl⟩ := hle K (IsPure.le_self hK)
    refine ⟨N, fun N' e => ?_, rfl⟩
    have := hK (N'.map ι) ((key N N').2 e)
    exact (AddSubmonoid.map_le_map_iff_of_injective hι).mp this
  · rintro ⟨N, hN, rfl⟩ K e
    have hK : monIdeal (L.map ι) (N.map ι) = monIdeal (L.map ι) (K ⊓ L.map ι) :=
      e.trans (monIdeal_map_inf L ι K)
    obtain ⟨N', -, hN'⟩ := hle (K ⊓ L.map ι) inf_le_right
    rw [← hN'] at hK
    have h1 := hN N' ((key N N').1 hK)
    calc N.map ι ≤ N'.map ι := (AddSubmonoid.gc_map_comap ι).monotone_l h1
      _ = K ⊓ L.map ι := hN'
      _ ≤ K := inf_le_left

/-- `Π` of `L ⊆ G` is computed in the monoid `L` itself, as the self-action of `L`. -/
theorem pureMagnets_subtype {G : Type*} [AddCommMonoid G] (L : AddSubmonoid G) :
    pureMagnets (monIdeal L) =
      AddSubmonoid.map L.subtype '' pureMagnets (monIdeal (⊤ : AddSubmonoid L)) := by
  have := pureMagnets_map (⊤ : AddSubmonoid L) L.subtype L.subtype_injective
  have e : (⊤ : AddSubmonoid L).map L.subtype = L := by
    ext x
    simp
  rwa [e] at this

end Pure

section Generators

variable {E V : Set M}

/-- The step of the proof of Proposition 3.1: "Since `e` is outside `[V⟩`, there exists `h ∈ H` such
that `e = e' + h` with `e' ∈ [E⟩`." -/
lemma exists_add_of_notMem_closure {e : M} (he : e ∈ AddSubmonoid.closure E)
    (hV : e ∉ AddSubmonoid.closure V) :
    ∃ h ∈ E, h ∉ V ∧ ∃ e' ∈ AddSubmonoid.closure E, e = h + e' := by
  have key : e ∈ AddSubmonoid.closure V ∨
      ∃ h ∈ E, h ∉ V ∧ ∃ e' ∈ AddSubmonoid.closure E, e = h + e' := by
    clear hV
    induction he using AddSubmonoid.closure_induction with
    | mem x hx =>
      by_cases hxV : x ∈ V
      · exact Or.inl (AddSubmonoid.subset_closure hxV)
      · exact Or.inr ⟨x, hx, hxV, 0, zero_mem _, (add_zero x).symm⟩
    | zero => exact Or.inl (zero_mem _)
    | add x y hx hy ihx ihy =>
      rcases ihx with ihx | ⟨h, hh, hhV, e', he', rfl⟩
      · rcases ihy with ihy | ⟨h, hh, hhV, e', he', rfl⟩
        · exact Or.inl (add_mem ihx ihy)
        · exact Or.inr ⟨h, hh, hhV, x + e', add_mem hx he', by abel⟩
      · exact Or.inr ⟨h, hh, hhV, e' + y, add_mem he' hy, by abel⟩
  exact key.resolve_left hV

/-- Every element of `[E⟩` is `a • b + z` with `z ∈ [E ∖ {b}⟩`. -/
lemma exists_nsmul_add (b : M) {x : M} (hx : x ∈ AddSubmonoid.closure E) :
    ∃ a : ℕ, ∃ z ∈ AddSubmonoid.closure (E \ {b}), x = a • b + z := by
  induction hx using AddSubmonoid.closure_induction with
  | mem x hx =>
    by_cases hxb : x = b
    · exact ⟨1, 0, zero_mem _, by simp [hxb]⟩
    · exact ⟨0, x, AddSubmonoid.subset_closure ⟨hx, hxb⟩, by simp⟩
  | zero => exact ⟨0, 0, zero_mem _, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨a, z, hz, rfl⟩ := hx
    obtain ⟨c, w, hw, rfl⟩ := hy
    exact ⟨a + c, z + w, add_mem hz hw, by rw [add_smul]; abel⟩

/-- Hypothesis (i) of Proposition 3.1. -/
def IsMinimalGen (E : Set M) : Prop :=
  ∀ E' : Set M, E' ⊂ E → AddSubmonoid.closure E' ≠ AddSubmonoid.closure E

lemma closure_diff_singleton_eq {b : M} (hb : b ∈ AddSubmonoid.closure (E \ {b})) :
    AddSubmonoid.closure (E \ {b}) = AddSubmonoid.closure E := by
  refine le_antisymm (AddSubmonoid.closure_mono sdiff_subset) (AddSubmonoid.closure_le.mpr fun x hx => ?_)
  by_cases hxb : x = b
  · exact hxb ▸ hb
  · exact AddSubmonoid.subset_closure ⟨hx, hxb⟩

lemma IsMinimalGen.notMem_closure_diff (hE : IsMinimalGen E) {b : M} (hb : b ∈ E) :
    b ∉ AddSubmonoid.closure (E \ {b}) := fun h =>
  hE (E \ {b}) ⟨sdiff_subset, fun hs => (hs hb).2 rfl⟩ (closure_diff_singleton_eq h)

/-- "`E ∩ {0} = ∅` because `0` has no effect on generation". -/
lemma IsMinimalGen.zero_notMem (hE : IsMinimalGen E) : (0 : M) ∉ E := fun h =>
  hE.notMem_closure_diff h (zero_mem _)

/-- A set none of whose elements lies in the submonoid generated by the others satisfies (i) of
Proposition 3.1. This is how Example (v) checks minimality. -/
lemma isMinimalGen_of_notMem (h : ∀ b ∈ E, b ∉ AddSubmonoid.closure (E \ {b})) : IsMinimalGen E := by
  intro E' hE' e
  obtain ⟨b, hb, hbE'⟩ := exists_of_ssubset hE'
  have hsub : E' ⊆ E \ {b} := fun x hx => ⟨hE'.1 hx, fun hxb => hbE' (hxb ▸ hx)⟩
  have hmem : b ∈ AddSubmonoid.closure E' := e ▸ AddSubmonoid.subset_closure hb
  exact h b hb (AddSubmonoid.closure_mono hsub hmem)

/-- **Lemma 3.2.** For all `B ⊂ E`, for all `B' ⊊ B`, we have `[B'⟩ ⊊ [B⟩`. -/
theorem lemma32 (hE : IsMinimalGen E) {B B' : Set M} (hB : B ⊆ E) (hB' : B' ⊂ B) :
    AddSubmonoid.closure B' < AddSubmonoid.closure B := by
  refine lt_of_le_of_ne (AddSubmonoid.closure_mono hB'.1) fun e => ?_
  obtain ⟨b, hb, hbB'⟩ := exists_of_ssubset hB'
  have h1 : b ∈ AddSubmonoid.closure B' := e ▸ AddSubmonoid.subset_closure hb
  refine hE.notMem_closure_diff (hB hb) (AddSubmonoid.closure_mono ?_ h1)
  intro x hx
  exact ⟨hB (hB'.1 hx), fun hxb => hbB' (hxb ▸ hx)⟩

/-- The step of the proof of Proposition 3.1: `X^N = X^{[N ∩ E⟩}`. -/
lemma monIdeal_closure_inter (N : AddSubmonoid M) :
    monIdeal (AddSubmonoid.closure E) N =
      monIdeal (AddSubmonoid.closure E) (AddSubmonoid.closure ((N : Set M) ∩ E)) := by
  refine Subset.antisymm (monIdeal_anti (AddSubmonoid.closure_le.mpr inter_subset_left)) ?_
  rintro x ⟨m, hm, hmN, t, ht, rfl⟩
  obtain ⟨h, hh, hhV, e', he', rfl⟩ := exists_add_of_notMem_closure hm hmN
  refine ⟨h, AddSubmonoid.subset_closure hh, fun hN => hhV ⟨hN, hh⟩, e' + t, add_mem he' ht, ?_⟩
  abel

/-- The step of the proof of Proposition 3.1: `[B⟩ ∩ E = B`. -/
lemma closure_inter_eq (hE : IsMinimalGen E) {B : Set M} (hB : B ⊆ E) :
    (AddSubmonoid.closure B : Set M) ∩ E = B := by
  have h1 : B ⊆ (AddSubmonoid.closure B : Set M) ∩ E := fun x hx =>
    ⟨AddSubmonoid.subset_closure hx, hB hx⟩
  by_contra hne
  have hss : B ⊂ (AddSubmonoid.closure B : Set M) ∩ E :=
    ⟨h1, fun h => hne (Subset.antisymm (by exact h) h1)⟩
  have hlt := lemma32 hE inter_subset_right hss
  refine (ne_of_lt hlt) (le_antisymm (AddSubmonoid.closure_mono h1) ?_)
  exact AddSubmonoid.closure_le.mpr fun x hx => hx.1

/-- The surjectivity step of the proof of Proposition 3.1: `[B⟩` is a pure magnet. Cancellativity and
(ii) are used here only.

The printed proof takes `N ⊂ [B⟩`; this is not used. The step "there exists `e' ∈ E ∖ B`, and for each
`e ∈ E` an integer `λ_e ∈ ℕ` such that `b = ∑_{e ∈ E} λ_e e + e'`" is `exists_add_of_notMem_closure`,
followed by `exists_nsmul_add`, with `e' = h` and `∑ λ_e e = a • b + z`.

Journal p. 536, case `λ_b ≥ 1`: "we get the identity `0 = ∑_{e ∈ E∖{b}} λ_e e + (λ_b - 1)b + e' = 0`.
This implies that `e' ∈ N^*`. So `N^* ≠ 0` which is absurd." As `N ⊂ [B⟩` and `e' ∉ B = [B⟩ ∩ E`, one has
`e' ∉ N`, so `N^*` is a misprint: the identity gives `e' ∈ [E⟩^*`, whence `[E⟩^* ≠ 0`, against (ii).
This is `hunit` below. -/
theorem isPure_closure [IsCancelAdd M] (hE : IsMinimalGen E)
    (hu : unitsFace (AddSubmonoid.closure E) = ⊥) {B : Set M} (hB : B ⊆ E) :
    IsPure (monIdeal (AddSubmonoid.closure E)) (AddSubmonoid.closure B) := by
  intro N e
  refine AddSubmonoid.closure_le.mpr fun b hbB => ?_
  by_contra hbN
  have hbE := hB hbB
  have hbL : b ∈ AddSubmonoid.closure E := AddSubmonoid.subset_closure hbE
  have hmem : b ∈ monIdeal (AddSubmonoid.closure E) (AddSubmonoid.closure B) :=
    e ▸ mem_monIdeal_of_notMem hbL hbN
  obtain ⟨m, hm, hmB, t, ht, hbm⟩ := hmem
  -- `e'` of the printed proof is `h`
  obtain ⟨h, hh, hhB, s, hs, rfl⟩ := exists_add_of_notMem_closure hm hmB
  have hhb : h ≠ b := fun e => hhB (e ▸ hbB)
  obtain ⟨a, z, hz, hrest⟩ := exists_nsmul_add b (add_mem hs ht)
  have hsub : AddSubmonoid.closure (E \ {b}) ≤ AddSubmonoid.closure E :=
    AddSubmonoid.closure_mono sdiff_subset
  have hbeq : b = a • b + z + h := by
    rw [← hrest, hbm]
    abel
  rcases a with _ | c
  · -- `λ_b = 0`
    refine hE.notMem_closure_diff hbE ?_
    have this : b = z + h := by simpa using hbeq
    have hm' := add_mem hz (AddSubmonoid.subset_closure ⟨hh, hhb⟩ :
      h ∈ AddSubmonoid.closure (E \ {b}))
    rwa [← this] at hm'
  · -- `λ_b ≥ 1`
    have h0 : h + (c • b + z) = 0 := by
      apply add_left_cancel (a := b)
      rw [add_zero]
      conv_rhs => rw [hbeq, succ_nsmul]
      abel
    have hunit : h ∈ unitsFace (AddSubmonoid.closure E) :=
      ⟨AddSubmonoid.subset_closure hh, c • b + z,
        add_mem (nsmul_mem hbL c) (hsub hz), h0⟩
    rw [hu, AddSubmonoid.mem_bot] at hunit
    exact hE.zero_notMem (hunit ▸ hh)

/-- A pure magnet is generated by its elements in `E`. -/
lemma IsPure.eq_closure {N : AddSubmonoid M} (hN : IsPure (monIdeal (AddSubmonoid.closure E)) N) :
    N = AddSubmonoid.closure ((N : Set M) ∩ E) :=
  le_antisymm (hN _ (monIdeal_closure_inter N)) (AddSubmonoid.closure_le.mpr inter_subset_left)

/-- **Proposition 3.1**, as an equality of sets of submonoids. -/
theorem prop31 [IsCancelAdd M] (hE : IsMinimalGen E) (hu : unitsFace (AddSubmonoid.closure E) = ⊥) :
    pureMagnets (monIdeal (AddSubmonoid.closure E)) = AddSubmonoid.closure '' 𝒫 E := by
  ext N
  constructor
  · intro hN
    exact ⟨(N : Set M) ∩ E, inter_subset_right, (IsPure.eq_closure hN).symm⟩
  · rintro ⟨B, hB, rfl⟩
    exact isPure_closure hE hu hB

/-- **Proposition 3.1.** Under (i) and (ii), `N ↦ N ∩ E` is a bijection from `Π(a)` to the set of
subsets of `E`, with inverse `B ↦ [B⟩`. -/
def prop31Equiv [IsCancelAdd M] (hE : IsMinimalGen E)
    (hu : unitsFace (AddSubmonoid.closure E) = ⊥) :
    pureMagnets (monIdeal (AddSubmonoid.closure E)) ≃ 𝒫 E where
  toFun N := ⟨(N.1 : Set M) ∩ E, inter_subset_right⟩
  invFun B := ⟨AddSubmonoid.closure B.1, isPure_closure hE hu B.2⟩
  left_inv N := Subtype.ext (IsPure.eq_closure N.2).symm
  right_inv B := Subtype.ext (closure_inter_eq hE B.2)

theorem prop31_card [IsCancelAdd M] (hE : IsMinimalGen E)
    (hu : unitsFace (AddSubmonoid.closure E) = ⊥) :
    Cardinal.mk (pureMagnets (monIdeal (AddSubmonoid.closure E))) = 2 ^ Cardinal.mk E := by
  rw [Cardinal.mk_congr (prop31Equiv hE hu), Cardinal.mk_powerset]

/-- Proposition 3.1 with `[E⟩ = M`, as needed in Theorem 4.6. -/
theorem prop31_top [IsCancelAdd M] (hE : IsMinimalGen E) (hgen : AddSubmonoid.closure E = ⊤)
    (hu : unitsFace (⊤ : AddSubmonoid M) = ⊥) :
    pureMagnets (monIdeal (⊤ : AddSubmonoid M)) = AddSubmonoid.closure '' 𝒫 E := by
  rw [← hgen] at hu ⊢
  exact prop31 hE hu

end Generators

section Quotient

variable (M)

/-- `M^×`, the face of invertible elements of `M`. -/
abbrev unitsOf : AddSubmonoid M := unitsFace (⊤ : AddSubmonoid M)

/-- The congruence `x ∼ y` iff `x = y + u` with `u ∈ M^×`. -/
def unitCon : AddCon M where
  r x y := ∃ u ∈ unitsOf M, x = y + u
  iseqv :=
    { refl := fun x => ⟨0, zero_mem _, (add_zero x).symm⟩
      symm := by
        rintro x y ⟨u, hu, rfl⟩
        obtain ⟨v, hv, e⟩ := unitsFace_isGroup _ hu
        exact ⟨v, hv, by rw [add_assoc, e, add_zero]⟩
      trans := by
        rintro x y z ⟨u, hu, rfl⟩ ⟨v, hv, rfl⟩
        exact ⟨v + u, add_mem hv hu, by abel⟩ }
  add' := by
    rintro a b c d ⟨u, hu, rfl⟩ ⟨v, hv, rfl⟩
    exact ⟨u + v, add_mem hu hv, by abel⟩

/-- The quotient monoid `M/M^×`. -/
abbrev Sharp : Type _ := (unitCon M).Quotient

/-- The projection `f : M → M/M^×`. -/
def proj : M →+ Sharp M := (unitCon M).mk'

variable {M}

lemma proj_surjective : Function.Surjective (proj M) := AddCon.mk'_surjective

lemma proj_eq_iff {x y : M} : proj M x = proj M y ↔ ∃ u ∈ unitsOf M, x = y + u :=
  (unitCon M).eq

lemma proj_unit {u : M} (hu : u ∈ unitsOf M) : proj M u = 0 := by
  have : proj M u = proj M 0 := proj_eq_iff.2 ⟨u, hu, by simp⟩
  rwa [map_zero] at this

/-- `M/M^×` is sharp. -/
theorem unitsFace_sharp : unitsOf (Sharp M) = ⊥ := by
  refine le_bot_iff.mp fun x hx => ?_
  obtain ⟨-, y, -, e⟩ := hx
  obtain ⟨a, rfl⟩ := proj_surjective x
  obtain ⟨b, rfl⟩ := proj_surjective y
  rw [← map_add, ← map_zero (proj M), proj_eq_iff] at e
  obtain ⟨u, ⟨-, v, -, huv⟩, hab⟩ := e
  have ha : a ∈ unitsOf M := ⟨trivial, b + v, trivial, by
    rw [← add_assoc, hab, zero_add, huv]⟩
  exact proj_unit ha

/-- As used in the proof of Theorem 4.6, where it is cited from Ogus, *Lectures on Logarithmic
Algebraic Geometry*, Proposition 1.3.3: `M/M^×` is cancellative if `M` is. -/
theorem sharp_add_left_cancel [IsCancelAdd M] {a b c : Sharp M} (h : a + b = a + c) : b = c := by
  obtain ⟨a, rfl⟩ := proj_surjective a
  obtain ⟨b, rfl⟩ := proj_surjective b
  obtain ⟨c, rfl⟩ := proj_surjective c
  rw [← map_add, ← map_add, proj_eq_iff] at h
  obtain ⟨u, hu, e⟩ := h
  refine proj_eq_iff.2 ⟨u, hu, add_left_cancel (a := a) ?_⟩
  rw [e, add_assoc]

instance isCancelAdd_sharp [IsCancelAdd M] : IsCancelAdd (Sharp M) :=
  { add_left_cancel := fun _ _ _ h => sharp_add_left_cancel h
    add_right_cancel := fun c a b h => by
      have h' : a + c = b + c := h
      rw [add_comm a, add_comm b] at h'
      exact sharp_add_left_cancel h' }

/-- Membership in `f⁻¹(f(N))`, for `M^× ⊆ N`. -/
lemma mem_of_proj_mem_map {N : AddSubmonoid M} (hN : unitsOf M ≤ N) {x : M}
    (h : proj M x ∈ N.map (proj M)) : x ∈ N := by
  obtain ⟨y, hy, e⟩ := h
  obtain ⟨u, hu, rfl⟩ := proj_eq_iff.1 e.symm
  exact add_mem hy (hN hu)

lemma comap_map_proj {N : AddSubmonoid M} (hN : unitsOf M ≤ N) :
    (N.map (proj M)).comap (proj M) = N :=
  le_antisymm (fun _ hx => mem_of_proj_mem_map hN hx) (AddSubmonoid.le_comap_map N)

lemma map_comap_proj (P : AddSubmonoid (Sharp M)) : (P.comap (proj M)).map (proj M) = P :=
  AddSubmonoid.map_comap_eq_of_surjective proj_surjective P

lemma units_le_comap (P : AddSubmonoid (Sharp M)) : unitsOf M ≤ P.comap (proj M) := fun u hu => by
  change proj M u ∈ P
  rw [proj_unit hu]
  exact zero_mem _

/-- **Lemma 4.4.** `N ↦ N/M^×` and `P ↦ f⁻¹(P)` are mutually inverse bijections between the
submonoids of `M` containing `M^×` and the submonoids of `M/M^×`. (Journal p. 537: "{submonoids of `N`
containing `M^*`}"; `M` is meant.) -/
def lemma44 : {N : AddSubmonoid M // unitsOf M ≤ N} ≃ AddSubmonoid (Sharp M) where
  toFun N := N.1.map (proj M)
  invFun P := ⟨P.comap (proj M), units_le_comap P⟩
  left_inv N := Subtype.ext (comap_map_proj N.2)
  right_inv P := map_comap_proj P

end Quotient

section Section4

/-- **Lemma 4.1**, first step, for a submonoid that is a group. If `L` is a group and `g ∈ L ∖ N`,
then `J_N = 1`. Printed: "for all `n ∈ N`, we have `n = n + (-g) + g`"; here `x = g + (-g + x)` for
all `x ∈ L`. (The case `n = 0 ∈ N` of the printed identity already gives `J_N = 1`.) -/
lemma monIdeal_eq_of_group {L N : AddSubmonoid M} (hL : ∀ x ∈ L, ∃ y ∈ L, x + y = 0) (h : ¬ L ≤ N) :
    monIdeal L N = L := by
  refine Subset.antisymm monIdeal_subset fun x hx => ?_
  obtain ⟨g, hg, hgN⟩ := SetLike.not_le_iff_exists.mp h
  obtain ⟨y, hy, e⟩ := hL g hg
  exact ⟨g, hg, hgN, y + x, L.add_mem hy hx, by rw [← add_assoc, e, zero_add]⟩

lemma monIdeal_self (L : AddSubmonoid M) : monIdeal L L = ∅ := by
  refine eq_empty_of_forall_notMem ?_
  rintro x ⟨m, hm, hmN, -⟩
  exact hmN hm

lemma monIdeal_top_self : monIdeal (⊤ : AddSubmonoid M) ⊤ = ∅ := monIdeal_self _

section Group

variable {G : Type*} [AddCommGroup G]

/-- **Lemma 4.1**: `(𝔸(G)_S)^N = ∅` (`J_N = 1`) if `N ⊊ G`. -/
theorem lemma41_empty {N : AddSubmonoid G} (h : N ≠ ⊤) : monIdeal (⊤ : AddSubmonoid G) N = univ := by
  have := monIdeal_eq_of_group (L := (⊤ : AddSubmonoid G)) (N := N)
    (fun x _ => ⟨-x, trivial, add_neg_cancel x⟩) (fun hle => h (top_le_iff.mp hle))
  simpa using this

/-- **Lemma 4.1**: `(𝔸(G)_S)^G = 𝔸(G)_S`, i.e. `J_G = 0`. -/
theorem lemma41_top : monIdeal (⊤ : AddSubmonoid G) ⊤ = ∅ := monIdeal_top_self

/-- **Lemma 4.1**: if `G ≠ 0`, then `Π(a) = {0, G}`. -/
theorem lemma41_pure [Nontrivial G] : pureMagnets (monIdeal (⊤ : AddSubmonoid G)) = {⊥, ⊤} := by
  have hbt : (⊥ : AddSubmonoid G) ≠ ⊤ := bot_ne_top
  ext N
  simp only [mem_insert_iff, mem_singleton_iff]
  constructor
  · intro hN
    by_cases hNt : N = ⊤
    · exact Or.inr hNt
    · exact Or.inl (le_bot_iff.mp (hN ⊥ ((lemma41_empty hNt).trans (lemma41_empty hbt).symm)))
  · rintro (rfl | rfl)
    · exact isPure_bot
    · intro K e
      by_contra hne
      have hK : K ≠ ⊤ := fun e' => hne (by simp [e'])
      rw [lemma41_top, lemma41_empty hK] at e
      exact empty_ne_univ e

/-- **Lemma 4.1**: if `G = 0`, then `Π(a) = {0}`. -/
theorem lemma41_trivial [Subsingleton G] : pureMagnets (monIdeal (⊤ : AddSubmonoid G)) = {⊥} := by
  ext N
  simp only [mem_singleton_iff]
  constructor
  · exact fun _ => Subsingleton.elim _ _
  · rintro rfl
    exact isPure_bot

end Group

variable {N N' : AddSubmonoid M}

/-- **Proposition 4.2.** If `N` does not contain `M^×`, then `(𝔸(M)_S)^N = ∅`, i.e. `J_N = 1`. As
printed: `𝔸(M) → 𝔸(M^×)` is equivariant (`monIdeal_mono_left`, for Fact 3.15), and Lemma 4.1 applies
to `M^×`. The printed hypothesis `M^* ≠ 0` is implied by `¬ M^× ≤ N`, so it is not stated. -/
theorem prop42 (h : ¬ unitsOf M ≤ N) : monIdeal (⊤ : AddSubmonoid M) N = univ := by
  have h1 := monIdeal_eq_of_group (L := unitsOf M) (N := N)
    (fun _ hx => unitsFace_isGroup _ hx) h
  have h0 : (0 : M) ∈ monIdeal (unitsOf M) N := h1.symm ▸ zero_mem (unitsOf M)
  have h2 : (0 : M) ∈ monIdeal (⊤ : AddSubmonoid M) N :=
    monIdeal_mono_left le_top h0
  refine eq_univ_of_forall fun x => ?_
  simpa using add_mem_monIdeal h2 (show x ∈ (⊤ : AddSubmonoid M) from trivial)

/-- Not stated in the paper, but used in the proof of Proposition 4.5 ("We necessarily have
`M^* ⊂ Q` by Proposition 4.2"): if `N` contains `M^×`, then `J_N ≠ 1`. So the attractor is empty iff
`N` does not contain `M^×`, over a nonempty base. -/
theorem zero_notMem_monIdeal (h : unitsOf M ≤ N) : (0 : M) ∉ monIdeal (⊤ : AddSubmonoid M) N := by
  rintro ⟨m, -, hmN, t, -, e⟩
  exact hmN (h ⟨trivial, t, trivial, e.symm⟩)

theorem units_le_iff_monIdeal : unitsOf M ≤ N ↔ (0 : M) ∉ monIdeal (⊤ : AddSubmonoid M) N :=
  ⟨zero_notMem_monIdeal, fun h => by
    by_contra hc
    exact h ((prop42 hc).symm ▸ mem_univ _)⟩

lemma proj_notMem_map (hN : unitsOf M ≤ N) {m : M} (hm : m ∉ N) : proj M m ∉ N.map (proj M) :=
  fun h => hm (mem_of_proj_mem_map hN h)

/-- `J_N` determines `J_{N/M^×}`: the direction of Proposition 4.3 which is stated without proof in
the paper, "If `J_N = J_{N'}`, then `J_{N/M^*} = J_{N'/M^*}`"; it uses the surjection
`M ∖ N → M/M^* ∖ N/M^*` of the printed proof. -/
lemma monIdeal_proj_subset (hN' : unitsOf M ≤ N')
    (h : monIdeal (⊤ : AddSubmonoid M) N ⊆ monIdeal (⊤ : AddSubmonoid M) N') :
    monIdeal (⊤ : AddSubmonoid (Sharp M)) (N.map (proj M)) ⊆
      monIdeal (⊤ : AddSubmonoid (Sharp M)) (N'.map (proj M)) := by
  rintro x ⟨m, -, hmN, t, -, rfl⟩
  obtain ⟨m, rfl⟩ := proj_surjective m
  obtain ⟨t, rfl⟩ := proj_surjective t
  have hm : m ∉ N := fun h' => hmN ⟨m, h', rfl⟩
  obtain ⟨m', -, hm', t', -, e⟩ := h ⟨m, trivial, hm, t, trivial, rfl⟩
  refine ⟨proj M m', trivial, proj_notMem_map hN' hm', proj M t', trivial, ?_⟩
  rw [← map_add, ← map_add, e]

/-- The reciprocal direction of Proposition 4.3, as printed: `m̄ = t̄ + m̄'` lifts to
`m = t + g + m'`, with `g ∈ M^×`. -/
lemma monIdeal_of_proj_subset (hN : unitsOf M ≤ N)
    (h : monIdeal (⊤ : AddSubmonoid (Sharp M)) (N.map (proj M)) ⊆
      monIdeal (⊤ : AddSubmonoid (Sharp M)) (N'.map (proj M))) :
    monIdeal (⊤ : AddSubmonoid M) N ⊆ monIdeal (⊤ : AddSubmonoid M) N' := by
  rintro x ⟨m, -, hmN, t, -, rfl⟩
  obtain ⟨m', -, hm', t', -, e⟩ := h ⟨proj M m, trivial, proj_notMem_map hN hmN, proj M t, trivial, rfl⟩
  obtain ⟨m', rfl⟩ := proj_surjective m'
  obtain ⟨t', rfl⟩ := proj_surjective t'
  rw [← map_add, ← map_add, proj_eq_iff] at e
  obtain ⟨g, -, e⟩ := e
  exact ⟨m', trivial, fun h' => hm' ⟨m', h', rfl⟩, t' + g, trivial, by rw [e, add_assoc]⟩

/-- **Proposition 4.3.** For `N, N'` containing `M^×`: `𝔸(M)^N = 𝔸(M)^{N'}` iff
`𝔸(M/M^×)^{N/M^×} = 𝔸(M/M^×)^{N'/M^×}`. -/
theorem prop43 (hN : unitsOf M ≤ N) (hN' : unitsOf M ≤ N') :
    monIdeal (⊤ : AddSubmonoid M) N = monIdeal (⊤ : AddSubmonoid M) N' ↔
      monIdeal (⊤ : AddSubmonoid (Sharp M)) (N.map (proj M)) =
        monIdeal (⊤ : AddSubmonoid (Sharp M)) (N'.map (proj M)) :=
  ⟨fun h => Subset.antisymm (monIdeal_proj_subset hN' h.le) (monIdeal_proj_subset hN h.ge),
    fun h => Subset.antisymm (monIdeal_of_proj_subset hN h.le)
      (monIdeal_of_proj_subset hN' h.ge)⟩

/-- The key step of the proof of Proposition 4.5: `f⁻¹(P)` is pure if `P` is. The first line uses
that `(𝔸(M)_S)^{f⁻¹(P)}` is not empty (`zero_notMem_monIdeal`); the paper's "We necessarily have
`M^* ⊂ Q` by Proposition 4.2" needs this. -/
theorem isPure_comap_proj {P : AddSubmonoid (Sharp M)}
    (hP : IsPure (monIdeal (⊤ : AddSubmonoid (Sharp M))) P) :
    IsPure (monIdeal (⊤ : AddSubmonoid M)) (P.comap (proj M)) := by
  intro Q e
  have hQ : unitsOf M ≤ Q := by
    rw [units_le_iff_monIdeal, ← e]
    exact zero_notMem_monIdeal (units_le_comap P)
  have h1 := (prop43 (units_le_comap P) hQ).1 e
  rw [map_comap_proj] at h1
  have h2 := hP _ h1
  calc P.comap (proj M) ≤ (Q.map (proj M)).comap (proj M) := (AddSubmonoid.gc_map_comap (proj M)).monotone_u h2
    _ = Q := comap_map_proj hQ

/-- The second step of the proof of Proposition 4.5: a pure magnet containing `M^×` is `f⁻¹(P)`, with
`P = E(N/M^×)` pure. This does not use `M^× ≠ 0`. -/
theorem exists_comap_of_isPure (hN : IsPure (monIdeal (⊤ : AddSubmonoid M)) N)
    (hU : unitsOf M ≤ N) :
    ∃ P : AddSubmonoid (Sharp M), IsPure (monIdeal (⊤ : AddSubmonoid (Sharp M))) P ∧
      N = P.comap (proj M) := by
  let P := pureOfMagnet (⊤ : AddSubmonoid (Sharp M)) (N.map (proj M))
  have hP := isPure_pureOfMagnet (⊤ : AddSubmonoid (Sharp M)) (N.map (proj M))
  refine ⟨P, hP, IsPure.eq_of_monIdeal_eq hN (isPure_comap_proj hP) ?_⟩
  refine (prop43 hU (units_le_comap P)).2 ?_
  rw [map_comap_proj]
  exact (monIdeal_pureOfMagnet _ _).symm

/-- **Proposition 4.5.** If `M^× ≠ 0`, then `Π(a) = {0} ⊔ {f⁻¹(P) | P ∈ Π(ā)}`. -/
theorem prop45 (hU : unitsOf M ≠ ⊥) :
    pureMagnets (monIdeal (⊤ : AddSubmonoid M)) =
      {⊥} ∪ AddSubmonoid.comap (proj M) '' pureMagnets (monIdeal (⊤ : AddSubmonoid (Sharp M))) := by
  ext N
  constructor
  · intro hN
    by_cases hc : unitsOf M ≤ N
    · obtain ⟨P, hP, rfl⟩ := exists_comap_of_isPure hN hc
      exact Or.inr ⟨P, hP, rfl⟩
    · refine Or.inl (le_bot_iff.mp (hN ⊥ ?_))
      rw [prop42 hc, prop42]
      exact fun h => hU (le_bot_iff.mp h)
  · rintro (h | ⟨P, hP, rfl⟩)
    · rw [mem_singleton_iff.mp h]
      exact isPure_bot
    · exact isPure_comap_proj hP

/-- The union of Proposition 4.5 is disjoint: `f⁻¹(P)` contains `M^× ≠ 0`. -/
theorem comap_ne_bot (hU : unitsOf M ≠ ⊥) (P : AddSubmonoid (Sharp M)) :
    P.comap (proj M) ≠ ⊥ := fun e =>
  hU (le_bot_iff.mp (e ▸ units_le_comap P))

/-- Without `M^× ≠ 0`, the pure magnets containing `M^×` are the `f⁻¹(P)`; if `M^× = 0` these are all
of them. -/
theorem pure_of_units_eq_bot (hU : unitsOf M = ⊥) :
    pureMagnets (monIdeal (⊤ : AddSubmonoid M)) =
      AddSubmonoid.comap (proj M) '' pureMagnets (monIdeal (⊤ : AddSubmonoid (Sharp M))) := by
  ext N
  constructor
  · intro hN
    obtain ⟨P, hP, rfl⟩ := exists_comap_of_isPure hN (hU ▸ bot_le)
    exact ⟨P, hP, rfl⟩
  · rintro ⟨P, hP, rfl⟩
    exact isPure_comap_proj hP

lemma comap_injective_proj : Function.Injective (AddSubmonoid.comap (proj M)) :=
  AddSubmonoid.comap_injective_of_surjective proj_surjective

variable [IsCancelAdd M] {E : Set (Sharp M)}

/-- The sharp case of Theorem 4.6: Proposition 3.1 applied to `M/M^×`. -/
theorem pure_sharp (hE : IsMinimalGen E) (hgen : AddSubmonoid.closure E = ⊤) :
    pureMagnets (monIdeal (⊤ : AddSubmonoid (Sharp M))) = AddSubmonoid.closure '' 𝒫 E :=
  prop31_top hE hgen unitsFace_sharp

theorem thm46_injOn (hE : IsMinimalGen E) :
    InjOn (fun B : Set (Sharp M) => (AddSubmonoid.closure B).comap (proj M)) (𝒫 E) := by
  intro B hB B' hB' e
  have h1 := comap_injective_proj e
  rw [← closure_inter_eq hE hB, ← closure_inter_eq hE hB']
  exact congrArg (fun K : AddSubmonoid (Sharp M) => (K : Set (Sharp M)) ∩ E) h1

/-- **Theorem 4.6 (i)**, for a minimal generating set `E` of `M/M^×`: if `M^× = 0`, then
`B ↦ f⁻¹([B⟩)` is a bijection from `𝒫(E)` to `Π(a)`. Here `f` is an isomorphism; for `E ⊆ M` itself,
see `thm46_i`. -/
theorem thm46_i_quot (hE : IsMinimalGen E) (hgen : AddSubmonoid.closure E = ⊤)
    (hU : unitsOf M = ⊥) :
    BijOn (fun B : Set (Sharp M) => (AddSubmonoid.closure B).comap (proj M)) (𝒫 E)
      (pureMagnets (monIdeal (⊤ : AddSubmonoid M))) := by
  refine ⟨?_, thm46_injOn hE, ?_⟩
  · intro B hB
    refine isPure_comap_proj ?_
    have : AddSubmonoid.closure B ∈ pureMagnets (monIdeal (⊤ : AddSubmonoid (Sharp M))) := by
      rw [pure_sharp hE hgen]
      exact ⟨B, hB, rfl⟩
    exact this
  · intro N hN
    rw [pure_of_units_eq_bot hU, pure_sharp hE hgen] at hN
    obtain ⟨_, ⟨B, hB, rfl⟩, rfl⟩ := hN
    exact ⟨B, hB, rfl⟩

/-- **Theorem 4.6 (ii)**: if `M^× ≠ 0`, then `Π(a) = {0} ⊔ {f⁻¹([B⟩) | B ∈ 𝒫(E)}`. -/
theorem thm46_ii (hE : IsMinimalGen E) (hgen : AddSubmonoid.closure E = ⊤) (hU : unitsOf M ≠ ⊥) :
    pureMagnets (monIdeal (⊤ : AddSubmonoid M)) =
      {⊥} ∪ (fun B : Set (Sharp M) => (AddSubmonoid.closure B).comap (proj M)) '' 𝒫 E := by
  rw [prop45 hU, pure_sharp hE hgen, image_image]

/-- **Theorem 4.6**, "In particular": `#Π(a) = 2^{#E}` if `M^× = 0`. -/
theorem thm46_card_i (hE : IsMinimalGen E) (hgen : AddSubmonoid.closure E = ⊤)
    (hU : unitsOf M = ⊥) :
    Cardinal.mk (pureMagnets (monIdeal (⊤ : AddSubmonoid M))) = 2 ^ Cardinal.mk E := by
  rw [← Cardinal.mk_powerset]
  exact (Cardinal.mk_congr (thm46_i_quot hE hgen hU).equiv).symm

/-- **Theorem 4.6**, "In particular": `#Π(a) = 2^{#E} + 1` if `M^× ≠ 0`. -/
theorem thm46_card_ii (hE : IsMinimalGen E) (hgen : AddSubmonoid.closure E = ⊤)
    (hU : unitsOf M ≠ ⊥) :
    Cardinal.mk (pureMagnets (monIdeal (⊤ : AddSubmonoid M))) = 2 ^ Cardinal.mk E + 1 := by
  rw [← Cardinal.mk_powerset, ← Cardinal.mk_option]
  let F : Option (𝒫 E) → pureMagnets (monIdeal (⊤ : AddSubmonoid M)) := fun o =>
    match o with
    | none => ⟨⊥, isPure_bot⟩
    | some B => ⟨(AddSubmonoid.closure B.1).comap (proj M), by
        rw [thm46_ii hE hgen hU]
        exact Or.inr ⟨B.1, B.2, rfl⟩⟩
  refine (Cardinal.mk_congr (Equiv.ofBijective F ⟨?_, ?_⟩)).symm
  · rintro (_ | B) (_ | B') e
    · rfl
    · exact absurd (congrArg Subtype.val e).symm (comap_ne_bot hU _)
    · exact absurd (congrArg Subtype.val e) (comap_ne_bot hU _)
    · exact congrArg some (Subtype.ext (thm46_injOn hE B.2 B'.2 (congrArg Subtype.val e)))
  · rintro ⟨N, hN⟩
    have hN' := hN
    rw [thm46_ii hE hgen hU] at hN'
    rcases hN' with h | ⟨B, hB, rfl⟩
    · exact ⟨none, Subtype.ext (mem_singleton_iff.mp h).symm⟩
    · exact ⟨some ⟨B, hB⟩, rfl⟩

omit [IsCancelAdd M] in
/-- **Theorem 4.6 (i)**, for a minimal generating set `E` of `M` itself (`M/0 = M`): `B ↦ [B⟩` is a
bijection from `𝒫(E)` to `Π(a)`. -/
theorem thm46_i [IsCancelAdd M] {E : Set M} (hE : IsMinimalGen E) (hgen : AddSubmonoid.closure E = ⊤)
    (hU : unitsOf M = ⊥) :
    BijOn AddSubmonoid.closure (𝒫 E) (pureMagnets (monIdeal (⊤ : AddSubmonoid M))) := by
  rw [prop31_top hE hgen hU]
  refine ⟨mapsTo_image _ _, ?_, surjOn_image _ _⟩
  intro B hB B' hB' e
  rw [← closure_inter_eq hE hB, ← closure_inter_eq hE hB', e]

end Section4

