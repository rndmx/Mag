import AlgMag.Sec3LeftoverAct
import Mathlib.AlgebraicGeometry.Modules.Tilde
import Mathlib.Algebra.Category.ModuleCat.Basic
import StacksFrontier.AlgebraicGeometry.AffineBaseChange.Basic

/-!
# Sections over an affine scheme of a direct sum of quasi-coherent modules are finite sums
-/

universe u

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry TopologicalSpace

noncomputable section

namespace AlgMag.P221

variable {M : Type u}

section Aux
variable {R : CommRingCat.{u}}

/-- The quotient map. -/
def qOf (Y : ModuleCat.{u} R) (N : Submodule R Y) : Y ⟶ ModuleCat.of R (Y ⧸ N) :=
  ModuleCat.ofHom N.mkQ

lemma comp_qOf {Y Z : ModuleCat.{u} R} (N : Submodule R Y) (f : Z ⟶ Y)
    (h : LinearMap.range f.hom ≤ N) : f ≫ qOf Y N = 0 := by
  ext y
  exact (Submodule.Quotient.mk_eq_zero N).2 (h ⟨y, rfl⟩)

lemma eq_top_of_qOf {Y : ModuleCat.{u} R} (N : Submodule R Y) (h : qOf Y N = 0) : N = ⊤ := by
  rw [eq_top_iff]
  intro y _
  have := congrArg (fun k => k.hom y) h
  exact (Submodule.Quotient.mk_eq_zero N).1 this

end Aux

/-- On `Spec R`: the sections of a direct sum of quasi-coherent modules are generated by the summands. -/
theorem iSup_range_spec {R : CommRingCat.{u}} {X : M → (Spec R).Modules} {P : (Spec R).Modules}
    [hq : ∀ m, (X m).IsQuasicoherent] [P.IsQuasicoherent] (ι : ∀ m, X m ⟶ P)
    (hc : IsColimit (Cofan.mk P ι)) :
    ⨆ m, LinearMap.range (moduleSpecΓFunctor.map (ι m)).hom = ⊤ := by
  refine eq_top_of_qOf _ ?_
  generalize hN : (⨆ m, LinearMap.range (moduleSpecΓFunctor.map (ι m)).hom) = N
  have isoP : IsIso (Scheme.Modules.fromTildeΓNatTrans.app P) :=
    (isQuasicoherent_iff_isIso_fromTildeΓ P).mp inferInstance
  have isoX : ∀ m, IsIso (Scheme.Modules.fromTildeΓNatTrans.app (X m)) := fun m =>
    (isQuasicoherent_iff_isIso_fromTildeΓ (X m)).mp inferInstance
  have hz : ∀ m, moduleSpecΓFunctor.map (ι m) ≫ qOf _ N = 0 := fun m =>
    comp_qOf N _ (hN ▸ le_iSup (fun m => LinearMap.range (moduleSpecΓFunctor.map (ι m)).hom) m)
  have hψ : inv (Scheme.Modules.fromTildeΓNatTrans.app P) ≫ (tilde.functor R).map (qOf _ N) = 0 := by
    refine Cofan.IsColimit.hom_ext hc _ _ fun m => ?_
    have nat := Scheme.Modules.fromTildeΓNatTrans.naturality (ι m)
    have nat' : ι m ≫ inv (Scheme.Modules.fromTildeΓNatTrans.app P) =
        inv (Scheme.Modules.fromTildeΓNatTrans.app (X m)) ≫
          (tilde.functor R).map (moduleSpecΓFunctor.map (ι m)) := by
      rw [IsIso.comp_inv_eq, Category.assoc, IsIso.eq_inv_comp]
      exact nat.symm
    change ι m ≫ _ = ι m ≫ _
    rw [comp_zero, ← Category.assoc, nat', Category.assoc, ← Functor.map_comp, hz, Functor.map_zero,
      comp_zero]
  have hq0 : (tilde.functor R).map (qOf _ N) = 0 := by
    rwa [IsIso.inv_comp_eq, comp_zero] at hψ
  exact tilde.fullyFaithfulFunctor.map_injective (by rw [hq0, Functor.map_zero])

/-- Induction on the sections over an affine scheme of a direct sum of quasi-coherent modules. -/
theorem sec_induction {T : Scheme.{u}} [IsAffine T] {X : M → T.Modules} {P : T.Modules}
    [hq : ∀ m, (X m).IsQuasicoherent] [hP : P.IsQuasicoherent] (ι : ∀ m, X m ⟶ P)
    (hc : IsColimit (Cofan.mk P ι)) {C : Γ(P, ⊤) → Prop} (h0 : C 0)
    (hadd : ∀ a b, C a → C b → C (a + b)) (hι : ∀ m (y : Γ(X m, ⊤)), C ((ι m).app ⊤ y))
    (x : Γ(P, ⊤)) : C x := by
  let e := T.isoSpec
  let G := Scheme.Modules.restrictFunctor e.inv
  haveI : ∀ m, (G.obj (X m)).IsQuasicoherent := fun m =>
    Scheme.Modules.isQuasicoherent_restrictFunctor e.inv (X m)
  haveI : (G.obj P).IsQuasicoherent := Scheme.Modules.isQuasicoherent_restrictFunctor e.inv P
  have hc' := isColimitCofanMkObjOfIsColimit G X ι hc
  have ht := iSup_range_spec (fun m => G.map (ι m)) hc'
  have hU : e.inv ''ᵁ (⊤ : (Spec Γ(T, ⊤)).Opens) = ⊤ := by
    simp
  have key : ∀ (x' : moduleSpecΓFunctor.obj (G.obj P)),
      ∀ (D : (moduleSpecΓFunctor.obj (G.obj P)) → Prop), D 0 → (∀ a b, D a → D b → D (a + b)) →
      (∀ m y, D ((moduleSpecΓFunctor.map (G.map (ι m))).hom y)) → D x' := by
    intro x' D d0 dadd dι
    have hx : x' ∈ ⨆ m, LinearMap.range (moduleSpecΓFunctor.map (G.map (ι m))).hom := ht ▸ trivial
    refine Submodule.iSup_induction _ (motive := D) hx ?_ d0 dadd
    rintro m _ ⟨y, rfl⟩
    exact dι m y
  have hle : e.inv ''ᵁ (⊤ : (Spec Γ(T, ⊤)).Opens) ≤ ⊤ := le_top
  have hiso : IsIso (homOfLE hle).op := by
    have : IsIso (homOfLE hle) := ⟨homOfLE hU.ge, Subsingleton.elim _ _, Subsingleton.elim _ _⟩
    infer_instance
  have bij : ∀ Z : T.Modules, Function.Bijective (Z.presheaf.map (homOfLE hle).op) := fun Z =>
    ConcreteCategory.bijective_of_isIso (Z.presheaf.map (homOfLE hle).op)
  let r : Γ(P, ⊤) →+ Γ(P, e.inv ''ᵁ ⊤) := (P.presheaf.map (homOfLE hle).op).hom
  have main := key (r x : Γ(P, e.inv ''ᵁ ⊤)) (fun y => ∀ x, r x = (y : Γ(P, e.inv ''ᵁ ⊤)) → C x)
    (fun x hx => by
      have : x = 0 := (bij P).1 (hx.trans (map_zero r).symm)
      rw [this]; exact h0)
    (fun a b ha hb x hx => by
      obtain ⟨a', ha'⟩ := (bij P).2 a
      obtain ⟨b', hb'⟩ := (bij P).2 b
      have : x = a' + b' := (bij P).1 (hx.trans (by
        refine Eq.trans ?_ (map_add r a' b').symm
        exact congrArg₂ (· + ·) ha'.symm hb'.symm))
      rw [this]
      exact hadd _ _ (ha a' ha') (hb b' hb'))
    (fun m y x hx => by
      obtain ⟨y', hy'⟩ := (bij (X m)).2 y
      have e1 : r ((ι m).app ⊤ y') = (ι m).app (e.inv ''ᵁ ⊤) y :=
        ((PresheafOfModules.naturality_apply (ι m).val (homOfLE hle).op y').symm.trans
          (congrArg _ hy'))
      have : x = (ι m).app ⊤ y' := (bij P).1 (hx.trans e1.symm)
      rw [this]
      exact hι m y')
  exact main x rfl

end AlgMag.P221
