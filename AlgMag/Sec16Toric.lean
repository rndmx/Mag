import AlgMag.Sec2Monoids
import Mathlib.Algebra.MonoidAlgebra.Ideal
import Mathlib.Algebra.Group.Submonoid.Membership
import Mathlib.Algebra.Order.Group.Unbundled.Int
import Mathlib.Tactic.Linarith

/-!
# Attractors of `𝔸(N)` (Algebraic Magnetism, §16.7, first paragraph; unnumbered)

`M` is a commutative monoid, `N, L` magnets. With `𝔸(N) = Spec R[N]` graded by `M`, the attractor
`𝔸(N)^L` is `Spec R[N]/J_L` by Theorem 3.20, where `J_L = Magnetism.magnetIdeal`. The paper has
`R = ℤ`; here `R` is any nontrivial commutative ring where needed. The second paragraph of §16.7
(toric monoschemes) is not here: monoschemes are absent from the libraries.
-/

open Magnetism

namespace AlgMag.Toric

variable {M : Type*} [AddCommMonoid M] (R : Type*) [CommRing R] (N L : AddSubmonoid M)

/-- The `M`-grading of `R[N]`. -/
noncomputable abbrev grading : M → Submodule R (AddMonoidAlgebra R N) :=
  AddMonoidAlgebra.gradeBy R N.subtype

/-- The elements of `N \ (N ∩ L)`. -/
def outside : Set N := {x | (x : M) ∉ L}

/-- **§16.7.** The ideal `I` of the monoid `N` generated by `N \ (N ∩ L)`. -/
def monoIdeal : Set N := {n | ∃ x y : N, (x : M) ∉ L ∧ n = x + y}

/-- **§16.7.** `A(N)^L = Spec R[N]/(X^n | n ∈ N \ (N ∩ L))`. -/
theorem magnetIdeal_grading :
    magnetIdeal (grading R N) L =
      Ideal.span (AddMonoidAlgebra.of' R N '' outside N L) := by
  classical
  apply le_antisymm
  · refine Ideal.span_le.2 ?_
    intro f hf
    simp only [Set.mem_iUnion, SetLike.mem_coe] at hf
    obtain ⟨m, hm, hf⟩ := hf
    refine SetLike.mem_coe.2 (AddMonoidAlgebra.mem_ideal_span_of'_image.2 fun n hn => ?_)
    have h : (n : M) = m := hf n hn
    exact ⟨n, by change (n : M) ∉ L; rwa [h], 0, (zero_add n).symm⟩
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨n, hn, rfl⟩
    exact mem_magnetIdeal_of_notMem hn (AddMonoidAlgebra.single_mem_gradeBy _ _ _)

/-- **§16.7.** The ideal `(X^n | n ∈ N \ (N ∩ L))` equals `⨁_{i ∈ I} R X^i`. -/
theorem mem_magnetIdeal_iff (f : AddMonoidAlgebra R N) :
    f ∈ magnetIdeal (grading R N) L ↔ ∀ n ∈ f.coeff.support, n ∈ monoIdeal N L := by
  rw [magnetIdeal_grading, AddMonoidAlgebra.mem_ideal_span_of'_image]
  refine forall₂_congr fun n _ => ⟨?_, ?_⟩
  · rintro ⟨x, hx, d, e⟩
    exact ⟨x, d, hx, e.trans (add_comm _ _)⟩
  · rintro ⟨x, y, hx, e⟩
    exact ⟨x, hx, y, e.trans (add_comm _ _)⟩

/-- **§16.7.** If the submonoid `F` of `N` is a face and its elements are exactly those of `N` not
in `I`, then `R[N]/(X^n | n ∈ N \ (N ∩ L)) = R[F]`, so `𝔸(N)^L = 𝔸(F)`. -/
noncomputable def quotientEquiv [Nontrivial R] {F : AddSubmonoid M} (hF : F ≤ N)
    (hc : FaceCond F N) (hI : ∀ n : N, (n : M) ∈ F ↔ n ∉ monoIdeal N L) :
    (AddMonoidAlgebra R N ⧸ magnetIdeal (grading R N) L) ≃+* AddMonoidAlgebra R F := by
  have hker : RingHom.ker (faceProjAlgHom (R := R) hF hc) = magnetIdeal (grading R N) L := by
    ext f
    rw [RingHom.mem_ker, mem_magnetIdeal_iff]
    constructor
    · intro h n hn
      by_contra hnI
      have hnF := (hI n).2 hnI
      have : f.coeff n = 0 := by
        have h2 := congrArg (fun g => g.coeff (⟨n, hnF⟩ : F)) h
        exact h2
      exact (Finsupp.mem_support_iff.1 hn) this
    · intro h
      refine AddMonoidAlgebra.coeff_inj.mp (Finsupp.ext fun g => ?_)
      change f.coeff (AddSubmonoid.inclusion hF g) = 0
      by_contra hne
      exact (hI (AddSubmonoid.inclusion hF g)).1 g.2 (h _ (Finsupp.mem_support_iff.2 hne))
  have hsurj : Function.Surjective (faceProjAlgHom (R := R) hF hc) := fun g => by
    refine ⟨incl R hF g, ?_⟩
    refine AddMonoidAlgebra.coeff_inj.mp (Finsupp.ext fun k => ?_)
    change (incl R hF g).coeff (AddSubmonoid.inclusion hF k) = g.coeff k
    simp only [incl]
    exact Finsupp.mapDomain_apply (AddSubmonoid.inclusion_injective hF) _ _
  exact (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj)

/-- **§16.7.** `I` is a prime ideal of `N`: its complement is a submonoid. -/
structure IsPrimeIdeal : Prop where
  zero : (0 : N) ∉ monoIdeal N L
  add : ∀ {a b : N}, a ∉ monoIdeal N L → b ∉ monoIdeal N L → a + b ∉ monoIdeal N L

variable {N L} in
lemma monoIdeal_add {a b : N} (ha : a ∈ monoIdeal N L) : a + b ∈ monoIdeal N L := by
  obtain ⟨x, y, hx, rfl⟩ := ha
  exact ⟨x, y + b, hx, add_assoc _ _ _⟩

/-- **§16.7.** If `I` is prime, `N \ I` is a submonoid of `M`. -/
def complementMagnet (h : IsPrimeIdeal N L) : AddSubmonoid M where
  carrier := {m | ∃ n : N, n ∉ monoIdeal N L ∧ (n : M) = m}
  zero_mem' := ⟨0, h.zero, rfl⟩
  add_mem' := by
    rintro _ _ ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
    exact ⟨a + b, h.add ha hb, rfl⟩

lemma mem_complementMagnet (h : IsPrimeIdeal N L) (n : N) :
    (n : M) ∈ complementMagnet N L h ↔ n ∉ monoIdeal N L := by
  constructor
  · rintro ⟨n', hn', e⟩
    rwa [← Subtype.ext e]
  · exact fun hn => ⟨n, hn, rfl⟩

lemma complementMagnet_le (h : IsPrimeIdeal N L) : complementMagnet N L h ≤ N := by
  rintro _ ⟨n, _, rfl⟩
  exact n.2

/-- **§16.7.** If `I` is prime, `N \ I` is "necessarily a face". -/
theorem faceCond_complement (h : IsPrimeIdeal N L) : FaceCond (complementMagnet N L h) N := by
  intro x hx y hy hxy
  have hn := (mem_complementMagnet N L h (⟨x, hx⟩ + ⟨y, hy⟩)).1 hxy
  refine ⟨(mem_complementMagnet N L h ⟨x, hx⟩).2 fun hI => hn (monoIdeal_add hI), ?_⟩
  refine (mem_complementMagnet N L h ⟨y, hy⟩).2 fun hI => hn ?_
  rw [add_comm]
  exact monoIdeal_add hI

/-- **§16.7.** If `I` is prime, `R[N]/I = R[N \ I]`: `𝔸(N)^L` is the scheme of a submonoid of `M`. -/
noncomputable def primeQuotientEquiv [Nontrivial R] (h : IsPrimeIdeal N L) :
    (AddMonoidAlgebra R N ⧸ magnetIdeal (grading R N) L) ≃+*
      AddMonoidAlgebra R (complementMagnet N L h) :=
  quotientEquiv R N L (complementMagnet_le N L h) (faceCond_complement N L h)
    (mem_complementMagnet N L h)

/-- **§16.7.** If `N ∩ L` is a face of `N`, then `N \ I = N ∩ L`. -/
theorem notMem_monoIdeal_iff (hf : FaceCond (N ⊓ L) N) (n : N) :
    n ∉ monoIdeal N L ↔ (n : M) ∈ L := by
  constructor
  · intro h
    by_contra hn
    exact h ⟨n, 0, hn, (add_zero n).symm⟩
  · rintro h ⟨x, y, hx, rfl⟩
    exact hx (hf x x.2 y y.2 ⟨(x + y).2, h⟩).1.2

/-- **§16.7.** If `N ∩ L` is a face of `N`, then `𝔸(N)^L = 𝔸(N ∩ L)`. -/
noncomputable def faceQuotientEquiv [Nontrivial R] (hf : FaceCond (N ⊓ L) N) :
    (AddMonoidAlgebra R N ⧸ magnetIdeal (grading R N) L) ≃+* AddMonoidAlgebra R (N ⊓ L : AddSubmonoid M) :=
  quotientEquiv R N L inf_le_left hf fun n =>
    ⟨fun h => (notMem_monoIdeal_iff N L hf n).2 h.2,
      fun h => ⟨n.2, (notMem_monoIdeal_iff N L hf n).1 h⟩⟩

/-! ### The example -/

/-- `N = [(1,1), (1,-1), (1,0)⟩` in `M = ℤ²`. -/
def exN : AddSubmonoid (ℤ × ℤ) := AddSubmonoid.closure {(1, 1), (1, -1), (1, 0)}

/-- `L = [(1,0)⟩`. -/
def exL : AddSubmonoid (ℤ × ℤ) := AddSubmonoid.closure {(1, 0)}

lemma exN_abs {x : ℤ × ℤ} (h : x ∈ exN) : -x.1 ≤ x.2 ∧ x.2 ≤ x.1 := by
  induction h using AddSubmonoid.closure_induction with
  | mem x hx =>
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl <;> norm_num
  | zero => simp
  | add x y _ _ hx hy =>
    simp only [Prod.fst_add, Prod.snd_add]
    constructor <;> linarith [hx.1, hx.2, hy.1, hy.2]

lemma exL_snd {x : ℤ × ℤ} (h : x ∈ exL) : x.2 = 0 := by
  induction h using AddSubmonoid.closure_induction with
  | mem x hx =>
    rw [Set.mem_singleton_iff] at hx
    rw [hx]
  | zero => rfl
  | add x y _ _ hx hy => simp [hx, hy]

lemma exL_of_nonneg (a : ℕ) : ((a : ℤ), (0 : ℤ)) ∈ exL := by
  induction a with
  | zero => exact exL.zero_mem
  | succ k ih =>
    have := exL.add_mem ih (AddSubmonoid.subset_closure rfl : ((1 : ℤ), (0 : ℤ)) ∈ exL)
    simpa using this

lemma exN_of_nat (a : ℕ) : ((a : ℤ), (0 : ℤ)) ∈ exN := by
  induction a with
  | zero => exact exN.zero_mem
  | succ k ih =>
    have := exN.add_mem ih
      (AddSubmonoid.subset_closure (by simp) : ((1 : ℤ), (0 : ℤ)) ∈ exN)
    simpa using this

/-- **§16.7, example.** `N \ I = {(0,0), (1,0)}`. -/
theorem ex_complement (n : exN) :
    n ∉ monoIdeal exN exL ↔ (n : ℤ × ℤ) = (0, 0) ∨ (n : ℤ × ℤ) = (1, 0) := by
  obtain ⟨⟨a, b⟩, hn⟩ := n
  have hb := exN_abs hn
  simp only at hb
  constructor
  · intro h
    by_contra hne
    apply h
    by_cases hb0 : b = 0
    · subst hb0
      have ha2 : 2 ≤ a := by
        by_contra hlt
        have h0 : a = 0 ∨ a = 1 := by omega
        rcases h0 with rfl | rfl
        · exact hne (Or.inl rfl)
        · exact hne (Or.inr rfl)
      obtain ⟨k, rfl⟩ : ∃ k : ℕ, a = (k : ℤ) + 2 := ⟨(a - 2).toNat, by omega⟩
      have h1 : ((1 : ℤ), (1 : ℤ)) ∈ exN := AddSubmonoid.subset_closure (by simp)
      have h2 : ((1 : ℤ), (-1 : ℤ)) ∈ exN := AddSubmonoid.subset_closure (by simp)
      refine ⟨⟨(1, 1), h1⟩, ⟨((k : ℤ) + 1, -1), ?_⟩, ?_, ?_⟩
      · have := exN.add_mem (exN_of_nat k) h2
        simpa using this
      · intro hl
        have := exL_snd hl
        simp at this
      · refine Subtype.ext (Prod.ext ?_ ?_)
        · change (k : ℤ) + 2 = 1 + ((k : ℤ) + 1)
          ring
        · change (0 : ℤ) = 1 + -1
          norm_num
    · refine ⟨⟨(a, b), hn⟩, 0, ?_, (add_zero _).symm⟩
      intro hl
      exact hb0 (exL_snd hl)
  · rintro h ⟨⟨⟨p, q⟩, hx⟩, ⟨⟨r, s⟩, hy⟩, hxL, e⟩
    have e1 : a = p + r := congrArg (fun z : exN => (z : ℤ × ℤ).1) e
    have hq := exN_abs hx
    have hs := exN_abs hy
    simp only at hq hs
    have hq0 : q ≠ 0 := by
      rintro rfl
      apply hxL
      obtain ⟨k, rfl⟩ : ∃ k : ℕ, p = (k : ℤ) := ⟨p.toNat, by omega⟩
      exact exL_of_nonneg k
    have e2 : b = q + s := congrArg (fun z : exN => (z : ℤ × ℤ).2) e
    have hab : a ≤ 1 ∧ b = 0 := by
      rcases h with h | h
      · exact ⟨by have := congrArg Prod.fst h; simp only at this; omega, congrArg Prod.snd h⟩
      · exact ⟨by have := congrArg Prod.fst h; simp only at this; omega, congrArg Prod.snd h⟩
    obtain ⟨ha1, hb0⟩ := hab
    omega

/-- **§16.7, example.** For `M = ℤ²`, `N`, `L` as above, `I` is not prime: `N \ I` is not a
submonoid. -/
theorem ex_not_prime : ¬ IsPrimeIdeal exN exL := by
  intro h
  have h10 : ((1 : ℤ), (0 : ℤ)) ∈ exN := AddSubmonoid.subset_closure (by simp)
  have hn : (⟨(1, 0), h10⟩ : exN) ∉ monoIdeal exN exL := (ex_complement _).2 (Or.inr rfl)
  have := (ex_complement _).1 (h.add hn hn)
  rcases this with h1 | h1
  · have := congrArg Prod.fst h1
    norm_num at this
  · have := congrArg Prod.fst h1
    norm_num at this

end AlgMag.Toric
