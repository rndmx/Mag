import Mathlib.LinearAlgebra.SymmetricAlgebra.Basic
import Mathlib.RingTheory.Smooth.Basic
import Mathlib.Algebra.Polynomial.AlgebraMap
import Mathlib.Algebra.Polynomial.Coeff

/-!
# Theorem 12.4 and Corollary 12.5: the ring computation

Mayeux, *Algebraic Magnetism*, Theorem 12.4. The injectivity of `Sym(I/I²) → A`. The printed proof
uses that `X⁰ → X^N` is a regular immersion (Tags 067U, 062Z, 063M). Here formal smoothness of
`A₀ → A` is used directly: the identity of `Sym/J²` lifts to maps `A → Sym/J^k`.
-/

universe u

namespace AlgMag.SymRing

variable {A₀ A P : Type u} [CommRing A₀] [CommRing A] [Algebra A₀ A] [AddCommGroup P] [Module A₀ P]

local notation "Sy" => SymmetricAlgebra A₀ P
local notation "ιS" => SymmetricAlgebra.ι A₀ P

variable (A₀ P) in
/-- The ideal `J` of `Sym(P)` generated by `P`. -/
def augIdeal : Ideal (SymmetricAlgebra A₀ P) := Ideal.span (Set.range (SymmetricAlgebra.ι A₀ P))

local notation "JJ" => augIdeal A₀ P

lemma ι_mem (p : P) : ιS p ∈ JJ := Ideal.subset_span ⟨p, rfl⟩

/-- The intersection of the powers of `J` vanishes: scale `P` by a variable. -/
lemma eq_zero_of_mem_pow (x : Sy) (h : ∀ m : ℕ, x ∈ JJ ^ m) : x = 0 := by
  let τl : P →ₗ[A₀] Polynomial Sy :=
    { toFun := fun p => Polynomial.C (ιS p) * Polynomial.X
      map_add' := fun a b => by simp [add_mul]
      map_smul' := fun r a => by
        rw [map_smul, ← Polynomial.smul_C, smul_mul_assoc]
        rfl }
  let τ : Sy →ₐ[A₀] Polynomial Sy := SymmetricAlgebra.lift τl
  let ev : Polynomial Sy →ₐ[A₀] Sy := (Polynomial.aeval (1 : Sy)).restrictScalars A₀
  have hev : ev.comp τ = AlgHom.id A₀ Sy := by
    refine SymmetricAlgebra.algHom_ext (LinearMap.ext fun p => ?_)
    change ev (τ (ιS p)) = ιS p
    rw [SymmetricAlgebra.lift_ι_apply]
    change Polynomial.aeval (1 : Sy) (Polynomial.C (ιS p) * Polynomial.X) = _
    simp
  have hJ : JJ ≤ (Ideal.span {(Polynomial.X : Polynomial Sy)}).comap τ.toRingHom := by
    refine Ideal.span_le.2 ?_
    rintro _ ⟨p, rfl⟩
    change τ (ιS p) ∈ Ideal.span {(Polynomial.X : Polynomial Sy)}
    rw [SymmetricAlgebra.lift_ι_apply]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  have hτ : τ x = 0 := by
    refine Polynomial.ext fun d => ?_
    have h₁ : τ x ∈ Ideal.span {(Polynomial.X : Polynomial Sy)} ^ (d + 1) :=
      (Ideal.pow_right_mono hJ (d + 1)).trans (Ideal.le_comap_pow _ _) (h (d + 1))
    rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at h₁
    simpa using Polynomial.X_pow_dvd_iff.1 h₁ d (Nat.lt_succ_self d)
  have := congrArg (fun f : Sy →ₐ[A₀] Sy => f x) hev
  simp only [AlgHom.comp_apply, hτ, map_zero, AlgHom.id_apply] at this
  exact this.symm

lemma pow_mul_mem {a b : Sy} {m n : ℕ} (ha : a ∈ JJ ^ m) (hb : b ∈ JJ ^ n) : a * b ∈ JJ ^ (m + n) := by
  rw [pow_add]
  exact Ideal.mul_mem_mul ha hb

lemma mem_of_le {a : Sy} {m n : ℕ} (h : n ≤ m) (ha : a ∈ JJ ^ m) : a ∈ JJ ^ n :=
  Ideal.pow_le_pow_right h ha

/-- The quotient map. -/
noncomputable abbrev mk (k : ℕ) : Sy →ₐ[A₀] Sy ⧸ JJ ^ k := Ideal.Quotient.mkₐ A₀ (JJ ^ k)

lemma mk_eq_iff {k : ℕ} {a b : Sy} : mk (A₀ := A₀) (P := P) k a = mk k b ↔ a - b ∈ JJ ^ k :=
  Ideal.Quotient.eq

section Main

variable [Algebra.FormallySmooth A₀ A] (π : A →ₐ[A₀] A₀) (t : A →ₗ[A₀] P)
  (ht : ∀ a b, t (a * b) = π a • t b + π b • t a) (s : P →ₗ[A₀] A)
  (hπs : ∀ p, π (s p) = 0) (hts : ∀ p, t (s p) = p)

include ht in
lemma t_one : t 1 = 0 := by
  have := ht 1 1
  simp only [mul_one, map_one, one_smul] at this
  exact left_eq_add.1 this

include ht in
/-- The map `A → Sym/J²`, `a ↦ π a + t a`. -/
lemma exists_psi2 : ∃ ψ : A →ₐ[A₀] Sy ⧸ JJ ^ 2, ∀ a, ψ a = mk 2 (algebraMap A₀ Sy (π a) + ιS (t a)) := by
  refine ⟨{ toFun := fun a => mk 2 (algebraMap A₀ Sy (π a) + ιS (t a))
            map_one' := by
              rw [map_one, t_one π t ht, map_zero, map_one, add_zero, map_one]
            map_zero' := by simp
            map_add' := fun a b => by
              rw [← map_add]
              congr 1
              simp only [map_add]
              ring
            map_mul' := fun a b => by
              rw [← map_mul, mk_eq_iff, map_mul, ht, map_mul, map_add, map_smul, map_smul]
              have e : ιS (t a) * ιS (t b) ∈ JJ ^ 2 := by
                rw [pow_two]
                exact Ideal.mul_mem_mul (ι_mem _) (ι_mem _)
              rw [Algebra.smul_def, Algebra.smul_def]
              have : (algebraMap A₀ Sy (π a) * algebraMap A₀ Sy (π b) +
                  (algebraMap A₀ Sy (π a) * ιS (t b) + algebraMap A₀ Sy (π b) * ιS (t a))) -
                  (algebraMap A₀ Sy (π a) + ιS (t a)) * (algebraMap A₀ Sy (π b) + ιS (t b)) =
                  -(ιS (t a) * ιS (t b)) := by ring
              rw [this]
              exact Ideal.neg_mem_iff _ |>.2 e
            commutes' := fun r => by
              have h₁ : t (algebraMap A₀ A r) = 0 := by
                rw [Algebra.algebraMap_eq_smul_one, map_smul, t_one π t ht, smul_zero]
              rw [h₁, map_zero, add_zero, AlgHom.commutes, AlgHom.commutes]
              rfl }, fun a => rfl⟩

include ht hπs hts in
/-- Lifts `A → Sym/J^(k+2)`. -/
lemma exists_psi (k : ℕ) : ∃ ψ : A →ₐ[A₀] Sy ⧸ JJ ^ (k + 2),
    ∀ p, ∃ y ∈ JJ ^ 2, ψ (s p) = mk (k + 2) (ιS p + y) := by
  induction k with
  | zero =>
    obtain ⟨ψ, hψ⟩ := exists_psi2 π t ht
    refine ⟨ψ, fun p => ⟨0, Ideal.zero_mem _, ?_⟩⟩
    rw [hψ, hπs, hts, map_zero]
    change mk 2 _ = mk 2 _
    rw [zero_add, add_zero]
  | succ k ih =>
    obtain ⟨ψ, hψ⟩ := ih
    let le' : JJ ^ (k + 1 + 2) ≤ JJ ^ (k + 2) := Ideal.pow_le_pow_right (by omega)
    let g : Sy ⧸ JJ ^ (k + 1 + 2) →ₐ[A₀] Sy ⧸ JJ ^ (k + 2) := Ideal.Quotient.factorₐ A₀ le'
    have hgmk : ∀ a, g (mk (k + 1 + 2) a) = mk (k + 2) a := fun a => rfl
    have hgs : Function.Surjective g := fun y => by
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
      exact ⟨mk _ a, rfl⟩
    have hnil : IsNilpotent (RingHom.ker (g : Sy ⧸ JJ ^ (k + 1 + 2) →+* Sy ⧸ JJ ^ (k + 2))) := by
      refine ⟨2, ?_⟩
      rw [pow_two, Ideal.zero_eq_bot, eq_bot_iff, Ideal.mul_le]
      intro x hx y hy
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
      have ha : a ∈ JJ ^ (k + 2) := Ideal.Quotient.eq_zero_iff_mem.1 hx
      have hb : b ∈ JJ ^ (k + 2) := Ideal.Quotient.eq_zero_iff_mem.1 hy
      rw [← map_mul, Ideal.mem_bot, Ideal.Quotient.eq_zero_iff_mem]
      exact mem_of_le (by omega) (pow_mul_mem ha hb)
    let ψ' := Algebra.FormallySmooth.liftOfSurjective ψ g hgs hnil
    have hψ' : ∀ x, g (ψ' x) = ψ x := Algebra.FormallySmooth.liftOfSurjective_apply ψ g hgs hnil
    refine ⟨ψ', fun p => ?_⟩
    obtain ⟨w, hw⟩ := Ideal.Quotient.mk_surjective (ψ' (s p))
    obtain ⟨y, hy, e⟩ := hψ p
    have e₁ : mk (k + 2) w = mk (k + 2) (ιS p + y) := by
      rw [← e, ← hψ', ← hgmk]
      exact congrArg g hw
    have e₂ := mk_eq_iff.1 e₁
    refine ⟨w - ιS p, ?_, ?_⟩
    · have := Ideal.add_mem _ (mem_of_le (by omega : 2 ≤ k + 2) e₂) hy
      convert this using 1
      ring
    · rw [add_sub_cancel]
      exact hw.symm

include ht hπs hts in
/-- **Theorem 12.4**, the injectivity step: `Sym(P) → A` is injective. -/
theorem sym_lift_injective : Function.Injective (SymmetricAlgebra.lift s) := by
  refine (injective_iff_map_eq_zero _).2 fun x hx => eq_zero_of_mem_pow x fun m => ?_
  induction m with
  | zero => simp
  | succ m ih =>
    obtain ⟨ψ, hψ⟩ := exists_psi π t ht s hπs hts m
    let e : Sy →ₐ[A₀] Sy ⧸ JJ ^ (m + 2) := ψ.comp (SymmetricAlgebra.lift s)
    have heι : ∀ p, ∃ y ∈ JJ ^ 2, e (ιS p) = mk _ (ιS p + y) := fun p => by
      obtain ⟨y, hy, h⟩ := hψ p
      refine ⟨y, hy, ?_⟩
      change ψ (SymmetricAlgebra.lift s (ιS p)) = _
      rw [SymmetricAlgebra.lift_ι_apply, h]
    have D0 : ∀ y : Sy, ∃ z ∈ JJ, e y = mk _ (y + z) := by
      intro y
      induction y using SymmetricAlgebra.induction with
      | algebraMap r => exact ⟨0, Ideal.zero_mem _, by rw [add_zero, AlgHom.commutes, AlgHom.commutes]⟩
      | ι p =>
        obtain ⟨z, hz, h⟩ := heι p
        exact ⟨z, mem_of_le (n := 1) (by omega) hz |> (by simpa using ·), h⟩
      | mul a b ha hb =>
        obtain ⟨z, hz, h⟩ := ha
        obtain ⟨z', hz', h'⟩ := hb
        refine ⟨a * z' + z * b + z * z', ?_, ?_⟩
        · exact Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hz') (Ideal.mul_mem_right _ _ hz))
            (Ideal.mul_mem_right _ _ hz)
        · rw [map_mul, h, h', ← map_mul]
          congr 1
          ring
      | add a b ha hb =>
        obtain ⟨z, hz, h⟩ := ha
        obtain ⟨z', hz', h'⟩ := hb
        refine ⟨z + z', Ideal.add_mem _ hz hz', ?_⟩
        rw [map_add, h, h', ← map_add]
        congr 1
        ring
    have D1 : ∀ y ∈ JJ, ∃ z ∈ JJ ^ 2, e y = mk _ (y + z) := by
      intro y hy
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
      · rintro _ ⟨p, rfl⟩
        exact heι p
      · exact ⟨0, Ideal.zero_mem _, by simp⟩
      · rintro a b _ _ ⟨z, hz, h⟩ ⟨z', hz', h'⟩
        refine ⟨z + z', Ideal.add_mem _ hz hz', ?_⟩
        rw [map_add, h, h', ← map_add]
        congr 1
        ring
      · rintro c a ha ⟨z, hz, h⟩
        obtain ⟨z₀, hz₀, h₀⟩ := D0 c
        refine ⟨c * z + z₀ * a + z₀ * z, ?_, ?_⟩
        · refine Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hz) ?_) ?_
          · rw [pow_two]
            exact Ideal.mul_mem_mul hz₀ ha
          · exact Ideal.mul_mem_left _ _ hz
        · rw [smul_eq_mul, map_mul, h₀, h, ← map_mul]
          congr 1
          ring
    have Dm : ∀ n : ℕ, ∀ y ∈ JJ ^ (n + 1), ∃ z ∈ JJ ^ (n + 2), e y = mk _ (y + z) := by
      intro n
      induction n with
      | zero =>
        intro y hy
        exact D1 y (by simpa using hy)
      | succ n ihn =>
        intro y hy
        rw [pow_succ] at hy
        refine Submodule.mul_induction_on hy ?_ ?_
        · intro a ha b hb
          obtain ⟨z, hz, h⟩ := ihn a ha
          obtain ⟨z', hz', h'⟩ := D1 b hb
          refine ⟨a * z' + z * b + z * z', ?_, ?_⟩
          · have hb₁ : b ∈ JJ ^ 1 := by simpa using hb
            refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) ?_
            · exact pow_mul_mem ha hz'
            · exact mem_of_le (by omega) (pow_mul_mem hz hb₁)
            · exact mem_of_le (by omega) (pow_mul_mem hz hz')
          · rw [map_mul, h, h', ← map_mul]
            congr 1
            ring
        · rintro a b ⟨z, hz, h⟩ ⟨z', hz', h'⟩
          refine ⟨z + z', Ideal.add_mem _ hz hz', ?_⟩
          rw [map_add, h, h', ← map_add]
          congr 1
          ring
    have hex : e x = 0 := by
      exact (congrArg ψ hx).trans (map_zero ψ)
    obtain ⟨z, hz, h⟩ : ∃ z ∈ JJ ^ (m + 1), e x = mk _ (x + z) := by
      cases m with
      | zero => simpa using D0 x
      | succ n => exact Dm n x ih
    rw [hex] at h
    have h₂ : x + z ∈ JJ ^ (m + 2) := Ideal.Quotient.eq_zero_iff_mem.1 h.symm
    have := Ideal.sub_mem _ (mem_of_le (by omega : m + 1 ≤ m + 2) h₂) hz
    simpa using this

end Main

end AlgMag.SymRing
