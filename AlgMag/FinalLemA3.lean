import Mathlib.LinearAlgebra.TensorProduct.Basis
import Mathlib.RingTheory.TensorProduct.Basic
import Mathlib.RingTheory.Ideal.Maps
import Mathlib.RingTheory.Ideal.Span

/-!
# Lemma A.3 of *Algebraic Magnetism*, the printed dual argument, for a general `F`, `X` affine

`lemmaA3` of `AppendixA3` is for `F = F_n ⊆ D(M)` and `X` an algebraic space. This is the step of the printed proof for a general
pointed `F = Spec E`, with `E` free over `R` (printed: finite locally free; the statement is local), and `X = Spec A`, an action
being read as `c : A → E ⊗ A`. "The `𝒪_X`-algebra `𝒜` being finite locally free, the formation of its linear dual commutes with
base change; hence it is equivalent to say that `I → 𝒜 → 𝒪_X` becomes the zero map. Equivalently the `𝒪_X`-ideal `J` is contained in
`ker(u)`." Here `I` is generated by the `c a - 1 ⊗ a`, and `J` by their contractions with the linear forms of `E`. Infinitesimality is
used in the printed proof only to know that the stabilizer is a closed subscheme, which is automatic for `X` affine.
-/

open scoped TensorProduct

noncomputable section

namespace AlgMag.Final

variable {R E A R' : Type*} [CommRing R] [AddCommGroup E] [Module R E] [Module.Free R E]
  [CommRing A] [Algebra R A] [CommRing R'] [Algebra R R']

/-- Contraction with a linear form `ℓ` of `E`. -/
def contr (B : Type*) [AddCommGroup B] [Module R B] (ℓ : E →ₗ[R] R) : E ⊗[R] B →ₗ[R] B :=
  (TensorProduct.lid R B).toLinearMap ∘ₗ TensorProduct.map ℓ LinearMap.id

/-- The ideal `J` of the printed proof. -/
def fixedIdeal (e₁ : E) (c : A →ₗ[R] E ⊗[R] A) : Ideal A :=
  Ideal.span {b | ∃ (a : A) (ℓ : E →ₗ[R] R), b = contr A ℓ (c a - e₁ ⊗ₜ a)}

lemma contr_map (u : A →ₐ[R] R') (ℓ : E →ₗ[R] R) (z : E ⊗[R] A) :
    contr R' ℓ (TensorProduct.map LinearMap.id u.toLinearMap z) = u (contr A ℓ z) := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | add x y hx hy => simp only [map_add, hx, hy]
  | tmul e a => simp [contr]

/-- An element of `E ⊗ R'` with all contractions zero is zero: this is "the linear dual commutes with base change". -/
lemma eq_zero_of_contr {z : E ⊗[R] R'} (h : ∀ ℓ : E →ₗ[R] R, contr R' ℓ z = 0) : z = 0 := by
  classical
  let b := Module.Free.chooseBasis R E
  refine (LinearEquiv.map_eq_zero_iff (TensorProduct.equivFinsuppOfBasisLeft b)).1 ?_
  ext i
  have key : ∀ y : E ⊗[R] R', TensorProduct.equivFinsuppOfBasisLeft b y i =
      contr R' (b.coord i) y := by
    intro y
    induction y using TensorProduct.induction_on with
    | zero => simp
    | add x y hx hy => simp only [map_add, Finsupp.add_apply, hx, hy]
    | tmul e a =>
      simp [contr, TensorProduct.equivFinsuppOfBasisLeft_apply_tmul_apply]
  rw [key, h, Finsupp.zero_apply]

/-- **Lemma A.3**, the printed equivalence: `u : Spec R' → X` is fixed by `F` if and only if `J ⊆ ker u`. -/
theorem lemA3_affine (e₁ : E) (c : A →ₗ[R] E ⊗[R] A) (u : A →ₐ[R] R') :
    (∀ a, TensorProduct.map LinearMap.id u.toLinearMap (c a) = e₁ ⊗ₜ u a) ↔
      fixedIdeal e₁ c ≤ RingHom.ker u.toRingHom := by
  have hz : ∀ a, TensorProduct.map LinearMap.id u.toLinearMap (c a - e₁ ⊗ₜ a) =
      TensorProduct.map LinearMap.id u.toLinearMap (c a) - e₁ ⊗ₜ[R] u a := by
    intro a; simp
  constructor
  · intro h
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨a, ℓ, rfl⟩
    change u _ = 0
    rw [← contr_map, hz, h, sub_self, map_zero]
  · intro h a
    rw [← sub_eq_zero, ← hz]
    refine eq_zero_of_contr fun ℓ => ?_
    rw [contr_map]
    exact h (Ideal.subset_span ⟨a, ℓ, rfl⟩)

end AlgMag.Final

#print axioms AlgMag.Final.lemA3_affine
