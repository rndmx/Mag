import AlgMag.FinalMiscThm124Cited
import Mathlib.RingTheory.MvPolynomial.Homogeneous

/-!
# Theorem 12.4: `Sym(I/I²) → gr_I` from local quasi-regular generators

The citation of Tags 062Z, 063M in the printed proof of Theorem 12.4, ring form. `IsQRAt π q` says
that at the prime `q` of `A₀ = B/I` the ideal `I` is generated by a quasi-regular sequence;
`grInjective_of_isQRAt` is the injectivity of `Sym(I/I²) → gr_I`.
-/

open AlgMag.SymRing MvPolynomial

universe u

namespace AlgMag.Sec12Printed

variable {A₀ B : Type u} [CommRing A₀] [CommRing B] [Algebra A₀ B] (π : B →ₐ[A₀] A₀)

/-- At the prime `q` of `A₀`, the ideal `I = ker π` is generated by a quasi-regular sequence `f`:
stalkwise `I` is generated by `f`, and a homogeneous form of degree `k` over `A₀` whose value on `f`
lies in `I^(k+1)` vanishes near `q` (Stacks 061M, 063D (4)). -/
def IsQRAt (q : Ideal A₀) : Prop :=
  ∃ (r : ℕ) (f : Fin r → B), (∀ i, f i ∈ augI π) ∧
    (∀ a ∈ augI π, ∃ h : B, π h ∉ q ∧ h * a ∈ Ideal.span (Set.range f)) ∧
    ∀ (k : ℕ) (P : MvPolynomial (Fin r) A₀), P.IsHomogeneous k →
      aeval f P ∈ augI π ^ (k + 1) → ∃ u : A₀, u ∉ q ∧ u • P = 0

variable {π}

local notation "Sy" => SymmetricAlgebra A₀ (Conormal π)
local notation "JJ" => augIdeal A₀ (Conormal π)
local notation "ιS" => SymmetricAlgebra.ι A₀ (Conormal π)

private lemma dec_sym (y : Sy) : ∃ r : A₀, ∃ j ∈ JJ, y = algebraMap A₀ Sy r + j := by
  induction y using SymmetricAlgebra.induction with
  | algebraMap r => exact ⟨r, 0, Ideal.zero_mem _, by simp⟩
  | ι p => exact ⟨0, _, ι_mem p, by simp⟩
  | mul a b ha hb =>
    obtain ⟨r, j, hj, rfl⟩ := ha
    obtain ⟨r', j', hj', rfl⟩ := hb
    refine ⟨r * r', algebraMap A₀ Sy r * j' + j * (algebraMap A₀ Sy r' + j'), ?_, ?_⟩
    · exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hj') (Ideal.mul_mem_right _ _ hj)
    · rw [map_mul]; ring
  | add a b ha hb =>
    obtain ⟨r, j, hj, rfl⟩ := ha
    obtain ⟨r', j', hj', rfl⟩ := hb
    exact ⟨r + r', j + j', Ideal.add_mem _ hj hj', by rw [map_add]; ring⟩

/-- The class of `a ∈ I` near `q` lies in the span of the classes of the generators. -/
private lemma exists_smul_mem_span {q : Ideal A₀} {r : ℕ} {f : Fin r → B}
    (hgen : ∀ a ∈ augI π, ∃ h : B, π h ∉ q ∧ h * a ∈ Ideal.span (Set.range f))
    (hf : ∀ i, f i ∈ augI π) (p : Conormal π) :
    ∃ u : A₀, u ∉ q ∧ u • p ∈ Submodule.span A₀ (Set.range fun i => tMap π (f i)) := by
  obtain ⟨⟨a, ha⟩, rfl⟩ := (augI π).toCotangent_surjective p
  obtain ⟨h, hh, hm⟩ := hgen a ha
  refine ⟨π h, hh, ?_⟩
  have e : π h • (augI π).toCotangent ⟨a, ha⟩ = tMap π (h * a) := by
    have h0 : π a = 0 := ha
    rw [tMap_mul, h0, zero_smul, add_zero, tMap_of_mem π ha]
  rw [e]
  have key : ∀ z ∈ Ideal.span (Set.range f), π z = 0 ∧ tMap π z ∈
      Submodule.span A₀ (Set.range fun i => tMap π (f i)) := by
    intro z hz
    refine Submodule.span_induction (p := fun z _ => π z = 0 ∧ tMap π z ∈
      Submodule.span A₀ (Set.range fun i => tMap π (f i))) ?_ ?_ ?_ ?_ hz
    · rintro _ ⟨i, rfl⟩
      exact ⟨hf i, Submodule.subset_span ⟨i, rfl⟩⟩
    · exact ⟨map_zero _, by simp⟩
    · rintro x y _ _ ⟨h1, hx⟩ ⟨h2, hy⟩
      refine ⟨by rw [map_add, h1, h2, add_zero], ?_⟩
      rw [map_add]
      exact Submodule.add_mem _ hx hy
    · rintro c x _ ⟨h1, hx⟩
      refine ⟨by rw [smul_eq_mul, map_mul, h1, mul_zero], ?_⟩
      rw [smul_eq_mul, tMap_mul, h1, zero_smul, add_zero]
      exact Submodule.smul_mem _ _ hx
  exact (key _ hm).2

section Main

variable {s : Conormal π →ₗ[A₀] B}

private lemma J_pow_le (hπs : ∀ p, π (s p) = 0) (n : ℕ) {y : Sy} (hy : y ∈ JJ ^ n) :
    (SymmetricAlgebra.lift s : Sy →ₐ[A₀] B) y ∈ augI π ^ n := by
  have hle : JJ ≤ (augI π).comap (SymmetricAlgebra.lift s : Sy →ₐ[A₀] B) := by
    rw [augIdeal, Ideal.span_le]
    rintro _ ⟨p, rfl⟩
    change π (SymmetricAlgebra.lift s (ιS p)) = 0
    rw [SymmetricAlgebra.lift_ι_apply, hπs]
  exact Ideal.le_comap_pow _ n (Ideal.pow_right_mono hle n hy)

/-- Forms whose value on `ι p` is close to their value on `f`. -/
private def Good {r : ℕ} (f : Fin r → B) (s : Conormal π →ₗ[A₀] B) (k : ℕ)
    (P : MvPolynomial (Fin r) A₀) : Prop :=
  P.IsHomogeneous k ∧
    aeval (fun i => s (tMap π (f i))) P - aeval f P ∈ augI π ^ (k + 1) ∧
    aeval (fun i => s (tMap π (f i))) P ∈ augI π ^ k ∧
    aeval f P ∈ augI π ^ k ∧
    aeval (fun i => ιS (tMap π (f i))) P ∈ JJ ^ k

private lemma Good.add {r : ℕ} {f : Fin r → B} {k : ℕ} {P Q : MvPolynomial (Fin r) A₀}
    (hP : Good (π := π) f s k P) (hQ : Good (π := π) f s k Q) : Good (π := π) f s k (P + Q) := by
  obtain ⟨a1, a2, a3, a4, a5⟩ := hP
  obtain ⟨b1, b2, b3, b4, b5⟩ := hQ
  refine ⟨a1.add b1, ?_, ?_, ?_, ?_⟩
  · have := Ideal.add_mem _ a2 b2
    simp only [map_add]
    convert this using 1
    ring
  · simp only [map_add]; exact Ideal.add_mem _ a3 b3
  · simp only [map_add]; exact Ideal.add_mem _ a4 b4
  · simp only [map_add]; exact Ideal.add_mem _ a5 b5

private lemma Good.mul {r : ℕ} {f : Fin r → B} {k l : ℕ} {P Q : MvPolynomial (Fin r) A₀}
    (hP : Good (π := π) f s k P) (hQ : Good (π := π) f s l Q) :
    Good (π := π) f s (k + l) (P * Q) := by
  obtain ⟨a1, a2, a3, a4, a5⟩ := hP
  obtain ⟨b1, b2, b3, b4, b5⟩ := hQ
  refine ⟨a1.mul b1, ?_, ?_, ?_, ?_⟩
  · simp only [map_mul]
    have e1 := Ideal.mul_mem_mul a3 b2
    have e2 := Ideal.mul_mem_mul a2 b4
    rw [← pow_add, show k + (l + 1) = k + l + 1 by ring] at e1
    rw [← pow_add, show k + 1 + l = k + l + 1 by ring] at e2
    have := Ideal.add_mem _ e1 e2
    convert this using 1
    ring
  · simp only [map_mul, pow_add]; exact Ideal.mul_mem_mul a3 b3
  · simp only [map_mul, pow_add]; exact Ideal.mul_mem_mul a4 b4
  · simp only [map_mul, pow_add]; exact Ideal.mul_mem_mul a5 b5

/-- **Tags 062Z, 063M**, ring form used by the printed proof of Theorem 12.4: if `I` is generated by
a quasi-regular sequence at each maximal ideal of `A₀`, then `Sym(I/I²) → gr_I` is injective. -/
theorem grInjective_of_isQRAt (h : ∀ q : Ideal A₀, q.IsMaximal → IsQRAt π q) : GrInjective π := by
  intro s hπs hts k x hx hφ
  let Ann : Ideal A₀ :=
    { carrier := {a | algebraMap A₀ Sy a * x ∈ JJ ^ (k + 1)}
      add_mem' := fun {a b} ha hb => by
        simp only [Set.mem_setOf_eq, map_add, add_mul] at *
        exact Ideal.add_mem _ ha hb
      zero_mem' := by simp
      smul_mem' := fun c a ha => by
        simp only [Set.mem_setOf_eq, smul_eq_mul, map_mul, mul_assoc] at *
        exact Ideal.mul_mem_left _ _ ha }
  suffices hA : Ann = ⊤ by
    have : (1 : A₀) ∈ Ann := hA ▸ Submodule.mem_top
    simpa [Ann] using this
  by_contra hne
  obtain ⟨q, hq, hAq⟩ := Ideal.exists_le_maximal Ann hne
  have hqp := hq.isPrime
  obtain ⟨r, f, hf, hgen, hqr⟩ := h q hq
  let pp : Fin r → Conormal π := fun i => tMap π (f i)
  let G : Ideal Sy := Ideal.span (Set.range fun i => ιS (pp i))
  have hGJ : G ≤ JJ := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact ι_mem _
  -- `J^n` is in `G^n` near `q`
  have step1 : ∀ y ∈ JJ, ∃ u : A₀, u ∉ q ∧ algebraMap A₀ Sy u * y ∈ G := by
    intro y hy
    refine Submodule.span_induction (p := fun y _ => ∃ u : A₀, u ∉ q ∧ algebraMap A₀ Sy u * y ∈ G)
      ?_ ?_ ?_ ?_ hy
    · rintro _ ⟨p, rfl⟩
      obtain ⟨u, hu, hm⟩ := exists_smul_mem_span hgen hf p
      refine ⟨u, hu, ?_⟩
      have key : ∀ z ∈ Submodule.span A₀ (Set.range pp), ιS z ∈ G := by
        intro z hz
        refine Submodule.span_induction (p := fun z _ => ιS z ∈ G) ?_ ?_ ?_ ?_ hz
        · rintro _ ⟨i, rfl⟩
          exact Ideal.subset_span ⟨i, rfl⟩
        · simp
        · intro a b _ _ ha hb
          rw [map_add]
          exact Ideal.add_mem _ ha hb
        · intro c a _ ha
          rw [map_smul, Algebra.smul_def]
          exact Ideal.mul_mem_left _ _ ha
      have := key _ hm
      rwa [map_smul, Algebra.smul_def] at this
    · exact ⟨1, fun h1 => hq.ne_top ((Ideal.eq_top_iff_one _).2 h1), by simp⟩
    · rintro a b _ _ ⟨u, hu, ha⟩ ⟨v, hv, hb⟩
      refine ⟨u * v, fun hm => (hqp.mem_or_mem hm).elim hu hv, ?_⟩
      have := Ideal.add_mem _ (Ideal.mul_mem_left G (algebraMap A₀ Sy v) ha)
        (Ideal.mul_mem_left G (algebraMap A₀ Sy u) hb)
      convert this using 1
      rw [map_mul]; ring
    · rintro c a _ ⟨u, hu, ha⟩
      refine ⟨u, hu, ?_⟩
      have := Ideal.mul_mem_left G c ha
      convert this using 1
      rw [smul_eq_mul]; ring
  have step2 : ∀ (n : ℕ) (y : Sy), y ∈ JJ ^ n →
      ∃ u : A₀, u ∉ q ∧ algebraMap A₀ Sy u * y ∈ G ^ n := by
    intro n
    induction n with
    | zero =>
      intro y _
      exact ⟨1, fun h1 => hq.ne_top ((Ideal.eq_top_iff_one _).2 h1), by simp⟩
    | succ n ih =>
      intro y hy
      rw [pow_succ] at hy
      refine Submodule.mul_induction_on hy ?_ ?_
      · intro a ha b hb
        obtain ⟨u, hu, h1⟩ := ih a ha
        obtain ⟨v, hv, h2⟩ := step1 b hb
        refine ⟨u * v, fun hm => (hqp.mem_or_mem hm).elim hu hv, ?_⟩
        rw [pow_succ]
        have := Ideal.mul_mem_mul h1 h2
        convert this using 1
        rw [map_mul]; ring
      · rintro a b ⟨u, hu, h1⟩ ⟨v, hv, h2⟩
        refine ⟨u * v, fun hm => (hqp.mem_or_mem hm).elim hu hv, ?_⟩
        have := Ideal.add_mem _ (Ideal.mul_mem_left (G ^ (n + 1)) (algebraMap A₀ Sy v) h1)
          (Ideal.mul_mem_left (G ^ (n + 1)) (algebraMap A₀ Sy u) h2)
        convert this using 1
        rw [map_mul]; ring
  -- `s (p i) - f i ∈ I²`
  have hdiff : ∀ i, s (pp i) - f i ∈ augI π ^ 2 := by
    intro i
    have hm : s (pp i) - f i ∈ augI π := Ideal.sub_mem _ (hπs _) (hf i)
    have h0 : tMap π (s (pp i) - f i) = 0 := by
      rw [map_sub, hts, sub_eq_zero]
    rw [tMap_of_mem π hm, Ideal.toCotangent_eq_zero] at h0
    exact h0
  have goodC : ∀ c : A₀, Good (π := π) f s 0 (C c) := by
    intro c
    refine ⟨isHomogeneous_C _ _, ?_, by simp, by simp, by simp⟩
    simp
  have goodX : ∀ i, Good (π := π) f s 1 (X i) := by
    intro i
    refine ⟨isHomogeneous_X _ _, ?_, ?_, ?_, ?_⟩
    · simpa using hdiff i
    · simpa using hπs (pp i)
    · simpa using hf i
    · simpa using ι_mem _
  let Ψ : MvPolynomial (Fin r) A₀ →ₐ[A₀] Sy := aeval fun i => ιS (pp i)
  -- elements of `G` are linear forms modulo `J²`
  have step3a : ∀ b ∈ G, ∃ Q, Good (π := π) f s 1 Q ∧ b - Ψ Q ∈ JJ ^ 2 := by
    intro b hb
    refine Submodule.span_induction (p := fun b _ => ∃ Q, Good (π := π) f s 1 Q ∧ b - Ψ Q ∈ JJ ^ 2)
      ?_ ?_ ?_ ?_ hb
    · rintro _ ⟨i, rfl⟩
      exact ⟨X i, goodX i, by simp [Ψ]⟩
    · refine ⟨0, ⟨isHomogeneous_zero _ _ _, by simp, by simp, by simp, by simp⟩, by simp⟩
    · rintro a b _ _ ⟨P, hP, h1⟩ ⟨Q, hQ, h2⟩
      refine ⟨P + Q, hP.add hQ, ?_⟩
      have := Ideal.add_mem _ h1 h2
      rw [map_add]
      convert this using 1
      ring
    · rintro c a ha ⟨P, hP, h1⟩
      obtain ⟨c0, j, hj, rfl⟩ := dec_sym c
      refine ⟨C c0 * P, ?_, ?_⟩
      · simpa using (goodC c0).mul hP
      · have haJ : a ∈ JJ := hGJ ha
        have e1 : j * a ∈ JJ ^ 2 := by rw [pow_two]; exact Ideal.mul_mem_mul hj haJ
        have e2 := Ideal.mul_mem_left (JJ ^ 2) (algebraMap A₀ Sy c0) h1
        have := Ideal.add_mem _ e1 e2
        rw [map_mul, smul_eq_mul]
        convert this using 1
        simp only [Ψ, aeval_C]
        ring
  have step3 : ∀ (n : ℕ) (y : Sy), y ∈ G ^ n →
      ∃ P, Good (π := π) f s n P ∧ y - Ψ P ∈ JJ ^ (n + 1) := by
    intro n
    induction n with
    | zero =>
      intro y _
      obtain ⟨c, j, hj, rfl⟩ := dec_sym y
      exact ⟨C c, goodC c, by simpa [Ψ] using hj⟩
    | succ n ih =>
      intro y hy
      rw [pow_succ] at hy
      refine Submodule.mul_induction_on hy ?_ ?_
      · intro a ha b hb
        obtain ⟨P, hP, h1⟩ := ih a ha
        obtain ⟨Q, hQ, h2⟩ := step3a b hb
        refine ⟨P * Q, hP.mul hQ, ?_⟩
        have e1 : (a - Ψ P) * b ∈ JJ ^ (n + 1 + 1) := by
          rw [pow_succ JJ (n + 1)]; exact Ideal.mul_mem_mul h1 (hGJ hb)
        have e2 : Ψ P * (b - Ψ Q) ∈ JJ ^ (n + 1 + 1) := by
          rw [show n + 1 + 1 = n + 2 by ring, pow_add]; exact Ideal.mul_mem_mul hP.2.2.2.2 h2
        have := Ideal.add_mem _ e1 e2
        rw [map_mul]
        convert this using 1
        ring
      · rintro a b ⟨P, hP, h1⟩ ⟨Q, hQ, h2⟩
        refine ⟨P + Q, hP.add hQ, ?_⟩
        have := Ideal.add_mem _ h1 h2
        rw [map_add]
        convert this using 1
        ring
  -- conclusion
  obtain ⟨u, hu, hux⟩ := step2 k x hx
  obtain ⟨P, hP, hw⟩ := step3 k _ hux
  let φ : Sy →ₐ[A₀] B := SymmetricAlgebra.lift s
  have hφΨ : φ (Ψ P) = aeval (fun i => s (pp i)) P := by
    have : φ.comp Ψ = aeval (fun i => s (pp i)) := by
      apply MvPolynomial.algHom_ext
      intro i
      simp [Ψ, φ]
    exact DFunLike.congr_fun this P
  have h1 : φ (algebraMap A₀ Sy u * x) ∈ augI π ^ (k + 1) := by
    rw [map_mul]
    exact Ideal.mul_mem_left _ _ hφ
  have h2 := J_pow_le hπs (k + 1) hw
  have h3 : φ (Ψ P) ∈ augI π ^ (k + 1) := by
    have := Ideal.sub_mem _ h1 h2
    rw [← map_sub] at this
    simpa using this
  have h4 : aeval f P ∈ augI π ^ (k + 1) := by
    have := Ideal.sub_mem _ h3 hP.2.1
    rw [hφΨ] at this
    have e : aeval f P = aeval (fun i => s (pp i)) P -
        (aeval (fun i => s (pp i)) P - aeval f P) := by ring
    rw [e]
    exact this
  obtain ⟨v, hv, hvP⟩ := hqr k P hP.1 h4
  have hvΨ : algebraMap A₀ Sy v * Ψ P = 0 := by
    rw [← Algebra.smul_def, ← map_smul, hvP, map_zero]
  have h5 : algebraMap A₀ Sy (v * u) * x ∈ JJ ^ (k + 1) := by
    have := Ideal.mul_mem_left _ (algebraMap A₀ Sy v) hw
    rw [mul_sub, hvΨ, sub_zero] at this
    rwa [map_mul, mul_assoc]
  have h6 : v * u ∈ q := hAq h5
  exact (hqp.mem_or_mem h6).elim hv hu

end Main

/-- **Theorem 12.4**, ring statement from the outputs of Tags 067U, 063M: `I/I²` projective and `I`
locally generated by a quasi-regular sequence give `Sym_{A₀}(I/I²) ≅ B`. -/
theorem printed_ring_qr {Y : Type u} [AddCommMonoid Y] [DecidableEq Y]
    {𝒜 : Y → Submodule A₀ B} [GradedAlgebra 𝒜] {w : Y → ℕ}
    [Module.Projective A₀ (Conormal π)] (h : ∀ q : Ideal A₀, q.IsMaximal → IsQRAt π q)
    (H : IsAug 𝒜 π w) : Nonempty (SymmetricAlgebra A₀ (Conormal π) ≃ₐ[A₀] B) :=
  printed_ring_cited (grInjective_of_isQRAt h) H

#print axioms grInjective_of_isQRAt
#print axioms printed_ring_qr

end AlgMag.Sec12Printed
