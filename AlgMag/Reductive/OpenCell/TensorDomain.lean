import Mathlib.RingTheory.Jacobson.Ring
import Mathlib.FieldTheory.IsAlgClosed.Basic
import Mathlib.LinearAlgebra.TensorProduct.Basis
import Mathlib.RingTheory.TensorProduct.Basic
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.RingTheory.TensorProduct.Nontrivial

/-!
# Nullstellensatz points and tensor products of domains over `k̄`

* `exists_algHom_ker_eq`: every maximal ideal of a finite type algebra over an algebraically
  closed field `K` is the kernel of a `K`-point.
* `eq_zero_of_forall_algHom`: in a reduced finite type `K`-algebra, an element killed by every
  `K`-point is zero.
* `isDomain_tensorProduct_of_isAlgClosed`: `A ⊗[K] B` is a domain if `A`, `B` are domains and
  `A` is of finite type (no hypothesis on `B` beyond being a domain).

Proof of the last: write `x = ∑ aᵢ ⊗ bᵢ`, `y = ∑ cⱼ ⊗ bⱼ` on a `K`-basis `b` of `B`. For a
`K`-point `φ` of `A`, `(φ ⊗ id)(x) (φ ⊗ id)(y) = 0` in the domain `B`, so `φ` kills all `aᵢ`
or all `cⱼ`. Hence `φ` kills the product ideal `(aᵢ)(cⱼ)`; by the Nullstellensatz this product
is `0`, so one factor is `0` in the domain `A`.
-/

namespace AlgMag.OpenCellNotes

open scoped TensorProduct

universe u v w

variable {K : Type u} [Field K] [IsAlgClosed K]

/-- Every maximal ideal of a finite type `K`-algebra is the kernel of a `K`-point. -/
theorem exists_algHom_ker_eq {A : Type v} [CommRing A] [Algebra K A] [Algebra.FiniteType K A]
    (m : Ideal A) [hm : m.IsMaximal] : ∃ φ : A →ₐ[K] K, RingHom.ker φ = m := by
  let _ : Field (A ⧸ m) := Ideal.Quotient.field m
  have hft : Algebra.FiniteType K (A ⧸ m) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ K m)
      (Ideal.Quotient.mkₐ_surjective K m)
  have : Module.Finite K (A ⧸ m) := finite_of_finite_type_of_isJacobsonRing K (A ⧸ m)
  have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K) (K := A ⧸ m)
  let e : K ≃ₐ[K] A ⧸ m := AlgEquiv.ofBijective (Algebra.ofId K (A ⧸ m)) hbij
  refine ⟨(e.symm : A ⧸ m →ₐ[K] K).comp (Ideal.Quotient.mkₐ K m), ?_⟩
  ext x
  simp only [RingHom.mem_ker, AlgHom.coe_comp, Function.comp_apply, AlgEquiv.coe_toAlgHom,
    Ideal.Quotient.mkₐ_eq_mk]
  rw [map_eq_zero_iff _ e.symm.injective, Ideal.Quotient.eq_zero_iff_mem]

/-- **Nullstellensatz.** In a reduced finite type `K`-algebra, an element killed by every
`K`-point is zero. -/
theorem eq_zero_of_forall_algHom {A : Type v} [CommRing A] [Algebra K A] [Algebra.FiniteType K A]
    [IsReduced A] {a : A} (h : ∀ φ : A →ₐ[K] K, φ a = 0) : a = 0 := by
  -- `A` is Jacobson (finite type over a field), so `jacobson ⊥ = ⊥` for `⊥` radical.
  have hJR : IsJacobsonRing A := isJacobsonRing_of_finiteType (A := K)
  have hJ : (⊥ : Ideal A).jacobson = ⊥ := IsJacobsonRing.out hJR Ideal.isRadical_bot
  have ha : a ∈ (⊥ : Ideal A).jacobson := by
    rw [Ideal.jacobson, Ideal.mem_sInf]
    rintro m ⟨-, hm⟩
    obtain ⟨φ, hφ⟩ := exists_algHom_ker_eq (K := K) m
    rw [← hφ, RingHom.mem_ker]
    exact h φ
  rw [hJ] at ha
  exact ha

/-- The `K`-point `φ ⊗ id : A ⊗ B → B`. -/
noncomputable def evalLeft {A : Type v} {B : Type w} [CommRing A] [CommRing B] [Algebra K A]
    [Algebra K B] (φ : A →ₐ[K] K) : A ⊗[K] B →ₐ[K] B :=
  (Algebra.TensorProduct.lid K B).toAlgHom.comp (Algebra.TensorProduct.map φ (AlgHom.id K B))

omit [IsAlgClosed K] in
lemma evalLeft_tmul {A : Type v} {B : Type w} [CommRing A] [CommRing B] [Algebra K A]
    [Algebra K B] (φ : A →ₐ[K] K) (a : A) (b : B) : evalLeft φ (a ⊗ₜ b) = φ a • b := by
  simp [evalLeft]

omit [IsAlgClosed K] in
/-- If `φ ⊗ id` kills `∑ aᵢ ⊗ bᵢ` (`b` a basis) then `φ` kills every `aᵢ`. -/
lemma forall_eq_zero_of_evalLeft {A : Type v} {B : Type w} [CommRing A] [CommRing B]
    [Algebra K A] [Algebra K B] {ι : Type w} (b : Module.Basis ι K B) (c : ι →₀ A) (φ : A →ₐ[K] K)
    (h : evalLeft φ (c.sum fun i a => a ⊗ₜ[K] b i) = 0) : ∀ i, φ (c i) = 0 := by
  let l : ι →₀ K := c.mapRange φ (map_zero φ)
  have hl : Finsupp.linearCombination K b l = 0 := by
    rw [Finsupp.linearCombination_apply, Finsupp.sum_mapRange_index (fun _ => by simp)]
    rw [map_finsuppSum] at h
    simpa [evalLeft_tmul] using h
  have h0 : l = 0 := linearIndependent_iff.mp b.linearIndependent l hl
  intro i
  simpa [l] using DFunLike.congr_fun h0 i

/-- The ideal generated by the coefficients of a finitely supported family. -/
def coeffIdeal {A : Type v} [CommRing A] {ι : Type w} (c : ι →₀ A) : Ideal A :=
  Ideal.span (Set.range c)

omit [IsAlgClosed K] in
lemma coeffIdeal_le_ker {A : Type v} [CommRing A] [Algebra K A] {ι : Type w} (c : ι →₀ A)
    (φ : A →ₐ[K] K) (h : ∀ i, φ (c i) = 0) : coeffIdeal c ≤ RingHom.ker φ := by
  rw [coeffIdeal, Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  exact h i

omit [IsAlgClosed K] in
lemma eq_zero_of_coeffIdeal_eq_bot {A : Type v} {B : Type w} [CommRing A] [CommRing B]
    [Algebra K A] [Algebra K B] {ι : Type w} (b : Module.Basis ι K B) (c : ι →₀ A)
    (h : coeffIdeal c = ⊥) : (c.sum fun i a => a ⊗ₜ[K] b i) = 0 := by
  have : c = 0 := by
    ext i
    have : c i ∈ coeffIdeal c := Ideal.subset_span ⟨i, rfl⟩
    rw [h, Ideal.mem_bot] at this
    simpa using this
  simp [this]

/-- **Tensor product of domains over an algebraically closed field.** If `A` and `B` are domains
over `K = K̄` and `A` is of finite type, `A ⊗[K] B` is a domain. -/
theorem isDomain_tensorProduct_of_isAlgClosed {A : Type v} {B : Type w} [CommRing A] [CommRing B]
    [Algebra K A] [Algebra K B] [IsDomain A] [IsDomain B] [Algebra.FiniteType K A] :
    IsDomain (A ⊗[K] B) := by
  have : Nontrivial (A ⊗[K] B) :=
    Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain K A B
      (FaithfulSMul.algebraMap_injective K A) (FaithfulSMul.algebraMap_injective K B)
  have : NoZeroDivisors (A ⊗[K] B) := by
    refine ⟨fun {x y} hxy => ?_⟩
    let b := Module.Basis.ofVectorSpace K B
    obtain ⟨c, rfl⟩ := TensorProduct.eq_repr_basis_right (M := A) b x
    obtain ⟨d, rfl⟩ := TensorProduct.eq_repr_basis_right (M := A) b y
    have key : ∀ φ : A →ₐ[K] K, coeffIdeal c * coeffIdeal d ≤ RingHom.ker φ := by
      intro φ
      have h1 := congrArg (evalLeft φ) hxy
      rw [map_mul, map_zero] at h1
      rcases mul_eq_zero.mp h1 with h1 | h1
      · exact Ideal.mul_le_left.trans
          (coeffIdeal_le_ker c φ (forall_eq_zero_of_evalLeft b c φ h1))
      · exact Ideal.mul_le_right.trans
          (coeffIdeal_le_ker d φ (forall_eq_zero_of_evalLeft b d φ h1))
    have hbot : coeffIdeal c * coeffIdeal d = ⊥ := by
      rw [eq_bot_iff]
      intro z hz
      exact (Ideal.mem_bot).mpr (eq_zero_of_forall_algHom (K := K) fun φ => key φ hz)
    rcases Ideal.mul_eq_bot.mp hbot with h | h
    · exact Or.inl (eq_zero_of_coeffIdeal_eq_bot b c h)
    · exact Or.inr (eq_zero_of_coeffIdeal_eq_bot b d h)
  exact NoZeroDivisors.to_isDomain _

end AlgMag.OpenCellNotes
