import AlgMag.Reductive.RootDatumBase
import AlgMag.Reductive.RootSpaceDim
import AlgMag.Reductive.RootSpaceDimAlt
import AlgMag.Reductive.RankOneReflectionAlt
import AlgMag.Reductive.WeylGeneratedAlt

/-!
# The root datum of a connected `G` from two rank-one inputs

`k = k̄`, `G = Spec H` smooth, connected, of finite type, `D : SplitReductiveData π`, `X` a lattice.
From

* (R1) for every root `α`, `N_{G^{ℤα}}(T)(k) ⊄ T(k)`: a `k`-point of the attractor `G^{ℤα}`
  normalizing `T` acts on `X` by some `σ ≠ 1`;
* (R2′) for every root `α`, `O(U_α)` is generated by one element, `U_α = G^{[α⟩}_e`,

`SplitReductiveData.toWithRootSpacesOfRankOne` builds `SplitReductiveData.WithRootSpaces π`.
Nothing else is an input: the reflections (`WithReflections.ofLineAttractor`), the root datum
`rootPairing`, `range_root`, `dim 𝔤_α = 1` and `nα ∉ Φ`
(`RankOne.finrank_rootSpace_eq_one_and_reduced_iff`), reducedness
(`WithReflections.isReduced_rootPairing`), the base (`RootDatumBase.baseInt`) and
`W = W(Φ)` (`WeylAlt.exists_weylGroup_rootPairing`) are all constructed.
-/

suppress_compilation

open Set Function Module TauCeti WithConv Magnetism

namespace AlgMag.Reductive

open AlgMag.RootDatumBase AlgMag.Weyl

universe u

variable {k : Type u} {H : Type u} {X : Type u}
variable [Field k] [CommRing H] [HopfAlgebra k H] [CommGroup X] [DecidableEq X]
variable [Module.Finite k (Bialgebra.CotangentSpace k H)]
variable {π : H →ₐc[k] MonoidAlgebra k X}
variable [Module.IsTorsionFree ℤ (Additive X)]

omit [DecidableEq X] in
/-- Roots have infinite order (`X` torsion-free, `0 ∉ Φ`). -/
theorem nsmul_eq_zero_of_mem_roots {α : Additive X} (hα : α ∈ roots π) :
    ∀ n : ℕ, n • α = 0 → n = 0 := by
  have : IsAddTorsionFree (Additive X) := .of_isTorsionFree ℤ (Additive X)
  intro n hn
  by_contra h
  exact ne_zero_of_mem_roots hα ((nsmul_right_injective h) (hn.trans (nsmul_zero n).symm))

variable [Module.Finite ℤ (Additive X)]
variable [IsAlgClosed k] [Algebra.FiniteType k H] [Algebra.Smooth k H]
  [ConnectedSpace (PrimeSpectrum H)] [Monoid.FG X] [IsMulTorsionFree X]

/-- **`WithRootSpaces` for a connected `G` from (R1) and (R2′)**: (R1) for every root `α`, a
`k`-point `n ∈ G^{ℤα}` normalizing `T` acts by `σ ≠ 1`; (R2′) for every root `α`, `O(U_α)` is
generated by one element. -/
def SplitReductiveData.toWithRootSpacesOfRankOne (D : SplitReductiveData π)
    (hR1 : ∀ α ∈ roots π, ∃ (n : WithConv (H →ₐ[k] k)) (σ : X ≃* X), IsNormalizingWith π k n σ ∧
      n ∈ attractorSubgroup π (lineMagnet α) k ∧ σ ≠ 1)
    (hR2 : ∀ (α : Additive X) (hα : α ∈ roots π), ∃ y : H, Function.Surjective
      (Polynomial.aeval (R := k) (Ideal.Quotient.mk
        (rootGroupIdeal π α (nsmul_eq_zero_of_mem_roots hα)).toIdeal y))) :
    SplitReductiveData.WithRootSpaces π :=
  have hdr : ∀ α (hα : α ∈ roots π), Module.finrank k (rootSpace π α) = 1 ∧
      ∀ n : ℕ, 2 ≤ n → n • α ∉ roots π := fun α hα =>
    (RankOne.finrank_rootSpace_eq_one_and_reduced_iff (nsmul_eq_zero_of_mem_roots hα) hα).mpr
      (hR2 α hα)
  haveI := (SplitReductiveData.WithReflections.ofLineAttractor D hR1).isReduced_rootPairing
    fun α hα => (hdr α hα).2
  { toWithRootDatum := (SplitReductiveData.WithReflections.ofLineAttractor D hR1).toWithRootDatum
      (baseInt _)
      (WeylAlt.exists_weylGroup_rootPairing (SplitReductiveData.WithReflections.ofLineAttractor D hR1)
        (baseInt _))
    torsionFree := fun x n hn => by
      have : IsAddTorsionFree (Additive X) := .of_isTorsionFree ℤ (Additive X)
      rcases eq_or_ne n 0 with h | h
      · exact Or.inl h
      · exact Or.inr ((nsmul_right_injective h) (hn.trans (nsmul_zero n).symm))
    finrank_rootSpace := fun α hα => (hdr α hα).1 }

end AlgMag.Reductive
