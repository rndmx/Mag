import Mathlib.LinearAlgebra.RootSystem.BaseExists
import AlgMag.Reductive.RootDatumFromGPairing

/-!
# Bases of root pairings over `ℤ`

For a finite reduced root pairing `P` over `ℤ` (for instance a root datum), we construct a base
`P.Base` with no further input.

* `exists_forall_ne_zero_int`: finitely many nonzero `ℤ`-valued forms have a common non-zero;
* `exists_regular_pair`: linear forms `f` on `M` and `g` on `N`, nonzero on all roots, resp.
  coroots, with `f(α) > 0 ↔ g(α^∨) > 0` (`f = g ∘ Polarization`);
* `baseOf_root_subset_baseOf_coroot`: the simple roots of `f` are simple coroots of `g`;
* `baseInt`: the base whose simple roots are the indecomposable `f`-positive roots;
* `nonempty_base_int`: every finite reduced root pairing over `ℤ` has a base;
* `WithReflections.toWithRootDatumOfReduced`: `WithRootDatum` from `G` with the base built here,
  the remaining inputs being reducedness and `W ⊆ W(Φ)`.

The proof follows Serre, *Algèbres de Lie semi-simples complexes*, Ch. V, §8–9, as in Mathlib's
`RootPairing.nonempty_base` (over fields), run over `ℤ`: `f = g ∘ Polarization` makes the
`f`-positive roots and the `g`-positive coroots correspond, and linear independence of the simple
roots over `ℤ` (`RootPairing.linearIndepOn_root_baseOf'`) identifies simple roots and simple
coroots.
-/

open Function Set Module IsAddIndecomposable

namespace AlgMag.RootDatumBase

/-- **A common non-zero**: finitely many `ℤ`-valued additive forms, each nonzero somewhere, are
simultaneously nonzero at one point. -/
theorem exists_forall_ne_zero_int {κ V : Type*} [Finite κ] [AddCommGroup V] (φ : κ → V →+ ℤ)
    (h : ∀ i, ∃ x, φ i x ≠ 0) : ∃ x, ∀ i, φ i x ≠ 0 := by
  classical
  have : Fintype κ := Fintype.ofFinite κ
  suffices ∀ s : Finset κ, ∃ x, ∀ i ∈ s, φ i x ≠ 0 by
    obtain ⟨x, hx⟩ := this Finset.univ
    exact ⟨x, fun i => hx i (Finset.mem_univ i)⟩
  intro s
  induction s using Finset.induction_on with
  | empty => exact ⟨0, by simp⟩
  | insert j s hj ih =>
    obtain ⟨x, hx⟩ := ih
    obtain ⟨y, hy⟩ := h j
    have hfin : (⋃ i ∈ insert j s, {t : ℤ | φ i x + t * φ i y = 0}).Finite := by
      refine Set.Finite.biUnion (Finset.finite_toSet _) fun i hi => Set.Subsingleton.finite ?_
      intro t ht t' ht'
      simp only [Set.mem_ofPred_eq] at ht ht'
      have hne : φ i y ≠ 0 := by
        intro h0
        rcases Finset.mem_insert.mp hi with rfl | hi
        · exact hy h0
        · rw [h0, mul_zero, add_zero] at ht
          exact hx i hi ht
      have : (t - t') * φ i y = 0 := by linear_combination ht - ht'
      exact sub_eq_zero.mp ((mul_eq_zero.mp this).resolve_right hne)
    obtain ⟨t, ht⟩ := hfin.infinite_compl.nonempty
    refine ⟨x + t • y, fun i hi h0 => ht ?_⟩
    simp only [Set.mem_iUnion, Set.mem_ofPred_eq]
    refine ⟨i, hi, ?_⟩
    simpa [map_add, map_zsmul, smul_eq_mul] using h0

variable {ι M N : Type*} [Finite ι] [AddCommGroup M] [AddCommGroup N]
variable (P : RootPairing ι ℤ M N)

omit [Finite ι] in

/-- `0 < (α, α)` for the canonical form. -/
theorem rootForm_root_self_pos [Fintype ι] (i : ι) : 0 < P.RootForm (P.root i) (P.root i) := by
  rw [P.rootForm_root_self]
  have h := Finset.single_le_sum (f := fun j => P.pairing i j * P.pairing i j)
    (fun j _ => mul_self_nonneg _) (Finset.mem_univ i)
  simp only [P.pairing_same] at h
  linarith

/-- **A regular pair**: `f` on `M`, `g` on `N`, nonzero on roots, resp. coroots, with matching
signs. -/
theorem exists_regular_pair : ∃ (f : Dual ℤ M) (g : Dual ℤ N), (∀ i, f (P.root i) ≠ 0) ∧
    (∀ i, g (P.coroot i) ≠ 0) ∧ ∀ i, 0 < f (P.root i) ↔ 0 < g (P.coroot i) := by
  have : Fintype ι := Fintype.ofFinite ι
  obtain ⟨g, hg⟩ := exists_forall_ne_zero_int
    (fun i => (Dual.eval ℤ N (P.coroot i)).toAddMonoidHom) fun i =>
      ⟨P.toLinearMap (P.root i), by simp [P.root_coroot_two]⟩
  simp only [LinearMap.toAddMonoidHom_coe, Dual.eval_apply] at hg
  refine ⟨g ∘ₗ P.Polarization, g, ?_, hg, ?_⟩ <;> intro i <;>
  · have e := congrArg g (P.rootForm_self_smul_coroot i)
    rw [map_zsmul, map_nsmul, smul_eq_mul, nsmul_eq_mul] at e
    have hpos := rootForm_root_self_pos P i
    have hgi := hg i
    simp only [LinearMap.comp_apply]
    push_cast at e
    first
    | (intro h0; rw [h0, mul_zero] at e
       exact hgi ((mul_eq_zero.mp e).resolve_left hpos.ne'))
    | constructor
      · intro h; nlinarith
      · intro h; nlinarith

omit [Finite ι] in
/-- Elements of the monoid generated by `v '' s` are `ℕ`-combinations of `v` on `s`. -/
theorem exists_finsupp_of_mem_closure {v : ι → M} {s : Set ι} {u : M}
    (hu : u ∈ AddSubmonoid.closure (v '' s)) :
    ∃ A : ι →₀ ℤ, A ∈ Finsupp.supported ℤ ℤ s ∧ (∀ x, 0 ≤ A x) ∧
      Finsupp.linearCombination ℤ v A = u := by
  classical
  induction hu using AddSubmonoid.closure_induction with
  | mem u hu =>
    obtain ⟨x, hx, rfl⟩ := hu
    refine ⟨Finsupp.single x 1, Finsupp.single_mem_supported ℤ 1 hx, fun y => ?_, by simp⟩
    rw [Finsupp.single_apply]
    split_ifs <;> norm_num
  | zero => exact ⟨0, zero_mem _, fun _ => le_rfl, by simp⟩
  | add u w _ _ hu hw =>
    obtain ⟨A, hA, hA0, rfl⟩ := hu
    obtain ⟨B, hB, hB0, rfl⟩ := hw
    exact ⟨A + B, add_mem hA hB, fun x => by simpa using add_nonneg (hA0 x) (hB0 x), by simp⟩

omit [Finite ι] in
/-- If `c α_i = c' α_j + c'' α_k` with `c', c'' > 0`, `α_j, α_k` nonnegative combinations of an
independent family containing `α_i`, then `α_j ∈ ℤ α_i`. -/
theorem exists_eq_smul_of_smul_eq_add {v : ι → M} {s : Set ι} (hli : LinearIndepOn ℤ v s)
    {i j k : ι} (hi : i ∈ s) {c c' c'' : ℤ} (hc' : 0 < c') (hc'' : 0 < c'')
    (hj : v j ∈ AddSubmonoid.closure (v '' s)) (hk : v k ∈ AddSubmonoid.closure (v '' s))
    (h : c • v i = c' • v j + c'' • v k) : ∃ n : ℤ, v j = n • v i := by
  classical
  obtain ⟨A, hA, hA0, hAj⟩ := exists_finsupp_of_mem_closure hj
  obtain ⟨B, hB, hB0, hBk⟩ := exists_finsupp_of_mem_closure hk
  have hz := linearIndepOn_iff.mp hli (c • Finsupp.single i 1 - c' • A - c'' • B)
    (sub_mem (sub_mem (Submodule.smul_mem _ _ (Finsupp.single_mem_supported ℤ 1 hi))
      (Submodule.smul_mem _ _ hA)) (Submodule.smul_mem _ _ hB))
    (by simp [map_sub, map_smul, hAj, hBk, h])
  have hAx : ∀ x, x ≠ i → A x = 0 := by
    intro x hx
    have e := congrArg (fun l => l x) hz
    simp only [Finsupp.coe_sub, Finsupp.coe_smul, Pi.sub_apply, Pi.smul_apply, smul_eq_mul,
      Finsupp.single_apply, Ne.symm hx, ↓reduceIte, mul_zero, zero_sub, Finsupp.coe_zero,
      Pi.zero_apply] at e
    have h1 := hA0 x
    have h2 := hB0 x
    have h3 : 0 ≤ c'' * B x := mul_nonneg hc''.le h2
    rcases h1.lt_or_eq with h1 | h1
    · have : 0 < c' * A x := mul_pos hc' h1
      linarith
    · exact h1.symm
  refine ⟨A i, ?_⟩
  have hA' : A = Finsupp.single i (A i) := by
    ext x
    by_cases hx : x = i
    · subst hx; simp
    · simp [Ne.symm hx, hAx x hx]
  rw [← hAj, hA', Finsupp.linearCombination_single]
  simp

/-- **Simple roots are simple coroots**: for regular `f`, `g` with matching signs, an
indecomposable `f`-positive root has an indecomposable `g`-positive coroot. -/
theorem baseOf_root_subset_baseOf_coroot [P.IsReduced] (f : Dual ℤ M) (g : Dual ℤ N)
    (hf : ∀ i, f (P.root i) ≠ 0) (hfg : ∀ i, 0 < f (P.root i) ↔ 0 < g (P.coroot i)) :
    baseOf P.root (f : M →+ ℤ) ⊆ baseOf P.coroot (g : N →+ ℤ) := by
  have : Fintype ι := Fintype.ofFinite ι
  intro i hi
  have his : i ∈ baseOf P.root (f : M →+ ℤ) := hi
  have hipos : 0 < f (P.root i) := by simpa using hi.1
  refine ⟨by simpa using (hfg i).mp hipos, fun j hj k hk h => ?_⟩
  have hj' : 0 < f (P.root j) := (hfg j).mpr (by simpa using hj)
  have hk' : 0 < f (P.root k) := (hfg k).mpr (by simpa using hk)
  exfalso
  have hli := P.linearIndepOn_root_baseOf' (S := ℤ) f hf
  have hcl : ∀ l, 0 < f (P.root l) →
      P.root l ∈ AddSubmonoid.closure (P.root '' baseOf P.root (f : M →+ ℤ)) := by
    intro l hl
    rw [AddSubmonoid.closure_image_isAddIndecomposable_baseOf]
    exact AddSubmonoid.subset_closure ⟨l, by simpa using hl, rfl⟩
  have e : P.CorootForm (P.coroot i) (P.coroot i) • P.root i =
      P.CorootForm (P.coroot j) (P.coroot j) • P.root j +
        P.CorootForm (P.coroot k) (P.coroot k) • P.root k := by
    rw [P.corootForm_self_smul_root i, P.corootForm_self_smul_root j,
      P.corootForm_self_smul_root k, h, map_add, smul_add]
  have hpos : ∀ l, 0 < P.CorootForm (P.coroot l) (P.coroot l) := fun l =>
    rootForm_root_self_pos P.flip l
  have key : ∀ l, 0 < f (P.root l) → (∃ n : ℤ, P.root l = n • P.root i) → l = i := by
    rintro l hl ⟨n, hn⟩
    have hld : ¬ LinearIndependent ℤ ![P.root l, P.root i] := by
      rw [LinearIndependent.pair_iff]
      push Not
      exact ⟨1, -n, by rw [hn]; module, by simp⟩
    rcases RootPairing.IsReduced.eq_or_eq_neg (P := P) l i hld with h' | h'
    · exact P.root.injective h'
    · rw [h', map_neg] at hl
      linarith
  have hji := key j hj' (exists_eq_smul_of_smul_eq_add hli his (hpos j) (hpos k) (hcl j hj')
    (hcl k hk') e)
  have hki := key k hk' (exists_eq_smul_of_smul_eq_add hli his (hpos k) (hpos j) (hcl k hk')
    (hcl j hj') (e.trans (add_comm _ _)))
  rw [hji, hki] at h
  exact P.ne_zero' i (by simpa using h)

/-- For regular `f`, `g` with matching signs, simple roots and simple coroots coincide. -/
theorem baseOf_root_eq_baseOf_coroot [P.IsReduced] (f : Dual ℤ M) (g : Dual ℤ N)
    (hf : ∀ i, f (P.root i) ≠ 0) (hg : ∀ i, g (P.coroot i) ≠ 0)
    (hfg : ∀ i, 0 < f (P.root i) ↔ 0 < g (P.coroot i)) :
    baseOf P.root (f : M →+ ℤ) = baseOf P.coroot (g : N →+ ℤ) := by
  have : Module.IsReflexive ℤ N := .of_isPerfPair P.flip.toLinearMap
  have : Module.IsReflexive ℤ M := .of_isPerfPair P.toLinearMap
  have : P.flip.IsReduced := inferInstance
  exact subset_antisymm (baseOf_root_subset_baseOf_coroot P f g hf hfg)
    (baseOf_root_subset_baseOf_coroot P.flip g f hg fun i => (hfg i).symm)

/-- The base attached to a regular pair `(f, g)`. -/
noncomputable def baseOfRegular [P.IsReduced] (f : Dual ℤ M) (g : Dual ℤ N)
    (hf : ∀ i, f (P.root i) ≠ 0) (hg : ∀ i, g (P.coroot i) ≠ 0)
    (hfg : ∀ i, 0 < f (P.root i) ↔ 0 < g (P.coroot i)) : P.Base :=
  letI := P.indexNeg
  { support := (baseOf P.root (f : M →+ ℤ)).toFinite.toFinset
    linearIndepOn_root := by simpa using P.linearIndepOn_root_baseOf' (S := ℤ) f hf
    linearIndepOn_coroot := by
      simpa [baseOf_root_eq_baseOf_coroot P f g hf hg hfg] using
        P.flip.linearIndepOn_root_baseOf' (S := ℤ) g hg
    root_mem_or_neg_mem := fun i => by
      simpa using mem_or_neg_mem_closure_baseOf P.root (f : M →+ ℤ) i (by simpa using hf i)
        (by simp)
    coroot_mem_or_neg_mem := fun i => by
      simpa [baseOf_root_eq_baseOf_coroot P f g hf hg hfg] using
        mem_or_neg_mem_closure_baseOf P.coroot (g : N →+ ℤ) i (by simpa using hg i) (by simp) }

/-- The support of `baseOfRegular` is the set of indecomposable `f`-positive roots. -/
theorem coe_support_baseOfRegular [P.IsReduced] (f : Dual ℤ M) (g : Dual ℤ N)
    (hf : ∀ i, f (P.root i) ≠ 0) (hg : ∀ i, g (P.coroot i) ≠ 0)
    (hfg : ∀ i, 0 < f (P.root i) ↔ 0 < g (P.coroot i)) :
    ((baseOfRegular P f g hf hg hfg).support : Set ι) = baseOf P.root (f : M →+ ℤ) := by
  simp [baseOfRegular]

/-- **The base over `ℤ`**, from the regular pair of `exists_regular_pair`. -/
noncomputable def baseInt [P.IsReduced] : P.Base :=
  baseOfRegular P (exists_regular_pair P).choose (exists_regular_pair P).choose_spec.choose
    (exists_regular_pair P).choose_spec.choose_spec.1
    (exists_regular_pair P).choose_spec.choose_spec.2.1
    (exists_regular_pair P).choose_spec.choose_spec.2.2

/-- **Existence of bases over `ℤ`**: a finite reduced root pairing over `ℤ` has a base. -/
theorem nonempty_base_int [P.IsReduced] : Nonempty P.Base := ⟨baseInt P⟩

end AlgMag.RootDatumBase

namespace AlgMag.Reductive

open TauCeti AlgMag.RootDatumBase

universe u

variable {k : Type u} {H : Type u} {X : Type u}
variable [Field k] [CommRing H] [HopfAlgebra k H] [CommGroup X] [DecidableEq X]
variable [Module.Finite k (Bialgebra.CotangentSpace k H)]
variable {π : H →ₐc[k] MonoidAlgebra k X} (D : SplitReductiveData.WithReflections π)
variable [Module.IsTorsionFree ℤ (Additive X)] [Module.Finite ℤ (Additive X)]

/-- **The base of the root datum of `G`**. -/
noncomputable def SplitReductiveData.WithReflections.base [D.rootPairing.IsReduced] :
    D.rootPairing.Base :=
  baseInt D.rootPairing

/-- **`WithRootDatum` from `G` without a base**: the inputs are reducedness and `W ⊆ W(Φ)`. -/
noncomputable def SplitReductiveData.WithReflections.toWithRootDatumOfReduced
    [D.rootPairing.IsReduced]
    (hW : ∀ w : D.W, ∃ g : D.rootPairing.weylGroup,
      ∀ m : Additive X, (g : D.rootPairing.Aut) • m = w • m) :
    SplitReductiveData.WithRootDatum π :=
  D.toWithRootDatum D.base hW

end AlgMag.Reductive
