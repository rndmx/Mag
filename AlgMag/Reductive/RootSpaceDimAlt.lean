import AlgMag.Reductive.RootGroupGaLie

/-!
# `dim 𝔤_α = 1` and `nα ∉ Φ` from the unipotent group `U_α = G^{[α⟩}_e`

`G = Spec H` over a field `k`, `T = D(X)` acting by conjugation, `α` of infinite order,
`U_α = G^{[α⟩}_e` (`rootGroupIdeal`). No reducedness of `Φ` and no root datum is assumed.

* `mem_lieSubalgebra_rootGroupIdeal_iff_pos`: **`Lie(U_α) = ⊕_{n ≥ 1} 𝔤_{nα}`**, in the form:
  a tangent vector lies in `Lie(U_α)` iff it vanishes on `H_χ` for every `χ ∉ {nα | n ≥ 1}`.
  In particular `𝔤_{nα} ⊆ Lie(U_α)` for `n ≥ 1` (`rootSpace_le_lie`).
* `eq_zero_of_coordinate`: if `O(U_α) = H/J_U` is generated by one element `ȳ`, a tangent vector
  of `U_α` is determined by its value at `y`.
* `finrank_rootSpace_le_one`, `eq_zero_or_eq_zero`: hence each `𝔤_{nα}` (`n ≥ 1`) has dimension
  `≤ 1`, and two of them with `mα ≠ nα` cannot both be nonzero (a combination of their
  generators vanishes at `y`, so it is zero, and `𝔤_{mα} ∩ 𝔤_{nα} = 0`).
* **`finrank_rootSpace_eq_one_and_reduced`**: for `α ∈ Φ` with `O(U_α)` monogenic
  (`U_α` a closed subscheme of `𝔸¹`): `dim 𝔤_α = 1` and `nα ∉ Φ` for `n ≥ 2`.
* **`isRootGroup_iff_monogenic`**: for `G` smooth and `α ∈ Φ`, `U_α` is a root group
  (`U_α ≅ 𝔾_a`, `Lie U_α = 𝔤_α`) iff `O(U_α)` is generated by one element. With
  `finrank_rootSpace_eq_one_and_reduced_iff`: iff `dim 𝔤_α = 1` and `nα ∉ Φ` for all `n ≥ 2`.

So both `dim 𝔤_α = 1` and reducedness come from one geometric input on the rank-one unipotent
group `U_α`: that `O(U_α)` (a polynomial ring `Sym(C)` by BB for faces,
`nonempty_prescribedUnit_equiv_sym`) is in one variable, i.e. `dim U_α ≤ 1`.
-/

suppress_compilation

open Magnetism TauCeti WithConv

namespace AlgMag.Reductive.RankOne

universe u

variable {k : Type u} {H : Type u} {X : Type u}
variable [Field k] [CommRing H] [HopfAlgebra k H] [CommGroup X] [DecidableEq X]
variable [Module.Finite k (Bialgebra.CotangentSpace k H)]
variable {π : H →ₐc[k] MonoidAlgebra k X} {α : Additive X}

/-! ### `Lie(U_α) = ⊕_{n ≥ 1} 𝔤_{nα}` -/

omit [Module.Finite k (Bialgebra.CotangentSpace k H)] in
/-- **`Lie(U_α)` without reducedness**: a tangent vector lies in `Lie(U_α)` iff it vanishes on
every `H_χ` with `χ ∉ {nα | n ≥ 1}`. -/
theorem mem_lieSubalgebra_rootGroupIdeal_iff_pos (hα : ∀ n : ℕ, n • α = 0 → n = 0)
    (d : Derivation k H (Bialgebra.CounitAlgebra k H k)) :
    d ∈ (rootGroupIdeal π α hα).lieSubalgebra (B := k) ↔
      ∀ χ : Additive X, (∀ n : ℕ, 1 ≤ n → χ ≠ n • α) → ∀ h ∈ torusGrading π χ, d h = 0 := by
  have hspan : (rootGroupIdeal π α hα).toIdeal = Ideal.span
      ((⋃ (m : Additive X) (_ : m ∉ rayMagnet α), (torusGrading π m : Set H)) ∪
        {y | ∃ x ∈ torusGrading π 0, x - algebraMap k H (Coalgebra.counit (R := k) x) = y}) := by
    rw [rootGroupIdeal, prescribedUnitHopfIdeal_toIdeal, prescribedUnitIdeal, magnetIdeal,
      Ideal.span_union]
  rw [HopfIdeal.mem_lieSubalgebra_iff_of_toIdeal_eq_span _ hspan]
  constructor
  · intro hd χ hχ h hh
    by_cases hN : χ ∈ rayMagnet α
    · obtain ⟨n, rfl⟩ := AddSubmonoid.mem_closure_singleton.1 hN
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · rw [zero_smul] at hh
        have := hd _ (Or.inr ⟨h, hh, rfl⟩)
        simpa only [map_sub, d.map_algebraMap, sub_zero] using this
      · exact absurd rfl (hχ n hn)
    · exact hd h (Or.inl (Set.mem_iUnion₂.2 ⟨χ, hN, hh⟩))
  · intro hd x hx
    rcases hx with hx | ⟨x, hx, rfl⟩
    · obtain ⟨χ, hχ, hx⟩ := Set.mem_iUnion₂.1 hx
      refine hd χ (fun n _ e => hχ ?_) x hx
      rw [e]
      exact AddSubmonoid.mem_closure_singleton.2 ⟨n, rfl⟩
    · have h0 : ∀ n : ℕ, 1 ≤ n → (0 : Additive X) ≠ n • α := fun n hn e => by
        have := hα n e.symm
        omega
      simpa only [map_sub, d.map_algebraMap, sub_zero] using hd 0 h0 x hx

omit [Module.Finite k (Bialgebra.CotangentSpace k H)] in
/-- **`𝔤_{nα} ⊆ Lie(U_α)`** for `n ≥ 1`. -/
theorem rootSpace_le_lie (hα : ∀ n : ℕ, n • α = 0 → n = 0) {χ : Additive X} (n : ℕ)
    (hn : 1 ≤ n) (hχ : χ = n • α) {d : Derivation k H (Bialgebra.CounitAlgebra k H k)}
    (hd : d ∈ rootSpace π χ) : d ∈ (rootGroupIdeal π α hα).lieSubalgebra (B := k) :=
  (mem_lieSubalgebra_rootGroupIdeal_iff_pos hα d).2 fun χ' hχ' h hh =>
    hd χ' (hχ ▸ hχ' n hn) h hh

/-! ### Root spaces -/

omit [Module.Finite k (Bialgebra.CotangentSpace k H)] in
/-- `𝔤_χ ∩ 𝔤_χ' = 0` for `χ ≠ χ'`. -/
theorem eq_zero_of_mem_rootSpace {χ χ' : Additive X} (hne : χ ≠ χ')
    {d : Derivation k H (Bialgebra.CounitAlgebra k H k)} (hd : d ∈ rootSpace π χ)
    (hd' : d ∈ rootSpace π χ') : d = 0 := by
  have key : ∀ h : H, d h = 0 := by
    intro h
    induction h using induction_torusGrading (π := π) with
    | h0 => exact d.map_zero
    | hadd x y hx hy => rw [map_add, hx, hy, add_zero]
    | hmem β x hx =>
      by_cases hβ : β = χ
      · subst hβ; exact hd' β hne x hx
      · exact hd β hβ x hx
  ext h
  rw [key h]
  rfl

omit [DecidableEq X] in
attribute [local instance] Derivation.adjointComodule in
/-- `𝔤_α ≠ 0` for every root `α`. -/
theorem rootSpace_ne_bot {χ : Additive X} (hχ : χ ∈ roots π) : rootSpace π χ ≠ ⊥ := by
  obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hχ.2
  intro hbot
  have hmem : Derivation.cotangentLinearEquiv (R := k) (A := H) (B := k) x ∈ rootSpace π χ :=
    fun χ' hχ' h hh => cotangentLinearEquiv_eq_zero_of_mem_adjointWeightSpace hx
      (fun e => hχ' (Additive.toMul.injective e)) hh
  rw [hbot, Submodule.mem_bot] at hmem
  exact hx0 ((Derivation.cotangentLinearEquiv (R := k) (A := H) (B := k)).injective
    (hmem.trans (map_zero _).symm))

/-! ### A coordinate of `U_α` determines its tangent vectors -/

omit [DecidableEq X] [Module.Finite k (Bialgebra.CotangentSpace k H)] in
/-- A tangent vector of `U = Spec(H/I)` vanishing at a generator `ȳ` of `H/I` vanishes. -/
theorem eq_zero_of_coordinate {I : HopfIdeal k H} {y : H}
    (hy : Function.Surjective (Polynomial.aeval (R := k) (Ideal.Quotient.mk I.toIdeal y)))
    {d : Derivation k H (Bialgebra.CounitAlgebra k H k)} (hd : d ∈ I.lieSubalgebra (B := k))
    (hdy : d y = 0) : d = 0 := by
  have hdI := (HopfIdeal.mem_lieSubalgebra_iff I d).1 hd
  ext h
  obtain ⟨P, hP⟩ := hy (Ideal.Quotient.mk I.toIdeal h)
  have hmk : Ideal.Quotient.mk I.toIdeal (h - Polynomial.aeval y P) = 0 := by
    rw [map_sub, ← hP, ← Ideal.Quotient.mkₐ_eq_mk k, ← Polynomial.aeval_algHom_apply, sub_self]
  have h1 := hdI _ (Ideal.Quotient.eq_zero_iff_mem.1 hmk)
  rw [map_sub, Derivation.map_aeval, hdy, smul_zero, sub_zero] at h1
  rw [h1]
  rfl

variable (π) in
/-- Evaluation at `y`: `𝔤_χ → k`, `d ↦ d(y)`. -/
def rootSpaceCoord (χ : Additive X) (y : H) : rootSpace π χ →ₗ[k] k where
  toFun d := Bialgebra.CounitAlgebra.algEquivSelf k H k ((d : Derivation k H _) y)
  map_add' a b := by
    rw [← map_add]
    rfl
  map_smul' c a := by
    rw [RingHom.id_apply, ← map_smul]
    rfl

section Monogenic

variable (hα : ∀ n : ℕ, n • α = 0 → n = 0) {y : H}
  (hy : Function.Surjective (Polynomial.aeval (R := k)
    (Ideal.Quotient.mk (rootGroupIdeal π α hα).toIdeal y)))
include hy

omit [Module.Finite k (Bialgebra.CotangentSpace k H)] in
/-- Evaluation at the coordinate is injective on `𝔤_{nα}`, `n ≥ 1`. -/
theorem rootSpaceCoord_injective {χ : Additive X} (n : ℕ) (hn : 1 ≤ n) (hχ : χ = n • α) :
    Function.Injective (rootSpaceCoord π χ y) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  rintro ⟨d, hd⟩ h0
  have hdy : d y = 0 := (Bialgebra.CounitAlgebra.algEquivSelf k H k).injective
    (h0.trans (map_zero _).symm)
  exact Subtype.ext (eq_zero_of_coordinate hy (rootSpace_le_lie hα n hn hχ hd) hdy)

omit [Module.Finite k (Bialgebra.CotangentSpace k H)] in
/-- **`dim 𝔤_{nα} ≤ 1`** for `n ≥ 1`, when `O(U_α)` is monogenic. -/
theorem finrank_rootSpace_le_one {χ : Additive X} (n : ℕ) (hn : 1 ≤ n) (hχ : χ = n • α) :
    Module.finrank k (rootSpace π χ) ≤ 1 := by
  have := LinearMap.finrank_le_finrank_of_injective (rootSpaceCoord_injective hα hy n hn hχ)
  rwa [Module.finrank_self] at this

omit [Module.Finite k (Bialgebra.CotangentSpace k H)] in
/-- **Two distinct `𝔤_{mα}`, `𝔤_{nα}` (`m, n ≥ 1`) are not both nonzero**, when `O(U_α)` is
monogenic. -/
theorem eq_zero_or_eq_zero {χ χ' : Additive X} (m n : ℕ) (hm : 1 ≤ m) (hn : 1 ≤ n)
    (hχ : χ = m • α) (hχ' : χ' = n • α) (hne : χ ≠ χ')
    {d₁ d₂ : Derivation k H (Bialgebra.CounitAlgebra k H k)} (hd₁ : d₁ ∈ rootSpace π χ)
    (hd₂ : d₂ ∈ rootSpace π χ') : d₁ = 0 ∨ d₂ = 0 := by
  have l₁ := rootSpace_le_lie hα m hm hχ hd₁
  have l₂ := rootSpace_le_lie hα n hn hχ' hd₂
  by_cases h₁ : d₁ = 0
  · exact Or.inl h₁
  right
  let e := Bialgebra.CounitAlgebra.algEquivSelf k H k
  have hcomb : e (d₂ y) • d₁ - e (d₁ y) • d₂ = 0 := by
    refine eq_zero_of_coordinate hy (sub_mem ((rootGroupIdeal π α hα).lieSubalgebra.smul_mem _ l₁)
      ((rootGroupIdeal π α hα).lieSubalgebra.smul_mem _ l₂)) ?_
    apply e.injective
    rw [Derivation.sub_apply, Derivation.smul_apply, Derivation.smul_apply, map_sub, map_smul,
      map_smul, smul_eq_mul, smul_eq_mul, map_zero, mul_comm, sub_self]
  rw [sub_eq_zero] at hcomb
  have hv : e (d₂ y) • d₁ = 0 :=
    eq_zero_of_mem_rootSpace hne (Submodule.smul_mem _ _ hd₁)
      (hcomb ▸ Submodule.smul_mem _ _ hd₂)
  have hb : e (d₂ y) = 0 := (smul_eq_zero.1 hv).resolve_right h₁
  exact eq_zero_of_coordinate hy l₂ (e.injective (hb.trans (map_zero e).symm))

/-- **`dim 𝔤_α = 1` and `nα ∉ Φ` for `n ≥ 2`**, for a root `α` such that `O(U_α)` is generated
by one element. -/
theorem finrank_rootSpace_eq_one_and_reduced (hroot : α ∈ roots π) :
    Module.finrank k (rootSpace π α) = 1 ∧ ∀ n : ℕ, 2 ≤ n → n • α ∉ roots π := by
  have hα1 : α = (1 : ℕ) • α := (one_smul _ _).symm
  obtain ⟨d, hd, hd0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot (rootSpace_ne_bot hroot)
  refine ⟨?_, fun n hn hnα => ?_⟩
  · have hinj := rootSpaceCoord_injective hα hy 1 le_rfl hα1
    have hv : rootSpaceCoord π α y ⟨d, hd⟩ ≠ 0 := fun h0 =>
      hd0 (congrArg Subtype.val (hinj (h0.trans (map_zero _).symm)))
    have hsurj : Function.Surjective (rootSpaceCoord π α y) := fun c =>
      ⟨(c / rootSpaceCoord π α y ⟨d, hd⟩) • ⟨d, hd⟩, by
        rw [map_smul, smul_eq_mul, div_mul_cancel₀ _ hv]⟩
    exact (LinearEquiv.ofBijective _ ⟨hinj, hsurj⟩).finrank_eq.trans (Module.finrank_self k)
  · obtain ⟨d₂, hd₂, hd₂0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot (rootSpace_ne_bot hnα)
    have hne : α ≠ n • α := fun h => by
      have := nsmul_injective_of hα (hα1.symm.trans h)
      omega
    rcases eq_zero_or_eq_zero hα hy 1 n le_rfl (by omega) hα1 rfl hne hd hd₂ with h | h
    · exact hd0 h
    · exact hd₂0 h

end Monogenic

/-! ### Root groups -/

/-- **For `G` smooth and `α ∈ Φ`: `U_α` is a root group iff `O(U_α)` is monogenic.** -/
theorem isRootGroup_iff_monogenic [Algebra.Smooth k H] (hα : ∀ n : ℕ, n • α = 0 → n = 0)
    (hroot : α ∈ roots π) :
    IsRootGroup π α (rootGroupIdeal π α hα) ↔ ∃ y : H, Function.Surjective
      (Polynomial.aeval (R := k) (Ideal.Quotient.mk (rootGroupIdeal π α hα).toIdeal y)) := by
  constructor
  · intro h
    obtain ⟨y, -, hb, -⟩ := h.ga
    exact ⟨y, hb.2⟩
  · rintro ⟨y, hy⟩
    obtain ⟨h1, h2⟩ := finrank_rootSpace_eq_one_and_reduced hα hy hroot
    exact isRootGroup_rootGroupIdeal_of_finrank hα h2 h1

/-- **For `G` smooth and `α ∈ Φ`: `O(U_α)` is monogenic iff `dim 𝔤_α = 1` and `nα ∉ Φ`
(`n ≥ 2`).** -/
theorem finrank_rootSpace_eq_one_and_reduced_iff [Algebra.Smooth k H]
    (hα : ∀ n : ℕ, n • α = 0 → n = 0) (hroot : α ∈ roots π) :
    (Module.finrank k (rootSpace π α) = 1 ∧ ∀ n : ℕ, 2 ≤ n → n • α ∉ roots π) ↔
      ∃ y : H, Function.Surjective
        (Polynomial.aeval (R := k) (Ideal.Quotient.mk (rootGroupIdeal π α hα).toIdeal y)) := by
  rw [← isRootGroup_iff_monogenic hα hroot]
  exact ⟨fun ⟨h1, h2⟩ => isRootGroup_rootGroupIdeal_of_finrank hα h2 h1, fun h => by
    obtain ⟨y, -, hb, -⟩ := h.ga
    exact finrank_rootSpace_eq_one_and_reduced hα hb.2 hroot⟩

end AlgMag.Reductive.RankOne
