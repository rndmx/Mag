import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Algebra.Group.Submonoid.BigOperators
import Mathlib.Tactic.Abel

/-!
# Simple transitivity of the Weyl group on positive roots

`M` an abelian group, `Φ ⊆ M` with a basis `B ⊆ Φ` (`Φ⁺ = Φ ∩ ℕB`, `Φ⁺ ∩ -Φ⁺ = ∅` on `Φ`), and
`W` a group acting on `M` by `act`, **generated by simple reflections** `s_α = refl α`
(`α ∈ B`), with `s_α m = m - ⟨m, α^∨⟩ α`, `⟨α, α^∨⟩ = 2`, `s_α` permuting `Φ⁺ \ {α}`, and
coroots `W`-equivariant (`w α = α'` with `α, α' ∈ B` implies `⟨m, α'^∨⟩ = ⟨w⁻¹ m, α^∨⟩`).

* `exchange`: if `w = s_{a_1} ⋯ s_{a_r}` and `w α < 0` (`α ∈ B`), then `w s_α` is (in its action)
  a product of `r - 1` simple reflections (Humphreys 1.7, deletion);
* `act_eq_of_pos` (**Bourbaki VI §1 no. 5, Thm 2 (b)**): an element of `W` preserving `Φ⁺` acts
  trivially on `M`.
-/

namespace AlgMag.Reductive.RootSystem

variable {M : Type*} [AddCommGroup M] {W : Type*} [Group W]

/-- Root-datum input: `W = ⟨s_α : α ∈ B⟩` acting on `M`, with coroots on `B`. -/
structure WeylSystem (Φ B : Set M) (act : W → M →+ M) (refl : M → W) (coroot : M → M →+ ℤ) :
    Prop where
  basis_sub : B ⊆ Φ
  pointed : ∀ α ∈ Φ, α ∈ AddSubmonoid.closure B → -α ∉ AddSubmonoid.closure B
  act_mul : ∀ v w m, act (v * w) m = act v (act w m)
  act_one : ∀ m, act 1 m = m
  act_mem : ∀ w α, α ∈ Φ → act w α ∈ Φ
  refl_act : ∀ α ∈ B, ∀ m, act (refl α) m = m - coroot α m • α
  coroot_self : ∀ α ∈ B, coroot α α = 2
  coroot_act : ∀ w α a, α ∈ B → a ∈ B → act w α = a → ∀ m, coroot a m = coroot α (act w⁻¹ m)
  refl_sq : ∀ α ∈ B, refl α * refl α = 1
  refl_pos : ∀ α ∈ B, ∀ β ∈ Φ, β ∈ AddSubmonoid.closure B → β ≠ α →
    act (refl α) β ∈ AddSubmonoid.closure B
  gen : ∀ w, w ∈ Subgroup.closure (refl '' B)

namespace WeylSystem

variable {Φ B : Set M} {act : W → M →+ M} {refl : M → W} {coroot : M → M →+ ℤ}

/-- The word `s_{a_1} ⋯ s_{a_r}`. -/
def wl (refl : M → W) (l : List M) : W := (l.map refl).prod

variable (S : WeylSystem Φ B act refl coroot)
include S

lemma act_refl_self {α : M} (hα : α ∈ B) : act (refl α) α = -α := by
  rw [S.refl_act α hα, S.coroot_self α hα, two_zsmul]; abel

/-- `w s_α w⁻¹ = s_{wα}` when `wα ∈ B`, in the form `s_{wα} w s_α = w`. -/
lemma conj {v : W} {α a : M} (hα : α ∈ B) (ha : a ∈ B) (hva : act v α = a) (m : M) :
    act (refl a) (act v (act (refl α) m)) = act v m := by
  have hinv : ∀ x, act v⁻¹ (act v x) = x := fun x => by
    rw [← S.act_mul, inv_mul_cancel, S.act_one]
  have h1 : act v (act (refl α) m) = act v m - coroot α m • a := by
    rw [S.refl_act α hα, map_sub, map_zsmul, hva]
  have h2 : act v⁻¹ a = α := by rw [← hva, hinv]
  rw [h1, S.refl_act a ha, S.coroot_act v α a hα ha hva, map_sub, map_zsmul, hinv, h2, map_sub,
    map_zsmul, S.coroot_self α hα, smul_eq_mul]
  rw [show coroot α m - coroot α m * 2 = -coroot α m by omega, neg_zsmul]
  abel

omit [AddCommGroup M] S in
lemma wl_cons (a : M) (l : List M) : wl refl (a :: l) = refl a * wl refl l := by
  simp [wl]

omit [AddCommGroup M] S in
lemma wl_concat (l : List M) (a : M) : wl refl (l ++ [a]) = wl refl l * refl a := by
  simp [wl]

/-- **Exchange / deletion.** -/
theorem exchange : ∀ (l : List M), (∀ x ∈ l, x ∈ B) → ∀ α ∈ B,
    act (wl refl l) α ∉ AddSubmonoid.closure B →
    ∃ l' : List M, (∀ x ∈ l', x ∈ B) ∧ l'.length + 1 = l.length ∧
      ∀ m, act (wl refl l') m = act (wl refl l * refl α) m := by
  intro l
  induction l with
  | nil =>
    intro _ α hα h
    exact absurd (by simpa [wl, S.act_one] using AddSubmonoid.subset_closure hα) h
  | cons a t ih =>
    intro hl α hα h
    have haB : a ∈ B := hl a List.mem_cons_self
    have htB : ∀ x ∈ t, x ∈ B := fun x hx => hl x (List.mem_cons_of_mem a hx)
    rw [wl_cons, S.act_mul] at h
    by_cases ht : act (wl refl t) α ∈ AddSubmonoid.closure B
    · have heq : act (wl refl t) α = a := by
        by_contra hne
        exact h (S.refl_pos a haB _ (S.act_mem _ _ (S.basis_sub hα)) ht hne)
      refine ⟨t, htB, by simp, fun m => ?_⟩
      rw [wl_cons, S.act_mul, S.act_mul, S.conj hα haB heq]
    · obtain ⟨t', ht'B, hlen, heq⟩ := ih htB α hα ht
      refine ⟨a :: t', ?_, by simp [hlen], fun m => ?_⟩
      · intro x hx
        rcases List.mem_cons.1 hx with rfl | hx
        · exact haB
        · exact ht'B x hx
      · rw [wl_cons, S.act_mul, heq, wl_cons, mul_assoc, S.act_mul, S.act_mul, S.act_mul]

/-- A word preserving `Φ⁺` acts trivially. -/
theorem act_wl_eq : ∀ n (l : List M), l.length = n → (∀ x ∈ l, x ∈ B) →
    (∀ γ ∈ Φ, γ ∈ AddSubmonoid.closure B → act (wl refl l) γ ∈ AddSubmonoid.closure B) →
    ∀ m, act (wl refl l) m = m := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro l hn hl hpos m
  rcases List.eq_nil_or_concat' l with rfl | ⟨t, α, rfl⟩
  · simp [wl, S.act_one]
  · have hαB : α ∈ B := hl α (by simp)
    have htB : ∀ x ∈ t, x ∈ B := fun x hx => hl x (by simp [hx])
    have hneg : act (wl refl t) α ∉ AddSubmonoid.closure B := by
      intro ht
      have h := hpos α (S.basis_sub hαB) (AddSubmonoid.subset_closure hαB)
      rw [wl_concat, S.act_mul, S.act_refl_self hαB, map_neg] at h
      exact S.pointed _ (S.act_mem _ _ (S.basis_sub hαB)) ht h
    obtain ⟨t', ht'B, hlen, heq⟩ := S.exchange t htB α hαB hneg
    have heq' : ∀ m, act (wl refl t') m = act (wl refl (t ++ [α])) m := by
      intro m; rw [heq, wl_concat]
    have hlt : t'.length < n := by rw [← hn]; simp; omega
    rw [← heq']
    exact ih _ hlt t' rfl ht'B (fun γ hγ hγB => by rw [heq']; exact hpos γ hγ hγB) m

lemma exists_wl (w : W) : ∃ l : List M, (∀ x ∈ l, x ∈ B) ∧ wl refl l = w := by
  have hw := S.gen w
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨a, ha, rfl⟩ := hx
    exact ⟨[a], by simpa using ha, by simp [wl]⟩
  | one => exact ⟨[], by simp, by simp [wl]⟩
  | mul x y _ _ hx hy =>
    obtain ⟨l1, h1, rfl⟩ := hx
    obtain ⟨l2, h2, rfl⟩ := hy
    refine ⟨l1 ++ l2, fun z hz => ?_, by simp [wl]⟩
    rcases List.mem_append.1 hz with hz | hz
    · exact h1 z hz
    · exact h2 z hz
  | inv x _ hx =>
    obtain ⟨l, hl, rfl⟩ := hx
    refine ⟨l.reverse, fun z hz => hl z (List.mem_reverse.1 hz), ?_⟩
    simp only [wl, List.prod_inv_reverse, List.map_map, List.map_reverse]
    rw [← List.map_reverse, ← List.map_reverse]
    congr 1
    rw [List.map_reverse, List.map_reverse]
    congr 1
    exact List.map_congr_left fun a ha =>
      (inv_eq_of_mul_eq_one_right (S.refl_sq a (hl a ha))).symm

/-- **Bourbaki VI §1 no. 5, Thm 2 (b): an element of `W` preserving `Φ⁺` acts trivially.** -/
theorem act_eq_of_pos (w : W)
    (hw : ∀ γ ∈ Φ, γ ∈ AddSubmonoid.closure B → act w γ ∈ AddSubmonoid.closure B) (m : M) :
    act w m = m := by
  obtain ⟨l, hl, rfl⟩ := S.exists_wl w
  exact S.act_wl_eq _ l rfl hl hw m

end WeylSystem

end AlgMag.Reductive.RootSystem
