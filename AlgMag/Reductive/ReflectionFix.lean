import AlgMag.Reductive.CyclotomicLevi
import AlgMag.Reductive.RootSystemCombinatorics

/-!
# Proposition `prop:weyl-levi` (i): reduction of the Steinberg input to point stabilizers

`fix_eq_hyperplanes` takes as input that the pointwise stabilizer of `M^w` is generated by the
reflections it contains. Here that input is reduced to the statement for the stabilizer of a
single vector (`hPt`), by choosing a vector of `M^w` generic with respect to the finite set of
roots (`exists_generic`).
-/

namespace AlgMag.Reductive.Torsion

variable {M : Type*} [AddCommGroup M] {W : Type*} [Group W] [DistribMulAction W M]
  (B : M →+ M →+ ℤ)

lemma mem_fix_iff_phi (w : W) (x : M) : x ∈ fix w ↔ phi w x = 0 := by
  rw [phi_apply, sub_eq_zero]
  exact ⟨fun h => h.symm, fun h => h.symm⟩

/-- A vector of `M^w` generic for a finite set of roots: a root orthogonal to it is orthogonal
to all of `M^w`. -/
theorem exists_generic (w : W) (s : Finset M) :
    ∃ x₀ ∈ fix (M := M) w, ∀ α ∈ s, B α x₀ = 0 → ∀ y ∈ fix (M := M) w, B α y = 0 := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨0, (mem_fix_iff_phi w 0).2 (map_zero _), by simp⟩
  | insert a s ha ih =>
    obtain ⟨x₀, hx₀, h⟩ := ih
    by_cases hgood : B a x₀ = 0 → ∀ y ∈ fix (M := M) w, B a y = 0
    · refine ⟨x₀, hx₀, fun α hα => ?_⟩
      rcases Finset.mem_insert.1 hα with rfl | hα
      · exact hgood
      · exact h α hα
    · rw [Classical.not_imp] at hgood
      obtain ⟨ha0, hex⟩ := hgood
      obtain ⟨y, hy'⟩ := not_forall.1 hex
      obtain ⟨hy, hay⟩ := Classical.not_imp.1 hy'
      set N : ℕ := 1 + ∑ α ∈ s, (B α y).natAbs with hN
      refine ⟨N • x₀ + y, ?_, fun α hα h0 => ?_⟩
      · rw [mem_fix_iff_phi] at hx₀ hy ⊢
        rw [map_add, map_nsmul, hx₀, hy, smul_zero, add_zero]
      · rw [map_add, map_nsmul, nsmul_eq_mul] at h0
        rcases Finset.mem_insert.1 hα with rfl | hα
        · rw [ha0, mul_zero, zero_add] at h0
          exact absurd h0 hay
        · by_cases hb : B α x₀ = 0
          · exact h α hα hb
          · exfalso
            have h1 : (B α y).natAbs ≤ ∑ β ∈ s, (B β y).natAbs :=
              Finset.single_le_sum (f := fun β => (B β y).natAbs) (fun _ _ => Nat.zero_le _) hα
            have h2 : (B α y).natAbs = N * (B α x₀).natAbs := by
              have : B α y = -((N : ℤ) * B α x₀) := by linarith
              rw [this, Int.natAbs_neg, Int.natAbs_mul, Int.natAbs_natCast]
            have h3 : 1 ≤ (B α x₀).natAbs := Int.natAbs_pos.2 hb
            have h4 : N ≤ N * (B α x₀).natAbs := Nat.le_mul_of_pos_right N h3
            omega

variable {Φ : Set M} {refl : M → W}
  (hreflfix : ∀ α ∈ Φ, ∀ x : M, refl α • x = x ↔ B α x = 0)

include hreflfix in
/-- **Prop. `prop:weyl-levi` (i), `V^w` is an intersection of root hyperplanes**, with the
Steinberg input only for the stabilizer of a single vector: if every point stabilizer is
generated by the reflections `s_α`, `α ⊥ v`, then `M^w` is the set of `x` orthogonal to every
root `α` with `s_α ∈ W_{L_w}`. -/
theorem fix_eq_hyperplanes_of_point (hΦ : Φ.Finite) (w : W)
    (hPt : ∀ v : M, MulAction.stabilizer W v ≤
      Subgroup.closure (refl '' {α ∈ Φ | B α v = 0})) :
    fix (M := M) w = {x | ∀ α ∈ Φ, refl α ∈ levi (M := M) w → B α x = 0} := by
  ext x
  refine ⟨fun hx α hα hl => (hreflfix α hα x).1 (hl x hx), fun hx => ?_⟩
  obtain ⟨x₀, hx₀, hgen⟩ := exists_generic B w hΦ.toFinset
  have hsub : refl '' {α ∈ Φ | B α x₀ = 0} ⊆ (MulAction.stabilizer W x : Subgroup W) := by
    rintro _ ⟨α, ⟨hα, h0⟩, rfl⟩
    have hl : refl α ∈ levi (M := M) w := fun y hy =>
      (hreflfix α hα y).2 (hgen α (hΦ.mem_toFinset.2 hα) h0 y hy)
    exact (hreflfix α hα x).2 (hx α hα hl)
  exact (Subgroup.closure_le _).2 hsub (hPt x₀ hx₀)

include hreflfix in
/-- Under the same point-stabilizer input, the hypothesis `hSt` of `fix_eq_hyperplanes` holds:
the pointwise stabilizer `W_{L_w}` of `M^w` is generated by the reflections it contains. -/
theorem levi_le_closure_of_point (hΦ : Φ.Finite) (w : W)
    (hPt : ∀ v : M, MulAction.stabilizer W v ≤
      Subgroup.closure (refl '' {α ∈ Φ | B α v = 0})) :
    levi (M := M) w ≤ Subgroup.closure (refl '' {α ∈ Φ | refl α ∈ levi (M := M) w}) := by
  obtain ⟨x₀, hx₀, hgen⟩ := exists_generic B w hΦ.toFinset
  intro v hv
  refine Subgroup.closure_mono ?_ (hPt x₀ (hv x₀ hx₀))
  rintro _ ⟨α, ⟨hα, h0⟩, rfl⟩
  exact ⟨α, ⟨hα, fun y hy => (hreflfix α hα y).2 (hgen α (hΦ.mem_toFinset.2 hα) h0 y hy)⟩, rfl⟩

end AlgMag.Reductive.Torsion

/-!
## The point-stabilizer input `hPt`, at the action level (hPt run, 2026-11-10)

Setting: `W` finite acting on `M`, `B` a symmetric `W`-invariant form, `Φ` finite and `W`-stable,
`B α α > 0`, `s_α x = x ↔ B α x = 0`, and `B α α • s_α x = B α α • x - (2 B α x) • α`.

`exists_act_eq_of_smul_eq` (Humphreys 1.12 (c), Steinberg): if `g • v = v` then `g` acts on `M`
as an element of `W_v = ⟨s_α : α ∈ Φ, B α v = 0⟩`. Proof (step 1 of the plan): perturb `v`
to a regular `p = N v + u₀`, pick `u' ∈ W_v` maximizing `B(p, u' g p)`; then `u' g` maps `p` into
its own chamber, hence acts trivially by the chamber input `hU` (simple transitivity on
chambers, which is `RootSystem.WeylSystem.act_eq_of_pos` once a simple system is given).

`fix_eq_hyperplanes_of_chamber`: `M^w = {x | ∀ α ∈ Φ, s_α ∈ W_{L_w} → B α x = 0}` with no
stabilizer hypothesis, only `hU`.
-/

namespace AlgMag.Reductive.Torsion

variable {M : Type*} [AddCommGroup M] {W : Type*} [Group W] [DistribMulAction W M]
  (B : M →+ M →+ ℤ)

/-- A vector regular for a finite set of vectors of nonzero square. -/
theorem exists_regular_of_sq (s : Finset M) (hs : ∀ α ∈ s, B α α ≠ 0) :
    ∃ u : M, ∀ α ∈ s, B α u ≠ 0 := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨0, by simp⟩
  | insert a s ha ih =>
    obtain ⟨u, hu⟩ := ih (fun α hα => hs α (Finset.mem_insert_of_mem hα))
    by_cases hau : B a u = 0
    · set N : ℕ := 1 + ∑ α ∈ s, (B α a).natAbs with hN
      refine ⟨N • u + a, fun α hα => ?_⟩
      rw [map_add, map_nsmul, nsmul_eq_mul]
      rcases Finset.mem_insert.1 hα with rfl | hα
      · rw [hau, mul_zero, zero_add]; exact hs α (Finset.mem_insert_self _ _)
      · intro h0
        have hb := hu α hα
        have h1 : (B α a).natAbs ≤ ∑ β ∈ s, (B β a).natAbs :=
          Finset.single_le_sum (f := fun β => (B β a).natAbs) (fun _ _ => Nat.zero_le _) hα
        have h2 : (B α a).natAbs = N * (B α u).natAbs := by
          have : B α a = -((N : ℤ) * B α u) := by linarith
          rw [this, Int.natAbs_neg, Int.natAbs_mul, Int.natAbs_natCast]
        have h3 : 1 ≤ (B α u).natAbs := Int.natAbs_pos.2 hb
        have h4 : N ≤ N * (B α u).natAbs := Nat.le_mul_of_pos_right N h3
        omega
    · refine ⟨u, fun α hα => ?_⟩
      rcases Finset.mem_insert.1 hα with rfl | hα
      · exact hau
      · exact hu α hα

variable {Φ : Set M} {refl : M → W}
  (hsymm : ∀ a b : M, B a b = B b a)
  (hinv : ∀ (g : W) (a b : M), B (g • a) (g • b) = B a b)
  (hΦW : ∀ g : W, ∀ α ∈ Φ, g • α ∈ Φ)
  (hαα : ∀ α ∈ Φ, 0 < B α α)
  (hreflfix : ∀ α ∈ Φ, ∀ x : M, refl α • x = x ↔ B α x = 0)
  (hrefl : ∀ α ∈ Φ, ∀ x : M, B α α • (refl α • x) = B α α • x - (2 * B α x) • α)
  (hU : ∀ p : M, (∀ α ∈ Φ, B α p ≠ 0) → ∀ h : W,
    (∀ α ∈ Φ, 0 < B α p → 0 < B α (h • p)) → ∀ x : M, h • x = x)

include hsymm hinv hΦW hαα hreflfix hrefl hU in
/-- **`hPt` at the action level** (Humphreys 1.12 (c)): if `g • v = v`, then `g` acts on `M` as
an element of `W_v = ⟨s_α : α ∈ Φ, B α v = 0⟩`. -/
theorem exists_act_eq_of_smul_eq [Finite W] (hΦ : Φ.Finite) {g : W} {v : M} (hg : g • v = v) :
    ∃ u ∈ Subgroup.closure (refl '' {α ∈ Φ | B α v = 0}), ∀ x : M, g • x = u • x := by
  classical
  have := Fintype.ofFinite W
  set Wv := Subgroup.closure (refl '' {α ∈ Φ | B α v = 0}) with hWv
  have hWvfix : ∀ u ∈ Wv, u • v = v := by
    intro u hu
    induction hu using Subgroup.closure_induction with
    | mem x hx =>
      obtain ⟨α, ⟨hα, h0⟩, rfl⟩ := hx
      exact (hreflfix α hα v).2 h0
    | one => exact one_smul W v
    | mul x y _ _ hx hy => rw [mul_smul, hy, hx]
    | inv x _ hx => rw [inv_smul_eq_iff, hx]
  obtain ⟨u₀, hu₀⟩ := exists_regular_of_sq B hΦ.toFinset
    (fun α hα => (hαα α (hΦ.mem_toFinset.1 hα)).ne')
  set N : ℤ := 1 + ∑ α ∈ hΦ.toFinset, ∑ h : W, |B α (h • u₀)| with hN
  set p : M := N • v + u₀ with hp
  have hbound : ∀ α ∈ Φ, ∀ h : W, |B α (h • u₀)| < N := by
    intro α hα h
    have h1 : |B α (h • u₀)| ≤ ∑ h' : W, |B α (h' • u₀)| :=
      Finset.single_le_sum (f := fun h' => |B α (h' • u₀)|) (fun _ _ => abs_nonneg _)
        (Finset.mem_univ h)
    have h2 : ∑ h' : W, |B α (h' • u₀)| ≤ ∑ β ∈ hΦ.toFinset, ∑ h' : W, |B β (h' • u₀)| :=
      Finset.single_le_sum (f := fun β => ∑ h' : W, |B β (h' • u₀)|)
        (fun _ _ => Finset.sum_nonneg fun _ _ => abs_nonneg _) (hΦ.mem_toFinset.2 hα)
    linarith
  have hN0 : 0 < N := by
    have hs : 0 ≤ ∑ α ∈ hΦ.toFinset, ∑ h : W, |B α (h • u₀)| :=
      Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => abs_nonneg _
    linarith
  have hBp : ∀ α : M, ∀ h : W, h • v = v → B α (h • p) = N * B α v + B α (h • u₀) := by
    intro α h hh
    have hc : h • (N • v) = N • (h • v) := smul_comm h N v
    rw [hp, smul_add, hc, hh, map_add, map_zsmul, smul_eq_mul]
  -- sign of `B α (h • p)` for `α` not orthogonal to `v`
  have hpos : ∀ α ∈ Φ, ∀ h : W, h • v = v → 0 < B α v → 0 < B α (h • p) := by
    intro α hα h hh hv
    rw [hBp α h hh]
    have h1 := mul_le_mul_of_nonneg_left (show (1 : ℤ) ≤ B α v from hv) hN0.le
    have h2 := (abs_lt.1 (hbound α hα h)).1
    linarith
  have hneg : ∀ α ∈ Φ, ∀ h : W, h • v = v → B α v < 0 → B α (h • p) < 0 := by
    intro α hα h hh hv
    rw [hBp α h hh]
    have h1 := mul_le_mul_of_nonneg_left (show B α v ≤ -1 by omega) hN0.le
    have h2 := (abs_lt.1 (hbound α hα h)).2
    linarith
  have hp1 : ∀ α : M, B α p = N * B α v + B α u₀ := fun α => by
    simpa using hBp α 1 (one_smul W v)
  have hreg : ∀ α ∈ Φ, B α p ≠ 0 := by
    intro α hα
    rcases lt_trichotomy (B α v) 0 with h | h | h
    · simpa using (hneg α hα 1 (one_smul W v) h).ne
    · rw [hp1, h, mul_zero, zero_add]; exact hu₀ α (hΦ.mem_toFinset.2 hα)
    · simpa using (hpos α hα 1 (one_smul W v) h).ne'
  -- maximize `B(p, u' g p)` over `u' ∈ W_v`
  obtain ⟨u', hu'mem, hmax⟩ := Finset.exists_max_image (Finset.univ.filter (· ∈ Wv))
    (fun u => B p ((u * g) • p)) ⟨1, by simp [Wv.one_mem]⟩
  have hu' : u' ∈ Wv := (Finset.mem_filter.1 hu'mem).2
  have hhv : (u' * g) • v = v := by rw [mul_smul, hg, hWvfix u' hu']
  have hchamber : ∀ α ∈ Φ, 0 < B α p → 0 < B α ((u' * g) • p) := by
    intro α hα hαp
    rcases lt_trichotomy (B α v) 0 with h | h | h
    · have := hneg α hα 1 (one_smul W v) h
      rw [one_smul] at this
      exact absurd hαp (not_lt.2 this.le)
    · set y := (u' * g) • p with hy
      have hyreg : B α y ≠ 0 := by
        have h1 := hinv (u' * g)⁻¹ α y
        rw [hy, inv_smul_smul] at h1
        rw [← h1]
        exact hreg _ (hΦW _ α hα)
      have hsα : refl α ∈ Wv := Subgroup.subset_closure ⟨α, ⟨hα, h⟩, rfl⟩
      have hle := hmax (refl α * u') (Finset.mem_filter.2 ⟨Finset.mem_univ _,
        Wv.mul_mem hsα hu'⟩)
      rw [mul_assoc, mul_smul, ← hy] at hle
      have hc : B α α * B p (refl α • y) = B α α * B p y - 2 * B α y * B α p := by
        have h1 := congrArg (B p) (hrefl α hα y)
        rw [map_zsmul, map_sub, map_zsmul, map_zsmul, smul_eq_mul, smul_eq_mul, smul_eq_mul,
          hsymm p α] at h1
        linarith
      have hαα' := hαα α hα
      have h3 : B α α * B p (refl α • y) ≤ B α α * B p y :=
        mul_le_mul_of_nonneg_left hle hαα'.le
      have h4 : 0 ≤ B α y * B α p := by linarith
      by_contra hcon
      have h5 : B α y < 0 := lt_of_le_of_ne (not_lt.1 hcon) hyreg
      have h6 : B α y * B α p < 0 := mul_neg_of_neg_of_pos h5 hαp
      linarith
    · exact hpos α hα _ hhv h
  have htriv := hU p hreg (u' * g) hchamber
  refine ⟨u'⁻¹, Wv.inv_mem hu', fun x => ?_⟩
  rw [eq_inv_smul_iff, ← mul_smul]
  exact htriv x

include hsymm hinv hΦW hαα hreflfix hrefl hU in
/-- **Prop. `prop:weyl-levi` (i), `V^w` is an intersection of root hyperplanes**, with no
stabilizer hypothesis: only the chamber input `hU`. -/
theorem fix_eq_hyperplanes_of_chamber [Finite W] (hΦ : Φ.Finite) (w : W) :
    fix (M := M) w = {x | ∀ α ∈ Φ, refl α ∈ levi (M := M) w → B α x = 0} := by
  ext x
  refine ⟨fun hx α hα hl => (hreflfix α hα x).1 (hl x hx), fun hx => ?_⟩
  obtain ⟨x₀, hx₀, hgen⟩ := exists_generic B w hΦ.toFinset
  obtain ⟨u, hu, hwu⟩ :=
    exists_act_eq_of_smul_eq B hsymm hinv hΦW hαα hreflfix hrefl hU hΦ (g := w) hx₀
  have hsub : refl '' {α ∈ Φ | B α x₀ = 0} ⊆ (MulAction.stabilizer W x : Subgroup W) := by
    rintro _ ⟨α, ⟨hα, h0⟩, rfl⟩
    have hl : refl α ∈ levi (M := M) w := fun y hy =>
      (hreflfix α hα y).2 (hgen α (hΦ.mem_toFinset.2 hα) h0 y hy)
    exact (hreflfix α hα x).2 (hx α hα hl)
  show w • x = x
  rw [hwu x]
  exact (Subgroup.closure_le _).2 hsub hu

open AlgMag.Reductive.RootSystem in
include hinv hΦW in
/-- The chamber input `hU` from simple systems: if, for every regular `p`, the positive roots
`{α ∈ Φ | 0 < B α p}` are the roots in `ℕS` for a simple system `S` (a `WeylSystem`), then an
element mapping `p` into its own chamber acts trivially (`WeylSystem.act_eq_of_pos`). -/
theorem chamber_of_weylSystem {coroot : M → M →+ ℤ}
    (hS : ∀ p : M, (∀ α ∈ Φ, B α p ≠ 0) → ∃ S : Set M,
      WeylSystem Φ S (fun w : W => DistribSMul.toAddMonoidHom M w) refl coroot ∧
      ∀ α ∈ Φ, (α ∈ AddSubmonoid.closure S ↔ 0 < B α p)) :
    ∀ p : M, (∀ α ∈ Φ, B α p ≠ 0) → ∀ h : W,
      (∀ α ∈ Φ, 0 < B α p → 0 < B α (h • p)) → ∀ x : M, h • x = x := by
  intro p hp h hh x
  obtain ⟨S, hW, hSp⟩ := hS p hp
  have key : ∀ y : M, h⁻¹ • y = y := fun y =>
    hW.act_eq_of_pos h⁻¹ (fun γ hγ hγS => by
      show h⁻¹ • γ ∈ AddSubmonoid.closure S
      have e : B (h⁻¹ • γ) p = B γ (h • p) := by simpa using hinv h⁻¹ γ (h • p)
      refine (hSp _ (hΦW _ γ hγ)).2 ?_
      rw [e]
      exact hh γ hγ ((hSp γ hγ).1 hγS)) y
  have := key x
  rw [inv_smul_eq_iff] at this
  exact this.symm

open AlgMag.Reductive.RootSystem in
include hsymm hinv hΦW hαα hreflfix hrefl in
/-- **Prop. `prop:weyl-levi` (i)** with the chamber input replaced by the existence of simple
systems (`WeylSystem`) for the positive systems cut out by regular vectors. -/
theorem fix_eq_hyperplanes_of_weylSystem [Finite W] (hΦ : Φ.Finite) {coroot : M → M →+ ℤ}
    (hS : ∀ p : M, (∀ α ∈ Φ, B α p ≠ 0) → ∃ S : Set M,
      WeylSystem Φ S (fun w : W => DistribSMul.toAddMonoidHom M w) refl coroot ∧
      ∀ α ∈ Φ, (α ∈ AddSubmonoid.closure S ↔ 0 < B α p)) (w : W) :
    fix (M := M) w = {x | ∀ α ∈ Φ, refl α ∈ levi (M := M) w → B α x = 0} :=
  fix_eq_hyperplanes_of_chamber B hsymm hinv hΦW hαα hreflfix hrefl
    (chamber_of_weylSystem B hinv hΦW hS) hΦ w

end AlgMag.Reductive.Torsion

