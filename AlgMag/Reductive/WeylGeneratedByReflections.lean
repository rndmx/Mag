/-!
# `W = N_G(T)/T` is generated by the reflections `s_α`

`G` smooth and connected over `k = k̄`, `D : SplitReductiveData.WithReflections π`, `X` a
lattice, the root datum `rootPairing` of `RootDatumFromGPairing.lean` reduced with a base `b`.
Then every `w ∈ W` acts on `X` as an element of the Weyl group `W(Φ) = ⟨s_α : α ∈ Φ⟩` of the
root datum (`exists_weylGroup`), so `W = W(Φ)` (the converse inclusion is
`exists_weyl_of_weylGroup_rootPairing`), and `toWithRootDatumOfConnected` needs no hypothesis
on `W`.

Magnetic proof.
* `eq_one_of_pairingHom_fixed`: let `λ` be a cocharacter with `⟨α, λ⟩ ≠ 0` for all roots and
  `w ∈ W` with `⟨w χ, λ⟩ = ⟨χ, λ⟩`. Then `(1 - w)X ⊆ f⁻¹(0)` (`f = ⟨·, λ⟩`), so
  `n_w ∈ G^{f⁻¹(0)} = Z_G(λ)` (`rep_mem_attractorSubgroup_iff`). `Z_G(λ)` is connected (open
  cell, `connectedSpace_levi_of_openCell`), so `G^{f⁻¹(0)} = (G^{f⁻¹(0)})°`, and the latter
  depends only on the roots in `f⁻¹(0)`, i.e. none (`compIdeal_eq_of_roots`): it is
  `(G^0)° ⊆ G^0`. So `n_w ∈ G^0`, i.e. `(1 - w)X = 0`, `w = 1`.
* `exists_translate_pos`: a regular `f` is moved by `W(Φ)` into the chamber of `b`
  (Bourbaki VI §1 Prop. 20, `SimpleSystem.exists_translate_pos_sub_of`).
* `exists_weylGroup`: for `w ∈ W`, move a regular `f₁` positive on `Φ⁺` and `f₁ ∘ w⁻¹` into the
  chamber; this gives `v ∈ W(Φ)` with `x := w⁻¹ v` preserving `Φ⁺`. The average
  `F = Σ_{i < ord x} f₁ ∘ xⁱ` is regular and `x`-invariant, hence `x = 1`.

Connectedness of `G` is needed: `G = T ⋊ ℤ/2` (inversion) is split reductive data with `Φ = ∅`
and `W = ℤ/2`.
-/

suppress_compilation

open Set Function Module Magnetism TauCeti WithConv TauCeti.Cocharacter
open scoped TensorProduct

namespace AlgMag.Reductive

universe u

variable {k : Type u} {H : Type u} {X : Type u}
variable [Field k] [CommRing H] [HopfAlgebra k H] [CommGroup X] [DecidableEq X]
variable [Module.Finite k (Bialgebra.CotangentSpace k H)]
variable {π : H →ₐc[k] MonoidAlgebra k X}

/-- The cocharacter `λ` with `⟨·, λ⟩ = F`. -/
def cocharOf (F : Additive X →+ ℤ) : X →* Multiplicative ℤ where
  toFun x := Multiplicative.ofAdd (F (Additive.ofMul x))
  map_one' := by simp
  map_mul' a b := by simp

omit [DecidableEq X] in
@[simp] lemma pairingHom_cocharOf (F : Additive X →+ ℤ) : pairingHom (cocharOf F) = F := by
  ext χ; rfl

section Geometric

variable [IsAlgClosed k] [Algebra.FiniteType k H] [Algebra.Smooth k H]
  [ConnectedSpace (PrimeSpectrum H)]

omit [Module.Finite k (Bialgebra.CotangentSpace k H)] in
/-- **`Z_G(λ)` is connected**: `(G^{f⁻¹(0)})° = G^{f⁻¹(0)}`. -/
theorem compIdeal_comap_bot_le (ψ : X →* Multiplicative ℤ) :
    compIdeal π ((⊥ : Magnet ℤ).comap (pairingHom ψ)) ≤
      magnetIdeal (torusGrading π) ((⊥ : Magnet ℤ).comap (pairingHom ψ)) := by
  set L := (⊥ : Magnet ℤ).comap (pairingHom ψ)
  have : IrreducibleSpace (PrimeSpectrum H) := AlgMag.OpenCellNotes.irreducibleSpace_of_connectedSpace k
  have hZ := connectedSpace_levi_of_openCell (π.cocharacter ψ) (isOpenEmbedding_openCell _)
  rw [← magnetIdeal_torusGrading_comap_bot, ← magnetHopfIdeal_toIdeal] at hZ
  have : Algebra.FiniteType k (H ⧸ (magnetHopfIdeal π L).toIdeal) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k _) (Ideal.Quotient.mkₐ_surjective k _)
  have hbot : attrComp π L = ⊥ :=
    (HopfAlgebra.identityComponentHopfIdeal_eq_bot_iff_connectedSpace (k := k)
      (H := H ⧸ (magnetHopfIdeal π L).toIdeal)).2 hZ
  intro x hx
  have hx' : Ideal.Quotient.mk _ (Ideal.Quotient.mk _ x) = 0 := hx
  rw [Ideal.Quotient.eq_zero_iff_mem, hbot, HopfIdeal.bot_toIdeal, Ideal.mem_bot,
    Ideal.Quotient.eq_zero_iff_mem, magnetHopfIdeal_toIdeal] at hx'
  exact hx'

/-- **An element of `W` fixing a regular cocharacter is trivial.** If `⟨α, λ⟩ ≠ 0` for all
roots `α` and `⟨w χ, λ⟩ = ⟨χ, λ⟩` for all `χ`, then `w = 1`. -/
theorem eq_one_of_pairingHom_fixed (D : SplitReductiveData π) (ψ : X →* Multiplicative ℤ)
    (hreg : ∀ α ∈ roots π, pairingHom ψ α ≠ 0) (w : D.W)
    (hw : ∀ χ : Additive X, pairingHom ψ (w • χ) = pairingHom ψ χ) : w = 1 := by
  set L := (⊥ : Magnet ℤ).comap (pairingHom ψ)
  have h1 : Weyl.weylMagnet (w : X ≃* X) ≤ L := by
    rw [Weyl.weylMagnet, AddSubmonoid.closure_le]
    rintro _ ⟨χ, rfl⟩
    show pairingHom ψ _ ∈ (⊥ : Magnet ℤ)
    rw [AddSubmonoid.mem_bot, map_sub]
    exact sub_eq_zero.2 (hw χ).symm
  have h2 := (rep_mem_attractorSubgroup_iff D w L).2 h1
  have h3 : compIdeal π ⊥ ≤ RingHom.ker (D.rep w).ofConv := by
    rw [compIdeal_eq_of_roots π bot_le (fun α hα => iff_of_false ?_ ?_)]
    · exact (compIdeal_comap_bot_le ψ).trans ((mem_attractorSubgroup π).1 h2)
    · rw [AddSubmonoid.mem_bot]; exact ne_zero_of_mem_roots hα
    · show pairingHom ψ α ∉ (⊥ : Magnet ℤ)
      rw [AddSubmonoid.mem_bot]; exact hreg α hα
  have h4 : D.rep w ∈ attractorSubgroup π ⊥ k :=
    compSubgroup_le π ⊥ ((mem_compSubgroup π ⊥ _).2 h3)
  have h5 := (rep_mem_attractorSubgroup_iff D w ⊥).1 h4
  refine weyl_ext fun m => ?_
  have := h5 (AddSubmonoid.subset_closure ⟨m, rfl⟩)
  rw [AddSubmonoid.mem_bot, sub_eq_zero] at this
  rw [one_smul]
  exact this.symm

end Geometric

/-! ### Moving a regular form into the chamber -/

namespace Parabolic.SimpleSystem

variable {M : Type*} [AddCommGroup M] {Φ B : Set M} {W : Type*} [Group W] {act : W → M →+ M}

/-- **A regular form is moved into the chamber** (Bourbaki VI §1 Prop. 20): if `f` is nonzero on
`Φ`, some `v ∈ W` has `f ∘ v > 0` on `Φ⁺`. -/
theorem exists_translate_pos (S : SimpleSystem Φ B act) (f : M →+ ℤ) (hf : ∀ β ∈ Φ, f β ≠ 0) :
    ∃ v : W, ∀ γ ∈ Φ, γ ∈ AddSubmonoid.closure B → 0 < f (act v γ) := by
  have hstep : ∀ v : W, (∀ α ∈ B, act v α ∈ {β | β ∈ Φ ∧ 0 < f β}) →
      ∀ β ∈ Φ, β ∈ AddSubmonoid.closure B → act v β ∈ {β | β ∈ Φ ∧ 0 < f β} := by
    intro v hall β hβ hβB
    have key : ∀ x ∈ AddSubmonoid.closure B, 0 ≤ f (act v x) := by
      intro x hx
      induction hx using AddSubmonoid.closure_induction with
      | mem x hx => exact (hall x hx).2.le
      | zero => simp
      | add x y _ _ hx hy => rw [map_add, map_add]; exact add_nonneg hx hy
    exact ⟨S.act_mem v β hβ, lt_of_le_of_ne (key β hβB) (Ne.symm (hf _ (S.act_mem v β hβ)))⟩
  have hu : {β | β ∈ Φ ∧ 0 < f β} ∪ -{β | β ∈ Φ ∧ 0 < f β} = Φ := by
    ext β
    rw [Set.mem_union, Set.mem_neg]
    constructor
    · rintro (h | h)
      · exact h.1
      · have := S.neg_mem _ h.1
        rwa [neg_neg] at this
    · intro hβ
      rcases lt_or_gt_of_ne (hf β hβ) with h | h
      · right
        exact ⟨S.neg_mem β hβ, by rw [map_neg]; omega⟩
      · left
        exact ⟨hβ, h⟩
  obtain ⟨v, hv⟩ := S.exists_translate_pos_sub_of hstep hu
  refine ⟨v, fun γ hγ hγB => (hv ⟨S.act_mem v γ hγ, ?_⟩).2⟩
  rw [SetLike.mem_coe, S.mem_closure_translate, S.act_inv_act]
  exact hγB

end Parabolic.SimpleSystem

/-! ### `W ⊆ W(Φ)` -/

namespace SplitReductiveData.WithReflections

variable (D : SplitReductiveData.WithReflections π)
variable [Module.IsTorsionFree ℤ (Additive X)] [Module.Finite ℤ (Additive X)]

/-- A form `X → ℤ` nonzero on all roots. -/
lemma exists_regular : ∃ f : Additive X →+ ℤ, ∀ α ∈ roots π, f α ≠ 0 := by
  have : Module.Free ℤ (Additive X) := Module.free_of_finite_type_torsion_free'
  obtain ⟨ψ, hψ⟩ := exists_generic_cocharacter (roots π) (finite_roots (π := π))
    (fun α hα => ne_zero_of_mem_roots hα)
  exact ⟨pairingHom ψ, hψ⟩

variable [IsAlgClosed k] [Algebra.FiniteType k H] [Algebra.Smooth k H]
  [ConnectedSpace (PrimeSpectrum H)]

/-- **`W ⊆ W(Φ)`: the Weyl group `N_G(T)/T` is generated by the reflections `s_α`.** Every
`w ∈ W` acts on `X` as an element of the Weyl group of the root datum `rootPairing`. -/
theorem exists_weylGroup [D.rootPairing.IsReduced] (b : D.rootPairing.Base) (w : D.W) :
    ∃ g : D.rootPairing.weylGroup,
      ∀ m : Additive X, (g : D.rootPairing.Aut) • m = w • m := by
  classical
  have S := RootSystem.RootDatum.simpleSystem D.rootPairing b
  rw [D.range_root_rootPairing] at S
  obtain ⟨f0, hf0⟩ := exists_regular (π := π)
  obtain ⟨v1, hv1⟩ := S.exists_translate_pos f0 hf0
  set f1 := f0.comp (RootSystem.RootDatum.act D.rootPairing v1) with hf1def
  have hf1 : ∀ γ ∈ roots π, γ ∈ AddSubmonoid.closure (D.rootPairing.root '' b.support) →
      0 < f1 γ := hv1
  have hf1ne : ∀ γ ∈ roots π, f1 γ ≠ 0 := fun γ hγ => hf0 _ (S.act_mem v1 γ hγ)
  obtain ⟨v2, hv2⟩ := S.exists_translate_pos
    (f1.comp (DistribSMul.toAddMonoidHom (Additive X) w⁻¹))
    (fun β hβ => hf1ne _ (D.smul_mem_roots w⁻¹ hβ))
  obtain ⟨w2, hw2⟩ := D.exists_weyl_of_weylGroup_rootPairing v2
  set x := w⁻¹ * w2 with hxdef
  have hx : ∀ γ ∈ roots π, γ ∈ AddSubmonoid.closure (D.rootPairing.root '' b.support) →
      0 < f1 (x • γ) := by
    intro γ hγ hγB
    have h := hv2 γ hγ hγB
    have h' : 0 < f1 (w⁻¹ • ((v2 : D.rootPairing.Aut) • γ)) := h
    rw [hw2] at h'
    rw [hxdef, mul_smul]
    exact h'
  have hxpos : ∀ γ ∈ roots π, γ ∈ AddSubmonoid.closure (D.rootPairing.root '' b.support) →
      x • γ ∈ AddSubmonoid.closure (D.rootPairing.root '' b.support) := by
    intro γ hγ hγB
    rcases S.pos_or_neg _ (D.smul_mem_roots x hγ) with h | h
    · exact h
    · exfalso
      have h1 := hf1 _ (S.neg_mem _ (D.smul_mem_roots x hγ)) h
      have h2 := hx γ hγ hγB
      rw [map_neg] at h1
      omega
  have hxpow : ∀ i : ℕ, ∀ γ ∈ roots π,
      γ ∈ AddSubmonoid.closure (D.rootPairing.root '' b.support) →
      (x ^ i) • γ ∈ AddSubmonoid.closure (D.rootPairing.root '' b.support) := by
    intro i
    induction i with
    | zero => intro γ _ hγB; rwa [pow_zero, one_smul]
    | succ i ih =>
      intro γ hγ hγB
      rw [pow_succ, mul_smul]
      exact ih _ (D.smul_mem_roots x hγ) (hxpos γ hγ hγB)
  have hn : 0 < orderOf x := orderOf_pos x
  set F : Additive X →+ ℤ := ∑ i ∈ Finset.range (orderOf x),
    f1.comp (DistribSMul.toAddMonoidHom (Additive X) (x ^ i)) with hFdef
  have hF : ∀ m, F m = ∑ i ∈ Finset.range (orderOf x), f1 ((x ^ i) • m) := fun m => by
    rw [hFdef, AddMonoidHom.finsetSum_apply]
    rfl
  have hFx : ∀ m, F (x • m) = F m := by
    intro m
    rw [hF, hF]
    have e1 := Finset.sum_range_succ' (fun i => f1 ((x ^ i) • m)) (orderOf x)
    have e2 := Finset.sum_range_succ (fun i => f1 ((x ^ i) • m)) (orderOf x)
    have e3 : f1 ((x ^ orderOf x) • m) = f1 ((x ^ 0) • m) := by
      rw [pow_orderOf_eq_one, pow_zero]
    have e4 : ∀ i ∈ Finset.range (orderOf x), f1 ((x ^ i) • x • m) = f1 ((x ^ (i + 1)) • m) :=
      fun i _ => by rw [← mul_smul, ← pow_succ]
    rw [Finset.sum_congr rfl e4]
    linarith
  have hFpos : ∀ γ ∈ roots π, γ ∈ AddSubmonoid.closure (D.rootPairing.root '' b.support) →
      0 < F γ := by
    intro γ hγ hγB
    rw [hF]
    exact Finset.sum_pos (fun i _ => hf1 _ (D.smul_mem_roots (x ^ i) hγ) (hxpow i γ hγ hγB))
      (Finset.nonempty_range_iff.2 hn.ne')
  have hFreg : ∀ α ∈ roots π, F α ≠ 0 := by
    intro α hα
    rcases S.pos_or_neg α hα with h | h
    · exact (hFpos α hα h).ne'
    · have := hFpos _ (S.neg_mem α hα) h
      rw [map_neg] at this
      omega
  have hx1 : x = 1 := eq_one_of_pairingHom_fixed D.toSplitReductiveData (cocharOf F)
    (by simpa using hFreg) x (by simpa using hFx)
  have hw : w2 = w := (inv_mul_eq_one.1 hx1).symm
  exact ⟨v2, fun m => by rw [hw2, hw]⟩

/-- **`W = W(Φ)`**: the Weyl group of `rootPairing` acts on `X` exactly as `W`. -/
theorem range_weylGroup_eq [D.rootPairing.IsReduced] (b : D.rootPairing.Base) :
    range (fun g : D.rootPairing.weylGroup => RootSystem.RootDatum.act D.rootPairing g) =
      range (fun w : D.W => actW (w : X ≃* X)) := by
  ext f
  constructor
  · rintro ⟨g, rfl⟩
    obtain ⟨w, hw⟩ := D.exists_weyl_of_weylGroup_rootPairing g
    exact ⟨w, AddMonoidHom.ext fun m => (hw m).symm⟩
  · rintro ⟨w, rfl⟩
    obtain ⟨g, hg⟩ := D.exists_weylGroup b w
    exact ⟨g, AddMonoidHom.ext fun m => hg m⟩

/-- **`WithRootDatum` from `G`, no hypothesis on `W`**: for `G` connected, the root datum
`rootPairing` (reduced, with a base) satisfies `weyl_eq`. -/
def toWithRootDatumOfConnected [D.rootPairing.IsReduced] (b : D.rootPairing.Base) :
    SplitReductiveData.WithRootDatum π :=
  D.toWithRootDatum b (D.exists_weylGroup b)

end SplitReductiveData.WithReflections

end AlgMag.Reductive
