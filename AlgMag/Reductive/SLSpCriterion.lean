import AlgMag.Rooted.ReductiveRooted
import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Algebra.Group.Subgroup.Ker
import Mathlib.Algebra.BigOperators.Pi
import Mathlib.Algebra.Ring.Int.Units
import Mathlib.Algebra.Module.Pi
import Mathlib.Tactic.TFAE
import Mathlib.Algebra.Group.Submonoid.BigOperators

/-!
# The `SL × Sp` criterion (Theorem `thm:red-SL-Sp`)

`G` split reductive over a field, `T = D(M)`, roots `Φ ⊆ M`, Weyl group acting by `act`,
`Z_w = (1 - w)M`. The pure-magnet predicate `P` of the conjugation action enters through
`AlgMag.Rooted.ReductiveInput` (Theorem `thm:red-pure`: `E(G^N) = [N ∩ Φ⟩ + Σ_{Z_w ⊆ N} Z_w`),
which is an explicit hypothesis here.

* `JoinIrredWeylGenerated Φ act` is condition (iii): `(1 - w)M = ℤ(Φ ∩ (1 - w)M)` for every `w`.
* (iii) ⇒ (i): `bijOn_inter_of_joinIrredWeylGenerated` (the map `N ↦ N ∩ Φ` is a bijection from
  pure magnets onto additively stable subsets, inverse `E ↦ [E⟩`).
* (iii) ⇒ (ii): `isJoinDense_of_joinIrredWeylGenerated` (rooted by `{[α⟩ : α ∈ Φ}`).
* (i) ⇒ (iii): `joinIrredWeylGenerated_of_injOn` (injectivity alone suffices).
* (ii) ⇒ (iii): `joinIrredWeylGenerated_of_isJoinDense`.
* (iv) ⇒ (iii), lattice part: `joinIrredWeylGenerated_typeA` (`ℤ^n`, permutations),
  `joinIrredWeylGenerated_typeC` (`ℤ^n`, signed permutations), stability under finite products
  `joinIrredWeylGenerated_pi`, surjective equivariant images `joinIrredWeylGenerated_of_image`, and the
  transfer `joinIrredWeylGenerated_of_transfer` along `ρ : M → P` (`(1-w)λ` depends only on
  `ρ(λ)` through a map `j : ℤΦ_P → M` sending roots to roots).
-/

namespace AlgMag.Reductive.SLSp

open AlgMag.Rooted
open scoped Pointwise

section Abstract

variable {M : Type*} [AddCommGroup M]

/-- `Z_w = (1 - w)M` as a subgroup. -/
def weylSubgroup (w : M →+ M) : AddSubgroup M := (AddMonoidHom.id M - w).range

lemma mem_weylMagnet {w : M →+ M} {z : M} : z ∈ Rooted.weylMagnet w ↔ ∃ x, x - w x = z := by
  simp [Rooted.weylMagnet]

lemma mem_weylSubgroup {w : M →+ M} {z : M} : z ∈ weylSubgroup w ↔ ∃ x, x - w x = z := by
  simp [weylSubgroup]

lemma coe_weylMagnet (w : M →+ M) :
    (Rooted.weylMagnet w : Set M) = (weylSubgroup w : Set M) := by
  ext z; rw [SetLike.mem_coe, SetLike.mem_coe, mem_weylMagnet, mem_weylSubgroup]

/-- **Condition (iii)**: `(1 - w)M = ℤ(Φ ∩ (1 - w)M)` for every `w` (the inclusion `⊇` is
automatic). -/
def JoinIrredWeylGenerated (Φ : Set M) {W : Type*} (act : W → M →+ M) : Prop :=
  ∀ w, ∀ z ∈ weylSubgroup (act w), z ∈ AddSubgroup.closure (Φ ∩ (weylSubgroup (act w) : Set M))

variable {Φ : Set M} {W : Type*} {act : W → M →+ M}

lemma reductiveHull_le (N : AddSubmonoid M) : reductiveHull Φ act N ≤ N :=
  sup_le (AddSubmonoid.closure_le.2 Set.inter_subset_left) (iSup₂_le fun _ hw => hw)

lemma weylMagnet_le_reductiveHull (N : AddSubmonoid M) (w : W)
    (hw : Rooted.weylMagnet (act w) ≤ N) : Rooted.weylMagnet (act w) ≤ reductiveHull Φ act N :=
  le_trans (le_iSup₂ (f := fun v (_ : v ∈ {v | Rooted.weylMagnet (act v) ≤ N}) =>
    Rooted.weylMagnet (act v)) w hw) le_sup_right

/-- A subgroup generated by a symmetric set is the submonoid it generates. -/
lemma mem_closure_of_symm {S : Set M} (hS : ∀ x ∈ S, -x ∈ S) {z : M}
    (hz : z ∈ AddSubgroup.closure S) : z ∈ AddSubmonoid.closure S := by
  rw [← AddSubgroup.mem_toAddSubmonoid, AddSubgroup.closure_toAddSubmonoid] at hz
  refine AddSubmonoid.closure_mono ?_ hz
  rintro x (hx | hx)
  · exact hx
  · simpa using hS _ (Set.mem_neg.1 hx)

/-- Under (iii) with `Φ = -Φ`, `Z_w ⊆ [Φ ∩ Z_w⟩`. -/
lemma weylMagnet_le_closure (hΦ : ∀ α ∈ Φ, -α ∈ Φ) (h3 : JoinIrredWeylGenerated Φ act) (w : W) :
    Rooted.weylMagnet (act w) ≤
      AddSubmonoid.closure (Φ ∩ (Rooted.weylMagnet (act w) : Set M)) := by
  intro z hz
  rw [coe_weylMagnet]
  refine mem_closure_of_symm (S := Φ ∩ (weylSubgroup (act w) : Set M)) (fun x hx => ⟨hΦ x hx.1, neg_mem hx.2⟩) (h3 w z ?_)
  rw [← SetLike.mem_coe, ← coe_weylMagnet]; exact hz

/-- Under (iii), `E(G^N) = [N ∩ Φ⟩`. -/
theorem reductiveHull_eq_closure (hΦ : ∀ α ∈ Φ, -α ∈ Φ) (h3 : JoinIrredWeylGenerated Φ act)
    (N : AddSubmonoid M) :
    reductiveHull Φ act N = AddSubmonoid.closure ((N : Set M) ∩ Φ) :=
  le_antisymm (sup_le le_rfl (iSup₂_le fun w hw =>
    (weylMagnet_le_closure hΦ h3 w).trans
      (AddSubmonoid.closure_mono fun _ hx => ⟨hw hx.2, hx.1⟩))) le_sup_left

lemma closure_inter_eq (N : AddSubmonoid M) :
    (AddSubmonoid.closure ((N : Set M) ∩ Φ) : Set M) ∩ Φ = (N : Set M) ∩ Φ :=
  le_antisymm (fun _ hx => ⟨AddSubmonoid.closure_le.2 Set.inter_subset_left hx.1, hx.2⟩)
    (fun _ hx => ⟨AddSubmonoid.subset_closure hx, hx.2⟩)

variable {P : AddSubmonoid M → Prop}

/-- Under (iii), `N` is pure iff `N = [N ∩ Φ⟩`. -/
theorem pure_iff_of_joinIrredWeylGenerated (H : ReductiveInput P Φ act) (hΦ : ∀ α ∈ Φ, -α ∈ Φ)
    (h3 : JoinIrredWeylGenerated Φ act) (N : AddSubmonoid M) :
    P N ↔ N = AddSubmonoid.closure ((N : Set M) ∩ Φ) := by
  rw [H.pure_iff, reductiveHull_eq_closure hΦ h3]

/-- **Theorem `thm:red-SL-Sp`, (iii) ⇒ (i).** `N ↦ N ∩ Φ` is a bijection from pure magnets onto
additively stable subsets of `Φ`, with inverse `E ↦ [E⟩`. -/
theorem bijOn_inter_of_joinIrredWeylGenerated (H : ReductiveInput P Φ act) (hΦ : ∀ α ∈ Φ, -α ∈ Φ)
    (h3 : JoinIrredWeylGenerated Φ act) :
    Set.BijOn (fun N : AddSubmonoid M => (N : Set M) ∩ Φ) {N | P N} {E | IsStableElt Φ E} ∧
      Set.InvOn AddSubmonoid.closure (fun N : AddSubmonoid M => (N : Set M) ∩ Φ)
        {N | P N} {E | IsStableElt Φ E} := by
  have hp := pure_iff_of_joinIrredWeylGenerated H hΦ h3
  refine ⟨⟨fun N hN => ⟨Set.inter_subset_right, ?_⟩, fun N hN L hL h => ?_, fun E hE => ?_⟩,
    fun N hN => ((hp N).1 hN).symm, fun E hE => hE.2⟩
  · show _ = _
    rw [← (hp N).1 hN]
  · rw [(hp N).1 hN, (hp L).1 hL]; exact congrArg _ h
  · refine ⟨AddSubmonoid.closure E, ?_, hE.2⟩
    show P _
    rw [hp, hE.2]

/-- **Theorem `thm:red-SL-Sp`, (iii) ⇒ (ii).** The action is rooted by `{[α⟩ : α ∈ Φ}`. -/
theorem isJoinDense_of_joinIrredWeylGenerated (H : ReductiveInput P Φ act) (hΦ : ∀ α ∈ Φ, -α ∈ Φ)
    (h3 : JoinIrredWeylGenerated Φ act) : IsJoinDense P (mono '' Φ) := by
  have hg : ∀ N, gen (trace (mono '' Φ) N) = AddSubmonoid.closure ((N : Set M) ∩ Φ) := fun N => by
    rw [trace_mono_image]; exact gen_mono_image _
  have hp := pure_iff_of_joinIrredWeylGenerated H hΦ h3
  refine isJoinDense_of_hull (fun N hN => ?_) (fun N => ?_)
  · rw [hg]; exact ((hp N).1 hN).symm
  · rw [hg, hp, closure_inter_eq]

/-- `Z_w` is pure. -/
theorem pure_weylMagnet (H : ReductiveInput P Φ act) (w : W) : P (Rooted.weylMagnet (act w)) :=
  (H.pure_iff _).2 (le_antisymm (weylMagnet_le_reductiveHull _ w le_rfl) (reductiveHull_le _))

/-- `ℤ(Φ ∩ Z_w) ⊆ Z_w`. -/
lemma closure_le_weylSubgroup (w : W) :
    AddSubgroup.closure (Φ ∩ (weylSubgroup (act w) : Set M)) ≤ weylSubgroup (act w) :=
  AddSubgroup.closure_le _ |>.2 Set.inter_subset_right

/-- **Theorem `thm:red-SL-Sp`, (i) ⇒ (iii).** If `N ↦ N ∩ Φ` is injective on pure magnets,
then (iii) holds: `Z_w` and `E(G^{ℤ(Φ ∩ Z_w)})` are pure with the same roots. -/
theorem joinIrredWeylGenerated_of_injOn (H : ReductiveInput P Φ act)
    (hinj : Set.InjOn (fun N : AddSubmonoid M => (N : Set M) ∩ Φ) {N | P N}) :
    JoinIrredWeylGenerated Φ act := by
  intro w z hz
  set Z := Rooted.weylMagnet (act w)
  set Z' := (AddSubgroup.closure (Φ ∩ (weylSubgroup (act w) : Set M))).toAddSubmonoid
  set L := reductiveHull Φ act Z'
  have hZ'Z : Z' ≤ Z := fun x hx => by
    rw [← SetLike.mem_coe, coe_weylMagnet]; exact closure_le_weylSubgroup w hx
  have hroots : (Z : Set M) ∩ Φ = (L : Set M) ∩ Φ := by
    refine le_antisymm (fun x hx => ⟨?_, hx.2⟩) (fun x hx => ⟨hZ'Z (reductiveHull_le _ hx.1), hx.2⟩)
    refine le_sup_left (a := AddSubmonoid.closure ((Z' : Set M) ∩ Φ)) ?_
    refine AddSubmonoid.subset_closure ⟨AddSubgroup.subset_closure ⟨hx.2, ?_⟩, hx.2⟩
    rw [← coe_weylMagnet]; exact hx.1
  have hZL : Z = L := hinj (pure_weylMagnet H w) (H.hull_pure Z') hroots
  have hzZ : z ∈ Z := by rw [← SetLike.mem_coe, coe_weylMagnet]; exact hz
  rw [hZL] at hzZ
  exact reductiveHull_le _ hzZ

/-- **Theorem `thm:red-SL-Sp`, (ii) ⇒ (iii).** -/
theorem joinIrredWeylGenerated_of_isJoinDense (H : ReductiveInput P Φ act)
    (R : IsJoinDense P (mono '' Φ)) : JoinIrredWeylGenerated Φ act := by
  refine joinIrredWeylGenerated_of_injOn H fun N hN L hL h => ?_
  have hg : ∀ N, gen (trace (mono '' Φ) N) = AddSubmonoid.closure ((N : Set M) ∩ Φ) := fun N => by
    rw [trace_mono_image]; exact gen_mono_image _
  rw [← R.left N hN, ← R.left L hL, hg, hg]
  exact congrArg _ h

/-- **Theorem `thm:red-SL-Sp`, (i) ⇔ (ii) ⇔ (iii)** (rectified statement, `Φ = -Φ`). -/
theorem tfae_criterion (H : ReductiveInput P Φ act) (hΦ : ∀ α ∈ Φ, -α ∈ Φ) :
    List.TFAE [Set.BijOn (fun N : AddSubmonoid M => (N : Set M) ∩ Φ) {N | P N}
        {E | IsStableElt Φ E}, IsJoinDense P (mono '' Φ), JoinIrredWeylGenerated Φ act] := by
  tfae_have 1 → 3 := fun h => joinIrredWeylGenerated_of_injOn H h.injOn
  tfae_have 3 → 1 := fun h => (bijOn_inter_of_joinIrredWeylGenerated H hΦ h).1
  tfae_have 2 → 3 := joinIrredWeylGenerated_of_isJoinDense H
  tfae_have 3 → 2 := isJoinDense_of_joinIrredWeylGenerated H hΦ
  tfae_finish

end Abstract

/-! ### (iv) ⇒ (iii): the lattice computation -/

section Transfer

variable {M : Type*} [AddCommGroup M] {Φ : Set M} {W : Type*} {act : W → M →+ M}
variable {Q : Type*} [AddCommGroup Q] {ΦQ : Set Q} {WQ : Type*} {actQ : WQ → Q →+ Q}

/-- (iii) passes to a surjective equivariant image sending roots to roots. -/
theorem joinIrredWeylGenerated_of_image (hQ : JoinIrredWeylGenerated ΦQ actQ) (q : Q →+ M)
    (hq : Function.Surjective q) (hΦ : ∀ α ∈ ΦQ, q α ∈ Φ) (τ : W → WQ)
    (hact : ∀ w x, act w (q x) = q (actQ (τ w) x)) : JoinIrredWeylGenerated Φ act := by
  intro w z hz
  obtain ⟨m, rfl⟩ := mem_weylSubgroup.1 hz
  obtain ⟨x, rfl⟩ := hq m
  have hx : q x - act w (q x) = q (x - actQ (τ w) x) := by rw [map_sub, hact]
  rw [hx]
  have hmem := hQ (τ w) _ (mem_weylSubgroup.2 ⟨x, rfl⟩)
  have : (AddSubgroup.closure (ΦQ ∩ (weylSubgroup (actQ (τ w)) : Set Q))).map q ≤
      AddSubgroup.closure (Φ ∩ (weylSubgroup (act w) : Set M)) := by
    rw [AddMonoidHom.map_closure, AddSubgroup.closure_le]
    rintro _ ⟨α, ⟨hα, hαZ⟩, rfl⟩
    obtain ⟨y, rfl⟩ := mem_weylSubgroup.1 hαZ
    refine AddSubgroup.subset_closure ⟨hΦ _ hα, mem_weylSubgroup.2 ⟨q y, ?_⟩⟩
    rw [map_sub, hact]
  exact this (AddSubgroup.mem_map_of_mem q hmem)

/-- **Transfer.** Let `ρ : M → P` be surjective and `j : ℤΦ_P → M` send roots to roots, with
`(1 - w)λ = j((1 - τ w) ρ(λ))`. Then (iii) for `P` implies (iii) for `M`. This is the reduction
of the paper from `X^*(T)` to the weight lattice `P = ⊕ P_i` of the simply connected derived
group. -/
theorem joinIrredWeylGenerated_of_transfer (hQ : JoinIrredWeylGenerated ΦQ actQ) (ρ : M →+ Q)
    (hρ : Function.Surjective ρ) (j : AddSubgroup.closure ΦQ →+ M)
    (hj : ∀ α (hα : α ∈ ΦQ), j ⟨α, AddSubgroup.subset_closure hα⟩ ∈ Φ) (τ : W → WQ)
    (hact : ∀ w m, ∃ h : ρ m - actQ (τ w) (ρ m) ∈ AddSubgroup.closure ΦQ,
      m - act w m = j ⟨_, h⟩) : JoinIrredWeylGenerated Φ act := by
  intro w z hz
  obtain ⟨m, rfl⟩ := mem_weylSubgroup.1 hz
  obtain ⟨h, hm⟩ := hact w m
  rw [hm]
  have hmem := hQ (τ w) _ (mem_weylSubgroup.2 ⟨ρ m, rfl⟩)
  have key : ∀ x (hx : x ∈ AddSubgroup.closure (ΦQ ∩ (weylSubgroup (actQ (τ w)) : Set Q))),
      j ⟨x, AddSubgroup.closure_mono Set.inter_subset_left hx⟩ ∈
        AddSubgroup.closure (Φ ∩ (weylSubgroup (act w) : Set M)) := by
    intro x hx
    induction hx using AddSubgroup.closure_induction with
    | mem x hx =>
      refine AddSubgroup.subset_closure ⟨hj x hx.1, ?_⟩
      obtain ⟨p, rfl⟩ := mem_weylSubgroup.1 hx.2
      obtain ⟨m', rfl⟩ := hρ p
      obtain ⟨h', hm'⟩ := hact w m'
      exact mem_weylSubgroup.2 ⟨m', hm'⟩
    | zero =>
      show j 0 ∈ _
      rw [map_zero]; exact zero_mem _
    | add x y hx' hy' hx hy =>
      show j (⟨x, AddSubgroup.closure_mono Set.inter_subset_left hx'⟩ +
        ⟨y, AddSubgroup.closure_mono Set.inter_subset_left hy'⟩) ∈ _
      rw [map_add]; exact add_mem hx hy
    | neg x hx' hx =>
      show j (-⟨x, AddSubgroup.closure_mono Set.inter_subset_left hx'⟩) ∈ _
      rw [map_neg]; exact neg_mem hx
  exact key _ hmem

end Transfer

section Pi

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {M : ι → Type*} [∀ i, AddCommGroup (M i)]
variable {Φ : ∀ i, Set (M i)} {W : ι → Type*} {act : ∀ i, W i → M i →+ M i}

/-- The componentwise action of `∏ W_i` on `∏ M_i`. -/
def piAct (act : ∀ i, W i → M i →+ M i) (w : ∀ i, W i) : (∀ i, M i) →+ (∀ i, M i) :=
  AddMonoidHom.pi fun i => (act i (w i)).comp (Pi.evalAddMonoidHom M i)

/-- The roots `⊔_i Φ_i` of a product. -/
def piRoots (Φ : ∀ i, Set (M i)) : Set (∀ i, M i) := ⋃ i, Pi.single i '' Φ i

/-- (iii) is stable under finite products (components of `Φ`, and torus factors with `Φ = ∅`). -/
theorem joinIrredWeylGenerated_pi (h : ∀ i, JoinIrredWeylGenerated (Φ i) (act i)) :
    JoinIrredWeylGenerated (piRoots Φ) (piAct act) := by
  intro w z hz
  obtain ⟨x, rfl⟩ := mem_weylSubgroup.1 hz
  rw [← Finset.univ_sum_single (x - piAct act w x)]
  refine sum_mem fun i _ => ?_
  have hi : (x - piAct act w x) i ∈ weylSubgroup (act i (w i)) :=
    mem_weylSubgroup.2 ⟨x i, by simp [piAct]⟩
  have hc := h i (w i) _ hi
  have hle : (AddSubgroup.closure (Φ i ∩ (weylSubgroup (act i (w i)) : Set (M i)))).map
      (AddMonoidHom.single M i) ≤
        AddSubgroup.closure (piRoots Φ ∩ (weylSubgroup (piAct act w) : Set (∀ i, M i))) := by
    rw [AddMonoidHom.map_closure, AddSubgroup.closure_le]
    rintro _ ⟨α, ⟨hα, hαZ⟩, rfl⟩
    obtain ⟨y, rfl⟩ := mem_weylSubgroup.1 hαZ
    refine AddSubgroup.subset_closure ⟨Set.mem_iUnion.2 ⟨i, _, hα, rfl⟩,
      mem_weylSubgroup.2 ⟨Pi.single i y, ?_⟩⟩
    ext j
    by_cases hj : j = i
    · subst hj; simp [piAct]
    · simp [piAct, hj]
  exact hle (AddSubgroup.mem_map_of_mem _ hc)

end Pi

section Models

variable {ι : Type*} [DecidableEq ι]

/-- If `f` sends each basis vector of `ℤ^ι` into a subgroup `S`, it sends `ℤ^ι` into `S`. -/
lemma map_mem_of_single [Fintype ι] {S : AddSubgroup (ι → ℤ)} (f : (ι → ℤ) →+ (ι → ℤ))
    (h : ∀ i, f (Pi.single i 1) ∈ S) (x : ι → ℤ) : f x ∈ S := by
  rw [← Finset.univ_sum_single x, map_sum]
  refine sum_mem fun i _ => ?_
  have : (Pi.single i (x i) : ι → ℤ) = x i • Pi.single i 1 := by
    ext j; by_cases hj : j = i <;> simp [hj]
  rw [this, map_zsmul]
  exact AddSubgroup.zsmul_mem _ (h i) _

omit [DecidableEq ι] in
/-- `1 - w` as an additive map. -/
lemma sub_apply_eq (w : (ι → ℤ) →+ (ι → ℤ)) (x : ι → ℤ) :
    (AddMonoidHom.id (ι → ℤ) - w) x = x - w x := rfl

lemma joinIrredWeylGenerated_of_single [Fintype ι] {Φ : Set (ι → ℤ)} {W : Type*} {act : W → (ι → ℤ) →+ (ι → ℤ)}
    (h : ∀ w i, Pi.single i 1 - act w (Pi.single i 1) = 0 ∨
      Pi.single i 1 - act w (Pi.single i 1) ∈ Φ) : JoinIrredWeylGenerated Φ act := by
  intro w z hz
  obtain ⟨x, rfl⟩ := mem_weylSubgroup.1 hz
  rw [← sub_apply_eq]
  refine map_mem_of_single _ (fun i => ?_) x
  rw [sub_apply_eq]
  rcases h w i with h0 | hr
  · rw [h0]; exact zero_mem _
  · exact AddSubgroup.subset_closure ⟨hr, mem_weylSubgroup.2 ⟨_, rfl⟩⟩

/-- Permutation action `σ · x = x ∘ σ⁻¹` on `ℤ^ι` (Weyl group of `GL_ι`, type `A`). -/
def permAct (σ : Equiv.Perm ι) : (ι → ℤ) →+ (ι → ℤ) where
  toFun x := x ∘ σ.symm
  map_zero' := rfl
  map_add' _ _ := rfl

/-- Roots of type `A`: `e_i - e_j`, `i ≠ j`. -/
def rootsA : Set (ι → ℤ) := {v | ∃ i j, i ≠ j ∧ v = Pi.single i 1 - Pi.single j 1}

lemma permAct_single (σ : Equiv.Perm ι) (i : ι) :
    permAct σ (Pi.single i 1) = Pi.single (σ i) 1 := by
  ext j
  simp only [permAct, AddMonoidHom.coe_mk, ZeroHom.coe_mk, Function.comp_apply, Pi.single_apply,
    Equiv.symm_apply_eq]

/-- **Type `A`** (`GL_n`, hence `SL_n` by `joinIrredWeylGenerated_of_image`): (iii) holds. -/
theorem joinIrredWeylGenerated_typeA [Fintype ι] : JoinIrredWeylGenerated (rootsA (ι := ι)) permAct := by
  refine joinIrredWeylGenerated_of_single fun σ i => ?_
  rw [permAct_single]
  by_cases h : σ i = i
  · left; rw [h, sub_self]
  · right; exact ⟨i, σ i, Ne.symm h, rfl⟩

/-- Signed permutation action `(ε, σ) · x = (j ↦ ε_j x_{σ⁻¹ j})` (Weyl group of `Sp_{2n}`). -/
def signedPermAct (w : (ι → ℤˣ) × Equiv.Perm ι) : (ι → ℤ) →+ (ι → ℤ) where
  toFun x j := (w.1 j : ℤ) * x (w.2.symm j)
  map_zero' := by ext; simp
  map_add' _ _ := by ext; simp [mul_add]

/-- Roots of type `C`: `±e_i ± e_j` (`i ≠ j`) and `±2e_i`. -/
def rootsC : Set (ι → ℤ) :=
  {v | ∃ i j, i ≠ j ∧ ∃ a b : ℤˣ, v = (a : ℤ) • Pi.single i 1 + (b : ℤ) • Pi.single j 1} ∪
    {v | ∃ i, ∃ a : ℤˣ, v = (2 * (a : ℤ)) • Pi.single i 1}

lemma signedPermAct_single (w : (ι → ℤˣ) × Equiv.Perm ι) (i : ι) :
    signedPermAct w (Pi.single i 1) = (w.1 (w.2 i) : ℤ) • Pi.single (w.2 i) 1 := by
  ext j
  simp only [signedPermAct, AddMonoidHom.coe_mk, ZeroHom.coe_mk, Pi.single_apply,
    Equiv.symm_apply_eq, Pi.smul_apply, smul_eq_mul]
  by_cases h : j = w.2 i
  · subst h; simp
  · simp [h]

/-- **Type `C`** (`Sp_{2n}`): (iii) holds. -/
theorem joinIrredWeylGenerated_typeC [Fintype ι] : JoinIrredWeylGenerated (rootsC (ι := ι)) signedPermAct := by
  refine joinIrredWeylGenerated_of_single fun w i => ?_
  rw [signedPermAct_single]
  by_cases h : w.2 i = i
  · rw [h]
    rcases Int.units_eq_one_or (w.1 i) with h1 | h1
    · left; rw [h1]; simp
    · right; refine Or.inr ⟨i, 1, ?_⟩; rw [h1]
      ext j; by_cases hj : j = i <;> simp [hj]
  · right
    refine Or.inl ⟨i, w.2 i, Ne.symm h, 1, -w.1 (w.2 i), ?_⟩
    simp [sub_eq_add_neg]

end Models

end AlgMag.Reductive.SLSp
