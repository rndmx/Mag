/-!
# (Gen): `U(λ)(k)` is generated by the ray pieces `U_(α)(k)` (CGP 3.3.11, numbering from memory)

`k` algebraically closed, `G = Spec H` smooth of finite type, `T = D(X)` acting through `π`,
`λ = λ_ψ`. The ray piece `U_(α) = G^{[α⟩}_e` is `rootGroupIdeal π α` (RootGroups.lean).

Main theorem: `unipotent_le_closure_rayPoints`. Proof: descending induction along the filtration
`U_{≥n}` (TorusConjDyn `filtrationIdeal`); each step writes the degree-`n` coordinates of
`g ∈ U_{≥n}(k)` as a finite sum over T-weights (`exists_ray_decomposition`, via BigradedF3 on
`P(λ)`), and realizes each summand by a point of `U_(α) ∩ U_{≥n}` (`exists_rayPoint_restrict`, via
`unipotentFiltrationPoints_surjective` on the attractor `G^{[α⟩}`, ParabolicGenTransport).
Also: Lie `U_(α) = ⊕_{m≥1} 𝔤_{mα}` and smoothness of `U_(α)`.
-/

suppress_compilation

open Magnetism TauCeti TauCeti.Cocharacter WithConv

namespace AlgMag.Reductive

universe u

variable {k : Type u} {H : Type u} {X : Type u}
variable [Field k] [CommRing H] [HopfAlgebra k H] [CommGroup X] [DecidableEq X]
variable (π : H →ₐc[k] MonoidAlgebra k X) (ψ : X →* Multiplicative ℤ)

/-- The rays on the positive side of `λ_f`: weights `α` with `⟨α, λ_f⟩ > 0`. -/
def PosRay : Type u := {α : Additive X // 0 < pairingHom ψ α}

lemma PosRay.torsionFree (α : PosRay ψ) : ∀ n : ℕ, n • α.1 = 0 → n = 0 := by
  intro n hn
  by_contra h
  have := congrArg (pairingHom ψ) hn
  rw [map_nsmul, map_zero] at this
  have h2 : 0 < n • pairingHom ψ α.1 := nsmul_pos α.2 h
  omega

/-- `k`-points of the ray piece `U_(α)`. -/
def rayPoints (α : PosRay ψ) : Set (WithConv (H →ₐ[k] k)) :=
  {g | (rootGroupIdeal π α.1 (PosRay.torsionFree ψ α)).toIdeal ≤ RingHom.ker g.ofConv}

/-- **Step 3: `Lie U_(α) = ⊕_{m ≥ 1} 𝔤_{mα}`** (no reducedness hypothesis on the root system). -/
theorem mem_lieSubalgebra_rootGroupIdeal_iff_ray [Module.Finite k (Bialgebra.CotangentSpace k H)]
    (α : Additive X) (hα : ∀ n : ℕ, n • α = 0 → n = 0)
    (d : Derivation k H (Bialgebra.CounitAlgebra k H k)) :
    d ∈ (rootGroupIdeal π α hα).lieSubalgebra (B := k) ↔
      ∀ χ : Additive X, (∀ n : ℕ, 0 < n → χ ≠ n • α) → ∀ h ∈ torusGrading π χ, d h = 0 := by
  have hspan : (rootGroupIdeal π α hα).toIdeal = Ideal.span
      ((⋃ (m : Additive X) (_ : m ∉ rayMagnet α), (torusGrading π m : Set H)) ∪
        {y | ∃ x ∈ torusGrading π 0, x - algebraMap k H (Coalgebra.counit (R := k) x) = y}) := by
    rw [rootGroupIdeal, prescribedUnitHopfIdeal_toIdeal, prescribedUnitIdeal, magnetIdeal,
      Ideal.span_union]
  rw [HopfIdeal.mem_lieSubalgebra_iff_of_toIdeal_eq_span _ hspan]
  constructor
  · intro hd χ hχ h hh
    by_cases hN : χ ∈ rayMagnet α
    · obtain ⟨n, rfl⟩ := AddSubmonoid.mem_closure_singleton.1 hN
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · rw [zero_smul] at hh
        have := hd _ (Or.inr ⟨h, hh, rfl⟩)
        simpa only [map_sub, d.map_algebraMap, sub_zero] using this
      · exact absurd rfl (hχ n hn)
    · exact hd h (Or.inl (Set.mem_iUnion₂.2 ⟨χ, hN, hh⟩))
  · intro hd x hx
    rcases hx with hx | ⟨x, hx, rfl⟩
    · obtain ⟨χ, hχ, hx⟩ := Set.mem_iUnion₂.1 hx
      refine hd χ (fun n _ h => hχ ?_) x hx
      rw [h]
      exact AddSubmonoid.nsmul_mem _ (AddSubmonoid.subset_closure (Set.mem_singleton α)) n
    · have h0 : ∀ n : ℕ, 0 < n → (0 : Additive X) ≠ n • α := fun n hn h =>
        absurd (hα n h.symm) (by omega)
      simpa only [map_sub, d.map_algebraMap, sub_zero] using hd 0 h0 x hx

/-! ### The filtration on points and the descending induction -/

open Classical in
/-- `U_{≥n}(k)`: the `k`-points killing `J_n = filtrationIdeal` (TorusConjDyn). -/
def filtPoints (n : ℕ) : Set (WithConv (H →ₐ[k] k)) :=
  {g | filtrationIdeal (π.cocharacter ψ) n ≤ RingHom.ker g.ofConv}

/-- `U(λ)(k) ⊆ U_{≥1}(k)` (`J_1` is the ideal of `U(λ)`). -/
lemma unipotent_subset_filtPoints_one :
    (unipotent k (π.cocharacter ψ) : Set _) ⊆ filtPoints π ψ 1 := by
  classical
  intro g hg
  simp only [filtPoints, Set.mem_setOf_eq, filtrationIdeal]
  refine sup_le ?_ (Ideal.span_le.2 ?_)
  · rw [BialgHom.unipotentDefiningHopfIdeal, HopfIdeal.ofIdealOfPointsSubgroup_toIdeal]
    exact (BialgHom.unipotentCoefficientIdeal_le_ker_iff _ g).2 hg
  · intro x hx
    obtain ⟨m, ⟨h0, h1⟩, -⟩ := Set.mem_iUnion₂.1 hx
    omega

/-- **(P1, order part)** `U_{≥m}(k) ⊆ U_{≥n}(k)` for `n ≤ m`. PROVED. -/
lemma filtPoints_antitone {n m : ℕ} (h : n ≤ m) : filtPoints π ψ m ⊆ filtPoints π ψ n := by
  classical
  intro g (hg : filtrationIdeal (π.cocharacter ψ) m ≤ _)
  show filtrationIdeal (π.cocharacter ψ) n ≤ _
  refine le_trans (sup_le_sup_left (Ideal.span_mono ?_) _) hg
  intro x hx
  obtain ⟨j, hj, hx⟩ := Set.mem_iUnion₂.1 hx
  exact Set.mem_iUnion₂.2 ⟨j, ⟨hj.1, by omega⟩, hx⟩

/-- **(P2a-i) Generic `μ ⊥ α`.** In any abelian group, if each `χ` of a finite set `W` is
separated from `α` by some `ℤ`-valued form vanishing on `α`, one form `μ` with `μ α = 0` separates
all of them (no finite cover of the lattice `α^⊥` by proper kernels, via finite index). -/
theorem exists_generic_perp {M : Type*} [AddCommGroup M] (α : M) (W : Finset M)
    (hsep : ∀ χ ∈ W, ∃ μ : M →+ ℤ, μ α = 0 ∧ μ χ ≠ 0) :
    ∃ μ : M →+ ℤ, μ α = 0 ∧ ∀ χ ∈ W, μ χ ≠ 0 := by
  classical
  let K : AddSubgroup (M →+ ℤ) :=
    { carrier := {μ | μ α = 0}
      add_mem' := fun {a b} ha hb => by simp_all
      zero_mem' := by simp
      neg_mem' := fun {a} ha => by simp_all }
  let p : M → Submodule ℤ K := fun χ =>
    { carrier := {μ | μ.1 χ = 0}
      add_mem' := fun {a b} ha hb => by simp_all
      zero_mem' := by simp
      smul_mem' := fun c x hx => by simp_all }
  by_contra hne
  push_neg at hne
  have hcov : ⋃ χ ∈ W, (p χ : Set K) = Set.univ := by
    refine Set.eq_univ_of_forall fun μ => ?_
    obtain ⟨χ, hχ, h0⟩ := hne μ.1 μ.2
    exact Set.mem_iUnion₂.2 ⟨χ, hχ, h0⟩
  obtain ⟨χ, hχ, hfi⟩ := Submodule.exists_finiteIndex_of_cover hcov
  obtain ⟨μ0, hα0, hχ0⟩ := hsep χ hχ
  have hmem := AddSubgroup.nsmul_index_mem (p χ).toAddSubgroup (⟨μ0, hα0⟩ : K)
  have hidx : (p χ).toAddSubgroup.index ≠ 0 := hfi.index_ne_zero
  have : ((p χ).toAddSubgroup.index • μ0) χ = 0 := hmem
  rw [AddMonoidHom.nsmul_apply, smul_eq_zero] at this
  rcases this with h | h
  · exact hidx (by exact_mod_cast h)
  · exact hχ0 h

/-- **(P2a) `U_(α)` is smooth.** PROVED: `U_(α) = G^{[α⟩}_e` is a retract of the smooth attractor
`G^{[α⟩}` (`smooth_quotient_prescribedUnitIdeal`, SliceSmooth.lean). No Levi/centralizer needed. -/
theorem smooth_rootGroupIdeal [Algebra.Smooth k H] (α : PosRay ψ) :
    Algebra.Smooth k (H ⧸ (rootGroupIdeal π α.1 (PosRay.torsionFree ψ α)).toIdeal) := by
  rw [rootGroupIdeal, prescribedUnitHopfIdeal_toIdeal]
  exact SliceSmooth.smooth_quotient_prescribedUnitIdeal π _ (rayMagnet_pointed (PosRay.torsionFree ψ α))

/-- **(P1-grp)** `U_{≥n}(k)` is a subgroup (general `G`). For `P(λ) = G` this is
`filtrationIdeal_spec`; in general via (a) (ParabolicGenStep `filtrationPoints_mul_inv`). -/
theorem filtPoints_mul_inv [Algebra.FiniteType k H] [Algebra.Smooth k H] (n : ℕ)
    {g h : WithConv (H →ₐ[k] k)} (hg : g ∈ filtPoints π ψ n) (hh : h ∈ filtPoints π ψ n) :
    g⁻¹ * h ∈ filtPoints π ψ n := by
  classical
  exact filtrationPoints_mul_inv (π.cocharacter ψ) n hg hh

/-- **`T ⊆ P(λ)`**: the torus lies in the dynamic parabolic of its own cocharacter. -/
theorem parabolic_le_ker_torus [Algebra.FiniteType k H] [Algebra.Smooth k H] :
    (parabolicDefiningHopfIdeal (π.cocharacter ψ)).toIdeal ≤
      RingHom.ker (π : H →ₐ[k] MonoidAlgebra k X) := by
  classical
  let lT : MonoidAlgebra k X →ₐc[k] LaurentPolynomial k :=
    (AddMonoidAlgebra.toMultiplicativeBialgEquiv k k ℤ).symm.toBialgHom.comp
      (MonoidAlgebra.mapDomainBialgHom k ψ)
  have hl : lT.comp π = π.cocharacter ψ := rfl
  set e : WithConv (MonoidAlgebra k X →ₐ[k] MonoidAlgebra k X) := toConv (AlgHom.id k _)
  have hconst : constPoint (MonoidAlgebra k X) (BialgHom.mapDomain π e) =
      BialgHom.mapDomain π (constPoint (MonoidAlgebra k X) e) := by
    apply WithConv.ofConv_injective
    rw [BialgHom.mapDomain_apply, WithConv.ofConv_toConv]
    rfl
  have he : e ∈ levi (MonoidAlgebra k X) lT := by
    rw [levi_eq_top]; exact Subgroup.mem_top _
  have hlevi : BialgHom.mapDomain π e ∈ levi (MonoidAlgebra k X) (π.cocharacter ψ) := by
    rw [mem_levi_iff, conjugate_mapDomain (π.cocharacter ψ) π lT hl, mem_levi_iff.1 he, hconst]
  have hle := (TauCeti.Cocharacter.negativeCoefficientIdeal_le_ker_iff _ _).2
    (levi_le_parabolic hlevi)
  intro x hx
  rw [parabolicDefiningHopfIdeal, HopfIdeal.ofIdealOfPointsSubgroup_toIdeal] at hx
  have h := hle hx
  rw [RingHom.mem_ker, BialgHom.mapDomain_apply, WithConv.ofConv_toConv] at h
  exact h

/-! ### The torus on `P(λ) = Spec (H ⧸ I_P)` -/

/-- The torus `π̄ : k[P(λ)] → k[X]` (`T ⊆ P(λ)`). -/
noncomputable def piBarPar [DecidableEq H] [Algebra.FiniteType k H] [Algebra.Smooth k H] :
    (H ⧸ (parabolicDefiningHopfIdeal (π.cocharacter ψ)).toIdeal) →ₐc[k] MonoidAlgebra k X :=
  descBialgHom (parMk (π.cocharacter ψ)) Ideal.Quotient.mk_surjective π (by
    intro x hx
    have : x ∈ (parabolicDefiningHopfIdeal (π.cocharacter ψ)).toIdeal := by
      simpa [parMk, RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem] using hx
    exact parabolic_le_ker_torus π ψ this)

lemma piBarPar_comp [DecidableEq H] [Algebra.FiniteType k H] [Algebra.Smooth k H] :
    (piBarPar π ψ).comp (parMk (π.cocharacter ψ)) = π := descBialgHom_comp _ _ _ _

lemma piBarPar_apply [DecidableEq H] [Algebra.FiniteType k H] [Algebra.Smooth k H] (x : H) :
    piBarPar π ψ (parMk (π.cocharacter ψ) x) = π x :=
  congrArg (fun f : H →ₐc[k] MonoidAlgebra k X => f x) (piBarPar_comp π ψ)

lemma piBarPar_cocharacter [DecidableEq H] [Algebra.FiniteType k H] [Algebra.Smooth k H] :
    (piBarPar π ψ).cocharacter ψ = parCochar (π.cocharacter ψ) := by
  apply BialgHom.coe_toAlgHom_injective
  refine Ideal.Quotient.algHom_ext _ (AlgHom.ext fun x => ?_)
  have e1 := DFunLike.congr_fun (BialgHom.cocharacter_id_comp (piBarPar π ψ) ψ)
    (parMk (π.cocharacter ψ) x)
  have e0 := DFunLike.congr_fun (BialgHom.cocharacter_id_comp π ψ) x
  have e2 := DFunLike.congr_fun (parCochar_comp (π.cocharacter ψ)) x
  simp only [BialgHom.comp_apply] at e1 e0 e2
  change (piBarPar π ψ).cocharacter ψ (parMk (π.cocharacter ψ) x) =
    parCochar (π.cocharacter ψ) (parMk (π.cocharacter ψ) x)
  rw [← e1, e2, piBarPar_apply, e0]

lemma parMk_mem_torusGrading [DecidableEq H] [Algebra.FiniteType k H] [Algebra.Smooth k H] {χ : Additive X}
    {x : H} (hx : x ∈ torusGrading π χ) :
    parMk (π.cocharacter ψ) x ∈ torusGrading (piBarPar π ψ) χ := by
  set f := parMk (π.cocharacter ψ)
  rw [mem_torusGrading] at hx ⊢
  have hl : torusCoactLeft π x = MonoidAlgebra.single (Additive.toMul χ) 1 ⊗ₜ[k] x := by
    have := congrArg (TensorProduct.comm k _ _) hx
    simpa [torusCoact] using this
  have hnat := DFunLike.congr_fun
    (HopfAlgebra.tensorProduct_map_comp_conjugationAlgHom (R := k) f) x
  simp only [AlgHom.comp_apply] at hnat
  have hQ : torusCoactLeft (piBarPar π ψ) (f x) =
      MonoidAlgebra.single (Additive.toMul χ) 1 ⊗ₜ[k] f x := by
    have e : torusCoactLeft (piBarPar π ψ) (f x) =
        Algebra.TensorProduct.map (AlgHom.id k _) (f : H →ₐ[k] _) (torusCoactLeft π x) := by
      change Algebra.TensorProduct.map (piBarPar π ψ).toAlgHom (AlgHom.id k _)
          (HopfAlgebra.conjugationAlgHom (R := k) (f.toAlgHom x)) =
        Algebra.TensorProduct.map (AlgHom.id k _) f.toAlgHom
          (Algebra.TensorProduct.map π.toAlgHom (AlgHom.id k H)
            (HopfAlgebra.conjugationAlgHom (R := k) x))
      have hc : (Algebra.TensorProduct.map (piBarPar π ψ).toAlgHom (AlgHom.id k _)).comp
          (Algebra.TensorProduct.map f.toAlgHom f.toAlgHom) =
          (Algebra.TensorProduct.map (AlgHom.id k _) f.toAlgHom).comp
            (Algebra.TensorProduct.map π.toAlgHom (AlgHom.id k H)) := by
        rw [← Algebra.TensorProduct.map_comp, ← Algebra.TensorProduct.map_comp]
        congr 1
        · exact AlgHom.ext fun y => piBarPar_apply π ψ y
      rw [← hnat]
      exact DFunLike.congr_fun hc _
    rw [e, hl, Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
    rfl
  change (TensorProduct.comm k _ _) (torusCoactLeft (piBarPar π ψ) (f x)) = _
  rw [hQ]
  rfl

lemma torusGrading_piBar_le [DecidableEq H] [Algebra.FiniteType k H] [Algebra.Smooth k H]
    (μ : Additive X) :
    torusGrading (piBarPar π ψ) μ ≤ lineGrading (parCochar (π.cocharacter ψ)) (pairingHom ψ μ) := by
  rw [← piBarPar_cocharacter π ψ]
  exact torusGrading_le_lineGrading (π := piBarPar π ψ) (ψ := ψ) μ

/-- **(c-i) finitely many weights in degree `n` modulo `J_n`.** -/
theorem exists_weight_finset [Algebra.FiniteType k H] [Algebra.Smooth k H] {n : ℕ} (hn : 0 < n) :
    ∃ S : Finset (Additive X), (∀ χ ∈ S, pairingHom ψ χ = n) ∧
      ∀ χ, χ ∉ S → pairingHom ψ χ = n → ∀ y ∈ torusGrading π χ,
        y ∈ filtrationIdeal (π.cocharacter ψ) n := by
  classical
  haveI := smooth_parQuot (π.cocharacter ψ)
  have hχQ := torusGrading_piBar_le π ψ
  obtain ⟨r, x, d, μ, hx, hb⟩ := filtrationIdeal_polynomial_bigraded' (parCochar (π.cocharacter ψ))
    (parabolic_parCochar_eq_bot _) (piBarPar π ψ) (pairingHom ψ) hχQ n
  refine ⟨(Finset.univ.filter (fun i => d i = n)).image μ, ?_, ?_⟩
  · intro χ hχ
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.1 hχ
    rw [(hx i).2.2.1, (Finset.mem_filter.1 hi).2]
  · intro χ hχ hχn y hy
    have hyQ := parMk_mem_torusGrading π ψ hy
    have hyL : parMk (π.cocharacter ψ) y ∈ lineGrading (parCochar (π.cocharacter ψ)) (n : ℤ) := by
      have := hχQ χ hyQ; rwa [hχn] at this
    obtain ⟨c, hc⟩ := exists_sum_generators (l := parCochar (π.cocharacter ψ)) hn
      (fun i => ⟨(hx i).1, (hx i).2.2.2.2⟩) hb hyL
    have hJ := filtrationIdeal_isHomogeneous_torus (parCochar (π.cocharacter ψ)) (piBarPar π ψ)
      (pairingHom ψ) hχQ n χ hc
    have hz : ∀ i : {i : Fin r // d i = n},
        (DirectSum.decompose (torusGrading (piBarPar π ψ)) (c i • x i.1) χ :
          H ⧸ (parabolicDefiningHopfIdeal (π.cocharacter ψ)).toIdeal) = 0 := by
      intro i
      have hne : μ i.1 ≠ χ := by
        intro h
        exact hχ (Finset.mem_image.2 ⟨i.1, Finset.mem_filter.2 ⟨Finset.mem_univ _, i.2⟩, h⟩)
      exact DirectSum.decompose_of_mem_ne _ (Submodule.smul_mem _ _ (hx i.1).2.2.2.1) hne
    rw [DirectSum.decompose_sub, DirectSum.sub_apply, Submodule.coe_sub,
      DirectSum.decompose_of_mem_same _ hyQ, DirectSum.decompose_sum, DFinsupp.finset_sum_apply,
      Submodule.coe_sum, Finset.sum_eq_zero (fun i _ => hz i), sub_zero] at hJ
    rw [← filtrationIdeal_comap_parabolicQuotient (π.cocharacter ψ) n]
    exact hJ

/-! ### (b): ray pieces realize admissible functionals (via the attractor `G^{[α⟩}`) -/

lemma rayMagnet_le_nat (α : PosRay ψ) : rayMagnet α.1 ≤ natMagnet.comap (pairingHom ψ) := by
  intro x hx
  obtain ⟨m, rfl⟩ := AddSubmonoid.mem_closure_singleton.1 hx
  show pairingHom ψ (m • α.1) ∈ natMagnet
  rw [map_nsmul, mem_natMagnet]
  exact nsmul_nonneg α.2.le m

/-- `G^{[α⟩}` as a Hopf ideal. -/
abbrev rayI (α : PosRay ψ) : HopfIdeal k H := magnetHopfIdeal π (rayMagnet α.1)

lemma rayI_toIdeal (α : PosRay ψ) :
    (rayI π ψ α).toIdeal = magnetIdeal (torusGrading π) (rayMagnet α.1) :=
  magnetHopfIdeal_toIdeal π _

lemma parabolic_le_rayI (α : PosRay ψ) :
    (parabolicDefiningHopfIdeal (π.cocharacter ψ)).toIdeal ≤ (rayI π ψ α).toIdeal := by
  rw [rayI_toIdeal, ← magnetIdeal_torusGrading_comap_nat]
  exact magnetIdeal_anti _ (rayMagnet_le_nat ψ α)

lemma rayI_le_ker (α : PosRay ψ) :
    (rayI π ψ α).toIdeal ≤ RingHom.ker (π.cocharacter ψ : H →ₐ[k] LaurentPolynomial k) := by
  rw [rayI_toIdeal]
  refine (magnetIdeal_le_ker_torus π _).trans fun x hx => ?_
  rw [RingHom.mem_ker] at hx ⊢
  change (AddMonoidAlgebra.toMultiplicativeBialgEquiv k k ℤ).symm
    (MonoidAlgebra.mapDomainBialgHom k ψ (π x)) = 0
  have hx' : π x = 0 := hx
  rw [hx', map_zero, map_zero]

/-- **Degree analysis.** For `χ ∈ [α⟩` of `λ`-degree `n`, a product `a·b` of weight vectors with
`β ∉ [α⟩` and weights adding to `χ` lies in `J_n`. -/
lemma mul_mem_filtration_of_weights {n : ℕ} (hn : 0 < n) {α : PosRay ψ} {χ : Additive X}
    (hχ : χ ∈ rayMagnet α.1) {β γ : Additive X} (hβ : β ∉ rayMagnet α.1)
    (hγβ : γ + β = χ) (hχn : pairingHom ψ χ = n) {a b : H} (ha : a ∈ torusGrading π γ)
    (hb : b ∈ torusGrading π β) : a * b ∈ filtrationIdeal (π.cocharacter ψ) n := by
  classical
  set l := π.cocharacter ψ
  have hdeg : pairingHom ψ γ + pairingHom ψ β = n := by rw [← map_add, hγβ, hχn]
  have lin : ∀ {μ : Additive X} {y : H}, y ∈ torusGrading π μ → y ∈ lineGrading l (pairingHom ψ μ) :=
    fun hy => torusGrading_le_lineGrading (π := π) (ψ := ψ) _ hy
  have unipF := unip_le_filtrationIdeal l n
  have zero_deg : ∀ {μ : Additive X} {y : H}, μ ≠ 0 → y ∈ torusGrading π μ →
      pairingHom ψ μ = 0 → y ∈ filtrationIdeal l n := by
    intro μ y hμ hy h0
    have hyL := lin hy
    rw [h0] at hyL
    have := sub_counit_mem_unip l hyL
    rw [counit_eq_zero_of_mem_torusGrading π hμ hy, map_zero, sub_zero] at this
    exact unipF this
  have neg_deg : ∀ {μ : Additive X} {y : H}, y ∈ torusGrading π μ → pairingHom ψ μ < 0 →
      y ∈ filtrationIdeal l n := fun hy h => unipF (neg_mem_unip l h (lin hy))
  have hβ0 : β ≠ 0 := fun h => hβ (h ▸ zero_mem _)
  rcases lt_trichotomy (pairingHom ψ β) 0 with h | h | h
  · exact Ideal.mul_mem_left _ a (neg_deg hb h)
  · exact Ideal.mul_mem_left _ a (zero_deg hβ0 hb h)
  · rcases lt_trichotomy (pairingHom ψ β) n with h' | h' | h'
    · obtain ⟨m, hm⟩ : ∃ m : ℕ, pairingHom ψ β = m := ⟨(pairingHom ψ β).toNat,
        (Int.toNat_of_nonneg h.le).symm⟩
      have hbL := lin hb
      rw [hm] at hbL
      exact Ideal.mul_mem_left _ a (mem_filtrationIdeal_of_lt l (by omega) (by omega) hbL)
    · have hγ0 : γ ≠ 0 := by
        rintro rfl; rw [zero_add] at hγβ; exact hβ (hγβ ▸ hχ)
      exact Ideal.mul_mem_right _ _ (zero_deg hγ0 ha (by omega))
    · exact Ideal.mul_mem_right _ _ (neg_deg ha (by omega))

/-- **`(I_{[α⟩})_χ ⊆ J_n`** for `χ ∈ [α⟩` of degree `n`. -/
lemma decompose_rayI_mem {n : ℕ} (hn : 0 < n) {α : PosRay ψ} {χ : Additive X}
    (hχ : χ ∈ rayMagnet α.1) (hχn : pairingHom ψ χ = n) {y : H}
    (hy : y ∈ magnetIdeal (torusGrading π) (rayMagnet α.1)) :
    (DirectSum.decompose (torusGrading π) y χ : H) ∈ filtrationIdeal (π.cocharacter ψ) n := by
  classical
  rw [magnetIdeal] at hy
  obtain ⟨m, c, g, rfl⟩ := Submodule.mem_span_set'.1 hy
  rw [DirectSum.decompose_sum, DFinsupp.finset_sum_apply, Submodule.coe_sum]
  refine Ideal.sum_mem _ fun i _ => ?_
  obtain ⟨β, hβ, hgβ⟩ := Set.mem_iUnion₂.1 (g i).2
  have e : χ = (χ - β) + β := (sub_add_cancel χ β).symm
  rw [smul_eq_mul, e, DirectSum.coe_decompose_mul_add_of_right_mem _ hgβ]
  exact mul_mem_filtration_of_weights π ψ hn hχ hβ (sub_add_cancel χ β) hχn
    (SetLike.coe_mem _) hgβ

/-- **(b) per-ray surjectivity.** A functional on degree-`n` coordinates killing
`J_n ⊔ I_{[α⟩}` is the restriction of a point of `U_(α) ∩ U_{≥n}`. Proof: TorusConjDyn
`unipotentFiltrationPoints_surjective` on `G^{[α⟩}` (ParabolicGenTransport `qLift_surjective`). -/
theorem exists_rayPoint_restrict [Algebra.FiniteType k H] [Algebra.Smooth k H]
    {n : ℕ} (hn : 0 < n) (α : PosRay ψ)
    (f : lineGrading (π.cocharacter ψ) (n : ℤ) →ₗ[k] k)
    (hf : ∀ w : lineGrading (π.cocharacter ψ) (n : ℤ), (w : H) ∈ filtrationIdeal
      (π.cocharacter ψ) n ⊔ magnetIdeal (torusGrading π) (rayMagnet α.1) → f w = 0) :
    ∃ r ∈ rayPoints π ψ α, r ∈ filtPoints π ψ n ∧
      ∀ (w : H) (hw : w ∈ lineGrading (π.cocharacter ψ) (n : ℤ)), r.ofConv w = f ⟨w, hw⟩ := by
  classical
  haveI : Algebra.Smooth k (H ⧸ (rayI π ψ α).toIdeal) :=
    smooth_quotient_magnetHopfIdeal π (rayMagnet α.1)
  obtain ⟨u, hu, huv⟩ := qLift_surjective (π.cocharacter ψ) (rayI_le_ker π ψ α)
    (parabolic_le_rayI π ψ α) hn f (by rw [rayI_toIdeal]; exact hf)
  rw [rayI_toIdeal] at hu
  refine ⟨u, ?_, fun x hx => hu (Ideal.mem_sup_left hx), fun w hw => huv ⟨w, hw⟩⟩
  show (rootGroupIdeal π α.1 (PosRay.torsionFree ψ α)).toIdeal ≤ RingHom.ker u.ofConv
  rw [rootGroupIdeal, prescribedUnitHopfIdeal_toIdeal, prescribedUnitIdeal]
  refine sup_le (fun x hx => hu (Ideal.mem_sup_right hx)) (Ideal.span_le.2 ?_)
  rintro _ ⟨x, hx, rfl⟩
  have hxL : x ∈ lineGrading (π.cocharacter ψ) 0 := by
    have := torusGrading_le_lineGrading (π := π) (ψ := ψ) 0 hx
    simpa using this
  exact hu (Ideal.mem_sup_left (unip_le_filtrationIdeal _ n (sub_counit_mem_unip _ hxL)))

/-- **(c) ray decomposition.** The degree-`n` restriction of `g ∈ U_{≥n}(k)` is a finite sum of
ray-supported functionals (weight decomposition `H_n = ⊕ H_χ`, finitely many weights modulo
`J_n`; each weight `χ` lies on the ray of `χ` itself). -/
theorem exists_ray_decomposition [IsAlgClosed k] [Algebra.FiniteType k H] [Algebra.Smooth k H]
    {n : ℕ} (hn : 0 < n) {g : WithConv (H →ₐ[k] k)} (hg : g ∈ filtPoints π ψ n) :
    ∃ (s : Finset (PosRay ψ)) (f : PosRay ψ → (lineGrading (π.cocharacter ψ) (n : ℤ) →ₗ[k] k)),
      (∀ α ∈ s, ∀ w : lineGrading (π.cocharacter ψ) (n : ℤ), (w : H) ∈ filtrationIdeal
        (π.cocharacter ψ) n ⊔ magnetIdeal (torusGrading π) (rayMagnet α.1) → f α w = 0) ∧
      ∀ (w : H) (hw : w ∈ lineGrading (π.cocharacter ψ) (n : ℤ)),
        g.ofConv w = ∑ α ∈ s, f α ⟨w, hw⟩ := by
  classical
  obtain ⟨S, hS, hW⟩ := exists_weight_finset π ψ hn
  have hχL : ∀ μ, torusGrading π μ ≤ lineGrading (π.cocharacter ψ) (pairingHom ψ μ) :=
    fun μ => torusGrading_le_lineGrading (π := π) (ψ := ψ) μ
  let s : Finset (PosRay ψ) := S.subtype (fun χ => 0 < pairingHom ψ χ)
  let f : PosRay ψ → (lineGrading (π.cocharacter ψ) (n : ℤ) →ₗ[k] k) := fun α =>
    (g.ofConv.toLinearMap ∘ₗ GradedAlgebra.proj (torusGrading π) α.1) ∘ₗ
      (lineGrading (π.cocharacter ψ) (n : ℤ)).subtype
  refine ⟨s, f, ?_, ?_⟩
  · intro α hα w hw
    have hαS : α.1 ∈ S := (Finset.mem_subtype.1 hα)
    have hαn := hS α.1 hαS
    show g.ofConv (GradedAlgebra.proj (torusGrading π) α.1 (w : H)) = 0
    rw [GradedAlgebra.proj_apply]
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.1 hw
    rw [← hab, DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add]
    have h1 := filtrationIdeal_isHomogeneous_torus (π.cocharacter ψ) π (pairingHom ψ) hχL n α.1 ha
    have h2 := decompose_rayI_mem π ψ hn (AddSubmonoid.subset_closure rfl) hαn hb
    exact hg (Ideal.add_mem _ h1 h2)
  · intro w hw
    have hsum_s : ∑ α ∈ s, f α ⟨w, hw⟩ =
        ∑ χ ∈ S, g.ofConv (DirectSum.decompose (torusGrading π) w χ : H) := by
      change ∑ α ∈ S.subtype (fun χ => 0 < pairingHom ψ χ),
          g.ofConv (GradedAlgebra.proj (torusGrading π) α.1 w) = _
      rw [Finset.sum_subtype_eq_sum_filter (f := fun χ =>
          g.ofConv (GradedAlgebra.proj (torusGrading π) χ w)), Finset.filter_true_of_mem]
      · rfl
      · intro χ hχ; rw [hS χ hχ]; exact_mod_cast hn
    rw [hsum_s]
    conv_lhs => rw [← DirectSum.sum_support_decompose (torusGrading π) w]
    rw [map_sum]
    have hzero : ∀ χ, (DirectSum.decompose (torusGrading π) w χ : H) ≠ 0 → χ ∉ S →
        g.ofConv (DirectSum.decompose (torusGrading π) w χ : H) = 0 := by
      intro χ hne hχS
      by_cases hχn : pairingHom ψ χ = n
      · exact hg (hW χ hχS hχn _ (SetLike.coe_mem _))
      · exact absurd (decompose_refine_eq_zero (lineGrading (π.cocharacter ψ))
          (torusGrading π) (pairingHom ψ) hχL hw hχn) hne
    set F : Additive X → k := fun χ => g.ofConv (DirectSum.decompose (torusGrading π) w χ : H)
    have hf1 : ∀ χ ∈ (DirectSum.decompose (torusGrading π) w).support ∪ S,
        χ ∉ (DirectSum.decompose (torusGrading π) w).support → F χ = 0 := by
      intro χ _ hχ
      have : (DirectSum.decompose (torusGrading π) w χ : H) = 0 := by
        rw [DFinsupp.notMem_support_iff.1 hχ]; rfl
      simp only [F, this, map_zero]
    have hf2 : ∀ χ ∈ (DirectSum.decompose (torusGrading π) w).support ∪ S, χ ∉ S → F χ = 0 := by
      intro χ _ hχ
      by_cases h0 : (DirectSum.decompose (torusGrading π) w χ : H) = 0
      · simp only [F, h0, map_zero]
      · exact hzero χ h0 hχ
    change ∑ χ ∈ (DirectSum.decompose (torusGrading π) w).support, F χ = ∑ χ ∈ S, F χ
    rw [Finset.sum_subset Finset.subset_union_left hf1,
      Finset.sum_subset Finset.subset_union_right hf2]

lemma one_mem_filtPoints (n : ℕ) : (1 : WithConv (H →ₐ[k] k)) ∈ filtPoints π ψ n := by
  classical
  intro x hx
  rw [RingHom.mem_ker]
  change algebraMap k k (Coalgebra.counit (R := k) x) = 0
  rw [counit_eq_zero_of_mem_filtrationIdeal (π.cocharacter ψ) hx, map_zero]

lemma mul_mem_filtPoints [Algebra.FiniteType k H] [Algebra.Smooth k H] (n : ℕ)
    {g h : WithConv (H →ₐ[k] k)} (hg : g ∈ filtPoints π ψ n) (hh : h ∈ filtPoints π ψ n) :
    g * h ∈ filtPoints π ψ n := by
  have hi : g⁻¹ ∈ filtPoints π ψ n := by
    simpa using filtPoints_mul_inv π ψ n hg (one_mem_filtPoints π ψ n)
  simpa using filtPoints_mul_inv π ψ n hi hh

/-- **(P1-vec) + (b) + (c)**, PROVED from `exists_rayPoint_restrict` and
`exists_ray_decomposition`, with `V = ` functions on `λ`-degree-`n` coordinates. -/
theorem exists_vecQuotient_raySurj [IsAlgClosed k] [Algebra.FiniteType k H] [Algebra.Smooth k H]
    {n : ℕ} (hn : 0 < n) :
    ∃ (V : Type u) (_ : AddCommGroup V) (q : WithConv (H →ₐ[k] k) → V),
      (∀ u ∈ filtPoints π ψ n, ∀ u' ∈ filtPoints π ψ n, q (u * u') = q u + q u') ∧
      (∀ u ∈ filtPoints π ψ n, q u = 0 → u ∈ filtPoints π ψ (n + 1)) ∧
      (∀ g ∈ filtPoints π ψ n, ∃ r ∈ Subgroup.closure (⋃ α : PosRay ψ, rayPoints π ψ α),
        r ∈ filtPoints π ψ n ∧ q r = q g) := by
  classical
  refine ⟨lineGrading (π.cocharacter ψ) (n : ℤ) → k, inferInstance,
    fun u w => u.ofConv (w : H), ?_, ?_, ?_⟩
  · intro u hu u' hu'
    funext w
    exact filtrationPoints_map_mul (π.cocharacter ψ) hn hu hu' w.2
  · intro u hu h0
    exact (unipotentFiltrationPoints_ker (π.cocharacter ψ) hn hu).2 fun w hw =>
      congrFun h0 ⟨w, hw⟩
  · intro g hg
    obtain ⟨s, f, hfs, hsum⟩ := exists_ray_decomposition π ψ hn hg
    have claim : ∀ t ⊆ s, ∃ r ∈ Subgroup.closure (⋃ α : PosRay ψ, rayPoints π ψ α),
        r ∈ filtPoints π ψ n ∧ ∀ (w : H) (hw : w ∈ lineGrading (π.cocharacter ψ) (n : ℤ)),
          r.ofConv w = ∑ α ∈ t, f α ⟨w, hw⟩ := by
      intro t
      induction t using Finset.induction_on with
      | empty =>
        intro _
        refine ⟨1, Subgroup.one_mem _, one_mem_filtPoints π ψ n, fun w hw => ?_⟩
        rw [Finset.sum_empty]
        change algebraMap k k (Coalgebra.counit (R := k) w) = 0
        rw [counit_eq_zero_of_mem_lineGrading (π.cocharacter ψ) (by exact_mod_cast hn.ne') hw,
          map_zero]
      | insert α t hα ih =>
        intro hts
        obtain ⟨r, hr, hrn, hrv⟩ := ih (fun x hx => hts (Finset.mem_insert_of_mem hx))
        obtain ⟨r', hr', hr'n, hr'v⟩ := exists_rayPoint_restrict π ψ hn α (f α)
          (hfs α (hts (Finset.mem_insert_self α t)))
        refine ⟨r' * r, Subgroup.mul_mem _ (Subgroup.subset_closure
          (Set.mem_iUnion.2 ⟨α, hr'⟩)) hr, mul_mem_filtPoints π ψ n hr'n hrn, fun w hw => ?_⟩
        rw [filtrationPoints_map_mul (π.cocharacter ψ) hn hr'n hrn hw, hr'v w hw, hrv w hw,
          Finset.sum_insert hα]
    obtain ⟨r, hr, hrn, hrv⟩ := claim s subset_rfl
    refine ⟨r, hr, hrn, funext fun w => ?_⟩
    show r.ofConv (w : H) = g.ofConv (w : H)
    rw [hrv w w.2, hsum w w.2]

/-- **(P1 + P2, step of the induction)**, PROVED from (P1-grp) and (P1-vec)+(b)+(c). -/
theorem exists_rayProduct_mul_mem_filtPoints [IsAlgClosed k] [Algebra.FiniteType k H]
    [Algebra.Smooth k H] {n : ℕ} (hn : 0 < n) {g : WithConv (H →ₐ[k] k)}
    (hg : g ∈ filtPoints π ψ n) :
    ∃ r ∈ Subgroup.closure (⋃ α : PosRay ψ, rayPoints π ψ α), r⁻¹ * g ∈ filtPoints π ψ (n + 1) := by
  obtain ⟨V, _, q, hadd, hker, hsurj⟩ := exists_vecQuotient_raySurj π ψ hn
  obtain ⟨r, hr, hrn, hq⟩ := hsurj g hg
  refine ⟨r, hr, hker _ (filtPoints_mul_inv π ψ n hrn hg) ?_⟩
  have h1 : r * (r⁻¹ * g) = g := by group
  have h2 := hadd r hrn _ (filtPoints_mul_inv π ψ n hrn hg)
  rw [h1, hq] at h2
  have h3 : q (r⁻¹ * g) = (q g + q (r⁻¹ * g)) - q g := by abel
  rw [h3, ← h2, sub_self]

/-- **(P3)** `U_{≥N}(k) = 1` for `N` large, from TorusConjDyn `unipotentFiltrationPoints_eventually`. -/
theorem filtPoints_eventually [Algebra.FiniteType k H] [Algebra.Smooth k H] :
    ∃ N, ∀ g ∈ filtPoints π ψ N, g = 1 := by
  classical
  obtain ⟨N, hN⟩ := unipotentFiltrationPoints_eventually (π.cocharacter ψ)
  exact ⟨N, fun g hg => hN N le_rfl k g hg⟩

/-- **(Gen), points form.** `U(λ)(k)` lies in the subgroup generated by the `k`-points of the ray pieces `U_(α)`, `⟨α, λ⟩ > 0`. -/
theorem unipotent_le_closure_rayPoints [IsAlgClosed k] [Algebra.FiniteType k H]
    [Algebra.Smooth k H] :
    unipotent k (π.cocharacter ψ) ≤ Subgroup.closure (⋃ α : PosRay ψ, rayPoints π ψ α) := by
  obtain ⟨N, hN⟩ := filtPoints_eventually π ψ
  have key : ∀ d n, 0 < n → N - n = d → ∀ g ∈ filtPoints π ψ n,
      g ∈ Subgroup.closure (⋃ α : PosRay ψ, rayPoints π ψ α) := by
    intro d
    induction d with
    | zero =>
      intro n _ hd g hg
      rw [hN g (filtPoints_antitone π ψ (by omega) hg)]
      exact Subgroup.one_mem _
    | succ d ih =>
      intro n hn hd g hg
      obtain ⟨r, hr, hrg⟩ := exists_rayProduct_mul_mem_filtPoints π ψ hn hg
      have := ih (n + 1) (by omega) (by omega) _ hrg
      simpa using Subgroup.mul_mem _ hr this
  intro g hg
  exact key _ 1 one_pos rfl g (unipotent_subset_filtPoints_one π ψ hg)

end AlgMag.Reductive
