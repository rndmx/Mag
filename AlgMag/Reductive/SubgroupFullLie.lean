import AlgMag.Reductive.OpenCell.HopfKaehler
import Mathlib.RingTheory.Smooth.Basic
import Mathlib.RingTheory.Ideal.IdempotentFG
import Mathlib.RingTheory.FiniteType
import Mathlib.RingTheory.Spectrum.Prime.Topology
import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Quotient.Basic

/-!
# A smooth closed subgroup with the full Lie algebra of a smooth connected group is everything

Let `P` be a smooth, finite-type commutative Hopf algebra over a field `k` with connected spectrum,
and `K` a Hopf ideal with `P ⧸ K` smooth and `dim Lie(P ⧸ K) = dim Lie(P)`. Then `K = 0`.

Proof: the conormal sequence `K/K² → (P ⧸ K) ⊗ Ω[P] → Ω[P ⧸ K] → 0` is exact and, `P ⧸ K` being
smooth, split injective on the left (Mathlib `Algebra.FormallySmooth.iff_split_injection`). Both
Kähler modules are free of rank `dim Lie` (invariant differentials,
`AlgMag.OpenCellNotes.kaehlerEquivInv`), so the right map is a surjection between free modules of
the same finite rank, hence injective (Orzech). So `K/K² = 0`, `K` is generated by an idempotent,
which is `0` by connectedness and `ε(K) = 0`.
-/

suppress_compilation

open TensorProduct

namespace AlgMag.Reductive

universe u

/-- A surjective linear map between finite free modules of the same rank over a nontrivial
commutative ring is injective. -/
lemma injective_of_surjective_of_finrank_eq {B M N : Type u} [CommRing B] [Nontrivial B]
    [AddCommGroup M] [Module B M] [AddCommGroup N] [Module B N]
    [Module.Free B M] [Module.Finite B M] [Module.Free B N] [Module.Finite B N]
    (f : M →ₗ[B] N) (hf : Function.Surjective f) (h : Module.finrank B M = Module.finrank B N) :
    Function.Injective f := by
  have hcard : Fintype.card (Module.Free.ChooseBasisIndex B M) =
      Fintype.card (Module.Free.ChooseBasisIndex B N) := by
    rw [← Module.finrank_eq_card_chooseBasisIndex, ← Module.finrank_eq_card_chooseBasisIndex, h]
  let e : N ≃ₗ[B] M := (Module.Free.chooseBasis B N).equiv (Module.Free.chooseBasis B M)
    (Fintype.equivOfCardEq hcard.symm)
  have hinj := OrzechProperty.injective_of_surjective_endomorphism ((e : N →ₗ[B] M) ∘ₗ f)
    (e.surjective.comp hf)
  exact fun x y hxy => hinj (by simp [hxy])

variable (k : Type u) [Field k] (P : Type u) [CommRing P] [HopfAlgebra k P]
  [Algebra.FiniteType k P]

/-- **A smooth closed subgroup with full Lie algebra in a smooth connected group is the whole
group.** -/
theorem toIdeal_eq_bot_of_finrank_cotangent_eq [Algebra.Smooth k P]
    [ConnectedSpace (PrimeSpectrum P)]
    [Module.Finite k (TauCeti.Bialgebra.CotangentSpace k P)]
    (K : TauCeti.HopfIdeal k P) [Algebra.Smooth k (P ⧸ K.toIdeal)]
    [Module.Finite k (TauCeti.Bialgebra.CotangentSpace k (P ⧸ K.toIdeal))]
    (hdim : Module.finrank k (TauCeti.Bialgebra.CotangentSpace k (P ⧸ K.toIdeal)) =
      Module.finrank k (TauCeti.Bialgebra.CotangentSpace k P)) :
    K.toIdeal = ⊥ := by
  have hf : Function.Surjective (algebraMap P (P ⧸ K.toIdeal)) := Ideal.Quotient.mk_surjective
  have hntB : Nontrivial (P ⧸ K.toIdeal) := by
    refine ⟨⟨0, 1, fun h => ?_⟩⟩
    have := congrArg (Coalgebra.counit (R := k) (A := P ⧸ K.toIdeal)) h
    rw [map_zero, Bialgebra.counit_one] at this
    exact zero_ne_one this
  have hntP : Nontrivial P := by
    refine ⟨⟨0, 1, fun h => ?_⟩⟩
    have := congrArg (Coalgebra.counit (R := k) (A := P)) h
    rw [map_zero, Bialgebra.counit_one] at this
    exact zero_ne_one this
  -- the conormal map is injective
  obtain ⟨l, hl⟩ := (Algebra.FormallySmooth.iff_split_injection (R := k) (P := P)
    (A := P ⧸ K.toIdeal) hf).1 inferInstance
  have hinj : Function.Injective (KaehlerDifferential.kerCotangentToTensor k P (P ⧸ K.toIdeal)) :=
    fun x y h => by
      have := congrArg l h
      rwa [← LinearMap.comp_apply, hl, ← LinearMap.comp_apply, hl] at this
  -- the base change map of Kähler differentials is injective
  have hrankP : Module.finrank (P ⧸ K.toIdeal) ((P ⧸ K.toIdeal) ⊗[P] Ω[P⁄k]) =
      Module.finrank k (TauCeti.Bialgebra.CotangentSpace k P) := by
    rw [Module.finrank_baseChange, AlgMag.OpenCellNotes.finrank_kaehler]
  have hrankB : Module.finrank (P ⧸ K.toIdeal) Ω[(P ⧸ K.toIdeal)⁄k] =
      Module.finrank k (TauCeti.Bialgebra.CotangentSpace k (P ⧸ K.toIdeal)) :=
    AlgMag.OpenCellNotes.finrank_kaehler k (P ⧸ K.toIdeal)
  have hmb : Function.Injective (KaehlerDifferential.mapBaseChange k P (P ⧸ K.toIdeal)) :=
    injective_of_surjective_of_finrank_eq _ (KaehlerDifferential.mapBaseChange_surjective k P _ hf)
      (by rw [hrankP, hrankB, hdim])
  -- hence `K/K² = 0`
  have hzero : ∀ x, KaehlerDifferential.kerCotangentToTensor k P (P ⧸ K.toIdeal) x = 0 := by
    intro x
    apply hmb
    rw [map_zero]
    exact (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange k P _ hf).apply_apply_eq_zero x
  have hsub : Subsingleton (RingHom.ker (algebraMap P (P ⧸ K.toIdeal))).Cotangent :=
    ⟨fun x y => hinj (by rw [hzero x, hzero y])⟩
  have hidem := (Ideal.cotangent_subsingleton_iff _).1 hsub
  have hker : RingHom.ker (algebraMap P (P ⧸ K.toIdeal)) = K.toIdeal := Ideal.mk_ker
  rw [hker] at hidem
  have : IsNoetherianRing P := Algebra.FiniteType.isNoetherianRing k P
  have hfg : K.toIdeal.FG := IsNoetherian.noetherian K.toIdeal
  · obtain ⟨e, he, hKe⟩ := (Ideal.isIdempotentElem_iff_of_fg _ hfg).1 hidem
    -- `e = 0`
    have heK : e ∈ K.toIdeal := hKe ▸ Submodule.mem_span_singleton_self e
    have hε : Coalgebra.counit (R := k) e = 0 := K.counit_eq_zero heK
    have hclo := PrimeSpectrum.isClopen_basicOpen_of_mul_add e (1 - e)
      (by rw [mul_sub, mul_one, he.eq, sub_self]) (by ring)
    rcases isClopen_iff.1 hclo with h | h
    · have hnil : IsNilpotent e := (PrimeSpectrum.basicOpen_eq_bot_iff e).1
        (TopologicalSpace.Opens.ext h)
      have he0 : e = 0 := he.eq_zero_of_isNilpotent hnil
      rw [hKe, he0]
      simp
    · exfalso
      have hclo' := PrimeSpectrum.isClopen_basicOpen_of_mul_add (1 - e) e
        (by rw [sub_mul, one_mul, he.eq, sub_self]) (by ring)
      have hdisj : (PrimeSpectrum.basicOpen (1 - e) : Set (PrimeSpectrum P)) = ∅ := by
        ext p
        simp only [Set.mem_empty_iff_false, iff_false]
        intro hp
        have hpe : p ∈ (PrimeSpectrum.basicOpen e : Set (PrimeSpectrum P)) := h ▸ Set.mem_univ p
        have h1 : (1 - e) * e ∉ p.asIdeal := p.isPrime.mul_notMem hp hpe
        rw [sub_mul, one_mul, he.eq, sub_self] at h1
        exact h1 (zero_mem _)
      have hnil : IsNilpotent (1 - e) := (PrimeSpectrum.basicOpen_eq_bot_iff _).1
        (TopologicalSpace.Opens.ext hdisj)
      have : 1 - e = 0 := (he.one_sub).eq_zero_of_isNilpotent hnil
      have he1 : e = 1 := (sub_eq_zero.1 this).symm
      rw [he1, Bialgebra.counit_one] at hε
      exact one_ne_zero hε

section Relative

variable {k} {H : Type u} [CommRing H] [HopfAlgebra k H] [Algebra.FiniteType k H]

/-- **Relative form.** For Hopf ideals `I ≤ J` (so `V(J) ⊆ V(I)`) with `H ⧸ I` smooth with
connected spectrum, `H ⧸ J` smooth, and `dim Lie V(J) = dim Lie V(I)`, we have `I = J`. -/
theorem eq_of_le_of_finrank_cotangent_eq {I J : TauCeti.HopfIdeal k H}
    (hIJ : I ≤ J) [Algebra.Smooth k (H ⧸ I.toIdeal)] [ConnectedSpace (PrimeSpectrum (H ⧸ I.toIdeal))]
    [Module.Finite k (TauCeti.Bialgebra.CotangentSpace k (H ⧸ I.toIdeal))]
    [Algebra.Smooth k (H ⧸ J.toIdeal)]
    [Module.Finite k (TauCeti.Bialgebra.CotangentSpace k (H ⧸ J.toIdeal))]
    (hdim : Module.finrank k (TauCeti.Bialgebra.CotangentSpace k (H ⧸ J.toIdeal)) =
      Module.finrank k (TauCeti.Bialgebra.CotangentSpace k (H ⧸ I.toIdeal))) :
    I = J := by
  have hle : I.toIdeal ≤ J.toIdeal := TauCeti.HopfIdeal.toIdeal_le_toIdeal.2 hIJ
  let φ : (H ⧸ I.toIdeal) →ₐ[k] (H ⧸ J.toIdeal) := Ideal.Quotient.factorₐ k hle
  let : Algebra (H ⧸ I.toIdeal) (H ⧸ J.toIdeal) := φ.toRingHom.toAlgebra
  have : IsScalarTower k (H ⧸ I.toIdeal) (H ⧸ J.toIdeal) :=
    IsScalarTower.of_algebraMap_eq fun c => (φ.commutes c).symm
  have hf : Function.Surjective (algebraMap (H ⧸ I.toIdeal) (H ⧸ J.toIdeal)) :=
    Ideal.Quotient.factor_surjective hle
  have hntB : Nontrivial (H ⧸ J.toIdeal) := by
    refine ⟨⟨0, 1, fun h => ?_⟩⟩
    have := congrArg (Coalgebra.counit (R := k) (A := H ⧸ J.toIdeal)) h
    rw [map_zero, Bialgebra.counit_one] at this
    exact zero_ne_one this
  have hntP : Nontrivial (H ⧸ I.toIdeal) := by
    refine ⟨⟨0, 1, fun h => ?_⟩⟩
    have := congrArg (Coalgebra.counit (R := k) (A := H ⧸ I.toIdeal)) h
    rw [map_zero, Bialgebra.counit_one] at this
    exact zero_ne_one this
  obtain ⟨l, hl⟩ := (Algebra.FormallySmooth.iff_split_injection (R := k) (P := H ⧸ I.toIdeal)
    (A := H ⧸ J.toIdeal) hf).1 inferInstance
  have hinj : Function.Injective
      (KaehlerDifferential.kerCotangentToTensor k (H ⧸ I.toIdeal) (H ⧸ J.toIdeal)) :=
    fun x y h => by
      have := congrArg l h
      rwa [← LinearMap.comp_apply, hl, ← LinearMap.comp_apply, hl] at this
  have hrankP : Module.finrank (H ⧸ J.toIdeal) ((H ⧸ J.toIdeal) ⊗[H ⧸ I.toIdeal] Ω[(H ⧸ I.toIdeal)⁄k]) =
      Module.finrank k (TauCeti.Bialgebra.CotangentSpace k (H ⧸ I.toIdeal)) := by
    rw [Module.finrank_baseChange, AlgMag.OpenCellNotes.finrank_kaehler]
  have hrankB : Module.finrank (H ⧸ J.toIdeal) Ω[(H ⧸ J.toIdeal)⁄k] =
      Module.finrank k (TauCeti.Bialgebra.CotangentSpace k (H ⧸ J.toIdeal)) :=
    AlgMag.OpenCellNotes.finrank_kaehler k (H ⧸ J.toIdeal)
  have hmb : Function.Injective
      (KaehlerDifferential.mapBaseChange k (H ⧸ I.toIdeal) (H ⧸ J.toIdeal)) :=
    injective_of_surjective_of_finrank_eq _ (KaehlerDifferential.mapBaseChange_surjective k _ _ hf)
      (by rw [hrankP, hrankB, hdim])
  have hzero : ∀ x,
      KaehlerDifferential.kerCotangentToTensor k (H ⧸ I.toIdeal) (H ⧸ J.toIdeal) x = 0 := by
    intro x
    apply hmb
    rw [map_zero]
    exact (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange k _ _ hf).apply_apply_eq_zero x
  have hsub : Subsingleton
      (RingHom.ker (algebraMap (H ⧸ I.toIdeal) (H ⧸ J.toIdeal))).Cotangent :=
    ⟨fun x y => hinj (by rw [hzero x, hzero y])⟩
  have hidem := (Ideal.cotangent_subsingleton_iff _).1 hsub
  have : IsNoetherianRing (H ⧸ I.toIdeal) := Algebra.FiniteType.isNoetherianRing k _
  obtain ⟨e, he, hKe⟩ := (Ideal.isIdempotentElem_iff_of_fg _
    (IsNoetherian.noetherian _)).1 hidem
  have heK : e ∈ RingHom.ker (algebraMap (H ⧸ I.toIdeal) (H ⧸ J.toIdeal)) :=
    hKe ▸ Submodule.mem_span_singleton_self e
  have hε : Coalgebra.counit (R := k) (A := H ⧸ I.toIdeal) e = 0 := by
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective e
    rw [RingHom.mem_ker] at heK
    have hxJ : x ∈ J.toIdeal := by
      have : Ideal.Quotient.mk J.toIdeal x = 0 := heK
      exact Ideal.Quotient.eq_zero_iff_mem.1 this
    rw [Bialgebra.Quotient.counit_mk]
    exact J.counit_eq_zero hxJ
  have he0 : e = 0 := by
    have hclo := PrimeSpectrum.isClopen_basicOpen_of_mul_add e (1 - e)
      (by rw [mul_sub, mul_one, he.eq, sub_self]) (by ring)
    rcases isClopen_iff.1 hclo with h | h
    · exact he.eq_zero_of_isNilpotent ((PrimeSpectrum.basicOpen_eq_bot_iff e).1
        (TopologicalSpace.Opens.ext h))
    · exfalso
      have hdisj : (PrimeSpectrum.basicOpen (1 - e) : Set (PrimeSpectrum (H ⧸ I.toIdeal))) = ∅ := by
        ext p
        simp only [Set.mem_empty_iff_false, iff_false]
        intro hp
        have hpe : p ∈ (PrimeSpectrum.basicOpen e : Set (PrimeSpectrum (H ⧸ I.toIdeal))) :=
          h ▸ Set.mem_univ p
        have h1 : (1 - e) * e ∉ p.asIdeal := p.isPrime.mul_notMem hp hpe
        rw [sub_mul, one_mul, he.eq, sub_self] at h1
        exact h1 (zero_mem _)
      have hnil : IsNilpotent (1 - e) := (PrimeSpectrum.basicOpen_eq_bot_iff _).1
        (TopologicalSpace.Opens.ext hdisj)
      have h1e : 1 - e = 0 := (he.one_sub).eq_zero_of_isNilpotent hnil
      rw [(sub_eq_zero.1 h1e).symm, Bialgebra.counit_one] at hε
      exact one_ne_zero hε
  have hker : RingHom.ker (algebraMap (H ⧸ I.toIdeal) (H ⧸ J.toIdeal)) = ⊥ := by
    rw [hKe, he0]; simp
  refine le_antisymm hIJ fun x hx => ?_
  have : Ideal.Quotient.mk I.toIdeal x ∈ RingHom.ker (algebraMap (H ⧸ I.toIdeal) (H ⧸ J.toIdeal)) := by
    rw [RingHom.mem_ker]
    change Ideal.Quotient.factor hle (Ideal.Quotient.mk I.toIdeal x) = 0
    rw [Ideal.Quotient.factor_mk]
    exact Ideal.Quotient.eq_zero_iff_mem.2 hx
  rw [hker, Ideal.mem_bot] at this
  exact Ideal.Quotient.eq_zero_iff_mem.1 this

end Relative

end AlgMag.Reductive
