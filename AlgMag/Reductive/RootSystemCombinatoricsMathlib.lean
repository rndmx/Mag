import AlgMag.Reductive.ParabolicBijection
import Mathlib.LinearAlgebra.RootSystem.Base
import Mathlib.LinearAlgebra.RootSystem.WeylGroup

/-!
# The Weyl system of a Mathlib root datum

`P : RootPairing ι ℤ M N` crystallographic, reduced, finite, with a base `b`. Roots
`Φ = range P.root`, basis `B = P.root '' b.support`, `W = P.weylGroup` (generated by **all**
reflections) acting on `M`.

* `weylGroup_le_closure_simple`: `W` is generated by the simple reflections (`induction_reflect`
  and `s_{s_j α_i} = s_j s_i s_j`);
* `weylSystem`: the hypotheses of `RootSystem.WeylSystem` hold, hence `simpleSystem`: a
  `SimpleSystem` whose `coxeter` field is proved;
* `bijOn_parabolic_rootPairing`: the bijection of `thm:red-parabolic` onto all parabolic subsets.
-/

namespace AlgMag.Reductive.RootSystem.RootDatum

open Set RootPairing

variable {ι M N : Type*} [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) (b : P.Base)

/-- The action of the Weyl group on `M`. -/
noncomputable def act (w : P.weylGroup) : M →+ M where
  toFun m := (w : P.Aut) • m
  map_zero' := smul_zero _
  map_add' := smul_add _

open Classical in
/-- The simple reflection attached to a root (`1` off the roots). -/
noncomputable def refl (m : M) : P.weylGroup :=
  if h : ∃ i, P.root i = m then weylGroup.ofIdx P h.choose else 1

open Classical in
/-- The coroot attached to a root, as a functional on `M` (`0` off the roots). -/
noncomputable def coroot (m : M) : M →+ ℤ :=
  if h : ∃ i, P.root i = m then (P.coroot' h.choose).toAddMonoidHom else 0

lemma refl_root (i : ι) : refl P (P.root i) = weylGroup.ofIdx P i := by
  have h : ∃ j, P.root j = P.root i := ⟨i, rfl⟩
  rw [refl, dif_pos h, P.root.injective h.choose_spec]

lemma coroot_root (i : ι) (m : M) : coroot P (P.root i) m = P.coroot' i m := by
  have h : ∃ j, P.root j = P.root i := ⟨i, rfl⟩
  rw [coroot, dif_pos h, P.root.injective h.choose_spec]
  rfl

lemma act_apply (w : P.weylGroup) (m : M) : act P w m = (w : P.Aut) • m := rfl

variable {P} in
lemma mem_closure_of_isPos_aux {m : M} (hm : m ∈ AddSubmonoid.closure (P.root '' b.support)) :
    ∃ f : ι → ℕ, m = ∑ j ∈ b.support, f j • P.root j := by
  classical
  induction hm using AddSubmonoid.closure_induction with
  | mem x hx =>
    obtain ⟨j, hj, rfl⟩ := hx
    refine ⟨Pi.single j 1, ?_⟩
    rw [Finset.sum_eq_single j (fun k _ hk => by simp [Pi.single_apply, hk]) (fun h => absurd hj h)]
    simp
  | zero => exact ⟨0, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨f, rfl⟩ := hx
    obtain ⟨g, rfl⟩ := hy
    exact ⟨f + g, by simp [add_smul, Finset.sum_add_distrib]⟩

variable [Finite ι] [P.IsCrystallographic] [P.IsReduced]

variable {P} in
/-- `α_i ∈ ℕB ↔ α_i > 0`. -/
lemma mem_closure_iff_isPos (i : ι) :
    P.root i ∈ AddSubmonoid.closure (P.root '' b.support) ↔ b.IsPos i := by
  have key : ∀ i, P.root i ∈ AddSubmonoid.closure (P.root '' b.support) → b.IsPos i := by
    intro i h
    obtain ⟨f, hf⟩ := mem_closure_of_isPos_aux b h
    have hf' : P.root i = ∑ j ∈ b.support, ((f j : ℤ)) • P.root j := by
      rw [hf]; simp [natCast_zsmul]
    rw [Base.isPos_iff', Base.height_eq_sum hf']
    exact Finset.sum_nonneg fun j _ => by positivity
  refine ⟨key i, fun hi => ?_⟩
  rcases b.root_mem_or_neg_mem i with h | h
  · exact h
  · have h' : P.root (P.reflectionPerm i i) ∈ AddSubmonoid.closure (P.root '' b.support) := by
      rwa [root_reflectionPerm, reflection_apply_self]
    have hn := key _ h'
    let := P.indexNeg
    exact absurd hi ((Base.IsPos.neg_iff_not b i).1 hn)

lemma reflection_reflectionPerm_aut (i j : ι) :
    Equiv.reflection P (P.reflectionPerm j i) =
      Equiv.reflection P j * Equiv.reflection P i * Equiv.reflection P j := by
  apply Equiv.weightHom_injective
  ext x
  simp [map_mul, P.reflection_reflectionPerm]

/-- **The Weyl group is generated by the simple reflections.** -/
theorem weylGroup_le_closure_simple (w : P.weylGroup) :
    w ∈ Subgroup.closure (refl P '' (P.root '' b.support)) := by
  set G := Subgroup.closure (refl P '' (P.root '' b.support))
  have hsimple : ∀ i ∈ b.support, weylGroup.ofIdx P i ∈ G := fun i hi =>
    Subgroup.subset_closure ⟨P.root i, ⟨i, hi, rfl⟩, refl_root P i⟩
  have hconj : ∀ i j, weylGroup.ofIdx P (P.reflectionPerm j i) =
      weylGroup.ofIdx P j * weylGroup.ofIdx P i * weylGroup.ofIdx P j := fun i j =>
    Subtype.ext (reflection_reflectionPerm_aut P i j)
  have hall : ∀ i, weylGroup.ofIdx P i ∈ G := fun i =>
    b.induction_reflect i (p := fun i => weylGroup.ofIdx P i ∈ G)
      (fun i hi => by rw [hconj]; exact mul_mem (mul_mem hi hi) hi)
      hsimple
      (fun i j hi hj => by rw [hconj]; exact mul_mem (mul_mem (hsimple j hj) hi) (hsimple j hj))
  obtain ⟨w, hw⟩ := w
  induction hw using weylGroup.induction with
  | mem i => exact hall i
  | one => exact one_mem G
  | mul x y hx hy hx' hy' => exact mul_mem hx' hy'

/-- **The Mathlib root datum is a `WeylSystem`.** -/
theorem weylSystem :
    WeylSystem (range P.root) (P.root '' b.support) (act P) (refl P) (coroot P) where
  basis_sub := image_subset_range _ _
  pointed := by
    rintro _ ⟨i, rfl⟩ h1 h2
    have h2' : P.root (P.reflectionPerm i i) ∈ AddSubmonoid.closure (P.root '' b.support) := by
      rwa [root_reflectionPerm, reflection_apply_self]
    rw [mem_closure_iff_isPos] at h1 h2'
    let := P.indexNeg
    exact (Base.IsPos.neg_iff_not b i).1 h2' h1
  act_mul v w m := by rw [act_apply, act_apply, act_apply, Subgroup.coe_mul, mul_smul]
  act_one m := by rw [act_apply, OneMemClass.coe_one, one_smul]
  act_mem := by
    rintro w _ ⟨i, rfl⟩
    exact ⟨(w : P.Aut).indexEquiv i, Equiv.root_indexEquiv_eq_smul P i _⟩
  refl_act := by
    rintro _ ⟨i, -, rfl⟩ m
    rw [refl_root, coroot_root, act_apply]
    rfl
  coroot_self := by
    rintro _ ⟨i, -, rfl⟩
    rw [coroot_root]
    exact P.root_coroot_two i
  coroot_act := by
    rintro w _ _ ⟨i, -, rfl⟩ ⟨j, -, rfl⟩ hw m
    rw [act_apply, ← Equiv.root_indexEquiv_eq_smul] at hw
    have hij := P.root.injective hw
    have key : ∀ (g : P.Aut) (x : M) (k : ι),
        P.coroot' k (g • x) = P.coroot' (g.indexEquiv.symm k) x := by
      intro g x k
      have hc : g.coweightMap (P.coroot k) = P.coroot (g.indexEquiv.symm k) := by
        simpa using congr_fun g.coroot_coweightMap k
      have h := LinearMap.congr_fun₂ g.weight_coweight_transpose (P.coroot k) x
      change P.toLinearMap (g.weightMap x) (P.coroot k) = _
      simpa [hc] using h
    rw [coroot_root, coroot_root, act_apply, Subgroup.coe_inv]
    conv_lhs => rw [← smul_inv_smul (w : P.Aut) m]
    rw [key, ← hij, _root_.Equiv.symm_apply_apply]
  refl_sq := by
    rintro _ ⟨i, -, rfl⟩
    rw [refl_root]
    apply Subtype.ext
    show Equiv.reflection P i * Equiv.reflection P i = 1
    conv_lhs => arg 1; rw [← Equiv.reflection_inv]
    exact inv_mul_cancel _
  refl_pos := by
    rintro _ ⟨i, hi, rfl⟩ _ ⟨j, rfl⟩ hj hne
    rw [refl_root, act_apply]
    have hji : j ≠ i := fun h => hne (by rw [h])
    have : (weylGroup.ofIdx P i : P.Aut) • P.root j = P.root (P.reflectionPerm i j) := by
      rw [root_reflectionPerm]; rfl
    rw [this, mem_closure_iff_isPos]
    rw [mem_closure_iff_isPos] at hj
    exact hj.reflectionPerm hi hji
  gen := weylGroup_le_closure_simple P b


/-- **The simple system of the root datum**, with `coxeter` proved (`SimpleSystem.ofWeyl`). -/
theorem simpleSystem :
    Parabolic.SimpleSystem (range P.root) (P.root '' b.support) (act P) :=
  Parabolic.SimpleSystem.ofWeyl (weylSystem P b) (finite_range _)
    (by rintro _ ⟨i, rfl⟩; exact b.root_mem_or_neg_mem i)
    (by rintro _ ⟨i, rfl⟩; exact P.neg_mem_range_root_iff.2 ⟨i, rfl⟩)

/-! ### Closed subsets of roots -/

/-- `R ⊆ Φ` is **closed**: `α, β ∈ R`, `α + β ∈ Φ` imply `α + β ∈ R`. -/
def IsClosedRoots (Φ R : Set M) : Prop :=
  R ⊆ Φ ∧ ∀ α ∈ R, ∀ β ∈ R, α + β ∈ Φ → α + β ∈ R

lemma IsClosedRoots.of_isStableElt {Φ R : Set M} (h : Rooted.IsStableElt Φ R) :
    IsClosedRoots Φ R := by
  refine ⟨h.1, fun α hα β hβ hαβ => ?_⟩
  rw [← h.2]
  exact ⟨add_mem (AddSubmonoid.subset_closure hα) (AddSubmonoid.subset_closure hβ), hαβ⟩

/-- Coordinates of a root in the base. -/
noncomputable def cf (k : ι) : ι → ℤ := (b.exists_root_eq_sum_int k).choose

variable {P b} [DecidableEq ι]

lemma cf_spec (k : ι) : P.root k = ∑ j ∈ b.support, cf P b k j • P.root j :=
  (b.exists_root_eq_sum_int k).choose_spec.2.2

lemma coeff_unique {f g : ι → ℤ}
    (h : ∑ j ∈ b.support, f j • P.root j = ∑ j ∈ b.support, g j • P.root j) :
    ∀ j ∈ b.support, f j = g j := by
  intro j hj
  have h' : ∑ i : b.support, f i • P.root i = ∑ i : b.support, g i • P.root i := by
    rw [Finset.sum_coe_sort b.support (fun i => f i • P.root i),
      Finset.sum_coe_sort b.support (fun i => g i • P.root i)]
    exact h
  exact Fintype.linearIndependent_iffₛ.mp b.linearIndepOn_root (fun i => f i) (fun i => g i) h'
    ⟨j, hj⟩

lemma single_sum {j : ι} (hj : j ∈ b.support) :
    ∑ l ∈ b.support, (Pi.single j 1 : ι → ℤ) l • P.root l = P.root j := by
  rw [Finset.sum_eq_single j (fun l _ hl => by simp [Pi.single_apply, hl])
    (fun h => absurd hj h)]
  simp

lemma cf_nonneg {k : ι} (hk : b.IsPos k) (j : ι) : 0 ≤ cf P b k j := by
  rcases (b.exists_root_eq_sum_int k).choose_spec.2.1 with h | h
  · exact h.le j
  · exfalso
    rw [Base.isPos_iff, Base.height_eq_sum (cf_spec k)] at hk
    have : ∑ j ∈ b.support, cf P b k j ≤ 0 := Finset.sum_nonpos fun j _ => h.le j
    exact absurd hk (not_lt.2 this)

lemma cf_add {i j k : ι} (h : P.root k = P.root i + P.root j) (hj : j ∈ b.support) :
    ∀ l ∈ b.support, cf P b k l = cf P b i l + (Pi.single j 1 : ι → ℤ) l := by
  apply coeff_unique
  rw [← cf_spec, h]
  simp only [add_smul, Finset.sum_add_distrib]
  rw [← cf_spec, single_sum hj]

lemma cf_simple {k : ι} (hk : k ∈ b.support) :
    ∀ l ∈ b.support, cf P b k l = (Pi.single k 1 : ι → ℤ) l := by
  apply coeff_unique
  rw [← cf_spec, single_sum hk]

lemma isPos_of_add {i j k : ι} (h : P.root k = P.root i + P.root j) (hk : b.IsPos k)
    (hj : j ∈ b.support) : b.IsPos i := by
  rw [Base.isPos_iff']
  rw [Base.isPos_iff] at hk
  have := b.height_add h
  rw [Base.height_one_of_mem_support hj] at this
  omega

variable {R : Set M}

/-- If `-α_k ∈ R` (`k > 0`), then `α_k ∈ ℕξ`, `ξ = {α ∈ B | -α ∈ R}`. -/
lemma cf_eq_zero_of_neg_mem (hcl : IsClosedRoots (range P.root) R)
    (hpos : ∀ k, b.IsPos k → P.root k ∈ R) {k : ι} (hk : b.IsPos k) :
    -P.root k ∈ R → ∀ l ∈ b.support, -P.root l ∉ R → cf P b k l = 0 := by
  refine hk.induction_on_add (p := fun k => b.IsPos k →
      -P.root k ∈ R → ∀ l ∈ b.support, -P.root l ∉ R → cf P b k l = 0) ?_ ?_ hk
  · intro k hk _ hkR l hl hlR
    rw [cf_simple hk l hl, Pi.single_apply, if_neg (fun h : l = k => hlR (h ▸ hkR))]
  · intro i j k hsum hpi hj hk hkR l hl hlR
    have hi := isPos_of_add hsum hk hj
    have hiR : -P.root i ∈ R := by
      have := hcl.2 _ hkR _ (hpos j (Base.isPos_of_mem_support hj))
        (by rw [hsum, neg_add, neg_add_cancel_right]; exact P.neg_mem_range_root_iff.2 ⟨i, rfl⟩)
      rwa [hsum, neg_add, neg_add_cancel_right] at this
    have hjR : -P.root j ∈ R := by
      have := hcl.2 _ hkR _ (hpos i hi)
        (by rw [hsum, neg_add, add_comm, ← add_assoc, add_neg_cancel, zero_add]
            exact P.neg_mem_range_root_iff.2 ⟨j, rfl⟩)
      rwa [hsum, neg_add, add_comm, ← add_assoc, add_neg_cancel, zero_add] at this
    rw [cf_add hsum hj l hl, hpi hi hiR l hl hlR, Pi.single_apply,
      if_neg (fun h : l = j => hlR (h ▸ hjR))]
    rfl

/-- Conversely, `α_k ∈ ℕξ` (`k > 0`) gives `-α_k ∈ R`. -/
lemma neg_mem_of_cf_eq_zero (hcl : IsClosedRoots (range P.root) R) {k : ι} (hk : b.IsPos k) :
    (∀ l ∈ b.support, -P.root l ∉ R → cf P b k l = 0) → -P.root k ∈ R := by
  refine hk.induction_on_add (p := fun k => b.IsPos k →
      (∀ l ∈ b.support, -P.root l ∉ R → cf P b k l = 0) → -P.root k ∈ R) ?_ ?_ hk
  · intro k hk _ hyp
    by_contra h
    have := hyp k hk h
    rw [cf_simple hk k hk] at this
    simp at this
  · intro i j k hsum hpi hj hk hyp
    have hi := isPos_of_add hsum hk hj
    have hjR : -P.root j ∈ R := by
      by_contra h
      have h1 := hyp j hj h
      rw [cf_add hsum hj j hj] at h1
      have := cf_nonneg hi j
      simp at h1
      omega
    have hiR : -P.root i ∈ R := hpi hi fun l hl hlR => by
      have h1 := hyp l hl hlR
      rw [cf_add hsum hj l hl, Pi.single_apply, if_neg (fun h : l = j => hlR (h ▸ hjR))] at h1
      simpa using h1
    have := hcl.2 _ hiR _ hjR (by rw [← neg_add, ← hsum]; exact P.neg_mem_range_root_iff.2 ⟨k, rfl⟩)
    rwa [← neg_add, ← hsum] at this

lemma exists_coords_of_mem_closure (hcl : IsClosedRoots (range P.root) R)
    (hpos : ∀ k, b.IsPos k → P.root k ∈ R) {x : M} (hx : x ∈ AddSubmonoid.closure R) :
    ∃ a e : ι → ℤ, (∀ j, 0 ≤ a j) ∧ (∀ j, 0 ≤ e j) ∧
      (∀ l ∈ b.support, -P.root l ∉ R → e l = 0) ∧
      x = ∑ j ∈ b.support, (a j - e j) • P.root j := by
  induction hx using AddSubmonoid.closure_induction with
  | mem x hx =>
    obtain ⟨k, rfl⟩ := hcl.1 hx
    by_cases hk : b.IsPos k
    · exact ⟨cf P b k, (0 : ι → ℤ), cf_nonneg hk, fun _ => le_rfl, fun _ _ _ => rfl, by
        simpa using cf_spec k⟩
    · let := P.indexNeg
      have hk' : b.IsPos (P.reflectionPerm k k) := (Base.IsPos.or_neg b k).resolve_left hk
      have hroot : P.root (P.reflectionPerm k k) = -P.root k := by
        rw [root_reflectionPerm, reflection_apply_self]
      have hnR : -P.root (P.reflectionPerm k k) ∈ R := by rw [hroot, neg_neg]; exact hx
      refine ⟨0, cf P b (P.reflectionPerm k k), fun _ => le_rfl, cf_nonneg hk',
        cf_eq_zero_of_neg_mem hcl hpos hk' hnR, ?_⟩
      rw [← neg_neg (P.root k), ← hroot, cf_spec (b := b) (P.reflectionPerm k k), ← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Pi.zero_apply, zero_sub, neg_smul]
  | zero => exact ⟨0, 0, fun _ => le_rfl, fun _ => le_rfl, fun _ _ _ => rfl, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨a1, e1, ha1, he1, hz1, rfl⟩ := hx
    obtain ⟨a2, e2, ha2, he2, hz2, rfl⟩ := hy
    refine ⟨a1 + a2, e1 + e2, fun j => add_nonneg (ha1 j) (ha2 j),
      fun j => add_nonneg (he1 j) (he2 j), fun l hl hlR => by
        simp [hz1 l hl hlR, hz2 l hl hlR], ?_⟩
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [← add_smul]
    congr 1
    simp only [Pi.add_apply]
    omega

/-- **A closed `R ⊇ Φ⁺` is additively stable.** -/
theorem isStableElt_of_pos (hcl : IsClosedRoots (range P.root) R)
    (hpos : ∀ k, b.IsPos k → P.root k ∈ R) : Rooted.IsStableElt (range P.root) R := by
  refine ⟨hcl.1, Subset.antisymm ?_ fun x hx => ⟨AddSubmonoid.subset_closure hx, hcl.1 hx⟩⟩
  rintro x ⟨hx, k, rfl⟩
  by_cases hk : b.IsPos k
  · exact hpos k hk
  let := P.indexNeg
  have hk' : b.IsPos (P.reflectionPerm k k) := (Base.IsPos.or_neg b k).resolve_left hk
  have hroot : P.root (P.reflectionPerm k k) = -P.root k := by
    rw [root_reflectionPerm, reflection_apply_self]
  obtain ⟨a, e, ha, he, hz, hxe⟩ := exists_coords_of_mem_closure hcl hpos hx
  have hc : ∀ l ∈ b.support, a l - e l = -cf P b (P.reflectionPerm k k) l := by
    apply coeff_unique
    rw [← hxe, ← neg_neg (P.root k), ← hroot, cf_spec (b := b) (P.reflectionPerm k k),
      ← Finset.sum_neg_distrib]
    simp only [neg_smul]
  have := neg_mem_of_cf_eq_zero hcl hk' fun l hl hlR => by
    have h1 := hc l hl
    have h2 := hz l hl hlR
    have h3 := ha l
    have h4 := cf_nonneg hk' l
    omega
  rwa [hroot, neg_neg] at this

variable (P b)

omit [DecidableEq ι] in
include b in
/-- **Closed ⇒ additively stable** for `R ∪ -R = Φ` (Bourbaki VI §1 Prop. 20 and no. 7). -/
theorem isStableElt_of_closed (hcl : IsClosedRoots (range P.root) R) (hu : R ∪ -R = range P.root) :
    Rooted.IsStableElt (range P.root) R := by
  classical
  have S := simpleSystem P b
  obtain ⟨v, hv⟩ := S.exists_translate_pos_sub_of (fun v hall β hβ hβB => by
    obtain ⟨k, rfl⟩ := hβ
    rw [mem_closure_iff_isPos] at hβB
    refine hβB.induction_on_add (p := fun k => act P v (P.root k) ∈ R)
      (fun k hk => hall _ ⟨k, hk, rfl⟩) fun i j k hsum hi hj => ?_
    have hk : act P v (P.root k) = act P v (P.root i) + act P v (P.root j) := by
      rw [hsum, map_add]
    rw [hk]
    exact hcl.2 _ hi _ (hall _ ⟨j, hj, rfl⟩) (by rw [← hk]; exact S.act_mem _ _ ⟨k, rfl⟩)) hu
  set R' := (act P v) ⁻¹' R
  have hcl' : IsClosedRoots (range P.root) R' := by
    refine ⟨fun x hx => ?_, fun x hx y hy hxy => ?_⟩
    · rw [← S.act_inv_act v x]; exact S.act_mem _ _ (hcl.1 hx)
    · show act P v (x + y) ∈ R
      rw [map_add]
      exact hcl.2 _ hx _ hy (by rw [← map_add]; exact S.act_mem _ _ hxy)
  have hpos' : ∀ k, b.IsPos k → P.root k ∈ R' := fun k hk =>
    hv ⟨S.act_mem _ _ ⟨k, rfl⟩, by
      rw [SetLike.mem_coe, S.mem_closure_translate, S.act_inv_act, mem_closure_iff_isPos]
      exact hk⟩
  have hst := isStableElt_of_pos hcl' hpos'
  refine ⟨hcl.1, Subset.antisymm (fun x ⟨hx, hxΦ⟩ => ?_)
    fun x hx => ⟨AddSubmonoid.subset_closure hx, hcl.1 hx⟩⟩
  have hle : AddSubmonoid.closure R ≤ (AddSubmonoid.closure R').comap (act P v⁻¹) := by
    rw [AddSubmonoid.closure_le]
    intro r hr
    exact AddSubmonoid.subset_closure (show act P v (act P v⁻¹ r) ∈ R by
      rw [S.act_act_inv]; exact hr)
  have hy : act P v⁻¹ x ∈ R' := by
    rw [← hst.2]
    exact ⟨hle hx, S.act_mem _ _ hxΦ⟩
  have : act P v (act P v⁻¹ x) ∈ R := hy
  rwa [S.act_act_inv] at this

omit [DecidableEq ι] in
/-- **Theorem `thm:red-parabolic` for a root datum: `N ↦ N ∩ Φ` is a bijection from the pure
magnets containing a basis `wB` onto the parabolic (closed, `R ∪ -R = Φ`) subsets**, inverse
`R ↦ [R⟩`. Only `ReductiveInput` (Theorem `thm:red-pure`) is assumed. -/
theorem bijOn_parabolic_rootPairing {Q : AddSubmonoid M → Prop}
    (H : Rooted.ReductiveInput Q (range P.root) (act P)) :
    Set.BijOn (fun N : AddSubmonoid M => (N : Set M) ∩ range P.root)
        {N | Q N ∧ ∃ B' ∈ Set.range (fun v : P.weylGroup => act P v '' (P.root '' b.support)),
          B' ⊆ N}
        {R | IsClosedRoots (range P.root) R ∧ R ∪ -R = range P.root} ∧
      Set.InvOn AddSubmonoid.closure (fun N : AddSubmonoid M => (N : Set M) ∩ range P.root)
        {N | Q N ∧ ∃ B' ∈ Set.range (fun v : P.weylGroup => act P v '' (P.root '' b.support)),
          B' ⊆ N}
        {R | IsClosedRoots (range P.root) R ∧ R ∪ -R = range P.root} := by
  classical
  have hT : {R | IsClosedRoots (range P.root) R ∧ R ∪ -R = range P.root} =
      {R | Rooted.IsStableElt (range P.root) R ∧ R ∪ -R = range P.root} := by
    ext R
    exact ⟨fun ⟨h, hu⟩ => ⟨isStableElt_of_closed P b h hu, hu⟩,
      fun ⟨h, hu⟩ => ⟨IsClosedRoots.of_isStableElt h, hu⟩⟩
  rw [hT]
  exact Parabolic.bijOn_parabolic_all H (simpleSystem P b)

end AlgMag.Reductive.RootSystem.RootDatum
