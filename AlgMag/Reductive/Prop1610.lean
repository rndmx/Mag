import AlgMag.Reductive.AttractorSubgroup
import AlgMag.Reductive.PushCocharacter

/-!
# Proposition 16.10 (ii) of Algebraic Magnetism: the parabolic as the attractor of `N_Σ`

The classical input is isolated in the hypothesis structure `ParabolicGeneration`: the dynamic
parabolic `P(λ_f)` is the smallest closed subgroup containing given closed subgroups `U_i`
(over a field: `T` and the root groups `U_α`, `α ∈ Φ ∩ N`, by the big cell of `P`), each of
which lies in the attractor `G^N` (Proposition 16.9 for root groups, Proposition 3.35 for `T`).
From it and `N ⊆ f⁻¹(ℕ)` we prove `G^N = P(λ_f)`, as in the printed proof.
-/

suppress_compilation

open Magnetism TauCeti TauCeti.Cocharacter

namespace AlgMag.Reductive

universe u v w

variable {R : Type u} {H : Type v} {X : Type w}
variable [CommRing R] [CommRing H] [HopfAlgebra R H] [CommGroup X] [DecidableEq X]
variable (π : H →ₐc[R] MonoidAlgebra R X) (ψ : X →* Multiplicative ℤ)

/-- **Hypothesis (generation of the parabolic).** `P(λ_f)` is generated, as a closed subgroup, by
the closed subgroups `U i` (Hopf ideals `U i`), all contained in the attractor `G^N`. -/
structure ParabolicGeneration (N : Magnet (Additive X)) where
  /-- Index set of the generating subgroups (e.g. `T` and the root groups `U_α`, `α ∈ Φ ∩ N`). -/
  ι : Type*
  /-- The generating closed subgroups, as Hopf ideals. -/
  U : ι → HopfIdeal R H
  /-- Each generator lies in `G^N`. -/
  le_attractor : ∀ i, magnetIdeal (torusGrading π) N ≤ (U i).toIdeal
  /-- `P(λ_f)` is the smallest closed subgroup containing every `U i`. -/
  generates : ∀ I : HopfIdeal R H, (∀ i, I.toIdeal ≤ (U i).toIdeal) →
    I.toIdeal ≤ (parabolicDefiningHopfIdeal (π.cocharacter ψ)).toIdeal

/-- **Proposition 16.10 (ii) of Algebraic Magnetism (attractor form).** If `N ⊆ f⁻¹(ℕ)` and
`P(λ_f)` is generated by closed subgroups lying in `G^N`, then `G^N = P(λ_f)`. -/
theorem magnetIdeal_eq_parabolic {N : Magnet (Additive X)}
    (hN : N ≤ natMagnet.comap (pairingHom ψ)) (hgen : ParabolicGeneration π ψ N) :
    magnetIdeal (torusGrading π) N = (parabolicDefiningHopfIdeal (π.cocharacter ψ)).toIdeal := by
  apply le_antisymm
  · have := hgen.generates (magnetHopfIdeal π N) (fun i => by
      rw [magnetHopfIdeal_toIdeal]; exact hgen.le_attractor i)
    rwa [magnetHopfIdeal_toIdeal] at this
  · rw [← magnetIdeal_torusGrading_comap_nat]
    exact magnetIdeal_anti _ hN

end AlgMag.Reductive
