import AlgMag.Reductive.SplitReductiveRootDatum
import AlgMag.Reductive.WeylPart

/-!
# Lemma `lem:weyl-part` (iii) for a split reductive group

`D : SplitReductiveData.WithRootDatum π`: `W` the Weyl group of `G` (a finite group of
automorphisms of `X`), `P` a root datum whose roots are the roots `Φ` of `G` and whose Weyl group
acts on `X` as `W`. For a root `β = P.root i`, `s_β ∈ W` is the element acting on `X` as the
reflection of `P`: `s_β(m) = m - ⟨m, β^∨⟩β`, so `(1 - s_β)M ⊆ ℤβ`.

For a magnet `N`, with `R(N) ∩ -R(N) = {β ∈ Φ | β ∈ N, -β ∈ N}` and
`W(R(N) ∩ -R(N))` the subgroup of `W` generated by the `s_β`, `β ∈ R(N) ∩ -R(N)`:

* `joinIrredWeylMagnets_le_weylPart`: `W(R(N) ∩ -R(N)) ⊆ W_N`;
* `sub_mem_symLattice`: `(1 - w)M ⊆ ℤ(R(N) ∩ -R(N))` for `w ∈ W(R(N) ∩ -R(N))`;
* `joinIrredWeylMagnets_normal`: `W(R(N) ∩ -R(N))` is normal in `W_N`.

These instantiate `closure_le_weylPart`, `sub_mem_of_mem_closure` and
`closure_normal_in_weylPart` of `AlgMag.Reductive.WeylPart`.
-/

open TensorProduct Magnetism TauCeti WithConv Set RootPairing

namespace AlgMag.Reductive

universe u

variable {X : Type u} [CommGroup X]

/-- A group of automorphisms of `X` acts on `Additive X`. -/
noncomputable instance weylActAdditive (W : Subgroup (X ≃* X)) : DistribMulAction W (Additive X) where
  smul w m := actW (w : X ≃* X) m
  one_smul _ := rfl
  mul_smul _ _ _ := rfl
  smul_zero w := map_zero (actW (w : X ≃* X))
  smul_add w a b := map_add (actW (w : X ≃* X)) a b

lemma weyl_smul_def {W : Subgroup (X ≃* X)} (w : W) (m : Additive X) :
    w • m = actW (w : X ≃* X) m := rfl

/-- An element of a group of automorphisms of `X` is determined by its action on `Additive X`. -/
lemma weyl_ext {W : Subgroup (X ≃* X)} {w w' : W} (h : ∀ m : Additive X, w • m = w' • m) :
    w = w' := by
  refine Subtype.ext (MulEquiv.ext fun x => ?_)
  exact congrArg Additive.toMul (h (Additive.ofMul x))

variable {k : Type u} {H : Type u}
variable [Field k] [CommRing H] [HopfAlgebra k H] [DecidableEq X]
variable [Module.Finite k (Bialgebra.CotangentSpace k H)]

namespace SplitReductiveData.WithRootDatum

variable {π : H →ₐc[k] MonoidAlgebra k X} (D : SplitReductiveData.WithRootDatum π)

instance finiteW : Finite D.W := D.finite

/-- An element of `W` acting on `X` as a given element of the Weyl group of `P`. -/
lemma exists_weyl_of_weylGroup (g : D.P.weylGroup) :
    ∃ w : D.W, ∀ m : Additive X, w • m = (g : D.P.Aut) • m := by
  have h : RootSystem.RootDatum.act D.P g ∈
      range (fun w : D.W => actW (w : X ≃* X)) := D.weyl_eq ▸ ⟨g, rfl⟩
  obtain ⟨w, hw⟩ := h
  exact ⟨w, fun m => congrArg (fun f => f m) hw⟩

/-- An element of the Weyl group of `P` acting on `X` as a given element of `W`. -/
lemma exists_weylGroup_of_weyl (w : D.W) :
    ∃ g : D.P.weylGroup, ∀ m : Additive X, (g : D.P.Aut) • m = w • m := by
  have h : actW (w : X ≃* X) ∈
      range (fun g : D.P.weylGroup => RootSystem.RootDatum.act D.P g) := D.weyl_eq.symm ▸ ⟨w, rfl⟩
  obtain ⟨g, hg⟩ := h
  exact ⟨g, fun m => congrArg (fun f => f m) hg⟩

/-- The reflection `s_β ∈ W` of the root `β = P.root i`. -/
noncomputable def refl (i : D.ι) : D.W :=
  (D.exists_weyl_of_weylGroup (weylGroup.ofIdx D.P i)).choose

/-- `s_β(m) = m - ⟨m, β^∨⟩β`. -/
lemma refl_smul (i : D.ι) (m : Additive X) : D.refl i • m = D.P.reflection i m := by
  rw [refl, (D.exists_weyl_of_weylGroup (weylGroup.ofIdx D.P i)).choose_spec m]
  rfl

/-- `(1 - s_β)M ⊆ ℤβ`. -/
lemma sub_refl_smul_mem (i : D.ι) (m : Additive X) :
    m - D.refl i • m ∈ AddSubgroup.zmultiples (D.P.root i) := by
  rw [D.refl_smul, reflection_apply, sub_sub_cancel]
  exact ⟨_, rfl⟩

/-- The indices of `R(N) ∩ -R(N)`: roots `β` with `β ∈ N` and `-β ∈ N`. -/
def symRoots (N : AddSubmonoid (Additive X)) : Set D.ι :=
  {i | D.P.root i ∈ N ∧ -D.P.root i ∈ N}

/-- The indexed roots are `R(N) ∩ -R(N) = {β ∈ Φ | β ∈ N, -β ∈ N}`. -/
lemma image_symRoots (N : AddSubmonoid (Additive X)) :
    D.P.root '' D.symRoots N = {β | β ∈ roots π ∧ β ∈ N ∧ -β ∈ N} := by
  ext β
  constructor
  · rintro ⟨i, hi, rfl⟩
    exact ⟨D.range_root ▸ ⟨i, rfl⟩, hi⟩
  · rintro ⟨hβ, h⟩
    rw [← D.range_root] at hβ
    obtain ⟨i, rfl⟩ := hβ
    exact ⟨i, h, rfl⟩

/-- The reflections `s_β`, `β ∈ R(N) ∩ -R(N)`. -/
def reflSet (N : AddSubmonoid (Additive X)) : Set D.W := D.refl '' D.symRoots N

/-- `W(R(N) ∩ -R(N))`, the subgroup of `W` generated by the `s_β`, `β ∈ R(N) ∩ -R(N)`. -/
def joinIrredWeylMagnets (N : AddSubmonoid (Additive X)) : Subgroup D.W := Subgroup.closure (D.reflSet N)

/-- `ℤ(R(N) ∩ -R(N))`. -/
def symLattice (N : AddSubmonoid (Additive X)) : AddSubgroup (Additive X) :=
  AddSubgroup.closure (D.P.root '' D.symRoots N)

lemma symLattice_le (N : AddSubmonoid (Additive X)) : ∀ z ∈ D.symLattice N, z ∈ N := by
  intro z hz
  suffices h : z ∈ N ∧ -z ∈ N from h.1
  induction hz using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨i, hi, rfl⟩ := hx
    exact hi
  | zero => simp
  | add x y _ _ hx hy => exact ⟨N.add_mem hx.1 hy.1, by rw [neg_add]; exact N.add_mem hx.2 hy.2⟩
  | neg x _ hx => exact ⟨hx.2, by rw [neg_neg]; exact hx.1⟩

lemma reflSet_sub_mem (N : AddSubmonoid (Additive X)) :
    ∀ s ∈ D.reflSet N, ∀ m : Additive X, m - s • m ∈ D.symLattice N := by
  rintro _ ⟨i, hi, rfl⟩ m
  exact AddSubgroup.zmultiples_le_of_mem (AddSubgroup.subset_closure (Set.mem_image_of_mem D.P.root hi))
    (D.sub_refl_smul_mem i m)

/-- **Lemma `lem:weyl-part` (iii) for `G`, inclusion.** `W(R(N) ∩ -R(N)) ⊆ W_N`. -/
theorem joinIrredWeylMagnets_le_weylPart (N : AddSubmonoid (Additive X)) :
    D.joinIrredWeylMagnets N ≤ weylPart N :=
  closure_le_weylPart (D.symLattice_le N) (D.reflSet_sub_mem N)

/-- **Lemma `lem:weyl-part` (iii) for `G`, lattice.** `(1 - w)M ⊆ ℤ(R(N) ∩ -R(N))` for
`w ∈ W(R(N) ∩ -R(N))`. -/
theorem sub_mem_symLattice (N : AddSubmonoid (Additive X)) {w : D.W} (hw : w ∈ D.joinIrredWeylMagnets N)
    (m : Additive X) : m - w • m ∈ D.symLattice N :=
  sub_mem_of_mem_closure (D.reflSet_sub_mem N) hw m

/-- `g s_β g⁻¹ = s_{gβ}` for `g` in the Weyl group of `P`, on `X`. -/
lemma smul_reflection (g : D.P.Aut) (i : D.ι) (x : Additive X) :
    g • D.P.reflection i x = D.P.reflection (g.indexEquiv i) (g • x) :=
  RootPairing.Equiv.weightEquiv_reflection g i x

/-- `v s_β v⁻¹ = s_{vβ}` for `v ∈ W_N` and `β ∈ R(N) ∩ -R(N)`. -/
lemma conj_mem_reflSet (N : AddSubmonoid (Additive X)) :
    ∀ v ∈ weylPart N, ∀ s ∈ D.reflSet N, v * s * v⁻¹ ∈ D.reflSet N := by
  rintro v hv _ ⟨i, hi, rfl⟩
  obtain ⟨g, hg⟩ := D.exists_weylGroup_of_weyl v
  have hginv : ∀ m : Additive X, v⁻¹ • m = ((g : D.P.Aut)⁻¹) • m := by
    intro m
    apply MulAction.injective v
    change v • v⁻¹ • m = v • ((g : D.P.Aut)⁻¹ • m)
    rw [smul_inv_smul, ← hg, smul_inv_smul]
  let j := (g : D.P.Aut).indexEquiv i
  have hj : D.P.root j = v • D.P.root i := by
    rw [RootPairing.Equiv.root_indexEquiv_eq_smul, hg]
  refine ⟨j, ⟨?_, ?_⟩, ?_⟩
  · rw [hj]; exact weylPart_smul_mem hv hi.1
  · rw [hj, ← smul_neg]; exact weylPart_smul_mem hv hi.2
  · refine weyl_ext fun m => ?_
    rw [D.refl_smul, mul_smul, mul_smul, hginv, D.refl_smul, ← hg, smul_reflection,
      smul_inv_smul]

/-- **Lemma `lem:weyl-part` (iii) for `G`, normality.** `W(R(N) ∩ -R(N))` is normal in `W_N`. -/
theorem joinIrredWeylMagnets_normal (N : AddSubmonoid (Additive X)) :
    ∀ v ∈ weylPart N, ∀ w ∈ D.joinIrredWeylMagnets N, v * w * v⁻¹ ∈ D.joinIrredWeylMagnets N :=
  closure_normal_in_weylPart (D.conj_mem_reflSet N)

end SplitReductiveData.WithRootDatum

end AlgMag.Reductive
