/-!
# Reductivity from data at a maximal torus (statement)

`k` algebraically closed, `G = Spec H` smooth, connected, finite type, `T = D(X) ⊆ G` a split
maximal torus given by the surjection `π : H → k[X]`. Then `G` is reductive (Tau Ceti's
`reductiveCommHopfAlgProperty`) iff

* (i)   `Z_G(T) = T`, i.e. the attractor ideal of the zero magnet is `ker π`;
* (ii') every root space `𝔤_α` is a line and `Φ ∩ ℚα = {±α}`;
* (iii) for every root `α` some `k`-point of `G^{ℤα}` normalizes `T` and acts by `σ` with
  `σ(α) = -α`.

Status: (⇐) `reductive_of_condI_condII_condIII` is proved (no sorry; axioms propext,
Classical.choice, Quot.sound). (⇒) `condI_condII_condIII_of_reductive` is proved from exactly two
geometric inputs, taken as explicit hypotheses (no `sorry`):
* `hDC : DimCountInput π hπ`: `dim Lie G ≤ dim Lie T + #(rays of λ-positive roots) +
  #(rays of λ-negative roots)` for some regular `λ` (classically `dim G = dim T + |Φ|`);
* `hR1 : R1Input π`: each rank-one attractor `G^{ℤα}` contains a point normalizing `T` with
  nontrivial action on `X`.
Their proofs (equivalence-reductive notes: the closed orbit `Y = G/Q` of `G` in a flag variety,
Białynicki-Birula, Lemma K; `dim Y = |Ψ⁺| = dim U(λ)` and the two fixed points of each `T`-curve)
need projective-variety infrastructure that is not in the library.
-/

suppress_compilation

set_option linter.style.haveILetI false

open TensorProduct Magnetism TauCeti WithConv AlgMag.Weyl

namespace AlgMag.Reductive

universe u

section BaseChangeAux

variable {k : Type u} (K : Type u) {H : Type u} [Field k] [Field K] [Algebra k K]
variable [CommRing H] [HopfAlgebra k H] {X : Type u} [CommGroup X] [DecidableEq X]
variable (π : H →ₐc[k] MonoidAlgebra k X)

/-- **`G^N_e` base changes**: the equations of `(G_K)^N_e` are generated by those of `G^N_e`. -/
theorem prescribedUnitIdeal_baseChange (N : Magnet (Additive X)) :
    prescribedUnitIdeal (torusBaseChange K π) N =
      (prescribedUnitIdeal π N).map (Algebra.TensorProduct.includeRight : H →ₐ[k] K ⊗[k] H) := by
  rw [prescribedUnitIdeal, prescribedUnitIdeal, Ideal.map_sup, magnetIdeal_baseChange,
    Ideal.map_span]
  congr 1
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨x, hx, rfl⟩
    rw [torusGrading_baseChange, Submodule.baseChange_eq_span] at hx
    rw [SetLike.mem_coe]
    refine Submodule.span_induction (p := fun x _ =>
      x - algebraMap K (K ⊗[k] H) (Coalgebra.counit (R := K) x) ∈ Ideal.span
        ((Algebra.TensorProduct.includeRight : H →ₐ[k] K ⊗[k] H) ''
          {y | ∃ x ∈ torusGrading π 0, x - algebraMap k H (Coalgebra.counit (R := k) x) = y}))
      ?_ ?_ ?_ ?_ hx
    · rintro _ ⟨h, hh, rfl⟩
      apply Ideal.subset_span
      refine ⟨h - algebraMap k H (Coalgebra.counit (R := k) h), ⟨h, hh, rfl⟩, ?_⟩
      simp [TensorProduct.tmul_sub, TensorProduct.tmul_smul, Algebra.TensorProduct.one_def,
        Algebra.algebraMap_eq_smul_one]
    · simp
    · intro a b _ _ ha hb
      have e : (a + b) - algebraMap K (K ⊗[k] H) (Coalgebra.counit (R := K) (a + b)) =
          (a - algebraMap K (K ⊗[k] H) (Coalgebra.counit (R := K) a)) +
            (b - algebraMap K (K ⊗[k] H) (Coalgebra.counit (R := K) b)) := by
        rw [map_add, map_add]; ring
      rw [e]; exact add_mem ha hb
    · intro c a _ ha
      have e : c • a - algebraMap K (K ⊗[k] H) (Coalgebra.counit (R := K) (c • a)) =
          algebraMap K (K ⊗[k] H) c *
            (a - algebraMap K (K ⊗[k] H) (Coalgebra.counit (R := K) a)) := by
        rw [map_smul, smul_eq_mul, map_mul, Algebra.smul_def]; ring
      rw [e]; exact Ideal.mul_mem_left _ _ ha
  · rw [Ideal.span_le]
    rintro _ ⟨_, ⟨h, hh, rfl⟩, rfl⟩
    apply Ideal.subset_span
    refine ⟨(1 : K) ⊗ₜ[k] h, one_tmul_mem_torusGrading K π hh, ?_⟩
    simp [TensorProduct.tmul_sub, TensorProduct.tmul_smul, Algebra.TensorProduct.one_def,
      Algebra.algebraMap_eq_smul_one]

omit [DecidableEq X] in
/-- **Monogenicity base changes**: if `H/I = k[ȳ]` then `(K ⊗ H)/(K ⊗ I) = K[1 ⊗ ȳ]`. -/
theorem monogenic_baseChange {I : Ideal H} {J : Ideal (K ⊗[k] H)}
    (hJ : J = I.map (Algebra.TensorProduct.includeRight : H →ₐ[k] K ⊗[k] H)) {y : H}
    (hy : Function.Surjective (Polynomial.aeval (R := k) (Ideal.Quotient.mk I y))) :
    Function.Surjective (Polynomial.aeval (R := K) (Ideal.Quotient.mk J ((1 : K) ⊗ₜ[k] y))) := by
  subst hJ
  set J := I.map (Algebra.TensorProduct.includeRight : H →ₐ[k] K ⊗[k] H)
  let φ : H ⧸ I →ₐ[k] (K ⊗[k] H) ⧸ J :=
    Ideal.quotientMapₐ J (Algebra.TensorProduct.includeRight : H →ₐ[k] K ⊗[k] H)
      Ideal.le_comap_map
  have hφ : ∀ h : H, φ (Ideal.Quotient.mk I h) = Ideal.Quotient.mk J ((1 : K) ⊗ₜ[k] h) :=
    fun h => rfl
  have key : ∀ h : H, ∃ q : Polynomial K,
      Polynomial.aeval (Ideal.Quotient.mk J ((1 : K) ⊗ₜ[k] y)) q =
        Ideal.Quotient.mk J ((1 : K) ⊗ₜ[k] h) := by
    intro h
    obtain ⟨p, hp⟩ := hy (Ideal.Quotient.mk I h)
    refine ⟨p.map (algebraMap k K), ?_⟩
    rw [Polynomial.aeval_map_algebraMap, ← hφ, Polynomial.aeval_algHom_apply, hp, hφ]
  intro z
  obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective z
  induction w using TensorProduct.induction_on with
  | zero => exact ⟨0, by simp⟩
  | tmul s h =>
    obtain ⟨q, hq⟩ := key h
    refine ⟨s • q, ?_⟩
    have hs : s ⊗ₜ[k] h = s • ((1 : K) ⊗ₜ[k] h) := by
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    rw [map_smul, hq, hs]
    rfl
  | add a b ha hb =>
    obtain ⟨qa, hqa⟩ := ha
    obtain ⟨qb, hqb⟩ := hb
    exact ⟨qa + qb, by rw [map_add, hqa, hqb, map_add]⟩

omit [DecidableEq X] in
/-- **The torus base changes as a closed subgroup**: `ker π_K = K ⊗ ker π`. -/
theorem ker_torusBaseChange (hπ : Function.Surjective π) :
    RingHom.ker (torusBaseChange K π).toAlgHom =
      (RingHom.ker π.toAlgHom).map (Algebra.TensorProduct.includeRight : H →ₐ[k] K ⊗[k] H) := by
  have e : RingHom.ker (torusBaseChange K π).toAlgHom =
      RingHom.ker (Algebra.TensorProduct.map (AlgHom.id k K) π.toAlgHom) := by
    ext x
    rw [RingHom.mem_ker, RingHom.mem_ker]
    change (TauCeti.MonoidAlgebra.scalarTensorBialgEquiv k K (G := X))
      ((Bialgebra.TensorProduct.map (BialgHom.id K K) π) x) = 0 ↔ _
    have hinj := (TauCeti.MonoidAlgebra.scalarTensorBialgEquiv k K (G := X)).injective
    have hm : (Bialgebra.TensorProduct.map (BialgHom.id K K) π) x =
        (Algebra.TensorProduct.map (AlgHom.id k K) π.toAlgHom) x := rfl
    rw [hm]
    exact ⟨fun h0 => hinj (h0.trans (map_zero _).symm), fun h0 => by rw [h0, map_zero]⟩
  rw [e, Algebra.TensorProduct.lTensor_ker _ hπ]

end BaseChangeAux

variable {k : Type u} {H : Type u} {X : Type u}
variable [Field k] [IsAlgClosed k] [CommRing H] [HopfAlgebra k H] [CommGroup X] [DecidableEq X]
variable [Algebra.FiniteType k H]
variable [Module.Finite k (Bialgebra.CotangentSpace k H)]

/-- **(i)** `Z_G(T) = T`. -/
def CondI (π : H →ₐc[k] MonoidAlgebra k X) : Prop :=
  magnetIdeal (torusGrading π) ⊥ = RingHom.ker π.toAlgHom

/-- **(ii′)** every root space is a line, and `Φ ∩ ℚα = {±α}`. -/
def CondII (π : H →ₐc[k] MonoidAlgebra k X) : Prop :=
  ∀ α ∈ roots π,
    Module.finrank k (Derivation.adjointWeightSpace π (Additive.toMul α)) = 1 ∧
    ∀ β ∈ roots π, (∃ m n : ℤ, n ≠ 0 ∧ n • β = m • α) → β = α ∨ β = -α

/-- **(iii)** Weyl elements: for every root `α`, a `k`-point of `G^{ℤα}` normalizing `T` and
acting on `X` by `σ` with `σ(α) = -α`. -/
def CondIII (π : H →ₐc[k] MonoidAlgebra k X) : Prop :=
  ∀ α ∈ roots π, ∃ (n : WithConv (H →ₐ[k] k)) (σ : X ≃* X), IsNormalizingWith π k n σ ∧
    n ∈ attractorSubgroup π (lineMagnet α) k ∧ σ (Additive.toMul α) = (Additive.toMul α)⁻¹

/-- (iii) gives condition (R1) (the body of `R1Property` in `R1FromReductive.lean` and of
`HypR1` in `FromR1R2.lean`). -/
theorem CondIII.r1 [Module.IsTorsionFree ℤ (Additive X)] {π : H →ₐc[k] MonoidAlgebra k X}
    (h : CondIII π) :
    ∀ α ∈ roots π, ∃ (n : WithConv (H →ₐ[k] k)) (σ : X ≃* X), IsNormalizingWith π k n σ ∧
      n ∈ attractorSubgroup π (lineMagnet α) k ∧ σ ≠ 1 := by
  intro α hα
  obtain ⟨n, σ, hn, hmem, hσ⟩ := h α hα
  refine ⟨n, σ, hn, hmem, ?_⟩
  rintro rfl
  have h1 : Additive.toMul α = (Additive.toMul α)⁻¹ := hσ
  have h2 : (2 : ℤ) • α = 0 := by
    rw [two_zsmul]
    apply Additive.toMul.injective
    rw [toMul_add, toMul_zero]
    nth_rewrite 1 [h1]
    exact inv_mul_cancel _
  exact ne_zero_of_mem_roots hα ((smul_eq_zero_iff_right two_ne_zero).mp h2)

/-- (ii′) gives (R2′) over `k`: `O(U_α)` is monogenic for every root `α`
(via `RankOne.finrank_rootSpace_eq_one_and_reduced_iff`, `RootSpaceDimAlt.lean`). -/
theorem CondII.monogenic [Algebra.Smooth k H] [Module.IsTorsionFree ℤ (Additive X)]
    {π : H →ₐc[k] MonoidAlgebra k X} (h : CondII π) {α : Additive X} (hα : α ∈ roots π)
    (hα' : ∀ n : ℕ, n • α = 0 → n = 0) :
    ∃ y : H, Function.Surjective
      (Polynomial.aeval (R := k) (Ideal.Quotient.mk (rootGroupIdeal π α hα').toIdeal y)) := by
  have hα0 : α ≠ 0 := ne_zero_of_mem_roots hα
  rw [← RankOne.finrank_rootSpace_eq_one_and_reduced_iff hα' hα]
  refine ⟨?_, fun n hn hmem => ?_⟩
  · rw [finrank_rootSpace_eq_finrank_adjointWeightSpace]
    exact (h α hα).1
  · have hpm := (h α hα).2 (n • α) hmem ⟨n, 1, one_ne_zero, by rw [one_smul, natCast_zsmul]⟩
    rcases hpm with e | e
    · have h0 : ((n : ℤ) - 1) • α = 0 := by
        rw [sub_smul, natCast_zsmul, e, one_smul, sub_self]
      have := (smul_eq_zero_iff_left hα0).mp h0
      omega
    · have h0 : ((n : ℤ) + 1) • α = 0 := by
        rw [add_smul, natCast_zsmul, e, one_smul, neg_add_cancel]
      have := (smul_eq_zero_iff_left hα0).mp h0
      omega

/-- (ii′) gives (R2′) over `k̄` (the body of `HypR2`, FromR1R2.lean): `O(U_α)` of `G_{k̄}` is
monogenic, generated by `1 ⊗ y` (`prescribedUnitIdeal_baseChange`, `monogenic_baseChange`). -/
theorem CondII.monogenic_bar [Algebra.Smooth k H] [Module.IsTorsionFree ℤ (Additive X)]
    {π : H →ₐc[k] MonoidAlgebra k X} (h : CondII π) (α : Additive X)
    (hα : α ∈ roots (piBar π)) :
    ∃ y : AlgebraicClosure k ⊗[k] H, Function.Surjective
      (Polynomial.aeval (R := AlgebraicClosure k) (Ideal.Quotient.mk
        (rootGroupIdeal (piBar π) α (nsmul_eq_zero_of_mem_roots hα)).toIdeal y)) := by
  have hα0 : α ∈ roots π := by rw [← roots_piBar π]; exact hα
  obtain ⟨y, hy⟩ := h.monogenic hα0 (nsmul_eq_zero_of_mem_roots hα0)
  refine ⟨(1 : AlgebraicClosure k) ⊗ₜ[k] y, monogenic_baseChange _ ?_ hy⟩
  rw [rootGroupIdeal, rootGroupIdeal, prescribedUnitHopfIdeal_toIdeal,
    prescribedUnitHopfIdeal_toIdeal, prescribedUnitIdeal_baseChange]

/-- (ii′) base changes to `k̄`. -/
theorem CondII.bar [Algebra.Smooth k H] [Module.IsTorsionFree ℤ (Additive X)]
    {π : H →ₐc[k] MonoidAlgebra k X} (h : CondII π) : CondII (piBar π) := by
  intro α hα
  refine ⟨?_, fun β hβ hdep => ?_⟩
  · obtain ⟨y, hy⟩ := h.monogenic_bar α hα
    rw [← finrank_rootSpace_eq_finrank_adjointWeightSpace]
    exact ((RankOne.finrank_rootSpace_eq_one_and_reduced_iff
      (nsmul_eq_zero_of_mem_roots hα) hα).mpr ⟨y, hy⟩).1
  · rw [roots_piBar] at hα hβ
    exact (h α hα).2 β hβ hdep

/-- (i) base changes to `k̄`. -/
theorem CondI.bar {π : H →ₐc[k] MonoidAlgebra k X} (hπ : Function.Surjective π)
    (h : CondI π) : CondI (piBar π) := by
  unfold CondI at h ⊢
  rw [magnetIdeal_baseChange, h, ker_torusBaseChange _ _ hπ]

/-- (iii) base changes to `k̄` (as `hypR1_bar`, FromR1R2.lean). -/
theorem CondIII.bar {π : H →ₐc[k] MonoidAlgebra k X} (hπ : Function.Surjective π)
    (h : CondIII π) : CondIII (piBar π) := by
  intro α hα
  rw [roots_piBar] at hα
  obtain ⟨n, σ, hn, hnα, hσ⟩ := h α hα
  have hn' := isNormalizingWith_bar hn
  exact ⟨_, σ, hn', (mem_lineAttractor_iff (torusBaseChange_surjective _ hπ) hn' α).2
    ((mem_lineAttractor_iff hπ hn α).1 hnα), hσ⟩

/-- **(i), (ii′), (iii) base change to `k̄`** — the input of (⇐), since Tau Ceti's reductivity
is a condition on `G_{k̄}`. -/
theorem conds_bar [Algebra.Smooth k H] [Module.IsTorsionFree ℤ (Additive X)]
    {π : H →ₐc[k] MonoidAlgebra k X} (hπ : Function.Surjective π)
    (h : CondI π ∧ CondII π ∧ CondIII π) :
    CondI (piBar π) ∧ CondII (piBar π) ∧ CondIII (piBar π) :=
  ⟨h.1.bar hπ, h.2.1.bar, h.2.2.bar hπ⟩

/-- **(⇒), geometric input (DC)**: for some cocharacter `λ` nonzero on the roots,
`dim Lie G ≤ dim Lie T + #{rays of λ-positive roots} + #{rays of λ-negative roots}`
(classically `dim G = dim T + |Φ|`). Math: `dim G = dim Q_y + dim Y` with `Q_y ⊇ T·U(−λ)`
solvable and `dim Y = |Ψ⁺| = dim U(λ)` (`V = 1` from `M_u = 1`: cores-B2G2.md Theorem K,
O1-O2.md Prop 1.2; rank2-L2.md Theorem A; S-proof.md Prop 6.1′). Needs the flag-variety orbit
`Y`: not formalized; it is the explicit hypothesis `hDC` of the (⇒) theorems below. -/
def DimCountInput (π : H →ₐc[k] MonoidAlgebra k X) (hπ : Function.Surjective π) : Prop :=
    ∃ ψ : X →* Multiplicative ℤ, (∀ α ∈ roots π, pairingHom ψ α ≠ 0) ∧
      Module.finrank k (Derivation k H (Bialgebra.CounitAlgebra k H k)) ≤
        Module.finrank k (Bialgebra.CotangentSpace k (H ⧸ (HopfIdeal.kerOfSurjective π hπ).toIdeal)) +
          posRays π (pairingHom ψ) + posRays π (-pairingHom ψ)

/-- **(⇒), the consequences of (DC)**: (i) and `dim U(±λ) ≤ #rays` for a generic `λ`
(`condI_and_counts_of_dimCount`, DimensionCount.lean). -/
theorem condI_and_counts_of_reductive [Module.IsTorsionFree ℤ (Additive X)]
    (π : H →ₐc[k] MonoidAlgebra k X) (hπ : Function.Surjective π)
    (hT : HopfIdeal.IsMaximalTorus k (CommHopfAlgCat.of k H) (HopfIdeal.kerOfSurjective π hπ))
    (hred : reductiveCommHopfAlgProperty k (FiniteTypeCommHopfAlgCat.of k H))
    (hDC : DimCountInput π hπ) :
    ∃ ψ : X →* Multiplicative ℤ, (∀ α ∈ roots π, pairingHom ψ α ≠ 0) ∧ CondI π ∧
      posDim π (pairingHom ψ) ≤ posRays π (pairingHom ψ) ∧
      posDim π (-pairingHom ψ) ≤ posRays π (-pairingHom ψ) := by
  have : Algebra.Smooth k H := hred.smooth
  have : Algebra.FiniteType k (MonoidAlgebra k X) :=
    Algebra.FiniteType.of_surjective π.toAlgHom hπ
  haveI : Monoid.FG X := MonoidAlgebra.fg_of_finiteType (R := k)
  haveI : Module.Finite ℤ (Additive X) :=
    Module.Finite.iff_addGroup_fg.2 (AddGroup.fg_iff_addMonoid_fg.2
      (Monoid.fg_iff_add_fg.1 inferInstance))
  haveI : Module.Free ℤ (Additive X) := Module.free_of_finite_type_torsion_free'
  haveI : IsAddTorsionFree (Additive X) := .of_isTorsionFree ℤ (Additive X)
  haveI : IsMulTorsionFree X :=
    ⟨fun n hn => IsAddTorsionFree.nsmul_right_injective (M := Additive X) hn⟩
  haveI : ConnectedSpace (PrimeSpectrum H) :=
    connectedSpace_of_geometricallyConnected k H hred.geometricallyConnected
  haveI : IrreducibleSpace (PrimeSpectrum H) := OpenCellNotes.irreducibleSpace_of_connectedSpace k
  obtain ⟨ψ, hψ, hDC⟩ := hDC
  obtain ⟨h1, h2, h3⟩ := condI_and_counts_of_dimCount π hπ ψ hψ hDC
  exact ⟨ψ, hψ, h1, h2, h3⟩

/-- **(⇒), (i)** `Z_G(T) = T`, from (DC). -/
theorem condI_of_reductive [Module.IsTorsionFree ℤ (Additive X)] (π : H →ₐc[k] MonoidAlgebra k X)
    (hπ : Function.Surjective π)
    (hT : HopfIdeal.IsMaximalTorus k (CommHopfAlgCat.of k H) (HopfIdeal.kerOfSurjective π hπ))
    (hred : reductiveCommHopfAlgProperty k (FiniteTypeCommHopfAlgCat.of k H))
    (hDC : DimCountInput π hπ) :
    CondI π :=
  (condI_and_counts_of_reductive π hπ hT hred hDC).choose_spec.2.1

/-- **Split reductive data over an algebraically closed `k`** from (i): `W` the image of
`N_G(T)(k)` (as `barData`, FromR1R2.lean, with `k̄` mapped back to `k`). -/
def algClosedData (π : H →ₐc[k] MonoidAlgebra k X) (hπ : Function.Surjective π)
    (hZ : magnetIdeal (torusGrading π) ⊥ = RingHom.ker π.toAlgHom) [Monoid.FG X] :
    SplitReductiveData π where
  surjective := hπ
  W := weylGroup π k
  finite := by
    haveI : Group.FG X := Group.fg_iff_monoid_fg.mpr inferInstance
    exact (finite_weylImage π hπ k).to_subtype
  rep w := Classical.choose w.2
  rep_normalizing w := Classical.choose_spec w.2
  normalizer_cover g σ hg := by
    let φ : AlgebraicClosure k →ₐ[k] k := IsAlgClosed.lift
    have hσ : σ ∈ weylGroup π k := ⟨_, IsNormalizingWith.mapValue π φ hg⟩
    refine ⟨hσ, ?_⟩
    have hr : IsNormalizingWith π (AlgebraicClosure k)
        (toAlgClosure (Classical.choose hσ)) σ :=
      IsNormalizingWith.mapValue π _ (Classical.choose_spec hσ)
    obtain ⟨t, ht⟩ := exists_torus_of_normalizing_same hπ hZ hg hr
    exact ⟨t, ht⟩
  roots_stable w hw α hα := by
    obtain ⟨n, hn⟩ := hw
    exact mem_roots_of_isNormalizingWith π hn hα

/-- **(⇒), geometric input (R1)**: the rank-one Levi `G^{ℤα}` has a nontrivial Weyl element.
Math: rank2-L2.md Theorem A(iii) (the `T`-curve `Z_{α,y} ≅ P¹` has two `T`-fixed points, swapped
by `N_{G_α}(T)`; Lemma 1.2 of centralizer-via-Q.md) and O1 (every root ray is in `Ψ`). The repo
records this as the place where reductivity enters (`RankOneReflectionAlt.lean`, docstring).
Needs the flag-variety orbit `Y`: not formalized; it is the explicit hypothesis `hR1` of the (⇒)
theorems below. -/
def R1Input (π : H →ₐc[k] MonoidAlgebra k X) : Prop :=
    ∀ α ∈ roots π, ∃ (n : WithConv (H →ₐ[k] k)) (σ : X ≃* X), IsNormalizingWith π k n σ ∧
      n ∈ attractorSubgroup π (lineMagnet α) k ∧ σ ≠ 1

/-- **(⇒), (iii)** Weyl elements, from (R1) and (i): a nontrivial Weyl element of `G^{ℤα}` is a
reflection at `α` (`isReflectionOn_of_mem_lineAttractor`, RankOneReflectionAlt.lean). -/
theorem condIII_of_reductive [Module.IsTorsionFree ℤ (Additive X)] (π : H →ₐc[k] MonoidAlgebra k X)
    (hπ : Function.Surjective π)
    (hT : HopfIdeal.IsMaximalTorus k (CommHopfAlgCat.of k H) (HopfIdeal.kerOfSurjective π hπ))
    (hred : reductiveCommHopfAlgProperty k (FiniteTypeCommHopfAlgCat.of k H))
    (hDC : DimCountInput π hπ) (hR1 : R1Input π) :
    CondIII π := by
  have : Algebra.FiniteType k (MonoidAlgebra k X) :=
    Algebra.FiniteType.of_surjective π.toAlgHom hπ
  haveI : Monoid.FG X := MonoidAlgebra.fg_of_finiteType (R := k)
  let D := algClosedData π hπ (condI_of_reductive π hπ hT hred hDC)
  intro α hα
  obtain ⟨n, σ, hn, hnα, hσ⟩ := hR1 α hα
  have hrefl := isReflectionOn_of_mem_lineAttractor D hα hn hnα hσ
  refine ⟨n, σ, hn, hnα, ?_⟩
  have := congrArg Additive.toMul hrefl.1
  simpa [actW] using this

/-- **(⇒), (ii′)** Root spaces are lines and `Φ ∩ ℚα = {±α}`: from the Weyl elements (iii) and the
counts given by (DC) (`condII_of_counting`, ForwardCounting.lean; S-proof.md Prop 6.1′). -/
theorem condII_of_reductive [Module.IsTorsionFree ℤ (Additive X)] (π : H →ₐc[k] MonoidAlgebra k X)
    (hπ : Function.Surjective π)
    (hT : HopfIdeal.IsMaximalTorus k (CommHopfAlgCat.of k H) (HopfIdeal.kerOfSurjective π hπ))
    (hred : reductiveCommHopfAlgProperty k (FiniteTypeCommHopfAlgCat.of k H))
    (hDC : DimCountInput π hπ) (hR1 : R1Input π) :
    CondII π := by
  obtain ⟨ψ, hψ, -, hD, hD'⟩ := condI_and_counts_of_reductive π hπ hT hred hDC
  refine condII_of_counting π (pairingHom ψ) hψ hD hD' ?_
  intro α hα
  obtain ⟨n, σ, hn, -, hσ⟩ := condIII_of_reductive π hπ hT hred hDC hR1 α hα
  exact ⟨n, σ, hn, hσ⟩

/-- **(⇒)** assembled. -/
theorem condI_condII_condIII_of_reductive [Module.IsTorsionFree ℤ (Additive X)] (π : H →ₐc[k] MonoidAlgebra k X)
    (hπ : Function.Surjective π)
    (hT : HopfIdeal.IsMaximalTorus k (CommHopfAlgCat.of k H) (HopfIdeal.kerOfSurjective π hπ))
    (hred : reductiveCommHopfAlgProperty k (FiniteTypeCommHopfAlgCat.of k H))
    (hDC : DimCountInput π hπ) (hR1 : R1Input π) :
    CondI π ∧ CondII π ∧ CondIII π :=
  ⟨condI_of_reductive π hπ hT hred hDC, condII_of_reductive π hπ hT hred hDC hR1,
    condIII_of_reductive π hπ hT hred hDC hR1⟩

/-- **(⇐), the core over `k̄`.** With (i), (ii′), (iii) at `π`, every connected normal smooth
unipotent closed subgroup of `G_{k̄}` is trivial. Math: equivalence.tex Theorem 5.1.
Assembly: A's `eq_augmentation_of_quotient_props_of_root` (ConverseCore.lean: `U ∩ T = e`, the
case `Lie U ⊆ 𝔤_0`, the bridge to a root space) and, for the root case, `le_of_root_group`
(`U_{±α} ⊆ U`), `exists_lie_rootSpace_conj` and `false_of_weylPoint` (WeylInNormal.lean). -/
theorem eq_augmentation_of_conds [Algebra.Smooth k H] [Module.IsTorsionFree ℤ (Additive X)]
    (π : H →ₐc[k] MonoidAlgebra k X) (hπ : Function.Surjective π)
    (hconn : geometricallyConnectedCommHopfAlgProperty k (CommHopfAlgCat.of k H))
    (h : CondI π ∧ CondII π ∧ CondIII π)
    (I : HopfIdeal (AlgebraicClosure k)
      (FiniteTypeCommHopfAlgCat.of (AlgebraicClosure k) (AlgebraicClosure k ⊗[k] H)))
    (hI : I.IsNormal)
    (hc : geometricallyConnectedCommHopfAlgProperty (AlgebraicClosure k)
      (FiniteTypeCommHopfAlgCat.quotient
        (FiniteTypeCommHopfAlgCat.of (AlgebraicClosure k) (AlgebraicClosure k ⊗[k] H)) I).obj)
    (hu : smoothUnipotentCommHopfAlgProperty (AlgebraicClosure k)
      (FiniteTypeCommHopfAlgCat.quotient
        (FiniteTypeCommHopfAlgCat.of (AlgebraicClosure k) (AlgebraicClosure k ⊗[k] H)) I)) :
    I = HopfIdeal.augmentation (AlgebraicClosure k)
      (FiniteTypeCommHopfAlgCat.of (AlgebraicClosure k) (AlgebraicClosure k ⊗[k] H)) := by
  set K := AlgebraicClosure k
  have hρ : Function.Surjective (piBar π) := torusBaseChange_surjective K hπ
  have hb := conds_bar hπ h
  have : Algebra.FiniteType k (MonoidAlgebra k X) :=
    Algebra.FiniteType.of_surjective π.toAlgHom hπ
  haveI : Monoid.FG X := MonoidAlgebra.fg_of_finiteType (R := k)
  haveI : IsAddTorsionFree (Additive X) := .of_isTorsionFree ℤ (Additive X)
  haveI : IsMulTorsionFree X := ⟨fun n hn => IsAddTorsionFree.nsmul_right_injective (M := Additive X) hn⟩
  haveI : Group.FG X := Group.fg_iff_monoid_fg.mpr inferInstance
  let D := barData hπ h.1
  haveI : ConnectedSpace (PrimeSpectrum (K ⊗[k] H)) := by
    have := hconn K
    let e := PrimeSpectrum.homeomorphOfRingEquiv
      (Algebra.TensorProduct.comm k H K).toRingEquiv
    exact e.surjective.connectedSpace e.continuous
  haveI : IrreducibleSpace (PrimeSpectrum (K ⊗[k] H)) :=
    OpenCellNotes.irreducibleSpace_of_connectedSpace K
  refine eq_augmentation_of_quotient_props_of_root (piBar π) hρ hb.1 I hI hc hu ?_
  intro hUT' α hα e he heα he0
  have hα' : ∀ n : ℕ, n • α = 0 → n = 0 := nsmul_eq_zero_of_mem_roots hα
  have hIh := isHomogeneous_of_isNormal (piBar π) hI
  have hIε : ∀ x ∈ I.toIdeal, Coalgebra.counit (R := K) x = 0 := fun x hx =>
    I.counit_eq_zero (by simpa using hx)
  have hUT := fun (g : WithConv (K ⊗[k] H →ₐ[K] K ⊗[K] MonoidAlgebra K X)) hgI hgT =>
    eq_one_of_kills_of_sup_eq (piBar π) hb.1 hUT' g hgI hgT
  -- `U_β ⊆ U` for a root `β` with a nonzero `d ∈ Lie U ∩ 𝔤_β`
  have hroot : ∀ β (hβ : β ∈ roots (piBar π)) (d : Derivation K (K ⊗[k] H)
      (Bialgebra.CounitAlgebra K (K ⊗[k] H) K)), (∀ x ∈ I.toIdeal, d x = 0) →
      d ∈ rootSpace (piBar π) β → d ≠ 0 →
      I.toIdeal ≤ prescribedUnitIdeal (piBar π) (rayMagnet β) := by
    intro β hβ d hdI hdβ hd0
    have hβ' : ∀ n : ℕ, n • β = 0 → n = 0 := nsmul_eq_zero_of_mem_roots hβ
    obtain ⟨y0, hy0⟩ := hb.2.1.monogenic hβ hβ'
    have hJ : IsRootGroup (piBar π) β (rootGroupIdeal (piBar π) β hβ') :=
      (RankOne.isRootGroup_iff_monogenic hβ' hβ).2 ⟨y0, hy0⟩
    obtain ⟨y, hy, hφ, -⟩ := hJ.ga
    have hJdef : (rootGroupIdeal (piBar π) β hβ').toIdeal = prescribedUnitIdeal (piBar π) (rayMagnet β) := by
      rw [rootGroupIdeal, prescribedUnitHopfIdeal_toIdeal]
    have hJε : ∀ x ∈ (rootGroupIdeal (piBar π) β hβ').toIdeal, Coalgebra.counit (R := K) x = 0 :=
      fun x hx => (rootGroupIdeal (piBar π) β hβ').counit_eq_zero (by simpa using hx)
    have h0 : ∀ x ∈ torusGrading (piBar π) 0,
        x - algebraMap K (K ⊗[k] H) (Coalgebra.counit (R := K) x) ∈
          I.toIdeal ⊔ magnetIdeal (torusGrading (piBar π)) ⊥ := by
      intro x _
      have hx : x - algebraMap K (K ⊗[k] H) (Coalgebra.counit (R := K) x) ∈
          (HopfIdeal.augmentation K (K ⊗[k] H)).toIdeal := by
        rw [HopfIdeal.mem_toIdeal, HopfIdeal.mem_augmentation, map_sub,
          Algebra.algebraMap_eq_smul_one, map_smul, Bialgebra.counit_one, smul_eq_mul, mul_one,
          sub_self]
      rw [← hUT', HopfIdeal.sup_toIdeal, magnetHopfIdeal_toIdeal] at hx
      exact hx
    have hsm : Algebra.Smooth K ((K ⊗[k] H) ⧸ I.toIdeal) :=
      ((smoothUnipotentCommHopfAlgProperty_iff K _).1 hu).1
    haveI : IsReduced ((K ⊗[k] H) ⧸ (I.toIdeal ⊔ (rootGroupIdeal (piBar π) β hβ').toIdeal)) := by
      rw [hJdef, sup_prescribedUnitIdeal_eq (piBar π) (rayMagnet_pointed hβ') hIh h0]
      have := smooth_quotient_sup_magnetIdeal_of_isNormal (piBar π) hI (rayMagnet β)
      exact isReduced_of_smooth K _
    have hdJ : ∀ x ∈ (rootGroupIdeal (piBar π) β hβ').toIdeal, d x = 0 := by
      have := (hJ.lie d).2 hdβ
      exact (HopfIdeal.mem_lieSubalgebra_iff _ d).1 this
    rw [← hJdef]
    exact le_of_root_group hβ' (isHomogeneous_rootGroupIdeal β hβ') hJε hy hφ hIh hIε d hdI hdJ hd0
  have heI : ∀ x ∈ I.toIdeal, e x = 0 := (HopfIdeal.mem_lieSubalgebra_iff _ e).1 he
  have hUα := hroot α hα e heI heα he0
  -- the Weyl point and `U_{-α} ⊆ U`
  obtain ⟨n, σ, hn, hnα, hσα⟩ := hb.2.2 α hα
  obtain ⟨e', he'I, he'α, he'0⟩ :=
    exists_lie_rootSpace_conj (piBar π) hI hn heI heα he0
  have hσα' : Additive.ofMul (σ (Additive.toMul α)) = -α := by
    rw [hσα]; rfl
  rw [hσα'] at he'α
  have hnegα : -α ∈ roots (piBar π) := by
    have := mem_roots_of_isNormalizingWith (piBar π) hn hα
    rwa [hσα'] at this
  have hUα' := hroot (-α) hnegα e' he'I he'α he'0
  exact false_of_weylPoint (piBar π) D hα (fun β hβ hdep => (hb.2.1 α hα).2 β hβ hdep)
    hI hUT hUα hUα' hn hnα hσα

/-- **(⇐)** (i), (ii′), (iii) imply reductivity: base change to `k̄` (`conds_bar`) and the core
`eq_augmentation_of_conds`. -/
theorem reductive_of_condI_condII_condIII [Module.IsTorsionFree ℤ (Additive X)]
    (π : H →ₐc[k] MonoidAlgebra k X)
    (hπ : Function.Surjective π)
    (hsmooth : Algebra.Smooth k H)
    (hconn : geometricallyConnectedCommHopfAlgProperty k (CommHopfAlgCat.of k H))
    (h : CondI π ∧ CondII π ∧ CondIII π) :
    reductiveCommHopfAlgProperty k (FiniteTypeCommHopfAlgCat.of k H) := by
  have := hsmooth
  rw [reductiveCommHopfAlgProperty_iff]
  refine ⟨hsmooth, hconn, fun I hI hc hu => ?_⟩
  exact eq_augmentation_of_conds π hπ hconn h I hI hc hu

/-- **Reductivity criterion** (both directions); (⇒) from the explicit inputs `hDC`, `hR1`. -/
theorem reductive_iff_condI_condII_condIII [Module.IsTorsionFree ℤ (Additive X)] (π : H →ₐc[k] MonoidAlgebra k X)
    (hπ : Function.Surjective π)
    (hT : HopfIdeal.IsMaximalTorus k (CommHopfAlgCat.of k H) (HopfIdeal.kerOfSurjective π hπ))
    (hsmooth : Algebra.Smooth k H)
    (hconn : geometricallyConnectedCommHopfAlgProperty k (CommHopfAlgCat.of k H))
    (hDC : DimCountInput π hπ) (hR1 : R1Input π) :
    reductiveCommHopfAlgProperty k (FiniteTypeCommHopfAlgCat.of k H) ↔
      CondI π ∧ CondII π ∧ CondIII π :=
  ⟨fun hred => condI_condII_condIII_of_reductive π hπ hT hred hDC hR1,
    reductive_of_condI_condII_condIII π hπ hsmooth hconn⟩

end AlgMag.Reductive

