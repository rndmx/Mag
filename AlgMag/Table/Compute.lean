/-!
# Table 1: computable root data and the column quantities

Everything here is plain structural recursion over `List Int` / `List Nat` (no well-founded
recursion, no `Finset`), so that each table entry `quantity G = n` is checked by the kernel with
`decide +kernel` (no `native_decide`, no extra axiom).

A root datum is given in coordinates of the character lattice `M = ℤⁿ` (`sr`: simple roots, rows)
and of the cocharacter lattice `M^∨ = ℤⁿ` (`sc`: simple coroots, rows), the pairing being the dot
product. `ofCartan A gens` builds it from the Cartan matrix `A` (`A i j = ⟨α_i, α_j^∨⟩`) and
generators of `M` in fundamental-weight coordinates (`Q ⊆ M ⊆ P`).

Columns (see `sections/torsion.tex`, `table/notes-columns.md`):
* `numRoots` = `|Φ|`, `numW` = `|W|` (Borel subgroups `⊇ T`), `numBases` = number of bases `wΔ`
  (magnets generated by a basis);
* `numParabolic` = number of distinct `w(Φ⁺ ∪ Φ_J)` (parabolic subsets), `parabolicFormula` =
  `Σ_J [W : W_J]`;
* `numFlats` = number of distinct `Φ ∩ span_ℚ S`, `S ⊆ Φ⁺` (flats = Levi subgroups `⊇ T`);
* `numJoinIrredWeylMagnets` = number of distinct `Z_w = (1 - w)M`;
* `numNonRed` = number of distinct non-redundant `Z_w`, i.e.
  `Z_w ≠ ℤ(Φ ∩ Z_w) + Σ_{Z_v ⊊ Z_w} Z_v`; `joinIrreduciblesCard = numRoots + numNonRed`;
* `nonRedPrimes` = primes `p` with a non-redundant `Z_w`, `w ≠ 1` of `p`-power order;
* `pi1Primes` = primes dividing `|π₁| = [M^∨ : ℤΦ^∨]`.
-/

namespace AlgMag.Table

abbrev Vec := List Int
abbrev Mat := List Vec

/-! ### Vectors and matrices -/

def dot : Vec → Vec → Int
  | a :: as, b :: bs => a * b + dot as bs
  | _, _ => 0

def vadd : Vec → Vec → Vec
  | a :: as, b :: bs => (a + b) :: vadd as bs
  | _, _ => []

def vsub : Vec → Vec → Vec
  | a :: as, b :: bs => (a - b) :: vsub as bs
  | _, _ => []

def smul (k : Int) (v : Vec) : Vec := v.map (k * ·)

def lin (s : Int) (a : Vec) (t : Int) (b : Vec) : Vec := vadd (smul s a) (smul t b)

def isZero (v : Vec) : Bool := v.all (· == 0)

def unitVec (n i : Nat) : Vec := (List.range n).map fun j => if j == i then 1 else 0

def idMat (n : Nat) : Mat := (List.range n).map (unitVec n)

def col (m : Mat) (j : Nat) : Vec := m.map fun r => r.getD j 0

def transpose (n : Nat) (m : Mat) : Mat := (List.range n).map (col m)

def mulVec (m : Mat) (v : Vec) : Vec := m.map (dot · v)

def matMul (n : Nat) (a b : Mat) : Mat :=
  let bt := transpose n b
  a.map fun r => bt.map (dot r)

def matSub : Mat → Mat → Mat
  | a :: as, b :: bs => vsub a b :: matSub as bs
  | _, _ => []

/-! ### Integer echelon form (with coefficient tracking) -/

/-- Extended Euclid with fuel: `(g, s, t)` with `s a + t b = g`. -/
def xgcdAux : Nat → Int → Int → Int → Int → Int → Int → Int × Int × Int
  | 0, r0, s0, t0, _, _, _ => (r0, s0, t0)
  | f + 1, r0, s0, t0, r1, s1, t1 =>
    if r1 == 0 then (r0, s0, t0) else
    let q := Int.ediv r0 r1
    xgcdAux f r1 s1 t1 (r0 - q * r1) (s0 - q * s1) (t0 - q * t1)

def xgcd (a b : Int) : Int × Int × Int :=
  match xgcdAux 128 a 1 0 b 0 1 with
  | (g, s, t) => if g < 0 then (-g, -s, -t) else (g, s, t)

/-- A row together with its coefficients in terms of the original generators. -/
abbrev Row := Vec × Vec

def rlin (s : Int) (a : Row) (t : Int) (b : Row) : Row := (lin s a.1 t b.1, lin s a.2 t b.2)

/-- Clear column `c` of `r` against the pivot candidate `p` (unimodular step). -/
def clear (c : Nat) (p r : Row) : Row × Row :=
  let x := p.1.getD c 0
  let y := r.1.getD c 0
  if y == 0 then (p, r) else
  match xgcd x y with
  | (g, s, t) => (rlin s p t r, rlin (Int.ediv x g) r (-(Int.ediv y g)) p)

/-- One column step: returns `(pivot?, remaining rows)`. -/
def colStep (c : Nat) : List Row → Option Row × List Row
  | [] => (none, [])
  | p :: rs =>
    let st := rs.foldl (fun (acc : Row × List Row) r =>
      match clear c acc.1 r with
      | (p', r') => (p', r' :: acc.2)) (p, [])
    let p' := st.1
    let rest := st.2.filter fun r => !isZero r.1
    let x := p'.1.getD c 0
    if x == 0 then (none, if isZero p'.1 then rest else p' :: rest)
    else if x < 0 then (some (smul (-1) p'.1, smul (-1) p'.2), rest)
    else (some p', rest)

/-- Echelon basis: list of `(pivot column, row)`; pivots strictly increasing, pivot entries
positive, entries of later rows at earlier pivot columns zero. -/
def echelonRows (n : Nat) (rows : List Row) : List (Nat × Row) :=
  ((List.range n).foldl (fun (acc : List (Nat × Row) × List Row) c =>
    match colStep c acc.2 with
    | (some p, rest) => ((c, p) :: acc.1, rest)
    | (none, rest) => (acc.1, rest)) ([], rows.filter fun r => !isZero r.1)).1.reverse

/-- Echelon basis of the lattice generated by `gens` (coefficients w.r.t. `gens`). -/
def echelon (n : Nat) (gens : Mat) : List (Nat × Row) :=
  echelonRows n ((List.range gens.length).zip gens |>.map fun (i, g) => (g, unitVec gens.length i))

/-- Reduce `x` modulo an echelon basis: `(remainder, quotients)`. -/
def reduce (B : List (Nat × Row)) (x : Vec) : Vec × List Int :=
  let st := B.foldl (fun (acc : Vec × List Int) (b : Nat × Row) =>
    let q := Int.ediv (acc.1.getD b.1 0) (b.2.1.getD b.1 0)
    (vsub acc.1 (smul q b.2.1), q :: acc.2)) (x, [])
  (st.1, st.2.reverse)

def memB (B : List (Nat × Row)) (x : Vec) : Bool := isZero (reduce B x).1

/-- `x ∈ ℤ gens`. -/
def memL (n : Nat) (gens : Mat) (x : Vec) : Bool := memB (echelon n gens) x

/-- `ℤ a ⊆ ℤ b`. -/
def leL (n : Nat) (a b : Mat) : Bool := let B := echelon n b; a.all (memB B)

def rankQ (n : Nat) (gens : Mat) : Nat := (echelon n gens).length

/-- `x ∈ ℚ gens`. -/
def memQ (n : Nat) (gens : Mat) (x : Vec) : Bool := rankQ n (x :: gens) == rankQ n gens

/-! ### Determinants (Laplace; only used in small rank) -/

def dropAt : Nat → Vec → Vec
  | _, [] => []
  | 0, _ :: as => as
  | k + 1, a :: as => a :: dropAt k as

def detAux : Nat → Mat → Int
  | 0, _ => 1
  | _ + 1, [] => 1
  | f + 1, r :: rs =>
    ((List.range r.length).zip r).foldl (fun acc (j, a) =>
      let minor := rs.map (dropAt j)
      let s : Int := if j % 2 == 0 then 1 else -1
      acc + s * a * detAux f minor) 0

def det (m : Mat) : Int := detAux m.length m

/-! ### Small number theory -/

def isPrimeB (p : Nat) : Bool := 2 ≤ p && (List.range p).all fun d => d < 2 || p % d != 0

/-- Primes dividing `m` (`m ≠ 0`), increasing. -/
def primesOf (m : Nat) : List Nat := (List.range (m + 1)).filter fun p => isPrimeB p && m % p == 0

/-- `some p` if `m = p^k` with `k ≥ 1`, else `none`. -/
def primePowerBase (m : Nat) : Option Nat :=
  match primesOf m with
  | [p] => some p
  | _ => none

/-- Insert into a strictly increasing list (dedup). -/
def insertSorted (x : Nat) : List Nat → List Nat
  | [] => [x]
  | y :: ys => if x < y then x :: y :: ys else if x == y then y :: ys else y :: insertSorted x ys

def dedupNat (l : List Nat) : List Nat := l.foldl (fun acc x => insertSorted x acc) []

def bit (i : Nat) : Nat := Nat.shiftLeft 1 i

def maskOf (l : List Nat) : Nat := l.foldl (fun acc i => acc ||| bit i) 0

def testBit (m i : Nat) : Bool := (Nat.shiftRight m i) % 2 == 1

/-- Index of `x` in `l` (or `l.length`). -/
def idxOf {α : Type} [BEq α] (x : α) : List α → Nat
  | [] => 0
  | y :: ys => if x == y then 0 else idxOf x ys + 1

/-! ### Root data -/

structure RD where
  n : Nat
  /-- Cartan matrix `A i j = ⟨α_i, α_j^∨⟩`. -/
  cartan : Mat
  /-- Simple roots in `M`-coordinates. -/
  sr : Mat
  /-- Simple coroots in `M^∨`-coordinates. -/
  sc : Mat

/-- Root datum from a Cartan matrix and generators of `M` (`Q ⊆ M ⊆ P`) in fundamental-weight
coordinates. A `ℤ`-basis `B` of `M` is computed; `α_i` are the coefficients of row `i` of `A`
in `B`, and `α_j^∨` (in the dual basis) is column `j` of `B`. -/
def ofCartan (A : Mat) (gens : Mat) : RD :=
  let n := A.length
  let B := (echelon n gens).map fun b => b.2.1
  let EB := echelon n B
  { n, cartan := A, sr := A.map fun a => (reduce EB a).2, sc := transpose n B }

/-- The pairing matrix `⟨α_i, α_j^∨⟩`. -/
def RD.pairing (G : RD) : Mat := G.sr.map fun a => G.sc.map (dot a)

/-- `[M : ℤΦ]` and `[M^∨ : ℤΦ^∨] = |π₁|`. -/
def RD.indexQ (G : RD) : Int := det G.sr
def RD.indexCoroots (G : RD) : Int := det G.sc

/-- Simple reflection `s_i` on `M` as a matrix: `x ↦ x - ⟨x, α_i^∨⟩ α_i`. -/
def RD.refl (G : RD) (i : Nat) : Mat :=
  let a := G.sr.getD i []
  let c := G.sc.getD i []
  (List.range G.n).map fun r => (List.range G.n).map fun k =>
    (if r == k then 1 else 0) - a.getD r 0 * c.getD k 0

/-- Breadth-first closure of `{1}` under left multiplication by `gens`. -/
def closeAux (n : Nat) (gens : List Mat) : Nat → List Mat → List Mat → List Mat
  | 0, seen, _ => seen
  | f + 1, seen, frontier =>
    let st := frontier.foldl (fun (acc : List Mat × List Mat) g =>
      gens.foldl (fun (acc : List Mat × List Mat) s =>
        let h := matMul n s g
        if acc.1.contains h then acc else (h :: acc.1, h :: acc.2)) acc) (seen, [])
    if st.2.isEmpty then st.1 else closeAux n gens f st.1 st.2

/-- The Weyl group, as matrices on `M`. -/
def RD.weyl (G : RD) : List Mat :=
  (closeAux G.n ((List.range G.n).map G.refl) 200 [idMat G.n] [idMat G.n]).reverse

/-- A root: coordinates in the simple roots, in `M`, and its coroot in `M^∨`. -/
abbrev Root := Vec × Vec × Vec

def RD.reflRoot (G : RD) (i : Nat) (r : Root) : Root :=
  let a := G.sr.getD i []
  let c := G.sc.getD i []
  let k := dot r.2.1 c
  let l := dot a r.2.2
  (vsub r.1 (smul k (unitVec G.n i)), vsub r.2.1 (smul k a), vsub r.2.2 (smul l c))

def rootsAux (step : Root → List Root) : Nat → List Root → List Root → List Root
  | 0, seen, _ => seen
  | f + 1, seen, frontier =>
    let st := frontier.foldl (fun (acc : List Root × List Root) r =>
      (step r).foldl (fun (acc : List Root × List Root) s =>
        if acc.1.any (fun t => t.1 == s.1) then acc else (s :: acc.1, s :: acc.2)) acc) (seen, [])
    if st.2.isEmpty then st.1 else rootsAux step f st.1 st.2

def RD.simpleRoots (G : RD) : List Root :=
  (List.range G.n).map fun i => (unitVec G.n i, G.sr.getD i [], G.sc.getD i [])

/-- All roots (with coroots), as the `W`-orbit of the simple roots. -/
def RD.roots (G : RD) : List Root :=
  (rootsAux (fun r => (List.range G.n).map (G.reflRoot · r)) 200 G.simpleRoots
    G.simpleRoots).reverse

/-- Roots in `M`-coordinates. -/
def RD.rootsM (G : RD) : Mat := G.roots.map fun r => r.2.1

/-- Roots in simple-root coordinates. -/
def RD.rootsQ (G : RD) : Mat := G.roots.map fun r => r.1

def isPos (v : Vec) : Bool := v.all (0 ≤ ·)

/-- Permutation of root indices induced by a matrix on `M`. -/
def RD.perm (G : RD) (rM : Mat) (w : Mat) : List Nat := rM.map fun x => idxOf (mulVec w x) rM

/-! ### Columns -/

def RD.numRoots (G : RD) : Nat := G.roots.length

def RD.numW (G : RD) : Nat := G.weyl.length

/-- Number of distinct bases `w Δ` (as sets of roots). -/
def RD.numBases (G : RD) : Nat :=
  let rM := G.rootsM
  let simple := (List.range G.n).map fun i => idxOf (G.sr.getD i []) rM
  (dedupNat (G.weyl.map fun w => let p := G.perm rM w; maskOf (simple.map (p.getD · 0)))).length

def subsetsOf : List Nat → List (List Nat)
  | [] => [[]]
  | x :: xs => let s := subsetsOf xs; s ++ s.map (x :: ·)

/-- `Φ⁺ ∪ Φ_J` as a list of root indices. -/
def RD.stdParabolic (G : RD) (J : List Nat) : List Nat :=
  let rQ := G.rootsQ
  ((List.range rQ.length).zip rQ).filterMap fun (k, v) =>
    if isPos v || ((List.range G.n).all fun i => J.contains i || v.getD i 0 == 0) then some k
    else none

/-- Number of distinct parabolic subsets `w(Φ⁺ ∪ Φ_J)`. -/
def RD.numParabolic (G : RD) : Nat :=
  let rM := G.rootsM
  let perms := G.weyl.map (G.perm rM)
  let stds := (subsetsOf (List.range G.n)).map G.stdParabolic
  (dedupNat (perms.flatMap fun p => stds.map fun s => maskOf (s.map (p.getD · 0)))).length

/-- `Σ_{J ⊆ Δ} [W : W_J]`. -/
def RD.parabolicFormula (G : RD) : Nat :=
  let w := G.numW
  ((subsetsOf (List.range G.n)).map fun J =>
    w / (closeAux G.n (J.map G.refl) 200 [idMat G.n] [idMat G.n]).length).foldl (· + ·) 0

def subsetsUpTo : Nat → List Vec → List Mat
  | _, [] => [[]]
  | 0, _ => [[]]
  | k + 1, x :: xs => subsetsUpTo (k + 1) xs ++ (subsetsUpTo k xs).map (x :: ·)

/-- Number of flats `Φ ∩ span_ℚ S` (`S ⊆ Φ⁺`, `|S| ≤ rank`) = Levi subgroups `⊇ T`. -/
def RD.numFlats (G : RD) : Nat :=
  let rQ := G.rootsQ
  let pos := rQ.filter isPos
  (dedupNat ((subsetsUpTo G.n pos).map fun S =>
    maskOf (((List.range rQ.length).zip rQ).filterMap fun (k, v) =>
      if memQ G.n S v then some k else none))).length

/-- Number of distinct standard-Levi conjugates `w Φ_J` (cross-check of `numFlats`). -/
def RD.numLeviConj (G : RD) : Nat :=
  let rM := G.rootsM
  let rQ := G.rootsQ
  let perms := G.weyl.map (G.perm rM)
  let stds := (subsetsOf (List.range G.n)).map fun J =>
    ((List.range rQ.length).zip rQ).filterMap fun (k, v) =>
      if (List.range G.n).all (fun i => J.contains i || v.getD i 0 == 0) then some k else none
  (dedupNat (perms.flatMap fun p => stds.map fun s => maskOf (s.map (p.getD · 0)))).length

/-- Generators of `Z_w = (1 - w)M`: the columns of `1 - w`. -/
def RD.zgens (G : RD) (w : Mat) : Mat := transpose G.n (matSub (idMat G.n) w)

/-- Distinct Weyl magnets: list of `(representative w, generators)`. -/
def RD.joinIrredWeylReps (G : RD) : List (Mat × Mat) :=
  (G.weyl.foldl (fun (acc : List (Mat × Mat)) w =>
    let z := G.zgens w
    if acc.any (fun p => leL G.n z p.2 && leL G.n p.2 z) then acc else (w, z) :: acc) []).reverse

def RD.numJoinIrredWeylMagnets (G : RD) : Nat := G.joinIrredWeylReps.length

/-- Generators of `ℤ(Φ ∩ Z) + Σ_{Z_v ⊊ Z} Z_v`, `Z` given by generators `z`. -/
def RD.lowerGens (G : RD) (reps : List (Mat × Mat)) (z : Mat) : Mat :=
  let B := echelon G.n z
  G.rootsM.filter (memB B) ++
    reps.flatMap fun p => if p.2.all (memB B) && !(leL G.n z p.2) then p.2 else []

/-- `Z` (generators `z`) is non-redundant. -/
def RD.nonRed (G : RD) (reps : List (Mat × Mat)) (z : Mat) : Bool :=
  !(leL G.n z (G.lowerGens reps z))

def RD.nonRedReps (G : RD) : List (Mat × Mat) :=
  let reps := G.joinIrredWeylReps
  reps.filter fun p => G.nonRed reps p.2

def RD.numNonRed (G : RD) : Nat := G.nonRedReps.length

def RD.joinIrreduciblesCard (G : RD) : Nat := G.numRoots + G.numNonRed

/-- Order of `w` (fuel `64`). -/
def orderAux (n : Nat) (w : Mat) : Nat → Nat → Mat → Nat
  | 0, k, _ => k
  | f + 1, k, x => if x == idMat n then k else orderAux n w f (k + 1) (matMul n w x)

def RD.order (G : RD) (w : Mat) : Nat := orderAux G.n w 64 1 w

/-- Primes `p` such that some non-redundant `Z_w` has `w` of `p`-power order. -/
def RD.nonRedPrimes (G : RD) : List Nat :=
  let reps := G.joinIrredWeylReps
  let nr := (reps.filter fun p => G.nonRed reps p.2).map fun p => p.2
  dedupNat (G.weyl.filterMap fun w =>
    let z := G.zgens w
    if nr.any (fun y => leL G.n z y && leL G.n y z) then primePowerBase (G.order w) else none)

/-- Primes dividing `ord w` for `w` with `Z_w` non-redundant. -/
def RD.nonRedOrderPrimes (G : RD) : List Nat :=
  let reps := G.joinIrredWeylReps
  let nr := (reps.filter fun p => G.nonRed reps p.2).map fun p => p.2
  dedupNat (G.weyl.flatMap fun w =>
    let z := G.zgens w
    if nr.any (fun y => leL G.n z y && leL G.n y z) then primesOf (G.order w) else [])

/-- Primes dividing `|π₁| = [M^∨ : ℤΦ^∨]`. -/
def RD.pi1Primes (G : RD) : List Nat := primesOf G.indexCoroots.natAbs

end AlgMag.Table
