import AlgMag.Table.Groups

/-!
# Table 1: the computed `W` and `Φ` are closed

`RD.weylClosed`: the list `G.weyl` contains `1`, has no repetition, and is closed under left
multiplication by every simple reflection; hence it is the monoid (= group, the generators being
involutions of a finite set) generated by the simple reflections, i.e. the Weyl group acting
on `M`. `RD.rootsClosed`: the root list has no repetition (in simple-root coordinates), is closed
under the simple reflections, and contains the simple roots, so it is the `W`-orbit `Φ` of `Δ`.
Both checked by the kernel.
-/

namespace AlgMag.Table

def nodupB {α : Type} [BEq α] : List α → Bool
  | [] => true
  | a :: l => !l.contains a && nodupB l

def RD.weylClosed (G : RD) : Bool :=
  G.weyl.contains (idMat G.n) && nodupB G.weyl &&
    (List.range G.n).all fun i => G.weyl.all fun w => G.weyl.contains (matMul G.n (G.refl i) w)

def RD.rootsClosed (G : RD) : Bool :=
  nodupB G.rootsQ && G.simpleRoots.all (fun r => G.rootsQ.contains r.1) &&
    (List.range G.n).all fun i => G.roots.all fun r => G.rootsQ.contains (G.reflRoot i r).1

set_option maxRecDepth 100000

