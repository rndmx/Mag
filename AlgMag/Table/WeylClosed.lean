/-- Words in the generators `gens`, built by left multiplication on `1`. -/
inductive ReachG (n : Nat) (gens : List Mat) : Mat → Prop
  | one : ReachG n gens (idMat n)
  | step (s : Mat) (hs : s ∈ gens) (w : Mat) : ReachG n gens w → ReachG n gens (matMul n s w)

/-- The monoid generated by the simple reflections, as matrices on `M`. -/
abbrev RD.Gen (G : RD) : Mat → Prop := ReachG G.n ((List.range G.n).map G.refl)

theorem foldl_inv {α β : Type} (P : β → Prop) (f : β → α → β) :
    ∀ (l : List α) (b : β), P b → (∀ b a, a ∈ l → P b → P (f b a)) → P (l.foldl f b)
  | [], b, hb, _ => hb
  | a :: l, b, hb, h =>
    foldl_inv P f l (f b a) (h b a (by simp) hb) (fun b a' ha' => h b a' (by simp [ha']))

theorem closeAux_sound (n : Nat) (gens : List Mat) :
    ∀ (f : Nat) (seen frontier : List Mat), (∀ x ∈ seen, ReachG n gens x) →
      (∀ x ∈ frontier, ReachG n gens x) → ∀ x ∈ closeAux n gens f seen frontier, ReachG n gens x
  | 0, seen, _, hs, _ => by simpa [closeAux] using hs
  | f + 1, seen, frontier, hs, hf => by
    let P : List Mat × List Mat → Prop := fun acc =>
      (∀ x ∈ acc.1, ReachG n gens x) ∧ ∀ x ∈ acc.2, ReachG n gens x
    let inner : Mat → List Mat × List Mat → List Mat × List Mat := fun g acc =>
      gens.foldl (fun (acc : List Mat × List Mat) s =>
        let h := matMul n s g
        if acc.1.contains h then acc else (h :: acc.1, h :: acc.2)) acc
    have key : P (frontier.foldl (fun acc g => inner g acc) (seen, [])) := by
      refine foldl_inv P (fun acc g => inner g acc) frontier (seen, []) ⟨hs, by simp [P]⟩ ?_
      intro acc g hg hacc
      refine foldl_inv P (fun (acc : List Mat × List Mat) s =>
        let h := matMul n s g
        if acc.1.contains h then acc else (h :: acc.1, h :: acc.2)) gens acc hacc ?_
      intro acc' s hs' hacc'
      have hr : ReachG n gens (matMul n s g) := ReachG.step s hs' g (hf g hg)
      by_cases hc : acc'.1.contains (matMul n s g) = true
      · dsimp only
        rw [if_pos hc]; exact hacc'
      · dsimp only
        rw [if_neg hc]
        refine ⟨?_, ?_⟩
        · intro x hx; rcases List.mem_cons.1 hx with rfl | hx
          · exact hr
          · exact hacc'.1 x hx
        · intro x hx; rcases List.mem_cons.1 hx with rfl | hx
          · exact hr
          · exact hacc'.2 x hx
    unfold closeAux
    show ∀ x ∈ (if (frontier.foldl (fun acc g => inner g acc) (seen, [])).2.isEmpty then
        (frontier.foldl (fun acc g => inner g acc) (seen, [])).1 else
        closeAux n gens f (frontier.foldl (fun acc g => inner g acc) (seen, [])).1
          (frontier.foldl (fun acc g => inner g acc) (seen, [])).2), ReachG n gens x
    split
    · exact fun x hx => key.1 x hx
    · exact closeAux_sound n gens f _ _ key.1 key.2

theorem RD.weyl_sound (G : RD) : ∀ w ∈ G.weyl, G.Gen w := by
  intro w hw
  unfold RD.weyl at hw
  have := closeAux_sound G.n ((List.range G.n).map G.refl) 200 [idMat G.n] [idMat G.n]
    (by simp; exact ReachG.one) (by simp; exact ReachG.one)
  exact this w (List.mem_reverse.1 hw)

/-- If the check `weylClosed` succeeds, the computed list is exactly the set of words in the
simple reflections, i.e. the Weyl group (the generators are involutions of a finite set). -/
theorem RD.weyl_mem_iff_gen (G : RD) (h : G.weylClosed = true) : ∀ w, w ∈ G.weyl ↔ G.Gen w := by
  unfold RD.weylClosed at h
  simp only [Bool.and_eq_true, List.all_eq_true, List.mem_range, decide_eq_true_eq] at h
  obtain ⟨⟨h1, _⟩, h2⟩ := h
  have h1' : idMat G.n ∈ G.weyl := List.contains_iff_mem.1 h1
  intro w
  refine ⟨G.weyl_sound w, fun hw => ?_⟩
  induction hw with
  | one => exact h1'
  | step s hs w _ ih =>
    obtain ⟨i, hi, rfl⟩ := List.mem_map.1 hs
    exact List.contains_iff_mem.1 (h2 i (List.mem_range.1 hi) w ih)

theorem SO7_weyl_gen : ∀ w, w ∈ SO7.weyl ↔ SO7.Gen w := SO7.weyl_mem_iff_gen SO7_weylClosed
#print axioms SO7_weyl_gen

