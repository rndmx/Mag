import AlgMag.GeneralBase
import AlgMag.GeneralBaseCor

/-!
# Self-actions over an arbitrary base scheme: Proposition 2.1

Mayeux, *Algebraic magnetism invariants of self-actions of diagonalizable monoid schemes*,
Semigroup Forum 112 (2026) 532–540, doi:10.1007/s00233-025-10572-9 (the published version, read from
the publisher's PDF; numbering and quotations below are those of the journal).
§2, for an arbitrary scheme `S`. Here `X = 𝔸(L)_S` is `AlgMag.GB.A L S`, with the
action `AlgMag.GB.aAction L S` of `𝔸(M)_S`.

The statement of the journal, as an equality of schemes, is in `AlgMag.SelfActionsProp21`.

## Main results

* `attractorImage_self`: a point of `X` over `T` underlies a point of `X^N` iff it kills `L ∖ N`.
* `attractorPtEquivChars`, `attractorPtEquivSpec`: **Proposition 2.1**, `X^N = S ×_ℤ Spec(ℤ[L]/J_N)`.
* `magnetIdeal_chart`, `ker_iAtt_self`: **Proposition 2.1**, the closed subscheme: over an affine
  open of `S`, the ideal of `X^N` is generated by the `X^m`, `m ∈ L ∖ N`.
* `attractorImage_eq_iff`, `pureMagnets_scheme`: over `S ≠ ∅`, `X^N = X^{N'}` iff the monoid ideals
  agree, so `Π(a)` does not depend on `S`.
* `pureMagnets_empty_base`: over `S = ∅`, `Π(a) = {0}`.
* `isEmpty_Zatt_of_zero_mem`: `X^N` is empty if `J_N = 1`.
-/

suppress_compilation

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry Magnetism

open scoped Classical

set_option linter.unusedSectionVars false

universe u

namespace AlgMag.SelfActions

open AlgMag.GB

attribute [local instance] gradedAlgebraOf

variable {S : Scheme.{u}} {M : Type u} [AddCommMonoid M] (L : AddSubmonoid M)

section Sections

/-- A global section vanishes if it vanishes on open immersions covering the scheme. -/
lemma section_zero_of_local {T : Scheme.{u}} (s : Γ(T, ⊤))
    (H : ∀ x : T, ∃ (Z : Scheme.{u}) (ι : Z ⟶ T) (_ : IsOpenImmersion ι) (y : Z),
      ι y = x ∧ ι.appTop.hom s = 0) : s = 0 := by
  refine TopCat.Presheaf.section_ext T.sheaf ⊤ s 0 fun x hx => ?_
  obtain ⟨Z, ι, _, y, rfl, h⟩ := H x
  have hinj : Function.Injective (ι.stalkMap y) :=
    ((ConcreteCategory.isIso_iff_bijective _).mp inferInstance).1
  refine hinj ?_
  have h1 := Scheme.Hom.germ_stalkMap_apply ι ⊤ y hx s
  have h2 := Scheme.Hom.germ_stalkMap_apply ι ⊤ y hx 0
  refine h1.trans (Eq.trans ?_ h2.symm)
  congr 1
  rw [map_zero]
  exact h

/-- A scheme whose ring of global sections is trivial is empty. -/
lemma isEmpty_of_one_eq_zero {T : Scheme.{u}} (h : (1 : Γ(T, ⊤)) = 0) : IsEmpty T := by
  refine ⟨fun x => ?_⟩
  have h1 := congrArg (T.presheaf.germ ⊤ x trivial).hom h
  rw [map_one, map_zero] at h1
  exact one_ne_zero h1

end Sections

section Coord

variable {U : S.Opens} (hU : IsAffineOpen U)

/-- The coordinate `X^l` on the chart `p⁻¹ U` of `𝔸(L)_S`. -/
def coord (l : L) : Aalg (A L S) U :=
  (etaEquiv hU (Aalg (A L S) U)).symm
    (toGa hU (liesOver_Phi hU _) (pts _ (iotaX (A L S) hU)) (Multiplicative.ofAdd l))

lemma eta_coord (l : L) : eta hU (Aalg (A L S) U) (coord L hU l) =
    toGa hU (liesOver_Phi hU _) (pts _ (iotaX (A L S) hU)) (Multiplicative.ofAdd l) :=
  (etaEquiv hU (Aalg (A L S) U)).apply_symm_apply _

/-- For `t : T → 𝔸(L)_S` over `U`, the pullback of the coordinate `X^l` is the value of the monoid
map `L → Γ(T, ⊤)` attached to `t` at `l`. -/
lemma ptX_coord {T : Over S} (hT : LiesOver T U) (t : T ⟶ A L S) (l : L) :
    ptX (A L S) hU T hT t (coord L hU l) =
      toGa hU hT (pts T t) (Multiplicative.ofAdd l) := by
  let c := toChart (A L S) hU T hT t
  have hc : c ≫ iotaX (A L S) hU = t := (toChart (A L S) hU T hT).symm_apply_apply t
  have h1 : ptX (A L S) hU T hT t = homPhi hU T hT _ c := rfl
  have h2 := homPhi_comp hU (liesOver_Phi hU (Aalg (A L S) U)) hT c (𝟙 _)
  rw [Category.comp_id] at h2
  rw [h1, h2, AlgHom.comp_apply]
  change gpull hU _ hT c (eta hU (Aalg (A L S) U) (coord L hU l)) = _
  rw [eta_coord, ← hc, pts_comp]
  rfl

/-- The coordinate `X^l` is homogeneous of degree `l`. -/
lemma coord_mem (l : L) : coord L hU l ∈ gradingOf hU (aAction L S) (l : M) := by
  rw [gradingOf, mem_coactGrading]
  refine (eta_bijective hU (Aover (A L S) U M)).1 ?_
  have h1 := DFunLike.congr_fun (eta_rho hU (A L S) (aAction L S)) (coord L hU l)
  refine h1.trans ((ptX_coord L hU (liesOver_Phi hU _) _ l).trans ?_)
  have h2 : pts _ ((aAction L S).smul (hUniv hU (A L S)) (xConst hU (A L S) M)) =
      APt.toMagnet L (hUniv hU (A L S)) * pts _ (xConst hU (A L S) M) :=
    (pts _).apply_symm_apply _
  have h6 := congrArg (fun z : APt (overO S) L _ => z (Multiplicative.ofAdd l)) h2
  refine Eq.trans h6 ?_
  have h3 : toGa hU (liesOver_Phi hU _) (pts _ (xConst hU (A L S) M)) (Multiplicative.ofAdd l) =
      eta hU (Aover (A L S) U M) (AddMonoidAlgebra.single 0 (coord L hU l)) := by
    rw [← ptX_coord, xConst, Equiv.apply_symm_apply]
    rfl
  have h4 : (APt.toMagnet L (hUniv hU (A L S)) * pts _ (xConst hU (A L S) M))
      (Multiplicative.ofAdd l) = eta hU (Aover (A L S) U M) (AddMonoidAlgebra.single (l : M) 1) *
        toGa hU (liesOver_Phi hU _) (pts _ (xConst hU (A L S) M)) (Multiplicative.ofAdd l) := rfl
  refine Eq.trans h4 ?_
  rw [h3, ← map_mul, AddMonoidAlgebra.single_mul_single, add_zero, one_mul]

end Coord

section Vanishing

variable {N : AddSubmonoid M} {T : Over S}

/-- **Theorem 3.20, closed part, in the case of `𝔸(L)_S`**, on a piece over an affine open. -/
lemma toPoint_vanish_of_liesOver {U : S.Opens} (hU : IsAffineOpen U) (hT : LiesOver T U)
    (φ : AttractorPt (aAction L S) N T) {l : L} (hl : (l : M) ∉ N) :
    pts T φ.toPoint (Multiplicative.ofAdd l) = 0 := by
  have h := toPoint_kills hU (aAction L S) N hT φ
    (mem_magnetIdeal_of_notMem hl (coord_mem L hU l))
  rw [ptX_coord] at h
  exact h

/-- The underlying point of a point of `X^N(T)` kills `L ∖ N`. -/
theorem toPoint_vanish (φ : AttractorPt (aAction L S) N T) {l : L} (hl : (l : M) ∉ N) :
    pts T φ.toPoint (Multiplicative.ofAdd l) = 0 := by
  refine section_zero_of_local _ fun x => ?_
  obtain ⟨U, y, hy⟩ := S.directedAffineCover.exists_eq (T.hom x)
  let U' : S.affineOpens := U
  have hxU : T.hom x ∈ U'.1 := by
    rw [← hy]
    exact y.2
  let V : T.left.Opens := T.hom ⁻¹ᵁ U'.1
  let W : Over S := Over.mk (V.ι ≫ T.hom)
  let w : W ⟶ T := Over.homMk V.ι rfl
  have hW : LiesOver W U'.1 := liesOver_of_forall fun z => by
    change (V.ι ≫ T.hom) z ∈ U'.1
    rw [Scheme.Hom.comp_apply]
    exact z.2
  refine ⟨W.left, w.left, inferInstanceAs (IsOpenImmersion V.ι), ⟨x, hxU⟩, ?_, ?_⟩
  · simp [w, W]
  · have h := toPoint_vanish_of_liesOver L U'.2 hW (φ.baseChange w) hl
    rw [toPoint_baseChange, pts_comp] at h
    exact h

variable (N) in
/-- The monoid map `l ↦ x(l) a(l)` on `N`, and `l ↦ 0` off `N`. -/
def extChar {B : Type*} [CommRing B] (x : Multiplicative L →* B)
    (hx : ∀ l : L, (l : M) ∉ N → x (Multiplicative.ofAdd l) = 0) (a : Multiplicative N →* B) :
    Multiplicative L →* B where
  toFun l := if h : ((Multiplicative.toAdd l : L) : M) ∈ N then
    x l * a (Multiplicative.ofAdd ⟨_, h⟩) else 0
  map_one' := by
    have h0 : ((Multiplicative.toAdd (1 : Multiplicative L) : L) : M) ∈ N := N.zero_mem
    rw [dif_pos h0, map_one, one_mul]
    exact map_one a
  map_mul' l l' := by
    have hx' : ∀ k : Multiplicative L, ((Multiplicative.toAdd k : L) : M) ∉ N → x k = 0 :=
      fun k hk => hx _ hk
    by_cases h1 : ((Multiplicative.toAdd l : L) : M) ∈ N <;>
      by_cases h2 : ((Multiplicative.toAdd l' : L) : M) ∈ N
    · have h3 : ((Multiplicative.toAdd (l * l') : L) : M) ∈ N := N.add_mem h1 h2
      rw [dif_pos h1, dif_pos h2, dif_pos h3, map_mul x, mul_mul_mul_comm, ← map_mul a]
      rfl
    · rw [dif_neg h2, mul_zero]
      split_ifs
      · rw [map_mul, hx' l' h2, mul_zero, zero_mul]
      · rfl
    · rw [dif_neg h1, zero_mul]
      split_ifs
      · rw [map_mul, hx' l h1, zero_mul, zero_mul]
      · rfl
    · rw [dif_neg h1, zero_mul]
      split_ifs
      · rw [map_mul, hx' l h1, zero_mul, zero_mul]
      · rfl

lemma extChar_of_mem {B : Type*} [CommRing B] (x : Multiplicative L →* B)
    (hx : ∀ l : L, (l : M) ∉ N → x (Multiplicative.ofAdd l) = 0) (a : Multiplicative N →* B)
    {l : L} (h : (l : M) ∈ N) :
    extChar L N x hx a (Multiplicative.ofAdd l) = x (Multiplicative.ofAdd l) * a (Multiplicative.ofAdd ⟨l, h⟩) :=
  dif_pos h

lemma extChar_of_notMem {B : Type*} [CommRing B] (x : Multiplicative L →* B)
    (hx : ∀ l : L, (l : M) ∉ N → x (Multiplicative.ofAdd l) = 0) (a : Multiplicative N →* B)
    {l : L} (h : (l : M) ∉ N) : extChar L N x hx a (Multiplicative.ofAdd l) = 0 :=
  dif_neg h

lemma vanish_comp {T T' : Over S} {t : T ⟶ A L S}
    (ht : ∀ l : L, (l : M) ∉ N → pts T t (Multiplicative.ofAdd l) = 0) (s : T' ⟶ T) :
    ∀ l : L, (l : M) ∉ N → pts T' (s ≫ t) (Multiplicative.ofAdd l) = 0 := by
  intro l hl
  rw [pts_comp, APt.res_apply, ht l hl, map_zero]

/-- The converse of `toPoint_vanish`: a point of `𝔸(L)_S` killing `L ∖ N` is the underlying point
of the equivariant map `𝔸(N)_T → 𝔸(L)_T`, `a ↦ (l ↦ t(l) a(l))`. This is the map printed in the proof
of Proposition 2.1, "sending `X^m` to `F([X^m]) X^m`". -/
def vanishPt (t : T ⟶ A L S)
    (ht : ∀ l : L, (l : M) ∉ N → pts T t (Multiplicative.ofAdd l) = 0) :
    AttractorPt (aAction L S) N T where
  app {T'} s a := (pts T').symm (extChar L N (pts T' (s ≫ t)) (vanish_comp L ht s) a)
  naturality {T' T''} s r a := by
    change (pts T'').symm _ = s ≫ (pts T').symm _
    apply (pts T'').injective
    rw [Equiv.apply_symm_apply,
      pts_comp s ((pts T').symm (extChar L N (pts T' (r ≫ t)) (vanish_comp L ht r) a)),
      Equiv.apply_symm_apply]
    refine MonoidHom.ext fun l => ?_
    obtain ⟨l, rfl⟩ := Multiplicative.ofAdd.surjective l
    by_cases h : (l : M) ∈ N
    · rw [extChar_of_mem _ _ _ _ h, APt.res_apply, APt.res_apply, extChar_of_mem _ _ _ _ h, map_mul,
        Category.assoc, pts_comp s (r ≫ t), APt.res_apply]
    · rw [extChar_of_notMem _ _ _ _ h, APt.res_apply, extChar_of_notMem _ _ _ _ h, map_zero]
  equivariant {T'} s h a := by
    change (pts T').symm _ = (pts T').symm _
    congr 1
    refine MonoidHom.ext fun l => ?_
    obtain ⟨l, rfl⟩ := Multiplicative.ofAdd.surjective l
    rw [Equiv.apply_symm_apply]
    change _ = APt.toMagnet L h (Multiplicative.ofAdd l) * _
    by_cases hl : (l : M) ∈ N
    · rw [extChar_of_mem _ _ _ _ hl, extChar_of_mem _ _ _ _ hl]
      change _ * (h (Multiplicative.ofAdd (l : M)) * a _) = h (Multiplicative.ofAdd (l : M)) * (_ * _)
      ring
    · rw [extChar_of_notMem _ _ _ _ hl, extChar_of_notMem _ _ _ _ hl, mul_zero]

lemma toPoint_vanishPt (t : T ⟶ A L S)
    (ht : ∀ l : L, (l : M) ∉ N → pts T t (Multiplicative.ofAdd l) = 0) :
    (vanishPt L t ht).toPoint = t := by
  change (pts T).symm _ = t
  rw [Equiv.symm_apply_eq]
  refine MonoidHom.ext fun l => ?_
  obtain ⟨l, rfl⟩ := Multiplicative.ofAdd.surjective l
  by_cases h : (l : M) ∈ N
  · rw [extChar_of_mem _ _ _ _ h, Category.id_comp]
    change _ * (1 : (overO S).obj (op T)) = _
    rw [mul_one]
  · rw [extChar_of_notMem _ _ _ _ h, ht l h]

variable (N T) in
/-- **Proposition 2.1**, on points. `X^N(T) ⊆ X(T)` is the set of monoid maps `L → Γ(T, ⊤)` killing
`L ∖ N`, for an arbitrary scheme `S` and `T` over `S`. -/
theorem attractorImage_self :
    attractorImage (aAction L S) N T =
      {t | ∀ l : L, (l : M) ∉ N → pts T t (Multiplicative.ofAdd l) = 0} := by
  ext t
  constructor
  · rintro ⟨φ, rfl⟩ l hl
    exact toPoint_vanish L φ hl
  · intro ht
    exact ⟨vanishPt L t ht, toPoint_vanishPt L t ht⟩

variable (N T) in
/-- **Proposition 2.1**: `X^N(T)` is the set of monoid maps `L → Γ(T, ⊤)` killing `L ∖ N`. -/
def attractorPtEquivChars :
    AttractorPt (aAction L S) N T ≃
      {χ : Multiplicative L →* Γ(T.left, ⊤) // ∀ l : L, (l : M) ∉ N → χ (Multiplicative.ofAdd l) = 0} where
  toFun φ := ⟨pts T φ.toPoint, fun _ hl => toPoint_vanish L φ hl⟩
  invFun χ := vanishPt L ((pts T).symm (show APt (overO S) L (op T) from χ.1)) (fun l hl =>
    (congrArg (fun z : APt (overO S) L (op T) => z (Multiplicative.ofAdd l))
      ((pts T).apply_symm_apply (show APt (overO S) L (op T) from χ.1))).trans (χ.2 l hl))
  left_inv φ := toPoint_injective_global (by
    rw [toPoint_vanishPt, Equiv.symm_apply_apply])
  right_inv χ := Subtype.ext
    ((congrArg (pts T) (toPoint_vanishPt L _ _)).trans ((pts T).apply_symm_apply _))

/-- Ring morphisms, bundled or not. -/
def homRingEquiv (R₁ : Type u) [CommRing R₁] (S₁ : CommRingCat.{u}) :
    (R₁ →+* S₁) ≃ (CommRingCat.of R₁ ⟶ S₁) where
  toFun f := CommRingCat.ofHom f
  invFun f := f.hom
  left_inv _ := rfl
  right_inv _ := rfl

variable (N T) in
/-- **Proposition 2.1**, on functors of points: a point of `X^N` over `T → S` is a morphism
`T → Spec(ℤ[L]/J_N)`, for an arbitrary scheme `S`. -/
def attractorPtEquivSpec :
    AttractorPt (aAction L S) N T ≃
      (T.left ⟶ Spec (CommRingCat.of
        (AddMonoidAlgebra ℤ L ⧸ magnetIdeal (magnetGrading L ℤ) N))) :=
  (attractorPtEquivChars L N T).trans <|
    (quotientChars (R := ℤ) (L := L) (N := N) Γ(T.left, ⊤)).symm.trans <|
      (RingHom.equivIntAlgHom (R := AddMonoidAlgebra ℤ L ⧸ magnetIdeal (magnetGrading L ℤ) N)
          (S := Γ(T.left, ⊤))).symm.trans <|
        (homRingEquiv (AddMonoidAlgebra ℤ L ⧸ magnetIdeal (magnetGrading L ℤ) N)
            Γ(T.left, ⊤)).trans (homSpecEquiv T.left _).symm

end Vanishing

section Detect

variable {N N' : AddSubmonoid M}

lemma vanish_iff_monIdeal {B : Type*} [CommMonoidWithZero B] (χ : Multiplicative L →* B) :
    (∀ l : L, (l : M) ∉ N → χ (Multiplicative.ofAdd l) = 0) ↔
      ∀ l : L, (l : M) ∈ monIdeal L N → χ (Multiplicative.ofAdd l) = 0 := by
  constructor
  · rintro h l ⟨m, hm, hmN, t, ht, e⟩
    have : l = ⟨m, hm⟩ + ⟨t, ht⟩ := Subtype.ext e
    rw [this, ofAdd_add, map_mul, h ⟨m, hm⟩ hmN, zero_mul]
  · exact fun h l hl => h l (mem_monIdeal_of_notMem l.2 hl)

/-- `X^N = X^{N'}` (`S ≠ ∅`) iff the monoid ideals agree. The test object is `Spec (R[L]/J_N)`, with
`R = Γ(S, U)` for a nonempty affine open `U`, which lies over `S`. -/
theorem attractorImage_eq_iff [Nonempty S] :
    attractorImage (aAction L S) N = attractorImage (aAction L S) N' ↔
      monIdeal L N = monIdeal L N' := by
  constructor
  · have key : ∀ {N N' : AddSubmonoid M},
        attractorImage (aAction L S) N = attractorImage (aAction L S) N' →
          monIdeal L N' ⊆ monIdeal L N := by
      intro N N' e
      obtain ⟨x⟩ : Nonempty S := inferInstance
      obtain ⟨U, y, hy⟩ := S.directedAffineCover.exists_eq x
      let U' : S.affineOpens := U
      have hxU : x ∈ U'.1 := by
        rw [← hy]
        exact y.2
      have hU := U'.2
      have : Nonempty (U'.1 : S.Opens) := ⟨⟨x, hxU⟩⟩
      have : Nontrivial Γ(S, U'.1) := Scheme.component_nontrivial S U'.1
      let D : CommAlgCat.{u} Γ(S, U'.1) := CommAlgCat.of Γ(S, U'.1)
        (AddMonoidAlgebra Γ(S, U'.1) L ⧸ magnetIdeal (magnetGrading L Γ(S, U'.1)) N)
      let hT := liesOver_Phi hU D
      let c : L → D := fun l => Ideal.Quotient.mk _ (mono Γ(S, U'.1) L l)
      let χ : Multiplicative L →* Ga hU (Phi hU D) hT :=
        { toFun := fun l => eta hU D (c (Multiplicative.toAdd l))
          map_one' := by
            have : c 0 = 1 := rfl
            change eta hU D (c 0) = 1
            rw [this, map_one]
          map_mul' := fun l l' => by
            rw [← map_mul]
            congr 1
            change Ideal.Quotient.mk _ _ = Ideal.Quotient.mk _ _ * Ideal.Quotient.mk _ _
            rw [← map_mul, AddMonoidAlgebra.single_mul_single, one_mul]
            rfl }
      let t : Phi hU D ⟶ A L S := (pts _).symm (ofGa hU hT χ)
      have hpts : pts _ t = ofGa hU hT χ := (pts _).apply_symm_apply _
      have ht : t ∈ attractorImage (aAction L S) N (Phi hU D) := by
        rw [attractorImage_self, Set.mem_ofPred_eq]
        intro l hl
        rw [hpts]
        change eta hU D (c l) = 0
        have : c l = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr
          (mem_magnetIdeal_of_notMem hl (single_mem_magnetGrading l _))
        rw [this, map_zero]
      rw [e, attractorImage_self, Set.mem_ofPred_eq] at ht
      have hsub : ∀ l : L, (l : M) ∉ N' → (l : M) ∈ monIdeal L N := by
        intro l hl
        have h1 := ht l hl
        rw [hpts] at h1
        have h2 : c l = 0 := (eta_bijective hU D).1 (h1.trans (map_zero _).symm)
        exact (mono_mem_magnetIdeal_iff _ L l).1 (Ideal.Quotient.eq_zero_iff_mem.mp h2)
      rintro _ ⟨m, hm, hmN, s, hs, rfl⟩
      exact add_mem_monIdeal (hsub ⟨m, hm⟩ hmN) hs
    intro e
    exact Set.Subset.antisymm (key e.symm) (key e)
  · intro e
    funext T
    rw [attractorImage_self, attractorImage_self]
    ext t
    simp only [Set.mem_ofPred_eq]
    rw [vanish_iff_monIdeal, vanish_iff_monIdeal, e]

/-- **§2**: over `S ≠ ∅`, `Π(a)` is the set of pure magnets of the monoid ideals. In particular it does
not depend on `S`. This is the reduction "We can assume that `S = Spec(ℤ)` by base change" of the
proof of Proposition 3.1, including the converse direction it needs: base change preserves equalities
of attractors, and `S ≠ ∅` is what reflects them. -/
theorem pureMagnets_scheme [Nonempty S] :
    pureMagnets (attractorImage (aAction L S)) = pureMagnets (monIdeal L) := by
  ext K
  refine forall_congr' fun K' => ?_
  rw [attractorImage_eq_iff]

/-- Over `S = ∅`, all attractors are equal. -/
theorem attractorImage_eq_of_isEmpty [IsEmpty S] (K K' : AddSubmonoid M) :
    attractorImage (aAction L S) K = attractorImage (aAction L S) K' := by
  funext T
  have hT : IsEmpty T.left := ⟨fun x => isEmptyElim (T.hom x)⟩
  have h0 : ∀ s : Γ(T.left, ⊤), s = 0 := fun s =>
    section_zero_of_local s fun x => isEmptyElim x
  rw [attractorImage_self, attractorImage_self]
  ext t
  simp only [Set.mem_ofPred_eq]
  exact ⟨fun _ _ _ => h0 _, fun _ _ _ => h0 _⟩

/-- **Counterexample over the empty scheme to "an arbitrary base scheme" (journal p. 533)**: over
`S = ∅`, `Π(a) = {0}`. -/
theorem pureMagnets_empty_base [IsEmpty S] :
    pureMagnets (attractorImage (aAction L S)) = {⊥} := by
  have hall := attractorImage_eq_of_isEmpty (S := S) L
  ext K
  simp only [Set.mem_singleton_iff]
  constructor
  · intro hK
    exact le_bot_iff.mp (hK ⊥ (hall _ _))
  · rintro rfl
    exact isPure_bot

/-- `X^N = ∅` as soon as `J_N = 1`, i.e. `0 ∈ MonIdeal(L ∖ N)`: every `T` with a point of `X^N` is
empty. -/
theorem isEmpty_of_zero_mem {T : Over S} (h0 : (0 : M) ∈ monIdeal L N)
    (φ : AttractorPt (aAction L S) N T) : IsEmpty T.left := by
  refine isEmpty_of_one_eq_zero ?_
  have := (vanish_iff_monIdeal L (N := N) (pts T φ.toPoint)).1 (fun _ hl => toPoint_vanish L φ hl)
    0 h0
  rw [ofAdd_zero, map_one] at this
  exact this

/-- `X^N` is the empty scheme as soon as `J_N = 1`. -/
theorem isEmpty_Zatt_of_zero_mem (h0 : (0 : M) ∈ monIdeal L N) :
    IsEmpty (Zatt (aAction L S) N).left :=
  isEmpty_of_zero_mem L h0 (attEquiv (aAction L S) N _ (𝟙 _))

end Detect

section Chart

variable {U : S.Opens} (hU : IsAffineOpen U)

/-- The monoid map `l ↦ X^l` on the chart. -/
def coordHom : Multiplicative L →* Aalg (A L S) U where
  toFun l := coord L hU (Multiplicative.toAdd l)
  map_one' := (eta_bijective hU _).1 (by
    change eta hU _ (coord L hU 0) = eta hU _ 1
    rw [eta_coord, map_one]
    exact map_one (pts _ (iotaX (A L S) hU)))
  map_mul' l l' := (eta_bijective hU _).1 (by
    rw [map_mul (eta hU (Aalg (A L S) U)), eta_coord, eta_coord, eta_coord]
    exact map_mul _ _ _)

/-- `Γ(U)[L] → Γ(p⁻¹ U)`, `X^l ↦ X^l`. -/
def theta : AddMonoidAlgebra Γ(S, U) L →ₐ[Γ(S, U)] Aalg (A L S) U :=
  AddMonoidAlgebra.lift _ _ L (coordHom L hU)

lemma theta_single (l : L) (c : Γ(S, U)) :
    theta L hU (AddMonoidAlgebra.single l c) = c • coord L hU l := by
  simp [theta, AddMonoidAlgebra.lift_single, coordHom]

/-- `Γ(U)[L]` as an algebra. -/
abbrev DU : CommAlgCat.{u} Γ(S, U) := CommAlgCat.of Γ(S, U) (AddMonoidAlgebra Γ(S, U) L)

/-- The universal point of `𝔸(L)_S` over `Spec Γ(U)[L]`. -/
def tUniv : Phi hU (DU (U := U) L) ⟶ A L S :=
  (pts _).symm (ofGa hU (liesOver_Phi hU _)
    (((eta hU (DU L)) : DU (U := U) L →* _).comp (AddMonoidAlgebra.of Γ(S, U) L)))

lemma ptX_tUniv_coord (l : L) :
    ptX (A L S) hU _ (liesOver_Phi hU _) (tUniv L hU) (coord L hU l) =
      eta hU (DU L) (AddMonoidAlgebra.single l 1) := by
  rw [ptX_coord, tUniv, Equiv.apply_symm_apply]
  rfl

/-- `Γ(p⁻¹ U)` is generated by the coordinates: `theta` is surjective. -/
theorem theta_surjective : Function.Surjective (theta L hU) := by
  let D := DU (U := U) L
  let Ad := Aalg (A L S) U
  have hA := liesOver_Phi hU Ad
  have hD := liesOver_Phi hU D
  let κ : Ad →ₐ[Γ(S, U)] D :=
    ((etaEquiv hU D).symm.toAlgHom).comp (ptX (A L S) hU _ hD (tUniv L hU))
  have hκ : ∀ a, eta hU D (κ a) = ptX (A L S) hU _ hD (tUniv L hU) a := fun a =>
    (etaEquiv hU D).apply_symm_apply _
  let s : Phi hU Ad ⟶ Phi hU D := (homPhi hU _ hA D).symm ((eta hU Ad).comp (theta L hU))
  have hs : homPhi hU _ hA D s = (eta hU Ad).comp (theta L hU) :=
    (homPhi hU _ hA D).apply_symm_apply _
  have hs' : ∀ x : D, gpull hU hD hA s (eta hU D x) = eta hU Ad (theta L hU x) := by
    intro x
    have h2 := homPhi_comp hU hD hA s (𝟙 _)
    rw [Category.comp_id, hs] at h2
    exact (DFunLike.congr_fun h2 x).symm
  have hcomp : s ≫ tUniv L hU = iotaX (A L S) hU := by
    apply (pts _).injective
    refine MonoidHom.ext fun l => ?_
    obtain ⟨l, rfl⟩ := Multiplicative.ofAdd.surjective l
    rw [pts_comp, APt.res_apply]
    have h3 : pts _ (tUniv L hU) (Multiplicative.ofAdd l) =
        eta hU D (AddMonoidAlgebra.single l 1) := by
      rw [tUniv, Equiv.apply_symm_apply]
      rfl
    rw [h3]
    change gpull hU hD hA s _ = _
    rw [hs', theta_single, one_smul, eta_coord]
    rfl
  have hid : ptX (A L S) hU _ hA (iotaX (A L S) hU) = eta hU Ad := by
    change homPhi hU _ hA _ (toChart (A L S) hU _ hA (iotaX (A L S) hU)) = _
    congr 1
    apply (toChart (A L S) hU _ hA).symm.injective
    rw [Equiv.symm_apply_apply]
    exact (Category.id_comp _).symm
  intro a
  refine ⟨κ a, (eta_bijective hU Ad).1 ?_⟩
  rw [← hs', hκ]
  have h4 := ptX_comp (A L S) hU hD hA s (tUniv L hU)
  rw [hcomp, hid] at h4
  exact (DFunLike.congr_fun h4 a).symm

/-- The coaction on the image of `theta`. -/
lemma coeff_rho_theta (b : AddMonoidAlgebra Γ(S, U) L) (m : M) :
    (rho hU (aAction L S) (theta L hU b)).coeff m =
      if h : m ∈ L then b.coeff ⟨m, h⟩ • coord L hU ⟨m, h⟩ else 0 := by
  induction b using AddMonoidAlgebra.induction_linear with
  | zero =>
    simp only [map_zero, AddMonoidAlgebra.coeff_zero, Finsupp.coe_zero, Pi.zero_apply, zero_smul]
    split_ifs <;> rfl
  | add x y hx hy =>
    rw [map_add, map_add, AddMonoidAlgebra.coeff_add, Finsupp.add_apply, hx, hy,
      AddMonoidAlgebra.coeff_add]
    split_ifs
    · rw [Finsupp.add_apply, add_smul]
    · exact add_zero _
  | single l c =>
    rw [theta_single, map_smul, mem_coactGrading.mp (coord_mem L hU l), AddMonoidAlgebra.smul_single,
      AddMonoidAlgebra.coeff_single, AddMonoidAlgebra.coeff_single]
    by_cases e : (l : M) = m
    · subst e
      rw [dif_pos l.2]
      simp
    · rw [Finsupp.single_eq_of_ne (Ne.symm e)]
      split_ifs with h
      · have hne : (⟨m, h⟩ : L) ≠ l := fun e' => e (congrArg Subtype.val e').symm
        rw [Finsupp.single_eq_of_ne hne, zero_smul]
      · rfl

variable (N : AddSubmonoid M)

/-- **Proposition 2.1**, the ideal, over an affine open `U` of an arbitrary `S`: the graded pieces of
`Γ(p⁻¹ U)` of degree outside `N` generate `⟨X^m | m ∈ L ∖ N⟩`. -/
theorem magnetIdeal_chart :
    magnetIdeal (gradingOf hU (aAction L S)) N =
      Ideal.span {a | ∃ l : L, (l : M) ∉ N ∧ a = coord L hU l} := by
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · simp only [Set.iUnion_subset_iff]
    intro m hm a ha
    obtain ⟨b, rfl⟩ := theta_surjective L hU a
    have h1 : rho hU (aAction L S) (theta L hU b) = AddMonoidAlgebra.single m (theta L hU b) := ha
    have h2 := coeff_rho_theta L hU b m
    rw [h1, AddMonoidAlgebra.coeff_single, Finsupp.single_eq_same] at h2
    rw [SetLike.mem_coe, h2]
    split_ifs with hL
    · exact Submodule.smul_of_tower_mem _ _ (Ideal.subset_span ⟨⟨m, hL⟩, hm, rfl⟩)
    · exact zero_mem _
  · rintro _ ⟨l, hl, rfl⟩
    exact mem_magnetIdeal_of_notMem hl (coord_mem L hU l)

/-- **Proposition 2.1** for an arbitrary `S`. `X^N` is a closed subscheme of `X = 𝔸(L)_S`
(`AlgMag.GB.instClosedIAtt`), whose ideal over an affine open `U` is `⟨X^m | m ∈ L ∖ N⟩`. -/
theorem ker_iAtt_self (U : S.affineOpens) :
    (iAtt (aAction L S) N).left.ker.ideal
        ⟨(A L S).hom ⁻¹ᵁ U.1, isAffineOpen_preimage (A L S) U.2⟩ =
      Ideal.span {a | ∃ l : L, (l : M) ∉ N ∧ a = coord L U.2 l} :=
  (ker_iAtt_ideal (aAction L S) N U).trans (magnetIdeal_chart L U.2 N)

end Chart

