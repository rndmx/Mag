import AlgMag.ChartTowerPoints
import AlgMag.ChartEffectiveFinal
import StacksFrontier.AlgebraicGeometry.Spaces.OpenSubspaceCorrespondence

/-!
# The closed strata of the effectivity step of the chart lemma

Part of the proof of the equivariant étale chart lemma for `D(M)`-actions at a closed point (local
structure in the sense of Alper–Hall–Rydh), used for **Theorem 6.8** of Algebraic Magnetism.

## Construction

The reduced closed substack of `[Z/G]` and its ideal `J` as a sheaf on `X` are not used:

1. Let `o₀ : P₀ → X` be the reduced closed subspace on `|X| \ U` (Stacks 03IQ). It need not be stable:
   this is the `μ_p` issue of Lemma 4.2, `X_red` is not stable when `μ_p ⊂ G`.
2. `P`, the scheme-theoretic image of `G × P₀ → X`, is stable with the same points. On an affine
   `W` with `x ∈ X(W)`, write `K(x) ⊂ Γ(W)[M]` for the ideal of `W[M] ×_{g⁻¹x, X} P₀` and put
   `imgI x = {r | 1 ⊗ r ∈ K(x)}` (`AlgMag.ChartMain.imgI`). For an affine chart `φ : V → X`,
   `P` is cut out by `J_V = imgI φ` (`Space.invariantSubspace`). In graded terms `imgI` is the
   largest homogeneous ideal inside the ideal of `P₀`.
   * `imgI_le`: `g^♯ (imgI x) ⊂ imgI (h • g^* x)` for any `g`, `h`.
   * `imgI_flat`: equality for `h = 1` and `g` flat (flat base change of the image).
   These two give invariance under `V ×_X V` and stability, the latter on the universal
   case `V[M] ×_X V`, whose map to `V` through `V[M]` is flat.
   * Points: `f ∈ I₀` gives `(1 ⊗ f)^N ∈ K(φ)`, by stability of the set `|X| \ U`: this is the
   "correct radical". `J_V ⊂ I₀` gives `P₀ ⊂ P`.
3. `Z^(k)` is `thickening` of `o = P → X`, i.e. `V(J^{k+1})`, with `mem_thickening_iff` and
   `thickeningAction`. So `V(J^k) ⊂ Z^(k)`, which is what `OpenStratumMap` asks of `Z^(k)`.

An affine chart of `X` is assumed (`X` quasi-compact), so that `V[M]` is `spObj`. Separatedness is
not used here.
-/

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry DirectSum

universe u

namespace AlgMag.ChartMain

/-! ### Flat base change of `{r | 1 ⊗ r ∈ K}` -/

section FlatRing

open scoped TensorProduct

variable {A A' M' : Type u} [CommRing A] [CommRing A'] [AddCommGroup M']

/-- `A[M] → A'[M]`. -/
noncomputable abbrev baseMap (g : A →+* A') : AddMonoidAlgebra A M' →+* AddMonoidAlgebra A' M' :=
  evalAt (AddMonoidAlgebra.singleZeroRingHom.comp g) (AddMonoidAlgebra.of A' M')

lemma baseMap_single (g : A →+* A') (e : M') (b : A) :
    baseMap g (AddMonoidAlgebra.single e b) = AddMonoidAlgebra.single e (g b) := by
  rw [evalAt_single]
  simp [AddMonoidAlgebra.single_mul_single]

/-- For `g : A → A'` flat and `K ⊂ A[M]`: `{r' | 1 ⊗ r' ∈ K A'[M]}` is generated by
`{r | 1 ⊗ r ∈ K}`. -/
theorem comap_map_singleZero_le (g : A →+* A') (hg : g.Flat) (K : Ideal (AddMonoidAlgebra A M')) :
    (K.map (baseMap g)).comap
        (AddMonoidAlgebra.singleZeroRingHom : A' →+* AddMonoidAlgebra A' M') ≤
      (K.comap (AddMonoidAlgebra.singleZeroRingHom : A →+* AddMonoidAlgebra A M')).map g := by
  classical
  letI := g.toAlgebra
  haveI : Module.Flat A A' := hg
  let Q := AddMonoidAlgebra A M' ⧸ K
  let q : AddMonoidAlgebra A M' →+* Q := Ideal.Quotient.mk K
  have hsm : ∀ (b : A) (y : Q), b • y = q (AddMonoidAlgebra.single 0 b) * y := fun b y => by
    rw [Algebra.smul_def]; rfl
  let ψ : AddMonoidAlgebra A' M' → A' ⊗[A] Q :=
    fun p => p.coeff.sum fun d a' => a' ⊗ₜ[A] q (AddMonoidAlgebra.single d 1)
  have ψadd : ∀ p p', ψ (p + p') = ψ p + ψ p' := fun p p' => by
    simp only [ψ, AddMonoidAlgebra.coeff_add]
    exact Finsupp.sum_add_index' (fun _ => TensorProduct.zero_tmul _ _)
      (fun _ _ _ => TensorProduct.add_tmul _ _ _)
  have ψzero : ψ 0 = 0 := by simp [ψ]
  have ψsingle : ∀ d a', ψ (AddMonoidAlgebra.single d a') =
      a' ⊗ₜ[A] q (AddMonoidAlgebra.single d 1) := fun d a' => by
    simp [ψ]
  have hmulK : ∀ κ ∈ K, ∀ p, ψ (p * baseMap g κ) = 0 := by
    intro κ hκ p
    induction p using AddMonoidAlgebra.induction_linear with
    | zero => simp [ψzero]
    | add p p' h h' => rw [add_mul, ψadd, h, h', add_zero]
    | single d a' =>
      have key : ∀ κ' : AddMonoidAlgebra A M',
          ψ (AddMonoidAlgebra.single d a' * baseMap g κ') =
            a' ⊗ₜ[A] q (AddMonoidAlgebra.single d 1 * κ') := by
        intro κ'
        induction κ' using AddMonoidAlgebra.induction_linear with
        | zero => simp [ψzero]
        | add x y hx hy => rw [map_add, mul_add, ψadd, hx, hy, mul_add, map_add, TensorProduct.tmul_add]
        | single e b =>
          rw [baseMap_single, AddMonoidAlgebra.single_mul_single, ψsingle,
            AddMonoidAlgebra.single_mul_single, one_mul]
          have h2 : a' * g b = b • a' := by
            rw [Algebra.smul_def, mul_comm]; rfl
          have h3 : q (AddMonoidAlgebra.single (d + e) b) =
              b • q (AddMonoidAlgebra.single (d + e) 1) := by
            rw [hsm, ← map_mul, AddMonoidAlgebra.single_mul_single, zero_add, mul_one]
          rw [h2, h3, TensorProduct.smul_tmul]
      rw [key, (Ideal.Quotient.eq_zero_iff_mem).2 (K.mul_mem_left _ hκ), TensorProduct.tmul_zero]
  have hker : ∀ y ∈ K.map (baseMap g), ∀ p, ψ (p * y) = 0 := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨κ, hκ, rfl⟩ := hy
      exact hmulK κ hκ
    | zero => intro p; simp [ψzero]
    | add x y _ _ hx hy => intro p; rw [mul_add, ψadd, hx, hy, add_zero]
    | smul r y _ ih => intro p; rw [smul_eq_mul, ← mul_assoc]; exact ih _
  intro a' ha'
  have h0 : ψ (AddMonoidAlgebra.singleZeroRingHom a') = 0 := by
    simpa using hker _ ha' 1
  have h1 : ψ (AddMonoidAlgebra.singleZeroRingHom a') = a' ⊗ₜ[A] (1 : Q) := by
    change ψ (AddMonoidAlgebra.single 0 a') = _
    rw [ψsingle]; rfl
  let ℓ : A →ₗ[A] Q := Algebra.linearMap A Q
  have hex : Function.Exact (LinearMap.lTensor A' (LinearMap.ker ℓ).subtype) (LinearMap.lTensor A' ℓ) :=
    Module.Flat.lTensor_exact A' (LinearMap.exact_subtype_ker_map ℓ)
  have h2 : LinearMap.lTensor A' ℓ (a' ⊗ₜ[A] (1 : A)) = 0 := by
    rw [LinearMap.lTensor_tmul, show ℓ 1 = 1 from map_one (algebraMap A Q), ← h1, h0]
  obtain ⟨t, ht⟩ := (hex _).1 h2
  have h3 : ∀ t : A' ⊗[A] (LinearMap.ker ℓ),
      TensorProduct.rid A A' (LinearMap.lTensor A' (LinearMap.ker ℓ).subtype t) ∈
        (K.comap (AddMonoidAlgebra.singleZeroRingHom : A →+* AddMonoidAlgebra A M')).map g := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => simp
    | tmul x y =>
      have hy : (y : A) ∈ K.comap (AddMonoidAlgebra.singleZeroRingHom : A →+* AddMonoidAlgebra A M') :=
        (Ideal.Quotient.eq_zero_iff_mem (I := K)).1 y.2
      rw [LinearMap.lTensor_tmul, TensorProduct.rid_tmul, Algebra.smul_def, mul_comm]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hy)
    | add x y hx hy => rw [map_add, map_add]; exact Ideal.add_mem _ hx hy
  have h4 := h3 t
  rw [ht] at h4
  simpa using h4

end FlatRing

/-! ### The ideal `imgI` -/

section Img

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {M : Type u} [AddCommGroup M] [AddMonoid.FG M]
  {X P₀ : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {o₀ : P₀ ⟶ X} (ho : ClosedP o₀)
  (actX : AAction (fppfO B S hS) M X)

local notation "SCH" => BigFppfOver.toScheme B S hS

/-- The action, with the group point written in `Γ(T)`. -/
def smX {T : BigFppfOver B S hS} (h : Multiplicative M →* Γ((SCH).obj T, ⊤)) (x : X.obj (op T)) :
    X.obj (op T) :=
  actX.smul (U := op T) h x

lemma smX_one {T : BigFppfOver B S hS} (x : X.obj (op T)) : smX actX 1 x = x :=
  actX.one_smul (U := op T) x

lemma smX_mul {T : BigFppfOver B S hS} (g h : Multiplicative M →* Γ((SCH).obj T, ⊤))
    (x : X.obj (op T)) : smX actX (g * h) x = smX actX g (smX actX h x) :=
  actX.mul_smul (U := op T) g h x

lemma smX_map {T T' : BigFppfOver B S hS} (f : T' ⟶ T) (h : Multiplicative M →* Γ((SCH).obj T, ⊤))
    (x : X.obj (op T)) :
    X.map f.op (smX actX h x) = smX actX (secPt ((SCH).map f).appTop.hom h) (X.map f.op x) :=
  actX.map_smul f.op h x

/-- `W[M]`. -/
noncomputable abbrev gmObj (W : BigFppfOver B S hS) [IsAffine ((SCH).obj W)] : BigFppfOver B S hS :=
  spObj W (ι1 W (M := M)) contains1

/-- `W[M] → W`. -/
noncomputable abbrev gmπ (W : BigFppfOver B S hS) [IsAffine ((SCH).obj W)] : gmObj (M := M) W ⟶ W :=
  spToT W (ι1 W (M := M)) contains1

/-- The point `(g, w) ↦ g • x(w)` of `X` over `W[M]`. -/
noncomputable def univX {W : BigFppfOver B S hS} [IsAffine ((SCH).obj W)] (x : X.obj (op W)) :
    X.obj (op (gmObj (M := M) W)) :=
  smX actX (univPt1 (U := W)) (X.map (gmπ (M := M) W).op x)

/-- The global sections of an ideal sheaf on an affine scheme. -/
noncomputable abbrev topI {Y : Scheme.{u}} [IsAffine Y] (I : Y.IdealSheafData) : Ideal Γ(Y, ⊤) :=
  I.ideal ⟨⊤, isAffineOpen_top Y⟩

/-- `{r ∈ Γ(W) | 1 ⊗ r ∈ K(x)}`, for `K(x)` the ideal in `Γ(W)[M]` of `(g • x)⁻¹ P₀`: the ideal of
the scheme-theoretic image of `(g • x)⁻¹ P₀ → W`. -/
noncomputable def imgI {W : BigFppfOver B S hS} [IsAffine ((SCH).obj W)] (x : X.obj (op W)) :
    Ideal Γ((SCH).obj W, ⊤) :=
  (topI (idealOf ho (yonedaEquiv.symm (univX actX x)))).comap
    ((SCH).map (gmπ (M := M) W)).appTop.hom

variable {W W' : BigFppfOver B S hS} [IsAffine ((BigFppfOver.toScheme B S hS).obj W)]
  [IsAffine ((BigFppfOver.toScheme B S hS).obj W')]

/-- `(g, w') ↦ (g h(w'), f(w'))`. -/
lemma exists_gmLift (f : W' ⟶ W) (h : Multiplicative M →* Γ((SCH).obj W', ⊤)) (x : X.obj (op W)) :
    ∃ τ : gmObj (M := M) W' ⟶ gmObj (M := M) W,
      τ ≫ gmπ W = gmπ W' ≫ f ∧
      (∀ y, ((SCH).map τ).appTop.hom (spSec W (ι1 W (M := M)) contains1 y) =
        evalAt ((SCH).map (gmπ (M := M) W' ≫ f)).appTop.hom
          (secPt ((SCH).map (gmπ (M := M) W')).appTop.hom h * univPt1 (U := W')) y) ∧
      X.map τ.op (univX actX x) =
        univX actX (smX actX h (X.map f.op x)) := by
  have hψ : (evalAt ((SCH).map (gmπ (M := M) W' ≫ f)).appTop.hom
      (secPt ((SCH).map (gmπ (M := M) W')).appTop.hom h * univPt1 (U := W'))).comp (ι1 W (M := M)) =
      ((SCH).map (gmπ (M := M) W' ≫ f)).appTop.hom :=
    RingHom.ext fun b => evalAt_ι _ _ b
  obtain ⟨τ, h1, h2⟩ := exists_spLift (ι1 W (M := M)) contains1 (gmπ (M := M) W' ≫ f) _ hψ
  refine ⟨τ, h1, h2, ?_⟩
  have hres : secPt ((SCH).map τ).appTop.hom (univPt1 (U := W)) =
      secPt ((SCH).map (gmπ (M := M) W')).appTop.hom h * univPt1 (U := W') :=
    MonoidHom.ext fun m => by
      refine (h2 _).trans ?_
      refine (evalAt_single _ _ (Multiplicative.toAdd m) 1).trans ?_
      rw [map_one, one_mul]
      rfl
  have e1 : X.map τ.op (X.map (gmπ (M := M) W).op x) =
      X.map (gmπ (M := M) W').op (X.map f.op x) := by
    rw [← Functor.map_comp_apply, ← Functor.map_comp_apply, ← op_comp, ← op_comp, h1]
  unfold univX
  rw [smX_map, smX_map, e1, hres, mul_comm, smX_mul]

lemma topI_idealOf_map (τ : W' ⟶ W) (u : X.obj (op W)) :
    topI (idealOf ho (yonedaEquiv.symm (X.map τ.op u))) =
      (topI (idealOf ho (yonedaEquiv.symm u))).map ((SCH).map τ).appTop.hom := by
  rw [← yoneda_map_comp_pt, idealOf_comp]
  exact IdealPow.ideal_comap_top_of_isAffine _ _

/-- `f^♯ (imgI x) ⊂ imgI (h • f^* x)`, for any `f` and `h`. -/
theorem imgI_le (f : W' ⟶ W) (h : Multiplicative M →* Γ((SCH).obj W', ⊤)) (x : X.obj (op W)) :
    (imgI ho actX x).map ((SCH).map f).appTop.hom ≤
      imgI ho actX (smX actX h (X.map f.op x)) := by
  obtain ⟨τ, h1, -, h3⟩ := exists_gmLift actX f h x
  rw [Ideal.map_le_iff_le_comap]
  intro r hr
  have : ((SCH).map (gmπ (M := M) W')).appTop.hom (((SCH).map f).appTop.hom r) =
      ((SCH).map τ).appTop.hom (((SCH).map (gmπ (M := M) W)).appTop.hom r) := by
    have e := congrArg (fun z => ((SCH).map z).appTop.hom r) h1
    simp only [Functor.map_comp, Scheme.Hom.comp_appTop] at e
    exact e.symm
  rw [Ideal.mem_comap]
  unfold imgI
  rw [Ideal.mem_comap, ← h3, topI_idealOf_map, this]
  exact Ideal.mem_map_of_mem _ hr

/-- `imgI (f^* x) ⊂ f^♯ (imgI x)`, for `f` flat. -/
theorem imgI_flat (f : W' ⟶ W) (hf : Flat ((SCH).map f)) (x : X.obj (op W)) :
    imgI ho actX (X.map f.op x) ≤ (imgI ho actX x).map ((SCH).map f).appTop.hom := by
  obtain ⟨τ, h1, h2, h3⟩ := exists_gmLift actX f 1 x
  rw [smX_one] at h3
  have hb := spSec_bijective W (ι1 W (M := M)) contains1
  have hb' := spSec_bijective W' (ι1 W' (M := M)) contains1
  let e := RingEquiv.ofBijective _ hb
  let K := topI (idealOf ho (yonedaEquiv.symm (univX actX x)))
  let K₀ : Ideal (R1 W M) := K.comap (spSec W (ι1 W (M := M)) contains1)
  have hK : K = K₀.map (spSec W (ι1 W (M := M)) contains1) :=
    (Ideal.map_comap_of_surjective _ hb.2 K).symm
  have hτ : ∀ y, ((SCH).map τ).appTop.hom (spSec W (ι1 W (M := M)) contains1 y) =
      spSec W' (ι1 W' (M := M)) contains1 (baseMap ((SCH).map f).appTop.hom y) := by
    intro y
    rw [h2]
    have : secPt (M := M) ((SCH).map (gmπ (M := M) W')).appTop.hom (1 : Multiplicative M →* Γ((SCH).obj W', ⊤))
        * univPt1 (U := W') = univPt1 (U := W') := by
      refine MonoidHom.ext fun m => ?_
      simp [secPt]
    rw [this]
    induction y using AddMonoidAlgebra.induction_linear with
    | zero => simp
    | add p q hp hq => rw [map_add, map_add, map_add, hp, hq]
    | single d b =>
      rw [evalAt_single, baseMap_single, Functor.map_comp, Scheme.Hom.comp_appTop]
      change ((SCH).map (gmπ (M := M) W')).appTop.hom (((SCH).map f).appTop.hom b) * _ = _
      rw [spToT_appTop]
      change spSec W' (ι1 W' (M := M)) contains1 _ * spSec W' (ι1 W' (M := M)) contains1 _ = _
      rw [← map_mul]
      congr 1
      change AddMonoidAlgebra.single 0 _ * AddMonoidAlgebra.single d 1 = _
      rw [AddMonoidAlgebra.single_mul_single, zero_add, mul_one]
  have hflat : (((SCH).map f).appTop.hom).Flat :=
    (HasRingHomProperty.iff_of_isAffine (P := @Flat)).1 hf
  intro r hr
  unfold imgI at hr
  rw [Ideal.mem_comap, ← h3, topI_idealOf_map, spToT_appTop] at hr
  have h4 : (topI (idealOf ho (yonedaEquiv.symm (univX actX x)))).map ((SCH).map τ).appTop.hom =
      (K₀.map (baseMap ((SCH).map f).appTop.hom)).map (spSec W' (ι1 W' (M := M)) contains1) := by
    change K.map _ = _
    rw [hK, Ideal.map_map, Ideal.map_map]
    congr 1
    exact RingHom.ext hτ
  rw [h4] at hr
  have h5 := Ideal.comap_map_of_bijective _ hb'
    (I := K₀.map (baseMap (M' := M) ((SCH).map f).appTop.hom))
  have h6 : (ι1 W' (M := M)) r ∈ K₀.map (baseMap ((SCH).map f).appTop.hom) := by
    rw [← h5]
    exact hr
  have h7 := comap_map_singleZero_le ((SCH).map f).appTop.hom hflat K₀ h6
  have h8 : K₀.comap (AddMonoidAlgebra.singleZeroRingHom) = imgI ho actX x := by
    ext a
    unfold imgI
    rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, spToT_appTop]
  rwa [h8] at h7

omit [IsAffine ((BigFppfOver.toScheme B S hS).obj W')] in
/-- `W[M] → W` is flat. -/
lemma flat_gmπ : Flat ((SCH).map (gmπ (M := M) W)) := by
  have hf : Flat (Spec.map (CommRingCat.ofHom (ι1 W (M := M)))) := by
    refine Flat.SpecMap_iff.2 ?_
    change (algebraMap (RT W) (R1 W M)).Flat
    exact RingHom.flat_algebraMap_iff.2 inferInstance
  change Flat (Spec.map _ ≫ ((SCH).obj W).isoSpec.inv)
  infer_instance

omit [IsAffine ((BigFppfOver.toScheme B S hS).obj W')] in
/-- `imgI (h • x) ⊂ imgI x`. -/
lemma imgI_smul_le (h : Multiplicative M →* Γ((SCH).obj W, ⊤)) (x : X.obj (op W)) :
    imgI ho actX (smX actX h x) ≤ imgI ho actX x := by
  let h' : Multiplicative M →* Γ((SCH).obj W, ⊤) := APt.inv (U := op W) h
  have hm : h' * h = 1 := APt.inv_mul (U := op W) h
  have h1 := imgI_le ho actX (𝟙 W) h' (smX actX h x)
  have h2 : smX actX h' (X.map (𝟙 W).op (smX actX h x)) = x := by
    rw [CategoryTheory.op_id, FunctorToTypes.map_id_apply]
    exact (smX_mul actX h' h x).symm.trans (by rw [hm, smX_one])
  rw [h2] at h1
  intro r hr
  have := h1 (Ideal.mem_map_of_mem _ hr)
  simpa using this

/-- The key inclusion: `c^♯ (imgI x) ⊂ c'^♯ (imgI x)`, for `c^* x = h • c'^* x` with `c'` flat. -/
theorem imgI_key {V : BigFppfOver B S hS} [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
    (x : X.obj (op V)) (c c' : W ⟶ V) (hc' : Flat ((SCH).map c'))
    (h : Multiplicative M →* Γ((SCH).obj W, ⊤))
    (e : X.map c.op x = smX actX h (X.map c'.op x)) :
    (imgI ho actX x).map ((SCH).map c).appTop.hom ≤
      (imgI ho actX x).map ((SCH).map c').appTop.hom := by
  have h1 := imgI_le ho actX c 1 x
  rw [smX_one, e] at h1
  exact h1.trans ((imgI_smul_le ho actX h _).trans (imgI_flat ho actX c' hc' x))

end Img

/-! ### The stable closed subspace `P` -/

section Stable

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {M : Type u} [AddCommGroup M] [AddMonoid.FG M]
  {X P₀ : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {o₀ : P₀ ⟶ X} (ho : ClosedP o₀)
  (actX : AAction (fppfO B S hS) M X)
  {V : BigFppfOver B S hS} [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
  (φ : yoneda.obj V ⟶ X)

local notation "SCH" => BigFppfOver.toScheme B S hS

/-- `J_V` on the chart. -/
noncomputable def chartJ : ((SCH).obj V).IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop (imgI ho actX (yonedaEquiv φ))

lemma topI_chartJ : topI (chartJ ho actX φ) = imgI ho actX (yonedaEquiv φ) := by
  unfold topI chartJ
  rw [Scheme.IdealSheafData.ofIdealTop_ideal,
    show (homOfLE (le_top (a := (⊤ : ((SCH).obj V).Opens)))) = 𝟙 _ from rfl]
  simp

lemma map_yonedaEquiv {W : BigFppfOver B S hS} (c : W ⟶ V) :
    X.map c.op (yonedaEquiv φ) = φ.app (op W) c := by
  have := NatTrans.naturality_apply φ c.op (𝟙 V)
  simpa [yonedaEquiv_apply] using this.symm

lemma topI_comap_chartJ {W : BigFppfOver B S hS} [IsAffine ((BigFppfOver.toScheme B S hS).obj W)]
    (c : W ⟶ V) : topI ((chartJ ho actX φ).comap ((SCH).map c)) =
      (imgI ho actX (yonedaEquiv φ)).map ((SCH).map c).appTop.hom := by
  rw [← topI_chartJ]
  exact IdealPow.ideal_comap_top_of_isAffine _ _

/-- The key inclusion, on any `C`. -/
theorem comap_chartJ_le {C : BigFppfOver B S hS} (c c' : C ⟶ V) (hc' : Flat ((SCH).map c'))
    (h : Multiplicative M →* Γ((SCH).obj C, ⊤))
    (e : φ.app (op C) c = smX actX h (φ.app (op C) c')) :
    (chartJ ho actX φ).comap ((SCH).map c) ≤ (chartJ ho actX φ).comap ((SCH).map c') := by
  intro A
  let W : BigFppfOver B S hS := Chart.immObj C (A.1.ι)
  let j : W ⟶ C := Chart.immι C (A.1.ι)
  have hA : IsAffine ((SCH).obj W) := A.2
  have hjo : IsOpenImmersion ((SCH).map j) := inferInstanceAs (IsOpenImmersion A.1.ι)
  have hfl : Flat ((SCH).map (j ≫ c')) := by
    rw [Functor.map_comp]; infer_instance
  have e' : X.map (j ≫ c).op (yonedaEquiv φ) =
      smX actX (secPt ((SCH).map j).appTop.hom h) (X.map (j ≫ c').op (yonedaEquiv φ)) := by
    rw [op_comp, op_comp, Functor.map_comp_apply, Functor.map_comp_apply, map_yonedaEquiv,
      map_yonedaEquiv, e, smX_map]
  have key := imgI_key ho actX (yonedaEquiv φ) (j ≫ c) (j ≫ c') hfl _ e'
  rw [← topI_comap_chartJ, ← topI_comap_chartJ] at key
  have hT : IsAffineOpen (⊤ : A.1.toScheme.Opens) := isAffineOpen_top _
  have e1 : ∀ d : C ⟶ V, topI ((chartJ ho actX φ).comap ((SCH).map (j ≫ d))) =
      Ideal.map A.1.topIso.inv.hom (((chartJ ho actX φ).comap ((SCH).map d)).ideal A) := by
    intro d
    have := IdealPow.ideal_comap_ι_top ((chartJ ho actX φ).comap ((SCH).map d)) A.2 hT
    rw [← Scheme.IdealSheafData.comap_comp] at this
    rw [Functor.map_comp]
    exact this
  rw [e1, e1] at key
  have hb : Function.Bijective A.1.topIso.inv.hom := ConcreteCategory.bijective_of_isIso A.1.topIso.inv
  intro r hr
  have := key (Ideal.mem_map_of_mem _ hr)
  have h9 := Ideal.comap_map_of_bijective _ hb
    (I := ((chartJ ho actX φ).comap ((SCH).map c')).ideal A)
  rw [← h9]
  exact this

variable {φ}
  (hs : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Surjective.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS))) φ)
  (he : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Etale.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS))) φ)

include he in
/-- `J_V` is invariant under `V ×_X V`. -/
theorem chartJ_invariant : Space.IsInvariantSubscheme B S hS hs
    (Subobject.mk (chartJ ho actX φ).subschemeι) := by
  have hw : yoneda.map (Space.atlasRelationTarget B S hS hs) ≫ φ =
      yoneda.map (Space.atlasRelationSource B S hS hs) ≫ φ := by
    simpa using hs.rep.w φ
  have hv : ∀ (c c' : Space.atlasRelation B S hS hs ⟶ V), yoneda.map c ≫ φ = yoneda.map c' ≫ φ →
      φ.app (op _) c = smX actX 1 (φ.app (op _) c') := by
    intro c c' h
    rw [smX_one]
    have e := congrArg yonedaEquiv h
    rw [yonedaEquiv_comp, yonedaEquiv_comp, yonedaEquiv_yoneda_map, yonedaEquiv_yoneda_map] at e
    exact e
  have hf1 : Flat ((SCH).map (Space.atlasRelationTarget B S hS hs)) := by
    have := Space.etale_atlasRelationTarget B S hS hs he
    infer_instance
  have hf2 : Flat ((SCH).map (Space.atlasRelationSource B S hS hs)) := by
    have := Space.etale_atlasRelationSource B S hS hs he
    infer_instance
  dsimp only [Space.IsInvariantSubscheme]
  rw [pullback_mk_subscheme, pullback_mk_subscheme]
  have e : (chartJ ho actX φ).comap ((SCH).map (Space.atlasRelationTarget B S hS hs)) =
      (chartJ ho actX φ).comap ((SCH).map (Space.atlasRelationSource B S hS hs)) :=
    le_antisymm (comap_chartJ_le ho actX φ _ _ hf2 1 (hv _ _ hw))
      (comap_chartJ_le ho actX φ _ _ hf1 1 (hv _ _ hw.symm))
  rw [e]

variable (φ) in
/-- **`P`**: the stable closed subspace of the effectivity step, the scheme-theoretic image of `G × P₀ → X`. -/
noncomputable def stableP : Subfunctor X :=
  Space.invariantSubspace B S hS φ (Subobject.mk (chartJ ho actX φ).subschemeι)

include hs he in
/-- `P` is a closed subspace. -/
theorem isClosedSubspace_stableP (hX : IsAlgebraicSpace B S hS X) :
    Space.IsClosedSubspace B S hS (stableP ho actX φ) := by
  have hci : IsClosedImmersion (Subobject.mk (chartJ ho actX φ).subschemeι).arrow := mk_arrow_closed _
  have him : AlgebraicGeometry.IsImmersion (Subobject.mk (chartJ ho actX φ).subschemeι).arrow :=
    inferInstance
  have hinv := chartJ_invariant ho actX hs he
  have hA := Space.isAlgebraicSpace_and_presheaf_invariantSubspace B S hS hs he
    (Space.isEffectiveDescentAlongSurjectiveEtale_isClosedImmersion B S hS) hX _ him hci hinv
  have hloc := Stacks.Descent.isClosedImmersion_isLocalAtTarget_fpqc
  exact ⟨hA.1, Space.presheaf_invariantSubspace_of_isLocalAtTarget B S hS hs he _ him hci hinv
    hA.2.rep⟩

include hs he in
/-- `P` is stable. -/
theorem smX_mem_stableP {T : BigFppfOver B S hS} (h : Multiplicative M →* Γ((SCH).obj T, ⊤))
    {x : X.obj (op T)} (hx : x ∈ (stableP ho actX φ).obj (op T)) :
    smX actX h x ∈ (stableP ho actX φ).obj (op T) := by
  intro T' g f hf
  refine (Space.mem_subschemePoints_iff B S hS _).2 ((factors_mk_subschemeι_iff _ _).2 ?_)
  let t := yonedaEquiv.symm (X.map g.op x)
  let q := hs.rep.snd t
  have hqs : Surjective ((SCH).map q) := hs.property_snd t
  have hqe : Etale ((SCH).map q) := he.property_snd t
  let c2 : hs.rep.pullback t ⟶ V := yoneda.preimage (hs.rep.fst t)
  have hc2y : yoneda.map c2 ≫ φ = yoneda.map q ≫ t := by
    rw [Functor.map_preimage]; exact hs.rep.w t
  have hc2 : φ.app (op _) c2 = X.map q.op (X.map g.op x) := by
    have e := congrArg yonedaEquiv hc2y
    rw [yonedaEquiv_comp, yonedaEquiv_comp, yonedaEquiv_yoneda_map, yonedaEquiv_yoneda_map] at e
    refine e.trans ?_
    simp [t]
  have hc2bot : (chartJ ho actX φ).comap ((SCH).map c2) = ⊥ := by
    exact (factors_mk_subschemeι_iff _ _).1 ((Space.mem_subschemePoints_iff B S hS _).1
      (hx _ (q ≫ g) c2 (hc2.trans (by rw [op_comp, Functor.map_comp_apply]))))
  refine eq_bot_of_comap_eq_bot q hqs hqe _ ?_
  let h2 : Multiplicative M →* Γ((SCH).obj (hs.rep.pullback t), ⊤) :=
    secPt ((SCH).map q).appTop.hom (secPt ((SCH).map g).appTop.hom h)
  have hψ : (evalAt ((SCH).map c2).appTop.hom h2).comp (ι1 V (M := M)) = ((SCH).map c2).appTop.hom :=
    RingHom.ext fun b => evalAt_ι _ _ b
  obtain ⟨τ, hτ1, hτ2⟩ := exists_spLift (ι1 V (M := M)) contains1 c2 _ hψ
  have hres : secPt ((SCH).map τ).appTop.hom (univPt1 (U := V)) = h2 :=
    MonoidHom.ext fun m => by
      refine (hτ2 _).trans ?_
      refine (evalAt_single _ _ (Multiplicative.toAdd m) 1).trans ?_
      rw [map_one, one_mul]
      rfl
  have hmain : X.map τ.op (univX actX (yonedaEquiv φ)) = φ.app (op _) (q ≫ f) := by
    have e1 : X.map τ.op (X.map (gmπ (M := M) V).op (yonedaEquiv φ)) = φ.app (op _) c2 := by
      rw [← Functor.map_comp_apply, ← op_comp]
      change X.map (τ ≫ spToT V (ι1 V (M := M)) contains1).op _ = _
      rw [hτ1, map_yonedaEquiv]
      rfl
    have e2 : φ.app (op _) (q ≫ f) = X.map q.op (φ.app (op _) f) :=
      NatTrans.naturality_apply φ q.op f
    unfold univX
    rw [smX_map, hres, e1, hc2, e2, hf, smX_map, smX_map]
  let a := yonedaEquiv.symm (univX actX (yonedaEquiv φ))
  let r0 := hs.rep.snd a
  let q1 : hs.rep.pullback a ⟶ V := yoneda.preimage (hs.rep.fst a)
  have hq1y : yoneda.map q1 ≫ φ = yoneda.map r0 ≫ a := by
    rw [Functor.map_preimage]; exact hs.rep.w a
  have hq1 : φ.app (op _) q1 = X.map r0.op (univX actX (yonedaEquiv φ)) := by
    have e := congrArg yonedaEquiv hq1y
    rw [yonedaEquiv_comp, yonedaEquiv_comp, yonedaEquiv_yoneda_map, yonedaEquiv_yoneda_map] at e
    refine e.trans ?_
    simp [a]
  have hfl : Flat ((SCH).map (r0 ≫ gmπ (M := M) V)) := by
    have h1 : Etale ((SCH).map r0) := he.property_snd a
    have h2 : Flat ((SCH).map (gmπ (M := M) V)) := flat_gmπ
    rw [Functor.map_comp]
    infer_instance
  have e : φ.app (op _) q1 = smX actX (secPt ((SCH).map r0).appTop.hom (univPt1 (U := V)))
      (φ.app (op _) (r0 ≫ gmπ (M := M) V)) := by
    rw [hq1]
    unfold univX
    rw [smX_map, ← map_yonedaEquiv, op_comp, Functor.map_comp_apply]
  have hle := comap_chartJ_le ho actX φ q1 (r0 ≫ gmπ (M := M) V) hfl _ e
  have hw : yoneda.map (q ≫ f) ≫ φ = yoneda.map τ ≫ a := by
    apply yonedaEquiv.injective
    rw [yonedaEquiv_comp, yonedaEquiv_comp, yonedaEquiv_yoneda_map, yonedaEquiv_yoneda_map]
    simp only [a]
    exact (hmain.symm)
  let l : hs.rep.pullback t ⟶ hs.rep.pullback a := hs.rep.lift (yoneda.map (q ≫ f)) τ hw
  have hl1 : l ≫ q1 = q ≫ f := yoneda.map_injective (by
    rw [Functor.map_comp, Functor.map_preimage]
    exact hs.rep.lift_fst _ _ _)
  have hl2 : l ≫ r0 = τ := hs.rep.lift_snd _ _ _
  have hfin : (chartJ ho actX φ).comap ((SCH).map (q ≫ f)) ≤
      (chartJ ho actX φ).comap ((SCH).map c2) := by
    have this : ((chartJ ho actX φ).comap ((SCH).map q1)).comap ((SCH).map l) ≤
        ((chartJ ho actX φ).comap ((SCH).map (r0 ≫ gmπ (M := M) V))).comap ((SCH).map l) :=
      Scheme.IdealSheafData.comap_mono (f := (SCH).map l) hle
    rw [← Scheme.IdealSheafData.comap_comp, ← Scheme.IdealSheafData.comap_comp, ← Functor.map_comp,
      ← Functor.map_comp, hl1, ← Category.assoc, hl2] at this
    have e3 : τ ≫ gmπ (M := M) V = c2 := hτ1
    rwa [e3] at this
  rw [hc2bot, le_bot_iff, Functor.map_comp, Scheme.IdealSheafData.comap_comp] at hfin
  exact hfin

/-- The action of `D(M)` on `P`. -/
def stableAct : AAction (fppfO B S hS) M (stableP ho actX φ).toFunctor where
  smul {T} h x := ⟨actX.smul h x.1, smX_mem_stableP ho actX hs he (T := T.unop) h x.2⟩
  one_smul x := Subtype.ext (actX.one_smul x.1)
  mul_smul g h x := Subtype.ext (actX.mul_smul g h x.1)
  map_smul f h x := Subtype.ext (actX.map_smul f h x.1)

lemma stableAct_equiv : IsEquivariant (stableAct ho actX hs he) actX (stableP ho actX φ).ι :=
  fun _ _ => rfl

variable (φ) in
/-- `J_V` is inside the ideal of `P₀`. -/
lemma chartJ_le_idealOf : chartJ ho actX φ ≤ idealOf ho φ := by
  refine Scheme.IdealSheafData.le_of_isAffine ?_
  change topI (chartJ ho actX φ) ≤ topI (idealOf ho φ)
  rw [topI_chartJ]
  have hψ : (evalAt ((SCH).map (𝟙 V)).appTop.hom (1 : Multiplicative M →* _)).comp (ι1 V (M := M)) =
      ((SCH).map (𝟙 V)).appTop.hom := RingHom.ext fun b => evalAt_ι _ _ b
  obtain ⟨s, hs1, hs2⟩ := exists_spLift (ι1 V (M := M)) contains1 (𝟙 V) _ hψ
  have hres : secPt ((SCH).map s).appTop.hom (univPt1 (U := V)) = 1 :=
    MonoidHom.ext fun m => by
      refine (hs2 _).trans ?_
      refine (evalAt_single _ _ (Multiplicative.toAdd m) 1).trans ?_
      simp
  have e0 : X.map s.op (univX actX (yonedaEquiv φ)) = yonedaEquiv φ := by
    unfold univX
    rw [smX_map, hres, smX_one, ← Functor.map_comp_apply, ← op_comp]
    change X.map (s ≫ spToT V (ι1 V (M := M)) contains1).op _ = _
    rw [hs1, CategoryTheory.op_id, FunctorToTypes.map_id_apply]
  intro r hr
  have h1 : ((SCH).map s).appTop.hom (((SCH).map (gmπ (M := M) V)).appTop.hom r) = r := by
    have e := congrArg (fun z => ((SCH).map z).appTop.hom r) hs1
    simp only [Functor.map_comp, Scheme.Hom.comp_appTop] at e
    simpa using e
  have h2 := topI_idealOf_map ho s (univX actX (yonedaEquiv φ))
  rw [e0, Equiv.symm_apply_apply] at h2
  rw [h2, ← h1]
  exact Ideal.mem_map_of_mem _ hr

/-- `P₀ ⊂ P`. -/
theorem o₀_mem_stableP {T : BigFppfOver B S hS} (z : P₀.obj (op T)) :
    o₀.app (op T) z ∈ (stableP ho actX φ).obj (op T) := by
  intro T' g f hf
  refine (Space.mem_subschemePoints_iff B S hS _).2 ((factors_mk_subschemeι_iff _ _).2 ?_)
  have hbot : idealOf ho (yoneda.map f ≫ φ) = ⊥ := by
    have e : yoneda.map f ≫ φ = yonedaEquiv.symm (P₀.map g.op z) ≫ o₀ := by
      apply yonedaEquiv.injective
      rw [yonedaEquiv_comp, yonedaEquiv_comp, yonedaEquiv_yoneda_map, Equiv.apply_symm_apply, hf]
      exact (NatTrans.naturality_apply o₀ g.op z).symm
    rw [e]
    exact idealOf_eq_bot_of_factors ho _
  rw [idealOf_comp] at hbot
  have hm : (chartJ ho actX φ).comap ((SCH).map f) ≤ (idealOf ho φ).comap ((SCH).map f) :=
    Scheme.IdealSheafData.comap_mono (f := (SCH).map f) (chartJ_le_idealOf ho actX φ)
  exact le_bot_iff.1 (hm.trans hbot.le)

end Stable

/-! ### The points -/

section Points

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {M : Type u} [AddCommGroup M] [AddMonoid.FG M]
  {X P₀ : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {o₀ : P₀ ⟶ X} (ho : ClosedP o₀)
  (actX : AAction (fppfO B S hS) M X)

local notation "SCH" => BigFppfOver.toScheme B S hS
local notation "E" => Space.pointsEquivScheme B S hS

open AlgebraicGeometry.Space (pointsMap range_pointsMap_yoneda_map
  preimage_range_pointsMap_eq_range_pointsMap_snd)

/-- The points of `T` over `P₀` are the support of `𝒥(t)`. -/
lemma mem_range_iff_support {W : BigFppfOver B S hS} (t : yoneda.obj W ⟶ X) (w : (SCH).obj W) :
    pointsMap B S hS (yoneda.obj W) t ((E W).symm w) ∈ Set.range (pointsMap B S hS P₀ o₀) ↔
      w ∈ (idealOf ho t).support := by
  have h1 := Set.ext_iff.1 (preimage_range_pointsMap_eq_range_pointsMap_snd B S hS ho.rep t)
    ((E W).symm w)
  rw [Set.mem_preimage] at h1
  rw [h1, range_pointsMap_yoneda_map]
  have hc := snd_closed ho t
  have h2 : ((idealOf ho t).support : Set ((SCH).obj W)) = Set.range ((SCH).map (ho.rep.snd t)) := by
    unfold idealOf
    rw [Scheme.Hom.support_ker]
    exact ((SCH).map (ho.rep.snd t)).isClosedEmbedding.isClosed_range.closure_eq
  have h3 := Set.ext_iff.1 h2 w
  constructor
  · rintro ⟨v, hv, e⟩
    rw [SetLike.mem_coe] at h3
    rw [h3, ← (E W).symm.injective e]
    exact hv
  · intro hw
    rw [SetLike.mem_coe] at h3
    exact ⟨w, h3.1 hw, rfl⟩

lemma mem_basicOpen_iff {Y : Scheme.{u}} [IsAffine Y] (x : Y) (g : Γ(Y, ⊤)) :
    x ∈ Y.basicOpen g ↔ g ∉ (Y.isoSpec.hom x).asIdeal := by
  rw [← Scheme.map_PrimeSpectrum_basicOpen_of_affine]
  exact Iff.rfl

lemma mem_basicOpen_pow {Y : Scheme.{u}} {x : Y} {g : Γ(Y, ⊤)} (h : x ∈ Y.basicOpen g) (N : ℕ) :
    x ∈ Y.basicOpen (g ^ N) := by
  induction N with
  | zero => simp
  | succ N ih => rw [pow_succ, Scheme.basicOpen_mul]; exact ⟨ih, h⟩

variable {V : BigFppfOver B S hS} [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
  (φ : yoneda.obj V ⟶ X)

/-- **The correct radical**: a point of `V(J_V)` lies over `P₀`, if `|P₀|` is stable. -/
theorem range_of_vanishing
    (hst : ∀ {A : BigFppfOver B S hS} (t : X.obj (op A))
      (h : Multiplicative M →* Γ((SCH).obj A, ⊤)) (w : (SCH).obj A),
      pointsMap B S hS (yoneda.obj A) (yonedaEquiv.symm (smX actX h t)) ((E A).symm w) ∈
        Set.range (pointsMap B S hS P₀ o₀) →
      pointsMap B S hS (yoneda.obj A) (yonedaEquiv.symm t) ((E A).symm w) ∈
        Set.range (pointsMap B S hS P₀ o₀))
    (v : (SCH).obj V) (hv : ∀ g ∈ imgI ho actX (yonedaEquiv φ), v ∉ ((SCH).obj V).basicOpen g) :
    pointsMap B S hS (yoneda.obj V) φ ((E V).symm v) ∈ Set.range (pointsMap B S hS P₀ o₀) := by
  rw [mem_range_iff_support ho,
    Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨⊤, isAffineOpen_top _⟩) trivial,
    Scheme.mem_zeroLocus_iff]
  intro r hr hvr
  have hrad : ((SCH).map (gmπ (M := M) V)).appTop.hom r ∈
      (topI (idealOf ho (yonedaEquiv.symm (univX actX (yonedaEquiv φ))))).radical := by
    rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
    rintro 𝔮 ⟨hK, h𝔮⟩
    by_contra hn
    let Y := (SCH).obj (gmObj (M := M) V)
    let pt : Spec Γ(Y, ⊤) := (⟨𝔮, h𝔮⟩ : PrimeSpectrum Γ(Y, ⊤))
    let y : (SCH).obj (gmObj (M := M) V) := Y.isoSpec.inv pt
    have hy : Y.isoSpec.hom y = pt := by
      have h : (Y.isoSpec.inv ≫ Y.isoSpec.hom) pt = pt := by rw [Iso.inv_hom_id]; rfl
      exact (Scheme.Hom.comp_apply _ _ _).symm.trans h
    have hsup : y ∈ (idealOf ho (yonedaEquiv.symm (univX actX (yonedaEquiv φ)))).support := by
      rw [Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨⊤, isAffineOpen_top _⟩) trivial,
        Scheme.mem_zeroLocus_iff]
      intro g hg hyg
      rw [mem_basicOpen_iff, hy] at hyg
      exact hyg (hK hg)
    have h1 := (mem_range_iff_support ho _ y).2 hsup
    have h2 := hst _ _ y h1
    have e : yonedaEquiv.symm (X.map (gmπ (M := M) V).op (yonedaEquiv φ)) =
        yoneda.map (gmπ (M := M) V) ≫ φ := by
      rw [← yoneda_map_comp_pt, Equiv.symm_apply_apply]
    rw [e, Space.pointsMap_comp_apply, ← Space.pointsEquivScheme_symm_map,
      mem_range_iff_support ho, Scheme.IdealSheafData.mem_support_iff_of_mem
        (U := ⟨⊤, isAffineOpen_top _⟩) trivial, Scheme.mem_zeroLocus_iff] at h2
    have h3 := h2 r hr
    refine hn ?_
    by_contra hn'
    refine h3 ?_
    have h4 : y ∈ ((SCH).obj (gmObj (M := M) V)).basicOpen
        (((SCH).map (gmπ (M := M) V)).appTop.hom r) := by
      rw [mem_basicOpen_iff, hy]; exact hn'
    have h5 := Scheme.preimage_basicOpen ((SCH).map (gmπ (M := M) V)) r
    have h6 : y ∈ ((SCH).map (gmπ (M := M) V)) ⁻¹ᵁ ((SCH).obj V).basicOpen r := by
      rw [h5]
      exact h4
    exact h6
  obtain ⟨N, hN⟩ := hrad
  have hmem : r ^ N ∈ imgI ho actX (yonedaEquiv φ) := by
    unfold imgI
    rw [Ideal.mem_comap, map_pow]
    exact hN
  exact hv _ hmem (mem_basicOpen_pow hvr N)

end Points

/-! ### The tower -/

section Tower

open AlgebraicGeometry.Space (pointsMap pointsMap_comp_apply points FieldValuedPoint)

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {M : Type u} [AddCommGroup M] [AddMonoid.FG M]
  {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
  (actX : AAction (fppfO B S hS) M X)

local notation "SCH" => BigFppfOver.toScheme B S hS
local notation "E" => Space.pointsEquivScheme B S hS

omit [AddMonoid.FG M] in
lemma map_symm_app {A T T' : BigFppfOver B S hS} (e : T' ⟶ T) (v : T ⟶ A) (t : X.obj (op A)) :
    X.map e.op ((yonedaEquiv.symm t).app (op T) v) = X.map (e ≫ v).op t := by
  have h1 : (yonedaEquiv.symm t).app (op T) v = X.map v.op t := rfl
  rw [h1, ← Functor.map_comp_apply, ← op_comp]

/-- A stable map: `h • t` over the image of `f` if `t` is. -/
lemma pts_smul {Uo : BigFppfOver B S hS} {actU : AAction (fppfO B S hS) M (yoneda.obj Uo)}
    {fU : yoneda.obj Uo ⟶ X} (hfe : IsEquivariant actU actX fU)
    {A : BigFppfOver B S hS} (t : X.obj (op A)) (h : Multiplicative M →* Γ((SCH).obj A, ⊤))
    (w : points B S hS (yoneda.obj A))
    (ht : pointsMap B S hS (yoneda.obj A) (yonedaEquiv.symm t) w ∈
      Set.range (pointsMap B S hS (yoneda.obj Uo) fU)) :
    pointsMap B S hS (yoneda.obj A) (yonedaEquiv.symm (smX actX h t)) w ∈
      Set.range (pointsMap B S hS (yoneda.obj Uo) fU) := by
  obtain ⟨p, rfl⟩ := Quot.exists_rep w
  obtain ⟨u, hu⟩ := ht
  obtain ⟨q, rfl⟩ := Quot.exists_rep u
  have hu' := (FieldValuedPoint.class_eq_class_iff B S hS X _ _).1 hu
  obtain ⟨r, ⟨e1, he1⟩, ⟨e2, he2⟩⟩ := hu'
  have he2' : X.map (e2 ≫ p.value).op t = r.value := (map_symm_app e2 p.value t).symm.trans he2
  let res : Multiplicative M →* Γ((SCH).obj r.siteObject, ⊤) :=
    secPt ((SCH).map (e2 ≫ p.value)).appTop.hom h
  let q2 : FieldValuedPoint B S hS (yoneda.obj Uo) :=
    { carrier := r.carrier, field := r.field, contained := r.contained, toBase := r.toBase,
      value := actU.smul (U := op r.siteObject) res (e1 ≫ q.value) }
  have he1' : fU.app (op r.siteObject) (e1 ≫ q.value) = r.value := by
    rw [← he1]
    exact NatTrans.naturality_apply fU e1.op q.value
  have hv : fU.app (op r.siteObject) q2.value = smX actX res r.value := by
    rw [← he1']
    exact hfe (T := op r.siteObject) res (e1 ≫ q.value)
  refine ⟨Quot.mk _ q2, ?_⟩
  refine FieldValuedPoint.class_eq_class_of_hasCommonExtension B S hS X ?_
  refine ⟨_, FieldValuedPoint.dominates_refl B S hS X _, ⟨e2, ?_⟩⟩
  refine Eq.trans ?_ hv.symm
  refine (map_symm_app e2 p.value _).trans ?_
  rw [smX_map, he2']

variable {P₀ : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {o₀ : P₀ ⟶ X} (ho : ClosedP o₀)
  {V : BigFppfOver B S hS} [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
  {φ : yoneda.obj V ⟶ X}
  (hs : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Surjective.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS))) φ)
  (he : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Etale.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS))) φ)

include hs he in
/-- `P → X` is a closed immersion. -/
lemma stableP_closedP (hX : IsAlgebraicSpace B S hS X) : ClosedP (stableP ho actX φ).ι :=
  (isClosedSubspace_stableP ho actX hs he hX).2

/-- `Z^(k)`: the `V(J^{k+1})` of `P → X`. -/
noncomputable def strataZ (hX : IsAlgebraicSpace B S hS X) (k : ℕ) : Subfunctor X :=
  thickening (stableP_closedP actX ho hs he hX) φ k

/-- **The tower of the effectivity step.** -/
noncomputable def chartTower (hX : IsAlgebraicSpace B S hS X) : ClosedTower actX where
  Z k := (strataZ actX ho hs he hX k).toFunctor
  actZ k := thickeningAction (stableP_closedP actX ho hs he hX) hs he
    (stableAct_equiv ho actX hs he) k
  i k := (strataZ actX ho hs he hX k).ι
  equiv _ := fun _ _ => rfl
  mono _ _ := Subtype.val_injective

/-- `Z^(k)` is a closed subspace. -/
theorem chartTower_closed (hX : IsAlgebraicSpace B S hS X) (k : ℕ) :
    Space.IsClosedSubspace B S hS (strataZ actX ho hs he hX k) :=
  isClosedSubspace_thickening _ hX hs he k

/-- **The points of `Z^(k)`** are those of `P₀`, for `|P₀|` the complement of a stable `U`. -/
theorem range_chartTower (hX : IsAlgebraicSpace B S hS X)
    {Uo : BigFppfOver B S hS} {actU : AAction (fppfO B S hS) M (yoneda.obj Uo)}
    {fU : yoneda.obj Uo ⟶ X} (hfe : IsEquivariant actU actX fU)
    (hT : Set.range (pointsMap B S hS P₀ o₀) = (Set.range (pointsMap B S hS (yoneda.obj Uo) fU))ᶜ)
    (k : ℕ) :
    Set.range (pointsMap B S hS _ (strataZ actX ho hs he hX k).ι) =
      Set.range (pointsMap B S hS P₀ o₀) := by
  have hst : ∀ {A : BigFppfOver B S hS} (t : X.obj (op A))
      (h : Multiplicative M →* Γ((SCH).obj A, ⊤)) (w : (SCH).obj A),
      pointsMap B S hS (yoneda.obj A) (yonedaEquiv.symm (smX actX h t)) ((E A).symm w) ∈
        Set.range (pointsMap B S hS P₀ o₀) →
      pointsMap B S hS (yoneda.obj A) (yonedaEquiv.symm t) ((E A).symm w) ∈
        Set.range (pointsMap B S hS P₀ o₀) := by
    intro A t h w h1
    rw [hT] at h1 ⊢
    intro h2
    exact h1 (pts_smul actX hfe t h _ h2)
  have hP := stableP_closedP actX ho hs he hX
  -- a point of `P` lies over `P₀`
  have hPsub : Set.range (pointsMap B S hS _ (stableP ho actX φ).ι) ⊆
      Set.range (pointsMap B S hS P₀ o₀) := by
    rintro _ ⟨y, rfl⟩
    obtain ⟨y0, rfl⟩ := Quot.exists_rep y
    have hsurj : Function.Surjective (pointsMap B S hS (yoneda.obj V) φ) :=
      (Space.presheafSurjective_iff_isSurjective_yoneda B S hS X hX V φ).1 hs
    obtain ⟨v, hv⟩ := hsurj (pointsMap B S hS _ (stableP ho actX φ).ι (Quot.mk _ y0))
    obtain ⟨c0, rfl⟩ := Quot.exists_rep v
    obtain ⟨r, ⟨e1, he1⟩, ⟨e2, he2⟩⟩ := (FieldValuedPoint.class_eq_class_iff B S hS X _ _).1 hv
    let c : r.siteObject ⟶ V := e1 ≫ c0.value
    have hc : φ.app (op _) c = r.value := by
      rw [← he1]
      exact NatTrans.naturality_apply φ e1.op c0.value
    have hcP : c ∈ (Space.subschemePoints B S hS
        (Subobject.mk (chartJ ho actX φ).subschemeι)).obj (op _) :=
      y0.value.2 _ e2 c (hc.trans he2.symm)
    have hbot := (factors_mk_subschemeι_iff _ _).1 ((Space.mem_subschemePoints_iff B S hS _).1 hcP)
    haveI : IsAffine ((SCH).obj r.siteObject) := inferInstanceAs (IsAffine (Spec _))
    let c0' : FieldValuedPoint B S hS (yoneda.obj V) :=
      { carrier := r.carrier, field := r.field, contained := r.contained, toBase := r.toBase,
        value := c }
    let w : (SCH).obj r.siteObject := IsLocalRing.closedPoint r.carrier
    have hsym : (E V).symm (((SCH).map c) w) = Quot.mk _ c0 := by
      refine (E V).symm_apply_eq.2 ?_
      refine Eq.trans (?_ : _ = Space.schemePoint B S hS V c0') ?_
      · rfl
      · exact Space.schemePoint_eq_of_dominates B S hS V (p := c0') (q := c0) ⟨e1, rfl⟩
    have hvan : ∀ g ∈ imgI ho actX (yonedaEquiv φ), ((SCH).map c) w ∉ ((SCH).obj V).basicOpen g := by
      intro g hg hmem
      have h1 : ((SCH).map c).appTop.hom g ∈ topI ((chartJ ho actX φ).comap ((SCH).map c)) := by
        rw [topI_comap_chartJ]
        exact Ideal.mem_map_of_mem _ hg
      rw [hbot] at h1
      have h0 : ((SCH).map c).appTop.hom g = 0 := by simpa [topI] using h1
      have h6 : w ∈ ((SCH).map c) ⁻¹ᵁ ((SCH).obj V).basicOpen g := hmem
      rw [Scheme.preimage_basicOpen] at h6
      have h2 : w ∈ ((SCH).obj r.siteObject).basicOpen (((SCH).map c).appTop.hom g) := h6
      rw [h0, Scheme.basicOpen_zero] at h2
      exact h2
    have := range_of_vanishing ho actX φ hst _ hvan
    rw [hsym] at this
    rwa [hv] at this
  have hsup : ∀ {A : BigFppfOver B S hS} (t : yoneda.obj A ⟶ X) (w : (SCH).obj A),
      w ∈ (idealOf hP t).support →
      pointsMap B S hS (yoneda.obj A) t ((E A).symm w) ∈ Set.range (pointsMap B S hS P₀ o₀) :=
    fun t w hw => hPsub ((mem_range_iff_support hP t w).2 hw)
  apply Set.Subset.antisymm
  · rintro _ ⟨y, rfl⟩
    obtain ⟨y0, rfl⟩ := Quot.exists_rep y
    -- `y0.value ∈ X_k`
    let z : X.obj (op y0.siteObject) := y0.value.1
    have hz := (mem_thickening_iff hP hs he k z).1 y0.value.2
    let ip : FieldValuedPoint B S hS (yoneda.obj y0.siteObject) :=
      { carrier := y0.carrier, field := y0.field, contained := y0.contained, toBase := y0.toBase,
        value := 𝟙 _ }
    have h1 : y0.siteObject = ip.siteObject := rfl
    let w : (SCH).obj y0.siteObject := Space.pointsEquivScheme B S hS _ (Quot.mk _ ip)
    have hwsup : w ∈ (idealOf hP (yonedaEquiv.symm z)).support := by
      have hs1 : ((idealOf hP (yonedaEquiv.symm z)) ^ (k + 1)).support =
          (idealOf hP (yonedaEquiv.symm z)).support := rfl
      rw [← hs1, hz, Scheme.IdealSheafData.support_bot]
      trivial
    have h2 := hsup (yonedaEquiv.symm z) w hwsup
    have h3 : (E y0.siteObject).symm w = Quot.mk _ ip := Equiv.symm_apply_apply _ _
    rw [h3] at h2
    have h4 : pointsMap B S hS (yoneda.obj y0.siteObject) (yonedaEquiv.symm z) (Quot.mk _ ip) =
        pointsMap B S hS _ (strataZ actX ho hs he hX k).ι (Quot.mk _ y0) := by
      refine FieldValuedPoint.class_eq_class_of_hasCommonExtension B S hS X ?_
      refine ⟨Space.FieldValuedPoint.map B S hS _ (strataZ actX ho hs he hX k).ι y0,
        ⟨𝟙 _, ?_⟩, FieldValuedPoint.dominates_refl B S hS X _⟩
      refine (map_symm_app (𝟙 y0.siteObject) (𝟙 y0.siteObject) z).trans ?_
      change X.map (𝟙 y0.siteObject ≫ 𝟙 y0.siteObject).op z = z
      simp
    rw [← h4]
    exact h2
  · rintro _ ⟨y, rfl⟩
    have hmem : ∀ (T : (BigFppfOver B S hS)ᵒᵖ) (a : P₀.obj T),
        o₀.app T a ∈ (strataZ actX ho hs he hX k).obj T := by
      rintro ⟨T⟩ a
      refine (mem_thickening_iff hP hs he k _).2 ?_
      have h1 : o₀.app (op T) a ∈ (stableP ho actX φ).obj (op T) := o₀_mem_stableP ho actX a
      let a0 : (stableP ho actX φ).toFunctor.obj (op T) := ⟨_, h1⟩
      have h2 : yonedaEquiv.symm (o₀.app (op T) a) =
          yonedaEquiv.symm a0 ≫ (stableP ho actX φ).ι := by
        apply yonedaEquiv.injective
        rw [yonedaEquiv_comp, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        rfl
      rw [h2, idealOf_eq_bot_of_factors hP]
      rw [pow_succ, Scheme.IdealSheafData.mul_bot]
    let l : P₀ ⟶ (strataZ actX ho hs he hX k).toFunctor :=
      { app := fun T => TypeCat.ofHom fun a => ⟨o₀.app T a, hmem T a⟩
        naturality := by
          intro T T' f
          ext a
          exact Subtype.ext (show o₀.app T' (P₀.map f a) = X.map f (o₀.app T a) from
            NatTrans.naturality_apply o₀ f a) }
    refine ⟨pointsMap B S hS _ l y, ?_⟩
    rw [← pointsMap_comp_apply]
    rfl

end Tower

/-! ### The strata of the complement of a stable open -/

section Main

open AlgebraicGeometry.Space (pointsMap points)

attribute [local instance] Space.pointTopology

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {M : Type u} [AddCommGroup M] [AddMonoid.FG M]
  {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
  (actX : AAction (fppfO B S hS) M X)

local notation "SCH" => BigFppfOver.toScheme B S hS

variable {Uo : BigFppfOver B S hS} {fU : yoneda.obj Uo ⟶ X}

/-- `|X| \ U` is closed. -/
lemma isClosed_compl_open (hfo : Space.IsOpenImmersion B S hS fU) :
    IsClosed (Set.range (pointsMap B S hS (yoneda.obj Uo) fU))ᶜ :=
  (Space.isOpen_range_pointsMap_of_isOpenImmersion B S hS fU hfo).isClosed_compl

/-- `P₀`: the reduced closed subspace on `|X| \ U`. It need not be stable. -/
noncomputable def complP₀ (hX : IsAlgebraicSpace B S hS X) (hfo : Space.IsOpenImmersion B S hS fU) :
    Subfunctor X :=
  Space.reducedClosedSubspace B S hS X hX _ (isClosed_compl_open hfo)

lemma complP₀_closedP (hX : IsAlgebraicSpace B S hS X) (hfo : Space.IsOpenImmersion B S hS fU) :
    ClosedP (complP₀ hX hfo).ι :=
  (Space.isClosedSubspace_reducedClosedSubspace B S hS X hX _ (isClosed_compl_open hfo)).2

variable {V : BigFppfOver B S hS} [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
  {φ : yoneda.obj V ⟶ X}
  (hs : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Surjective.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS))) φ)
  (he : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Etale.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS))) φ)

/-- **Effectivity step, the closed strata** `Z^(k)` with complement `U`, from the affine chart `φ`. -/
noncomputable def complTower (hX : IsAlgebraicSpace B S hS X)
    (hfo : Space.IsOpenImmersion B S hS fU) : ClosedTower actX :=
  chartTower actX (complP₀_closedP hX hfo) hs he hX

/-- **Effectivity step, setup**: for `U` a stable open of the algebraic space `X` with an affine chart, each
`Z^(k)` is a closed algebraic subspace, stable by construction, with point set `|X| \ U`. -/
theorem complTower_spec (hX : IsAlgebraicSpace B S hS X)
    {actU : AAction (fppfO B S hS) M (yoneda.obj Uo)} (hfe : IsEquivariant actU actX fU)
    (hfo : Space.IsOpenImmersion B S hS fU) :
    (∀ k, Space.IsClosedImmersion B S hS ((complTower actX hs he hX hfo).i k)) ∧
    (∀ k, IsAlgebraicSpace B S hS ((complTower actX hs he hX hfo).Z k)) ∧
    (∀ k, Set.range (pointsMap B S hS _ ((complTower actX hs he hX hfo).i k)) =
      (Set.range (pointsMap B S hS (yoneda.obj Uo) fU))ᶜ) := by
  have hc := fun k => chartTower_closed actX (complP₀_closedP hX hfo) hs he hX k
  refine ⟨fun k => (hc k).2, fun k => (hc k).1, fun k => ?_⟩
  have hT := Space.range_pointsMap_ι_reducedClosedSubspace B S hS X hX _ (isClosed_compl_open hfo)
  exact (range_chartTower actX (complP₀_closedP hX hfo) hs he hX hfe hT k).trans hT

/-- `X` has an affine atlas (`X` is quasi-compact). This hypothesis makes `V[M]`
available as `spObj`. -/
def HasAffineAtlas (X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) : Prop :=
  ∃ (V : BigFppfOver B S hS) (φ : yoneda.obj V ⟶ X), IsAffine ((SCH).obj V) ∧
    (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Surjective.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS))) φ ∧
    (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@Etale.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS))) φ

variable {X₀ : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {act₀ : AAction (fppfO B S hS) M X₀}

/-- A closed subspace of a space with an affine atlas has one. -/
theorem HasAffineAtlas.closedStable (h : HasAffineAtlas X₀) (C : ClosedStable act₀) :
    HasAffineAtlas C.Z := by
  obtain ⟨V, φ, hA, hs, he⟩ := h
  let sq := C.closed.rep.isPullback φ
  have hcl : IsClosedImmersion ((SCH).map (C.closed.rep.snd φ)) := C.closed.property_snd φ
  refine ⟨C.closed.rep.pullback φ, C.closed.rep.fst φ, ?_, ?_, ?_⟩
  · exact isAffine_of_isAffineHom ((SCH).map (C.closed.rep.snd φ))
  · exact MorphismProperty.of_isPullback sq.flip hs
  · exact MorphismProperty.of_isPullback sq.flip he

variable [DecidableEq M]

/-- **Lemma 4.3 for the tower of the effectivity step**, as a named proposition (not proved here). -/
def StrataOverChart (C : ClosedStable act₀) : Prop :=
  ∀ (U : BigFppfOver B S hS) (actU : AAction (fppfO B S hS) M (yoneda.obj U))
    (f : yoneda.obj U ⟶ C.Z), IsAffine ((SCH).obj U) → Nonempty ((SCH).obj U) →
    IsEquivariant actU C.actZ f →
    ∀ (hfo : Space.IsOpenImmersion B S hS f)
      (V : BigFppfOver B S hS) [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
      (φ : yoneda.obj V ⟶ C.Z)
      (hs : (MorphismProperty.presheaf (MorphismProperty.inverseImage
        (@Surjective.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS))) φ)
      (he : (MorphismProperty.presheaf (MorphismProperty.inverseImage
        (@Etale.{u} : MorphismProperty Scheme.{u}) (BigFppfOver.toScheme B S hS))) φ),
      OpenStratumMap (complTower C.actZ hs he C.alg hfo)

/-- **`StrataOver` from Lemma 4.3**: the tower is constructed, and only `OpenStratumMap` remains
as a hypothesis. -/
theorem strataOver_of_chart (C : ClosedStable act₀) (hA : HasAffineAtlas C.Z)
    (h : StrataOverChart C) : StrataOver C := by
  intro U actU f hUa hUn hfe hfo
  obtain ⟨V, φ, hV, hs, he⟩ := hA
  obtain ⟨h1, h2, h3⟩ := complTower_spec C.actZ hs he C.alg hfe hfo
  refine ⟨complTower C.actZ hs he C.alg hfo, h1, h2, fun k => ?_,
    h U actU f hUa hUn hfe hfo V φ hs he⟩
  rw [h3 k]
  exact disjoint_compl_left

/-- **Effectivity, existence**, with the setup of the closed strata discharged: what `effective_of_noetherian`
needs when `X₀` has an affine atlas is separatedness and `NoetherianAlgebraization` of the closed
stable subspaces (`hC`), Lemma 4.2 (`h42`) and Lemma 4.3 for `complTower` (`h43`). -/
theorem effective_of_noetherian_atlas
    (hX₀ : IsAlgebraicSpace B S hS X₀) (hA : HasAffineAtlas X₀)
    [TopologicalSpace.NoetherianSpace (points B S hS X₀)]
    (hC : ∀ C : ClosedStable act₀, Space.IsSeparatedOver B S hS C.Z ∧ NoetherianAlgebraization C.Z)
    (h42 : ∀ C : ClosedStable act₀, AffineStratum C.Z C.actZ)
    (h43 : ∀ C : ClosedStable act₀, StrataOverChart C)
    (C : ClosedStable act₀) : Effective C.actZ :=
  effective_of_noetherian hX₀ hC h42
    (fun C' => strataOver_of_chart C' (hA.closedStable C') (h43 C')) C

end Main

end AlgMag.ChartMain

#print axioms AlgMag.ChartMain.complTower_spec
#print axioms AlgMag.ChartMain.strataOver_of_chart
#print axioms AlgMag.ChartMain.effective_of_noetherian_atlas
