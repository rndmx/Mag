/-! ### Fact 2.10 (i) -/

section Redei

/-- A commutative monoid is finitely presented: a quotient of a free commutative monoid of finite
rank by the congruence generated by finitely many relations. -/
def AddMonoidFP (N : Type*) [AddCommMonoid N] : Prop :=
  ∃ (n : ℕ) (φ : (Fin n →₀ ℕ) →+ N) (P : Finset ((Fin n →₀ ℕ) × (Fin n →₀ ℕ))),
    Function.Surjective φ ∧
      ∀ a b, φ a = φ b ↔ addConGen (fun x y => (x, y) ∈ P) a b

open scoped Classical in
/-- Rédei: every additive congruence on `ℕ^n` is generated by a finite subset of itself. The proof
uses Hilbert's basis theorem for `ℤ[ℕ^n]`. -/
theorem exists_finite_relations {n : ℕ} {Q : Type*} [AddCommMonoid Q] (φ : (Fin n →₀ ℕ) →+ Q) :
    ∃ P : Finset ((Fin n →₀ ℕ) × (Fin n →₀ ℕ)),
      ∀ a b, φ a = φ b ↔ addConGen (fun x y => (x, y) ∈ P) a b := by
  let F := Fin n →₀ ℕ
  let A := AddMonoidAlgebra ℤ F
  have : IsNoetherianRing A := inferInstanceAs (IsNoetherianRing (MvPolynomial (Fin n) ℤ))
  let d : F × F → A := fun p => AddMonoidAlgebra.single p.1 1 - AddMonoidAlgebra.single p.2 1
  let pairs : Set (F × F) := {p | φ p.1 = φ p.2}
  have hfg : (Submodule.span A (d '' pairs)).FG := IsNoetherian.noetherian _
  obtain ⟨s', hs', hspan⟩ := Submodule.fg_span_iff_fg_span_finset_subset _ |>.mp hfg
  obtain ⟨P, hP, hPs⟩ := Finset.subset_set_image_iff.mp hs'
  refine ⟨P, fun a b => ⟨fun hab => ?_, fun hab => ?_⟩⟩
  · let c : AddCon F := addConGen (fun x y => (x, y) ∈ P)
    let q : A →+* AddMonoidAlgebra ℤ c.Quotient := AddMonoidAlgebra.mapDomainRingHom ℤ (c.mk')
    have hsq : ∀ x : F, q (AddMonoidAlgebra.single x 1) = AddMonoidAlgebra.single (c.mk' x) 1 :=
      fun x => AddMonoidAlgebra.mapDomain_single
    have hq : ∀ x ∈ Submodule.span A (d '' pairs), q x = 0 := by
      intro x hx
      rw [hspan, ← hPs] at hx
      induction hx using Submodule.span_induction with
      | mem y hy =>
        simp only [Finset.coe_image, Set.mem_image, Finset.mem_coe] at hy
        obtain ⟨p, hp, rfl⟩ := hy
        have e : c.mk' p.1 = c.mk' p.2 := (AddCon.eq c).mpr (AddConGen.Rel.of _ _ hp)
        simp only [d, map_sub, hsq, e, sub_self]
      | zero => simp
      | add x y _ _ hx hy => simp [hx, hy]
      | smul r x _ hx => simp [hx]
    have h0 := hq (d (a, b)) (Submodule.subset_span ⟨(a, b), hab, rfl⟩)
    simp only [d, map_sub, hsq, sub_eq_zero] at h0
    have h1 : c.mk' a = c.mk' b := by
      by_contra hne
      have := congrArg (fun x : AddMonoidAlgebra ℤ c.Quotient => x.coeff (c.mk' a)) h0
      simp only [AddMonoidAlgebra.coeff_single, Finsupp.single_eq_same,
        Finsupp.single_eq_of_ne hne] at this
      exact one_ne_zero this
    exact (AddCon.eq c).mp h1
  · have hle : addConGen (fun x y => (x, y) ∈ P) ≤ AddCon.ker φ := by
      refine AddCon.addConGen_le.mpr fun x y hxy => ?_
      have : ((x, y) : F × F) ∈ pairs := hP hxy
      exact this
    exact hle hab

/-- **Fact 2.10 (i).** A finitely generated commutative monoid is finitely presented. -/
theorem fact210_i (N : Type*) [AddCommMonoid N] [hN : AddMonoid.FG N] : AddMonoidFP N := by
  classical
  obtain ⟨s, hs⟩ := hN.fg_top
  let n := s.card
  let g : Fin n → N := fun i => (s.equivFin.symm i : N)
  have hg : AddSubmonoid.closure (Set.range g) = ⊤ := by
    rw [← hs]
    congr 1
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact (s.equivFin.symm i).2
    · intro hx
      exact ⟨s.equivFin ⟨x, hx⟩, by simp [g]⟩
  let φ : (Fin n →₀ ℕ) →+ N := (Finsupp.liftAddHom fun i => (multiplesHom N (g i)))
  obtain ⟨P, hP⟩ := exists_finite_relations φ
  refine ⟨n, φ, P, ?_, hP⟩
  have : AddMonoidHom.mrange φ = ⊤ := by
    rw [eq_top_iff, ← hg, AddSubmonoid.closure_le]
    rintro _ ⟨i, rfl⟩
    exact ⟨Finsupp.single i 1, by simp [φ]⟩
  exact AddMonoidHom.mrange_eq_top.mp this

end Redei

/-! ### Definition 2.20 -/

section Def220

variable {C : Type*} [Category C] (𝒪 : Cᵒᵖ ⥤ CommRingCat.{u}) (M : Type*) [AddCommMonoid M]

/-- **Definition 2.20.** A `𝔸(M)_S`-`𝒪_S`-module structure on the functor `W(F)`: on every `T` the
monoid `𝔸(M)(T)` acts on the `𝒪(T)`-module `W(T)` by linear maps, compatibly with morphisms
`T' → T`. The functor `W` is given with its `𝒪`-module structure. -/
structure ModuleAAction (W : Cᵒᵖ ⥤ Type u) [∀ U, AddCommGroup (W.obj U)]
    [∀ U, Module (𝒪.obj U) (W.obj U)] extends AAction 𝒪 M W where
  smul_add : ∀ {U : Cᵒᵖ} (h : APt 𝒪 M U) (x y : W.obj U), smul h (x + y) = smul h x + smul h y
  smul_smul_scalar : ∀ {U : Cᵒᵖ} (h : APt 𝒪 M U) (r : 𝒪.obj U) (x : W.obj U),
    smul h (r • x) = r • smul h x

end Def220

/-! ### Proposition 3.28, Example 1.2 -/

section Linear

variable (R : Type u) [CommRing R] {M : Type u} [AddCommMonoid M] [DecidableEq M]
variable (E : Type u) [AddCommGroup E] [Module R E]

/-- The functor of points of `V(E)` over `Spec R`: `V(E)(D) = Hom_R(E, D)`. -/
def affV : (Aff R)ᵒᵖ ⥤ Type u where
  obj U := E →ₗ[R] (unop (unop U) : CommAlgCat.{u} R)
  map f := ↾ fun x => f.unop.unop.hom.toLinearMap.comp x

/-- `V(E) = Spec_S (Sym E)`: the identification with the functor of points of the spectrum of the
symmetric algebra (statement of Proposition 3.28). -/
noncomputable def affVEquivSym (D : CommAlgCat.{u} R) :
    (E →ₗ[R] D) ≃ (SymmetricAlgebra R E →ₐ[R] D) := SymmetricAlgebra.lift

variable {E} (ℰ : M → Submodule R E) [DirectSum.Decomposition ℰ]

section Comp
variable {D : Type u} [AddCommGroup D] [Module R D]

/-- A linear map out of `E` from its components. -/
noncomputable def homOfComp (c : ∀ m, ℰ m →ₗ[R] D) : E →ₗ[R] D :=
  (DirectSum.toModule R M D c).comp (DirectSum.decomposeLinearEquiv ℰ).toLinearMap

lemma homOfComp_of_mem (c : ∀ m, ℰ m →ₗ[R] D) {m : M} {e : E} (he : e ∈ ℰ m) :
    homOfComp R ℰ c e = c m ⟨e, he⟩ := by
  have : (DirectSum.decomposeLinearEquiv ℰ) e = DirectSum.lof R M (fun i => ℰ i) m ⟨e, he⟩ :=
    DirectSum.decompose_of_mem ℰ he
  simp [homOfComp, this]

lemma linHom_ext {f g : E →ₗ[R] D} (h : ∀ (m : M) (a : E), a ∈ ℰ m → f a = g a) : f = g := by
  refine LinearMap.ext fun a => ?_
  induction a using DirectSum.Decomposition.inductionOn ℰ with
  | zero => simp
  | @homogeneous m x => exact h m x x.2
  | add a a' ha ha' => simp only [map_add, ha, ha']

end Comp

section Smul
variable {D : Type u} [CommRing D] [Algebra R D]

/-- The linear action of `h ∈ 𝔸(M)(D)` on `V(E)(D)`: multiply the weight `m` part by `h(m)`. -/
noncomputable def linSmul (h : Multiplicative M →* D) (f : E →ₗ[R] D) : E →ₗ[R] D :=
  homOfComp R ℰ fun m =>
    (LinearMap.mulLeft R (h (Multiplicative.ofAdd m))).comp (f.comp (ℰ m).subtype)

lemma linSmul_of_mem (h : Multiplicative M →* D) (f : E →ₗ[R] D) {m : M} {e : E} (he : e ∈ ℰ m) :
    linSmul R ℰ h f e = h (Multiplicative.ofAdd m) * f e := by
  rw [linSmul, homOfComp_of_mem R ℰ _ he]; rfl

end Smul

/-- **Proposition 3.28**, first assertion: `𝔸(M)` acts linearly on `V(E)`. -/
noncomputable def linAction : AAction (affO R) M (affV R E) where
  smul {U} h x := linSmul (D := (unop (unop U) : CommAlgCat.{u} R)) R ℰ h x
  one_smul {U} x := by
    let D : CommAlgCat.{u} R := unop (unop U)
    refine linHom_ext (D := D) R ℰ fun m a ha => ?_
    refine (linSmul_of_mem (D := D) R ℰ _ _ ha).trans ?_
    exact one_mul (M := D) _
  mul_smul {U} g h x := by
    let D : CommAlgCat.{u} R := unop (unop U)
    refine linHom_ext (D := D) R ℰ fun m a ha => ?_
    refine (linSmul_of_mem (D := D) R ℰ _ _ ha).trans ?_
    refine Eq.trans ?_ (linSmul_of_mem (D := D) R ℰ _ _ ha).symm
    refine Eq.trans (mul_assoc (G := D) _ _ _) (congrArg _ ?_)
    exact (linSmul_of_mem (D := D) R ℰ _ _ ha).symm
  map_smul {U V} f h x := by
    let D : CommAlgCat.{u} R := unop (unop U)
    let D' : CommAlgCat.{u} R := unop (unop V)
    let φ : D →ₐ[R] D' := f.unop.unop.hom
    refine linHom_ext (D := D') R ℰ fun m a ha => ?_
    refine Eq.trans ?_ (linSmul_of_mem (D := D') R ℰ _ _ ha).symm
    refine Eq.trans (congrArg φ (linSmul_of_mem (D := D) R ℰ _ _ ha)) ?_
    exact map_mul φ _ _

variable (N : AddSubmonoid M) (C : Type u) [CommRing C] [Algebra R C]

variable {ℰ N C} in
/-- The universal value `φ(X) : E → C[N]`. -/
noncomputable def linUniv (φ : AttractorPt (linAction R ℰ) N (op (CommAlgCat.of R C))) :
    E →ₗ[R] AddMonoidAlgebra C N :=
  φ.app (T' := op (CommAlgCat.of R (AddMonoidAlgebra C N))) (affHom (constAlg N C))
    (AddMonoidAlgebra.of C N)

variable {ℰ N C} in
/-- A point of the attractor of `V(E)` is graded (same argument as `AttractorPt.univ_mem`). -/
lemma linUniv_mem (φ : AttractorPt (linAction R ℰ) N (op (CommAlgCat.of R C))) {m : M}
    {a : E} (ha : a ∈ ℰ m) : linUniv R φ a ∈ magnetGrading N C m := by
  let B := AddMonoidAlgebra C N
  let E' := AddMonoidAlgebra B M
  let i : B →ₐ[R] E' := constAlg M B
  let Δ : B →ₐ[R] E' := diagGrading N C
  let X : Multiplicative N →* B := AddMonoidAlgebra.of C N
  let t₀ : op (CommAlgCat.of R B) ⟶ op (CommAlgCat.of R C) := affHom (constAlg N C)
  let t₁ : op (CommAlgCat.of R E') ⟶ op (CommAlgCat.of R C) := affHom (i.comp (constAlg N C))
  have h₁ : φ.app t₁ ((i : B →* E').comp X) = i.toLinearMap.comp (linUniv R φ) :=
    φ.naturality (affHom i) t₀ X
  have hΔ : affHom Δ ≫ t₀ = t₁ := by
    change (CommAlgCat.ofHom (Δ.comp (constAlg N C))).op = _
    rw [show Δ.comp (constAlg N C) = i.comp (constAlg N C) from diag_comp_const N C]
  have h₂ : φ.app t₁ ((Δ : B →* E').comp X) = Δ.toLinearMap.comp (linUniv R φ) := by
    have := φ.naturality (affHom Δ) t₀ X
    rw [hΔ] at this
    exact this
  let hu : Multiplicative M →* E' := AddMonoidAlgebra.of B M
  have hX : (Δ : B →* E').comp X = (hu.comp (AddMonoidHom.toMultiplicative N.subtype)) *
      (i : B →* E').comp X := by
    refine MonoidHom.ext fun n => ?_
    change Δ (AddMonoidAlgebra.single (Multiplicative.toAdd n) 1) =
      AddMonoidAlgebra.single ((Multiplicative.toAdd n : N) : M) 1 *
        AddMonoidAlgebra.single 0 (AddMonoidAlgebra.single (Multiplicative.toAdd n) 1)
    rw [show Δ (AddMonoidAlgebra.single (Multiplicative.toAdd n) 1) = _ from diag_single N C _ _,
      AddMonoidAlgebra.single_mul_single]
    simp
  have key : Δ.toLinearMap.comp (linUniv R φ) =
      linSmul R ℰ hu (i.toLinearMap.comp (linUniv R φ)) := by
    rw [← h₂, hX, ← h₁]
    exact φ.equivariant t₁ hu _
  have hval : Δ (linUniv R φ a) = AddMonoidAlgebra.single m (linUniv R φ a) := by
    have := DFunLike.congr_fun key a
    rw [linSmul_of_mem R ℰ _ _ ha] at this
    refine this.trans ?_
    change AddMonoidAlgebra.single m 1 * AddMonoidAlgebra.single 0 (linUniv R φ a) = _
    rw [AddMonoidAlgebra.single_mul_single]
    simp
  intro n hn
  by_contra hne
  have hcoeff := coeff_coeff_diag (R := R) (M := M) N C (linUniv R φ a) n
  change ((Δ (linUniv R φ a)).coeff (n : M)).coeff n = _ at hcoeff
  have hne' : (n : M) ≠ m := hne
  rw [hval, AddMonoidAlgebra.coeff_single, Finsupp.single_eq_of_ne hne'] at hcoeff
  exact (Finsupp.mem_support_iff.mp hn) (by simpa using hcoeff.symm)

/-- The evaluation of a point of `V(E)`'s attractor at `(t, a)` through the universal value. -/
lemma linApp_eq (φ : AttractorPt (linAction R ℰ) N (op (CommAlgCat.of R C)))
    {T' : (Aff R)} (t : T' ⟶ op (CommAlgCat.of R C)) (a : APt (affO R) N (op T')) (e : E) :
    (show E →ₗ[R] (unop T' : CommAlgCat.{u} R) from φ.app t a) e =
      evalAlg (D := (unop T' : CommAlgCat.{u} R)) t.unop.hom a (linUniv R φ e) := by
  let ev : AddMonoidAlgebra C N →ₐ[R] (unop T' : CommAlgCat.{u} R) :=
    evalAlg (D := (unop T' : CommAlgCat.{u} R)) t.unop.hom a
  let s : T' ⟶ op (CommAlgCat.of R (AddMonoidAlgebra C N)) :=
    (CommAlgCat.ofHom ev : CommAlgCat.of R (AddMonoidAlgebra C N) ⟶
      CommAlgCat.of R (unop T' : CommAlgCat.{u} R)).op
  have hn := φ.naturality s (affHom (constAlg N C)) (AddMonoidAlgebra.of C N)
  have e₁ : s ≫ affHom (constAlg N C) = t := by
    refine Quiver.Hom.unop_inj (CommAlgCat.hom_ext (AlgHom.ext fun c => ?_))
    change ev (AddMonoidAlgebra.single 0 c) = t.unop.hom c
    rw [show ev (AddMonoidAlgebra.single 0 c) = _ from
      evalAlg_single (R := R) (D := (unop T' : CommAlgCat.{u} R)) N C t.unop.hom a 0 c]
    simp only [ofAdd_zero]
    exact (congrArg _ (map_one a)).trans (mul_one (M := (unop T' : CommAlgCat.{u} R)) _)
  have e₂ : APt.res (𝒪 := affO R) s.op (AddMonoidAlgebra.of C N) = a := by
    refine MonoidHom.ext fun n => ?_
    change ev (AddMonoidAlgebra.single (Multiplicative.toAdd n) 1) = a n
    rw [show ev (AddMonoidAlgebra.single (Multiplicative.toAdd n) 1) = _ from
      evalAlg_single (R := R) (D := (unop T' : CommAlgCat.{u} R)) N C t.unop.hom a
        (Multiplicative.toAdd n) 1]
    simp
    rfl
  rw [e₁, e₂] at hn
  exact (LinearMap.congr_fun (show (show E →ₗ[R] (unop T' : CommAlgCat.{u} R) from φ.app t a) =
    ev.toLinearMap.comp (linUniv R φ) from hn) e)

open scoped Classical in
/-- The point of the attractor of `V(E)` attached to a family of linear forms on the `E_n`. -/
noncomputable def linPtOf (l : ∀ n : N, ℰ (n : M) →ₗ[R] C) :
    AttractorPt (linAction R ℰ) N (op (CommAlgCat.of R C)) where
  app {T'} t a := homOfComp (D := (unop T' : CommAlgCat.{u} R)) R ℰ fun m =>
    if hm : m ∈ N then
      (LinearMap.mulLeft R (show (unop T' : CommAlgCat.{u} R) from
        a (Multiplicative.ofAdd (⟨m, hm⟩ : N)))).comp
        (t.unop.hom.toLinearMap.comp (l ⟨m, hm⟩))
    else 0
  naturality {T' T''} s t a := by
    refine linHom_ext (D := (unop T'' : CommAlgCat.{u} R)) R ℰ fun m x hx => ?_
    refine (homOfComp_of_mem R ℰ _ hx).trans ?_
    refine Eq.trans ?_ (congrArg s.unop.hom (homOfComp_of_mem R ℰ _ hx)).symm
    by_cases hm : m ∈ N
    · simp only [dif_pos hm]
      refine Eq.trans ?_ (map_mul s.unop.hom _ _).symm
      rfl
    · simp only [dif_neg hm]
      exact (map_zero s.unop.hom).symm
  equivariant {T'} t h a := by
    refine linHom_ext (D := (unop T' : CommAlgCat.{u} R)) R ℰ fun m x hx => ?_
    refine (homOfComp_of_mem R ℰ _ hx).trans ?_
    refine Eq.trans ?_ (linSmul_of_mem (D := (unop T' : CommAlgCat.{u} R)) R ℰ _ _ hx).symm
    refine Eq.trans ?_ (congrArg _ (homOfComp_of_mem R ℰ _ hx)).symm
    by_cases hm : m ∈ N
    · simp only [dif_pos hm]
      exact mul_assoc (G := (unop T' : CommAlgCat.{u} R)) _ _ _
    · simp only [dif_neg hm]
      exact (mul_zero (M₀ := (unop T' : CommAlgCat.{u} R)) _).symm

open scoped Classical in
/-- **Proposition 3.28** over an arbitrary affine `T = Spec C` with `E` an arbitrary `M`-graded
`R`-module: a `C`-point of `V(E)^N` is a family of linear forms on the graded pieces `E_n`, `n ∈ N`,
that is a `C`-point of `V(E_N)` (see `linAttractorEquiv`). The map is `φ ↦ φ.toPoint|_{E_n}`, i.e.
the map `V(E)^N → V(E)` lands in `V(E_N)`. -/
noncomputable def linAttractorFamEquiv :
    AttractorPt (linAction R ℰ) N (op (CommAlgCat.of R C)) ≃
      ∀ n : N, ℰ (n : M) →ₗ[R] C where
  toFun φ n := (show E →ₗ[R] C from φ.toPoint).comp (ℰ (n : M)).subtype
  invFun := linPtOf R ℰ N C
  left_inv φ := by
    refine AttractorPt.ext ?_
    funext T' t a
    refine linHom_ext (D := (unop T' : CommAlgCat.{u} R)) R ℰ fun m x hx => ?_
    refine (homOfComp_of_mem R ℰ _ hx).trans ?_
    refine Eq.trans ?_ (linApp_eq R ℰ N C φ t a x).symm
    by_cases hm : m ∈ N
    · simp only [dif_pos hm]
      obtain ⟨c, hc⟩ := exists_single_of_mem_magnetGrading hm (linUniv_mem R φ hx)
      have e0 : (show E →ₗ[R] C from φ.toPoint) x = c := by
        refine (linApp_eq R ℰ N C φ (𝟙 _) 1 x).trans ?_
        rw [hc]
        refine (evalAlg_single (R := R) (D := C) N C (AlgHom.id R C) 1 ⟨m, hm⟩ c).trans ?_
        simp
      rw [hc]
      refine Eq.trans ?_ (evalAlg_single (R := R) (D := (unop T' : CommAlgCat.{u} R)) N C
        t.unop.hom a ⟨m, hm⟩ c).symm
      change (show (unop T' : CommAlgCat.{u} R) from a _) *
        t.unop.hom ((show E →ₗ[R] C from φ.toPoint) x) = _
      rw [e0]
      exact mul_comm (G := (unop T' : CommAlgCat.{u} R)) _ _
    · simp only [dif_neg hm]
      have h0 := linUniv_mem R φ hx
      rw [magnetGrading_eq_bot hm, Submodule.mem_bot] at h0
      rw [h0, map_zero]
      rfl
  right_inv l := by
    funext n
    refine LinearMap.ext fun x => ?_
    refine (homOfComp_of_mem R ℰ _ x.2).trans ?_
    simp only [dif_pos n.2]
    change (1 : C) * _ = _
    rw [one_mul]
    rfl

/-- **Proposition 3.28**: `V(E)^N(C) = V(E_N)(C)` for `E_N = ⨁_{n ∈ N} E_n`. -/
noncomputable def linAttractorEquiv :
    AttractorPt (linAction R ℰ) N (op (CommAlgCat.of R C)) ≃
      ((⨁ n : N, ℰ (n : M)) →ₗ[R] C) :=
  (linAttractorFamEquiv R ℰ N C).trans
    { toFun := fun l => DirectSum.toModule R N C l
      invFun := fun f n => f.comp (DirectSum.lof R N (fun n : N => ℰ (n : M)) n)
      left_inv := fun l => by funext n; ext x; simp
      right_inv := fun f => by ext n x; simp }

end Linear

end AlgMag

