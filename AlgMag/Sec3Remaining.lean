open CategoryTheory Opposite Magnetism DirectSum


namespace AlgMag

section Linear2

variable (R : Type u) [CommRing R] {M : Type u} [AddCommMonoid M] [DecidableEq M]
variable {E : Type u} [AddCommGroup E] [Module R E]
variable (ℰ : M → Submodule R E) [DirectSum.Decomposition ℰ]
variable (N : AddSubmonoid M) (C : Type u) [CommRing C] [Algebra R C]

/-- The value of a point of `V(E)^N` on `e ∈ E_m`, `m ∈ N`: `t(x(e)) a(m)`. -/
lemma linApp_of_mem (φ : AttractorPt (linAction R ℰ) N (op (CommAlgCat.of R C)))
    {T' : Aff R} (t : T' ⟶ op (CommAlgCat.of R C)) (a : APt (affO R) N (op T')) {m : M}
    (hm : m ∈ N) {e : E} (he : e ∈ ℰ m) :
    (show E →ₗ[R] (unop T' : CommAlgCat.{u} R) from φ.app t a) e =
      t.unop.hom ((show E →ₗ[R] C from φ.toPoint) e) *
        (show (unop T' : CommAlgCat.{u} R) from a (Multiplicative.ofAdd (⟨m, hm⟩ : N))) := by
  obtain ⟨c, hc⟩ := exists_single_of_mem_magnetGrading hm (linUniv_mem R φ he)
  have e0 : (show E →ₗ[R] C from φ.toPoint) e = c := by
    refine (linApp_eq R ℰ N C φ (𝟙 _) 1 e).trans ?_
    rw [hc]
    refine (evalAlg_single (R := R) (D := C) N C (AlgHom.id R C) 1 ⟨m, hm⟩ c).trans ?_
    simp
  refine (linApp_eq R ℰ N C φ t a e).trans ?_
  rw [hc, e0]
  exact evalAlg_single (R := R) (D := (unop T' : CommAlgCat.{u} R)) N C t.unop.hom a ⟨m, hm⟩ c

/-- Off the magnet, a point of `V(E)^N` vanishes. -/
lemma linToPoint_of_notMem (φ : AttractorPt (linAction R ℰ) N (op (CommAlgCat.of R C))) {m : M}
    (hm : m ∉ N) {e : E} (he : e ∈ ℰ m) : (show E →ₗ[R] C from φ.toPoint) e = 0 := by
  refine (linApp_eq R ℰ N C φ (𝟙 _) 1 e).trans ?_
  have h0 := linUniv_mem R φ he
  rw [magnetGrading_eq_bot hm, Submodule.mem_bot] at h0
  rw [h0, map_zero]

/-- **Example 1.2 / Proposition 3.28**: `V^N → V` is injective, with image the points supported on
the weights in `N`: `V^N = ⨁_{n ∈ N} V_n ⊆ V`. -/
theorem lin_toPoint_injective :
    Function.Injective (AttractorPt.toPoint (act := linAction R ℰ) (N := N)
      (T := op (CommAlgCat.of R C))) := by
  intro φ ψ h
  apply (linAttractorFamEquiv R ℰ N C).injective
  funext n
  exact congrArg (fun x : E →ₗ[R] C => x.comp (ℰ (n : M)).subtype) h

theorem lin_toPoint_range (x : E →ₗ[R] C) :
    (∃ φ : AttractorPt (linAction R ℰ) N (op (CommAlgCat.of R C)), φ.toPoint = x) ↔
      ∀ m, m ∉ N → ∀ e ∈ ℰ m, x e = 0 := by
  constructor
  · rintro ⟨φ, rfl⟩ m hm e he
    exact linToPoint_of_notMem R ℰ N C φ hm he
  · intro hx
    refine ⟨linPtOf R ℰ N C fun n => x.comp (ℰ (n : M)).subtype, ?_⟩
    refine linHom_ext R ℰ fun m e he => ?_
    refine (homOfComp_of_mem R ℰ _ he).trans ?_
    by_cases hm : m ∈ N
    · simp only [dif_pos hm]
      change (1 : C) * _ = _
      rw [one_mul]
      rfl
    · simp only [dif_neg hm]
      exact (hx m hm e he).symm

/-! Weights on a free module. -/

variable {ι : Type u} (w : ι → M)

/-- The weight spaces of the free module `R^ι` with basis of weights `w`. -/
def wtGr (m : M) : Submodule R (ι →₀ R) := Finsupp.supported R R {i | w i = m}

/-- The additive map to the direct sum of weight spaces. -/
noncomputable def wtD : (ι →₀ R) →+ ⨁ m, wtGr R w m :=
  Finsupp.liftAddHom fun i =>
    (DirectSum.of (fun m => wtGr R w m) (w i)).comp
      { toFun := fun r => ⟨Finsupp.single i r, Finsupp.single_mem_supported R r rfl⟩
        map_zero' := Subtype.ext (Finsupp.single_zero _)
        map_add' := fun a b => Subtype.ext (Finsupp.single_add _ _ _) }

lemma wtD_single (i : ι) (r : R) : wtD R w (Finsupp.single i r) =
    DirectSum.of (fun m => wtGr R w m) (w i)
      ⟨Finsupp.single i r, Finsupp.single_mem_supported R r rfl⟩ := by
  rw [wtD, Finsupp.liftAddHom_apply_single]
  rfl

lemma of_wt_cast {a b : M} (h : a = b) {x : ι →₀ R} (hx : x ∈ wtGr R w a) (hy : x ∈ wtGr R w b) :
    DirectSum.of (fun m => wtGr R w m) a ⟨x, hx⟩ = DirectSum.of (fun m => wtGr R w m) b ⟨x, hy⟩ := by
  subst h; rfl

lemma wtD_of_mem {m : M} (f : ι →₀ R) (hf : f ∈ wtGr R w m) :
    wtD R w f = DirectSum.of (fun m => wtGr R w m) m ⟨f, hf⟩ := by
  classical
  induction f using Finsupp.induction with
  | zero =>
    rw [map_zero]
    exact (map_zero (DirectSum.of (fun m => wtGr R w m) m)).symm
  | single_add i r f hi hr ih =>
    have hsup : ∀ j ∈ (Finsupp.single i r + f).support, w j = m := fun j hj => hf hj
    have hd : Disjoint (Finsupp.single i r).support f.support := by
      rw [Finsupp.support_single_ne_zero _ hr]
      simpa using hi
    have hs := Finsupp.support_add_eq hd
    have hi' : w i = m := hsup i (by rw [hs, Finsupp.support_single_ne_zero _ hr]; simp)
    have hf' : f ∈ wtGr R w m := fun j hj => hsup j (by rw [hs]; exact Finset.mem_union_right _ hj)
    have hs' : Finsupp.single i r ∈ wtGr R w m := by
      rw [← hi']; exact Finsupp.single_mem_supported R r rfl
    rw [map_add, ih hf', wtD_single, of_wt_cast R w hi'
      (show Finsupp.single i r ∈ wtGr R w (w i) from Finsupp.single_mem_supported R r rfl) hs',
      ← map_add]
    rfl

/-- The decomposition of `R^ι` in weight spaces. -/
noncomputable instance wtDecomp : DirectSum.Decomposition (wtGr R w) := by
  classical
  exact DirectSum.Decomposition.ofAddHom _ (wtD R w)
    (by
      refine Finsupp.addHom_ext fun i r => ?_
      simp [wtD_single])
    (by
      refine DirectSum.addHom_ext fun m x => ?_
      simpa using wtD_of_mem R w x.1 x.2)

lemma single_mem_wtGr (i : ι) (r : R) : Finsupp.single i r ∈ wtGr R w (w i) :=
  Finsupp.single_mem_supported R r rfl

/-- **Example 1.2.** `X = 𝔸^ι` with weights `w`: the map `v ↦ (v_i)` identifies `X^N(C)` with the
vectors supported on the coordinates of weight in `N`, i.e. `V^N = ⨁_{n ∈ N} V_n`. -/
noncomputable def ex12 :
    AttractorPt (linAction R (wtGr R w)) N (op (CommAlgCat.of R C)) ≃
      {v : ι → C // ∀ i, w i ∉ N → v i = 0} :=
  Equiv.ofBijective
    (fun φ => ⟨fun i => (show (ι →₀ R) →ₗ[R] C from φ.toPoint) (Finsupp.single i 1), fun i hi =>
      linToPoint_of_notMem R (wtGr R w) N C φ hi (single_mem_wtGr R w i 1)⟩)
    (by
      constructor
      · intro φ ψ h
        apply lin_toPoint_injective R (wtGr R w) N C
        refine Finsupp.lhom_ext' fun i => LinearMap.ext_ring ?_
        exact congrFun (congrArg Subtype.val h) i
      · rintro ⟨v, hv⟩
        obtain ⟨φ, hφ⟩ := (lin_toPoint_range R (wtGr R w) N C
          (Finsupp.linearCombination R v)).mpr (by
            intro m hm e he
            rw [Finsupp.linearCombination_apply]
            refine Finset.sum_eq_zero fun i hi => ?_
            have : w i = m := he hi
            change e i • v i = 0
            rw [hv i (this ▸ hm), smul_zero])
        refine ⟨φ, Subtype.ext (funext fun i => ?_)⟩
        change (show (ι →₀ R) →ₗ[R] C from φ.toPoint) _ = _
        rw [hφ]
        simp)

end Linear2

end AlgMag

end

section

open CategoryTheory Opposite Magnetism DirectSum

namespace AlgMag

/-- `ℕ ⊆ ℤ`. -/
def posN : AddSubmonoid ℤ where
  carrier := {x | 0 ≤ x}
  add_mem' := fun {a b} (ha : 0 ≤ a) (hb : 0 ≤ b) => show 0 ≤ a + b by omega
  zero_mem' := le_refl (0 : ℤ)

/-- `-ℕ ⊆ ℤ`. -/
def negN : AddSubmonoid ℤ where
  carrier := {x | x ≤ 0}
  add_mem' := fun {a b} (ha : a ≤ 0) (hb : b ≤ 0) => show a + b ≤ 0 by omega
  zero_mem' := le_refl (0 : ℤ)

lemma mem_posN {x : ℤ} : x ∈ posN ↔ 0 ≤ x := Iff.rfl
lemma mem_negN {x : ℤ} : x ∈ negN ↔ x ≤ 0 := Iff.rfl

/-! ### Remark 3.23 -/

section Rem323

variable (R : Type) [CommRing R]

/-- A family of maps `Y(D) → X(D)` on affine `R`-schemes is a closed immersion, tested on affine
points: for each `x ∈ X(D)` the pullback to `Spec D` is a closed subscheme `V(I)`. -/
def IsClosedImmAff (Y : CommAlgCat.{0} R → Type*) (X : (Aff R)ᵒᵖ ⥤ Type)
    (p : ∀ D : CommAlgCat.{0} R, Y D → X.obj (op (op D))) : Prop :=
  ∀ (D : CommAlgCat.{0} R) (x : X.obj (op (op D))), ∃ I : Ideal D,
    ∀ (D' : CommAlgCat.{0} R) (t : D ⟶ D'),
      (∃ y : Y D', p D' y = X.map (Quiver.Hom.op t.op) x) ↔ ∀ i ∈ I, t.hom i = 0

/-- Weights `(1, 0)` on `𝔸²`. -/
def wt2 : Fin 2 → ℤ := ![1, 0]

lemma span_unit_mul {D : Type} [CommRing D] {u v x y : D} (huv : u * v = 1)
    (h : Ideal.span {x, y} = ⊤) : Ideal.span {u * x, y} = ⊤ := by
  rw [Ideal.eq_top_iff_one] at h ⊢
  obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp h
  refine Ideal.mem_span_pair.mpr ⟨a * v, b, ?_⟩
  rw [← hab, show a * v * (u * x) = a * (u * v) * x by ring, huv, mul_one]

lemma apt_unit {D : Type} [CommRing D] (h : Multiplicative ℤ →* D) :
    h (Multiplicative.ofAdd 1) * h (Multiplicative.ofAdd (-1)) = 1 := by
  rw [← map_mul, ← ofAdd_add, add_neg_cancel, ofAdd_zero, map_one]

/-- `𝔸² \ {0}` with the action of `D(ℤ)` of weights `(1, 0)`: the points of `V(R²)` whose two
coordinates generate the unit ideal. -/
noncomputable def puncturedPlane : (Aff R)ᵒᵖ ⥤ Type where
  obj U := {f : (Fin 2 →₀ R) →ₗ[R] (unop (unop U) : CommAlgCat.{0} R) //
    Ideal.span {f (Finsupp.single 0 1), f (Finsupp.single 1 1)} = ⊤}
  map {U V} g := ↾ fun x => ⟨g.unop.unop.hom.toLinearMap.comp x.1, by
    have h := congrArg (Ideal.map g.unop.unop.hom) x.2
    rw [Ideal.map_span, Ideal.map_top, Set.image_pair] at h
    exact h⟩

/-- The linear action restricts to `𝔸² \ {0}`. -/
noncomputable def puncturedAction : AAction (affO R) ℤ (puncturedPlane R) where
  smul {U} h x := ⟨(linAction R (wtGr R wt2)).smul h x.1, by
    let D : CommAlgCat.{0} R := unop (unop U)
    let h' : Multiplicative ℤ →* D := h
    have e0 := linSmul_of_mem (D := D) R (wtGr R wt2) h' x.1 (single_mem_wtGr R wt2 0 1)
    have e1 := linSmul_of_mem (D := D) R (wtGr R wt2) h' x.1 (single_mem_wtGr R wt2 1 1)
    have h1 : h' (Multiplicative.ofAdd (wt2 1)) = 1 := map_one h'
    change Ideal.span {linSmul (D := D) R (wtGr R wt2) h' x.1 (Finsupp.single 0 1),
      linSmul (D := D) R (wtGr R wt2) h' x.1 (Finsupp.single 1 1)} = ⊤
    rw [e0, e1, h1, one_mul]
    exact span_unit_mul (apt_unit h') x.2⟩
  one_smul {U} x := Subtype.ext ((linAction R (wtGr R wt2)).one_smul x.1)
  mul_smul {U} g h x := Subtype.ext ((linAction R (wtGr R wt2)).mul_smul g h x.1)
  map_smul {U V} f h x := Subtype.ext ((linAction R (wtGr R wt2)).map_smul f h x.1)

/-- A point of `(𝔸² \ {0})^N` gives a point of `V(R²)^N`. -/
noncomputable def puncturedToLin {N : AddSubmonoid ℤ} {T : Aff R}
    (φ : AttractorPt (puncturedAction R) N T) : AttractorPt (linAction R (wtGr R wt2)) N T where
  app t a := (φ.app t a).1
  naturality s t a := congrArg Subtype.val (φ.naturality s t a)
  equivariant t h a := congrArg Subtype.val (φ.equivariant t h a)

open scoped Classical in
/-- The zero point of `𝔸(ℕ)` over `D`. -/
noncomputable def zeroPt (D : Type) [CommRing D] : Multiplicative posN →* D where
  toFun n := if (Multiplicative.toAdd n : posN) = 0 then 1 else 0
  map_one' := by simp
  map_mul' x y := by
    have key : (Multiplicative.toAdd (x * y) : posN) = 0 ↔
        (Multiplicative.toAdd x : posN) = 0 ∧ (Multiplicative.toAdd y : posN) = 0 := by
      have hx : 0 ≤ ((Multiplicative.toAdd x : posN) : ℤ) := (Multiplicative.toAdd x : posN).2
      have hy : 0 ≤ ((Multiplicative.toAdd y : posN) : ℤ) := (Multiplicative.toAdd y : posN).2
      simp only [Subtype.ext_iff, toAdd_mul, AddSubmonoid.coe_add, AddSubmonoid.coe_zero]
      omega
    rw [if_congr key rfl rfl]
    by_cases h1 : (Multiplicative.toAdd x : posN) = 0 <;>
    by_cases h2 : (Multiplicative.toAdd y : posN) = 0 <;> simp [h1, h2]

open scoped Classical in
lemma zeroPt_of (D : Type) [CommRing D] (n : posN) :
    zeroPt D (Multiplicative.ofAdd n) = if n = 0 then 1 else 0 := rfl

/-- A `D`-point `(x, y)` of `𝔸² \ {0}` (weights `(1, 0)`) which lies in the image of the attractor
for `ℕ` has `y` invertible. -/
theorem punctured_unit {D : CommAlgCat.{0} R} (φ : AttractorPt (puncturedAction R) posN (op D)) :
    IsUnit ((show (Fin 2 →₀ R) →ₗ[R] D from (φ.toPoint).1) (Finsupp.single 1 1)) := by
  let ψ := puncturedToLin R φ
  have hspan := (φ.app (𝟙 _) (zeroPt D)).2
  have e0 := linApp_of_mem R (wtGr R wt2) posN D ψ (𝟙 _) (zeroPt D)
    (m := wt2 0) (by simp [wt2, mem_posN]) (single_mem_wtGr R wt2 0 1)
  have e1 := linApp_of_mem R (wtGr R wt2) posN D ψ (𝟙 _) (zeroPt D)
    (m := wt2 1) (by simp [wt2, mem_posN]) (single_mem_wtGr R wt2 1 1)
  let a0 : D := (zeroPt D) (Multiplicative.ofAdd (⟨wt2 0, by simp [wt2, mem_posN]⟩ : posN))
  have ha0 : a0 = 0 := by
    have hne : (⟨wt2 0, by simp [wt2, mem_posN]⟩ : posN) ≠ 0 := by
      intro h
      have := congrArg Subtype.val h
      simp [wt2] at this
    exact (zeroPt_of D _).trans (if_neg hne)
  have ha1 : (zeroPt D) (Multiplicative.ofAdd (⟨wt2 1, by simp [wt2, mem_posN]⟩ : posN)) = (1 : D) := by
    have he : (⟨wt2 1, by simp [wt2, mem_posN]⟩ : posN) = 0 := Subtype.ext (by simp [wt2])
    exact (zeroPt_of D _).trans (if_pos he)
  have hs : Ideal.span {((φ.app (𝟙 _) (zeroPt D)).1 : (Fin 2 →₀ R) →ₗ[R] D) (Finsupp.single 0 1),
      ((φ.app (𝟙 _) (zeroPt D)).1 : (Fin 2 →₀ R) →ₗ[R] D) (Finsupp.single 1 1)} = ⊤ := hspan
  have e0' : ((φ.app (𝟙 _) (zeroPt D)).1 : (Fin 2 →₀ R) →ₗ[R] D) (Finsupp.single 0 1) = 0 := by
    refine e0.trans ?_
    exact (congrArg _ ha0).trans (mul_zero (M₀ := D) _)
  have e1' : ((φ.app (𝟙 _) (zeroPt D)).1 : (Fin 2 →₀ R) →ₗ[R] D) (Finsupp.single 1 1) =
      (show (Fin 2 →₀ R) →ₗ[R] D from (φ.toPoint).1) (Finsupp.single 1 1) := by
    refine e1.trans ?_
    exact (congrArg _ ha1).trans (mul_one (M := D) _)
  rw [e0', e1', Ideal.eq_top_iff_one] at hs
  obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hs
  rw [mul_zero, zero_add] at hab
  exact IsUnit.of_mul_eq_one b (by rw [mul_comm]; exact hab)

/-- **Remark 3.23.** Corollary 3.22 does not generalize outside the affine case: for `X = 𝔸² \ {0}`
with weights `(1, 0)`, `R ≠ 0`, and `ℕ ⊆ ℤ`, the morphism `X^ℕ → X^ℤ = X` is not a closed immersion
(`X^ℕ` is the open subscheme `y ≠ 0`). -/
theorem rem323 [Nontrivial R] :
    ¬ IsClosedImmAff R (fun D => AttractorPt (puncturedAction R) posN (op D)) (puncturedPlane R)
      (fun _ φ => φ.toPoint) := by
  intro hcl
  let P := Polynomial R
  let D : CommAlgCat.{0} R := CommAlgCat.of R P
  let x₀ : (Fin 2 →₀ R) →ₗ[R] D :=
    Finsupp.linearCombination R (![1, (Polynomial.X : P)] : Fin 2 → P)
  have hx0 : x₀ (Finsupp.single 0 1) = 1 := by simp [x₀]
  have hx1 : x₀ (Finsupp.single 1 1) = (Polynomial.X : P) := by simp [x₀]
  let x : (puncturedPlane R).obj (op (op D)) := ⟨x₀, by
    change Ideal.span {x₀ (Finsupp.single 0 1), x₀ (Finsupp.single 1 1)} = ⊤
    rw [hx0, Ideal.eq_top_iff_one]
    exact Ideal.subset_span (Set.mem_insert _ _)⟩
  obtain ⟨I, hI⟩ := hcl D x
  -- over `R[y, 1/y]` the point lifts
  let D' : CommAlgCat.{0} R := CommAlgCat.of R (LaurentPolynomial R)
  let τ : P →ₐ[R] LaurentPolynomial R := Polynomial.toLaurentAlg
  let t : D ⟶ D' := CommAlgCat.ofHom τ
  have hτ : Function.Injective τ := Polynomial.toLaurent_injective
  let x' : (Fin 2 →₀ R) →ₗ[R] D' := τ.toLinearMap.comp x₀
  have hunit : IsUnit (x' (Finsupp.single 1 1)) := by
    have : x' (Finsupp.single 1 1) = LaurentPolynomial.T 1 := by
      change τ (x₀ _) = _
      rw [hx1]
      exact Polynomial.toLaurent_X
    rw [this]
    exact LaurentPolynomial.isUnit_T 1
  have hrange : ∀ m, m ∉ posN → ∀ e ∈ wtGr R wt2 m, x' e = 0 := by
    intro m hm e he
    have : e = 0 := by
      refine Finsupp.ext fun i => ?_
      by_contra hne
      have hi : wt2 i = m := he (Finsupp.mem_support_iff.mpr hne)
      apply hm
      rw [← hi, mem_posN]
      fin_cases i <;> simp [wt2]
    rw [this, map_zero]
  obtain ⟨ψ, hψ⟩ := (lin_toPoint_range R (wtGr R wt2) posN D' x').mpr hrange
  have huni : ∀ {T' : Aff R} (s : T' ⟶ op D') (a : APt (affO R) posN (op T')),
      Ideal.span {(show (Fin 2 →₀ R) →ₗ[R] (unop T' : CommAlgCat.{0} R) from ψ.app s a) (Finsupp.single 0 1),
        (show (Fin 2 →₀ R) →ₗ[R] (unop T' : CommAlgCat.{0} R) from ψ.app s a) (Finsupp.single 1 1)} = ⊤ := by
    intro T' s a
    have e1 := linApp_of_mem R (wtGr R wt2) posN D' ψ s a
      (m := wt2 1) (by simp [wt2, mem_posN]) (single_mem_wtGr R wt2 1 1)
    have h1 : (show (unop T' : CommAlgCat.{0} R) from a (Multiplicative.ofAdd (⟨wt2 1, by simp [wt2, mem_posN]⟩ : posN))) = 1 := by
      have : (⟨wt2 1, by simp [wt2, mem_posN]⟩ : posN) = 0 := Subtype.ext (by simp [wt2])
      rw [this]
      exact map_one a
    rw [Ideal.eq_top_iff_one]
    have hu : IsUnit ((show (Fin 2 →₀ R) →ₗ[R] (unop T' : CommAlgCat.{0} R) from ψ.app s a) (Finsupp.single 1 1)) := by
      rw [show (show (Fin 2 →₀ R) →ₗ[R] (unop T' : CommAlgCat.{0} R) from ψ.app s a) (Finsupp.single 1 1) = _ from e1, h1, mul_one]
      rw [show (show (Fin 2 →₀ R) →ₗ[R] D' from ψ.toPoint) = x' from hψ]
      exact hunit.map s.unop.hom
    obtain ⟨v, hv⟩ := hu.exists_left_inv
    exact Ideal.mem_span_pair.mpr ⟨0, v, by rw [zero_mul, zero_add, hv]⟩
  let φ : AttractorPt (puncturedAction R) posN (op D') :=
    { app := fun s a => ⟨ψ.app s a, huni s a⟩
      naturality := fun s t a => Subtype.ext (ψ.naturality s t a)
      equivariant := fun t h a => Subtype.ext (ψ.equivariant t h a) }
  have hlift : ∃ y : AttractorPt (puncturedAction R) posN (op D'),
      y.toPoint = (puncturedPlane R).map (Quiver.Hom.op t.op) x :=
    ⟨φ, Subtype.ext hψ⟩
  have hI0 : ∀ i ∈ I, i = 0 := fun i hi => hτ (((hI D' t).mp hlift i hi).trans (map_zero τ).symm)
  obtain ⟨y, hy⟩ := (hI D (𝟙 D)).mpr (fun i hi => by rw [hI0 i hi, map_zero])
  have hu := punctured_unit R y
  have : (show (Fin 2 →₀ R) →ₗ[R] D from (y.toPoint).1) = x₀ := congrArg Subtype.val hy
  rw [this, hx1] at hu
  obtain ⟨v, hv⟩ := hu.exists_right_inv
  have hv' : (Polynomial.X : P) * v = 1 := hv
  have e := congrArg (Polynomial.eval 0) hv'
  rw [Polynomial.eval_mul, Polynomial.eval_X, zero_mul, Polynomial.eval_one] at e
  exact zero_ne_one e

end Rem323

/-! ### Remark 3.25: the projective line -/

section P1

/-- Base change of submodules of `D²`. -/
def bc {D D' : Type} [CommRing D] [CommRing D'] (φ : D →+* D') (K : Submodule D (D × D)) :
    Submodule D' (D' × D') := Submodule.span D' (Prod.map φ φ '' K)

lemma bc_span_pair {D D' : Type} [CommRing D] [CommRing D'] (φ : D →+* D') (u v : D × D) :
    bc φ (Submodule.span D {u, v}) = Submodule.span D' {Prod.map φ φ u, Prod.map φ φ v} := by
  apply le_antisymm
  · refine Submodule.span_le.mpr ?_
    rintro _ ⟨z, hz, rfl⟩
    obtain ⟨a, b, rfl⟩ := Submodule.mem_span_pair.mp hz
    refine Submodule.mem_span_pair.mpr ⟨φ a, φ b, ?_⟩
    ext <;> simp
  · refine Submodule.span_le.mpr ?_
    rintro _ (rfl | rfl)
    · exact Submodule.subset_span ⟨u, Submodule.subset_span (by simp), rfl⟩
    · exact Submodule.subset_span ⟨v, Submodule.subset_span (by simp), rfl⟩

lemma bc_id {D : Type} [CommRing D] (K : Submodule D (D × D)) : bc (RingHom.id D) K = K := by
  simp [bc]

lemma bc_comp {D D' D'' : Type} [CommRing D] [CommRing D'] [CommRing D''] (φ : D →+* D')
    (ψ : D' →+* D'') (K : Submodule D (D × D)) : bc (ψ.comp φ) K = bc ψ (bc φ K) := by
  apply le_antisymm
  · refine Submodule.span_le.mpr ?_
    rintro _ ⟨z, hz, rfl⟩
    exact Submodule.subset_span ⟨Prod.map φ φ z, Submodule.subset_span ⟨z, hz, rfl⟩, rfl⟩
  · refine Submodule.span_le.mpr ?_
    rintro _ ⟨z, hz, rfl⟩
    induction hz using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨w, hw, rfl⟩ := hy
      exact Submodule.subset_span ⟨w, hw, rfl⟩
    | zero =>
      have : Prod.map ψ ψ (0 : D' × D') = 0 := by ext <;> simp
      rw [this]
      exact Submodule.zero_mem _
    | add x y _ _ hx hy =>
      have : Prod.map ψ ψ (x + y) = Prod.map ψ ψ x + Prod.map ψ ψ y := by ext <;> simp
      rw [this]
      exact Submodule.add_mem _ hx hy
    | smul r x _ hx =>
      have : Prod.map ψ ψ (r • x) = ψ r • Prod.map ψ ψ x := by ext <;> simp
      rw [this]
      exact Submodule.smul_mem _ _ hx

/-- A rank one direct summand of `D²`, the range of a rank one projector
`[[a, b], [c, d]]`: this is the Grassmannian description of `ℙ¹(D)`. -/
def IsLine {D : Type} [CommRing D] (K : Submodule D (D × D)) : Prop :=
  ∃ a b c d : D, a * a + b * c = a ∧ a * b + b * d = b ∧ c * a + d * c = c ∧ c * b + d * d = d ∧
    a + d = 1 ∧ K = Submodule.span D {(a, c), (b, d)}

lemma IsLine.bc {D D' : Type} [CommRing D] [CommRing D'] (φ : D →+* D') {K : Submodule D (D × D)}
    (hK : IsLine K) : IsLine (AlgMag.bc φ K) := by
  obtain ⟨a, b, c, d, h1, h2, h3, h4, h5, h6⟩ := hK
  refine ⟨φ a, φ b, φ c, φ d, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [← map_mul, ← map_mul, ← map_add, h1]
  · rw [← map_mul, ← map_mul, ← map_add, h2]
  · rw [← map_mul, ← map_mul, ← map_add, h3]
  · rw [← map_mul, ← map_mul, ← map_add, h4]
  · rw [← map_add, h5, map_one]
  · rw [h6]
    exact bc_span_pair φ _ _

/-- The diagonal automorphism `(x, y) ↦ (u x, y)` of `D²`. -/
def diag2 {D : Type} [CommRing D] (u : D) : (D × D) →ₗ[D] (D × D) :=
  LinearMap.prod (u • LinearMap.fst D D D) (LinearMap.snd D D D)

@[simp] lemma diag2_apply {D : Type} [CommRing D] (u : D) (z : D × D) :
    diag2 u z = (u * z.1, z.2) := rfl

lemma map_diag2_span {D : Type} [CommRing D] (u : D) (p q : D × D) :
    (Submodule.span D {p, q}).map (diag2 u) = Submodule.span D {diag2 u p, diag2 u q} := by
  rw [Submodule.map_span, Set.image_pair]

lemma IsLine.map_diag2 {D : Type} [CommRing D] {u v : D} (huv : u * v = 1)
    {K : Submodule D (D × D)} (hK : IsLine K) : IsLine (K.map (diag2 u)) := by
  obtain ⟨a, b, c, d, h1, h2, h3, h4, h5, h6⟩ := hK
  have e1 : (u * a, c) = u • (a, v * c) := by
    ext
    · simp
    · change c = u * (v * c)
      rw [← mul_assoc, huv, one_mul]
  refine ⟨a, u * b, v * c, d, ?_, ?_, ?_, ?_, h5, ?_⟩
  · linear_combination h1 + (b * c) * huv
  · linear_combination u * h2
  · linear_combination v * h3
  · linear_combination (b * c) * huv + h4
  · rw [h6, map_diag2_span, diag2_apply, diag2_apply]
    apply le_antisymm
    · refine Submodule.span_le.mpr ?_
      rintro _ (rfl | rfl)
      · change (u * a, c) ∈ _
        rw [e1]
        exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))
      · exact Submodule.subset_span (by simp)
    · refine Submodule.span_le.mpr ?_
      rintro _ (rfl | rfl)
      · have : (a, v * c) = v • (u * a, c) := by
          ext
          · change a = v * (u * a)
            rw [← mul_assoc, mul_comm v u, huv, one_mul]
          · rfl
        rw [this]
        exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))
      · exact Submodule.subset_span (by simp)

variable (R : Type) [CommRing R]

/-- **Remark 3.25.** The projective line on affine `R`-schemes: `ℙ¹(D)` is the set of rank one
direct summands of `D²`. -/
def p1 : (Aff R)ᵒᵖ ⥤ Type where
  obj U := {K : Submodule (unop (unop U) : CommAlgCat.{0} R) ((unop (unop U) : CommAlgCat.{0} R) × (unop (unop U) : CommAlgCat.{0} R)) // IsLine K}
  map {U V} g := ↾ fun K => ⟨bc (g.unop.unop.hom : _ →ₐ[R] _).toRingHom K.1, K.2.bc _⟩
  map_id U := by
    ext K x
    exact SetLike.ext_iff.mp (bc_id K.1) x
  map_comp {U V W} f g := by
    ext K x
    exact SetLike.ext_iff.mp (bc_comp (f.unop.unop.hom : _ →ₐ[R] _).toRingHom (g.unop.unop.hom : _ →ₐ[R] _).toRingHom K.1) x

/-- The action of `D(ℤ)` on `ℙ¹` with weights `(1, 0)`. -/
noncomputable def p1Action : AAction (affO R) ℤ (p1 R) where
  smul {U} h K := ⟨Submodule.map (diag2 (show (unop (unop U) : CommAlgCat.{0} R) from h (Multiplicative.ofAdd 1))) K.1,
    K.2.map_diag2 (apt_unit (D := (unop (unop U) : CommAlgCat.{0} R)) h)⟩
  one_smul {U} K := by
    refine Subtype.ext ?_
    let D : CommAlgCat.{0} R := unop (unop U)
    have : diag2 (show D from (1 : Multiplicative ℤ →* D) (Multiplicative.ofAdd 1)) = LinearMap.id := by
      ext <;> simp
    exact (congrArg (fun f => Submodule.map f K.1) this).trans (Submodule.map_id _)
  mul_smul {U} g h K := by
    refine Subtype.ext ?_
    let D : CommAlgCat.{0} R := unop (unop U)
    let g' : Multiplicative ℤ →* D := g
    let h' : Multiplicative ℤ →* D := h
    have : diag2 ((g' * h') (Multiplicative.ofAdd 1)) =
        (diag2 (g' (Multiplicative.ofAdd 1))).comp (diag2 (h' (Multiplicative.ofAdd 1))) := by
      ext <;> simp [mul_comm]
    exact (congrArg (fun f => Submodule.map f K.1) this).trans (Submodule.map_comp _ _ _)
  map_smul {U V} f h K := by
    refine Subtype.ext ?_
    let D : CommAlgCat.{0} R := unop (unop U)
    let D' : CommAlgCat.{0} R := unop (unop V)
    let φ : D →+* D' := (f.unop.unop.hom : D →ₐ[R] D').toRingHom
    let h' : Multiplicative ℤ →* D := h
    change bc φ (K.1.map (diag2 (h' (Multiplicative.ofAdd 1)))) =
      (bc φ K.1).map (diag2 (φ (h' (Multiplicative.ofAdd 1))))
    rw [bc, bc, Submodule.map_span, Submodule.map_coe, Set.image_image, Set.image_image]
    congr 1
    refine Set.image_congr fun y _ => ?_
    ext <;> simp

/-- The line through `(b, 1)`. -/
def lineA {D : Type} [CommRing D] (b : D) : Submodule D (D × D) :=
  Submodule.span D {((0 : D), (0 : D)), (b, 1)}

/-- The line through `(1, c)`. -/
def lineB {D : Type} [CommRing D] (c : D) : Submodule D (D × D) :=
  Submodule.span D {((1 : D), c), ((0 : D), (0 : D))}

lemma isLine_lineA {D : Type} [CommRing D] (b : D) : IsLine (lineA b) :=
  ⟨0, b, 0, 1, by ring, by ring, by ring, by ring, by ring, rfl⟩

lemma isLine_lineB {D : Type} [CommRing D] (c : D) : IsLine (lineB c) :=
  ⟨1, 0, c, 0, by ring, by ring, by ring, by ring, by ring, rfl⟩

lemma bc_lineA {D D' : Type} [CommRing D] [CommRing D'] (φ : D →+* D') (b : D) :
    bc φ (lineA b) = lineA (φ b) := by
  rw [lineA, bc_span_pair]; simp [lineA]

lemma bc_lineB {D D' : Type} [CommRing D] [CommRing D'] (φ : D →+* D') (c : D) :
    bc φ (lineB c) = lineB (φ c) := by
  rw [lineB, bc_span_pair]; simp [lineB]

lemma map_lineA {D : Type} [CommRing D] (u b : D) :
    (lineA b).map (diag2 u) = lineA (u * b) := by
  rw [lineA, map_diag2_span]; simp [lineA]

lemma map_lineB {D : Type} [CommRing D] {u v : D} (huv : u * v = 1) (c : D) :
    (lineB c).map (diag2 u) = lineB (v * c) := by
  rw [lineB, map_diag2_span, lineB]
  simp only [diag2_apply, mul_one, mul_zero]
  apply le_antisymm
  · refine Submodule.span_le.mpr ?_
    rintro _ (rfl | rfl)
    · have : (u, c) = u • ((1 : D), v * c) := by
        ext
        · simp
        · change c = u * (v * c)
          rw [← mul_assoc, huv, one_mul]
      rw [this]
      exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))
    · exact Submodule.subset_span (by simp)
  · refine Submodule.span_le.mpr ?_
    rintro _ (rfl | rfl)
    · have : ((1 : D), v * c) = v • (u, c) := by
        ext
        · change 1 = v * u
          rw [mul_comm, huv]
        · rfl
      rw [this]
      exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))
    · exact Submodule.subset_span (by simp)

/-- The orbit map of `[1 : 1]` extended to `𝔸(ℕ)`: `a ↦ [a : 1]`. -/
noncomputable def p1PosPt (T : Aff R) : AttractorPt (p1Action R) posN T where
  app {T'} t a := ⟨lineA (show (unop T' : CommAlgCat.{0} R) from
    a (Multiplicative.ofAdd (⟨1, by simp [mem_posN]⟩ : posN))), isLine_lineA _⟩
  naturality {T' T''} s t a := Subtype.ext (bc_lineA _ _).symm
  equivariant {T'} t h a := Subtype.ext (map_lineA _ _).symm

/-- The orbit map of `[1 : 1]` extended to `𝔸(-ℕ)`: `b ↦ [1 : b]`. -/
noncomputable def p1NegPt (T : Aff R) : AttractorPt (p1Action R) negN T where
  app {T'} t a := ⟨lineB (show (unop T' : CommAlgCat.{0} R) from
    a (Multiplicative.ofAdd (⟨-1, by simp [mem_negN]⟩ : negN))), isLine_lineB _⟩
  naturality {T' T''} s t a := Subtype.ext (bc_lineB _ _).symm
  equivariant {T'} t h a := Subtype.ext
    (map_lineB (apt_unit (show Multiplicative ℤ →* (unop T' : CommAlgCat.{0} R) from h)) _).symm

lemma lineA_one_eq_lineB_one {D : Type} [CommRing D] : lineA (1 : D) = lineB (1 : D) := by
  rw [lineA, lineB, Set.pair_comm]

/-- **Remark 3.25.** `X^{N ∩ L} ≠ X^N ×_X X^L` for `X = ℙ¹`, `N = ℕ`, `L = -ℕ`, `M = ℤ`: the point
`[1 : 1]` of `ℙ¹` lifts both to `X^ℕ` and to `X^{-ℕ}`, but does not lift to `X^{ℕ ∩ -ℕ} = X^0`. -/
theorem rem325 [Nontrivial R] :
    ∃ (φ : AttractorPt (p1Action R) posN (op (CommAlgCat.of R R)))
      (ψ : AttractorPt (p1Action R) negN (op (CommAlgCat.of R R))),
      φ.toPoint = ψ.toPoint ∧
        ∀ χ : AttractorPt (p1Action R) (posN ⊓ negN) (op (CommAlgCat.of R R)),
          χ.toPoint ≠ φ.toPoint := by
  refine ⟨p1PosPt R _, p1NegPt R _, ?_, ?_⟩
  · refine Subtype.ext ?_
    exact lineA_one_eq_lineB_one
  · intro χ hχ
    let B := AddMonoidAlgebra R ℤ
    let t : op (CommAlgCat.of R B) ⟶ op (CommAlgCat.of R R) := affHom (constAlg ℤ R)
    let hu : APt (affO R) ℤ (op (op (CommAlgCat.of R B))) := AddMonoidAlgebra.of R ℤ
    have hone : APt.toMagnet (posN ⊓ negN) hu *
        (1 : APt (affO R) (posN ⊓ negN : AddSubmonoid ℤ) (op (op (CommAlgCat.of R B)))) = 1 := by
      ext n
      have h0 : ((Multiplicative.toAdd n : (posN ⊓ negN : AddSubmonoid ℤ)) : ℤ) = 0 := by
        have h := (Multiplicative.toAdd n : (posN ⊓ negN : AddSubmonoid ℤ)).2
        exact le_antisymm h.2 h.1
      have : hu (Multiplicative.ofAdd ((Multiplicative.toAdd n : (posN ⊓ negN : AddSubmonoid ℤ)) : ℤ)) = 1 := by
        rw [h0]; exact map_one hu
      change hu _ * 1 = 1
      rw [mul_one]
      exact this
    have heq := χ.equivariant t hu 1
    rw [hone] at heq
    have h1 : (χ.toPoint).1 = lineA (1 : R) := by
      rw [hχ]; rfl
    have hnat := AttractorPt.toPoint_baseChange t χ
    change χ.app (𝟙 _ ≫ t) 1 = _ at hnat
    rw [Category.id_comp] at hnat
    have hval : (χ.app t 1).1 = lineA (1 : B) := by
      have := congrArg Subtype.val hnat
      refine this.trans ?_
      change bc _ (χ.toPoint).1 = _
      rw [h1, bc_lineA, map_one]
    let u : B := AddMonoidAlgebra.single 1 1
    have h2 : lineA (1 : B) = (lineA (1 : B)).map (diag2 u) :=
      hval.symm.trans ((congrArg Subtype.val heq).trans (congrArg (Submodule.map (diag2 u)) hval))
    rw [map_lineA, mul_one] at h2
    have hm : (u, (1 : B)) ∈ lineA (1 : B) := by
      rw [h2]
      exact Submodule.subset_span (by simp)
    obtain ⟨p, q, hpq⟩ := Submodule.mem_span_pair.mp hm
    have e1 := congrArg Prod.fst hpq
    have e2 := congrArg Prod.snd hpq
    simp at e1 e2
    rw [e2] at e1
    have e3 : (AddMonoidAlgebra.single 1 1 : B) = AddMonoidAlgebra.single 0 1 := e1.symm
    have h4 : (AddMonoidAlgebra.single (1 : ℤ) (1 : R) : B).coeff 1 =
        (AddMonoidAlgebra.single (0 : ℤ) (1 : R) : B).coeff 1 := by rw [e3]
    rw [AddMonoidAlgebra.coeff_single, AddMonoidAlgebra.coeff_single, Finsupp.single_eq_same,
      Finsupp.single_eq_of_ne (by norm_num)] at h4
    exact one_ne_zero h4

end P1

end AlgMag

end

section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry


namespace AlgMag

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

local notation "Sch" => BigFppfOver.toScheme B S hS

/-! ### Fact 3.16 -/

section Fact316

variable {M : Type u} [AddCommMonoid M] [Countable M]
variable {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {act : AAction (fppfO B S hS) M F}
variable {N L : AddSubmonoid M} {UN UL : BigFppfOver B S hS}

/-- **Fact 3.16.** If `X^N`, `X^F` are representable by schemes and `p_{N,F} : X^N → X^F` is
separated, then `ι_{F,N} : X^F → X^N` is a closed immersion. -/
theorem fact316 (rN : RepresentsAttractor act N (yoneda.obj UN))
    (rL : RepresentsAttractor act L (yoneda.obj UL)) (hL : IsFace L N)
    [IsSeparated ((Sch).map (yoneda.preimage (repFace rN rL hL)))] :
    IsClosedImmersion ((Sch).map (yoneda.preimage (repMagnet rN rL hL.le))) := by
  have h : yoneda.preimage (repMagnet rN rL hL.le) ≫ yoneda.preimage (repFace rN rL hL) = 𝟙 UL :=
    yoneda.map_injective (by simpa using repMagnet_comp_repFace rN rL hL)
  have h' : (Sch).map (yoneda.preimage (repMagnet rN rL hL.le)) ≫
      (Sch).map (yoneda.preimage (repFace rN rL hL)) = 𝟙 _ := by
    rw [← CategoryTheory.Functor.map_comp, h, CategoryTheory.Functor.map_id]
  have : IsClosedImmersion ((Sch).map (yoneda.preimage (repMagnet rN rL hL.le)) ≫
      (Sch).map (yoneda.preimage (repFace rN rL hL))) := by
    rw [h']; infer_instance
  exact IsClosedImmersion.of_comp _ ((Sch).map (yoneda.preimage (repFace rN rL hL)))

end Fact316

/-! ### Proposition 3.31 (iii) -/

section Prop331

variable {M Z : Type u} [AddCommMonoid M] [AddCommGroup Z] [AddMonoid.FG Z]
variable (f : M →+ Z) (Y : AddSubmonoid Z)
variable {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (act : AAction (fppfO B S hS) M F)

/-- The action of `𝔸(Z)` through `𝔸(Z) → 𝔸(M)` dual to `f : M → Z` (notation of Proposition 3.31). -/
noncomputable def actAlong : AAction (fppfO B S hS) Z F where
  smul h x := act.smul (h.comp (AddMonoidHom.toMultiplicative f)) x
  one_smul x := act.one_smul x
  mul_smul g h x := act.mul_smul (g.comp (AddMonoidHom.toMultiplicative f))
    (h.comp (AddMonoidHom.toMultiplicative f)) x
  map_smul r h x := act.map_smul r _ x

/-- `f` restricted to `N = f⁻¹(Y) → Y`. -/
def linMagnetHom : Y.comap f →+ Y where
  toFun n := ⟨f n, n.2⟩
  map_zero' := Subtype.ext (map_zero f)
  map_add' a b := Subtype.ext (map_add f (a : M) (b : M))

variable {f Y}
variable (hf : Function.Injective f) (hY : ∀ y ∈ Y, ∃ m, f m = y)

/-- `f` identifies `N = f⁻¹(Y)` with `Y` when `Y ⊆ f(M)`, `f` injective. -/
noncomputable def magnetIso : Y.comap f ≃+ Y :=
  AddEquiv.ofBijective (linMagnetHom f Y)
    ⟨fun a b h => Subtype.ext (hf (congrArg Subtype.val h)),
      fun y => by
        obtain ⟨m, hm⟩ := hY y y.2
        exact ⟨⟨m, by change f m ∈ Y; rw [hm]; exact y.2⟩, Subtype.ext hm⟩⟩

/-- A point of `X^N` for `𝔸(M)` is a point of `X^Y` for `𝔸(Z)`. -/
noncomputable def ptAlong {T : BigFppfOver B S hS} (φ : AttractorPt act (Y.comap f) T) :
    AttractorPt (actAlong f act) Y T where
  app t a := φ.app t (a.comp (AddMonoidHom.toMultiplicative (linMagnetHom f Y)))
  naturality s t a := φ.naturality s t (a.comp (AddMonoidHom.toMultiplicative (linMagnetHom f Y)))
  equivariant t h a := by
    refine Eq.trans (congrArg (φ.app t) (MonoidHom.ext fun _ => rfl))
      (φ.equivariant t (h.comp (AddMonoidHom.toMultiplicative f))
        (a.comp (AddMonoidHom.toMultiplicative (linMagnetHom f Y))))

/-- The multiplicative form of `e⁻¹ : Y → N`. -/
noncomputable abbrev eInv : Multiplicative Y →* Multiplicative (Y.comap f) :=
  AddMonoidHom.toMultiplicative (magnetIso hf hY).symm.toAddMonoidHom

variable {act}

section Crux

lemma contains_of_inj (T : BigFppfOver B S hS) [IsAffine ((Sch).obj T)] {P : Type u} [AddCommMonoid P] (g : P →+ Z × Z)
    (hg : Function.Injective g) : B.Contains (Spec (.of (AddMonoidAlgebra (RT T) P))) := by
  have hM : B.Contains (Spec (.of (AddMonoidAlgebra (RT T) (Z × Z)))) := contains_M (contains_RT T)
  refine Scheme.size_Spec_lt_of_mk_le_max B.aleph0_lt_cutoff B.cutoff_isStrongPrelimit hM ?_
  exact (Cardinal.mk_le_of_injective (AddMonoidAlgebra.mapDomain_injective (R := RT T) hg)).trans
    (le_max_right _ _)

/-- The structure ring map `R → R[P]`. -/
noncomputable abbrev ρP (T : BigFppfOver B S hS) (P : Type u) [AddCommMonoid P] : RT T →+* AddMonoidAlgebra (RT T) P :=
  algebraMap _ _

/-- **Proposition 3.31 (iii)**, core: on an affine `T` an `𝔸(Z)`-equivariant map is `𝔸(M)`-equivariant:
pass to the universal point over `R[M × N]`, inject into `R[Z × N]` (`𝔸(N)×D(Z)` is schematically
dense in `𝔸(N)×𝔸(M)`) and use `HasDensePullback`. -/
theorem along_equivariant (T : BigFppfOver B S hS) [IsAffine ((Sch).obj T)] (hd : HasDensePullback F) (ψ : AttractorPt (actAlong f act) Y T)
    (h : APt (fppfO B S hS) M (op T)) (a : APt (fppfO B S hS) (Y.comap f) (op T)) :
    ψ.app (𝟙 T) ((APt.toMagnet (Y.comap f) h * a).comp (eInv hf hY)) =
      act.smul h (ψ.app (𝟙 T) (a.comp (eInv hf hY))) := by
  let N := Y.comap f
  let e := magnetIso hf hY
  let g₁ : M × N →+ Z × N := AddMonoidHom.prodMap f (AddMonoidHom.id N)
  have hg₁ : Function.Injective g₁ := fun x y hxy => by
    have h1 := congrArg Prod.fst hxy
    have h2 := congrArg Prod.snd hxy
    exact Prod.ext (hf h1) h2
  let k₂ : Z × N →+ Z × Z := AddMonoidHom.prodMap (AddMonoidHom.id Z) (f.comp N.subtype)
  have hk₂ : Function.Injective k₂ := fun x y hxy => by
    have h1 := congrArg Prod.fst hxy
    have h2 := congrArg Prod.snd hxy
    exact Prod.ext h1 (Subtype.ext (hf h2))
  have hC₁ : B.Contains (Spec (.of (AddMonoidAlgebra (RT T) (M × N)))) :=
    contains_of_inj T (k₂.comp g₁) (hk₂.comp hg₁)
  have hC₂ : B.Contains (Spec (.of (AddMonoidAlgebra (RT T) (Z × N)))) :=
    contains_of_inj T k₂ hk₂
  let π : AddMonoidAlgebra (RT T) (M × N) →+* AddMonoidAlgebra (RT T) (Z × N) :=
    AddMonoidAlgebra.mapDomainRingHom _ g₁
  have hπ : π.comp (ρP T (M × N)) = ρP T (Z × N) := by
    refine RingHom.ext fun r => ?_
    change AddMonoidAlgebra.mapDomain g₁ (AddMonoidAlgebra.single 0 r) = AddMonoidAlgebra.single 0 r
    rw [AddMonoidAlgebra.mapDomain_single, map_zero]
  have hπi : Function.Injective π := AddMonoidAlgebra.mapDomain_injective hg₁
  let of₁ := AddMonoidAlgebra.of (RT T) (M × N)
  let of₂ := AddMonoidAlgebra.of (RT T) (Z × N)
  let hu₁ : Multiplicative M →* AddMonoidAlgebra (RT T) (M × N) :=
    of₁.comp (AddMonoidHom.toMultiplicative (AddMonoidHom.inl M N))
  let au₁ : Multiplicative N →* AddMonoidAlgebra (RT T) (M × N) :=
    of₁.comp (AddMonoidHom.toMultiplicative (AddMonoidHom.inr M N))
  let hz : Multiplicative Z →* AddMonoidAlgebra (RT T) (Z × N) :=
    of₂.comp (AddMonoidHom.toMultiplicative (AddMonoidHom.inl Z N))
  let au₂ : Multiplicative N →* AddMonoidAlgebra (RT T) (Z × N) :=
    of₂.comp (AddMonoidHom.toMultiplicative (AddMonoidHom.inr Z N))
  let εi : Multiplicative Y →* Multiplicative N := eInv hf hY
  have he : ∀ y : Y, f ((Multiplicative.toAdd (εi (Multiplicative.ofAdd y)) : N) : M) = (y : Z) := by
    intro y
    exact congrArg Subtype.val ((magnetIso hf hY).apply_symm_apply y)
  let t₁ := spToT T (ρP T (M × N)) hC₁
  let t₂ := spToT T (ρP T (Z × N)) hC₂
  -- the identity at the universal point of `R[M × N]`
  have E1 : ψ.app t₁ (spPt ((((hu₁.comp (AddMonoidHom.toMultiplicative N.subtype)) * au₁)).comp εi)) =
      act.smul (spPt hu₁) (ψ.app t₁ (spPt (au₁.comp εi))) := by
    refine hd T (hC := hC₁) (hC' := hC₂) π hπ hπi ?_
    rw [act.map_smul, spPt_res]
    have hL := app_sp ψ π hπ ((((hu₁.comp (AddMonoidHom.toMultiplicative N.subtype)) * au₁)).comp εi)
      (hC := hC₁) (hC₀ := hC₂)
    have hR := app_sp ψ π hπ (au₁.comp εi) (hC := hC₁) (hC₀ := hC₂)
    refine hL.trans (Eq.trans ?_ (congrArg _ hR).symm)
    have hE := ψ.equivariant t₂ (spPt hz) (spPt (π.toMonoidHom.comp (au₁.comp εi)))
    refine Eq.trans (congrArg (ψ.app t₂) ?_) (Eq.trans hE ?_)
    · refine MonoidHom.ext fun y => ?_
      have e1 : ∀ y : Y, π (of₁ (Multiplicative.ofAdd
          (((Multiplicative.toAdd (εi (Multiplicative.ofAdd y)) : N) : M), (0 : N))) *
          of₁ (Multiplicative.ofAdd ((0 : M), (Multiplicative.toAdd (εi (Multiplicative.ofAdd y)) : N)))) =
          hz (Multiplicative.ofAdd (y : Z)) *
            π (of₁ (Multiplicative.ofAdd ((0 : M), (Multiplicative.toAdd (εi (Multiplicative.ofAdd y)) : N)))) := by
        intro y
        rw [map_mul]
        congr 1
        change AddMonoidAlgebra.mapDomain g₁ (AddMonoidAlgebra.single _ 1) = AddMonoidAlgebra.single _ 1
        rw [AddMonoidAlgebra.mapDomain_single]
        congr 1
        exact Prod.ext (he y) rfl
      change spSec T (ρP T (Z × N)) hC₂ (π _) =
        spSec T (ρP T (Z × N)) hC₂ (hz _) * spSec T (ρP T (Z × N)) hC₂ _
      rw [← map_mul]
      exact congrArg _ (e1 (Multiplicative.toAdd y))
    · change act.smul _ _ = act.smul _ _
      congr 1
      refine MonoidHom.ext fun m => ?_
      change spSec T (ρP T (Z × N)) hC₂ _ = spSec T (ρP T (Z × N)) hC₂ _
      refine congrArg _ ?_
      change _ = AddMonoidAlgebra.mapDomain g₁ (AddMonoidAlgebra.single _ 1)
      rw [AddMonoidAlgebra.mapDomain_single]
      rfl
  -- specialise to `(h, a)`
  let Γ' := Γ((Sch).obj T, ⊤)
  let gm : Multiplicative (M × N) →* Γ' :=
    { toFun := fun p => h (Multiplicative.ofAdd (Multiplicative.toAdd p).1) *
        a (Multiplicative.ofAdd (Multiplicative.toAdd p).2)
      map_one' := by
        change h 1 * a 1 = 1
        rw [map_one, map_one, mul_one]
      map_mul' := fun p q => by
        change h (Multiplicative.ofAdd _ * Multiplicative.ofAdd _) *
          a (Multiplicative.ofAdd _ * Multiplicative.ofAdd _) = _
        rw [map_mul, map_mul]
        exact mul_mul_mul_comm _ _ _ _ }
  let Ψ : AddMonoidAlgebra (RT T) (M × N) →+* Γ' :=
    (AddMonoidAlgebra.lift (RT T) Γ' (M × N) gm).toRingHom
  have hΨ : Ψ.comp (ρP T (M × N)) = ((Sch).map (𝟙 T)).appTop.hom := by
    refine RingHom.ext fun r => ?_
    have : ((Sch).map (𝟙 T)).appTop.hom r = r := by simp
    rw [this]
    exact (AddMonoidAlgebra.lift (RT T) Γ' (M × N) gm).commutes r
  let s : T ⟶ spObj T (ρP T (M × N)) hC₁ := spLift T _ hC₁ (𝟙 T) Ψ hΨ
  have hst : s ≫ t₁ = 𝟙 T := spLift_toT T _ hC₁ (𝟙 T) Ψ hΨ
  have hres : ∀ {P : Type u} [AddCommMonoid P] (b : Multiplicative P →* AddMonoidAlgebra (RT T) (M × N))
      (c : APt (fppfO B S hS) P (op T)), (∀ p, Ψ (b p) = c p) →
      APt.res s.op (spPt (T := T) (ρ := ρP T (M × N)) (hC := hC₁) b) = c := by
    intro P _ b c hb
    refine MonoidHom.ext fun p => ?_
    rw [res_spPt_apply]
    exact (spLift_appTop T _ hC₁ (𝟙 T) Ψ hΨ _).trans (hb p)
  have hΨof : ∀ p : M × N, Ψ (of₁ (Multiplicative.ofAdd p)) =
      h (Multiplicative.ofAdd p.1) * a (Multiplicative.ofAdd p.2) := by
    intro p
    exact AddMonoidAlgebra.lift_of gm _
  have hh : APt.res s.op (spPt (T := T) (ρ := ρP T (M × N)) (hC := hC₁) hu₁) = h :=
    hres _ _ fun m => by
      refine (hΨof _).trans ?_
      change h _ * a 1 = _
      rw [map_one, mul_one]
      rfl
  have haa : APt.res s.op (spPt (T := T) (ρ := ρP T (M × N)) (hC := hC₁) (au₁.comp εi)) = a.comp (eInv hf hY) :=
    hres _ _ fun y => by
      refine (hΨof _).trans ?_
      change h 1 * a _ = _
      rw [map_one, one_mul]
      rfl
  have hmix : APt.res s.op (spPt (T := T) (ρ := ρP T (M × N)) (hC := hC₁)
      (((hu₁.comp (AddMonoidHom.toMultiplicative N.subtype)) * au₁).comp εi)) =
      (APt.toMagnet N h * a).comp (eInv hf hY) :=
    hres _ _ fun y => by
      refine (map_mul Ψ _ _).trans ?_
      refine (congrArg₂ (· * ·) (hΨof _) (hΨof _)).trans ?_
      change h _ * a 1 * (h 1 * a _) = _
      rw [map_one, map_one, mul_one, one_mul]
      rfl
  have key := congrArg (F.map s.op) E1
  rw [act.map_smul, hh] at key
  have n1 := ψ.naturality s t₁ (spPt (T := T) (ρ := ρP T (M × N)) (hC := hC₁)
    (((hu₁.comp (AddMonoidHom.toMultiplicative N.subtype)) * au₁).comp εi))
  have n2 := ψ.naturality s t₁ (spPt (T := T) (ρ := ρP T (M × N)) (hC := hC₁) (au₁.comp εi))
  rw [hst, hmix] at n1
  rw [hst, haa] at n2
  rw [n1, n2]
  exact key

/-- Evaluation at the identity after base change. -/
lemma app_baseChange_id {T T' : BigFppfOver B S hS} {act' : AAction (fppfO B S hS) Z F}
    (t : T' ⟶ T) (ψ : AttractorPt act' Y T) (a : APt (fppfO B S hS) Y (op T')) :
    (AttractorPt.baseChange t ψ).app (𝟙 T') a = ψ.app t a := by
  change ψ.app (𝟙 T' ≫ t) a = _
  rw [Category.id_comp]

end Crux

/-- A point of `X^Y` for `𝔸(Z)` is a point of `X^N` for `𝔸(M)`, `X` separated (via
`HasDensePullback`). -/
noncomputable def ptOfAlong (hF : Presieve.IsSheaf (BigFppfOver.topology B S hS) F)
    (hd : HasDensePullback F) {T : BigFppfOver B S hS} (ψ : AttractorPt (actAlong f act) Y T) :
    AttractorPt act (Y.comap f) T where
  app t a := ψ.app t (a.comp (eInv hf hY))
  naturality s t a := ψ.naturality s t (a.comp (eInv hf hY))
  equivariant {T'} t h a := by
    let m0 := (APt.toMagnet (Y.comap f) h * a).comp (eInv hf hY)
    let m1 := a.comp (eInv hf hY)
    change ψ.app t m0 = act.smul h (ψ.app t m1)
    obtain ⟨I, V, π, hV, hS'⟩ := exists_affine_cover T'
    refine (hF _ hS').isSeparatedFor.ext fun W g hg => ?_
    obtain ⟨W', c, b, ⟨i⟩, rfl⟩ := hg
    have : IsAffine ((Sch).obj (V i)) := hV i
    suffices main : F.map (π i).op (ψ.app t m0) = F.map (π i).op (act.smul h (ψ.app t m1)) by
      simp only [op_comp, Functor.map_comp_apply]
      rw [main]
    rw [act.map_smul, ← ψ.naturality, ← ψ.naturality]
    have hc := along_equivariant hf hY (V i) hd (AttractorPt.baseChange (π i ≫ t) ψ)
      (APt.res (π i).op h) (APt.res (π i).op a)
    rw [app_baseChange_id, app_baseChange_id] at hc
    refine Eq.trans (congrArg (ψ.app (π i ≫ t)) (MonoidHom.ext fun y =>
      map_mul ((fppfO B S hS).map (π i).op).hom _ _)) hc

/-- **Proposition 3.31 (iii).** Let `f : M → Z` be injective into a finitely generated group (e.g.
`M` cancellative, `Z = M^gp`), `Y ⊆ f(M)` a magnet of `Z`, `N = f⁻¹(Y)`. If `X` is a sheaf with
`HasDensePullback` (e.g. a separated algebraic space, `hasDensePullback_of_separated`), then
`X^N_M = X^Y_Z`. The finite generation of `Z` is the size hypothesis of the site. -/
noncomputable def prop331_iii (hF : Presieve.IsSheaf (BigFppfOver.topology B S hS) F)
    (hd : HasDensePullback F) (T : BigFppfOver B S hS) :
    AttractorPt act (Y.comap f) T ≃ AttractorPt (actAlong f act) Y T where
  toFun := ptAlong act
  invFun := ptOfAlong hf hY hF hd
  left_inv φ := by
    refine AttractorPt.ext ?_
    funext T' t a
    refine congrArg (φ.app t) (MonoidHom.ext fun n => ?_)
    refine congrArg a ?_
    exact congrArg Multiplicative.ofAdd ((magnetIso hf hY).symm_apply_apply _)
  right_inv ψ := by
    refine AttractorPt.ext ?_
    funext T' t a
    refine congrArg (ψ.app t) (MonoidHom.ext fun n => ?_)
    refine congrArg a ?_
    exact congrArg Multiplicative.ofAdd ((magnetIso hf hY).apply_symm_apply _)

end Prop331

end AlgMag

end

section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry Magnetism


namespace AlgMag

/-! ### Example 3.33 -/

section Ex333

/-- `ℕ² ⊆ ℤ²`. -/
def quadrant : AddSubmonoid (ℤ × ℤ) where
  carrier := {x | 0 ≤ x.1 ∧ 0 ≤ x.2}
  add_mem' := fun {a b} (ha : 0 ≤ a.1 ∧ 0 ≤ a.2) (hb : 0 ≤ b.1 ∧ 0 ≤ b.2) =>
    show 0 ≤ a.1 + b.1 ∧ 0 ≤ a.2 + b.2 by omega
  zero_mem' := ⟨le_refl (0 : ℤ), le_refl (0 : ℤ)⟩

/-- The magnet `ℕ × 0`. -/
def axisX : AddSubmonoid (ℤ × ℤ) where
  carrier := {x | 0 ≤ x.1 ∧ x.2 = 0}
  add_mem' := fun {a b} (ha : 0 ≤ a.1 ∧ a.2 = 0) (hb : 0 ≤ b.1 ∧ b.2 = 0) =>
    show 0 ≤ a.1 + b.1 ∧ a.2 + b.2 = 0 by omega
  zero_mem' := ⟨le_refl (0 : ℤ), rfl⟩

/-- The magnet `0 × ℕ`. -/
def axisY : AddSubmonoid (ℤ × ℤ) where
  carrier := {x | x.1 = 0 ∧ 0 ≤ x.2}
  add_mem' := fun {a b} (ha : a.1 = 0 ∧ 0 ≤ a.2) (hb : b.1 = 0 ∧ 0 ≤ b.2) =>
    show a.1 + b.1 = 0 ∧ 0 ≤ a.2 + b.2 by omega
  zero_mem' := ⟨rfl, le_refl (0 : ℤ)⟩

/-- `(ℕ × 0) ∩ (0 × ℕ) = 0`. -/
theorem axisX_inf_axisY : axisX ⊓ axisY = ⊥ := by
  refine le_antisymm (fun x hx => ?_) bot_le
  exact Prod.ext hx.2.1 hx.1.2

/-- The coordinate `X^(1,0)`. -/
def e₁ : quadrant := ⟨(1, 0), by constructor <;> simp⟩
/-- The coordinate `X^(0,1)`. -/
def e₂ : quadrant := ⟨(0, 1), by constructor <;> simp⟩

variable (R : Type) [CommRing R]

/-- **Example 3.33**, first equality: for `X = 𝔸(ℕ²)`, by Example 3.21 `X^{ℕ×0}` is cut out by the
monomials of nonzero second degree, i.e. `X^{ℕ×0} = 𝔸¹ × 0`. -/
theorem ex333_axis :
    magnetIdeal (Toric.grading R quadrant) axisX =
      Ideal.span (AddMonoidAlgebra.of' R quadrant '' Toric.outside quadrant axisX) :=
  Toric.magnetIdeal_grading R quadrant axisX

/-- **Example 3.33**, second equality: `(X^{ℕ×0})^{0×ℕ} = X^{(ℕ×0) ∩ (0×ℕ)} = X^0`, whose ideal is
generated by all nonconstant monomials: the zero section of `𝔸²`. -/
theorem ex333_zero :
    magnetIdeal (Toric.grading R quadrant) (axisX ⊓ axisY) =
      Ideal.span (AddMonoidAlgebra.of' R quadrant '' {n | (n : ℤ × ℤ) ≠ 0}) := by
  rw [axisX_inf_axisY, Toric.magnetIdeal_grading]
  rfl

end Ex333

/-! ### Fact 3.34: the colimit step of the printed proof -/

section Chain

/-- The cones `N_k = {y ≥ 0, k x + y ≥ 0}`, decreasing in `k ≥ 1`. -/
def chainN (k : ℕ) : AddSubmonoid (ℤ × ℤ) where
  carrier := {x | 0 ≤ x.2 ∧ 0 ≤ (k : ℤ) * x.1 + x.2}
  add_mem' := fun {a b} (ha : 0 ≤ a.2 ∧ 0 ≤ (k : ℤ) * a.1 + a.2)
      (hb : 0 ≤ b.2 ∧ 0 ≤ (k : ℤ) * b.1 + b.2) => by
    refine ⟨show 0 ≤ a.2 + b.2 by omega, ?_⟩
    change 0 ≤ (k : ℤ) * (a.1 + b.1) + (a.2 + b.2)
    linarith [ha.2, hb.2, mul_add (k : ℤ) a.1 b.1]
  zero_mem' := ⟨le_refl (0 : ℤ), by simp⟩

/-- The intersection of the `N_k` is the quadrant. -/
theorem iInf_chainN : ⨅ k : {k : ℕ // 1 ≤ k}, chainN k = quadrant := by
  refine le_antisymm (fun x hx => ?_) (fun x hx => ?_)
  · have h := fun k : {k : ℕ // 1 ≤ k} => (AddSubmonoid.mem_iInf.mp hx) k
    refine ⟨?_, (h ⟨1, le_refl 1⟩).1⟩
    by_contra hneg
    have hy0 : 0 ≤ x.2 := (h ⟨1, le_refl 1⟩).1
    obtain ⟨hy, hk⟩ := h ⟨(x.2 + 1).toNat, by omega⟩
    have hc : (((x.2 + 1).toNat : ℕ) : ℤ) = x.2 + 1 := Int.toNat_of_nonneg (by omega)
    change 0 ≤ (((x.2 + 1).toNat : ℕ) : ℤ) * x.1 + x.2 at hk
    rw [hc] at hk
    have : x.1 ≤ -1 := by omega
    nlinarith
  · refine AddSubmonoid.mem_iInf.mpr fun k => ⟨hx.2, ?_⟩
    have := mul_nonneg (Int.natCast_nonneg (k : ℕ)) hx.1
    change 0 ≤ ((k : ℕ) : ℤ) * x.1 + x.2
    linarith [hx.2]

/-- **Fact 3.34, printed proof.** The step "`A(⋂ N_l)_S = colim_J A(⋂_J N_l)_S`" fails in schemes:
the point `x = 0, y = 1` of `A(ℕ²) = 𝔸²` lies in no image of `A(N_k)`, since `x · X^(-1,k) = y^k`
in `ℤ[N_k]`. So `𝔸² \ {(0,1)}` receives the compatible maps from all `A(N_k)` but `𝔸²` does not map
to it compatibly: `A(ℕ²)` is the colimit only among affine schemes, and Tag 002H does not apply. -/
theorem chain_no_point {K : Type*} [CommRing K] [Nontrivial K] (k : ℕ) (χ : Multiplicative (chainN k) →* K)
    (e₁' : chainN k) (he₁ : (e₁' : ℤ × ℤ) = (1, 0)) (e₂' : chainN k) (he₂ : (e₂' : ℤ × ℤ) = (0, 1))
    (h0 : χ (Multiplicative.ofAdd e₁') = 0) (h1 : χ (Multiplicative.ofAdd e₂') = 1) : False := by
  have hu : ((-1, (k : ℤ)) : ℤ × ℤ) ∈ chainN k := by
    refine ⟨Int.natCast_nonneg k, ?_⟩
    change 0 ≤ (k : ℤ) * (-1) + (k : ℤ)
    omega
  have hs : e₁' + ⟨(-1, (k : ℤ)), hu⟩ = k • e₂' := by
    refine Subtype.ext ?_
    change (e₁' : ℤ × ℤ) + (-1, (k : ℤ)) = k • (e₂' : ℤ × ℤ)
    rw [he₁, he₂]
    ext <;> simp
  have := congrArg (fun z => χ (Multiplicative.ofAdd z)) hs
  simp only [ofAdd_add, ofAdd_nsmul, map_mul, map_pow, h0, h1, zero_mul, one_pow] at this
  exact zero_ne_one this

end Chain

/-! ### Algebraic space base -/

section BaseB

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- **Definition 2.4 (iii).** `𝔸(N)_B = 𝔸(N)_S ×_S B`, for a functor `Bs` on the site. -/
noncomputable def AB (Bs : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) (N : Type u) [AddCommMonoid N] :
    (BigFppfOver B S hS)ᵒᵖ ⥤ Type u where
  obj U := APt (fppfO B S hS) N U × Bs.obj U
  map f := ↾ fun x => (APt.res f x.1, Bs.map f x.2)
  map_id U := by
    ext x <;> simp
  map_comp f g := by
    ext x
    · simp [APt.res_comp]
    · simp

variable (Bs : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) {N L : Type u} [AddCommMonoid N] [AddCommMonoid L]

/-- **Fact 2.7** over `B`: `𝔸(N × L)_B = 𝔸(N)_B ×_B 𝔸(L)_B` on points. -/
noncomputable def prodEquivB (U : (BigFppfOver B S hS)ᵒᵖ) :
    (AB Bs (N × L)).obj U ≃ {p : (AB Bs N).obj U × (AB Bs L).obj U // p.1.2 = p.2.2} where
  toFun x := ⟨((MonoidHom.comp x.1 (AddMonoidHom.toMultiplicative (AddMonoidHom.inl N L)), x.2),
    (MonoidHom.comp x.1 (AddMonoidHom.toMultiplicative (AddMonoidHom.inr N L)), x.2)), rfl⟩
  invFun p :=
    ({ toFun := fun z => p.1.1.1 (Multiplicative.ofAdd (Multiplicative.toAdd z).1) *
          p.1.2.1 (Multiplicative.ofAdd (Multiplicative.toAdd z).2)
       map_one' := by
         change p.1.1.1 1 * p.1.2.1 1 = 1
         rw [map_one, map_one, mul_one]
       map_mul' := fun y z => by
         change p.1.1.1 (Multiplicative.ofAdd _ * Multiplicative.ofAdd _) *
           p.1.2.1 (Multiplicative.ofAdd _ * Multiplicative.ofAdd _) = _
         rw [map_mul, map_mul]
         exact mul_mul_mul_comm _ _ _ _ }, p.1.1.2)
  left_inv x := by
    refine Prod.ext (MonoidHom.ext fun z => ?_) rfl
    refine (map_mul x.1 _ _).symm.trans (congrArg x.1 ?_)
    exact Prod.ext (add_zero _) (zero_add _)
  right_inv p := by
    obtain ⟨⟨⟨a, b⟩, ⟨c, d⟩⟩, h⟩ := p
    obtain rfl : b = d := h
    refine Subtype.ext (Prod.ext (Prod.ext (MonoidHom.ext fun z => ?_) rfl)
      (Prod.ext (MonoidHom.ext fun z => ?_) rfl))
    · change a _ * c 1 = a z
      rw [map_one, mul_one]; rfl
    · change a 1 * c _ = c z
      rw [map_one, one_mul]; rfl

/-- **Fact 2.12** over `B`: the action of `𝔸(M)_B` on `𝔸(N)_B` for a magnet `N ⊆ M`, over `B`:
`(h, b) · (a, b) = (h|_N a, b)`. -/
noncomputable def actB {M : Type u} [AddCommMonoid M] (N' : AddSubmonoid M)
    {U : (BigFppfOver B S hS)ᵒᵖ} (h : APt (fppfO B S hS) M U) (x : (AB Bs N').obj U) :
    (AB Bs N').obj U :=
  (APt.toMagnet N' h * x.1, x.2)

/-- **Proposition 2.8 (iv)**. Flatness over an algebraic space is tested on schemes `V → B`, where
`𝔸(N)_B ×_B V = 𝔸(N)_V`: the multiplication over each such `V` is flat. The library has no flat
morphisms of algebraic spaces, so this chartwise form is the statement. -/
theorem flat_mul_overB (N : Type u) [AddCommMonoid N] (h : IsFreeAlong (diag N))
    (V : BigFppfOver B S hS) (_b : Bs.obj (op V)) :
    Flat (GB.mul N ((BigFppfOver.toScheme B S hS).obj V)).left :=
  GB.flat_mul N _ h

/-- **Fact 2.10 (vi)**, chartwise as in `flat_mul_overB`. -/
theorem lfp_mul_overB (N : Type u) [AddCommMonoid N] [AddMonoid.FG N]
    (V : BigFppfOver B S hS) (_b : Bs.obj (op V)) :
    LocallyOfFinitePresentation (GB.mul N ((BigFppfOver.toScheme B S hS).obj V)).left :=
  GB.lfp_mul N _

end BaseB

