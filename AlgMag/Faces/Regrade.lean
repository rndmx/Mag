import AlgMag.Sec12Topology
import AlgMag.Sec8Theorem83
import AlgMag.Sec5Etale
import AlgMag.Sec12PrintedSchemes

/-!
# Regrading along a face (faces-bb.md, §0)

`M` an abelian group, `N` a magnet of `M`, `F` a face of `N` (an `AddSubmonoid`, not a subgroup).
`F^gp` is the subgroup generated by `F`, `q : M → M/F^gp`, `N̄ = q(N)`.

* `AlgMag.Faces.mem_face_of_mem_closure`: (a) `N ∩ F^gp = F`.
* `AlgMag.Faces.nbar_sharp`: (b) `N̄` is sharp.
* `AlgMag.Faces.exists_weight_nbar`: (c) for `N` finitely generated, a weight `M/F^gp → ℕ`, additive on
  `N̄`, vanishing on `N̄` exactly at `0`; its pullback to `N` vanishes exactly on `F`.
* `AlgMag.Faces.unitsSub_face_eq`: `F^× = N^×`.
* `AlgMag.Faces.isFace_inf`, `AlgMag.Faces.isFace_unitsSub_of_face`: faces under restriction.
-/

namespace AlgMag.Faces

variable {M : Type*} [AddCommGroup M]

/-- `F^gp`, the subgroup generated by the face `F`. -/
abbrev Fgp (F : AddSubmonoid M) : AddSubgroup M := AddSubgroup.closure (F : Set M)

/-- `N̄ = q(N) ⊆ M/F^gp`. -/
abbrev Nbar (F N : AddSubmonoid M) : AddSubmonoid (M ⧸ Fgp F) :=
  N.map (QuotientAddGroup.mk' (Fgp F))

/-- An element of `F^gp` is a difference of two elements of `F`. -/
theorem exists_add_eq_of_mem_closure {F : AddSubmonoid M} {x : M} (hx : x ∈ Fgp F) :
    ∃ a ∈ F, ∃ b ∈ F, x + b = a := by
  induction hx using AddSubgroup.closure_induction with
  | mem x hx => exact ⟨x, hx, 0, F.zero_mem, by simp⟩
  | zero => exact ⟨0, F.zero_mem, 0, F.zero_mem, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨a, ha, b, hb, e⟩ := hx
    obtain ⟨a', ha', b', hb', e'⟩ := hy
    refine ⟨a + a', F.add_mem ha ha', b + b', F.add_mem hb hb', ?_⟩
    rw [← e, ← e']; abel
  | neg x _ hx =>
    obtain ⟨a, ha, b, hb, e⟩ := hx
    exact ⟨b, hb, a, ha, by rw [← e]; abel⟩

/-- **(a)** `N ∩ F^gp = F`, for a face `F` of a magnet `N`: if `n = f₁ - f₂` then `n + f₂ = f₁ ∈ F`. -/
theorem mem_face_of_mem_closure {F N : AddSubmonoid M} (hF : IsFace F N) {n : M} (hn : n ∈ N)
    (hc : n ∈ Fgp F) : n ∈ F := by
  obtain ⟨a, ha, b, hb, e⟩ := exists_add_eq_of_mem_closure hc
  have h : n + b ∈ F := by rw [e]; exact ha
  exact (hF.mem_of_add_mem hn (hF.le hb) h).1

/-- **(b)** `N̄` is sharp. -/
theorem nbar_sharp {F N : AddSubmonoid M} (hF : IsFace F N) :
    ∀ y ∈ Nbar F N, ∀ y' ∈ Nbar F N, y + y' = 0 → y = 0 := by
  rintro _ ⟨n, hn, rfl⟩ _ ⟨n', hn', rfl⟩ e
  have e' : QuotientAddGroup.mk' (Fgp F) (n + n') = 0 := by rw [map_add]; exact e
  have h : n + n' ∈ Fgp F := (QuotientAddGroup.eq_zero_iff _).1 e'
  have hnn := mem_face_of_mem_closure hF (N.add_mem hn hn') h
  exact (QuotientAddGroup.eq_zero_iff _).2
    (AddSubgroup.subset_closure (hF.mem_of_add_mem hn hn' hnn).1)

/-- `q(n) = 0` for `n ∈ N` iff `n ∈ F`. -/
theorem mk_eq_zero_iff {F N : AddSubmonoid M} (hF : IsFace F N) {n : M} (hn : n ∈ N) :
    QuotientAddGroup.mk' (Fgp F) n = 0 ↔ n ∈ F :=
  ⟨fun h => mem_face_of_mem_closure hF hn ((QuotientAddGroup.eq_zero_iff _).1 h),
    fun h => (QuotientAddGroup.eq_zero_iff _).2 (AddSubgroup.subset_closure h)⟩

/-- **(c)** For `N` finitely generated, a weight on `M/F^gp`: additive on `N̄`, zero on `q(n)` exactly
for `n ∈ F`, hence zero on `N̄` exactly at `0`. Built from `AlgMag.exists_weight_of_isFace` (Ogus,
[27, Prop. 2.2.1]) by descent along `q`. -/
theorem exists_weight_nbar {F N : AddSubmonoid M} (hF : IsFace F N) (hN : N.FG) :
    ∃ wZ : M ⧸ Fgp F → ℕ,
      (∀ n ∈ N, wZ (QuotientAddGroup.mk' (Fgp F) n) = 0 ↔ n ∈ F) ∧
      (∀ n ∈ N, ∀ n' ∈ N, wZ (QuotientAddGroup.mk' (Fgp F) (n + n')) =
        wZ (QuotientAddGroup.mk' (Fgp F) n) + wZ (QuotientAddGroup.mk' (Fgp F) n')) ∧
      (∀ y ∈ Nbar F N, wZ y = 0 → y = 0) := by
  classical
  obtain ⟨w, hw⟩ := exists_weight_of_isFace hF hN
  let f := QuotientAddGroup.mk' (Fgp F)
  have key : ∀ n n' : N, f n = f n' → w n = w n' := by
    intro n n' e
    -- `-n + n' ∈ F^gp`, so `-n + n' + b = a` with `a, b ∈ F`, so `n' + b = n + a`
    have hg : -(n : M) + n' ∈ Fgp F := QuotientAddGroup.eq.1 e
    obtain ⟨a, ha, b, hb, eab⟩ := exists_add_eq_of_mem_closure hg
    let a' : N := ⟨a, hF.le ha⟩
    let b' : N := ⟨b, hF.le hb⟩
    have e₂ : n' + b' = n + a' := Subtype.ext (by
      simp only [AddSubmonoid.coe_add, a', b']
      rw [← eab]; abel)
    have hwa : w a' = 0 := (hw a').2 ha
    have hwb : w b' = 0 := (hw b').2 hb
    have := congrArg w e₂
    rw [map_add, map_add, hwa, hwb, add_zero, add_zero] at this
    exact this.symm
  let wZ : M ⧸ Fgp F → ℕ := fun z => if hz : ∃ n : N, f n = z then w hz.choose else 0
  have wZ_f : ∀ n : N, wZ (f n) = w n := by
    intro n
    have hz : ∃ n' : N, f n' = f n := ⟨n, rfl⟩
    have e : wZ (f n) = w hz.choose := dif_pos hz
    rw [e]
    exact key _ _ hz.choose_spec
  refine ⟨wZ, fun n hn => ?_, fun n hn n' hn' => ?_, ?_⟩
  · have h : wZ (f n) = w ⟨n, hn⟩ := wZ_f ⟨n, hn⟩
    change wZ (f n) = 0 ↔ n ∈ F
    rw [h]
    exact hw ⟨n, hn⟩
  · have h1 : wZ (f n) = w ⟨n, hn⟩ := wZ_f ⟨n, hn⟩
    have h2 : wZ (f n') = w ⟨n', hn'⟩ := wZ_f ⟨n', hn'⟩
    have h3 : wZ (f (n + n')) = w (⟨n, hn⟩ + ⟨n', hn'⟩) := wZ_f (⟨n, hn⟩ + ⟨n', hn'⟩)
    change wZ (f (n + n')) = wZ (f n) + wZ (f n')
    rw [h1, h2, h3, map_add]
  · rintro _ ⟨n, hn, rfl⟩ h0
    have h : wZ (f n) = w ⟨n, hn⟩ := wZ_f ⟨n, hn⟩
    change wZ (f n) = 0 at h0
    rw [h] at h0
    exact (mk_eq_zero_iff hF hn).2 ((hw ⟨n, hn⟩).1 h0)

/-- A face of `N` restricts to a face of any `N_c ⊆ N`. -/
theorem isFace_inf {F N Nc : AddSubmonoid M} (hF : IsFace F N) (hle : Nc ≤ N) :
    IsFace (F ⊓ Nc) Nc where
  le := inf_le_right
  mem_of_add_mem := fun {x y} hx hy h => by
    have h' := hF.mem_of_add_mem (hle hx) (hle hy) (AddSubmonoid.mem_inf.1 h).1
    exact ⟨AddSubmonoid.mem_inf.2 ⟨h'.1, hx⟩, AddSubmonoid.mem_inf.2 ⟨h'.2, hy⟩⟩

/-- `F^× = N^×` for a face `F` of `N`. -/
theorem unitsSub_face_eq {F N : AddSubmonoid M} (hF : IsFace F N) : unitsSub F = unitsSub N := by
  ext x
  constructor
  · rintro ⟨h1, h2⟩
    exact ⟨hF.le h1, hF.le h2⟩
  · rintro ⟨h1, h2⟩
    have h0 : x + -x ∈ F := by rw [add_neg_cancel]; exact F.zero_mem
    exact ⟨(hF.mem_of_add_mem h1 h2 h0).1, (hF.mem_of_add_mem h1 h2 h0).2⟩

/-- `N^×` is a face of every face `F` of `N`. -/
theorem isFace_unitsSub_of_face {F N : AddSubmonoid M} (hF : IsFace F N) :
    IsFace (unitsSub N).toAddSubmonoid F := by
  have h := isFace_unitsSub F
  rw [unitsSub_face_eq hF] at h
  exact h

/-- Same for the copy `Sec12Printed.unitsOf` used in §12 (definitionally `unitsSub`). -/
theorem isFace_unitsOf_of_face {F N : AddSubmonoid M} (hF : IsFace F N) :
    IsFace (Sec12Printed.unitsOf N).toAddSubmonoid F :=
  have e : Sec12Printed.unitsOf N = unitsSub N := AddSubgroup.ext fun _ => Iff.rfl
  e ▸ isFace_unitsSub_of_face hF

end AlgMag.Faces
